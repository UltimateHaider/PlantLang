# tests/perf/tensor_6d_bench.plant — v0.51.2d.2
# 6D tensor create + free benchmark (1000 iterations).
# Uses CYCLE (LOOP is not a parser statement — see TD-012/TD-017 notes).
SUITE "6D Tensor Benchmark"
  CYCLE i FROM 1 TO 1000,
    CREATE T TO TENSOR([[[[[[i, i+1]]]]]]).
    TENSOR_FREE(T).
  /CYCLE.
  SHOW "bench-done".
/SUITE
