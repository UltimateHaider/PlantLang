# TD-048: GRAD_HO(x^2) at x=[3,3,3] = [6,6,6].
CREATE x (TENSOR) TO TENSOR([3.0, 3.0, 3.0]).
TENSOR_TRACK(x).
CREATE s (TENSOR) TO TENSOR_MUL(x, x).
CREATE loss (DBL) TO TENSOR_SUM(s).
CREATE dx (TENSOR) TO GRAD_HO(loss, x).
SHOW dx.
TAPE_CLEAR().
TENSOR_FREE(dx).
TENSOR_FREE(s).
TENSOR_FREE(x).
SHOW "td048-adv2-square-3-ok".
