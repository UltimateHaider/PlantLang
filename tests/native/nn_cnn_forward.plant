# CNN forward: CONV2D -> BatchNorm -> ReLU -> reshape -> DENSE.
CREATE X (TENSOR) TO TENSOR([[[[1.0, 2.0], [3.0, 4.0]]]]).
CREATE K (TENSOR) TO TENSOR([[[[1.0]]]]).
CREATE bc (TENSOR) TO TENSOR([0.0]).
CREATE g (TENSOR) TO TENSOR([1.0]).
CREATE bb (TENSOR) TO TENSOR([0.0]).
CREATE W (TENSOR) TO TENSOR([[0.5], [0.5], [0.5], [0.5]]).
CREATE bd (TENSOR) TO TENSOR([0.0]).
CREATE y (TENSOR) TO CONV2D_FORWARD(X, K, bc, 1, 0).
CREATE yn (TENSOR) TO BATCHNORM_FORWARD(y, g, bb, 0.00001).
CREATE a (TENSOR) TO TENSOR_RELU(yn).
CREATE f (TENSOR) TO TENSOR_RESHAPE_N(a, 2, 1, 4).
CREATE out (TENSOR) TO DENSE_FORWARD(f, W, bd).
SHOW out.
TENSOR_FREE(out).
TENSOR_FREE(f).
TENSOR_FREE(a).
TENSOR_FREE(yn).
TENSOR_FREE(y).
TENSOR_FREE(bd).
TENSOR_FREE(W).
TENSOR_FREE(bb).
TENSOR_FREE(g).
TENSOR_FREE(bc).
TENSOR_FREE(K).
TENSOR_FREE(X).
SHOW "nn-cnn-forward-ok".
