# DENSE + SIGMOID 2nd order through the bias (TD-065 in NN context).
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0]]).
CREATE W (TENSOR) TO TENSOR([[0.5], [0.5]]).
CREATE b (TENSOR) TO TENSOR([0.0]).
TENSOR_TRACK(b).
CREATE h (TENSOR) TO DENSE_FORWARD(X, W, b).
CREATE a (TENSOR) TO TENSOR_SIGMOID(h).
CREATE a2 (TENSOR) TO TENSOR_MUL(a, a).
CREATE loss (DBL) TO TENSOR_SUM(a2).
CREATE db (TENSOR) TO GRAD_HO(loss, b).
CREATE d2b (TENSOR) TO GRAD_HO(TENSOR_SUM(db), b).
SHOW db.
SHOW d2b.
TAPE_CLEAR().
TENSOR_FREE(d2b).
TENSOR_FREE(db).
TENSOR_FREE(a2).
TENSOR_FREE(a).
TENSOR_FREE(h).
TENSOR_FREE(b).
TENSOR_FREE(W).
TENSOR_FREE(X).
SHOW "act-second-order-ok".
