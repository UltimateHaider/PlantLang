# End-to-end: DENSE -> BN -> ReLU -> Dropout -> DENSE(2) -> softmax -> MSE;
# one SGD step; the loss must decrease.
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0], [3.0, 4.0]]).
CREATE W1 (TENSOR) TO TENSOR([[0.5], [0.5]]).
CREATE b1 (TENSOR) TO TENSOR([0.0]).
CREATE g (TENSOR) TO TENSOR([1.0]).
CREATE bb (TENSOR) TO TENSOR([0.0]).
CREATE W2 (TENSOR) TO TENSOR([[0.5, 0.2]]).
CREATE b2 (TENSOR) TO TENSOR([0.0, 0.0]).
CREATE T (TENSOR) TO TENSOR([[0.0, 1.0], [0.0, 1.0]]).
TENSOR_TRACK(W1).
TENSOR_TRACK(W2).
CREATE h1 (TENSOR) TO DENSE_FORWARD(X, W1, b1).
CREATE h1n (TENSOR) TO BATCHNORM_FORWARD(h1, g, bb, 0.00001).
CREATE a1 (TENSOR) TO TENSOR_RELU(h1n).
CREATE d1 (TENSOR) TO DROPOUT_FORWARD(a1, 0.0, 1).
CREATE out (TENSOR) TO DENSE_FORWARD(d1, W2, b2).
CREATE p (TENSOR) TO TENSOR_SOFTMAX(out, 1).
CREATE diff (TENSOR) TO TENSOR_SUB(p, T).
CREATE sq (TENSOR) TO TENSOR_MUL(diff, diff).
CREATE loss1 (DBL) TO TENSOR_SUM(sq).
CREATE dW1 (TENSOR) TO GRAD(loss1, W1, 1).
CREATE dW2 (TENSOR) TO GRAD(loss1, W2, 1).
TAPE_CLEAR().
CREATE s1 (TENSOR) TO TENSOR_SCALE(dW1, 5.0).
CREATE s2 (TENSOR) TO TENSOR_SCALE(dW2, 5.0).
SET W1 TO TENSOR_SUB(W1, s1).
SET W2 TO TENSOR_SUB(W2, s2).
CREATE h1b (TENSOR) TO DENSE_FORWARD(X, W1, b1).
CREATE h1nb (TENSOR) TO BATCHNORM_FORWARD(h1b, g, bb, 0.00001).
CREATE a1b (TENSOR) TO TENSOR_RELU(h1nb).
CREATE d1b (TENSOR) TO DROPOUT_FORWARD(a1b, 0.0, 1).
CREATE outb (TENSOR) TO DENSE_FORWARD(d1b, W2, b2).
CREATE pb (TENSOR) TO TENSOR_SOFTMAX(outb, 1).
CREATE diffb (TENSOR) TO TENSOR_SUB(pb, T).
CREATE sqb (TENSOR) TO TENSOR_MUL(diffb, diffb).
CREATE loss2 (DBL) TO TENSOR_SUM(sqb).
TAPE_CLEAR().
SHOW loss1.
SHOW loss2.
TENSOR_FREE(sqb).
TENSOR_FREE(diffb).
TENSOR_FREE(pb).
TENSOR_FREE(outb).
TENSOR_FREE(d1b).
TENSOR_FREE(a1b).
TENSOR_FREE(h1nb).
TENSOR_FREE(h1b).
TENSOR_FREE(s2).
TENSOR_FREE(s1).
TENSOR_FREE(dW2).
TENSOR_FREE(dW1).
TENSOR_FREE(sq).
TENSOR_FREE(diff).
TENSOR_FREE(p).
TENSOR_FREE(out).
TENSOR_FREE(d1).
TENSOR_FREE(a1).
TENSOR_FREE(h1n).
TENSOR_FREE(h1).
TENSOR_FREE(T).
TENSOR_FREE(b2).
TENSOR_FREE(W2).
TENSOR_FREE(bb).
TENSOR_FREE(g).
TENSOR_FREE(b1).
TENSOR_FREE(W1).
TENSOR_FREE(X).
SHOW "nn-end-to-end-ok".
