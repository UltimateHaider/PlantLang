CREATE a (TENSOR) TO TENSOR([[1.0, 2.0], [3.0, 4.0]]).
CREATE b (TENSOR) TO TENSOR([[5.0, 6.0], [7.0, 8.0]]).
TENSOR_TRACK(a).
TENSOR_TRACK(b).
CREATE c1 (TENSOR) TO TENSOR_MATMUL(a, b).
CREATE loss1 (DBL) TO TENSOR_SUM(c1).
CREATE da (TENSOR) TO GRAD(loss1, a).
SHOW da.
CREATE c2 (TENSOR) TO TENSOR_MATMUL(a, b).
CREATE loss2 (DBL) TO TENSOR_SUM(c2).
CREATE db (TENSOR) TO GRAD(loss2, b).
SHOW db.
