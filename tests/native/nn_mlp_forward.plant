# MLP forward: DENSE -> BatchNorm -> ReLU -> DENSE (2-row batch).
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0], [3.0, 4.0]]).
CREATE W1 (TENSOR) TO TENSOR([[0.5, 0.3], [0.2, 0.4]]).
CREATE b1 (TENSOR) TO TENSOR([0.1, 0.2]).
CREATE g (TENSOR) TO TENSOR([1.0, 1.0]).
CREATE bb (TENSOR) TO TENSOR([0.0, 0.0]).
CREATE W2 (TENSOR) TO TENSOR([[0.5], [0.5]]).
CREATE b2 (TENSOR) TO TENSOR([0.0]).
CREATE h1 (TENSOR) TO DENSE_FORWARD(X, W1, b1).
CREATE h1n (TENSOR) TO BATCHNORM_FORWARD(h1, g, bb, 0.00001).
CREATE a1 (TENSOR) TO TENSOR_RELU(h1n).
CREATE out (TENSOR) TO DENSE_FORWARD(a1, W2, b2).
SHOW h1.
SHOW h1n.
SHOW out.
TENSOR_FREE(out).
TENSOR_FREE(a1).
TENSOR_FREE(h1n).
TENSOR_FREE(h1).
TENSOR_FREE(b2).
TENSOR_FREE(W2).
TENSOR_FREE(bb).
TENSOR_FREE(g).
TENSOR_FREE(b1).
TENSOR_FREE(W1).
TENSOR_FREE(X).
SHOW "nn-mlp-forward-ok".
