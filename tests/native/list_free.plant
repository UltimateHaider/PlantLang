# tests/native/list_free.plant — Test LIST_FREE built-in
ACTION main(),
  # 1. list_free_basic: free a simple list
  CREATE L1 TO [10, 20, 30].
  SHOW L1.
  LIST_FREE(L1).
  SHOW "list_free_basic: PASS".

  # 2. list_free_nested: free a nested list
  CREATE L2 TO [[1, 2], [3, 4]].
  SHOW L2.
  LIST_FREE(L2).
  SHOW "list_free_nested: PASS".

  # 3. list_free_empty: free an empty list
  CREATE L3 TO [].
  SHOW L3.
  LIST_FREE(L3).
  SHOW "list_free_empty: PASS".

  # 4. list_free_strings: free a list of strings
  CREATE L4 TO ["hello", "world"].
  SHOW L4.
  LIST_FREE(L4).
  SHOW "list_free_strings: PASS".

  # 5. list_free_mixed: free a list with mixed types
  CREATE L5 TO [1, "two", 3].
  SHOW L5.
  LIST_FREE(L5).
  SHOW "list_free_mixed: PASS".

  # 6. list_free_then_reuse: free and create new list
  CREATE L6 TO [1, 2, 3].
  LIST_FREE(L6).
  CREATE L7 TO [4, 5, 6].
  SHOW L7.
  LIST_FREE(L7).
  SHOW "list_free_then_reuse: PASS".
/ACTION.
