# CONV2D (1x1 kernel -> 2x2 out) -> reshape [1,4] -> DENSE.
CREATE X (TENSOR) TO TENSOR([[[[1.0, 2.0], [3.0, 4.0]]]]).
CREATE K (TENSOR) TO TENSOR([[[[1.0]]]]).
CREATE b (TENSOR) TO TENSOR([0.0]).
CREATE y (TENSOR) TO CONV2D_FORWARD(X, K, b, 1, 0).
CREATE yf (TENSOR) TO TENSOR_RESHAPE_N(y, 2, 1, 4).
CREATE W (TENSOR) TO TENSOR([[0.5], [0.5], [0.5], [0.5]]).
CREATE b2 (TENSOR) TO TENSOR([0.0]).
CREATE out (TENSOR) TO DENSE_FORWARD(yf, W, b2).
SHOW out.
TENSOR_FREE(out).
TENSOR_FREE(b2).
TENSOR_FREE(W).
TENSOR_FREE(yf).
TENSOR_FREE(y).
TENSOR_FREE(b).
TENSOR_FREE(K).
TENSOR_FREE(X).
SHOW "conv2d-dense-stack-ok".
