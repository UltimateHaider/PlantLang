# DENSE + TANH + backward (dW; one GRAD per forward).
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0]]).
CREATE W (TENSOR) TO TENSOR([[0.5], [0.5]]).
CREATE b (TENSOR) TO TENSOR([0.0]).
TENSOR_TRACK(W).
CREATE h (TENSOR) TO DENSE_FORWARD(X, W, b).
CREATE a (TENSOR) TO TENSOR_TANH(h).
CREATE a2 (TENSOR) TO TENSOR_MUL(a, a).
CREATE loss (DBL) TO TENSOR_SUM(a2).
CREATE dW (TENSOR) TO GRAD(loss, W).
SHOW dW.
TENSOR_FREE(dW).
TENSOR_FREE(a2).
TENSOR_FREE(a).
TENSOR_FREE(h).
TENSOR_FREE(b).
TENSOR_FREE(W).
TENSOR_FREE(X).
SHOW "dense-tanh-ok".
