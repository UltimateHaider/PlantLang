# TD-048: GRAD_HO(TENSOR_SWISH) at 0 = 0.5.
CREATE a (TENSOR) TO TENSOR([0.0]).
TENSOR_TRACK(a).
CREATE c (TENSOR) TO TENSOR_SWISH(a).
CREATE loss (DBL) TO TENSOR_SUM(c).
CREATE da (TENSOR) TO GRAD_HO(loss, a).
SHOW da.
TAPE_CLEAR().
TENSOR_FREE(da).
TENSOR_FREE(c).
TENSOR_FREE(a).
SHOW "td048-adv2-swish-ok".
