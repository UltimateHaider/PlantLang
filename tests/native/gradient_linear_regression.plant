CREATE X (TENSOR) TO TENSOR([[1.0, 2.0], [3.0, 4.0]]).
CREATE y (TENSOR) TO TENSOR([[5.0], [11.0]]).
CREATE w (TENSOR) TO TENSOR([[0.5], [0.5]]).
TENSOR_TRACK(w).
CREATE pred (TENSOR) TO TENSOR_MATMUL(X, w).
CREATE diff (TENSOR) TO TENSOR_SUB(pred, y).
CREATE sq (TENSOR) TO TENSOR_MUL(diff, diff).
CREATE loss (DBL) TO TENSOR_MEAN(sq).
CREATE dw (TENSOR) TO GRAD(loss, w).
SHOW dw.
