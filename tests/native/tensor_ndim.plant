# tests/native/tensor_ndim.plant — Test TENSOR_NDIM introspection
ACTION main(),
  # 1. ndim_1d
  CREATE T1 TO TENSOR([1, 2, 3]).
  SHOW TENSOR_NDIM(T1).
  TENSOR_FREE(T1).

  # 2. ndim_2d
  CREATE T2 TO TENSOR([[1, 2], [3, 4]]).
  SHOW TENSOR_NDIM(T2).
  TENSOR_FREE(T2).

  # 3. ndim_3d
  CREATE T3 TO TENSOR([[[1, 2]]]).
  SHOW TENSOR_NDIM(T3).
  TENSOR_FREE(T3).

  # 4. ndim_6d
  CREATE T6 TO TENSOR([[[[[[1, 2]]]]]]).
  SHOW TENSOR_NDIM(T6).
  TENSOR_FREE(T6).
/ACTION.
