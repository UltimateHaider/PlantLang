# TD-048 (0b): 3rd+ derivatives -> explicit error (no silent-wrong).
CREATE x (TENSOR) TO TENSOR([1.0, 2.0]).
TENSOR_TRACK(x).
CREATE s (TENSOR) TO TENSOR_MUL(TENSOR_MUL(x, x), x).
CREATE loss (DBL) TO TENSOR_SUM(s).
CREATE dx (TENSOR) TO GRAD_HO(loss, x).
CREATE ddx (TENSOR) TO GRAD_HO(TENSOR_SUM(dx), x).
CREATE ddxx (TENSOR) TO GRAD_HO(TENSOR_SUM(ddx), x).
SHOW ddxx.
TAPE_CLEAR().
TENSOR_FREE(ddxx).
TENSOR_FREE(ddx).
TENSOR_FREE(dx).
TENSOR_FREE(s).
TENSOR_FREE(x).
SHOW "td048-adv2-third-unsupported-ok".
