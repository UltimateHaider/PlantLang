# BatchNorm backward: dbeta = sum(dy).
CREATE X (TENSOR) TO TENSOR([[1.0], [2.0], [3.0], [4.0]]).
CREATE g (TENSOR) TO TENSOR([1.0]).
CREATE b (TENSOR) TO TENSOR([0.0]).
CREATE M (TENSOR) TO TENSOR([[1.0], [2.0], [3.0], [4.0]]).
TENSOR_TRACK(b).
CREATE y (TENSOR) TO BATCHNORM_FORWARD(X, g, b, 0.00001).
CREATE ym (TENSOR) TO TENSOR_MUL(y, M).
CREATE loss (DBL) TO TENSOR_SUM(ym).
CREATE db (TENSOR) TO GRAD(loss, b, 1).
SHOW db.
TAPE_CLEAR().
TENSOR_FREE(db).
TENSOR_FREE(ym).
TENSOR_FREE(y).
TENSOR_FREE(M).
TENSOR_FREE(b).
TENSOR_FREE(g).
TENSOR_FREE(X).
SHOW "batchnorm-backward-beta-ok".
