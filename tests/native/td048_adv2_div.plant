# TD-048: GRAD_HO(TENSOR_DIV) w.r.t. a = 1/b.
CREATE a (TENSOR) TO TENSOR([4.0, 8.0]).
CREATE b (TENSOR) TO TENSOR([2.0, 4.0]).
TENSOR_TRACK(a).
CREATE c (TENSOR) TO TENSOR_DIV(a, b).
CREATE loss (DBL) TO TENSOR_SUM(c).
CREATE da (TENSOR) TO GRAD_HO(loss, a).
SHOW da.
TAPE_CLEAR().
TENSOR_FREE(da).
TENSOR_FREE(c).
TENSOR_FREE(a).
TENSOR_FREE(b).
SHOW "td048-adv2-div-ok".
