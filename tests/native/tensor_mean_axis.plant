# TD-068: MEAN_AXIS forward (axis 0 / 1) + backward.
CREATE x (TENSOR) TO TENSOR([[1.0, 2.0], [3.0, 4.0]]).
CREATE m0 (TENSOR) TO MEAN_AXIS(x, 0).
CREATE m1 (TENSOR) TO MEAN_AXIS(x, 1).
SHOW m0.
SHOW m1.
TENSOR_TRACK(x).
CREATE m (TENSOR) TO MEAN_AXIS(x, 1).
CREATE sq (TENSOR) TO TENSOR_MUL(m, m).
CREATE loss (DBL) TO TENSOR_SUM(sq).
CREATE dx (TENSOR) TO GRAD(loss, x, 1).
SHOW dx.
TAPE_CLEAR().
TENSOR_FREE(dx).
TENSOR_FREE(sq).
TENSOR_FREE(m).
TENSOR_FREE(m1).
TENSOR_FREE(m0).
TENSOR_FREE(x).
SHOW "tensor-mean-axis-ok".
