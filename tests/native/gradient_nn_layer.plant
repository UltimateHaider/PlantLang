CREATE X (TENSOR) TO TENSOR([[1.0, 2.0]]).
CREATE W (TENSOR) TO TENSOR([[1.0], [1.0]]).
CREATE b (TENSOR) TO TENSOR([[0.0]]).
TENSOR_TRACK(W).
TENSOR_TRACK(b).
CREATE z (TENSOR) TO TENSOR_MATMUL(X, W).
CREATE h (TENSOR) TO TENSOR_ADD(z, b).
CREATE a (TENSOR) TO TENSOR_RELU(h).
CREATE loss (DBL) TO TENSOR_SUM(a).
CREATE dW (TENSOR) TO GRAD(loss, W).
SHOW dW.
CREATE z2 (TENSOR) TO TENSOR_MATMUL(X, W).
CREATE h2 (TENSOR) TO TENSOR_ADD(z2, b).
CREATE a2 (TENSOR) TO TENSOR_RELU(h2).
CREATE loss2 (DBL) TO TENSOR_SUM(a2).
CREATE db (TENSOR) TO GRAD(loss2, b).
SHOW db.
