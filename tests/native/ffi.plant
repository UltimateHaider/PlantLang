ACTION ffi_swap_ref(a(REF LON), b(REF LON)) -> external.
ACTION ffi_add(a(LON), b(LON)) -> external.
ACTION ffi_open_mock(mode(LON)) -> Result<LON, TXT>.
ACTION ffi_parse_cfg(path(TXT)) -> Result<LON, TXT>.
ACTION ffi_make_buf(n(LON)) -> external.

ACTION main(),
  # ── plain FFI call ─────────────────────────────────────────
  REAP s0 FROM ffi_add, 2, 3.
  SHOW "add=" + s0.
  # ── REF pass-by-reference: swap through pointers ───────────
  CREATE a(LON) TO 10.
  CREATE b(LON) TO 20.
  REAP _ FROM ffi_swap_ref, a, b.
  REAP s1 FROM ffi_add, a, 0.
  SHOW "a-after=" + s1.
  REAP s2 FROM ffi_add, b, 0.
  SHOW "b-after=" + s2.
  REAP s3 FROM ffi_add, a, b.
  SHOW "sum=" + s3.
  # ── Result<LON, TXT>: failure path ──────────────────────────
  REAP h1 FROM ffi_open_mock, 0.
  SHOW "open-bad=" + h1.
  CREATE e1(LON) TO 0.
  REAP e1 FROM ffi_last_error.
  CREATE e1s(TXT) TO "".
  REAP e1s FROM _from_long, e1.
  SHOW "errno=" + e1s.
  REAP m1 FROM ffi_last_error_msg.
  SHOW "errmsg=" + m1.
  # ── Result<LON, TXT>: success path (errno cleared) ──────────
  REAP h2 FROM ffi_open_mock, 1.
  SHOW "open-ok=" + h2.
  CREATE e2(LON) TO 0.
  REAP e2 FROM ffi_last_error.
  CREATE e2s(TXT) TO "".
  REAP e2s FROM _from_long, e2.
  SHOW "errno-clear=" + e2s.
  # ── Result<TXT-returning, TXT>: parse cfg ────────────────────
  CREATE c1(LON) TO 0.
  REAP c1 FROM ffi_parse_cfg, "bad".
  CREATE c1s(TXT) TO "".
  REAP c1s FROM _from_long, c1.
  SHOW "cfg-bad=" + c1s.
  CREATE e3(LON) TO 0.
  REAP e3 FROM ffi_last_error.
  CREATE e3s(TXT) TO "".
  REAP e3s FROM _from_long, e3.
  SHOW "cfg-errno=" + e3s.
  REAP m3 FROM ffi_last_error_msg.
  SHOW "cfg-errmsg=" + m3.
  CREATE c2(LON) TO 0.
  REAP c2 FROM ffi_parse_cfg, "ok".
  CREATE c2s(TXT) TO "".
  REAP c2s FROM _from_long, c2.
  SHOW "cfg-ok=" + c2s.
  # ── ffi_free lifecycle ─────────────────────────────────────
  REAP buf FROM ffi_make_buf, 100.
  CREATE bl(LON) TO LEN(buf).
  CREATE bls(TXT) TO "".
  REAP bls FROM _from_long, bl.
  SHOW "buflen=" + bls.
  REAP _ FROM ffi_free, buf.
  CREATE e4(LON) TO 0.
  REAP e4 FROM ffi_last_error.
  CREATE e4s(TXT) TO "".
  REAP e4s FROM _from_long, e4.
  SHOW "free-ok=" + e4s.
  REAP _ FROM ffi_free, NULL.
  CREATE e5(LON) TO 0.
  REAP e5 FROM ffi_last_error.
  CREATE e5s(TXT) TO "".
  REAP e5s FROM _from_long, e5.
  SHOW "free-null=" + e5s.
  GIVE 0.
/GIVE main.
