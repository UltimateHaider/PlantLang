CREATE a (TENSOR) TO TENSOR([1.0, 2.0, 3.0]).
CREATE b (TENSOR) TO TENSOR([4.0, 5.0, 6.0]).
TENSOR_TRACK(a).
TENSOR_TRACK(b).
CREATE s (TENSOR) TO TENSOR_ADD(a, b).
CREATE loss (DBL) TO TENSOR_SUM(s).
CREATE da (TENSOR) TO GRAD(loss, a).
CREATE s2 (TENSOR) TO TENSOR_ADD(a, b).
CREATE loss2 (DBL) TO TENSOR_SUM(s2).
CREATE db (TENSOR) TO GRAD(loss2, b).
SHOW da.
SHOW db.
