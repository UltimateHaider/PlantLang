# TD-068: TENSOR_SQRT forward + backward (1/(2 sqrt x)).
CREATE x (TENSOR) TO TENSOR([4.0, 9.0, 16.0]).
CREATE y (TENSOR) TO TENSOR_SQRT(x).
SHOW y.
TENSOR_TRACK(x).
CREATE y2 (TENSOR) TO TENSOR_SQRT(x).
CREATE sq (TENSOR) TO TENSOR_MUL(y2, y2).
CREATE loss (DBL) TO TENSOR_SUM(sq).
CREATE dx (TENSOR) TO GRAD(loss, x, 1).
SHOW dx.
TAPE_CLEAR().
TENSOR_FREE(dx).
TENSOR_FREE(sq).
TENSOR_FREE(y2).
TENSOR_FREE(y).
TENSOR_FREE(x).
SHOW "tensor-sqrt-ok".
