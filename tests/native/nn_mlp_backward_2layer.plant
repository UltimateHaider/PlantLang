# 2-layer MLP (DENSE->ReLU->DENSE); one GRAD per forward (TD-066).
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0]]).
CREATE W1 (TENSOR) TO TENSOR([[0.5, 0.3], [0.2, 0.4]]).
CREATE b1 (TENSOR) TO TENSOR([0.1, 0.2]).
CREATE W2 (TENSOR) TO TENSOR([[0.5], [0.5]]).
CREATE b2 (TENSOR) TO TENSOR([0.0]).
TENSOR_TRACK(W2).
CREATE h1 (TENSOR) TO DENSE_FORWARD(X, W1, b1).
CREATE a1 (TENSOR) TO TENSOR_RELU(h1).
CREATE h2 (TENSOR) TO DENSE_FORWARD(a1, W2, b2).
CREATE h2sq (TENSOR) TO TENSOR_MUL(h2, h2).
CREATE loss (DBL) TO TENSOR_SUM(h2sq).
CREATE dW2 (TENSOR) TO GRAD(loss, W2).
TAPE_CLEAR().
TENSOR_TRACK(W1).
CREATE h1b (TENSOR) TO DENSE_FORWARD(X, W1, b1).
CREATE a1b (TENSOR) TO TENSOR_RELU(h1b).
CREATE h2b (TENSOR) TO DENSE_FORWARD(a1b, W2, b2).
CREATE h2sqb (TENSOR) TO TENSOR_MUL(h2b, h2b).
CREATE lossb (DBL) TO TENSOR_SUM(h2sqb).
CREATE dW1 (TENSOR) TO GRAD(lossb, W1).
SHOW dW1.
SHOW dW2.
TENSOR_FREE(dW1).
TENSOR_FREE(dW2).
TENSOR_FREE(h2sqb).
TENSOR_FREE(h2b).
TENSOR_FREE(a1b).
TENSOR_FREE(h1b).
TENSOR_FREE(h2sq).
TENSOR_FREE(h2).
TENSOR_FREE(a1).
TENSOR_FREE(h1).
TENSOR_FREE(b2).
TENSOR_FREE(W2).
TENSOR_FREE(b1).
TENSOR_FREE(W1).
TENSOR_FREE(X).
SHOW "nn-mlp-2layer-ok".
