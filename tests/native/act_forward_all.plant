# All 7 activations forward on a fixed input.
CREATE x (TENSOR) TO TENSOR([-1.0, 0.0, 1.0]).
CREATE r (TENSOR) TO TENSOR_RELU(x).
CREATE s (TENSOR) TO TENSOR_SIGMOID(x).
CREATE t (TENSOR) TO TENSOR_TANH(x).
CREATE g (TENSOR) TO TENSOR_GELU(x).
CREATE sw (TENSOR) TO TENSOR_SWISH(x).
CREATE m (TENSOR) TO TENSOR_MISH(x).
CREATE sm (TENSOR) TO TENSOR_SOFTMAX(x, 0).
SHOW r.
SHOW s.
SHOW t.
SHOW g.
SHOW sw.
SHOW m.
SHOW sm.
TENSOR_FREE(sm).
TENSOR_FREE(m).
TENSOR_FREE(sw).
TENSOR_FREE(g).
TENSOR_FREE(t).
TENSOR_FREE(s).
TENSOR_FREE(r).
TENSOR_FREE(x).
SHOW "act-forward-all-ok".
