# v0.50.0e — comprehensive ARRAY[T, N] test.

SHOW "=== ARRAY comprehensive ===".

# LON array via CREATE.
CREATE nums(ARRAY[LON, 5]) TO [10, 20, 30, 40, 50].
SHOW "nums: created".

# LON array via lowercase array syntax.
array[LON, 3] codes = [65, 66, 67].
SHOW "codes: created".

# NUM array via CREATE.
CREATE flags(ARRAY[NUM, 3]) TO [1, 0, 1].
SHOW "flags: created".

# DBL array via CREATE.
CREATE ratios(ARRAY[DBL, 3]) TO [1.5, 2.5, 3.5].
SHOW "ratios: created".

# Empty LON array (default init).
CREATE zeros(ARRAY[LON, 4]) TO [0, 0, 0, 0].
SHOW "zeros: created".

SHOW "=== all arrays created ===".
