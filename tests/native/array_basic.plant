# v0.50.0e — comprehensive ARRAY[T, N] test.

SHOW "=== ARRAY comprehensive ===".

# NUM array via CREATE.
CREATE nums(ARRAY[NUM, 5]) TO [10, 20, 30, 40, 50].
SHOW "nums: created".

# NUM array via lowercase array syntax.
array[NUM, 3] codes = [65, 66, 67].
SHOW "codes: created".

# FACT array via CREATE.
CREATE flags(ARRAY[FACT, 3]) TO [1, 0, 1].
SHOW "flags: created".

# SCL array via CREATE.
CREATE ratios(ARRAY[SCL, 3]) TO [1.5, 2.5, 3.5].
SHOW "ratios: created".

# Empty NUM array (default init).
CREATE zeros(ARRAY[NUM, 4]) TO [0, 0, 0, 0].
SHOW "zeros: created".

SHOW "=== all arrays created ===".
