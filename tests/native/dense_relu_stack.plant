# DENSE + ReLU (2 layers).
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0]]).
CREATE W1 (TENSOR) TO TENSOR([[0.5, 0.3], [0.2, 0.4]]).
CREATE b1 (TENSOR) TO TENSOR([0.1, 0.2]).
CREATE W2 (TENSOR) TO TENSOR([[0.5], [0.5]]).
CREATE b2 (TENSOR) TO TENSOR([0.0]).
CREATE h (TENSOR) TO DENSE_FORWARD(X, W1, b1).
CREATE a (TENSOR) TO TENSOR_RELU(h).
CREATE out (TENSOR) TO DENSE_FORWARD(a, W2, b2).
SHOW out.
TENSOR_FREE(out).
TENSOR_FREE(a).
TENSOR_FREE(h).
TENSOR_FREE(b2).
TENSOR_FREE(W2).
TENSOR_FREE(b1).
TENSOR_FREE(W1).
TENSOR_FREE(X).
SHOW "dense-relu-stack-ok".
