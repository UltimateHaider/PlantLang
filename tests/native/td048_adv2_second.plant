# TD-048: GRAD_HO(GRAD_HO(x^2), x) = 2 (second derivative).
CREATE x (TENSOR) TO TENSOR([1.0, 2.0, 3.0]).
TENSOR_TRACK(x).
CREATE s (TENSOR) TO TENSOR_MUL(x, x).
CREATE loss (DBL) TO TENSOR_SUM(s).
CREATE dx (TENSOR) TO GRAD_HO(loss, x).
CREATE ddx (TENSOR) TO GRAD_HO(TENSOR_SUM(dx), x).
SHOW ddx.
TAPE_CLEAR().
TENSOR_FREE(ddx).
TENSOR_FREE(dx).
TENSOR_FREE(s).
TENSOR_FREE(x).
SHOW "td048-adv2-second-ok".
