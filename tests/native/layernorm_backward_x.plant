# LayerNorm backward: dX through the last-axis normalize.
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0, 3.0]]).
CREATE g (TENSOR) TO TENSOR([1.0, 1.0, 1.0]).
CREATE b (TENSOR) TO TENSOR([0.0, 0.0, 0.0]).
CREATE M (TENSOR) TO TENSOR([1.0, 0.0, 0.0]).
TENSOR_TRACK(X).
CREATE y (TENSOR) TO LAYERNORM_FORWARD(X, g, b, 0.00001).
CREATE ym (TENSOR) TO TENSOR_MUL(y, M).
CREATE loss (DBL) TO TENSOR_SUM(ym).
CREATE dX (TENSOR) TO GRAD(loss, X, 1).
SHOW dX.
TAPE_CLEAR().
TENSOR_FREE(dX).
TENSOR_FREE(ym).
TENSOR_FREE(y).
TENSOR_FREE(M).
TENSOR_FREE(b).
TENSOR_FREE(g).
TENSOR_FREE(X).
SHOW "layernorm-backward-x-ok".
