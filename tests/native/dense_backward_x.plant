# DENSE backward: dX = (2y) * W^T.
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0], [3.0, 4.0]]).
CREATE W (TENSOR) TO TENSOR([[0.5], [0.5]]).
CREATE b (TENSOR) TO TENSOR([0.0]).
TENSOR_TRACK(X).
CREATE y (TENSOR) TO DENSE_FORWARD(X, W, b).
CREATE y2 (TENSOR) TO TENSOR_MUL(y, y).
CREATE loss (DBL) TO TENSOR_SUM(y2).
CREATE dX (TENSOR) TO GRAD(loss, X, 1).
SHOW dX.
TAPE_CLEAR().
TENSOR_FREE(dX).
TENSOR_FREE(y2).
TENSOR_FREE(y).
TENSOR_FREE(b).
TENSOR_FREE(W).
TENSOR_FREE(X).
SHOW "dense-backward-x-ok".
