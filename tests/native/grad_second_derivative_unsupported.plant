# v0.57.4 — TD-048 hotfix: second derivative -> explicit error (was silent)
CREATE x (TENSOR) TO TENSOR([1.0, 2.0]).
TENSOR_TRACK(x).
CREATE s (TENSOR) TO TENSOR_MUL(x, x).
CREATE loss (DBL) TO TENSOR_SUM(s).
CREATE dx (TENSOR) TO GRAD(loss, x, 1).
SHOW dx.
CREATE ddx (TENSOR) TO GRAD(TENSOR_SUM(dx), x, 1).
SHOW ddx.
TAPE_CLEAR().
TENSOR_FREE(dx).
TENSOR_FREE(ddx).
TENSOR_FREE(s).
TENSOR_FREE(x).
SHOW "second-deriv-error-ok".
