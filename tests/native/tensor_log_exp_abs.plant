# TD-069: LOG/EXP/ABS forward + backward (named intermediates).
CREATE x (TENSOR) TO TENSOR([1.0, 2.0, 4.0]).
CREATE z (TENSOR) TO TENSOR([0.0, 1.0]).
CREATE w (TENSOR) TO TENSOR([-2.0, 3.0]).
CREATE l (TENSOR) TO TENSOR_LOG(x).
CREATE e (TENSOR) TO TENSOR_EXP(z).
CREATE a (TENSOR) TO TENSOR_ABS(w).
SHOW l.
SHOW e.
SHOW a.
TENSOR_TRACK(x).
CREATE lg (TENSOR) TO TENSOR_LOG(x).
CREATE loss (DBL) TO TENSOR_SUM(lg).
CREATE dx (TENSOR) TO GRAD(loss, x, 1).
SHOW dx.
TAPE_CLEAR().
TENSOR_FREE(dx).
TENSOR_FREE(lg).
TENSOR_FREE(a).
TENSOR_FREE(e).
TENSOR_FREE(l).
TENSOR_FREE(w).
TENSOR_FREE(z).
TENSOR_FREE(x).
SHOW "tensor-log-exp-abs-ok".
