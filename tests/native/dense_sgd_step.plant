# SGD step: W <- W - 0.01*dW.
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0]]).
CREATE W (TENSOR) TO TENSOR([[0.5], [0.5]]).
CREATE b (TENSOR) TO TENSOR([0.0]).
TENSOR_TRACK(W).
CREATE y (TENSOR) TO DENSE_FORWARD(X, W, b).
CREATE y2 (TENSOR) TO TENSOR_MUL(y, y).
CREATE loss (DBL) TO TENSOR_SUM(y2).
CREATE dW (TENSOR) TO GRAD(loss, W, 1).
CREATE step (TENSOR) TO TENSOR_SCALE(dW, 0.01).
CREATE W2 (TENSOR) TO TENSOR_SUB(W, step).
SHOW W2.
TAPE_CLEAR().
TENSOR_FREE(W2).
TENSOR_FREE(step).
TENSOR_FREE(dW).
TENSOR_FREE(y2).
TENSOR_FREE(y).
TENSOR_FREE(b).
TENSOR_FREE(W).
TENSOR_FREE(X).
SHOW "dense-sgd-step-ok".
