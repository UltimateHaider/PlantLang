# MLP training step: dW1/dW2 then SGD update; loss must decrease.
CREATE X (TENSOR) TO TENSOR([[1.0, 2.0]]).
CREATE W1 (TENSOR) TO TENSOR([[0.5], [0.5]]).
CREATE b1 (TENSOR) TO TENSOR([0.0]).
CREATE W2 (TENSOR) TO TENSOR([[0.5]]).
CREATE b2 (TENSOR) TO TENSOR([0.0]).
TENSOR_TRACK(W1).
TENSOR_TRACK(W2).
CREATE h1 (TENSOR) TO DENSE_FORWARD(X, W1, b1).
CREATE a1 (TENSOR) TO TENSOR_RELU(h1).
CREATE out (TENSOR) TO DENSE_FORWARD(a1, W2, b2).
CREATE sq (TENSOR) TO TENSOR_MUL(out, out).
CREATE loss1 (DBL) TO TENSOR_SUM(sq).
CREATE dW1 (TENSOR) TO GRAD(loss1, W1, 1).
CREATE dW2 (TENSOR) TO GRAD(loss1, W2, 1).
TAPE_CLEAR().
CREATE s1 (TENSOR) TO TENSOR_SCALE(dW1, 0.1).
CREATE s2 (TENSOR) TO TENSOR_SCALE(dW2, 0.1).
SET W1 TO TENSOR_SUB(W1, s1).
SET W2 TO TENSOR_SUB(W2, s2).
CREATE h1b (TENSOR) TO DENSE_FORWARD(X, W1, b1).
CREATE a1b (TENSOR) TO TENSOR_RELU(h1b).
CREATE outb (TENSOR) TO DENSE_FORWARD(a1b, W2, b2).
CREATE sqb (TENSOR) TO TENSOR_MUL(outb, outb).
CREATE loss2 (DBL) TO TENSOR_SUM(sqb).
TAPE_CLEAR().
SHOW loss1.
SHOW loss2.
TENSOR_FREE(sqb).
TENSOR_FREE(outb).
TENSOR_FREE(a1b).
TENSOR_FREE(h1b).
TENSOR_FREE(s2).
TENSOR_FREE(s1).
TENSOR_FREE(dW2).
TENSOR_FREE(dW1).
TENSOR_FREE(sq).
TENSOR_FREE(out).
TENSOR_FREE(a1).
TENSOR_FREE(h1).
TENSOR_FREE(b2).
TENSOR_FREE(W2).
TENSOR_FREE(b1).
TENSOR_FREE(W1).
TENSOR_FREE(X).
SHOW "nn-mlp-train-step-ok".
