# TD-048: GRAD_HO(TENSOR_RELU) = d * (a > 0).
CREATE a (TENSOR) TO TENSOR([-1.0, 0.0, 2.0]).
TENSOR_TRACK(a).
CREATE c (TENSOR) TO TENSOR_RELU(a).
CREATE loss (DBL) TO TENSOR_SUM(c).
CREATE da (TENSOR) TO GRAD_HO(loss, a).
SHOW da.
TAPE_CLEAR().
TENSOR_FREE(da).
TENSOR_FREE(c).
TENSOR_FREE(a).
SHOW "td048-adv2-relu-ok".
