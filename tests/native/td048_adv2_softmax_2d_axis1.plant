# TD-048: softmax 2D axis=1 (rows) — sum(softmax) gradient is zero.
CREATE a (TENSOR) TO TENSOR([[1.0, 2.0], [3.0, 4.0]]).
TENSOR_TRACK(a).
CREATE s (TENSOR) TO TENSOR_SOFTMAX(a, 1).
CREATE loss (DBL) TO TENSOR_SUM(s).
CREATE da (TENSOR) TO GRAD_HO(loss, a).
SHOW da.
TAPE_CLEAR().
TENSOR_FREE(da).
TENSOR_FREE(s).
TENSOR_FREE(a).
SHOW "td048-adv2-softmax-2d-axis1-ok".
