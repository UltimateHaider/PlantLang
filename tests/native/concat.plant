ACTION main(),
  CREATE a(TX) TO "".
  CREATE b(TX) TO "".
  CREATE c(TX) TO "".
  CREATE d(TX) TO "".
  SET a TO "n" + 5.
  SHOW a.
  SET b TO 5 + "k".
  SHOW b.
  SET c TO "x=" + _cat("y", "z").
  SHOW c.
  SET d TO "pi=" + 3.
  SHOW d.
  # v0.48.3a: bare numeric vars auto-concat in string mixes
  CREATE x(NUM) TO 41.
  CREATE msg(TX) TO "hi".
  CREATE e(TX) TO "x=" + x.
  SHOW e.
  CREATE f(TX) TO "multi " + msg + " " + x + "!".
  SHOW f.
  CREATE g(TX) TO "idx " + x.
  SHOW g.
  CREATE h(TX) TO "expr " + (x + 1).
  SHOW h.
  CREATE j(TX) TO "len " + LEN(msg).
  SHOW j.
  # numeric-only expressions must stay arithmetic, not concat
  CREATE k(NUM) TO 7 + 2.
  CREATE k2(TX) TO "" + k.
  SHOW k2.
  CREATE l(NUM) TO x + 3.
  CREATE l2(TX) TO "" + l.
  SHOW l2.
  GIVE 0.
/GIVE main.
