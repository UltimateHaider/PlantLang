ACTION main(),
  CREATE a(TXT) TO "".
  CREATE b(TXT) TO "".
  CREATE c(TXT) TO "".
  CREATE d(TXT) TO "".
  SET a TO "n" + 5.
  SHOW a.
  SET b TO 5 + "k".
  SHOW b.
  SET c TO "x=" + _cat("y", "z").
  SHOW c.
  SET d TO "pi=" + 3.
  SHOW d.
  # v0.48.3a: bare numeric vars auto-concat in string mixes
  CREATE x(LON) TO 41.
  CREATE msg(TXT) TO "hi".
  CREATE e(TXT) TO "x=" + x.
  SHOW e.
  CREATE f(TXT) TO "multi " + msg + " " + x + "!".
  SHOW f.
  CREATE g(TXT) TO "idx " + x.
  SHOW g.
  CREATE h(TXT) TO "expr " + (x + 1).
  SHOW h.
  CREATE j(TXT) TO "len " + LEN(msg).
  SHOW j.
  # numeric-only expressions must stay arithmetic, not concat
  CREATE k(LON) TO 7 + 2.
  CREATE k2(TXT) TO "" + k.
  SHOW k2.
  CREATE l(LON) TO x + 3.
  CREATE l2(TXT) TO "" + l.
  SHOW l2.
  GIVE 0.
/GIVE main.
