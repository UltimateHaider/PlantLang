# TD-068: SUM_AXIS forward + backward.
CREATE x (TENSOR) TO TENSOR([[1.0, 2.0], [3.0, 4.0]]).
CREATE s0 (TENSOR) TO SUM_AXIS(x, 0).
CREATE s1 (TENSOR) TO SUM_AXIS(x, 1).
SHOW s0.
SHOW s1.
TENSOR_TRACK(x).
CREATE s (TENSOR) TO SUM_AXIS(x, 1).
CREATE sq (TENSOR) TO TENSOR_MUL(s, s).
CREATE loss (DBL) TO TENSOR_SUM(sq).
CREATE dx (TENSOR) TO GRAD(loss, x, 1).
SHOW dx.
TAPE_CLEAR().
TENSOR_FREE(dx).
TENSOR_FREE(sq).
TENSOR_FREE(s).
TENSOR_FREE(s1).
TENSOR_FREE(s0).
TENSOR_FREE(x).
SHOW "tensor-sum-axis-ok".
