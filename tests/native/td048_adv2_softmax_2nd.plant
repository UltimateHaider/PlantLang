# TD-048: softmax second-order derivative.
CREATE a (TENSOR) TO TENSOR([1.0, 2.0, 3.0]).
TENSOR_TRACK(a).
CREATE s (TENSOR) TO TENSOR_SOFTMAX(a, 0).
CREATE loss (DBL) TO TENSOR_SUM(s).
CREATE d1 (TENSOR) TO GRAD_HO(loss, a).
CREATE d2 (TENSOR) TO GRAD_HO(TENSOR_SUM(d1), a).
SHOW d2.
TAPE_CLEAR().
TENSOR_FREE(d2).
TENSOR_FREE(d1).
TENSOR_FREE(s).
TENSOR_FREE(a).
SHOW "td048-adv2-softmax-2nd-ok".
