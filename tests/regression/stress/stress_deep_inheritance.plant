# stress_deep_inheritance — 10-level SPECIES FROM chain with 5 methods per level.
# Validates deep type hierarchies, field inheritance, and method dispatch
# across 10 nested inheritance levels (v0.49.63).
SPECIES L0 {
  f0: TXT
  ACTION m0() -> TXT { GIVE "L0". }
  ACTION m1() -> TXT { GIVE "L0-m1". }
  ACTION m2() -> TXT { GIVE "L0-m2". }
  ACTION m3() -> TXT { GIVE "L0-m3". }
  ACTION m4() -> TXT { GIVE "L0-m4". }
}
SPECIES L1 FROM L0 {
  f1: TXT
  ACTION m0() -> TXT { GIVE "L1". }
  ACTION m5() -> TXT { GIVE "L1-m5". }
  ACTION m6() -> TXT { GIVE "L1-m6". }
  ACTION m7() -> TXT { GIVE "L1-m7". }
  ACTION m8() -> TXT { GIVE "L1-m8". }
}
SPECIES L2 FROM L1 {
  f2: TXT
  ACTION m0() -> TXT { GIVE "L2". }
  ACTION m9() -> TXT { GIVE "L2-m9". }
  ACTION m10() -> TXT { GIVE "L2-m10". }
  ACTION m11() -> TXT { GIVE "L2-m11". }
  ACTION m12() -> TXT { GIVE "L2-m12". }
}
SPECIES L3 FROM L2 {
  f3: TXT
  ACTION m0() -> TXT { GIVE "L3". }
  ACTION m13() -> TXT { GIVE "L3-m13". }
  ACTION m14() -> TXT { GIVE "L3-m14". }
  ACTION m15() -> TXT { GIVE "L3-m15". }
  ACTION m16() -> TXT { GIVE "L3-m16". }
}
SPECIES L4 FROM L3 {
  f4: TXT
  ACTION m0() -> TXT { GIVE "L4". }
  ACTION m17() -> TXT { GIVE "L4-m17". }
  ACTION m18() -> TXT { GIVE "L4-m18". }
  ACTION m19() -> TXT { GIVE "L4-m19". }
  ACTION m20() -> TXT { GIVE "L4-m20". }
}
SPECIES L5 FROM L4 {
  f5: TXT
  ACTION m0() -> TXT { GIVE "L5". }
  ACTION m21() -> TXT { GIVE "L5-m21". }
  ACTION m22() -> TXT { GIVE "L5-m22". }
  ACTION m23() -> TXT { GIVE "L5-m23". }
  ACTION m24() -> TXT { GIVE "L5-m24". }
}
SPECIES L6 FROM L5 {
  f6: TXT
  ACTION m0() -> TXT { GIVE "L6". }
  ACTION m25() -> TXT { GIVE "L6-m25". }
  ACTION m26() -> TXT { GIVE "L6-m26". }
  ACTION m27() -> TXT { GIVE "L6-m27". }
  ACTION m28() -> TXT { GIVE "L6-m28". }
}
SPECIES L7 FROM L6 {
  f7: TXT
  ACTION m0() -> TXT { GIVE "L7". }
  ACTION m29() -> TXT { GIVE "L7-m29". }
  ACTION m30() -> TXT { GIVE "L7-m30". }
  ACTION m31() -> TXT { GIVE "L7-m31". }
  ACTION m32() -> TXT { GIVE "L7-m32". }
}
SPECIES L8 FROM L7 {
  f8: TXT
  ACTION m0() -> TXT { GIVE "L8". }
  ACTION m33() -> TXT { GIVE "L8-m33". }
  ACTION m34() -> TXT { GIVE "L8-m34". }
  ACTION m35() -> TXT { GIVE "L8-m35". }
  ACTION m36() -> TXT { GIVE "L8-m36". }
}
SPECIES L9 FROM L8 {
  f9: TXT
  ACTION m0() -> TXT { GIVE "L9". }
  ACTION m37() -> TXT { GIVE "L9-m37". }
  ACTION m38() -> TXT { GIVE "L9-m38". }
  ACTION m39() -> TXT { GIVE "L9-m39". }
  ACTION m40() -> TXT { GIVE "L9-m40". }
}
ACTION main(),
  BLOOM L9 AS obj.
  CALL obj.put("f0", "v0").
  CALL obj.put("f5", "v5").
  CALL obj.put("f9", "v9").
  SHOW obj.f0.
  SHOW obj.f5.
  SHOW obj.f9.
  SHOW obj.m0().
  SHOW obj.m5().
  SHOW obj.m20().
  SHOW obj.m40().
  REAP chk1 FROM plant_is_a, obj, "L0".
  REAP chk2 FROM plant_is_a, obj, "L5".
  REAP chk3 FROM plant_is_a, obj, "L9".
  SHOW "isL0=" + chk1.
  SHOW "isL5=" + chk2.
  SHOW "isL9=" + chk3.
  GIVE 0.
/GIVE main.
