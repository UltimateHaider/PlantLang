# stress_combined — Multi-level inheritance stress.
# Validates type hierarchies with field inheritance and method dispatch
# across 3 levels (v0.49.63).
SPECIES Shape {
  color: TXT
  ACTION area() -> TXT { GIVE "0". }
  ACTION s0() -> TXT { GIVE "S0". }
  ACTION s1() -> TXT { GIVE "S1". }
  ACTION s2() -> TXT { GIVE "S2". }
  ACTION s3() -> TXT { GIVE "S3". }
  ACTION s4() -> TXT { GIVE "S4". }
  ACTION draw() -> TXT { GIVE "draw-shape". }
}
SPECIES Rect FROM Shape {
  w: TXT
  h: TXT
  ACTION r0() -> TXT { GIVE "R0". }
  ACTION r1() -> TXT { GIVE "R1". }
  ACTION r2() -> TXT { GIVE "R2". }
  ACTION r3() -> TXT { GIVE "R3". }
  ACTION r4() -> TXT { GIVE "R4". }
}
ACTION main(),
  BLOOM Rect AS r.
  CALL r.put("color", "blue").
  CALL r.put("w", "100").
  CALL r.put("h", "50").
  SHOW r.draw().
  SHOW r.area().
  SHOW r.s0().
  SHOW r.s4().
  REAP c1 FROM plant_is_a, r, "Shape".
  REAP c2 FROM plant_is_a, r, "Rect".
  SHOW "Shape=" + c1 + " Rect=" + c2.
  GIVE 0.
/GIVE main.
