ACTION main(),
  CREATE n(LON) TO 5.
  CREATE s(TXT) TO "B".
  CREATE r(TXT) TO "".
  SHOW "x=" + "a${n}b".
  SHOW "esc=\"${s}\"".
  SHOW "nl=a\nb".
  SHOW "quo=\"q\"".
  SET r TO "r=${n}".
  SHOW r.
  SET r TO "pre ${s} post".
  SHOW r.
  SHOW "multi=${n}x${n}".
  SHOW "cond=${n + 2 * n}".
  SHOW "quoted=${s + "${s}"}".
  GIVE 0.
/GIVE main.
