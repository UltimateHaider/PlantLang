# v0.48.21: CYCLE STEP clause — positive custom steps, negative
# steps (descending lo > hi), runtime step variables, and reverse
# ranges that must iterate down to and including hi.
ACTION main(),
  CREATE s(NUM) TO 0.
  CYCLE i FROM 1 TO 10 STEP 2,
    SET s TO s + i.
  /CYCLE.
  SHOW "odds1-9=" + s.
  CREATE s2(TX) TO "".
  CYCLE i FROM 5 TO 1 STEP -1,
    SET s2 TO s2 + _from_long(i) + " ".
  /CYCLE.
  SHOW "down=" + s2.
  CREATE s3(TX) TO "".
  CYCLE i FROM 10 TO 0 STEP -3,
    SET s3 TO s3 + _from_long(i) + " ".
  /CYCLE.
  SHOW "down3=" + s3.
  CREATE k(NUM) TO 2.
  CREATE s4(TX) TO "".
  CYCLE i FROM 1 TO 6 STEP k,
    SET s4 TO s4 + _from_long(i) + " ".
  /CYCLE.
  SHOW "runtime-step=" + s4.
  CREATE hit(TX) TO "none".
  CYCLE i FROM 1 TO 3 STEP -1,
    SET hit TO "ran".
  /CYCLE.
  SHOW "neg-norun=" + hit.
  CREATE s5(NUM) TO 0.
  CYCLE i FROM 10 TO 2 STEP -4,
    SET s5 TO s5 + i.
  /CYCLE.
  SHOW "sum10-2-4=" + s5.
  GIVE 0.
/GIVE main.
