ACTION main(),
  CREATE total(NUM) TO 0.
  CYCLE i FROM 1 TO 5,
    INCREASE total BY i.
    IF i IS 3, CONTINUE 0. /IF.
    DECREASE total BY 1.
  /CYCLE.
  SHOW "total=" + total.
  CREATE down(NUM) TO 0.
  CYCLE i FROM 3 TO 1 STEP -1,
    INCREASE down BY i.
  /CYCLE.
  SHOW "down=" + down.
  CREATE j(NUM) TO 0.
  CREATE items(LIST) TO plant_list_make(0).
  PUT "a" INTO items.
  PUT "b" INTO items.
  PUT "c" INTO items.
  CYCLE item, idx IN items,
    INCREASE j BY idx + 1.
  /CYCLE.
  SHOW "j=" + j.
  GIVE 0.
/GIVE main.
