# v0.49.23 - numerical analysis built-ins:
# LU EIGEN SVD SOLVE COND over nested-list matrices.
# LU -> [L, U] (partial pivoting folds into row order, PA = LU);
# EIGEN -> [values, vectors] for symmetric matrices (Jacobi, values
# sorted descending, vectors as columns); SVD -> [U, S, V] via the
# A^T A symmetric eigenproblem; SOLVE -> x; COND -> norm*norm(inv).
# All invalid states return "ERR". List results are rendered via
# FLATTEN + JOIN or bound to variables before positional indexing.
ACTION main(),
  SHOW "== lu ==".
  CREATE A(LIST) TO [[4, 3], [6, 3]].
  CREATE f(LIST) TO LU(A).
  SHOW JOIN(FLATTEN(f[0]), ",").
  SHOW JOIN(FLATTEN(f[1]), ",").
  SHOW "== eigen ==".
  CREATE S(LIST) TO [[2, 1], [1, 2]].
  CREATE eg(LIST) TO EIGEN(S).
  SHOW JOIN(eg[0], ",").
  SHOW JOIN(FLATTEN(eg[1]), ",").
  CREATE e2(LIST) TO EIGEN([[1, 5], [5, 1]]).
  SHOW JOIN(e2[0], ",").
  SHOW EIGEN([[1, 2], [3, 4]]).
  SHOW "== svd ==".
  CREATE s1(LIST) TO SVD([[3, 0], [0, 2]]).
  SHOW JOIN(s1[1], ",").
  CREATE s2(LIST) TO SVD([[4, 0], [0, 1], [0, 0]]).
  SHOW JOIN(s2[1], ",").
  SHOW "== solve ==".
  SHOW JOIN(SOLVE([[2, 1], [1, 3]], [5, 10]), ",").
  SHOW JOIN(SOLVE([[1, 0], [0, 1]], [7, 9]), ",").
  SHOW SOLVE([[1, 2], [2, 4]], [3, 6]).
  SHOW "== cond ==".
  SHOW COND([[1, 0], [0, 1]]).
  SHOW COND([[2, 0], [0, 2]]).
  SHOW COND([[1, 2], [2, 4]]).
  SHOW "== errors ==".
  SHOW LU([[1, 2, 3]]).
  SHOW EIGEN("nope").
  SHOW SOLVE([[2, 1]], [1]).
  GIVE 0.
/GIVE main.
