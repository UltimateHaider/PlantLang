# v0.49.28 - SPC + BLOOM object model:
#   SPC Name { field: TYPE ... }   (whitespace-separated fields)
#   BLOOM Name AS var                  -> map-backed record; fields
#   default to "" and are read/written via existing obj.field access
#   and .put(...) method calls.
SPC Person {
  name: TXT
  age: LON
}
SPC Empty { }
ACTION main(),
  BLOOM Person AS p.
  SHOW "[" + p.name + "]".
  SHOW "[" + p.age + "]".
  CALL p.put("name", "Ada").
  CALL p.put("age", "36").
  SHOW p.name.
  SHOW p.age.
  BLOOM Empty AS e.
  SHOW COUNT e.
  CREATE other(LST) TO { "age": 50 }.
  CALL p.put("age", "40").
  SHOW p.age.
  GIVE 0.
/GIVE main.
