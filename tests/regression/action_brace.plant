# v0.49.24 - official ACTION { ... } block syntax:
# curly-brace bodies parse via LBRACE/RBRACE depth matching (nested
# constructs cannot terminate an action early); comma bodies and
# /ACTION. terminators remain fully supported; empty blocks return "".
# Numeric returns still require the -> NUM annotation for tx_t
# wrapping (unchanged rule).
ACTION main() {
  SHOW "brace main".
  CREATE x(NUM) TO 6.
  IF x > 5,
    SHOW "big".
  /IF.
  CREATE i(NUM) TO 0.
  SEASON i < 3,
    SHOW "tick".
    SET i TO i + 1.
  /SEASON.
  SHOW twice(21).
  REAP _ FROM empty().
  CALL comma_legacy().
  SHOW thrice(3).
  GIVE 0.
}

ACTION twice(n(NUM)) -> NUM {
  GIVE n * 2.
}

ACTION empty() {
}

ACTION comma_legacy(),
  SHOW "comma form still works".
  SHOW thrice(3).
  GIVE 0.
/ACTION.

ACTION thrice(n(NUM)) -> NUM,
  GIVE n * 3.
/ACTION.
