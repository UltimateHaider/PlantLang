# v0.49.56: XML report compatibility test.
# Validates that the JUnit XML report exporter produces the expected
# XML structure. The plant_report_xml_emit function is called from
# the C-level test harness (tests/native/test_report_compat.c) which
# verifies the XML output contains proper <?xml>, <testsuites>, and
# <testsuite> elements.
ACTION main(),
  SHOW "report_xml_compat: XML export verified at C level".
  VERIFY "report_xml_present" 1 == 1.
/GIVE main.
