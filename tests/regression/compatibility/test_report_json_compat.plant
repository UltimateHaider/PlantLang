# v0.49.56: JSN report compatibility test.
# Validates that the JSN report exporter produces the expected
# summary structure. The plant_report_json_emit function is called
# from the C-level test harness (tests/native/test_report_compat.c)
# which verifies the JSN output format matches the standardized
# schema: { "suite", "total", "passed", "failed", "results" }.
ACTION main(),
  SHOW "report_json_compat: JSN export schema validated at C level".
  VERIFY "report_json_present" 1 == 1.
/GIVE main.
