ACTION main(),
  CREATE l(LIST) TO plant_list_make(3, "red", "green", "blue").
  ANALYZE l.
  CREATE m(LIST) TO plant_list_make(6, "name", "plant", "kind", "tree", "year", "2026").
  ANALYZE m.
  ANALYZE NULL.
  ANALYZE 7.
  ANALYZE "abc".
  CREATE s(STRING) TO "hello world".
  ANALYZE s.
  SHOW "s" + ANALYZE NOW FORMAT : YEAR.
  GIVE 0.
/ACTION.