# v0.48.20-patch: _handle_cat — genuine numeric literals must still
# use raw C arithmetic "+" (2 + 3 == 5), including on LON vars whose
# names contain digits (n2 + 1 == 8). LON actions return raw bits
# (numeric_return pattern): SET into a LON var before SHOW.
ACTION add(a(LON), b(LON)),
  GIVE a + b.
/GIVE add.

ACTION main(),
  CREATE n(LON) TO 2 + 3.
  SHOW n.
  REAP r FROM add, 30, 12.
  CREATE n1(LON) TO 0.
  SET n1 TO r.
  SHOW n1.
  CREATE n2(LON) TO 7.
  SHOW n2 + 1.
  SHOW n2 * 2.
  GIVE 0.
/GIVE main.
