# persistent_status — plant_persist_status MAP telemetry matches live
# runtime conditions: moderate pressure queues short leases as
# pending_frees, and GC drains them once they expire (v0.48.37b).
MISSION CONFIG PERSIST_PRESSURE = 85.
MISSION CONFIG PERSIST_LEASE_MS = 30.
ACTION main()
  CREATE o1(NUM) TO ffi_arc_alloc(64).
  CREATE o2(NUM) TO ffi_arc_alloc(64).
  SHOW "lease1=" + ffi_arc_lease(o1, 20).
  SHOW "lease2=" + ffi_arc_lease(o2, 20).
  SHOW "rel1=" + ffi_arc_release(o1).
  SHOW "rel2=" + ffi_arc_release(o2).
  SHOW "pressure=" + ffi_persist_pressure().
  SHOW "evict=" + ffi_lease_evict().
  SHOW "status1=" + plant_map_to_string(ffi_persist_status()).
  CALL ffi_sleep(60).
  SHOW "gc=" + ffi_arc_gc().
  SHOW "status2=" + plant_map_to_string(ffi_persist_status()).
/ACTION.
