# reap_expr — v0.49.9: REAP accepts general expressions in addition
# to legacy action calls: translate-time builtins (FIND/JOIN/SLICE/
# UPPER/LOWER/ABS/ROUND), COUNT, arithmetic, indexing, literals, and
# nested combinations — plus the preserved legacy forms (zero-arg
# bare call, parens call, comma call, module call).
ACTION helper(a(NUM)),
  GIVE _from_long(a * 2).
/GIVE helper.
ACTION zero(),
  GIVE "Z".
/GIVE zero.
ACTION main(),
  CREATE lst(LIST) TO plant_list_make(3, "aa", "bb", "cc").
  REAP s FROM "hello".
  SHOW "lit=" + s.
  REAP f FROM FIND("abc", "b").
  SHOW "find=" + f.
  REAP j FROM JOIN(lst, "-").
  SHOW "join=" + j.
  REAP sl FROM SLICE("abcdef", 1, 3).
  SHOW "slice=" + sl.
  REAP u FROM UPPER("AbC").
  SHOW "upper=" + u.
  REAP lo FROM LOWER("AbC").
  SHOW "lower=" + lo.
  REAP ab FROM ABS(-7).
  SHOW "abs=" + ab.
  REAP ro FROM ROUND("2.7").
  SHOW "round=" + ro.
  REAP c FROM COUNT lst.
  SHOW "count=" + c.
  REAP n FROM 2 + 3.
  SHOW "arith=" + n.
  REAP x FROM lst[0].
  SHOW "idx=" + x.
  REAP p FROM lst[1] + "!".
  SHOW "idxcat=" + p.
  REAP big FROM UPPER(JOIN(lst, ":")) + "!".
  SHOW "nested=" + big.
  REAP z FROM zero.
  SHOW "zero=" + z.
  REAP h FROM helper(3).
  SHOW "call=" + h.
  REAP u2 FROM UPPER(helper(2)).
  SHOW "callin=" + u2.
  REAP sp FROM strings:REPLACE, "a,b", ",", "-".
  SHOW "module=" + sp.
  GIVE 0.
/GIVE main.
