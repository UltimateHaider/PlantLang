# generic_return — generic numeric results (max2[LON]) are received
# into a LON var and SHOW correctly; string instantiation of a plain
# echo passes the string back verbatim.
ACTION max2[T](a(T), b(T)),
  IF a > b, GIVE a. /IF.
  GIVE b.
/ACTION.

ACTION echo[T](v(T)),
  GIVE v.
/ACTION.

ACTION main()
  REAP m FROM max2[LON], 15, 9.
  CREATE m2(LON) TO 0.
  SET m2 TO m.
  SHOW m2.
  SHOW m2 + 1.
  REAP s FROM echo[TXT], "cd".
  SHOW "str=" + s.
  GIVE 0.
/ACTION.