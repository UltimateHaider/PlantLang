ACTION main(),
  WEATHER,
    THROW ZERO_STORM.
  SHELTER ZERO_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW LOCK_STORM.
  SHELTER LOCK_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW MISSING_STORM.
  SHELTER MISSING_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW NETWORK_STORM.
  SHELTER NETWORK_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW LOST_STORM.
  SHELTER LOST_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW RANGE_STORM.
  SHELTER RANGE_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW TYPE_STORM.
  SHELTER TYPE_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW PARSE_STORM.
  SHELTER PARSE_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW HANDLE_STORM.
  SHELTER HANDLE_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW HARVEST_STORM.
  SHELTER HARVEST_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW FALL_STORM.
  SHELTER FALL_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW ANY_STORM.
  SHELTER ANY_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  WEATHER,
    THROW GHOST_STORM.
  SHELTER ANY_STORM AS err,
    SHOW err.
  CALM,
  /WEATHER.
  SHOW "done".
  GIVE 0.
/GIVE main.
