# v0.49.30 - SPC inheritance (FROM / PARENT):
#   SPC Child FROM Parent { extra: TYPE }
# Fields merge (parent first, child overwrites), methods inherit via
# bare-name dispatch, and child overrides replace parent impls.
SPC Animal {
  name: TXT
  ACTION speak() -> TXT {
    GIVE self.name + " makes a sound".
  }
}
SPC Dog FROM Animal {
  breed: TXT
  ACTION fetch() -> TXT {
    GIVE self.name + " fetches!".
  }
}
ACTION main(),
  BLOOM Animal AS a.
  CALL a.put("name", "Generic").
  SHOW a.speak().
  BLOOM Dog AS d.
  CALL d.put("name", "Rex").
  CALL d.put("breed", "Lab").
  SHOW COUNT d.
  SHOW d.fetch().
  GIVE 0.
/GIVE main.
