# v0.49.50 - Basic IMPLEMENTS clause
# Tests that SPC with IMPLEMENTS clause is recognized and interface
# conformance can be checked at runtime.
SPC Dog IMPLEMENTS Speakable {
  name: TXT
  ACTION speak() -> TXT {
    GIVE self.name + " barks!".
  }
}
ACTION main(),
  BLOOM Dog AS d.
  CALL d.put("name", "Rex").
  SHOW d.speak().
  REAP chk FROM plant_is_a, d, "Speakable".
  SHOW "is Speakable: " + chk.
  GIVE 0.
/GIVE main.
