INTERFACE Speakable {
  speak.
}
INTERFACE Movable {
  move.
}
SPECIES Dog IMPLEMENTS Speakable, Movable {
  name: TXT
  ACTION speak() -> TXT {
    GIVE self.name + " barks!".
  }
  ACTION move() -> TXT {
    GIVE self.name + " runs!".
  }
}
ACTION main(),
  BLOOM Dog AS d.
  CALL d.put("name", "Rex").
  SHOW d.speak().
  SHOW d.move().
  SHOW COUNT d.
  GIVE 0.
/GIVE main.
