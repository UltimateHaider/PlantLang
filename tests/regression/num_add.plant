# num_add — LON + LON must stay arithmetic (30), never concatenated,
# while string mixes of the same LON var concatenate via _from_long.
ACTION main(),
  CREATE a(LON) TO 10.
  CREATE b(LON) TO 20.
  CREATE c(LON) TO a + b.
  SHOW c.
  SHOW a + b + 5.
  CREATE t(TX) TO "sum " + c.
  SHOW t.
  GIVE 0.
/ACTION.