# nested instantiations: generic calling generic + cache reuse
ACTION inner[T](v(T)),
  GIVE "[" + v + "]".
/ACTION.

ACTION outer[T](v(T)),
  REAP w FROM inner[T], v.
  GIVE "(" + w + ")".
/ACTION.

ACTION main(),
  REAP r FROM outer[TXT], "x".
  SHOW "nested=" + r.
  REAP r2 FROM outer[TXT], "y".
  SHOW "nested2=" + r2.
  REAP r3 FROM inner[TXT], "z".
  SHOW "direct=" + r3.
  GIVE 0.
/GIVE main.
