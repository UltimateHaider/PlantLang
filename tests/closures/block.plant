# Block-form closure bodies run real statements, including an
# inner CREATE, and thread the closure map into nested blocks.
ACTION main(),
  CREATE x(LON) TO 8.
  CREATE h TO [MOVE x](v(LON)) -> (
    CREATE acc(TXT) TO _from_long(v + x + 1).
    SHOW "inner show".
    GIVE acc
  ).
  REAP r FROM h, 4.
  SHOW "block=" + r.
  GIVE 0.
/GIVE main.
