ACTION main(),
  # runtime-opaque bound (time-derived) so gcc -O2 cannot fold the loop
  REAP ts FROM time_now.
  CREATE tn(NUM) TO 0.
  REAP tn FROM _to_long, ts.
  REAP tmods FROM _from_long, tn - (tn / 1000) * 1000 + 0.
  CREATE tmod(NUM) TO 0.
  REAP tmod FROM _to_long, tmods.
  CREATE n(NUM) TO 10000000 + tmod.
  CREATE i(NUM) TO 0.
  CREATE acc(NUM) TO 0.
  REAP t0 FROM time_now.
  SEASON i < n,
    SET acc TO acc + 1.
    SET i TO i + 1.
  /SEASON.
  REAP t1 FROM time_now.
  REAP ns FROM _from_long, n.
  SHOW "loop-n=" + ns.
  REAP accs FROM _from_long, acc.
  SHOW "loop-acc=" + accs.
  CREATE t0n(NUM) TO 0.
  REAP t0n FROM _to_long, t0.
  CREATE t1n(NUM) TO 0.
  REAP t1n FROM _to_long, t1.
  REAP d FROM _from_long, t1n - t0n + 0.
  SHOW "elapsed_s=" + d.
  GIVE 0.
/GIVE main.
