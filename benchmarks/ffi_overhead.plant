ACTION bench_ms() -> external.
ACTION ffi_noop(v(NUM)) -> external.
ACTION ffi_add(a(NUM), b(NUM)) -> external.
ACTION ffi_swap_ref(a(REF NUM), b(REF NUM)) -> external.

ACTION main(),
  # runtime-opaque iteration count (time-derived) so gcc -O2 cannot
  # constant-fold the baseline loop
  REAP ts FROM time_now.
  CREATE tn(NUM) TO 0.
  REAP tn FROM _to_long, ts.
  REAP tmods FROM _from_long, tn - (tn / 1000) * 1000 + 0.
  CREATE tmod(NUM) TO 0.
  REAP tmod FROM _to_long, tmods.
  CREATE N(NUM) TO 10000000 + tmod.
  # ── phase 1: pure plant arithmetic loop (baseline) ─────────
  CREATE i(NUM) TO 0.
  CREATE x(NUM) TO 0.
  REAP t0 FROM bench_ms.
  SEASON i < N,
    SET x TO x + 1.
    SET i TO i + 1.
  /SEASON.
  REAP t1 FROM bench_ms.
  # keep x observable so gcc -O2 cannot elide the baseline loop
  REAP xchk FROM _from_long, x.
  SHOW "x=" + xchk.
  # ── phase 2: external C call, no return value (ffi_noop) ──
  CREATE j(NUM) TO 0.
  REAP t2 FROM bench_ms.
  SEASON j < N,
    REAP _ FROM ffi_noop, x.
    SET j TO j + 1.
  /SEASON.
  REAP t3 FROM bench_ms.
  # ── phase 3: external C call with TX value return (ffi_add) ──
  # (200K iterations: each return allocates a string, avoiding OOM)
  CREATE h(NUM) TO 0.
  REAP t3b FROM bench_ms.
  SEASON h < 200000,
    REAP _ FROM ffi_add, x, 1.
    SET h TO h + 1.
  /SEASON.
  REAP t3c FROM bench_ms.
  # ── phase 4: REF pass-by-reference update (ffi_swap_ref) ───
  CREATE k(NUM) TO 0.
  CREATE y(NUM) TO 1000.
  REAP t4 FROM bench_ms.
  SEASON k < N,
    REAP _ FROM ffi_swap_ref, x, y.
    SET k TO k + 1.
  /SEASON.
  REAP t5 FROM bench_ms.
  # ── report phase deltas in ms ───────────────────────────────
  CREATE t0n(NUM) TO 0.
  REAP t0n FROM _to_long, t0.
  CREATE t1n(NUM) TO 0.
  REAP t1n FROM _to_long, t1.
  REAP d1 FROM _from_long, t1n - t0n + 0.
  SHOW "plant-ms=" + d1.
  CREATE t2n(NUM) TO 0.
  REAP t2n FROM _to_long, t2.
  CREATE t3n(NUM) TO 0.
  REAP t3n FROM _to_long, t3.
  REAP d2 FROM _from_long, t3n - t2n + 0.
  SHOW "noop-ms=" + d2.
  CREATE t3bn(NUM) TO 0.
  REAP t3bn FROM _to_long, t3b.
  CREATE t3cn(NUM) TO 0.
  REAP t3cn FROM _to_long, t3c.
  REAP d3 FROM _from_long, t3cn - t3bn + 0.
  SHOW "value-ms=" + d3.
  CREATE t4n(NUM) TO 0.
  REAP t4n FROM _to_long, t4.
  CREATE t5n(NUM) TO 0.
  REAP t5n FROM _to_long, t5.
  REAP d4 FROM _from_long, t5n - t4n + 0.
  SHOW "ref-ms=" + d4.
  GIVE 0.
/GIVE main.
