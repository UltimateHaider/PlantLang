# PlantLang source files
*.plant linguist-language=PlantLang
*.plnt linguist-language=PlantLang

# PlantLang compiler source (self-hosted)
src/plantc/*.plant linguist-language=PlantLang

# Test files
tests/**/*.plant linguist-language=PlantLang

# Runtime C files
runtime/c/*.c linguist-language=C
runtime/c/*.h linguist-language=C

# Benchmarks
benchmarks/**/*.plant linguist-language=PlantLang

# Generated files (hide from language stats)
dist/** linguist-generated=true
build/** linguist-generated=true
release/** linguist-generated=true
*.tar.gz linguist-generated=true

# Override GitHub Linguist detection
*.plant linguist-detectable=true
*.plnt linguist-detectable=true

# Exclude generated files from stats
dist/** linguist-vendored=true
build/** linguist-vendored=true
release/** linguist-vendored=true
