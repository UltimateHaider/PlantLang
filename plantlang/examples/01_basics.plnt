# PlantLang — مثال 01: الأساسيات
MISSION: SAFE.

1\ CREATE name(TX) TO "PlantLang".
1\ CREATE version(SCL) TO 0.6.
1\ CREATE active(FACT) TO TRUE.
1\ CREATE year(NUM) TO 2025.
1\ SHOW name.
1\ SHOW version.
1\ SHOW active.
1\ SHOW year.

1\ CREATE x(NUM) TO 10.
1\ CREATE y(NUM) TO 3.
1\ CREATE sum_r(NUM) TO x + y.
1\ CREATE sub_r(NUM) TO x - y.
1\ CREATE mul_r(NUM) TO x * y.
1\ CREATE div_r(SCL) TO x / y.
1\ CREATE mod_r(NUM) TO x % y.
1\ CREATE pow_r(NUM) TO x ** 2.
1\ CREATE fld_r(NUM) TO x // y.
1\ SHOW sum_r.
1\ SHOW sub_r.
1\ SHOW mul_r.
1\ SHOW div_r.
1\ SHOW mod_r.
1\ SHOW pow_r.
1\ SHOW fld_r.

1\ CREATE fruits(LIST) TO apple, banana, mango, kiwi.
1\ SHOW fruits.
1\ SHOW FIRST fruits.
1\ SHOW LAST fruits.
1\ SHOW COUNT fruits.
1\ PUT grape INTO fruits.
1\ TAKE apple FROM fruits.
1\ SORT fruits.
1\ SHOW fruits.

1\ CREATE greeting(TX) TO "مرحباً بك في " + name.
1\ SHOW greeting.
