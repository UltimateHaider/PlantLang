# PlantLang — مثال 03: العواصف
MISSION: SAFE.

1\ WEATHER,
2\   CREATE a(NUM) TO 10.
2\   CREATE b(NUM) TO 0.
2\   CREATE c(NUM) TO a / b.
1\ SHELTER ZERO_STORM,
2\   SHOW "ZERO_STORM: لا يمكن القسمة على صفر".
1\ CALM.

1\ WEATHER,
2\   SHOW ghost_variable.
1\ SHELTER MISSING_STORM,
2\   SHOW "MISSING_STORM: المتغير غير موجود".
1\ CALM.

1\ WEATHER,
2\   CREATE lst(LIST) TO 1, 2, 3.
2\   INCREASE lst BY 5.
1\ SHELTER TYPE_STORM,
2\   SHOW "TYPE_STORM: عملية خاطئة على LIST".
1\ CALM.

1\ WEATHER,
2\   CREATE colors(LIST) TO red, green.
2\   TAKE yellow FROM colors.
1\ SHELTER LOST_STORM,
2\   SHOW "LOST_STORM: العنصر غير موجود".
1\ CALM.

ROOT MAX_SIZE TO 100.
1\ WEATHER,
2\   SET MAX_SIZE TO 200.
1\ SHELTER LOCK_STORM,
2\   SHOW "LOCK_STORM: ROOT محمية".
1\ CALM.

1\ WEATHER,
2\   SHOW totally_missing.
1\ SHELTER ANY_STORM AS err_msg,
2\   SHOW "ANY_STORM: " + err_msg.
1\ CALM.
