import re
import os
import json

class ChloroplastSovereign:
    def __init__(self, project_name="PlantProject"):
        self.project_name = project_name
        self.build_dir = f"./{project_name}_build"
        self.bridge_path = os.path.join(self.build_dir, "bridge.json")
        
        # 📖 قاموس المطابقة (The Mapping Dictionary)
        self.mapping = {
            "Speed": {  # Target: Go
                "ext": "go",
                "types": {"NUM": "int64", "DEW": "float64", "TEXT": "string"},
                "template": "var {n} {t} = {v}"
            },
            "Safety": { # Target: Rust
                "ext": "rs",
                "types": {"NUM": "i64", "DEW": "f64", "TEXT": "String"},
                "template": "let {n}: {t} = {v};"
            },
            "Intelligence": { # Target: Python
                "ext": "py",
                "types": {"NUM": "", "DEW": "", "TEXT": ""},
                "template": "{n} = {v}"
            }
        }
        
        # تجهيز بيئة البناء والجسر
        if not os.path.exists(self.build_dir):
            os.makedirs(self.build_dir)
        self._init_bridge()

    def _init_bridge(self):
        """إنشاء جسر البيانات (The Data Bridge)"""
        with open(self.bridge_path, "w") as f:
            json.dump({"nectar": {}, "logs": []}, f)

    def parse_missions(self, script):
        """تقسيم الكود إلى مهمات منفصلة بناءً على الأنماط"""
        pattern = r"1/ MISSION \((.*?)\): (.*?) \.(.*?)1/\."
        return re.findall(pattern, script, re.DOTALL)

    def translate_line(self, line, mode):
        """تحويل سطر PlantLang إلى اللغة الهدف"""
        line = line.strip()
        # منطق STORE
        store_match = re.search(r"\d+/ STORE (\w+)\((\w+)\) : (.*?) \.", line)
        if store_match:
            name, vtype, val = store_match.groups()
            m_data = self.mapping[mode]
            target_type = m_data["types"].get(vtype, "")
            
            # معالجة النصوص في Rust
            if mode == "Safety" and vtype == "TEXT":
                val = f"String::from({val})"
            
            return m_data["template"].format(n=name, t=target_type, v=val)
        
        # منطق SHOW
        show_match = re.search(r"\d+/ SHOW (\w+) \.", line)
        if show_match:
            var = show_match.group(1)
            if mode == "Speed": return f"fmt.Println({var})"
            if mode == "Safety": return f"println!(\"{{:?}}\", {var});"
            if mode == "Intelligence": return f"print({var})"
            
        return f"// {line} (Unmapped)"

    def build(self, script):
        print(f"🌿 PlantLang: Starting build for project '{self.project_name}'...")
        missions = self.parse_missions(script)
        
        for mode, name, content in missions:
            mode = mode.strip()
            name = name.strip()
            lines = content.strip().split('\n')
            
            translated_body = []
            for line in lines:
                if line.strip():
                    translated_body.append(self.translate_line(line, mode))
            
            self.generate_file(mode, name, translated_body)
            
        print(f"\n✅ Build Complete. Files are in: {self.build_dir}")

    def generate_file(self, mode, name, body):
        """إنتاج الملف المصدري النهائي"""
        ext = self.mapping[mode]["ext"]
        filename = f"{name}.{ext}"
        path = os.path.join(self.build_dir, filename)
        
        with open(path, "w", encoding="utf-8") as f:
            if mode == "Speed":
                f.write("package main\nimport \"fmt\"\nfunc main() {\n    " + "\n    ".join(body) + "\n}")
            elif mode == "Safety":
                f.write("fn main() {\n    " + "\n    ".join(body) + "\n}")
            else: # Python
                f.write("\n".join(body))
        
        print(f"📦 Generated {mode} Module: {filename}")

# --- كود الاختبار (The Holy Script) ---
hybrid_script = """
1/ MISSION (Safety): Vault_Access .
2/ STORE secret(TEXT) : "AX-2026" .
2/ SHOW secret .
1/.

1/ MISSION (Speed): Engine_Compute .
2/ STORE velocity(NUM) : 500 .
2/ STORE heat(DEW) : 98.6 .
2/ SHOW velocity .
1/.

1/ MISSION (Intelligence): AI_Analyzer .
2/ STORE probability(DEW) : 0.99 .
2/ SHOW probability .
