# ═══════════════════════════════════════════════════════════════
#  std/io.plnt — Core I/O Module (PlantLang Standard Library)
#
#  Provides safe, native PlantLang I/O actions backed by FFI
#  bindings to libc.  The underlying C bridge functions handle
#  TX Fat Pointer to C string conversion transparently.
# ═══════════════════════════════════════════════════════════════

# ── FFI external declarations (bridge to core/runtime_bridge.c) ──
ACTION plant_printf(s(TX)) -> external.
ACTION plant_puts(s(TX)) -> external.
ACTION plant_flush() -> external.

# ── Safe wrapper: print(text) ──
# Prints text to stdout without a trailing newline.
ACTION print(text(TX)),
  REAP _ FROM plant_printf, text.
/ACTION.

# ── Safe wrapper: println(text) ──
# Prints text to stdout with a trailing newline.
ACTION println(text(TX)),
  REAP _ FROM plant_puts, text.
/ACTION.

# ── Safe wrapper: flush() ──
# Flushes stdout.
ACTION flush(),
  REAP _ FROM plant_flush.
/ACTION.
