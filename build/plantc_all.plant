# ═══════════════════════════════════════════════════════════════
#  src/plantc/lexer.plant — Lexical analyzer for the
#  self-hosting PlantLang compiler.
# ═══════════════════════════════════════════════════════════════

# ── is_keyword(word) ──────────────────────────────────────
ACTION is_keyword(wrd(TX)),
  IF wrd IS "LET", GIVE TRUE. /IF.
  IF wrd IS "CREATE", GIVE TRUE. /IF.
  IF wrd IS "MATCH", GIVE TRUE. /IF.
  IF wrd IS "IF", GIVE TRUE. /IF.
  IF wrd IS "ELSE", GIVE TRUE. /IF.
  IF wrd IS "LOOP", GIVE TRUE. /IF.
  IF wrd IS "RETURN", GIVE TRUE. /IF.
  IF wrd IS "TYPE", GIVE TRUE. /IF.
  IF wrd IS "SHOW", GIVE TRUE. /IF.
  IF wrd IS "ACTION", GIVE TRUE. /IF.
  IF wrd IS "REAP", GIVE TRUE. /IF.
  IF wrd IS "GIVE", GIVE TRUE. /IF.
  IF wrd IS "SET", GIVE TRUE. /IF.
  IF wrd IS "PUT", GIVE TRUE. /IF.
  IF wrd IS "TAKE", GIVE TRUE. /IF.
  IF wrd IS "FOR", GIVE TRUE. /IF.
  IF wrd IS "CYCLE", GIVE TRUE. /IF.
  IF wrd IS "SEASON", GIVE TRUE. /IF.
  IF wrd IS "WEATHER", GIVE TRUE. /IF.
  IF wrd IS "SHELTER", GIVE TRUE. /IF.
  IF wrd IS "CALM", GIVE TRUE. /IF.
  IF wrd IS "AND", GIVE TRUE. /IF.
  IF wrd IS "OR", GIVE TRUE. /IF.
  IF wrd IS "NOT", GIVE TRUE. /IF.
  IF wrd IS "IS", GIVE TRUE. /IF.
  IF wrd IS "TRUE", GIVE TRUE. /IF.
  IF wrd IS "FALSE", GIVE TRUE. /IF.
  IF wrd IS "TO", GIVE TRUE. /IF.
  IF wrd IS "FROM", GIVE TRUE. /IF.
  IF wrd IS "AS", GIVE TRUE. /IF.
  IF wrd IS "IN", GIVE TRUE. /IF.
  IF wrd IS "SPLIT", GIVE TRUE. /IF.
  IF wrd IS "JOIN", GIVE TRUE. /IF.
  IF wrd IS "ENUM", GIVE TRUE. /IF.
  IF wrd IS "CONST", GIVE TRUE. /IF.
  IF wrd IS "FUNCTION", GIVE TRUE. /IF.
  IF wrd IS "IMPORT", GIVE TRUE. /IF.
  IF wrd IS "OPTION", GIVE TRUE. /IF.
  IF wrd IS "RESULT", GIVE TRUE. /IF.
  IF wrd IS "GREATER", GIVE TRUE. /IF.
  IF wrd IS "LESS", GIVE TRUE. /IF.
  IF wrd IS "THAN", GIVE TRUE. /IF.
  IF wrd IS "COUNT", GIVE TRUE. /IF.
  IF wrd IS "FIRST", GIVE TRUE. /IF.
  IF wrd IS "LAST", GIVE TRUE. /IF.
  IF wrd IS "SUM", GIVE TRUE. /IF.
  IF wrd IS "NULL", GIVE TRUE. /IF.
  IF wrd IS "ISNT", GIVE TRUE. /IF.
  IF wrd IS "TEST", GIVE TRUE. /IF.
  IF wrd IS "BREAK", GIVE TRUE. /IF.
  IF wrd IS "CONTINUE", GIVE TRUE. /IF.
  IF wrd IS "INTO", GIVE TRUE. /IF.
  GIVE FALSE.
/ACTION.

# ── keyword_to_type(word) ─────────────────────────────────
ACTION keyword_to_type(wrd(TX)),
  IF wrd IS "LET", GIVE "LET". /IF.
  IF wrd IS "CREATE", GIVE "CREATE". /IF.
  IF wrd IS "MATCH", GIVE "MATCH". /IF.
  IF wrd IS "IF", GIVE "IF". /IF.
  IF wrd IS "ELSE", GIVE "ELSE". /IF.
  IF wrd IS "LOOP", GIVE "LOOP". /IF.
  IF wrd IS "RETURN", GIVE "RETURN". /IF.
  IF wrd IS "TYPE", GIVE "TYPE". /IF.
  IF wrd IS "SHOW", GIVE "SHOW". /IF.
  IF wrd IS "ACTION", GIVE "ACTION". /IF.
  IF wrd IS "REAP", GIVE "REAP". /IF.
  IF wrd IS "GIVE", GIVE "GIVE". /IF.
  IF wrd IS "SET", GIVE "SET". /IF.
  IF wrd IS "PUT", GIVE "PUT". /IF.
  IF wrd IS "TAKE", GIVE "TAKE". /IF.
  IF wrd IS "FOR", GIVE "FOR". /IF.
  IF wrd IS "CYCLE", GIVE "CYCLE". /IF.
  IF wrd IS "SEASON", GIVE "SEASON". /IF.
  IF wrd IS "WEATHER", GIVE "WEATHER". /IF.
  IF wrd IS "SHELTER", GIVE "SHELTER". /IF.
  IF wrd IS "CALM", GIVE "CALM". /IF.
  IF wrd IS "AND", GIVE "AND". /IF.
  IF wrd IS "OR", GIVE "OR". /IF.
  IF wrd IS "NOT", GIVE "NOT". /IF.
  IF wrd IS "IS", GIVE "IS". /IF.
  IF wrd IS "TRUE", GIVE "TRUE". /IF.
  IF wrd IS "FALSE", GIVE "FALSE". /IF.
  IF wrd IS "TO", GIVE "TO". /IF.
  IF wrd IS "FROM", GIVE "FROM". /IF.
  IF wrd IS "AS", GIVE "AS". /IF.
  IF wrd IS "IN", GIVE "IN". /IF.
  IF wrd IS "SPLIT", GIVE "SPLIT". /IF.
  IF wrd IS "JOIN", GIVE "JOIN". /IF.
  IF wrd IS "ENUM", GIVE "ENUM". /IF.
  IF wrd IS "CONST", GIVE "CONST". /IF.
  IF wrd IS "FUNCTION", GIVE "FUNCTION". /IF.
  IF wrd IS "IMPORT", GIVE "IMPORT". /IF.
  IF wrd IS "OPTION", GIVE "OPTION". /IF.
  IF wrd IS "RESULT", GIVE "RESULT". /IF.
  IF wrd IS "GREATER", GIVE "GREATER". /IF.
  IF wrd IS "LESS", GIVE "LESS". /IF.
  IF wrd IS "THAN", GIVE "THAN". /IF.
  IF wrd IS "COUNT", GIVE "COUNT". /IF.
  IF wrd IS "FIRST", GIVE "FIRST". /IF.
  IF wrd IS "LAST", GIVE "LAST". /IF.
  IF wrd IS "SUM", GIVE "SUM". /IF.
  IF wrd IS "NULL", GIVE "NULL". /IF.
  IF wrd IS "ISNT", GIVE "ISNT". /IF.
  IF wrd IS "TEST", GIVE "TEST". /IF.
  IF wrd IS "BREAK", GIVE "BREAK". /IF.
  IF wrd IS "CONTINUE", GIVE "CONTINUE". /IF.
  IF wrd IS "INTO", GIVE "INTO". /IF.
  GIVE "IDENT".
/ACTION.

# ── char_type(ch) ─────────────────────────────────────────
ACTION char_type(ch(TX)),
  IF ch IS "+", GIVE "PLUS". /IF.
  IF ch IS "-", GIVE "MINUS". /IF.
  IF ch IS "*", GIVE "STAR". /IF.
  IF ch IS "/", GIVE "SLASH". /IF.
  IF ch IS "%", GIVE "PERCENT". /IF.
  IF ch IS "=", GIVE "EQUAL". /IF.
  IF ch IS ":", GIVE "COLON". /IF.
  IF ch IS "<", GIVE "LESS". /IF.
  IF ch IS ">", GIVE "GREATER". /IF.
  IF ch IS "!", GIVE "BANG". /IF.
  IF ch IS "?", GIVE "QUESTION". /IF.
  IF ch IS "&", GIVE "AMPERSAND". /IF.
  IF ch IS "|", GIVE "PIPE". /IF.
  IF ch IS ";", GIVE "SEMI". /IF.
  IF ch IS "(", GIVE "LPAREN". /IF.
  IF ch IS ")", GIVE "RPAREN". /IF.
  IF ch IS "{", GIVE "LBRACE". /IF.
  IF ch IS "}", GIVE "RBRACE". /IF.
  IF ch IS "[", GIVE "LBRACKET". /IF.
  IF ch IS "]", GIVE "RBRACKET". /IF.
  IF ch IS ",", GIVE "COMMA". /IF.
  IF ch IS ".", GIVE "DOT". /IF.
  IF ch IS "_", GIVE "WILDCARD". /IF.
  IF ch IS "#", GIVE "HASH". /IF.
  GIVE "".
/ACTION.

# ── is_alnum(ch) ──────────────────────────────────────────
ACTION is_alnum(ch(TX)),
  IF ch GREATER THAN OR EQUAL "a" AND ch LESS THAN OR EQUAL "z", GIVE TRUE. /IF.
  IF ch GREATER THAN OR EQUAL "A" AND ch LESS THAN OR EQUAL "Z", GIVE TRUE. /IF.
  IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", GIVE TRUE. /IF.
  IF ch IS "_", GIVE TRUE. /IF.
  GIVE FALSE.
/ACTION.

# ── is_alpha_start(ch) ────────────────────────────────────
ACTION is_alpha_start(ch(TX)),
  IF ch GREATER THAN OR EQUAL "a" AND ch LESS THAN OR EQUAL "z", GIVE TRUE. /IF.
  IF ch GREATER THAN OR EQUAL "A" AND ch LESS THAN OR EQUAL "Z", GIVE TRUE. /IF.
  IF ch IS "_", GIVE TRUE. /IF.
  GIVE FALSE.
/ACTION.

# ── match_ident_or_keyword(src, i, n) ─────────────────────
ACTION match_ident_or_keyword(src(TX), i(NUM), n(NUM)),
  CREATE wd(TX) TO "".
  CREATE ni(NUM) TO i.
  CREATE ch(TX) TO "".
  SEASON ni < n,
    REAP ok FROM is_alnum, char_at(src, ni).
    IF NOT ok, BREAK. /IF.
    REAP ch FROM char_at, src, ni.
    SET wd TO wd + ch.
    SET ni TO ni + 1.
  /SEASON.
  IF wd IS "null", SET wd TO "NULL". /IF.
  GIVE plant_list_make(2, wd, ni).
/ACTION.

# ── match_number(src, i, n) ───────────────────────────────
ACTION match_number(src(TX), i(NUM), n(NUM)),
  CREATE num(TX) TO "".
  CREATE ni(NUM) TO i.
  CREATE ch(TX) TO "".
  SEASON ni < n AND char_at(src, ni) GREATER THAN OR EQUAL "0" AND char_at(src, ni) LESS THAN OR EQUAL "9",
    REAP ch FROM char_at, src, ni.
    SET num TO num + ch.
    SET ni TO ni + 1.
  /SEASON.
  GIVE plant_list_make(2, num, ni).
/ACTION.

# ── match_string(src, i, n) ───────────────────────────────
ACTION match_string(src(TX), i(NUM), n(NUM)),
  CREATE val(TX) TO "".
  CREATE si(NUM) TO i.
  CREATE done(FACT) TO FALSE.
  CREATE ch(TX) TO "".
  IF si < n AND char_at(src, si) IS "\"", SET si TO si + 1. /IF.
  SEASON NOT done AND si < n,
    REAP ch FROM char_at, src, si.
    IF ch IS "\"", SET done TO TRUE. /IF.
    IF ch IS "\"", CONTINUE. /IF.
    IF ch IS "\\",
      SET si TO si + 1.
      IF si < n,
        REAP ch FROM char_at, src, si.
        IF ch IS "n", SET ch TO "\n". /IF.
        IF ch IS "t", SET ch TO "\t". /IF.
        IF ch IS "r", SET ch TO "\r". /IF.
      /IF.
    /IF.
    IF si < n,
      SET val TO val + ch.
      SET si TO si + 1.
    /IF.
  /SEASON.
  IF si < n AND char_at(src, si) IS "\"", SET si TO si + 1. /IF.
  GIVE plant_list_make(2, val, si).
/ACTION.

# ── skip_comment(src, i, n) ───────────────────────────────
ACTION skip_comment(src(TX), i(NUM), n(NUM)),
  SEASON i < n AND char_at(src, i) ISNT "\n",
    SET i TO i + 1.
  /SEASON.
  GIVE i.
/ACTION.

# ── scan_tokens(source) ───────────────────────────────────
ACTION scan_tokens(src(TX)),
  CREATE tokens(LIST) TO plant_list_make(0).
  CREATE i(NUM) TO 0.
  CREATE n(NUM) TO LEN(src).
  CREATE ch(TX) TO "".

  SEASON i < n,
    REAP ch FROM char_at, src, i.

    # Whitespace
    IF ch IS " " OR ch IS "\t" OR ch IS "\r", SET i TO i + 1. /IF.
    IF ch IS " " OR ch IS "\t" OR ch IS "\r", CONTINUE. /IF.

    # Newline
    IF ch IS "\n", SET i TO i + 1. /IF.
    IF ch IS "\n", CONTINUE. /IF.

    # Comment
    IF ch IS "#", REAP si FROM skip_comment, src, i + 1, n. /IF.
    IF ch IS "#", SET i TO si. /IF.
    IF ch IS "#", CONTINUE. /IF.

    # String literal
    IF ch IS "\"", REAP si FROM match_string, src, i, n. /IF.
    IF ch IS "\"", PUT plant_list_make(2, "STRING", si[0]) INTO tokens. /IF.
    IF ch IS "\"", SET i TO si[1]. /IF.
    IF ch IS "\"", CONTINUE. /IF.

    # Depth marker N\  — check before Number
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\",
      REAP si FROM match_number, src, i, n. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\",
      PUT plant_list_make(2, "DEPTH", si[0]) INTO tokens. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\",
      SET i TO si[1] + 1. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\" AND i < n AND char_at(src, i) IS " ",
      SET i TO i + 1. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\",
      CONTINUE. /IF.

    # Number
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", REAP si FROM match_number, src, i, n. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", PUT plant_list_make(2, "NUMBER", si[0]) INTO tokens. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", SET i TO si[1]. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", CONTINUE. /IF.

    # Identifier
    REAP ok FROM is_alpha_start, ch.
    IF ok, REAP si FROM match_ident_or_keyword, src, i, n. /IF.
    IF ok, REAP tok_ty FROM keyword_to_type, si[0]. /IF.
    IF ok, PUT plant_list_make(2, tok_ty, si[0]) INTO tokens. /IF.
    IF ok, SET i TO si[1]. /IF.
    IF ok, CONTINUE. /IF.

    # DOT_DOT
    IF ch IS "." AND i + 1 < n AND char_at(src, i + 1) IS ".",
      PUT plant_list_make(2, "DOT_DOT", "..") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.

    # ARROW
    IF ch IS "-" AND i + 1 < n AND char_at(src, i + 1) IS ">",
      PUT plant_list_make(2, "ARROW", "->") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.

    # Combined comparisons >= <= == !=
    IF ch IS ">" AND i + 1 < n AND char_at(src, i + 1) IS "=",
      PUT plant_list_make(2, "GREATER", ">=") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.
    IF ch IS "<" AND i + 1 < n AND char_at(src, i + 1) IS "=",
      PUT plant_list_make(2, "LESS", "<=") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.
    IF ch IS "=" AND i + 1 < n AND char_at(src, i + 1) IS "=",
      PUT plant_list_make(2, "EQUAL", "==") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.
    IF ch IS "!" AND i + 1 < n AND char_at(src, i + 1) IS "=",
      PUT plant_list_make(2, "BANG", "!=") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.

    # STAR_STAR
    IF ch IS "*" AND i + 1 < n AND char_at(src, i + 1) IS "*",
      PUT plant_list_make(2, "STAR_STAR", "**") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.

    # Single-char
    REAP tok_ty FROM char_type, ch.
    IF tok_ty ISNT "", PUT plant_list_make(2, tok_ty, ch) INTO tokens. /IF.
    IF tok_ty ISNT "", SET i TO i + 1. /IF.
    IF tok_ty ISNT "", CONTINUE. /IF.

    # Unknown
    PUT plant_list_make(2, "ERROR", ch) INTO tokens.
    SET i TO i + 1.
  /SEASON.

  PUT plant_list_make(2, "EOF", "") INTO tokens.
  GIVE tokens.
/ACTION.
# ═══════════════════════════════════════════════════════════════
#  src/plantc/parser.plant — Recursive descent parser
#
#  All action calls use REAP (no inline calls).
#  SEASON is a while-loop, IF is a conditional.
#  Use SEASON only for loops, IF for single branches.
#  Block IFs (multi-line) for multiple body statements.
# ═══════════════════════════════════════════════════════════════


#── Utility actions ────────────────────────────────────────────

ACTION tok_lex(tok(LIST)),
  GIVE tok[1].
/ACTION.

ACTION tok_type(tok(LIST)),
  GIVE tok[0].
/ACTION.

ACTION peek(tokens(LIST), pos(NUM)),
  IF pos < COUNT tokens,
    GIVE tokens[pos].
  /IF.
  GIVE plant_list_make(2, null, "").
/ACTION.

ACTION consume(tokens(LIST), pos(NUM)),
  GIVE plant_list_make(2, tokens[pos], pos + 1).
/ACTION.

ACTION _first(pair(LIST)),
  GIVE pair[0].
/ACTION.

ACTION _second(pair(LIST)),
  GIVE pair[1].
/ACTION.

ACTION is_eof(tokens(LIST), pos(NUM)),
  IF pos >= COUNT tokens,
    GIVE TRUE.
  /IF.
  REAP tok FROM peek, tokens, pos.
  REAP tp FROM tok_type, tok.
  IF tp IS "EOF",
    GIVE TRUE.
  /IF.
  GIVE FALSE.
/ACTION.

# collect_value: collects text until "." or EOF (consumes the dot)
# escape_string — re-escape C-unsafe characters in string content for emission
ACTION escape_string(s(TX)),
  CREATE r(TX) TO "".
  CREATE ei(NUM) TO 0.
  CREATE en(NUM) TO LEN(s).
  CREATE ec(TX) TO "".
  SEASON ei < en,
    REAP ec FROM char_at, s, ei.
    IF ec IS "\\", SET r TO r + "\\" + "\\". /IF.
    IF ec IS "\"", SET r TO r + "\\" + "\"". /IF.
    IF ec IS "\n", SET r TO r + "\\" + "n". /IF.
    IF ec IS "\t", SET r TO r + "\\" + "t". /IF.
    IF ec IS "\r", SET r TO r + "\\" + "r". /IF.
    IF ec ISNT "\\" AND ec ISNT "\"" AND ec ISNT "\n" AND ec ISNT "\t" AND ec ISNT "\r",
      SET r TO r + ec.
    /IF.
    SET ei TO ei + 1.
  /SEASON.
  GIVE r.
/ACTION.

ACTION collect_value(tokens(LIST), start(NUM)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP tt FROM tok_type, tok.
    IF tt IS "STRING",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    IF lx IS "." AND depth IS 0,
      REAP cpair FROM consume, tokens, p2.
      REAP p2 FROM _second, cpair.
      GIVE plant_list_make(2, text, p2).
    /IF.
    # a ")" at depth 0 closes an enclosing closure block body; leave
    # it unconsumed so the caller (parse_statement loop) sees it
    IF lx IS ")" AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    # a top-level "IN" terminates the value (CANCEL/TRACE ... IN ctx);
    # left unconsumed so the caller parses the context
    IF lx IS "IN" AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

# collect_until: collects text until delimiter at depth=0 (does NOT consume delimiter)
ACTION collect_until(tokens(LIST), start(NUM), delim(TX)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP tt FROM tok_type, tok.
    IF tt IS "STRING",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    IF _cat("", lx) IS _cat("", delim) AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

# collect_type_text: collects a type string until stopc (or "," when
# stopcomma=1) at depth 0, WITHOUT consuming the delimiter.
# Handles T, LIST[T], REF NUM, REF LIST[T], Box[NUM], Pair[NUM, TX] etc.
ACTION collect_type_text(tokens(LIST), start(NUM), stopc(TX), stopcomma(NUM)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE pdepth(NUM) TO 0.
  CREATE bdepth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF pdepth IS 0 AND bdepth IS 0,
      IF _cat("", lx) IS _cat("", stopc),
        GIVE plant_list_make(2, text, p2).
      /IF.
      IF stopcomma IS 1 AND lx IS ",",
        GIVE plant_list_make(2, text, p2).
      /IF.
    /IF.
    IF lx IS "(", SET pdepth TO pdepth + 1. /IF.
    IF lx IS ")", SET pdepth TO pdepth - 1. /IF.
    IF lx IS "[", SET bdepth TO bdepth + 1. /IF.
    IF lx IS "]", SET bdepth TO bdepth - 1. /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

#── Statement parsing ──────────────────────────────────────────

# collect_args: collect call arguments into a flat list until ",", "."
# or ")" at depth 0 (delimiters NOT consumed). Strings escaped.
ACTION collect_args(tokens(LIST), pos(NUM)),
  CREATE args(LIST) TO plant_list_make(0).
  CREATE p5(NUM) TO pos.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, args, p5).
    /IF.
    REAP tok FROM peek, tokens, p5.
    REAP lx FROM tok_lex, tok.
    REAP ty FROM tok_type, tok.
    IF lx IS "," AND ty ISNT "STRING",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    IF lx IS "." AND ty ISNT "STRING",
      GIVE plant_list_make(2, args, p5).
    /IF.
    IF lx IS ")" AND ty ISNT "STRING",
      GIVE plant_list_make(2, args, p5).
    /IF.
    # "IN" at depth 0 terminates the argument list (START/AWAIT/REAP
    # ... IN ctx); left unconsumed so the caller parses the context
    IF lx IS "IN" AND ty ISNT "STRING",
      GIVE plant_list_make(2, args, p5).
    /IF.
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM peek, tokens, p5.
      REAP alx FROM tok_lex, atok.
      REAP atype FROM tok_type, atok.
      IF atype IS "STRING",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "." AND adepth IS 0, BREAK 0. /IF.
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "IN" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM consume, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    PUT arg_text INTO args.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com2 FROM consume, tokens, p5.
      REAP p5 FROM _second, com2.
    /IF.
  /SEASON.
/ACTION.

# AWAIT callname, args [IN ctx]. — suspend until the async action
# completes; the child task is spawned into ctx when given
ACTION parse_await_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP act_pair FROM consume, tokens, p2.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p3 FROM _second, act_pair.
  REAP ap FROM collect_args, tokens, p3.
  CREATE args(LIST) TO ap[0].
  REAP p4 FROM _second, ap.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM peek, tokens, p4.
  REAP lx FROM tok_lex, tok.
  IF lx IS "IN",
    REAP in_pair FROM consume, tokens, p4.
    REAP p5 FROM _second, in_pair.
    REAP ctx_pair FROM consume, tokens, p5.
    REAP ctx_name FROM tok_lex, ctx_pair[0].
    REAP p6 FROM _second, ctx_pair.
    REAP dot FROM consume, tokens, p6.
    REAP p7 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(8, "type", "await_stmt", "action", act_name, "args", args, "ctx", ctx_name), p7).
  /IF.
  REAP dot FROM consume, tokens, p4.
  REAP p5 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(8, "type", "await_stmt", "action", act_name, "args", args, "ctx", ctx_name), p5).
/ACTION.

# START callname, args [IN ctx]. — fire-and-forget spawn
ACTION parse_start_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP act_pair FROM consume, tokens, p2.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p3 FROM _second, act_pair.
  REAP ap FROM collect_args, tokens, p3.
  CREATE args(LIST) TO ap[0].
  REAP p4 FROM _second, ap.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM peek, tokens, p4.
  REAP lx FROM tok_lex, tok.
  IF lx IS "IN",
    REAP in_pair FROM consume, tokens, p4.
    REAP p5 FROM _second, in_pair.
    REAP ctx_pair FROM consume, tokens, p5.
    REAP ctx_name FROM tok_lex, ctx_pair[0].
    REAP p6 FROM _second, ctx_pair.
    REAP dot FROM consume, tokens, p6.
    REAP p7 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(8, "type", "start_stmt", "action", act_name, "args", args, "ctx", ctx_name), p7).
  /IF.
  REAP dot FROM consume, tokens, p4.
  REAP p5 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(8, "type", "start_stmt", "action", act_name, "args", args, "ctx", ctx_name), p5).
/ACTION.

# ASYNC IN ctx, callname, args. — spawn into a structured context
ACTION parse_async_in_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP in_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, in_pair.
  REAP ctx_pair FROM consume, tokens, p3.
  REAP ctx_name FROM tok_lex, ctx_pair[0].
  REAP p4 FROM _second, ctx_pair.
  REAP com FROM consume, tokens, p4.
  REAP p5 FROM _second, com.
  REAP act_pair FROM consume, tokens, p5.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p6 FROM _second, act_pair.
  REAP ap FROM collect_args, tokens, p6.
  CREATE args(LIST) TO ap[0].
  REAP p7 FROM _second, ap.
  REAP dot FROM consume, tokens, p7.
  REAP p8 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(10, "type", "start_stmt", "action", act_name, "args", args, "ctx", ctx_name, "kind", "async_in"), p8).
/ACTION.

# CANCEL tok. or CANCEL tok IN ctx. — immediate cancellation + teardown;
# the IN form is scoped: only cancels the handle if it lives in ctx
ACTION parse_cancel_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  IF lx IS "IN",
    REAP in_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, in_pair.
    REAP ctx_pair FROM consume, tokens, p4.
    REAP ctx_name FROM tok_lex, ctx_pair[0].
    REAP p5 FROM _second, ctx_pair.
    REAP dot FROM consume, tokens, p5.
    REAP p6 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(6, "type", "cancel_stmt", "value", expr, "ctx", ctx_name), p6).
  /IF.
  GIVE plant_list_make(2, plant_list_make(6, "type", "cancel_stmt", "value", expr, "ctx", ctx_name), p3).
/ACTION.

# TRACE INFO|DEBUG|PERF msg [IN ctx]. — scoped trace event; the IN
# form tags the event with the context name
ACTION parse_trace_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP lv_pair FROM consume, tokens, p2.
  REAP lv FROM tok_lex, lv_pair[0].
  REAP p3 FROM _second, lv_pair.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4b FROM _second, vpair.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM peek, tokens, p4b.
  REAP lx FROM tok_lex, tok.
  IF lx IS "IN",
    REAP in_pair FROM consume, tokens, p4b.
    REAP p5 FROM _second, in_pair.
    REAP ctx_pair FROM consume, tokens, p5.
    REAP ctx_name FROM tok_lex, ctx_pair[0].
    REAP p6 FROM _second, ctx_pair.
    REAP dot FROM consume, tokens, p6.
    REAP p7 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(8, "type", "trace_stmt", "level", lv, "value", expr, "ctx", ctx_name), p7).
  /IF.
  # collect_value already consumed the dot; p4b is after it
  GIVE plant_list_make(2, plant_list_make(8, "type", "trace_stmt", "level", lv, "value", expr, "ctx", ctx_name), p4b).
/ACTION.

# MISSION CONFIG KEY = VALUE. — runtime configuration directive
ACTION parse_mission_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cfg_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, cfg_pair.
  REAP key_pair FROM consume, tokens, p3.
  REAP cfg_key FROM tok_lex, key_pair[0].
  REAP p4 FROM _second, key_pair.
  REAP eq_tok FROM peek, tokens, p4.
  REAP eq_lx FROM tok_lex, eq_tok.
  IF eq_lx IS "=" OR eq_lx IS "IS",
    REAP eq_pair FROM consume, tokens, p4.
    REAP p4 FROM _second, eq_pair.
  /IF.
  REAP val_pair FROM consume, tokens, p4.
  REAP cfg_val FROM tok_lex, val_pair[0].
  REAP vty FROM tok_type, val_pair[0].
  # quoted values (paths, strings with spaces) keep the whole token;
  # strip the quotes so the codegen emits a clean "value"
  IF vty IS "STRING",
    REAP cfg_val FROM escape_string, cfg_val.
  /IF.
  REAP p5 FROM _second, val_pair.
  REAP dot FROM consume, tokens, p5.
  REAP p6 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(6, "type", "config_stmt", "key", cfg_key, "value", cfg_val), p6).
/ACTION.

ACTION parse_create_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM consume, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tv FROM collect_type_text, tokens, p4, ")", 0.
    REAP tt FROM _first, tv.
    REAP p5 FROM _second, tv.
    REAP rp FROM consume, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tt.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM peek, tokens, p3.
  REAP lx2 FROM tok_lex, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

ACTION parse_show_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "show_stmt", "value", expr), p3).
/ACTION.

ACTION parse_give_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "give_stmt", "value", expr), p3).
/ACTION.

ACTION parse_set_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP eq FROM consume, tokens, p3.
  REAP p4 FROM _second, eq.
  REAP vpair FROM collect_value, tokens, p4.
  CREATE expr TO vpair[0].
  REAP p5 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "set_stmt", "target", id_name, "value", expr), p5).
/ACTION.

ACTION parse_let_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM consume, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tv FROM collect_type_text, tokens, p4, ")", 0.
    REAP tt FROM _first, tv.
    REAP p5 FROM _second, tv.
    REAP rp FROM consume, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tt.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM peek, tokens, p3.
  REAP lx2 FROM tok_lex, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

#── Closures ───────────────────────────────────────────────────
# parse_closure:
#   long form:  [MOVE x, REF y](params) -> expr
#   short form: [MOVE x] -> expr            (bracket entries ARE params)
#   short form: [MOVE x y z] -> expr        (multiple bare parameters)
# A bracket may also hold a block body: [MOVE x](params) -> ( stmts ).
# The closure body's single-expression form ends at "," or "."
# at depth 0; the block form ends at ")".
# Returns [closure_node, pos]; on failure [empty_list, start_pos];
# on mixed/invalid syntax [syntax_error_node, pos].
# The terminating "," or "." is NOT consumed (the caller handles it).

ACTION parse_closure(tokens(LIST), pos(NUM)),
  CREATE start_pos(NUM) TO pos.
  REAP lb FROM consume, tokens, pos.
  REAP p2 FROM _second, lb.
  CREATE captures(LIST) TO plant_list_make(0).
  CREATE entries(LIST) TO plant_list_make(0).
  CREATE had_comma(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(0), start_pos).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP ty FROM tok_type, tok.
    IF lx IS "]",
      REAP rb FROM consume, tokens, p2.
      REAP p2 FROM _second, rb.
      BREAK 0.
    /IF.
    # a parenthesized parameter list inside the bracket mixes the
    # short (bare) and long (parenthesized) parameter forms
    IF lx IS "(",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Mixed closure parameter syntax"), p2).
    /IF.
    REAP ent_pair FROM consume, tokens, p2.
    REAP en0 FROM tok_lex, ent_pair[0].
    REAP p2 FROM _second, ent_pair.
    CREATE en_mode(TX) TO "".
    CREATE en_name(TX) TO "".
    IF en0 IS "MOVE" OR en0 IS "REF",
      SET en_mode TO en0.
      REAP ntok FROM peek, tokens, p2.
      REAP nlx FROM tok_lex, ntok.
      REAP nty FROM tok_type, ntok.
      IF nlx IS "(",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Mixed closure parameter syntax"), p2).
      /IF.
      IF nty ISNT "IDENT",
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      REAP npair FROM consume, tokens, p2.
      REAP en_name FROM tok_lex, npair[0].
      REAP p2 FROM _second, npair.
    /IF.
    IF en_mode IS "",
      IF ty ISNT "IDENT",
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      SET en_name TO en0.
    /IF.
    PUT plant_list_make(2, en_mode, en_name) INTO entries.
    REAP tok2 FROM peek, tokens, p2.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      SET had_comma TO "1".
      REAP com FROM consume, tokens, p2.
      REAP p2 FROM _second, com.
    /IF.
  /SEASON.
  # after "]": a "(" selects the long form (bracket = captures),
  # anything else selects the short form (bracket = bare parameters)
  REAP ptok FROM peek, tokens, p2.
  REAP plx FROM tok_lex, ptok.
  CREATE params(LIST) TO plant_list_make(0).
  IF plx IS "(",
    # a bare (comma-less) multi-entry bracket followed by a
    # parenthesized parameter list mixes the two parameter forms
    IF had_comma IS "0",
      IF COUNT entries > 1,
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Mixed closure parameter syntax"), p2).
      /IF.
    /IF.
    # long form: the bracket entries are captures
    CREATE ci2(NUM) TO 0.
    SEASON ci2 < COUNT entries,
      REAP ce2 FROM plant_list_get, entries, ci2.
      REAP cm2 FROM _first, ce2.
      REAP cn2 FROM _second, ce2.
      IF cm2 IS "",
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      PUT plant_list_make(4, "name", cn2, "mode", cm2) INTO captures.
      SET ci2 TO ci2 + 1.
    /SEASON.
    REAP lp FROM consume, tokens, p2.
    REAP p3 FROM _second, lp.
    SEASON TRUE,
      REAP is_eof_flag FROM is_eof, tokens, p3.
      IF is_eof_flag,
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      REAP tok FROM peek, tokens, p3.
      REAP lx FROM tok_lex, tok.
      IF lx IS ")",
        REAP rp FROM consume, tokens, p3.
        REAP p4 FROM _second, rp.
        BREAK 0.
      /IF.
      REAP pn_pair FROM consume, tokens, p3.
      REAP pn FROM tok_lex, pn_pair[0].
      REAP p4 FROM _second, pn_pair.
      REAP tok2 FROM peek, tokens, p4.
      REAP lx2 FROM tok_lex, tok2.
      IF lx2 IS "(",
        REAP lp2 FROM consume, tokens, p4.
        REAP p5 FROM _second, lp2.
        REAP ptv FROM collect_type_text, tokens, p5, ")", 1.
        REAP pt FROM _first, ptv.
        REAP p5 FROM _second, ptv.
        REAP rp2 FROM consume, tokens, p5.
        REAP p5 FROM _second, rp2.
        PUT plant_list_make(4, "name", pn, "type", pt) INTO params.
        SET p4 TO p5.
      /IF.
      IF lx2 ISNT "(",
        PUT plant_list_make(4, "name", pn, "type", "") INTO params.
      /IF.
      REAP tok3 FROM peek, tokens, p4.
      REAP lx3 FROM tok_lex, tok3.
      IF lx3 IS ",",
        REAP com2 FROM consume, tokens, p4.
        REAP p4 FROM _second, com2.
      /IF.
      SET p3 TO p4.
    /SEASON.
  /IF.
  IF plx ISNT "(",
    # short form: the bracket entries ARE the parameters; they default
    # to NUM so concise closures can be used in arithmetic directly
    CREATE si2(NUM) TO 0.
    SEASON si2 < COUNT entries,
      REAP se2 FROM plant_list_get, entries, si2.
      REAP sn2 FROM _second, se2.
      PUT plant_list_make(4, "name", sn2, "type", "NUM") INTO params.
      SET si2 TO si2 + 1.
    /SEASON.
    SET p4 TO p2.
  /IF.
  # "->"
  REAP atok FROM peek, tokens, p4.
  REAP alx FROM tok_lex, atok.
  IF alx ISNT "->",
    GIVE plant_list_make(2, plant_list_make(0), start_pos).
  /IF.
  REAP ap FROM consume, tokens, p4.
  REAP p5 FROM _second, ap.
  # defensive skip of a stray MINUS (mirrors parse_action_decl)
  REAP stok FROM peek, tokens, p5.
  REAP sty FROM tok_type, stok.
  IF sty IS "MINUS",
    REAP sp FROM consume, tokens, p5.
    REAP p5 FROM _second, sp.
  /IF.
  # body: block form "-> ( stmts )" when "(" is followed by a
  # statement keyword; otherwise a single expression
  CREATE body_kind(TX) TO "expr".
  REAP btok FROM peek, tokens, p5.
  REAP blx FROM tok_lex, btok.
  CREATE body(LIST) TO plant_list_make(0).
  IF blx IS "(",
    REAP btok2 FROM peek, tokens, p5 + 1.
    REAP blx2 FROM tok_lex, btok2.
    IF blx2 IS "CREATE" OR blx2 IS "SHOW" OR blx2 IS "GIVE" OR blx2 IS "SET" OR blx2 IS "LET" OR blx2 IS "IF" OR blx2 IS "SEASON" OR blx2 IS "REAP" OR blx2 IS "PUT" OR blx2 IS "BREAK" OR blx2 IS "CONTINUE",
      SET body_kind TO "block".
      REAP bp FROM consume, tokens, p5.
      REAP p6 FROM _second, bp.
      CREATE stmts(LIST) TO plant_list_make(0).
      SEASON TRUE,
        REAP is_eof_flag FROM is_eof, tokens, p6.
        IF is_eof_flag, BREAK 0. /IF.
        REAP btok3 FROM peek, tokens, p6.
        REAP blx3 FROM tok_lex, btok3.
        IF blx3 IS ")",
          REAP brp FROM consume, tokens, p6.
          REAP p6 FROM _second, brp.
          BREAK 0.
        /IF.
        REAP d_pair FROM parse_statement, tokens, p6.
        CREATE decl TO d_pair[0].
        REAP p6 FROM _second, d_pair.
        IF decl > "",
          REAP dty FROM _map_get, decl, "type".
          IF dty IS "syntax_error",
            GIVE d_pair.
          /IF.
          PUT decl INTO stmts.
        /IF.
      /SEASON.
      SET body TO stmts.
      SET p5 TO p6.
    /IF.
  /IF.
  IF body_kind IS "expr",
    CREATE text(TX) TO "".
    CREATE bd(NUM) TO 0.
    CREATE pd(NUM) TO 0.
    SEASON TRUE,
      REAP is_eof_flag FROM is_eof, tokens, p5.
      IF is_eof_flag, BREAK 0. /IF.
      REAP etok FROM peek, tokens, p5.
      REAP elx FROM tok_lex, etok.
      REAP ety FROM tok_type, etok.
      IF ety IS "STRING",
        REAP elx FROM escape_string, elx.
        SET elx TO "\"" + elx + "\"".
      /IF.
      IF elx IS "," AND pd IS 0 AND bd IS 0, BREAK 0. /IF.
      IF elx IS "." AND pd IS 0 AND bd IS 0, BREAK 0. /IF.
      IF elx IS "(", SET pd TO pd + 1. /IF.
      IF elx IS ")", SET pd TO pd - 1. /IF.
      IF elx IS "[", SET bd TO bd + 1. /IF.
      IF elx IS "]", SET bd TO bd - 1. /IF.
      IF text > "",
        SET text TO text + " ".
      /IF.
      SET text TO text + elx.
      REAP ep FROM consume, tokens, p5.
      REAP p5 FROM _second, ep.
    /SEASON.
    SET body TO text.
  /IF.
  CREATE cnode(LIST) TO plant_list_make(12, "type", "closure", "params", params, "captures", captures, "body", body, "bkind", body_kind).
  GIVE plant_list_make(2, cnode, p5).
/ACTION.

ACTION parse_reap_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP var_pair FROM consume, tokens, p2.
  REAP var_name FROM tok_lex, var_pair[0].
  REAP p3 FROM _second, var_pair.
  REAP from_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, from_pair.
  REAP act_pair FROM consume, tokens, p4.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p5 FROM _second, act_pair.
  # Check for module:function syntax (e.g., strings:REPLACE)
  REAP next_tok FROM peek, tokens, p5.
  REAP next_lx FROM tok_lex, next_tok.
  REAP next_ty FROM tok_type, next_tok.
    IF next_ty IS "COLON",
      SET act_name TO act_name + ":".
      REAP colon_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, colon_pair.
      REAP func_pair FROM consume, tokens, p5.
      REAP func_name FROM tok_lex, func_pair[0].
      SET act_name TO act_name + func_name.
      REAP p5 FROM _second, func_pair.
    /IF.
  # generic type arguments at the call site: foo[NUM, TX]
  REAP ga_tok FROM peek, tokens, p5.
  REAP ga_lx FROM tok_lex, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p5, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p5 FROM _second, gv.
    REAP ga_rb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_rb.
    SET act_name TO act_name + "[" + gtext + "]".
  /IF.
  CREATE args(LIST) TO plant_list_make(0).
  CREATE clargs(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tok0 FROM peek, tokens, p5.
    REAP lx0 FROM tok_lex, tok0.
    REAP ty0 FROM tok_type, tok0.
    IF lx0 IS "," AND ty0 ISNT "STRING",
      REAP com0 FROM consume, tokens, p5.
      REAP p5 FROM _second, com0.
    /IF.
    # closure argument: [MOVE x, REF y](v(NUM)) -> expr
    REAP ctok FROM peek, tokens, p5.
    REAP clx FROM tok_lex, ctok.
    IF clx IS "[",
      REAP clp FROM parse_closure, tokens, p5.
      REAP cnode FROM _first, clp.
      REAP p6 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p6).
      /IF.
      IF COUNT cnode > 0,
        PUT "@@CLOSURE@@" INTO args.
        PUT cnode INTO clargs.
        SET p5 TO p6.
        REAP ctok2 FROM peek, tokens, p5.
        REAP clx2 FROM tok_lex, ctok2.
        IF clx2 IS ",",
          REAP ccom FROM consume, tokens, p5.
          REAP p5 FROM _second, ccom.
        /IF.
        IF clx2 IS ".",
          REAP cdot FROM consume, tokens, p5.
          REAP p6 FROM _second, cdot.
          GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6).
        /IF.
      /IF.
    /IF.
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p5).
    /IF.
    REAP tok FROM peek, tokens, p5.
    REAP lx FROM tok_lex, tok.
    REAP ty FROM tok_type, tok.
    # "IN" at depth 0 after the args → REAP ... IN ctx (async spawn
    # into a context; the reaped handle belongs to that context)
    IF lx IS "IN" AND ty ISNT "STRING",
      REAP in_pair FROM consume, tokens, p5.
      REAP p5b FROM _second, in_pair.
      REAP ctx_pair FROM consume, tokens, p5b.
      REAP ctx_name FROM tok_lex, ctx_pair[0].
      REAP p6b FROM _second, ctx_pair.
      REAP dot2 FROM consume, tokens, p6b.
      REAP p7b FROM _second, dot2.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ctx_name), p7b).
    /IF.
    IF lx IS "." AND ty ISNT "STRING",
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6).
    /IF.
    # collect one argument until , or . at depth 0 (do NOT consume delimiter)
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM peek, tokens, p5.
      REAP alx FROM tok_lex, atok.
      REAP atype FROM tok_type, atok.
      IF atype IS "STRING",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "." AND adepth IS 0, BREAK 0. /IF.
      # ")" at depth 0 closes an enclosing closure block body
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "IN" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM consume, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    # v0.48.18: `REAP r FROM f().` — the empty parens are collected
    # as a "( )" arg expression; drop them so zero-arg reaps emit
    # f() instead of the invalid f(( )).
    IF arg_text ISNT "( )",
        PUT arg_text INTO args.
    /IF.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    IF lx2 IS ".",
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6).
    /IF.
  /SEASON.
/ACTION.

# parse_call_stmt — bare call: name(args). → call_stmt node.
# (void FFI calls like plant_map_set / ffi_swap_ref; the codegen
#  reuses the reap_stmt discard path with target "_")
ACTION parse_call_stmt(tokens(LIST), pos(NUM)),
  REAP act_pair FROM consume, tokens, pos.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p5 FROM _second, act_pair.
  REAP next_tok FROM peek, tokens, p5.
  REAP next_ty FROM tok_type, next_tok.
  IF next_ty IS "COLON",
    SET act_name TO act_name + ":".
    REAP colon_pair FROM consume, tokens, p5.
    REAP p5 FROM _second, colon_pair.
    REAP func_pair FROM consume, tokens, p5.
    REAP func_name FROM tok_lex, func_pair[0].
    SET act_name TO act_name + func_name.
    REAP p5 FROM _second, func_pair.
  /IF.
  REAP ga_tok FROM peek, tokens, p5.
  REAP ga_lx FROM tok_lex, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p5, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p5 FROM _second, gv.
    REAP ga_rb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_rb.
    SET act_name TO act_name + "[" + gtext + "]".
  /IF.
  REAP lpar FROM consume, tokens, p5.
  REAP p5 FROM _second, lpar.
  CREATE args(LIST) TO plant_list_make(0).
  CREATE clargs(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tok0 FROM peek, tokens, p5.
    REAP lx0 FROM tok_lex, tok0.
    REAP ty0 FROM tok_type, tok0.
    IF lx0 IS "," AND ty0 ISNT "STRING",
      REAP com0 FROM consume, tokens, p5.
      REAP p5 FROM _second, com0.
    /IF.
    REAP ctok FROM peek, tokens, p5.
    REAP clx FROM tok_lex, ctok.
    IF clx IS "[",
      REAP clp FROM parse_closure, tokens, p5.
      REAP cnode FROM _first, clp.
      REAP p6 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p6).
      /IF.
      IF COUNT cnode > 0,
        PUT "@@CLOSURE@@" INTO args.
        PUT cnode INTO clargs.
        SET p5 TO p6.
        REAP ctok2 FROM peek, tokens, p5.
        REAP clx2 FROM tok_lex, ctok2.
        IF clx2 IS ",",
          REAP ccom FROM consume, tokens, p5.
          REAP p5 FROM _second, ccom.
        /IF.
      /IF.
    /IF.
    REAP tok FROM peek, tokens, p5.
    REAP lx FROM tok_lex, tok.
    IF lx IS ")",
      REAP rp FROM consume, tokens, p5.
      REAP p5 FROM _second, rp.
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(10, "type", "call_stmt", "action", act_name, "args", args, "clargs", clargs), p6).
    /IF.
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM peek, tokens, p5.
      REAP alx FROM tok_lex, atok.
      REAP atype FROM tok_type, atok.
      IF atype IS "STRING",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM consume, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    PUT arg_text INTO args.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_put_stmt(tokens(LIST), pos(NUM)),  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_until, tokens, p2, "INTO".
  CREATE item TO vpair[0].
  REAP p3 FROM _second, vpair.
  REAP into_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, into_pair.
  REAP tpair FROM collect_until, tokens, p4, ".".
  CREATE target TO tpair[0].
  REAP p5 FROM _second, tpair.
  REAP dot_pair FROM consume, tokens, p5.
  REAP p6 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "put_stmt", "item", item, "target", target), p6).
/ACTION.

ACTION parse_break_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  IF p2 < COUNT tokens,
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF lx IS "0",
      REAP drop FROM consume, tokens, p2.
      REAP p2 FROM _second, drop.
    /IF.
  /IF.
  REAP dot_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "break_stmt"), p3).
/ACTION.

ACTION parse_continue_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP dot_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "continue_stmt"), p3).
/ACTION.

ACTION parse_if_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM consume, tokens, p3.
  REAP p4 FROM _second, com.
  CREATE body(LIST) TO plant_list_make(0).
  CREATE cur_cond(TX) TO "".
  CREATE cur_body(LIST) TO plant_list_make(0).
  CREATE elif(LIST) TO plant_list_make(0).
  CREATE else_body(LIST) TO plant_list_make(0).
  CREATE in_elif(TX) TO "0".
  CREATE in_else(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      GIVE plant_list_make(2, plant_list_make(12, "type", "if_stmt", "cond", cond, "body", body, "elif", elif, "else", else_body), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP if_close FROM consume, tokens, p5.
      REAP p6 FROM _second, if_close.
      REAP dot FROM consume, tokens, p6.
      REAP p7 FROM _second, dot.
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      GIVE plant_list_make(2, plant_list_make(12, "type", "if_stmt", "cond", cond, "body", body, "elif", elif, "else", else_body), p7).
    /IF.
    IF lx IS "ORIF",
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      REAP o_pair FROM consume, tokens, p4.
      REAP p5 FROM _second, o_pair.
      REAP ocp FROM collect_until, tokens, p5, ",".
      REAP ocond FROM _first, ocp.
      REAP p6 FROM _second, ocp.
      REAP ocom FROM consume, tokens, p6.
      REAP p7 FROM _second, ocom.
      SET cur_cond TO ocond.
      SET cur_body TO plant_list_make(0).
      SET in_elif TO "1".
      SET in_else TO "0".
      SET p4 TO p7.
      CONTINUE 0.
    /IF.
    IF lx IS "ELSE",
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      REAP e_pair FROM consume, tokens, p4.
      REAP p5 FROM _second, e_pair.
      SET in_else TO "1".
      SET p4 TO p5.
      CONTINUE 0.
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      IF in_else IS "1",
        PUT stmt INTO else_body.
      /IF.
      IF in_else IS "0",
        IF in_elif IS "1",
          PUT stmt INTO cur_body.
        /IF.
        IF in_elif IS "0",
          PUT stmt INTO body.
        /IF.
      /IF.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_season_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM consume, tokens, p3.
  REAP p4 FROM _second, com.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP season_close FROM consume, tokens, p5.
      REAP p6 FROM _second, season_close.
      REAP dot FROM consume, tokens, p6.
      REAP p7 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p7).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_statement(tokens(LIST), pos(NUM)),
  SEASON TRUE,
    REAP tok FROM peek, tokens, pos.
    REAP tp FROM tok_type, tok.
    IF tp ISNT "DEPTH", BREAK 0. /IF.
    REAP drop_pair FROM consume, tokens, pos.
    REAP pos FROM _second, drop_pair.
  /SEASON.
  REAP tok FROM peek, tokens, pos.
  REAP lx FROM tok_lex, tok.
  IF lx IS "CREATE",
    REAP r FROM parse_create_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SHOW",
    REAP r FROM parse_show_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "GIVE",
    REAP r FROM parse_give_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SET",
    REAP r FROM parse_set_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "LET",
    REAP r FROM parse_let_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "IF",
    REAP r FROM parse_if_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SEASON",
    REAP r FROM parse_season_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "REAP",
    REAP r FROM parse_reap_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "PUT",
    REAP r FROM parse_put_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "BREAK",
    REAP r FROM parse_break_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "CONTINUE",
    REAP r FROM parse_continue_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "AWAIT",
    REAP r FROM parse_await_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "START",
    REAP r FROM parse_start_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ASYNC",
    REAP r FROM parse_async_in_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "CANCEL",
    REAP r FROM parse_cancel_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "TRACE",
    REAP r FROM parse_trace_stmt, tokens, pos.
    GIVE r.
  /IF.
  # bare call: IDENT( or module:IDENT( → call_stmt (void FFI calls)
  REAP nx FROM peek, tokens, pos + 1.
  REAP nx_ty FROM tok_type, nx.
  IF nx_ty IS "LPAREN",
    REAP r FROM parse_call_stmt, tokens, pos.
    GIVE r.
  /IF.
  REAP nx2 FROM peek, tokens, pos + 1.
  REAP nx2_ty FROM tok_type, nx2.
  IF nx2_ty IS "COLON",
    REAP nx3 FROM peek, tokens, pos + 2.
    REAP nx3_ty FROM tok_type, nx3.
    IF nx3_ty IS "LPAREN",
      REAP r FROM parse_call_stmt, tokens, pos.
      GIVE r.
    /IF.
  /IF.
  GIVE plant_list_make(2, null, pos + 1).
/ACTION.

#── Declaration parsing ────────────────────────────────────────

ACTION parse_enum_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP name FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  REAP lbr FROM consume, tokens, p3.
  REAP p4 FROM _second, lbr.
  CREATE members(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "}",
      REAP rbr FROM consume, tokens, p4.
      REAP p5 FROM _second, rbr.
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p5).
    /IF.
    REAP m_pair FROM consume, tokens, p4.
    REAP mname FROM tok_lex, m_pair[0].
    REAP p5 FROM _second, m_pair.
    PUT mname INTO members.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
/ACTION.

ACTION parse_struct_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP sname FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  # generic type parameter list: [T, U] right after the struct name
  CREATE generics(LIST) TO plant_list_make(0).
  REAP sg_tok FROM peek, tokens, p3.
  REAP sg_lx FROM tok_lex, sg_tok.
  IF sg_lx IS "[",
    REAP sg_lb FROM consume, tokens, p3.
    REAP p3 FROM _second, sg_lb.
    REAP sgv FROM collect_type_text, tokens, p3, "]", 0.
    REAP sgtext FROM _first, sgv.
    REAP p3 FROM _second, sgv.
    REAP sg_rb FROM consume, tokens, p3.
    REAP p3 FROM _second, sg_rb.
    REAP sgparts FROM strings:SPLIT, sgtext, ",".
    CREATE sgi(NUM) TO 0.
    CREATE sge(TX) TO "".
    SEASON sgi < COUNT sgparts,
      REAP sge FROM plant_list_get, sgparts, sgi.
      REAP sget FROM trim, sge.
      IF sget > "",
        PUT sget INTO generics.
      /IF.
      SET sgi TO sgi + 1.
    /SEASON.
  /IF.
  REAP lb FROM consume, tokens, p3.
  REAP p4 FROM _second, lb.
  CREATE fields(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(8, "type", "struct_decl", "name", sname, "generics", generics, "fields", fields), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "}",
      REAP rb FROM consume, tokens, p4.
      REAP p5 FROM _second, rb.
      GIVE plant_list_make(2, plant_list_make(8, "type", "struct_decl", "name", sname, "generics", generics, "fields", fields), p5).
    /IF.
    REAP fn_pair FROM consume, tokens, p4.
    REAP fname FROM tok_lex, fn_pair[0].
    REAP p5 FROM _second, fn_pair.
    REAP col_pair FROM consume, tokens, p5.
    REAP p6 FROM _second, col_pair.
    REAP ftv FROM collect_type_text, tokens, p6, "}", 1.
    REAP ftype FROM _first, ftv.
    REAP p7 FROM _second, ftv.
    REAP ftypet FROM trim, ftype.
    PUT plant_list_make(4, "name", fname, "type", ftypet) INTO fields.
    REAP tok2 FROM peek, tokens, p7.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p7.
      REAP p7 FROM _second, com.
    /IF.
    SET p4 TO p7.
  /SEASON.
/ACTION.

ACTION parse_action_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP aname FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  # async priority modifier (default NORMAL=1)
  CREATE prio(TX) TO "1".
  # v0.48.15: mission mode (default BALANCED; WITH MISSION FAST/SAFE)
  CREATE mission_mode(TX) TO "BALANCED".
  # generic type parameter list: [T, U] right after the action name
  CREATE generics(LIST) TO plant_list_make(0).
  REAP ga_tok FROM peek, tokens, p3.
  REAP ga_lx FROM tok_lex, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM consume, tokens, p3.
    REAP p3 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p3, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p3 FROM _second, gv.
    REAP ga_rb FROM consume, tokens, p3.
    REAP p3 FROM _second, ga_rb.
    REAP gparts FROM strings:SPLIT, gtext, ",".
    CREATE gi2(NUM) TO 0.
    CREATE ge2(TX) TO "".
    SEASON gi2 < COUNT gparts,
      REAP ge2 FROM plant_list_get, gparts, gi2.
      REAP ge2t FROM trim, ge2.
      IF ge2t > "",
        PUT ge2t INTO generics.
      /IF.
      SET gi2 TO gi2 + 1.
    /SEASON.
  /IF.
  REAP lp FROM consume, tokens, p3.
  REAP p4 FROM _second, lp.
  CREATE params(LIST) TO plant_list_make(0).
  CREATE vararg(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", plant_list_make(0), "prio", prio, "ret", "", "mission_mode", mission_mode), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    # v0.48.4: variadic marker "..." — lexer yields DOT_DOT+DOT or
    # DOT DOT DOT
    IF lx IS "..",
      REAP tokv2 FROM peek, tokens, p4 + 1.
      REAP lxv2 FROM tok_lex, tokv2.
      IF lxv2 IS ".",
        SET vararg TO "1".
        SET p4 TO p4 + 2.
        REAP ctok2 FROM peek, tokens, p4.
        REAP clx2 FROM tok_lex, ctok2.
        IF clx2 IS ")", SET p4 TO p4 + 1. /IF.
        IF clx2 IS ",", SET p4 TO p4 + 2. /IF.
        SET p5 TO p4.
        BREAK 0.
      /IF.
    /IF.
    IF lx IS ".",
      REAP tokv2 FROM peek, tokens, p4 + 1.
      REAP lxv2 FROM tok_lex, tokv2.
      IF lxv2 IS "..",
        SET vararg TO "1".
        SET p4 TO p4 + 2.
        REAP ctok2 FROM peek, tokens, p4.
        REAP clx2 FROM tok_lex, ctok2.
        IF clx2 IS ")", SET p4 TO p4 + 1. /IF.
        IF clx2 IS ",", SET p4 TO p4 + 2. /IF.
        SET p5 TO p4.
        BREAK 0.
      /IF.
      IF lxv2 IS ".",
        REAP tokv3 FROM peek, tokens, p4 + 2.
        REAP lxv3 FROM tok_lex, tokv3.
        IF lxv3 IS ".",
          SET vararg TO "1".
          SET p4 TO p4 + 3.
          REAP ctok2 FROM peek, tokens, p4.
          REAP clx2 FROM tok_lex, ctok2.
          IF clx2 IS ")", SET p4 TO p4 + 1. /IF.
          IF clx2 IS ",", SET p4 TO p4 + 2. /IF.
          SET p5 TO p4.
          BREAK 0.
        /IF.
      /IF.
    /IF.
    IF lx IS ")",
      REAP rp FROM consume, tokens, p4.
      REAP p5 FROM _second, rp.
      CREATE brk(NUM) TO 0.
      BREAK 0.
    /IF.
    REAP pn_pair FROM consume, tokens, p4.
    REAP pn FROM tok_lex, pn_pair[0].
    REAP p5 FROM _second, pn_pair.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS "(",
      REAP lp2 FROM consume, tokens, p5.
      REAP p6 FROM _second, lp2.
      # collect the full type text: T, LIST[T], REF NUM, REF LIST[T] …
      REAP ptv FROM collect_type_text, tokens, p6, ")", 1.
      REAP pt FROM _first, ptv.
      REAP p7 FROM _second, ptv.
      # normalize pointer markers: "void *" → "void*" (lexer splits *)
      REAP pt FROM strings:REPLACE, pt, " *", "*".
      REAP pt FROM strings:REPLACE, pt, "* ", "*".
      # consume the closing ")" of the type group
      REAP rp2 FROM consume, tokens, p7.
      REAP p7 FROM _second, rp2.
      PUT plant_list_make(4, "name", pn, "type", pt) INTO params.
      SET p5 TO p7.
    /IF.
    IF lx2 ISNT "(",
      PUT plant_list_make(4, "name", pn, "type", "") INTO params.
    /IF.
    REAP tok3 FROM peek, tokens, p5.
    REAP lx3 FROM tok_lex, tok3.
    IF lx3 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
  # skip optional -> Type (then check if , or .)
  CREATE ret(TX) TO "".
  REAP arrow_tok FROM peek, tokens, p5.
  REAP arrow_lx FROM tok_lex, arrow_tok.
  IF arrow_lx IS "->",
    REAP arrow_pair FROM consume, tokens, p5.
    REAP p5 FROM _second, arrow_pair.
    # skip bogus MINUS=- token (lexer bug: -> produces extra MINUS)
    REAP skip_tok FROM peek, tokens, p5.
    REAP skip_ty FROM tok_type, skip_tok.
    IF skip_ty IS "MINUS",
      REAP skip_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, skip_pair.
    /IF.
    REAP ret_pair FROM consume, tokens, p5.
    REAP ret_lx FROM tok_lex, ret_pair[0].
    REAP p5 FROM _second, ret_pair.
    # v0.48.4: FFI return types — external (default), Result<T,E>,
    # STRUCT X (by-value struct), void*
    IF ret_lx IS "Result", SET ret TO "Result". /IF.
    IF ret_lx IS "STRUCT",
      REAP rtv FROM collect_type_text, tokens, p5, ".", 0.
      REAP rtt FROM _first, rtv.
      REAP p5 FROM _second, rtv.
      SET ret TO "STRUCT " + rtt.
    /IF.
    # v0.48.12: ENUM X — FFI boundary enums (raw member ints in C,
    # wrapped with _from_enum on the PlantLang side)
    IF ret_lx IS "ENUM",
      REAP rtv FROM collect_type_text, tokens, p5, ".", 0.
      REAP rtt FROM _first, rtv.
      REAP p5 FROM _second, rtv.
      SET ret TO "ENUM " + rtt.
    /IF.
    IF ret_lx IS "void",
      REAP vst FROM peek, tokens, p5.
      REAP vsl FROM tok_lex, vst.
      IF vsl IS "*",
        REAP vsp FROM consume, tokens, p5.
        REAP p5 FROM _second, vsp.
        SET ret TO "void*".
      /IF.
    /IF.
    # Result<T, E> generics: -> Result<NUM, TX>. (E = TX error string)
    IF ret_lx IS "Result",
      REAP lt_tok FROM peek, tokens, p5.
      REAP lt_lx FROM tok_lex, lt_tok.
      IF lt_lx IS "<",
        REAP lt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, lt_pair.
        REAP rt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, rt_pair.
        REAP rc_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, rc_pair.
        REAP re_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, re_pair.
        REAP gt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, gt_pair.
      /IF.
    /IF.
    # v0.48.13: plain return types (T, NUM, TX, enum names…) are
    # stored on the action_decl node so generic instantiations know
    # their substituted return type (drives _from_long wrapping of
    # numeric GIVEs). FFI marker keywords are never stored here.
    IF ret IS "" AND ret_lx ISNT "external" AND ret_lx ISNT "Result" AND ret_lx ISNT "STRUCT" AND ret_lx ISNT "ENUM" AND ret_lx ISNT "void",
      SET ret TO ret_lx.
    /IF.
  /IF.
  # optional PRIORITY HIGH|NORMAL|LOW modifier (async actions)
  REAP pr_tok FROM peek, tokens, p5.
    REAP pr_lx FROM tok_lex, pr_tok.
    IF pr_lx IS "PRIORITY",
      REAP pr_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, pr_pair.
      REAP lv_pair FROM consume, tokens, p5.
      REAP lv_lx FROM tok_lex, lv_pair[0].
      REAP p5 FROM _second, lv_pair.
      IF lv_lx IS "HIGH", SET prio TO "0". /IF.
      IF lv_lx IS "NORMAL", SET prio TO "1". /IF.
      IF lv_lx IS "LOW", SET prio TO "2". /IF.
    /IF.
    # v0.48.15: WITH MISSION <MODE> — FAST (bump heap) / SAFE (boundary
    # guarded) / BALANCED (default). Optional; comes after PRIORITY.
    REAP wm_tok FROM peek, tokens, p5.
    REAP wm_lx FROM tok_lex, wm_tok.
    IF wm_lx IS "WITH",
      REAP wm_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, wm_pair.
      REAP ms_pair FROM consume, tokens, p5.
      REAP ms_lx FROM tok_lex, ms_pair[0].
      REAP p5 FROM _second, ms_pair.
      IF ms_lx IS "MISSION",
        REAP md_pair FROM consume, tokens, p5.
        REAP md_lx FROM tok_lex, md_pair[0].
        REAP p5 FROM _second, md_pair.
        SET mission_mode TO md_lx.
      /IF.
    /IF.
    REAP after_tok FROM peek, tokens, p5.
    REAP after_lx FROM tok_lex, after_tok.
    IF after_lx IS ",",
      REAP com_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, com_pair.
    /IF.
    IF after_lx IS ".",
      REAP dot_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, dot_pair.
      IF ret_lx IS "external" OR ret_lx IS "Result" OR ret_lx IS "STRUCT" OR ret_lx IS "ENUM" OR ret IS "void*",
        GIVE plant_list_make(2, plant_list_make(10, "type", "external_decl", "name", aname, "params", params, "ret", ret, "varargs", vararg), p5).
      /IF.
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", plant_list_make(0), "prio", prio, "ret", ret, "mission_mode", mission_mode), p5).
    /IF.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", body, "prio", prio, "ret", ret, "mission_mode", mission_mode), p5).
    /IF.
    REAP tok4 FROM peek, tokens, p5.
    REAP lx4 FROM tok_lex, tok4.
    IF lx4 IS "/",
      REAP slash FROM consume, tokens, p5.
      REAP p6 FROM _second, slash.
      REAP end FROM consume, tokens, p6.
      REAP p7 FROM _second, end.
      REAP dot FROM consume, tokens, p7.
      REAP p8 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", body, "prio", prio, "ret", ret, "mission_mode", mission_mode), p8).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p5.
    CREATE stmt TO stmt_pair[0].
    REAP p5 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_declaration(tokens(LIST), pos(NUM)),
  REAP tok FROM peek, tokens, pos.
  REAP lx FROM tok_lex, tok.
  IF lx IS "ENUM",
    REAP r FROM parse_enum_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "STRUCT",
    REAP r FROM parse_struct_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ACTION",
    REAP r FROM parse_action_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ASYNC",
    REAP pair FROM peek, tokens, pos + 1.
    REAP nx FROM tok_lex, pair.
    IF nx IS "IN",
      REAP r FROM parse_async_in_stmt, tokens, pos.
      GIVE r.
    /IF.
    REAP r FROM parse_action_decl, tokens, pos + 1.
    REAP nd FROM _first, r.
    REAP np FROM _second, r.
    REAP nt FROM _map_get, nd, "type".
    IF nt IS "action_decl",
      REAP nd2 FROM map_add, nd, "async", "1".
      GIVE plant_list_make(2, nd2, np).
    /IF.
    GIVE r.
  /IF.
  IF lx IS "MISSION",
    REAP r FROM parse_mission_stmt, tokens, pos.
    GIVE r.
  /IF.
  REAP r FROM parse_statement, tokens, pos.
  GIVE r.
/ACTION.

# map_add: append a key/value pair to a flat map list
ACTION map_add(m(LIST), k(TX), v(TX)),
  CREATE out(LIST) TO plant_list_make(0).
  CREATE mi3(NUM) TO 0.
  SEASON mi3 < COUNT m,
    REAP me3 FROM plant_list_get, m, mi3.
    PUT me3 INTO out.
    SET mi3 TO mi3 + 1.
  /SEASON.
  PUT k INTO out.
  PUT v INTO out.
  GIVE out.
/ACTION.

#── Top-level ──────────────────────────────────────────────────

ACTION parse_program(tokens(LIST)),
  CREATE pos(NUM) TO 0.
  CREATE nodes(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, pos.
    IF is_eof_flag,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    REAP d_pair FROM parse_declaration, tokens, pos.
    CREATE decl TO d_pair[0].
    REAP pos2 FROM _second, d_pair.
    IF decl > "",
      REAP dty FROM _map_get, decl, "type".
      IF dty IS "syntax_error",
        REAP dmsg FROM _map_get, decl, "msg".
        GIVE plant_list_make(6, "type", "program", "body", nodes, "error", dmsg).
      /IF.
    /IF.
    IF pos2 <= pos,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    SET pos TO pos2.
    IF decl > "",
      PUT decl INTO nodes.
    /IF.
  /SEASON.
/ACTION.
# ═══════════════════════════════════════════════════════════════
#  src/plantc/codegen_c.plant — PlantLang → C99 Code Generator
#
#  Consumes AST maps produced by src/plantc/parser.plant and
#  emits valid C99 source compatible with <plant_runtime.h>.
#
#  Node types handled:
#    show_stmt, create_stmt, let_stmt, set_stmt, give_stmt,
#    reap_stmt, put_stmt, break_stmt, continue_stmt,
#    if_stmt, season_stmt, cycle_stmt, match_stmt,
#    action_decl, enum_decl, program
# ═══════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────
#  _substr — extract substring [start, end) from str
# ──────────────────────────────────────────────────────────────
ACTION _substr(str(TX), start(NUM), end(NUM)),
    GIVE substring(str, start, end).
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_func — translate "KW varname" -> "CFN(varname)"
# ──────────────────────────────────────────────────────────────
ACTION _handle_func(expr(TX), kw(TX), cfn(TX)),
    REAP parts FROM strings:SPLIT, expr, kw + " ".
    IF COUNT parts IS 1, GIVE expr. /IF.
    REAP p0 FROM plant_list_get, parts, 0.
    CREATE res(TX) TO p0.
    CREATE idx(NUM) TO 1.
    SEASON idx < COUNT parts,
        REAP cur FROM plant_list_get, parts, idx.
        REAP pos FROM find_any, cur, " +)(".
        IF pos IS -1, SET pos TO LEN(cur). /IF.
        REAP vname FROM substring, cur, 0, pos.
        REAP rest FROM substring, cur, pos, LEN(cur).
        SET res TO res + cfn + "(" + vname + ")" + rest.
        SET idx TO idx + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_func_paren — translate "LEN(expr)" -> "strlen(expr)"
# ──────────────────────────────────────────────────────────────
ACTION _handle_func_paren(expr(TX), kw(TX), cfn(TX)),
    REAP parts FROM strings:SPLIT, expr, kw + " (".
    IF COUNT parts IS 1,
        REAP parts FROM strings:SPLIT, expr, kw + "(".
    /IF.
    IF COUNT parts IS 1, GIVE expr. /IF.
    REAP p0 FROM plant_list_get, parts, 0.
    CREATE res(TX) TO p0.
    CREATE idx(NUM) TO 1.
    SEASON idx < COUNT parts,
        REAP p FROM plant_list_get, parts, idx.
        SET res TO res + cfn + "(" + p.
        SET idx TO idx + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_identifier — 1 when the text is a C/PlantLang identifier
#  (letter or _ first, then letters/digits/_). Digit literals like
#  "2" or "0x10" are NOT identifiers. Used by seg_is_numeric so
#  identifiers that merely contain digits (eb2, n2) are never
#  mistaken for raw numeric literals (v0.48.20-patch).
# ──────────────────────────────────────────────────────────────
ACTION is_identifier(tok(TX)),
  CREATE i0(NUM) TO 0.
  CREATE ch0(TX) TO "".
  IF LEN(tok) IS 0, GIVE 0. /IF.
  REAP ch0 FROM char_at, tok, 0.
  REAP f0 FROM find_any, ch0, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_".
  IF f0 IS -1, GIVE 0. /IF.
  SET i0 TO 1.
  SEASON i0 < LEN(tok),
    REAP ch0 FROM char_at, tok, i0.
    REAP f0 FROM find_any, ch0, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_".
    IF f0 IS -1, GIVE 0. /IF.
    SET i0 TO i0 + 1.
  /SEASON.
  GIVE 1.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  seg_is_numeric — 1 when a concatenation segment is a numeric
#  value or expression: digit literals and identifiers/expressions
#  built only from NUM/FACT vars (nums) and arithmetic operators.
#  Identifier tokens are checked against nums even when they
#  contain digits (is_identifier), so "eb2" is never treated as a
#  raw literal (v0.48.20-patch).
#  Used by _handle_cat to decide _from_long() wrapping.
# ──────────────────────────────────────────────────────────────
#  seg_has_literal_digit — 1 when the segment text contains a digit
#  that belongs to a genuine numeric literal rather than an
#  identifier (is_identifier). "p5" has a digit but is an
#  identifier → 0; "1" and "(2 + 3)" are literals → 1. Lets
#  _handle_cat keep the raw C "+" arithmetic shortcut (which REAP'd
#  index vars like p5 rely on) without letting identifier digits
#  like "eb2" trigger it (v0.48.20-patch).
# ──────────────────────────────────────────────────────────────
ACTION seg_has_literal_digit(seg(TX)),
  REAP sid FROM is_identifier, seg.
  IF sid IS 1, GIVE 0. /IF.
  REAP sb FROM strings:REPLACE, seg, " ", "".
  CREATE si2(NUM) TO 0.
  CREATE sc2(TX) TO "".
  SEASON si2 < LEN(sb),
    REAP sc2 FROM char_at, sb, si2.
    REAP sd FROM find_any, sc2, "0123456789".
    IF sd ISNT -1, GIVE 1. /IF.
    SET si2 TO si2 + 1.
  /SEASON.
  GIVE 0.
/ACTION.

ACTION seg_is_numeric(seg(TX), nums(LIST)),
  REAP sb FROM strings:REPLACE, seg, " ", "".
  IF sb IS "", GIVE 0. /IF.
  # known numeric-returning calls (translate_expr output): LEN→strlen,
  # COUNT→plant_array_length, _to_long — their results are C longs.
  REAP pre0 FROM substring, sb, 0, 7.
  IF pre0 IS "strlen(", GIVE 1. /IF.
  REAP pre1 FROM substring, sb, 0, 19.
  IF pre1 IS "plant_array_length(", GIVE 1. /IF.
  REAP pre2 FROM substring, sb, 0, 9.
  IF pre2 IS "_to_long(", GIVE 1. /IF.
  REAP pre3 FROM substring, sb, 0, 9.
  IF pre3 IS "json_len(", GIVE 1. /IF.
  REAP pre4 FROM substring, sb, 0, 10.
  IF pre4 IS "json_kind(", GIVE 1. /IF.
  REAP pre5 FROM substring, sb, 0, 9.
  IF pre5 IS "set_size(", GIVE 1. /IF.
  REAP pre6 FROM substring, sb, 0, 11.
  IF pre6 IS "queue_size(", GIVE 1. /IF.
  REAP pre7 FROM substring, sb, 0, 11.
  IF pre7 IS "stack_size(", GIVE 1. /IF.
  REAP pre8 FROM substring, sb, 0, 14.
  IF pre8 IS "ffi_last_error(", GIVE 1. /IF.
  CREATE si(NUM) TO 0.
  CREATE sc(TX) TO "".
  CREATE tok(TX) TO "".
  CREATE toknum(NUM) TO 1.
  SEASON si < LEN(sb),
    REAP sc FROM char_at, sb, si.
    REAP isid FROM find_any, sc, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_".
    IF isid ISNT -1,
      SET tok TO tok + sc.
    /IF.
    IF isid IS -1,
      REAP isop FROM find_any, sc, "+-*/%^<>=!&|()".
      IF isop IS -1, GIVE 0. /IF.
      IF tok > "",
        REAP tokid FROM is_identifier, tok.
        IF tokid IS 1, SET toknum TO 0. /IF.
        IF toknum IS 0,
          REAP mf FROM list_contains, nums, tok.
          IF mf IS 0, GIVE 0. /IF.
        /IF.
        SET tok TO "".
        SET toknum TO 1.
      /IF.
    /IF.
    SET si TO si + 1.
  /SEASON.
  IF tok > "",
    REAP tokid FROM is_identifier, tok.
    IF tokid IS 1, SET toknum TO 0. /IF.
    IF toknum IS 0,
      REAP mf FROM list_contains, nums, tok.
      IF mf IS 0, GIVE 0. /IF.
    /IF.
  /IF.
  GIVE 1.
/ACTION.

# ──────────────────────────────────────────────
#  expr_is_numeric — 1 when a tx_t-context value expression is a
#  scalar C numeric: a digit literal, a NUM/FACT var reference,
#  arithmetic built only from numerics, or a known numeric-returning
#  call (LEN/COUNT/_to_long/std numeric readers). Quoted string
#  literals are never numeric ("12" stays text). Used by the
#  show_stmt generator to wrap raw longs in _from_long before
#  plant_print (v0.48.5 numeric SHOW).
# ──────────────────────────────────────────────
ACTION expr_is_numeric(e(TX), nums(LIST)),
    REAP q0 FROM substring, e, 0, 1.
    IF q0 IS "\"", GIVE 0. /IF.
    REAP sn FROM seg_is_numeric, e, nums.
    GIVE sn.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_numeric_type — 1 when a (substituted) PlantLang type is a
#  scalar numeric type (NUM/FACT). gen_give_stmt wraps the GIVE
#  value of NUM-typed actions in _from_long so callers receive the
#  value as text instead of raw long bits (v0.48.13).
# ──────────────────────────────────────────────────────────────
ACTION is_numeric_type(t(TX)),
  IF t IS "NUM" OR t IS "FACT", GIVE 1. /IF.
  GIVE 0.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_cat — convert + to _cat() for string concatenation
#  Raw C "+" only when every top-level segment is verifiably
#  numeric (seg_is_numeric); identifiers containing digits like
#  "eb2" now concatenate instead of producing void*+void* C errors
#  (v0.48.20-patch).
#  nums: names of scalar NUM/FACT vars in scope; bare identifiers
#  listed there get _from_long() so "x" + n works (v0.48.3a)
#  NOTE: does NOT handle quoted + inside string literals correctly
#  so it should only be called on show_stmt values which rarely
#  contain string literals with + as delimiter arguments
# ──────────────────────────────────────────────────────────────
ACTION _handle_cat(expr(TX), nums(LIST), evars(LIST)),
    CREATE parts(LIST) TO plant_list_make(0).
    CREATE depth(NUM) TO 0.
    CREATE instr(NUM) TO 0.
    CREATE i(NUM) TO 0.
    CREATE ch(TX) TO "".
    CREATE c0(TX) TO "".
    CREATE c1(TX) TO "".
    CREATE seg(TX) TO "".
    CREATE start(NUM) TO 0.
    CREATE res(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE pel(TX) TO "".
    CREATE has_str(NUM) TO 0.
    # scan for top-level " + " (outside parens and strings) and split there
    SEASON i < LEN(expr),
        REAP ch FROM char_at, expr, i.
        IF ch IS "\"", SET instr TO 1 - instr. SET has_str TO 1. /IF.
        IF instr IS 1 AND ch IS "\\", SET i TO i + 1. /IF.
        IF instr IS 0 AND ch IS "(", SET depth TO depth + 1. /IF.
        IF instr IS 0 AND ch IS ")", SET depth TO depth - 1. /IF.
        IF instr IS 0 AND ch IS "+" AND depth IS 0,
            REAP c0 FROM char_at, expr, i - 1.
            REAP c1 FROM char_at, expr, i + 1.
            IF c0 IS " " AND c1 IS " ",
                REAP seg FROM substring, expr, start, i - 1.
                PUT seg INTO parts.
                SET start TO i + 2.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    REAP seg FROM substring, expr, start, LEN(expr).
    IF (COUNT parts) IS 0, GIVE expr. /IF.
    # genuine numeric literal present (digit outside identifiers, e.g.
    # "1" in "p5 + 1") and no quoted string → raw numeric C "+", the
    # v0.48.3 shortcut REAP'd index vars (tx_t holding bit patterns)
    # depend on. Identifier digits alone (ccode + eb2) never fire it.
    CREATE has_lit(NUM) TO 0.
    CREATE ni9(NUM) TO 0.
    CREATE p9(TX) TO "".
    SEASON ni9 < COUNT parts,
        REAP p9 FROM plant_list_get, parts, ni9.
        REAP hl9 FROM seg_has_literal_digit, p9.
        IF hl9 IS 1, SET has_lit TO 1. /IF.
        SET ni9 TO ni9 + 1.
    /SEASON.
    REAP hl9 FROM seg_has_literal_digit, seg.
    IF hl9 IS 1, SET has_lit TO 1. /IF.
    IF has_str IS 0 AND has_lit IS 1,
        GIVE strings_REPLACE(expr, " + ", "+").
    /IF.
    # no genuine literal: ambiguous — every segment verifiably numeric
    # (digit literal, NUM/FACT var in nums, known numeric-returning
    # call) → keep C "+"; otherwise fall through so string variables
    # concatenate (identifiers with digits like eb2 route to _cat,
    # v0.48.20-patch).
    IF has_str IS 0,
        CREATE allnum(NUM) TO 1.
        CREATE ni0(NUM) TO 0.
        CREATE pe0(TX) TO "".
        SEASON ni0 < COUNT parts,
            REAP pe0 FROM plant_list_get, parts, ni0.
            REAP sg0 FROM seg_is_numeric, pe0, nums.
            IF sg0 IS 0, SET allnum TO 0. /IF.
            SET ni0 TO ni0 + 1.
        /SEASON.
        REAP sg0 FROM seg_is_numeric, seg, nums.
        IF sg0 IS 0, SET allnum TO 0. /IF.
        IF allnum IS 1,
            GIVE strings_REPLACE(expr, " + ", "+").
        /IF.
    /IF.
    PUT seg INTO parts.
    CREATE nparts(LIST) TO plant_list_make(0).
    CREATE ni(NUM) TO 0.
    CREATE pel2(TX) TO "".
    SEASON ni < COUNT parts,
        REAP pel2 FROM plant_list_get, parts, ni.
        REAP sgn FROM seg_is_numeric, pel2, nums.
        IF sgn IS 1,
            SET pel2 TO "_from_long(" + pel2 + ")".
        /IF.
        REAP snm FROM enum_expr_of, evars, pel2.
        IF sgn IS 0 AND snm ISNT "",
            SET pel2 TO "_from_enum(" + pel2 + ", \"" + snm + "\")".
        /IF.
        PUT pel2 INTO nparts.
        SET ni TO ni + 1.
    /SEASON.
    SET res TO nparts[0].
    SET pi TO 1.
    SEASON pi < COUNT nparts,
        REAP pel FROM plant_list_get, nparts, pi.
        SET res TO "_cat(" + res + ", " + pel + ")".
        SET pi TO pi + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  collect_implicit — REAP targets never declared (params,
#  CREATE/LET) in an action body; auto-declare them as tx_t.
# ──────────────────────────────────────────────────────────────
#  _if_bodies — flatten an if_stmt's branch bodies (main body,
#  every ORIF body, and the ELSE body) into one list so every
#  statement-walking pass treats all branches uniformly (v0.48.20).
# ──────────────────────────────────────────────────────────────
ACTION _if_bodies(nd),
  CREATE out(LIST) TO plant_list_make(0).
  REAP mb FROM _map_get, nd, "body".
  PUT mb INTO out.
  REAP el FROM _map_get, nd, "elif".
  CREATE ei(NUM) TO 1.
  SEASON ei < COUNT el,
    REAP eb FROM plant_list_get, el, ei.
    PUT eb INTO out.
    SET ei TO ei + 2.
  /SEASON.
  REAP eb2 FROM _map_get, nd, "else".
  IF COUNT eb2 > 0,
    PUT eb2 INTO out.
  /IF.
  GIVE out.
/ACTION.

ACTION collect_declared_walk(bd(LIST), declared(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "create_stmt" OR ty IS "let_stmt",
      REAP tgt FROM _map_get, nd, "target".
      PUT tgt INTO declared.
    /IF.
    IF ty IS "if_stmt",
      REAP ib FROM _if_bodies, nd.
      CREATE ii2(NUM) TO 0.
      SEASON ii2 < COUNT ib,
        REAP ibd FROM plant_list_get, ib, ii2.
        REAP sub_ret FROM collect_declared_walk, ibd, declared.
        SET ii2 TO ii2 + 1.
      /SEASON.
    /IF.
    IF ty IS "season_stmt",
      REAP sub_bd FROM _map_get, nd, "body".
      REAP sub_ret FROM collect_declared_walk, sub_bd, declared.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE "ok".
/ACTION.

ACTION collect_used_walk(bd(LIST), used(LIST), declared(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "reap_stmt",
      REAP tgt FROM _map_get, nd, "target".
      CREATE found(NUM) TO 0.
      CREATE fi(NUM) TO 0.
      CREATE fe(TX) TO "".
      SEASON fi < COUNT declared,
        REAP fe FROM plant_list_get, declared, fi.
        IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
        SET fi TO fi + 1.
      /SEASON.
      SET fi TO 0.
      SEASON fi < COUNT used,
        REAP fe FROM plant_list_get, used, fi.
        IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
        SET fi TO fi + 1.
      /SEASON.
      IF NOT found,
        PUT tgt INTO used.
      /IF.
    /IF.
    IF ty IS "if_stmt",
      REAP ib FROM _if_bodies, nd.
      CREATE ii2(NUM) TO 0.
      SEASON ii2 < COUNT ib,
        REAP ibd FROM plant_list_get, ib, ii2.
        REAP sub_ret FROM collect_used_walk, ibd, used, declared.
        SET ii2 TO ii2 + 1.
      /SEASON.
    /IF.
    IF ty IS "season_stmt",
      REAP sub_bd FROM _map_get, nd, "body".
      REAP sub_ret FROM collect_used_walk, sub_bd, used, declared.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE "ok".
/ACTION.

ACTION collect_implicit(bd(LIST), params(LIST)),
  CREATE used(LIST) TO plant_list_make(0).
  CREATE declared(LIST) TO plant_list_make(0).
  CREATE ci(NUM) TO 0.
  CREATE pn(TX) TO "".
  SEASON ci < COUNT params,
    REAP pn FROM _map_get, params[ci], "name".
    PUT pn INTO declared.
    SET ci TO ci + 1.
  /SEASON.
  REAP sub_ret FROM collect_declared_walk, bd, declared.
  REAP sub_ret FROM collect_used_walk, bd, used, declared.
  GIVE used.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  v0.48.6 — ENUM display repair
#  collect_enums_* — flat [name, membersCsv, …] table of every
#  enum-typed variable reachable in an action body plus every enum
#  member constant (module-scope). membersCsv is the comma-joined
#  member list of the enum type (built by build_enum_registry from
#  the module AST). Used at SHOW/concat sites to wrap enum refs
#  with _from_enum(var, "RED,GREEN,BLUE") so they print member
#  names instead of crashing on raw enum-int-as-pointer.
# ──────────────────────────────────────────────────────────────
ACTION build_enum_registry(ast(LIST)),
  CREATE reg(LIST) TO plant_list_make(0).
  CREATE ei(NUM) TO 0.
  CREATE ne(TX) TO "".
  CREATE nty(TX) TO "".
  SEASON ei < COUNT ast,
    REAP ne FROM plant_list_get, ast, ei.
    REAP nty FROM _map_get, ne, "type".
    IF nty IS "enum_decl",
      REAP enm FROM _map_get, ne, "name".
      CREATE mems(LIST) TO _map_get(ne, "members").
      CREATE csv(TX) TO "".
      CREATE mi(NUM) TO 0.
      SEASON mi < COUNT mems,
        IF mi > 0, SET csv TO csv + ",". /IF.
        SET csv TO csv + plant_list_get(mems, mi).
        SET mi TO mi + 1.
      /SEASON.
      PUT enm INTO reg.
      PUT csv INTO reg.
    /IF.
    SET ei TO ei + 1.
  /SEASON.
  # struct entries: "STRUCT.<Name>" → "gensCsv;fieldCsv" (raw field
  # types, generics comma-joined, fields "name:type" comma-joined).
  # collect_enums uses them to register enum field reads of
  # struct-typed vars as plant_map_get(var, "field") keys (v0.48.10).
  CREATE si(NUM) TO 0.
  CREATE sn(TX) TO "".
  CREATE sty(TX) TO "".
  SEASON si < COUNT ast,
    REAP sn FROM plant_list_get, ast, si.
    REAP sty FROM _map_get, sn, "type".
    IF sty IS "struct_decl",
      REAP sname2 FROM _map_get, sn, "name".
      CREATE gslst(LIST) TO _map_get(sn, "generics").
      CREATE fslst(LIST) TO _map_get(sn, "fields").
      CREATE gcsv(TX) TO "".
      CREATE gidx(NUM) TO 0.
      SEASON gidx < COUNT gslst,
        IF gidx > 0, SET gcsv TO gcsv + ",". /IF.
        SET gcsv TO gcsv + plant_list_get(gslst, gidx).
        SET gidx TO gidx + 1.
      /SEASON.
      CREATE fcsv(TX) TO "".
      CREATE fidx(NUM) TO 0.
      CREATE fel3(TX) TO "".
      SEASON fidx < COUNT fslst,
        REAP fel3 FROM plant_list_get, fslst, fidx.
        IF fidx > 0, SET fcsv TO fcsv + ",". /IF.
        SET fcsv TO fcsv + _map_get(fel3, "name") + ":" + _map_get(fel3, "type").
        SET fidx TO fidx + 1.
      /SEASON.
      CREATE srekey(TX) TO "STRUCT." + sname2.
      CREATE sreval(TX) TO gcsv + ";" + fcsv.
      PUT srekey INTO reg.
      PUT sreval INTO reg.
    /IF.
    SET si TO si + 1.
  /SEASON.
  GIVE reg.
/ACTION.

# add_struct_enum_keys — for a struct-typed variable, register the
# enum field reads plant_map_get(var, "field") into the flat table
# res (keyed by the canonical token-joined expression form emitted
# by translate_expr). vtype is the (subst'd) declared type; enum
# fields of generic structs resolve through their type args.
ACTION add_struct_enum_keys(reg(LIST), vtype(TX), vname(TX), res(LIST)),
  CREATE vty2(TX) TO vtype.
  REAP rp0 FROM substring, vty2, 0, 4.
  IF rp0 IS "REF ", SET vty2 TO substring(vty2, 4, LEN(vty2)). /IF.
  REAP rp1 FROM substring, vty2, 0, 7.
  IF rp1 IS "STRUCT ", SET vty2 TO substring(vty2, 7, LEN(vty2)). /IF.
  REAP wbase2 FROM type_base, vty2.
  CREATE srlk(TX) TO "STRUCT." + wbase2.
  REAP raw2 FROM _cl_map_get, reg, srlk.
  IF raw2 IS "", GIVE res. /IF.
  REAP halves FROM strings:SPLIT, raw2, ";".
  CREATE gens2(LIST) TO plant_list_make(0).
  CREATE flds2(LIST) TO plant_list_make(0).
  IF COUNT halves > 0, REAP gens2 FROM strings:SPLIT, halves[0], ",". /IF.
  IF COUNT halves > 1, REAP flds2 FROM strings:SPLIT, halves[1], ",". /IF.
  REAP args2 FROM parse_type_args, vtype.
  CREATE fsub2(LIST) TO build_subst(gens2, args2).
  CREATE fi2(NUM) TO 0.
  CREATE fe2(TX) TO "".
  CREATE fnm2(TX) TO "".
  CREATE fty2(TX) TO "".
  SEASON fi2 < COUNT flds2,
    REAP fe2 FROM plant_list_get, flds2, fi2.
    REAP colon2 FROM find_any, fe2, ":".
    IF colon2 ISNT -1,
      REAP fnm2 FROM substring, fe2, 0, colon2.
      REAP fty2 FROM substring, fe2, colon2 + 1, LEN(fe2).
      REAP fty2 FROM subst_type, fty2, fsub2.
      REAP fcsv2 FROM enum_members_of, reg, fty2.
      IF fcsv2 ISNT "",
        CREATE ekey2(TX) TO "plant_map_get ( " + vname + " , \"" + fnm2 + "\" )".
        REAP ef2 FROM list_contains, res, ekey2.
        IF ef2 IS 0,
          PUT ekey2 INTO res.
          PUT fcsv2 INTO res.
        /IF.
      /IF.
    /IF.
    SET fi2 TO fi2 + 1.
  /SEASON.
  GIVE res.
/ACTION.

# enum_members_of — membersCsv for a type in a flat registry, or ""
ACTION enum_members_of(reg(LIST), ty(TX)),
  CREATE res(TX) TO "".
  CREATE ty2(TX) TO ty.
  REAP rp0 FROM substring, ty2, 0, 5.
  IF rp0 IS "ENUM ", SET ty2 TO substring(ty2, 5, LEN(ty2)). /IF.
  CREATE ri(NUM) TO 0.
  CREATE rn(TX) TO "".
  CREATE rv(TX) TO "".
  SEASON ri + 1 < COUNT reg,
    REAP rn FROM plant_list_get, reg, ri.
    REAP rv FROM plant_list_get, reg, ri + 1.
    IF str_eq(rn, ty2) IS "1", SET res TO rv. /IF.
    SET ri TO ri + 2.
  /SEASON.
  GIVE res.
/ACTION.

# reg_has_enum — 1 when the registry carries at least one ENUM
# entry (a key that is not one of the "STRUCT." field tables).
# Modules without enums fast-skip the whole collect_enums body
# traversal instead of walking every statement (v0.48.11).
ACTION reg_has_enum(reg(LIST)),
  CREATE ri(NUM) TO 0.
  CREATE rk(TX) TO "".
  CREATE rpre(TX) TO "".
  SEASON ri + 1 < COUNT reg,
    REAP rk FROM plant_list_get, reg, ri.
    REAP rpre FROM substring, rk, 0, 7.
    IF rpre ISNT "STRUCT.",
      GIVE 1.
    /IF.
    SET ri TO ri + 2.
  /SEASON.
  GIVE 0.
/ACTION.

# collect_enums_walk — add enum-typed CREATE/LET targets (as
# [name, membersCsv] pairs) from a body, recursing IF/SEASON/CYCLE/
# MATCH bodies, into the flat table res. REAP targets inherit the
# callee's return type from sigs so struct-returning calls register
# their struct field reads too (v0.48.10).
ACTION collect_enums_walk(bd, subst, reg, sigs, res),
  CREATE wi(NUM) TO 0.
  CREATE wnd(TX) TO "".
  CREATE wty(TX) TO "".
  CREATE wtg(TX) TO "".
  CREATE wvt(TX) TO "".
  CREATE wbs(TX) TO "".
  CREATE wms(TX) TO "".
  SEASON wi < COUNT bd,
    REAP wnd FROM plant_list_get, bd, wi.
    REAP wty FROM _map_get, wnd, "type".
    IF wty IS "create_stmt" OR wty IS "let_stmt",
      REAP wtg FROM _map_get, wnd, "target".
      REAP wvt FROM _map_get, wnd, "var_type".
      REAP wbs FROM subst_type, wvt, subst.
      REAP wms FROM enum_members_of, reg, wbs.
      IF wms > "",
        REAP wfound FROM list_contains, res, wtg.
        IF wfound IS 0,
          PUT wtg INTO res.
          PUT wms INTO res.
        /IF.
      /IF.
      IF wms IS "",
        REAP wrf FROM add_struct_enum_keys, reg, wbs, wtg, res.
      /IF.
    /IF.
    IF wty IS "reap_stmt",
      REAP wtg FROM _map_get, wnd, "target".
      IF wtg ISNT "_" AND wtg ISNT "null",
        REAP wact FROM _map_get, wnd, "action".
        REAP wbase FROM base_of, wact.
        REAP wsig FROM find_sig, sigs, wbase.
        IF COUNT wsig > 0,
          REAP wst2 FROM _map_get, wsig, "type".
          REAP wret FROM _map_get, wsig, "ret".
          IF wret > "",
            REAP wrf FROM add_struct_enum_keys, reg, wret, wtg, res.
            # FFI (external) callees return raw member ints from C:
            # register the target so the call site wraps it with
            # _from_enum and displays/concat resolve (v0.48.12)
            IF wst2 IS "external_decl",
              REAP wretb FROM subst_type, wret, subst.
              REAP wms2 FROM enum_members_of, reg, wretb.
              IF wms2 > "",
                REAP wf2 FROM list_contains, res, wtg.
                IF wf2 IS 0,
                  PUT wtg INTO res.
                  PUT wms2 INTO res.
                /IF.
              /IF.
            /IF.
          /IF.
        /IF.
      /IF.
    /IF.
    IF wty IS "if_stmt",
      REAP ib FROM _if_bodies, wnd.
      CREATE ii3(NUM) TO 0.
      SEASON ii3 < COUNT ib,
        REAP ibd3 FROM plant_list_get, ib, ii3.
        REAP wret FROM collect_enums_walk, ibd3, subst, reg, sigs, res.
        SET ii3 TO ii3 + 1.
      /SEASON.
    /IF.
    IF wty IS "season_stmt" OR wty IS "cycle_stmt" OR wty IS "match_stmt",
      CREATE sbl(LIST) TO _map_get(wnd, "body").
      REAP wret FROM collect_enums_walk, sbl, subst, reg, sigs, res.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE res.
/ACTION.

# collect_enums — every enum member name (module-scope constants)
# plus enum-typed params and CREATE/LET targets, as a flat
# [name, membersCsv, …] table. Struct-typed vars/params/reap targets
# contribute plant_map_get(var, "field") keys for enum fields.
ACTION collect_enums(bd, params, subst, reg, sigs),
  CREATE res(LIST) TO plant_list_make(0).
  REAP he2 FROM reg_has_enum, reg.
  IF he2 IS 0, GIVE res. /IF.
  CREATE pi(NUM) TO 0.
  CREATE pn2(TX) TO "".
  CREATE pt2(TX) TO "".
  CREATE psu2(TX) TO "".
  CREATE pm2(TX) TO "".
  SEASON pi < COUNT params,
    REAP pn2 FROM _map_get, params[pi], "name".
    REAP pt2 FROM _map_get, params[pi], "type".
    REAP psu2 FROM subst_type, pt2, subst.
    REAP pm2 FROM enum_members_of, reg, psu2.
    IF pm2 ISNT "",
      REAP pfound FROM list_contains, res, pn2.
      IF pfound IS 0,
        PUT pn2 INTO res.
        PUT pm2 INTO res.
      /IF.
    /IF.
    IF pm2 IS "",
      REAP prf FROM add_struct_enum_keys, reg, psu2, pn2, res.
    /IF.
    SET pi TO pi + 1.
  /SEASON.
  # member constants: every member name maps to its enum's csv
  CREATE ri(NUM) TO 0.
  CREATE rn(TX) TO "".
  CREATE rv(TX) TO "".
  SEASON ri + 1 < COUNT reg,
    REAP rn FROM plant_list_get, reg, ri.
    REAP rv FROM plant_list_get, reg, ri + 1.
    CREATE ms(LIST) TO plant_list_make(0).
    REAP ms FROM strings:SPLIT, rv, ",".
    CREATE mi(NUM) TO 0.
    CREATE mname(TX) TO "".
    SEASON mi < COUNT ms,
      REAP mname FROM plant_list_get, ms, mi.
      IF mname > "",
        REAP mf FROM list_contains, res, mname.
        IF mf IS 0,
          PUT mname INTO res.
          PUT rv INTO res.
        /IF.
      /IF.
      SET mi TO mi + 1.
    /SEASON.
    # enum type names resolve FFI formal params at call sites (v0.48.12)
    REAP rpre0 FROM substring, rn, 0, 7.
    IF rpre0 ISNT "STRUCT.",
      REAP tf FROM list_contains, res, rn.
      IF tf IS 0,
        PUT rn INTO res.
        PUT rv INTO res.
      /IF.
    /IF.
    SET ri TO ri + 2.
  /SEASON.
  # FFI call names with ENUM returns: inline ffi_color() expressions
  # display/concat correctly (matched via enum_expr_of) (v0.48.12)
  CREATE fi3(NUM) TO 0.
  CREATE fs3(TX) TO "".
  SEASON fi3 < COUNT sigs,
    REAP fs3 FROM plant_list_get, sigs, fi3.
    REAP fst3 FROM _map_get, fs3, "type".
    IF fst3 IS "external_decl",
      REAP fsnm3 FROM _map_get, fs3, "name".
      REAP fsrt3 FROM _map_get, fs3, "ret".
      REAP fsc3 FROM enum_members_of, reg, fsrt3.
      IF fsc3 ISNT "",
        REAP fsf3 FROM list_contains, res, fsnm3.
        IF fsf3 IS 0,
          PUT fsnm3 INTO res.
          PUT fsc3 INTO res.
        /IF.
      /IF.
    /IF.
    SET fi3 TO fi3 + 1.
  /SEASON.
  REAP wr FROM collect_enums_walk, bd, subst, reg, sigs, res.
  GIVE res.
/ACTION.

# enum_in_table — membersCsv for a name in a flat enum table, or ""
ACTION enum_in_table(evars(LIST), name(TX)),
  CREATE res(TX) TO "".
  CREATE ej(NUM) TO 0.
  CREATE ekey(TX) TO "".
  CREATE eval(TX) TO "".
  SEASON ej + 1 < COUNT evars,
    REAP ekey FROM plant_list_get, evars, ej.
    REAP eval FROM plant_list_get, evars, ej + 1.
    IF str_eq(ekey, name) IS "1", SET res TO eval. /IF.
    SET ej TO ej + 2.
  /SEASON.
  GIVE res.
/ACTION.

# enum_expr_of — membersCsv for a value expression: exact key, or
# the call prefix of an inline call like ffi_color(1) → ffi_color
# (FFI call names with ENUM returns are registered bare) (v0.48.12)
ACTION enum_expr_of(evars(LIST), cval(TX)),
  REAP e2 FROM enum_in_table, evars, cval.
  IF e2 ISNT "", GIVE e2. /IF.
  REAP lp2 FROM find_any, cval, "(".
  IF lp2 ISNT -1,
    REAP lpre2 FROM substring, cval, 0, lp2.
    REAP lpre2 FROM trim, lpre2.
    REAP e2 FROM enum_in_table, evars, lpre2.
    IF e2 ISNT "", GIVE e2. /IF.
  /IF.
  GIVE "".
/ACTION.
ACTION list_contains(lst(LIST), x(TX)),
  CREATE found(NUM) TO 0.
  CREATE li(NUM) TO 0.
  CREATE le(TX) TO "".
  SEASON li < COUNT lst,
    REAP le FROM plant_list_get, lst, li.
    IF str_eq(le, x) IS "1", SET found TO 1. /IF.
    SET li TO li + 1.
  /SEASON.
  GIVE found.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  collect_nums_walk — add names of scalar NUM/FACT CREATE/LET
#  targets in bd (recursing into IF/SEASON/CYCLE/MATCH bodies)
# ──────────────────────────────────────────────────────────────
ACTION collect_nums_walk(bd(LIST), subst(LIST), res(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE wnd(TX) TO "".
  CREATE wty(TX) TO "".
  CREATE wtg(TX) TO "".
  CREATE wvt(TX) TO "".
  CREATE wbs(TX) TO "".
  CREATE wbb(TX) TO "".
  SEASON wi < COUNT bd,
    REAP wnd FROM plant_list_get, bd, wi.
    REAP wty FROM _map_get, wnd, "type".
    IF wty IS "create_stmt" OR wty IS "let_stmt",
      REAP wtg FROM _map_get, wnd, "target".
      REAP wvt FROM _map_get, wnd, "var_type".
      REAP wbs FROM subst_type, wvt, subst.
      REAP wbb FROM type_base, wbs.
      IF wbb IS "NUM" OR wbb IS "FACT",
        REAP wfound FROM list_contains, res, wtg.
        IF wfound IS 0, PUT wtg INTO res. /IF.
      /IF.
    /IF.
    IF wty IS "if_stmt",
      REAP ib FROM _if_bodies, wnd.
      CREATE ii4(NUM) TO 0.
      SEASON ii4 < COUNT ib,
        REAP ibd4 FROM plant_list_get, ib, ii4.
        REAP wret2 FROM collect_nums_walk, ibd4, subst, res.
        SET ii4 TO ii4 + 1.
      /SEASON.
    /IF.
    IF wty IS "season_stmt" OR wty IS "cycle_stmt" OR wty IS "match_stmt",
      REAP wbd2 FROM _map_get, wnd, "body".
      REAP wret2 FROM collect_nums_walk, wbd2, subst, res.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  collect_nums — names of numeric scalar vars in scope for an
#  action body: NUM/FACT params (after subst) plus NUM/FACT
#  CREATE/LET targets anywhere in the body. Used by _handle_cat
#  so "text" + i concatenates numeric vars via _from_long.
# ──────────────────────────────────────────────────────────────
ACTION collect_nums(bd(LIST), params(LIST), subst(LIST)),
  CREATE res(LIST) TO plant_list_make(0).
  CREATE pi(NUM) TO 0.
  CREATE pnd(TX) TO "".
  CREATE pn2(TX) TO "".
  CREATE pty2(TX) TO "".
  CREATE psu2(TX) TO "".
  CREATE pbs2(TX) TO "".
  SEASON pi < COUNT params,
    REAP pnd FROM plant_list_get, params, pi.
    REAP pn2 FROM _map_get, pnd, "name".
    REAP pty2 FROM _map_get, pnd, "type".
    REAP psu2 FROM subst_type, pty2, subst.
    REAP pbs2 FROM type_base, psu2.
    IF pbs2 IS "NUM" OR pbs2 IS "FACT",
      PUT pn2 INTO res.
    /IF.
    SET pi TO pi + 1.
  /SEASON.
  REAP ret FROM collect_nums_walk, bd, subst, res.
  GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  nums_from_avars — numeric var names from an async var table
#  (flat [name, ctype, …] pairs as built by async_var_add)
# ──────────────────────────────────────────────────────────────
ACTION nums_from_avars(vars(LIST)),
  CREATE res(LIST) TO plant_list_make(0).
  CREATE vi(NUM) TO 0.
  CREATE vn(TX) TO "".
  CREATE vt(TX) TO "".
  SEASON vi + 1 < COUNT vars,
    REAP vn FROM plant_list_get, vars, vi.
    REAP vt FROM plant_list_get, vars, vi + 1.
    IF vt IS "long" OR vt IS "int",
      REAP vf FROM list_contains, res, vn.
      IF vf IS 0, PUT vn INTO res. /IF.
    /IF.
    SET vi TO vi + 2.
  /SEASON.
  GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  collect_nums_cb — numeric var names for closure bodies:
#  NUM/FACT closure params (after subst) + MOVE/REF shadows with
#  numeric ctype + numeric CREATE/LET targets in the body.
# ──────────────────────────────────────────────────────────────
ACTION collect_nums_cb(bd(LIST), params(LIST), shads(LIST), subst(LIST)),
  CREATE res(LIST) TO plant_list_make(0).
  CREATE ci(NUM) TO 0.
  CREATE cnd(TX) TO "".
  CREATE cn2(TX) TO "".
  CREATE cty2(TX) TO "".
  CREATE csu2(TX) TO "".
  CREATE cbs2(TX) TO "".
  SEASON ci < COUNT params,
    REAP cnd FROM plant_list_get, params, ci.
    REAP cn2 FROM _map_get, cnd, "name".
    REAP cty2 FROM _map_get, cnd, "type".
    REAP csu2 FROM subst_type, cty2, subst.
    REAP cbs2 FROM type_base, csu2.
    IF cbs2 IS "NUM" OR cbs2 IS "FACT",
      PUT cn2 INTO res.
    /IF.
    SET ci TO ci + 1.
  /SEASON.
  CREATE si7(NUM) TO 0.
  CREATE se7(TX) TO "".
  CREATE sn7(TX) TO "".
  CREATE sc7(TX) TO "".
  SEASON si7 < COUNT shads,
    REAP se7 FROM plant_list_get, shads, si7.
    REAP sn7 FROM _map_get, se7, "name".
    REAP sc7 FROM _map_get, se7, "ctype".
    IF sc7 IS "long" OR sc7 IS "int",
      REAP sf7 FROM list_contains, res, sn7.
      IF sf7 IS 0, PUT sn7 INTO res. /IF.
    /IF.
    SET si7 TO si7 + 1.
  /SEASON.
  REAP ret7 FROM collect_nums_walk, bd, subst, res.
  GIVE res.
/ACTION.

# ═══════════════════════════════════════════════════════════════
#  Async codegen — v0.48.3
#
#  ASYNC ACTION name(params), PRIORITY p, body /ACTION. compiles to:
#    plant_a_name_state — state struct (field 0 = __self task ptr,
#                          then __pc phase, then params + locals)
#    plant_a_name_step  — single step function driving all phases;
#                          local copies of every state var are
#                          restored at entry and saved back at each
#                          suspension point (AWAIT)
#    name(...)          — entry: alloc state, register the task
#                          (tx_t __parent, tx_t __ctx, user params)
#  AWAIT foo, args. (top-level only) slices the body into phases;
#  AWAIT inside IF/SEASON/CYCLE/MATCH or a plain ACTION is a
#  compile-time #error. Generic async actions unsupported.
# ═══════════════════════════════════════════════════════════════

# async_argstr — C argument list for an async action call site
# (mirrors reap_stmt arg handling: strings raw, exprs translated,
# REF params get &; async ABI adds __parent/__ctx before user args)
ACTION async_argstr(args(LIST), sigs(LIST), act(TX), nums(LIST), stvars(LIST), evars(LIST)),
  CREATE argstr(TX) TO "".
  REAP fparams FROM find_params, sigs, act.
  CREATE ai(NUM) TO 0.
  CREATE ael(TX) TO "".
  SEASON ai < COUNT args,
    REAP ael FROM plant_list_get, args, ai.
    CREATE aex(TX) TO ael.
    REAP a0 FROM substring, ael, 0, 1.
    IF a0 ISNT "\"",
      REAP aex FROM translate_expr, ael.
      REAP aex FROM _handle_cat, aex, nums, evars.
    /IF.
    REAP rp FROM is_ref_at, fparams, ai.
    IF rp IS "1", SET aex TO "&" + aex. /IF.
    IF ai < COUNT fparams,
      REAP fp_el FROM plant_list_get, fparams, ai.
      REAP fp_ty FROM _map_get, fp_el, "type".
      REAP fp_kind FROM ffi_param_kind, fp_ty.
      IF fp_kind IS "struct_val",
        REAP fpx FROM is_bare_id, ael.
        REAP fpk2 FROM stvar_kind, stvars, ael.
        IF fpx IS "1" AND fpk2 > "",
          IF fpk2 IS "struct_ref", SET aex TO "*" + aex. /IF.
        /IF.
        IF fpx IS "0" OR fpk2 IS "",
          REAP e0 FROM substring, ael, 0, 1.
          IF e0 ISNT "\"",
            REAP cnm3 FROM ffi_struct_cname, fp_ty.
            SET aex TO "plant_map_to_" + cnm3 + "(" + aex + ")".
          /IF.
        /IF.
      /IF.
      IF fp_kind IS "struct_ref",
        REAP fpx FROM is_bare_id, ael.
        REAP fpk2 FROM stvar_kind, stvars, ael.
        REAP amp0 FROM substring, aex, 0, 1.
        IF amp0 IS "&", SET aex TO substring(aex, 1, LEN(aex)). /IF.
        IF fpx IS "1" AND fpk2 IS "struct_val", SET aex TO "&" + aex. /IF.
        IF fpx IS "0" OR fpk2 IS "",
          REAP e0 FROM substring, ael, 0, 1.
          IF e0 ISNT "\"",
            REAP cnm3 FROM ffi_struct_cname, fp_ty.
            SET aex TO "plant_map_to_ref_" + cnm3 + "(" + aex + ")".
          /IF.
        /IF.
      /IF.
      IF fp_kind IS "callback",
        REAP fpx FROM is_bare_id, ael.
        IF fpx IS "1",
          REAP fpk2 FROM stvar_kind, stvars, ael.
          IF fpk2 IS "",
            REAP fs2 FROM find_sig, sigs, ael.
            IF COUNT fs2 > 0,
              SET aex TO "plant_cb_ensure(\"" + ael + "\", plant_cbw_" + ael + ")".
            /IF.
          /IF.
        /IF.
      /IF.
    /IF.
    IF ai > 0, SET argstr TO argstr + ", ". /IF.
    SET argstr TO argstr + aex.
    SET ai TO ai + 1.
  /SEASON.
  GIVE argstr.
/ACTION.

# async_var_add — append [name, ctype] to acc unless name exists
ACTION async_var_add(acc(LIST), name(TX), ctype(TX)),
  CREATE found(NUM) TO 0.
  CREATE fi(NUM) TO 0.
  CREATE fe(TX) TO "".
  SEASON fi < COUNT acc,
    REAP fe FROM plant_list_get, acc, fi.
    IF str_eq(fe, name) IS "1", SET found TO 1. /IF.
    SET fi TO fi + 1.
  /SEASON.
  IF NOT found,
    PUT name INTO acc.
    PUT ctype INTO acc.
  /IF.
  GIVE acc.
/ACTION.

# async_walk_decl — collect CREATE/LET targets (recursive into
# IF/SEASON/CYCLE bodies and MATCH clauses)
ACTION async_walk_decl(bd(LIST), acc(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "create_stmt" OR ty IS "let_stmt",
      REAP tg FROM _map_get, nd, "target".
      REAP vt FROM _map_get, nd, "var_type".
      REAP ct FROM ffi_ctype, vt.
      REAP acc FROM async_var_add, acc, tg, ct.
    /IF.
    IF ty IS "if_stmt",
      REAP ib FROM _if_bodies, nd.
      CREATE ii5(NUM) TO 0.
      SEASON ii5 < COUNT ib,
        REAP ibd5 FROM plant_list_get, ib, ii5.
        REAP acc FROM async_walk_decl, ibd5, acc.
        SET ii5 TO ii5 + 1.
      /SEASON.
    /IF.
    IF ty IS "season_stmt",
      REAP sb FROM _map_get, nd, "body".
      REAP acc FROM async_walk_decl, sb, acc.
    /IF.
    IF ty IS "cycle_stmt",
      REAP sb FROM _map_get, nd, "body".
      REAP acc FROM async_walk_decl, sb, acc.
    /IF.
    IF ty IS "match_stmt",
      CREATE cl(LIST) TO _map_get(nd, "clauses").
      CREATE ci(NUM) TO 0.
      SEASON ci < COUNT cl,
        REAP cl2 FROM plant_list_get, cl, ci.
        REAP cb FROM _map_get, cl2, "bodyStatements".
        REAP acc FROM async_walk_decl, cb, acc.
        SET ci TO ci + 1.
      /SEASON.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE acc.
/ACTION.

# async_collect_vars — flat [name, ctype, …] for the state struct:
# params first, then CREATE/LET targets, then implicit (tx_t)
ACTION async_collect_vars(bd(LIST), params(LIST)),
  CREATE acc(LIST) TO plant_list_make(0).
  CREATE pi(NUM) TO 0.
  CREATE pe(TX) TO "".
  SEASON pi < COUNT params,
    REAP pe FROM plant_list_get, params, pi.
    REAP pn FROM _map_get, pe, "name".
    REAP pt FROM _map_get, pe, "type".
    REAP ct FROM ffi_ctype, pt.
    REAP acc FROM async_var_add, acc, pn, ct.
    SET pi TO pi + 1.
  /SEASON.
  REAP acc FROM async_walk_decl, bd, acc.
  REAP imp FROM collect_implicit, bd, params.
  CREATE ii(NUM) TO 0.
  SEASON ii < COUNT imp,
    REAP iv FROM plant_list_get, imp, ii.
    REAP acc FROM async_var_add, acc, iv, "tx_t".
    SET ii TO ii + 1.
  /SEASON.
  GIVE acc.
/ACTION.

# async_split_phases — slice the body into phases at top-level
# AWAIT statements; every phase except the last ends with its AWAIT
ACTION async_split_phases(bd(LIST)),
  CREATE phases(LIST) TO plant_list_make(0).
  CREATE cur(LIST) TO plant_list_make(0).
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "await_stmt",
      PUT nd INTO cur.
      PUT cur INTO phases.
      SET cur TO plant_list_make(0).
    /IF.
    IF ty ISNT "await_stmt",
      PUT nd INTO cur.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  PUT cur INTO phases.
  GIVE phases.
/ACTION.

# async_emit_state — typedef for the per-action state struct
ACTION async_emit_state(name(TX), vars(LIST)),
  CREATE code(TX) TO "typedef struct \{\n".
  SET code TO code + "  tx_t __self;\n".
  SET code TO code + "  long __pc;\n".
  CREATE vi(NUM) TO 0.
  CREATE vn(TX) TO "".
  CREATE vt(TX) TO "".
  SEASON vi + 1 < COUNT vars,
    REAP vn FROM plant_list_get, vars, vi.
    REAP vt FROM plant_list_get, vars, vi + 1.
    SET code TO code + "  " + vt + " " + vn + ";\n".
    SET vi TO vi + 2.
  /SEASON.
  SET code TO code + "\} plant_a_" + name + "_state;\n\n".
  GIVE code.
/ACTION.

# async_emit_entry — tx_t name(tx_t __parent, tx_t __ctx, params):
# alloc the state, copy params in, register the task (prio/deadline
# inheritance handled by the engine via __parent)
ACTION async_emit_entry(name(TX), params(LIST), prio(TX), mmode(TX)),
  CREATE pstr(TX) TO "".
  CREATE pi(NUM) TO 0.
  CREATE pe(TX) TO "".
  SEASON pi < COUNT params,
    REAP pe FROM plant_list_get, params, pi.
    REAP pn FROM _map_get, pe, "name".
    REAP pt FROM _map_get, pe, "type".
    REAP ct FROM ffi_ctype, pt.
    IF pi > 0, SET pstr TO pstr + ", ". /IF.
    SET pstr TO pstr + ct + " " + pn.
    SET pi TO pi + 1.
  /SEASON.
  CREATE code(TX) TO "tx_t " + name + "(tx_t __parent, tx_t __ctx".
  IF pstr > "", SET code TO code + ", " + pstr. /IF.
  SET code TO code + ") \{\n".
  IF mmode IS "FAST",
    SET code TO code + "  plant_fast_enter(\"" + name + "\");\n".
  /IF.
  SET code TO code + "  plant_a_" + name + "_state* s = (plant_a_" + name + "_state*)plant_async_alloc_state(sizeof(plant_a_" + name + "_state), \"" + name + "\");\n".
  CREATE ci(NUM) TO 0.
  SEASON ci < COUNT params,
    REAP pe2 FROM plant_list_get, params, ci.
    REAP pn2 FROM _map_get, pe2, "name".
    SET code TO code + "  s->" + pn2 + " = " + pn2 + ";\n".
    SET ci TO ci + 1.
  /SEASON.
  SET code TO code + "  return plant_async_register((tx_t)s, plant_a_" + name + "_step, __parent, __ctx, " + prio + ", -1, -1, 0, \"" + name + "\");\n".
  SET code TO code + "\}\n\n".
  GIVE code.
/ACTION.

# async_emit_step — one step function driving every phase. Locals
# (aliases of the state fields) are restored at entry; the phase
# dispatch jumps to the saved program counter; AWAIT saves all
# locals back, bumps __pc and suspends on the child task.
ACTION async_emit_step(name(TX), phases(LIST), vars(LIST), sigs(LIST), subst(LIST), clmap(LIST), stvars(LIST), evars(LIST)),
  CREATE code(TX) TO "static int plant_a_" + name + "_step(tx_t st) \{\n".
  SET code TO code + "  plant_a_" + name + "_state* s = (plant_a_" + name + "_state*)st;\n".
  SET code TO code + "  if (s->__pc > 0) plant_async_await_result(st);\n".
  CREATE vi(NUM) TO 0.
  CREATE vn(TX) TO "".
  CREATE vt(TX) TO "".
  SEASON vi + 1 < COUNT vars,
    REAP vn FROM plant_list_get, vars, vi.
    REAP vt FROM plant_list_get, vars, vi + 1.
    SET code TO code + "  " + vt + " " + vn + " = s->" + vn + ";\n".
    SET vi TO vi + 2.
  /SEASON.
  SET code TO code + "  switch (s->__pc) \{\n".
  CREATE nums_s(LIST) TO nums_from_avars(vars).
  CREATE ph(NUM) TO 0.
  SEASON ph < COUNT phases,
    CREATE phs(TX) TO _from_long(ph).
    SET code TO code + "    case " + phs + ": goto plant_a_" + name + "_L" + phs + ";\n".
    SET ph TO ph + 1.
  /SEASON.
  SET code TO code + "  \}\n".
  CREATE ph2(NUM) TO 0.
  SEASON ph2 < COUNT phases,
    CREATE ph2s(TX) TO _from_long(ph2).
    SET code TO code + "  plant_a_" + name + "_L" + ph2s + ":\n".
    REAP phd FROM plant_list_get, phases, ph2.
    CREATE nph(NUM) TO COUNT phases.
    CREATE nst(NUM) TO COUNT phd.
    CREATE nxt(NUM) TO ph2 + 1.
    IF nxt < nph,
      CREATE lead(LIST) TO plant_list_make(0).
      CREATE lj(NUM) TO 0.
      SEASON lj < nst - 1,
        REAP ls FROM plant_list_get, phd, lj.
        PUT ls INTO lead.
        SET lj TO lj + 1.
      /SEASON.
      REAP lcode FROM generate_body, lead, 1, sigs, subst, clmap, "a", nums_s, stvars, evars, "", "".
      SET code TO code + lcode.
      CREATE aw_last(NUM) TO nst - 1.
      REAP awnd FROM plant_list_get, phd, aw_last.
      REAP act_s FROM _map_get, awnd, "action".
      REAP awctx FROM _map_get, awnd, "ctx".
      CREATE awargs(LIST) TO _map_get(awnd, "args").
      REAP arg_s FROM async_argstr, awargs, sigs, act_s, nums_s, stvars, evars.
      CREATE vi2(NUM) TO 0.
      CREATE vn2(TX) TO "".
      SEASON vi2 + 1 < COUNT vars,
        REAP vn2 FROM plant_list_get, vars, vi2.
        SET code TO code + "  s->" + vn2 + " = " + vn2 + ";\n".
        SET vi2 TO vi2 + 2.
      /SEASON.
      CREATE nxts(TX) TO _from_long(nxt).
      SET code TO code + "  s->__pc = " + nxts + ";\n".
      # AWAIT ... IN ctx (v0.48.14): the child task is spawned into the
      # context and the suspension is ctx-scoped; standard AWAIT keeps
      # the plain spawn with the default context.
      IF awctx ISNT "" AND awctx ISNT "null",
        SET code TO code + "  plant_async_await_in(st, " + awctx + ", " + act_s + "(st, " + awctx + "".
        IF arg_s > "", SET code TO code + ", " + arg_s. /IF.
        SET code TO code + "));\n  return 0;\n".
      /IF.
      IF awctx IS "" OR awctx IS "null",
        SET code TO code + "  plant_async_suspend(st, " + act_s + "(st, 0".
        IF arg_s > "", SET code TO code + ", " + arg_s. /IF.
        SET code TO code + "));\n  return 0;\n".
      /IF.
    /IF.
    IF nxt IS nph,
      REAP tcode FROM generate_body, phd, 1, sigs, subst, clmap, "a", nums_s, stvars, evars, "", "".
      SET code TO code + tcode.
    /IF.
    SET ph2 TO ph2 + 1.
  /SEASON.
  SET code TO code + "  plant_async_finish(st, \"" + name + "\");\n".
  SET code TO code + "  return 1;\n".
  SET code TO code + "\}\n\n".
  GIVE code.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  translate_expr — PlantLang → C expression translation
# ──────────────────────────────────────────────────────────────
ACTION translate_expr(expr(TX)),
    CREATE e(TX) TO expr.
    # ── START foo, args. in expression position: spawn and keep the
    #    task handle (tx_t) for later CANCEL / AWAIT on the child. ─
    REAP e0 FROM substring, e, 0, 6.
    IF e0 IS "START ",
        REAP e1 FROM substring, e, 6, LEN(e).
        REAP cm FROM find_any, e1, ",".
        IF cm IS -1,
            GIVE e1 + "(0, 0)".
        /IF.
        REAP anm FROM substring, e1, 0, cm.
        REAP args1 FROM substring, e1, cm + 1, LEN(e1).
        GIVE anm + "(0, 0, " + args1 + ")".
    /IF.
    REAP e FROM strings:REPLACE, e, "GREATER THAN OR EQUAL", ">=".
    REAP e FROM strings:REPLACE, e, "LESS THAN OR EQUAL", "<=".
    REAP e FROM strings:REPLACE, e, "GREATER THAN", ">".
    REAP e FROM strings:REPLACE, e, "LESS THAN", "<".
    REAP e FROM strings:REPLACE, e, "ISNT", "!=".
    REAP e FROM strings:REPLACE, e, "STAR_STAR", "**".
    REAP e FROM strings:REPLACE, e, " AND ", " && ".
    REAP e FROM strings:REPLACE, e, " OR ", " || ".
    REAP e FROM strings:REPLACE, e, "NOT ", "!".
    REAP e FROM strings:REPLACE, e, " IS ", " == ".
    REAP e FROM _handle_func, e, "COUNT", "plant_array_length".
    REAP e FROM _handle_func_paren, e, "LEN", "strlen".
    REAP e FROM _handle_func, e, "TEST", "!".
    REAP e FROM strings:REPLACE, e, "TRUE", "1".
    REAP e FROM strings:REPLACE, e, "FALSE", "0".
    REAP e FROM strings:REPLACE, e, "NULL", "NULL".
    REAP e FROM strings:REPLACE, e, " : ", "_".
    REAP e FROM handle_brackets, e.
    GIVE e.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  indent_str — generate indentation whitespace
# ──────────────────────────────────────────────────────────────
ACTION indent_str(level(NUM)),
    CREATE res(TX) TO "".
    CREATE i(NUM) TO 0.
    SEASON i < level,
        SET res TO res + "  ".
        SET i TO i + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  generate_body — generate C code for a list of AST nodes
#  clmap: closure-var map (flat [varname, closurenode]) for the
#  current C function scope (REAP action name lookup for closure
#  invocation); an empty list means no closures are in scope.
#  actx: "" = normal C function body, "a" = async step phase body
#  (CREATE/LET emit assignments into the state struct, GIVE emits
#  plant_async_finish + return 1).
#  nums: names of numeric scalar vars in scope (_handle_cat).
#  rty: the enclosing action's return type after substitution (""
#  for implicit returns / async steps / closures); gen_give_stmt
#  uses it to wrap NUM-typed returns in _from_long (v0.48.13).
# ──────────────────────────────────────────────────────────────
ACTION generate_body(bd(LIST), indent(NUM), sigs(LIST), subst(LIST), clmap(LIST), actx(TX), nums(LIST), stvars(LIST), evars(LIST), rty(TX), mexit(TX)),
  CREATE res(TX) TO "".
  CREATE i(NUM) TO 0.
  CREATE node_el(TX) TO "".
  SEASON i < COUNT bd,
    REAP node_el FROM plant_list_get, bd, i.
    REAP node_code FROM generate_node, node_el, indent, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
    IF node_code > "",
      SET res TO res + node_code.
    /IF.
    SET i TO i + 1.
  /SEASON.
  GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  generate_node — dispatch AST node by type
#  clmap: closure-var map (flat [varname, closurenode]) for the
#  current C function scope; "" (missing key) → empty list.
#  actx: "" = normal body, "a" = async step phase body.
#  nums: names of numeric scalar vars in scope (_handle_cat).
#  rty: enclosing action's substituted return type ("" if implicit).
# ──────────────────────────────────────────────────────────────
ACTION generate_node(node, indent(NUM), sigs(LIST), subst(LIST), clmap(LIST), actx(TX), nums(LIST), stvars(LIST), evars(LIST), rty(TX), mexit(TX)),
    REAP ntype FROM _map_get, node, "type".
    IF clmap IS "",
        SET clmap TO plant_list_make(0).
    /IF.
    IF evars IS "",
        SET evars TO plant_list_make(0).
    /IF.
  
    # ── show_stmt: SHOW expr. → plant_print(expr); ────────────
    #    numeric expressions are wrapped in _from_long so a bare
    #    NUM var / arithmetic / numeric reader prints its value
    #    instead of raw long-as-pointer bits (v0.48.5).
    IF ntype IS "show_stmt",
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval, nums, evars.
        REAP isn2 FROM expr_is_numeric, cval, nums.
        IF isn2 IS 1,
            SET cval TO "_from_long(" + cval + ")".
        /IF.
        REAP snm2 FROM enum_expr_of, evars, cval.
        IF isn2 IS 0 AND snm2 ISNT "",
            SET cval TO "_from_enum(" + cval + ", \"" + snm2 + "\")".
        /IF.
        REAP isel FROM indent_str, indent.
        GIVE isel + "  plant_print(" + cval + ");\n".
    /IF.
  
    # ── create_stmt: CREATE var(TYPE) TO val. → long/TX var = val; ─
    #    In async step phases the variable lives in the state struct,
    #    restored as a local at step entry → plain assignment, no decl.
    IF ntype IS "create_stmt",
        REAP target FROM _map_get, node, "target".
        REAP vtype FROM _map_get, node, "var_type".
        REAP vtype FROM subst_type, vtype, subst.
        REAP isel FROM indent_str, indent.
        REAP cnd FROM _map_get, node, "closure".
        IF cnd > "",
            REAP envname FROM _map_get, cnd, "envname".
            REAP caps FROM _map_get, cnd, "clcaps".
            REAP moved FROM _map_get, cnd, "moved".
            REAP cid2 FROM _map_get, cnd, "cid".
            CREATE ccode2(TX) TO isel + "  tx_t " + target + " = (tx_t)0;\n".
            IF actx IS "a", SET ccode2 TO isel + "  " + target + " = (tx_t)0;\n". /IF.
            SET ccode2 TO ccode2 + isel + "  { " + envname + "* __env_" + cid2 + " = (" + envname + "*)plant_env_alloc(sizeof(" + envname + "));\n".
            CREATE cpi(NUM) TO 0.
            CREATE capn(TX) TO "".
            CREATE capi(TX) TO "".
            SEASON cpi + 1 < COUNT caps,
                REAP capn FROM plant_list_get, caps, cpi.
                REAP capi FROM plant_list_get, caps, cpi + 1.
                SET ccode2 TO ccode2 + isel + "    __env_" + cid2 + "->" + capn + " = " + capi + ";\n".
                SET cpi TO cpi + 2.
            /SEASON.
            SET ccode2 TO ccode2 + isel + "    " + target + " = (tx_t)__env_" + cid2 + ";\n".
            SET ccode2 TO ccode2 + isel + "  }\n".
            CREATE cmi(NUM) TO 0.
            CREATE cmv(TX) TO "".
            SEASON cmi < COUNT moved,
                REAP cmv FROM plant_list_get, moved, cmi.
                SET ccode2 TO ccode2 + isel + "  " + cmv + " = 0;\n".
                SET cmi TO cmi + 1.
            /SEASON.
            GIVE ccode2.
        /IF.
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval, nums, evars.
        IF actx IS "a",
            GIVE isel + "  " + target + " = " + cval + ";\n".
        /IF.
        IF vtype IS "NUM",
            GIVE isel + "  long " + target + " = " + cval + ";\n".
        /IF.
        IF vtype IS "FACT",
            GIVE isel + "  int " + target + " = " + cval + ";\n".
        /IF.
        IF vtype IS "LIST",
            GIVE isel + "  PlantArray* " + target + " = " + cval + ";\n".
        /IF.
        REAP vst2 FROM is_struct_type, vtype.
        IF vst2 IS "1",
            REAP vct2 FROM ffi_ctype, vtype.
            IF actx IS "a",
                GIVE isel + "  " + target + " = " + cval + ";\n".
            /IF.
            GIVE isel + "  " + vct2 + " " + target + " = " + cval + ";\n".
        /IF.
        IF vtype ISNT "NUM" AND vtype ISNT "FACT" AND vtype ISNT "LIST",
            REAP vst3 FROM is_struct_type, vtype.
            IF vst3 ISNT "1",
                GIVE isel + "  tx_t " + target + " = " + cval + ";\n".
            /IF.
        /IF.
    /IF.
  
    # ── set_stmt: SET target TO val. → target = val; ──────────
    IF ntype IS "set_stmt",
        REAP target FROM _map_get, node, "target".
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval, nums, evars.
        REAP isel FROM indent_str, indent.
        GIVE isel + "  " + target + " = " + cval + ";\n".
    /IF.
  
    # ── let_stmt: LET var AS TYPE IS val. → type var = val; ──
    #    async step phases: assignment into the state-backed local.
    IF ntype IS "let_stmt",
        REAP target FROM _map_get, node, "target".
        REAP vtype FROM _map_get, node, "var_type".
        REAP vtype FROM subst_type, vtype, subst.
        REAP isel FROM indent_str, indent.
        REAP cnd FROM _map_get, node, "closure".
        IF cnd > "",
            REAP envname FROM _map_get, cnd, "envname".
            REAP caps FROM _map_get, cnd, "clcaps".
            REAP moved FROM _map_get, cnd, "moved".
            REAP cid2 FROM _map_get, cnd, "cid".
            CREATE ccode2(TX) TO isel + "  tx_t " + target + " = (tx_t)0;\n".
            IF actx IS "a", SET ccode2 TO isel + "  " + target + " = (tx_t)0;\n". /IF.
            SET ccode2 TO ccode2 + isel + "  { " + envname + "* __env_" + cid2 + " = (" + envname + "*)plant_env_alloc(sizeof(" + envname + "));\n".
            CREATE cpi(NUM) TO 0.
            CREATE capn(TX) TO "".
            CREATE capi(TX) TO "".
            SEASON cpi + 1 < COUNT caps,
                REAP capn FROM plant_list_get, caps, cpi.
                REAP capi FROM plant_list_get, caps, cpi + 1.
                SET ccode2 TO ccode2 + isel + "    __env_" + cid2 + "->" + capn + " = " + capi + ";\n".
                SET cpi TO cpi + 2.
            /SEASON.
            SET ccode2 TO ccode2 + isel + "    " + target + " = (tx_t)__env_" + cid2 + ";\n".
            SET ccode2 TO ccode2 + isel + "  }\n".
            CREATE cmi(NUM) TO 0.
            CREATE cmv(TX) TO "".
            SEASON cmi < COUNT moved,
                REAP cmv FROM plant_list_get, moved, cmi.
                SET ccode2 TO ccode2 + isel + "  " + cmv + " = 0;\n".
                SET cmi TO cmi + 1.
            /SEASON.
            GIVE ccode2.
        /IF.
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval, nums, evars.
        IF actx IS "a",
            GIVE isel + "  " + target + " = " + cval + ";\n".
        /IF.
        IF vtype IS "NUM",
            GIVE isel + "  long " + target + " = " + cval + ";\n".
        /IF.
        REAP vst4 FROM is_struct_type, vtype.
        IF vst4 IS "1",
            REAP vct4 FROM ffi_ctype, vtype.
            IF actx IS "a",
                GIVE isel + "  " + target + " = " + cval + ";\n".
            /IF.
            GIVE isel + "  " + vct4 + " " + target + " = " + cval + ";\n".
        /IF.
        IF vtype ISNT "NUM",
            REAP vst5 FROM is_struct_type, vtype.
            IF vst5 ISNT "1",
                GIVE isel + "  tx_t " + target + " = " + cval + ";\n".
            /IF.
        /IF.
    /IF.
  
    # ── give_stmt: GIVE val. → return val; ────────────────────
    #    async step phase: complete the task with the value.
    #    ENUM values (bare member refs, enum vars, struct field
    #    reads) are wrapped with _from_enum at the return site so
    #    callers receive the member-name string (v0.48.11).
    #    Pure numeric GIVEs of NUM-typed actions (explicit -> NUM
    #    or -> T instantiated with NUM) are wrapped with _from_long
    #    so callers get the value as text instead of raw long bits
    #    (v0.48.13); implicit-return actions keep the raw-bit
    #    convention so existing callers are unaffected.
    IF ntype IS "give_stmt",
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval, nums, evars.
        REAP isn3 FROM expr_is_numeric, cval, nums.
        IF isn3 IS 0,
            REAP snm3 FROM enum_expr_of, evars, cval.
            IF snm3 ISNT "",
                SET cval TO "_from_enum(" + cval + ", \"" + snm3 + "\")".
            /IF.
        /IF.
        IF isn3 IS 1 AND rty ISNT "",
            REAP in3 FROM is_numeric_type, rty.
            IF in3 IS 1,
                SET cval TO "_from_long(" + cval + ")".
            /IF.
        /IF.
        REAP isel FROM indent_str, indent.
        IF actx IS "a",
            GIVE isel + "  plant_async_finish(st, " + cval + ");\n  return 1;\n".
        /IF.
        # v0.48.18: mission-mode exit lines (plant_*_exit) run before
        # the give's return so the mode stack is popped even when the
        # action ends with GIVE instead of falling off the tail.
        IF mexit > "",
            GIVE isel + mexit + "  return " + cval + ";\n".
        /IF.
        GIVE isel + "  return " + cval + ";\n".
    /IF.
  
    # ── break_stmt → break; ───────────────────────────────────
    IF ntype IS "break_stmt",
        REAP isel FROM indent_str, indent.
        GIVE isel + "  break;\n".
    /IF.
  
    # ── continue_stmt → continue; ─────────────────────────────
    IF ntype IS "continue_stmt",
        REAP isel FROM indent_str, indent.
        GIVE isel + "  continue;\n".
    /IF.
  
    # ── put_stmt: PUT item INTO target. → plant_array_push(…) ─
    IF ntype IS "put_stmt",
        REAP item FROM _map_get, node, "item".
        REAP target FROM _map_get, node, "target".
        REAP citem FROM translate_expr, item.
        REAP citem FROM _handle_cat, citem, nums, evars.
        REAP isel FROM indent_str, indent.
        GIVE isel + "  " + target + " = plant_list_push(" + target + ", " + citem + ");\n".
    /IF.

    # ── await_stmt: only valid as the final statement of an async
    #    step phase; async_emit_step handles those directly. Any
    #    AWAIT reaching generate_node (normal action body, closure
    #    body, or nested inside IF/SEASON/CYCLE/MATCH of an async
    #    action) is a compile-time error.
    IF ntype IS "await_stmt",
        GIVE "#error AWAIT must be a top-level statement of an ASYNC ACTION body\n".
    /IF.

    # ── start_stmt: START foo, args. / ASYNC IN ctx, foo, args.
    #    → foo(0, 0, args);  (fire-and-forget spawn)
    #    START foo, args IN ctx → plant_async_start_in(ctx, foo, args)
    #    (v0.48.14 contextual spawn; same ABI, zero cost without ctx)
    IF ntype IS "start_stmt",
        REAP act FROM _map_get, node, "action".
        REAP act FROM strings:REPLACE, act, ":", "_".
        CREATE ctx_s(TX) TO "0".
        REAP ctx_n FROM _map_get, node, "ctx".
        IF ctx_n ISNT "" AND ctx_n ISNT "null", SET ctx_s TO ctx_n. /IF.
        CREATE args_s(LIST) TO _map_get(node, "args").
        CREATE argstr_s(TX) TO "".
        REAP argstr_s FROM async_argstr, args_s, sigs, act, nums, stvars, evars.
        REAP isel FROM indent_str, indent.
        REAP kind_s FROM _map_get, node, "kind".
        IF ctx_n ISNT "" AND ctx_n ISNT "null",
            CREATE spawn_fn(TX) TO "plant_async_start_in".
            IF kind_s IS "async_in", SET spawn_fn TO "plant_async_in". /IF.
            IF argstr_s > "",
                GIVE isel + "  " + spawn_fn + "(" + ctx_n + ", " + act + ", " + argstr_s + ");\n".
            /IF.
            IF argstr_s IS "",
                GIVE isel + "  " + spawn_fn + "(" + ctx_n + ", " + act + ");\n".
            /IF.
        /IF.
        IF argstr_s > "",
            GIVE isel + "  " + act + "(0, 0, " + argstr_s + ");\n".
        /IF.
        IF argstr_s IS "",
            GIVE isel + "  " + act + "(0, 0);\n".
        /IF.
    /IF.

    # ── cancel_stmt: CANCEL expr. → plant_async_cancel(expr);
    #    CANCEL expr IN ctx → plant_async_cancel_in(ctx, expr) (v0.48.14:
    #    only cancels the handle if it lives in the given context) ─
    IF ntype IS "cancel_stmt",
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cctx FROM _map_get, node, "ctx".
        REAP isel FROM indent_str, indent.
        IF cctx ISNT "" AND cctx ISNT "null",
            GIVE isel + "  plant_async_cancel_in(" + cctx + ", " + cval + ");\n".
        /IF.
        IF cctx IS "" OR cctx IS "null",
            GIVE isel + "  plant_async_cancel(" + cval + ");\n".
        /IF.
    /IF.

    # ── trace_stmt: TRACE INFO|DEBUG|PERF expr. → plant_trace(…);
    #    TRACE … IN ctx → plant_async_trace_in(ctx, level, msg), which
    #    tags the event with the context name (v0.48.14) ─
    IF ntype IS "trace_stmt",
        REAP lv FROM _map_get, node, "level".
        CREATE lvnum(TX) TO "0".
        IF lv IS "DEBUG", SET lvnum TO "1". /IF.
        IF lv IS "PERF", SET lvnum TO "2". /IF.
    REAP val FROM _map_get, node, "value".
    REAP cval FROM translate_expr, val.
    REAP cval FROM _handle_cat, cval, nums, evars.
    REAP tctx FROM _map_get, node, "ctx".
    REAP isel FROM indent_str, indent.
    IF tctx ISNT "" AND tctx ISNT "null",
        GIVE isel + "  plant_async_trace_in(" + tctx + ", " + lvnum + ", " + cval + ");\n".
    /IF.
    IF tctx IS "" OR tctx IS "null",
        GIVE isel + "  plant_trace(" + lvnum + ", \"\", " + cval + ");\n".
    /IF.
    /IF.

    # ── config_stmt: MISSION CONFIG KEY = VALUE. → plant_async_config ─
    IF ntype IS "config_stmt",
        REAP key FROM _map_get, node, "key".
        REAP val FROM _map_get, node, "value".
        REAP isel FROM indent_str, indent.
        GIVE isel + "  plant_async_config(\"" + key + "\", \"" + val + "\");\n".
    /IF.
  
    # ── call_stmt: bare call for void FFI helpers — reuses the
    #    reap_stmt discard path (target "_") so the call is emitted
    #    with the full ffi/struct/varargs arg handling. ─
    IF ntype IS "call_stmt",
        REAP ca2 FROM _map_get, node, "action".
        CREATE cargs2(LIST) TO _map_get(node, "args").
        CREATE ccl2(LIST) TO _map_get(node, "clargs").
        IF ccl2 IS "",
            SET ccl2 TO plant_list_make(0).
        /IF.
        CREATE cnode2(LIST) TO plant_list_make(10, "type", "reap_stmt", "target", "_", "action", ca2, "args", cargs2, "clargs", ccl2).
        REAP ccode3 FROM generate_node, cnode2, indent, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
        GIVE ccode3.
    /IF.

    # ── reap_stmt: REAP var FROM action, args. → var = action(…); ─
    # Generic calls (action[T1, T2]) emit the mangled monomorphized name.
    IF ntype IS "reap_stmt",
        REAP tgt FROM _map_get, node, "target".
        REAP act FROM _map_get, node, "action".
        REAP act FROM strings:REPLACE, act, ":", "_".
        CREATE callname(TX) TO act.
        CREATE fparams(LIST) TO plant_list_make(0).
        CREATE gi(NUM) TO -1.
        REAP gi FROM find_any, act, "[".
        IF gi ISNT -1,
            REAP sact FROM subst_reap_act, act, subst.
            REAP base FROM base_of, sact.
            REAP gargs FROM parse_type_args, sact.
            REAP mname FROM mangle, base, gargs.
            SET callname TO mname.
            REAP fparams FROM find_params, sigs, base.
        /IF.
        IF gi IS -1,
            REAP fparams FROM find_params, sigs, act.
        /IF.
        # closure-var invocation: REAP r FROM f, … where f holds a
        # closure created in this scope → r = plant_Closure_N_fn((tx_t)f, …)
        REAP cvar FROM _cl_map_get, clmap, act.
        CREATE clcall(TX) TO "".
        IF cvar > "",
            REAP cfn FROM _map_get, cvar, "fnname".
            SET callname TO cfn.
            SET clcall TO "(tx_t)" + act + ", ".
        /IF.
        CREATE args(LIST) TO _map_get(node, "args").
        CREATE clargs(LIST) TO plant_list_make(0).
        REAP clargs FROM _map_get, node, "clargs".
        IF clargs IS "",
            SET clargs TO plant_list_make(0).
        /IF.
        CREATE argstr(TX) TO "".
        CREATE clpre(TX) TO "".
        CREATE clclears(TX) TO "".
        CREATE ai(NUM) TO 0.
        CREATE arg_el(TX) TO "".
        REAP isel FROM indent_str, indent.
        SEASON ai < COUNT args,
            REAP arg_el FROM plant_list_get, args, ai.
            CREATE aexpr(TX) TO arg_el.
            # closure argument: emit the env-init prelude, pass the env
            CREATE cl_ok(TX) TO "0".
            REAP cl_ok FROM _cl_is_arg, arg_el.
            IF cl_ok IS "1",
                REAP cnd FROM plant_list_get, clargs, ai.
                CREATE cndok(TX) TO "0".
                IF cnd > "",
                    SET cndok TO "1".
                /IF.
                IF cndok IS "1",
                    REAP envname FROM _map_get, cnd, "envname".
                    REAP caps FROM _map_get, cnd, "clcaps".
                    REAP moved FROM _map_get, cnd, "moved".
                    SET clpre TO clpre + isel + "  tx_t __carg_" + ai + ";\n".
                    SET clpre TO clpre + isel + "  { " + envname + "* __env_" + ai + " = (" + envname + "*)plant_env_alloc(sizeof(" + envname + "));\n".
                    CREATE cpi(NUM) TO 0.
                    CREATE capn(TX) TO "".
                    CREATE capi(TX) TO "".
                    SEASON cpi + 1 < COUNT caps,
                        REAP capn FROM plant_list_get, caps, cpi.
                        REAP capi FROM plant_list_get, caps, cpi + 1.
                        SET clpre TO clpre + isel + "    __env_" + ai + "->" + capn + " = " + capi + ";\n".
                        SET cpi TO cpi + 2.
                    /SEASON.
                    SET clpre TO clpre + isel + "    __carg_" + ai + " = (tx_t)__env_" + ai + ";\n".
                    SET clpre TO clpre + isel + "  }\n".
                    CREATE cmi(NUM) TO 0.
                    CREATE cmv(TX) TO "".
                    SEASON cmi < COUNT moved,
                        REAP cmv FROM plant_list_get, moved, cmi.
                        SET clclears TO clclears + isel + "  " + cmv + " = 0;\n".
                        SET cmi TO cmi + 1.
                    /SEASON.
                    SET aexpr TO "__carg_" + ai.
                /IF.
                IF cndok IS "0",
                    SET aexpr TO arg_el.
                /IF.
            /IF.
            # plain argument: translate + REF handling + FFI
            # extension marshalling (STRUCT by value/ref, void*,
            # CALLBACK, varargs cast)
             IF cl_ok IS "0",
                 REAP arg0 FROM substring, arg_el, 0, 1.
                IF arg0 ISNT "\"",
                    REAP aexpr FROM translate_expr, arg_el.
                    REAP aexpr FROM _handle_cat, aexpr, nums, evars.
                /IF.
                CREATE fp_ty(TX) TO "".
                IF ai < COUNT fparams,
                    REAP fp_el FROM plant_list_get, fparams, ai.
                    REAP fp_ty FROM _map_get, fp_el, "type".
                /IF.
                REAP fk2 FROM ffi_param_kind, fp_ty.
                IF fk2 IS "struct_val",
                    REAP fpx FROM is_bare_id, arg_el.
                    REAP fpk2 FROM stvar_kind, stvars, arg_el.
                    IF fpx IS "1" AND fpk2 IS "struct_ref", SET aexpr TO "*" + aexpr. /IF.
                    IF fpx IS "0" OR fpk2 IS "",
                        REAP e0 FROM substring, arg_el, 0, 1.
                        IF e0 ISNT "\"",
                            REAP cnm4 FROM ffi_struct_cname, fp_ty.
                            SET aexpr TO "plant_map_to_" + cnm4 + "(" + aexpr + ")".
                        /IF.
                    /IF.
                /IF.
                IF fk2 IS "struct_ref",
                    REAP fpx FROM is_bare_id, arg_el.
                    REAP fpk2 FROM stvar_kind, stvars, arg_el.
                    REAP amp0 FROM substring, aexpr, 0, 1.
                    IF amp0 IS "&", SET aexpr TO substring(aexpr, 1, LEN(aexpr)). /IF.
                    IF fpx IS "1" AND fpk2 IS "struct_val", SET aexpr TO "&" + aexpr. /IF.
                    IF fpx IS "0" OR fpk2 IS "",
                        REAP e0 FROM substring, arg_el, 0, 1.
                        IF e0 ISNT "\"",
                            REAP cnm4 FROM ffi_struct_cname, fp_ty.
                            SET aexpr TO "plant_map_to_ref_" + cnm4 + "(" + aexpr + ")".
                        /IF.
                    /IF.
                /IF.
                IF fk2 IS "callback",
                    REAP fpx FROM is_bare_id, arg_el.
                    IF fpx IS "1",
                        REAP fpk2 FROM stvar_kind, stvars, arg_el.
                        IF fpk2 IS "",
                            REAP fs2 FROM find_sig, sigs, arg_el.
                            IF COUNT fs2 > 0,
                                SET aexpr TO "plant_cb_ensure(\"" + arg_el + "\", plant_cbw_" + arg_el + ")".
                            /IF.
                        /IF.
                    /IF.
                /IF.
                IF fk2 IS "plain",
                    # ENUM-typed FFI params: C expects the raw member
                    # int; _to_enum passes small ints through and maps
                    # member-name strings (from enum-typed function
                    # boundaries) back to their index (v0.48.12)
                    CREATE fty0(TX) TO fp_ty.
                    REAP fp0 FROM substring, fty0, 0, 4.
                    IF fp0 IS "REF ", SET fty0 TO substring(fty0, 4, LEN(fty0)). /IF.
                    REAP fp0 FROM substring, fty0, 0, 5.
                    IF fp0 IS "ENUM ", SET fty0 TO substring(fty0, 5, LEN(fty0)). /IF.
                    REAP fcsv2 FROM enum_in_table, evars, fty0.
                    IF fcsv2 ISNT "",
                        SET aexpr TO "_to_enum(" + aexpr + ", \"" + fcsv2 + "\")".
                    /IF.
                    REAP rp3 FROM is_ref_at, fparams, ai.
                    IF rp3 IS "1",
                        SET aexpr TO "&" + aexpr.
                    /IF.
                /IF.
                IF fk2 IS "voidptr",
                    SET aexpr TO "(void*)" + aexpr.
                /IF.
                IF ai >= COUNT fparams,
                    REAP sv2 FROM expr_is_stringlike, aexpr.
                    IF sv2 IS "0",
                        REAP sf2 FROM list_contains, nums, arg_el.
                        IF sf2 IS 0, SET aexpr TO "(tx_t)" + aexpr. /IF.
                    /IF.
                /IF.
            /IF.
            IF ai > 0, SET argstr TO argstr + ", ". /IF.
            SET argstr TO argstr + aexpr.
            SET ai TO ai + 1.
        /SEASON.
        # FFI extension return handling: STRUCT X → plant_X_to_map
        # wrapper; void* → direct (tx_t is void*); Result/"" → direct.
        CREATE ffi_ret(TX) TO "".
        CREATE ffi_rtk(TX) TO "".
        REAP sig2 FROM find_sig, sigs, act.
        IF COUNT sig2 > 0,
            REAP ffi_ret FROM _map_get, sig2, "ret".
            REAP fp9 FROM substring, ffi_ret, 0, 5.
            IF fp9 IS "ENUM ", SET ffi_ret TO substring(ffi_ret, 5, LEN(ffi_ret)). /IF.
            REAP ffi_rtk FROM ffi_param_kind, ffi_ret.
        /IF.
        CREATE call_expr(TX) TO callname + "(" + clcall + argstr + ")".
        # v0.48.14: REAP of an ASYNC ACTION returns the task handle —
        # the entry ABI is (tx_t __parent, tx_t __ctx, params…), so
        # prepend (0, ctx); REAP … IN ctx spawns into that context.
        REAP asy3 FROM _map_get, sig2, "async".
        IF asy3 IS "1",
            REAP reap_ctx FROM _map_get, node, "ctx".
            IF reap_ctx IS "" OR reap_ctx IS "null", SET reap_ctx TO "0". /IF.
            IF argstr > "",
                SET call_expr TO callname + "(0, " + reap_ctx + ", " + clcall + argstr + ")".
            /IF.
            IF argstr IS "",
                SET call_expr TO callname + "(0, " + reap_ctx + ")".
            /IF.
        /IF.
        CREATE ffi_pref(TX) TO "".
        IF ffi_rtk IS "struct_val",
            REAP rcnm FROM ffi_struct_cname, ffi_ret.
            SET ffi_pref TO ffi_pref + isel + "  plant_ffi_errno = 0;\n".
            IF tgt IS "_",
                GIVE clpre + ffi_pref + isel + "  " + call_expr + ";\n" + clclears.
            /IF.
            REAP stk2 FROM stvar_kind, stvars, tgt.
            IF stk2 > "",
                GIVE clpre + ffi_pref + isel + "  " + tgt + " = plant_" + rcnm + "_to_map(" + call_expr + ");\n" + clclears.
            /IF.
            GIVE clpre + ffi_pref + isel + "  " + tgt + " = plant_" + rcnm + "_to_map(" + call_expr + ");\n" + clclears.
        /IF.
        IF ffi_rtk ISNT "struct_val",
            IF ffi_rtk IS "voidptr" OR ffi_rtk IS "struct_ref",
                SET ffi_pref TO ffi_pref + isel + "  plant_ffi_errno = 0;\n".
            /IF.
            IF tgt IS "_",
                GIVE clpre + ffi_pref + isel + "  " + call_expr + ";\n" + clclears.
            /IF.
            IF tgt ISNT "_",
                # ENUM-typed FFI reap targets (registered by
                # collect_enums_walk): raw member int from C → member
                # name string; idempotent for already-wrapped values
                # (v0.48.12)
                REAP ffr2 FROM enum_in_table, evars, ffi_ret.
                IF ffr2 ISNT "",
                    REAP rtg2 FROM enum_in_table, evars, tgt.
                    IF rtg2 ISNT "",
                        SET call_expr TO "_from_enum(" + call_expr + ", \"" + rtg2 + "\")".
                    /IF.
                /IF.
                GIVE clpre + ffi_pref + isel + "  " + tgt + " = " + call_expr + ";\n" + clclears.
            /IF.
        /IF.
    /IF.
  
    # ── if_stmt: IF cond, body [ORIF cond2, body2]* [ELSE, bodyE] /IF. ─
    #    → if (c) { … } else if (c2) { … } else { … }  (v0.48.20)
    IF ntype IS "if_stmt",
        REAP cond FROM _map_get, node, "cond".
        REAP bd FROM _map_get, node, "body".
        REAP ccond FROM translate_expr, cond.
        REAP ccond FROM handle_strcmp, ccond.
        REAP isel FROM indent_str, indent.
        CREATE ccode(TX) TO isel + "  if (" + ccond + ") \{\n".
        REAP bcode FROM generate_body, bd, indent + 2, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
        SET ccode TO ccode + bcode.
        REAP elif FROM _map_get, node, "elif".
        IF COUNT elif > 0,
            CREATE ei2(NUM) TO 0.
            SEASON ei2 < COUNT elif,
                REAP econd FROM plant_list_get, elif, ei2.
                REAP ebd FROM plant_list_get, elif, ei2 + 1.
                REAP ecc FROM translate_expr, econd.
                REAP ecc FROM handle_strcmp, ecc.
                SET ccode TO ccode + isel + "  \} else if (" + ecc + ") \{\n".
                REAP ebc FROM generate_body, ebd, indent + 2, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
                SET ccode TO ccode + ebc.
                SET ei2 TO ei2 + 2.
            /SEASON.
        /IF.
        REAP ebody FROM _map_get, node, "else".
        IF COUNT ebody > 0,
            SET ccode TO ccode + isel + "  \} else \{\n".
            REAP ebod FROM generate_body, ebody, indent + 2, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
            SET ccode TO ccode + ebod.
        /IF.
        SET ccode TO ccode + isel + "  \}\n".
        GIVE ccode.
    /IF.
  
    # ── season_stmt: SEASON cond, body /SEASON. → while(cond) {…} ─
    IF ntype IS "season_stmt",
        REAP cond FROM _map_get, node, "cond".
        REAP bd FROM _map_get, node, "body".
        REAP ccond FROM translate_expr, cond.
        REAP ccond FROM handle_strcmp, ccond.
        REAP isel FROM indent_str, indent.
        CREATE ccode(TX) TO isel + "  while (" + ccond + ") \{\n".
        REAP bcode FROM generate_body, bd, indent + 2, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
        SET ccode TO ccode + bcode + isel + "  \}\n".
        GIVE ccode.
    /IF.
  
    # ── cycle_stmt: FROM/TO → for(iter=from; iter<=to; iter+=step) ─
    IF ntype IS "cycle_stmt",
        REAP ivar FROM _map_get, node, "iterVar".
        REAP fromExpr FROM _map_get, node, "fromExpr".
        REAP toExpr FROM _map_get, node, "toExpr".
        REAP stepExpr FROM _map_get, node, "stepExpr".
        REAP listExpr FROM _map_get, node, "listExpr".
        REAP indexVar FROM _map_get, node, "indexVar".
        REAP bd FROM _map_get, node, "body".
        REAP isel FROM indent_str, indent.
        CREATE ccode(TX) TO "".
    
        # FROM/TO form
        IF fromExpr ISNT "",
            REAP cfrom FROM translate_expr, fromExpr.
            REAP cto FROM translate_expr, toExpr.
            CREATE stepstr(TX) TO "1".
            IF stepExpr > "" AND stepExpr ISNT "null",
                REAP cstep FROM translate_expr, stepExpr.
                SET stepstr TO cstep.
            /IF.
            SET ccode TO isel + "  for (long " + ivar + " = " + cfrom + "; " + ivar + " <= " + cto + "; " + ivar + " += " + stepstr + ") \{\n".
            REAP bcode FROM generate_body, bd, indent + 2, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
            SET ccode TO ccode + bcode + isel + "  \}\n".
            GIVE ccode.
        /IF.
    
        # IN list form (CYCLE var IN list)
        IF listExpr ISNT "",
            CREATE idxvar(TX) TO "__cycle_i".
            IF indexVar ISNT "" AND indexVar ISNT "null",
                SET idxvar TO indexVar.
            /IF.
            REAP clist FROM translate_expr, listExpr.
            SET ccode TO isel + "  \{\n".
            SET ccode TO ccode + isel + "    long " + idxvar + " = 0;\n".
            SET ccode TO ccode + isel + "    while (" + idxvar + " < plant_array_length(" + clist + ")) \{\n".
            SET ccode TO ccode + isel + "      tx_t " + ivar + " = plant_array_get(" + clist + ", " + idxvar + ");\n".
            REAP bcode FROM generate_body, bd, indent + 4, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
            SET ccode TO ccode + bcode + isel + "      " + idxvar + "++;\n".
            SET ccode TO ccode + isel + "    }\n".
            SET ccode TO ccode + isel + "  }\n".
            GIVE ccode.
        /IF.
    
        GIVE "".
    /IF.
  
    # ── match_stmt: MATCH expr { Variant -> { stmts } } → switch ─
    IF ntype IS "match_stmt",
        REAP subj FROM _map_get, node, "subjectExpr".
        CREATE clauses(LIST) TO _map_get(node, "clauses").
        REAP csubj FROM translate_expr, subj.
        REAP isel FROM indent_str, indent.
        CREATE ccode(TX) TO isel + "  switch (" + csubj + ") \{\n".
        CREATE ci(NUM) TO 0.
        CREATE clause(TX) TO "".
        SEASON ci < COUNT clauses,
            REAP clause FROM plant_list_get, clauses, ci.
            REAP vname FROM _map_get, clause, "variantName".
            REAP binding FROM _map_get, clause, "binding".
            REAP cbody FROM _map_get, clause, "bodyStatements".
            SET ccode TO ccode + isel + "    case " + vname + ":\n".
            IF binding > "" AND binding ISNT "null",
                SET ccode TO ccode + isel + "      \{\n".
                SET ccode TO ccode + isel + "        tx_t " + binding + " = " + csubj + ";\n".
                REAP bcode FROM generate_body, cbody, indent + 4, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
                SET ccode TO ccode + bcode + isel + "      \}\n".
            /IF.
            IF binding IS "" OR binding IS "null",
                REAP bcode FROM generate_body, cbody, indent + 4, sigs, subst, clmap, actx, nums, stvars, evars, rty, mexit.
                SET ccode TO ccode + bcode.
            /IF.
            SET ccode TO ccode + isel + "      break;\n".
            SET ci TO ci + 1.
        /SEASON.
        SET ccode TO ccode + isel + "  \}\n".
        GIVE ccode.
    /IF.
  
    # ── external_decl: ACTION name(params) -> external. → no code (plant_compat.h) ─
    IF ntype IS "external_decl",
        GIVE "".
    /IF.

    # ── struct_decl: STRUCT name { field: TYPE, … } → no code here;
    #    typedefs (plain + mangled instantiations) come from the
    #    structs table pass in generate_c.
    IF ntype IS "struct_decl",
        GIVE "".
    /IF.

    # ── action_decl: ACTION name(params), body /ACTION. → void name(…) {…} ─
    # Generic templates emit nothing here; monomorphized copies are emitted
    # separately for each instantiation (see emit_inst).
    IF ntype IS "action_decl",
        CREATE gens_nd(LIST) TO _map_get(node, "generics").
        IF COUNT gens_nd IS 0,
            REAP aname FROM _map_get, node, "name".
            CREATE fnname(TX) TO aname.
            IF aname IS "main" AND _map_get(node, "main_rename") IS "1",
                SET fnname TO "plant_main".
            /IF.
            CREATE params(LIST) TO _map_get(node, "params").
            REAP bd FROM _map_get, node, "body".
            CREATE stvars_a(LIST) TO collect_stvars(bd, params, subst).
        # ── ASYNC ACTION: state struct + step function + entry ──
        #    (v0.48.3 async engine; generic async actions unsupported)
        CREATE asy_mark(TX) TO _map_get(node, "async").
        IF asy_mark IS "1",
            REAP prio_s FROM _map_get, node, "prio".
            CREATE avars(LIST) TO async_collect_vars(bd, params).
            CREATE aphases(LIST) TO async_split_phases(bd).
            CREATE evars_asy(LIST) TO collect_enums(bd, params, subst, evars, sigs).
            REAP st_code FROM async_emit_state, aname, avars.
            REAP en_code FROM async_emit_entry, aname, params, prio_s, _map_get(node, "mission_mode").
            REAP stp_code FROM async_emit_step, aname, aphases, avars, sigs, subst, clmap, stvars_a, evars_asy.
            GIVE "static int plant_a_" + aname + "_step(tx_t st);\n\n" + st_code + en_code + stp_code.
        /IF.
        CREATE paramstr(TX) TO "".
        CREATE pi(NUM) TO 0.
        CREATE param_el(TX) TO "".
        SEASON pi < COUNT params,
            REAP param_el FROM plant_list_get, params, pi.
            REAP pname FROM _map_get, param_el, "name".
            REAP ptype FROM _map_get, param_el, "type".
            REAP ctype FROM ffi_ctype, ptype.
            IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
            SET paramstr TO paramstr + ctype + " " + pname.
            SET pi TO pi + 1.
        /SEASON.
        CREATE nums_a(LIST) TO collect_nums(bd, params, subst).
        CREATE evars_a(LIST) TO collect_enums(bd, params, subst, evars, sigs).
        CREATE ccode(TX) TO "tx_t " + fnname + "(" + paramstr + ") \{\n".
        CREATE implicit(LIST) TO collect_implicit(bd, params).
        CREATE dcode(TX) TO "".
        CREATE di(NUM) TO 0.
        CREATE dv(TX) TO "".
        SEASON di < COUNT implicit,
            REAP dv FROM plant_list_get, implicit, di.
            SET dcode TO dcode + "  tx_t " + dv + " = \"\";\n".
            SET di TO di + 1.
        /SEASON.
        # v0.48.13: the declared -> Type after substitution drives
        # _from_long wrapping of numeric GIVEs ("" for implicit)
        CREATE rty_a(TX) TO subst_type(_map_get(node, "ret"), subst).
        # v0.48.18: the mission-mode exit lines are computed up front so
        # they can be threaded into the body generator — GIVE returns
        # emit them before the return; tail returns get them appended
        # after the body (see below).
        CREATE mmode(TX) TO _map_get(node, "mission_mode").
        CREATE mexit(TX) TO "".
        IF mmode IS "FAST", SET mexit TO "  plant_fast_exit();\n". /IF.
        IF mmode IS "SAFE", SET mexit TO "  plant_safe_exit();\n". /IF.
        IF mmode IS "SMART", SET mexit TO "  plant_smart_exit(\"" + aname + "\");\n". /IF.
        IF mmode IS "PERSISTENT", SET mexit TO "  plant_persist_exit();\n". /IF.
        REAP bcode FROM generate_body, bd, 1, sigs, subst, clmap, actx, nums_a, stvars_a, evars_a, rty_a, mexit.
        # v0.48.15: Mission Mode binding — FAST actions bind the bump
        # heap (plant_fast_enter resets it at every scope enter);
        # SAFE actions carry the Boundary Handshake guard so FAST
        # callers are blocked at the callee entry.
        # v0.48.16: every guarded mode (FAST/SAFE/SMART/PERSISTENT)
        # carries the callee-side boundary guard with its mode; FAST
        # binds the bump heap, SAFE binds the warm pool + SafeChannel.
        IF mmode IS "FAST",
            SET bcode TO "  if (plant_boundary_block(\"" + aname + "\", \"FAST\")) return \"\";\n  plant_fast_enter(\"" + aname + "\");\n" + bcode.
        /IF.
        IF mmode IS "SAFE",
            SET bcode TO "  if (plant_boundary_block(\"" + aname + "\", \"SAFE\")) return \"\";\n  plant_safe_enter(\"" + aname + "\");\n  plant_safe_channel_init(\"" + aname + "\");\n" + bcode.
        /IF.
        # v0.48.17: SMART binds the SmartExecutionRouter, which routes on
        # the dataset size (first NUM parameter): N < threshold runs
        # Scalar Inline, N >= threshold runs Parallel Vector Mode with
        # chunk dispatch over the dynamic vec pool.
        IF mmode IS "SMART",
            CREATE sp(TX) TO "0".
            CREATE spi(NUM) TO 0.
            SEASON spi < COUNT params,
                REAP sp_ty FROM _map_get, params[spi], "type".
                IF sp_ty IS "NUM",
                    REAP sp FROM _map_get, params[spi], "name".
                    SET spi TO COUNT params.
                /IF.
                SET spi TO spi + 1.
            /SEASON.
            SET bcode TO "  if (plant_boundary_block(\"" + aname + "\", \"SMART\")) return \"\";\n  plant_smart_enter(\"" + aname + "\", " + sp + ");\n" + bcode.
        /IF.
        IF mmode IS "PERSISTENT",
            SET bcode TO "  if (plant_boundary_block(\"" + aname + "\", \"PERSISTENT\")) return \"\";\n  plant_persist_enter(\"" + aname + "\");\n" + bcode.
        /IF.
        # v0.48.16: leave the mission mode (release worker/channel for
        # SAFE, pop the mode stack for FAST) before the tail returns.
        # GIVE-terminated bodies already carried the exit lines (they
        # were threaded into the body generator as mexit), so only
        # non-give tails get the exit appended here.
        IF (COUNT bd) > 0,
            CREATE bd_count2(NUM) TO COUNT bd.
            CREATE last_idx2(NUM) TO bd_count2 - 1.
            CREATE last_nd2(TX) TO plant_list_get(bd, last_idx2).
            CREATE last_ty2(TX) TO _map_get(last_nd2, "type").
            IF mexit > "" AND last_ty2 ISNT "give_stmt",
                SET bcode TO bcode + mexit.
            /IF.
        /IF.
        IF (COUNT bd) IS 0,
            IF mexit > "",
                SET bcode TO bcode + mexit.
            /IF.
        /IF.
        # plant_async_drain() for ACTION main() when async is
        # reachable from its call graph (drain_after marker set by
        # generate_c pass 2b). Skipped when main ends in explicit
        # GIVE (the give's return would precede the drain).
        REAP drn2 FROM _map_get, node, "drain_after".
        IF (COUNT bd) IS 0,
            IF drn2 IS "1", SET bcode TO bcode + "  plant_async_drain();\n". /IF.
            SET bcode TO bcode + "  return " + fnname + ";\n".
        /IF.
        IF (COUNT bd) > 0,
            CREATE bd_count(NUM) TO COUNT bd.
            CREATE last_idx(NUM) TO bd_count - 1.
            CREATE last_nd(TX) TO plant_list_get(bd, last_idx).
            CREATE last_ty(TX) TO _map_get(last_nd, "type").
            IF drn2 IS "1" AND last_ty ISNT "give_stmt",
                SET bcode TO bcode + "  plant_async_drain();\n".
            /IF.
            IF last_ty ISNT "give_stmt", SET bcode TO bcode + "  return " + fnname + ";\n". /IF.
        /IF.
        SET ccode TO ccode + dcode + bcode + "\}\n".
        GIVE ccode.
        /IF.
        GIVE "".
    /IF.
  
    # ── enum_decl: ENUM name { MEMBER, … } → typedef enum { … } name; ─
    IF ntype IS "enum_decl",
        REAP ename FROM _map_get, node, "name".
        CREATE members(LIST) TO _map_get(node, "members").
        CREATE ccode(TX) TO "typedef enum \{\n  ".
        CREATE mi(NUM) TO 0.
        CREATE member_el(TX) TO "".
        SEASON mi < COUNT members,
            REAP member_el FROM plant_list_get, members, mi.
            IF mi > 0, SET ccode TO ccode + ",\n  ". /IF.
            SET ccode TO ccode + member_el.
            SET mi TO mi + 1.
        /SEASON.
        SET ccode TO ccode + "\n\} " + ename + ";\n".
        # guard macro lets FFI mock code reference the enum type and
        # its member constants (#ifdef PLANT_ENUM_Color) (v0.48.12)
        GIVE "#define PLANT_ENUM_" + ename + " 1\n" + ccode.
    /IF.
    GIVE "".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  plant_ctype — PlantLang param type → C type (REF → pointer)
#  Generic/container types (LIST[T]) are stripped to their base
#  before mapping, so LIST[NUM] → PlantArray*.
# ──────────────────────────────────────────────────────────────
ACTION type_base(ptype(TX)),
    REAP bi FROM find_any, ptype, "[".
    IF bi IS -1, GIVE ptype. /IF.
    REAP b FROM substring, ptype, 0, bi.
    REAP bt FROM trim, b.
    GIVE bt.
/ACTION.

ACTION plant_ctype(ptype(TX)),
    REAP base FROM type_base, ptype.
    IF base IS "NUM", GIVE "long". /IF.
    IF base IS "FACT", GIVE "int". /IF.
    IF base IS "LIST", GIVE "PlantArray*". /IF.
    IF base IS "REF NUM", GIVE "long*". /IF.
    IF base IS "REF FACT", GIVE "int*". /IF.
    IF base IS "REF LIST", GIVE "PlantArray**". /IF.
    IF base IS "REF TX", GIVE "tx_t*". /IF.
    GIVE "tx_t".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  v0.48.4 — FFI Optional Extensions
#  Type classification + marshalling helpers for STRUCT-by-value,
#  STRUCT-by-pointer (REF STRUCT), void*, CALLBACK and varargs.
#  Plain struct names (no STRUCT prefix) keep the opaque tx_t ABI.
# ──────────────────────────────────────────────────────────────

# ffi_param_kind — classify an FFI param type:
#   struct_val   STRUCT X (by value)
#   struct_ref   REF STRUCT X (by pointer)
#   voidptr      void*
#   callback     CALLBACK
#   plain        everything else
ACTION ffi_param_kind(ptype(TX)),
  REAP p0 FROM substring, ptype, 0, 4.
  IF p0 IS "REF ",
    REAP rest FROM substring, ptype, 4, LEN(ptype).
    REAP r0 FROM substring, rest, 0, 7.
    IF r0 IS "STRUCT ", GIVE "struct_ref". /IF.
    GIVE "plain".
  /IF.
  REAP s0 FROM substring, ptype, 0, 7.
  IF s0 IS "STRUCT ", GIVE "struct_val". /IF.
  IF str_eq(ptype, "void*") IS "1", GIVE "voidptr". /IF.
  IF str_eq(ptype, "CALLBACK") IS "1", GIVE "callback". /IF.
  GIVE "plain".
/ACTION.

# ffi_struct_name — "STRUCT Point" / "REF STRUCT Box [ NUM ]" →
# "Point" / "Box [ NUM ]" (struct type text without markers)
ACTION ffi_struct_name(typ(TX)),
  REAP p0 FROM substring, typ, 0, 4.
  IF p0 IS "REF ",
    REAP rest FROM substring, typ, 4, LEN(typ).
    SET typ TO rest.
  /IF.
  REAP s0 FROM substring, typ, 0, 7.
  IF s0 IS "STRUCT ",
    GIVE substring(typ, 7, LEN(typ)).
  /IF.
  GIVE typ.
/ACTION.

# ffi_struct_cname — struct type text → generated C typedef name:
# "Point" → plant_Point, "Box [ NUM ]" → plant_Box_NUM
ACTION ffi_struct_cname(typ(TX)),
  REAP p0 FROM substring, typ, 0, 4.
  IF p0 IS "REF ",
    REAP typ FROM substring, typ, 4, LEN(typ).
  /IF.
  REAP s0 FROM substring, typ, 0, 7.
  IF s0 IS "STRUCT ",
    REAP typ FROM substring, typ, 7, LEN(typ).
  /IF.
  REAP b0 FROM base_of, typ.
  REAP bt0 FROM trim, b0.
  CREATE cname(TX) TO "plant_" + bt0.
  REAP bi FROM find_any, typ, "[".
  IF bi ISNT -1,
    REAP gargs FROM parse_type_args, typ.
    CREATE ai(NUM) TO 0.
    CREATE av(TX) TO "".
    SEASON ai < COUNT gargs,
      REAP av FROM plant_list_get, gargs, ai.
      SET cname TO cname + "_" + av.
      SET ai TO ai + 1.
    /SEASON.
  /IF.
  GIVE cname.
/ACTION.

# is_struct_type — 1 when a type is a struct type (not a primitive
# scalar NUM/FACT/TX/LIST, not a REF, not empty)
ACTION is_struct_type(t(TX)),
  REAP base FROM type_base, t.
  REAP tb FROM trim, base.
  IF tb IS "NUM", GIVE "0". /IF.
  IF tb IS "FACT", GIVE "0". /IF.
  IF tb IS "TX", GIVE "0". /IF.
  IF tb IS "LIST", GIVE "0". /IF.
  IF tb IS "", GIVE "0". /IF.
  REAP rf FROM substring, tb, 0, 4.
  IF rf IS "REF ", GIVE "0". /IF.
  GIVE "1".
/ACTION.

# collect_stvars_walk — struct-typed CREATE/LET targets in a body
ACTION collect_stvars_walk(bd(LIST), subst(LIST), res(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE wnd(TX) TO "".
  CREATE wty(TX) TO "".
  CREATE wtg(TX) TO "".
  CREATE wvt(TX) TO "".
  CREATE wbs(TX) TO "".
  SEASON wi < COUNT bd,
    REAP wnd FROM plant_list_get, bd, wi.
    REAP wty FROM _map_get, wnd, "type".
    IF wty IS "create_stmt" OR wty IS "let_stmt",
      REAP wtg FROM _map_get, wnd, "target".
      REAP wvt FROM _map_get, wnd, "var_type".
      REAP wbs FROM subst_type, wvt, subst.
      REAP wsf FROM is_struct_type, wbs.
      IF wsf IS "1",
        REAP wfound FROM list_contains, res, wtg.
        IF wfound IS 0,
          PUT wtg INTO res.
          REAP wk2 FROM ffi_param_kind, wbs.
          PUT wk2 INTO res.
        /IF.
      /IF.
    /IF.
    IF wty IS "if_stmt",
      REAP ib FROM _if_bodies, wnd.
      CREATE ii6(NUM) TO 0.
      SEASON ii6 < COUNT ib,
        REAP ibd6 FROM plant_list_get, ib, ii6.
        REAP wret2 FROM collect_stvars_walk, ibd6, subst, res.
        SET ii6 TO ii6 + 1.
      /SEASON.
    /IF.
    IF wty IS "season_stmt" OR wty IS "cycle_stmt" OR wty IS "match_stmt",
      REAP wbd2 FROM _map_get, wnd, "body".
      REAP wret2 FROM collect_stvars_walk, wbd2, subst, res.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE res.
/ACTION.

# collect_stvars — struct-typed var names in scope for an action:
# struct params + struct CREATE/LET targets (mirrors collect_nums).
# Flat [name, kind, …] pairs; kind = ffi_param_kind of the type.
ACTION collect_stvars(bd(LIST), params(LIST), subst(LIST)),
  CREATE res(LIST) TO plant_list_make(0).
  CREATE pi(NUM) TO 0.
  CREATE pnd(LIST) TO plant_list_make(0).
  CREATE pn2(TX) TO "".
  CREATE pty2(TX) TO "".
  CREATE psu2(TX) TO "".
  SEASON pi < COUNT params,
    REAP pnd FROM plant_list_get, params, pi.
    REAP pn2 FROM _map_get, pnd, "name".
    REAP pty2 FROM _map_get, pnd, "type".
    REAP psu2 FROM subst_type, pty2, subst.
    REAP pbs2 FROM is_struct_type, psu2.
    IF pbs2 IS "1",
      REAP pf FROM list_contains, res, pn2.
      IF pf IS 0,
        PUT pn2 INTO res.
        REAP pk2 FROM ffi_param_kind, psu2.
        PUT pk2 INTO res.
      /IF.
    /IF.
    SET pi TO pi + 1.
  /SEASON.
  REAP ret FROM collect_stvars_walk, bd, subst, res.
  GIVE res.
/ACTION.

# find_sig — look up the full sigs entry (name/params/ret/varargs)
# by declaration name; real empty LIST when missing
ACTION find_sig(sigs(LIST), name(TX)),
  CREATE fi(NUM) TO 0.
  CREATE fe(TX) TO "".
  CREATE fn(TX) TO "".
  CREATE found(LIST) TO plant_list_make(0).
  SEASON fi < COUNT sigs,
    REAP fe FROM plant_list_get, sigs, fi.
    REAP fn FROM _map_get, fe, "name".
    IF str_eq(fn, name) IS "1",
      SET found TO fe.
    /IF.
    SET fi TO fi + 1.
  /SEASON.
  GIVE found.
/ACTION.

# ffi_ctype — C type for an FFI param/return type
ACTION ffi_ctype(ptype(TX)),
  REAP k FROM ffi_param_kind, ptype.
  IF k IS "struct_val",
    REAP sn FROM ffi_struct_name, ptype.
    GIVE ffi_struct_cname(sn).
  /IF.
  IF k IS "struct_ref",
    REAP sn FROM ffi_struct_name, ptype.
    GIVE ffi_struct_cname(sn) + "*".
  /IF.
  IF k IS "voidptr", GIVE "void*". /IF.
  IF k IS "callback", GIVE "plant_cb_t". /IF.
  GIVE plant_ctype(ptype).
/ACTION.

# is_bare_id — expr is a single identifier [A-Za-z0-9_]+
ACTION is_bare_id(e(TX)),
  CREATE bi2(NUM) TO 0.
  CREATE bc(TX) TO "".
  SEASON bi2 < LEN(e),
    REAP bc FROM char_at, e, bi2.
    IF bc IS " " OR bc IS "(" OR bc IS ")" OR bc IS "+" OR bc IS "-" OR bc IS "\"" OR bc IS "[" OR bc IS "]" OR bc IS "@" OR bc IS "*" OR bc IS "&" OR bc IS "=" OR bc IS "!",
      GIVE "0".
    /IF.
    SET bi2 TO bi2 + 1.
  /SEASON.
  GIVE "1".
/ACTION.

# expr_is_stringlike — a translated expression yields a TX string:
# starts with a string literal, is a _cat call, or a _from_long call
# (quote checks use substring comparisons — call-arg string literals
#  cannot contain quote characters in the v1 bootstrap)
ACTION expr_is_stringlike(e(TX)),
  REAP q0 FROM substring, e, 0, 1.
  IF q0 IS "\"", GIVE "1". /IF.
  REAP c1 FROM find_any, e, "_cat(".
  IF c1 ISNT -1, GIVE "1". /IF.
  REAP s1 FROM substring, e, 0, 11.
  IF s1 IS "_from_long(", GIVE "1". /IF.
  GIVE "0".
/ACTION.

# stvar_kind — flat [name, kind, …] lookup: struct-var kind
# ("struct_val"/"struct_ref") for a name, or "" when not a stvar
ACTION stvar_kind(stvars(LIST), name(TX)),
  CREATE si(NUM) TO 0.
  SEASON si + 1 < COUNT stvars,
    REAP sv1 FROM plant_list_get, stvars, si.
    IF str_eq(sv1, name) IS "1",
      REAP sk1 FROM plant_list_get, stvars, si + 1.
      GIVE sk1.
    /IF.
    SET si TO si + 2.
  /SEASON.
  GIVE "".
/ACTION.

# collect_cb_uses — action names passed as CALLBACK args anywhere
# in a body (recurses IF/SEASON/CYCLE/MATCH)
ACTION collect_cb_uses(bd(LIST), sigs(LIST), acc(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "reap_stmt" OR ty IS "start_stmt" OR ty IS "await_stmt",
      REAP caact FROM _map_get, nd, "action".
      IF caact > "",
        REAP caact FROM strings:REPLACE, caact, ":", "_".
        REAP cafp FROM find_params, sigs, caact.
        CREATE caargs(LIST) TO _map_get(nd, "args").
        CREATE kai(NUM) TO 0.
        SEASON kai < COUNT caargs,
          IF kai < COUNT cafp,
            REAP kap FROM plant_list_get, cafp, kai.
            REAP kpty FROM _map_get, kap, "type".
            REAP kk FROM ffi_param_kind, kpty.
            IF kk IS "callback",
              REAP karg FROM plant_list_get, caargs, kai.
              REAP kb FROM is_bare_id, karg.
              IF kb IS "1",
                REAP kfound FROM callee_add, acc, karg.
                SET acc TO kfound.
              /IF.
            /IF.
          /IF.
          SET kai TO kai + 1.
        /SEASON.
      /IF.
    /IF.
    IF ty IS "if_stmt",
      REAP ib FROM _if_bodies, nd.
      CREATE ii7(NUM) TO 0.
      SEASON ii7 < COUNT ib,
        REAP ibd7 FROM plant_list_get, ib, ii7.
        REAP acc FROM collect_cb_uses, ibd7, sigs, acc.
        SET ii7 TO ii7 + 1.
      /SEASON.
    /IF.
    IF ty IS "season_stmt" OR ty IS "cycle_stmt",
      REAP sb FROM _map_get, nd, "body".
      REAP acc FROM collect_cb_uses, sb, sigs, acc.
    /IF.
    IF ty IS "match_stmt",
      CREATE cl9(LIST) TO _map_get(nd, "clauses").
      CREATE ci9(NUM) TO 0.
      SEASON ci9 < COUNT cl9,
        REAP cl2 FROM plant_list_get, cl9, ci9.
        REAP cb9 FROM _map_get, cl2, "bodyStatements".
        REAP acc FROM collect_cb_uses, cb9, sigs, acc.
        SET ci9 TO ci9 + 1.
      /SEASON.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE acc.
/ACTION.

# ffi_ret_ctype — FFI return type text → C type
ACTION ffi_ret_ctype(ret(TX)),
  REAP rk FROM ffi_param_kind, ret.
  IF rk IS "struct_val",
    REAP sn FROM ffi_struct_name, ret.
    GIVE ffi_struct_cname(sn).
  /IF.
  IF rk IS "voidptr", GIVE "void*". /IF.
  GIVE "tx_t".
/ACTION.

# struct_fields_at — subst'd field pairs [name, type, …] of a
# struct template for a type instantiation (args may be empty)
ACTION struct_fields_at(tpl(LIST), args(LIST)),
  CREATE flds(LIST) TO plant_list_make(0).
  CREATE sgens(LIST) TO _map_get(tpl, "generics").
  CREATE sfields(LIST) TO _map_get(tpl, "fields").
  CREATE fsub(LIST) TO build_subst(sgens, args).
  CREATE fi9(NUM) TO 0.
  CREATE fel9(TX) TO "".
  SEASON fi9 < COUNT sfields,
    REAP fel9 FROM plant_list_get, sfields, fi9.
    REAP fn9 FROM _map_get, fel9, "name".
    REAP ft9 FROM _map_get, fel9, "type".
    REAP fs9 FROM subst_type, ft9, fsub.
    PUT fn9 INTO flds.
    PUT fs9 INTO flds.
    SET fi9 TO fi9 + 1.
  /SEASON.
  GIVE flds.
/ACTION.

# ffi_emit_struct_helpers — map↔C-struct conversion helpers for
# one struct type (fields as [name, type, …] pairs, depth ≤ 3)
ACTION ffi_emit_struct_helpers(cname(TX), flds(LIST)),
  CREATE h1(TX) TO "".
  CREATE h2(TX) TO "".
  CREATE h3(TX) TO "".
  CREATE h4(TX) TO "".
  CREATE hall(TX) TO "".
  SET h1 TO "static " + cname + " plant_map_to_" + cname + "_d(tx_t m, long depth) \{\n".
  SET h1 TO h1 + "  " + cname + " r;\n  memset(&r, 0, sizeof(r));\n".
  SET h1 TO h1 + "  if (depth > 3) { plant_ffi_errno = FFI_ERR_DEPTH; plant_ffi_debug_print(\"map_to_" + cname + ": depth limit\"); return r; }\n".
  SET h1 TO h1 + "  if (!m) { plant_ffi_errno = FFI_ERR_TYPE; return r; }\n".
  CREATE fi8(NUM) TO 0.
  CREATE fn8(TX) TO "".
  CREATE ft8(TX) TO "".
  SEASON fi8 + 1 < COUNT flds,
    REAP fn8 FROM plant_list_get, flds, fi8.
    REAP ft8 FROM plant_list_get, flds, fi8 + 1.
    REAP fb8 FROM type_base, ft8.
    IF fb8 IS "NUM",
      SET h1 TO h1 + "  r." + fn8 + " = (long)(intptr_t)plant_map_get(m, \"" + fn8 + "\");\n".
    /IF.
    IF fb8 IS "FACT",
      SET h1 TO h1 + "  r." + fn8 + " = (int)(intptr_t)plant_map_get(m, \"" + fn8 + "\");\n".
    /IF.
    IF fb8 IS "TX",
      SET h1 TO h1 + "  r." + fn8 + " = plant_map_get(m, \"" + fn8 + "\");\n".
    /IF.
    REAP fs8 FROM is_struct_type, ft8.
    IF fs8 IS "1",
      REAP es8 FROM substring, ft8, 0, 7.
      IF es8 IS "STRUCT ",
        REAP fcn8 FROM ffi_struct_cname, ft8.
        SET h1 TO h1 + "  r." + fn8 + " = plant_map_to_" + fcn8 + "_d(plant_map_get(m, \"" + fn8 + "\"), depth + 1);\n".
      /IF.
      IF es8 ISNT "STRUCT ",
        SET h1 TO h1 + "  r." + fn8 + " = plant_map_get(m, \"" + fn8 + "\");\n".
      /IF.
    /IF.
    IF fb8 IS "LIST",
      SET h1 TO h1 + "  plant_ffi_errno = FFI_ERR_TYPE;\n  return r;\n".
    /IF.
    SET fi8 TO fi8 + 2.
  /SEASON.
  SET h1 TO h1 + "  return r;\n\}\n".
  SET h2 TO "static " + cname + " plant_map_to_" + cname + "(tx_t m) { return plant_map_to_" + cname + "_d(m, 1); }\n".
  SET h3 TO "static void* plant_struct_alloc_copy_" + cname + "(" + cname + " v) { " + cname + "* r = (" + cname + "*)plant_alloc(sizeof(" + cname + ")); *r = v; return (void*)r; }\n".
  SET h3 TO h3 + "static " + cname + "* plant_map_to_ref_" + cname + "(tx_t m) { return (" + cname + "*)plant_struct_alloc_copy_" + cname + "(plant_map_to_" + cname + "(m)); }\n".
  SET h4 TO "static tx_t plant_" + cname + "_to_map(" + cname + " v) \{\n".
  SET h4 TO h4 + "  tx_t r = (tx_t)plant_map_create(8);\n".
  CREATE fi7(NUM) TO 0.
  CREATE fn7(TX) TO "".
  CREATE ft7(TX) TO "".
  SEASON fi7 + 1 < COUNT flds,
    REAP fn7 FROM plant_list_get, flds, fi7.
    REAP ft7 FROM plant_list_get, flds, fi7 + 1.
    REAP fb7 FROM type_base, ft7.
    IF fb7 IS "NUM",
      SET h4 TO h4 + "  plant_map_set(r, \"" + fn7 + "\", (void*)(intptr_t)v." + fn7 + ");\n".
    /IF.
    IF fb7 IS "FACT",
      SET h4 TO h4 + "  plant_map_set(r, \"" + fn7 + "\", (void*)(intptr_t)v." + fn7 + ");\n".
    /IF.
    IF fb7 IS "TX",
      SET h4 TO h4 + "  plant_map_set(r, \"" + fn7 + "\", v." + fn7 + ");\n".
    /IF.
    REAP fs7 FROM is_struct_type, ft7.
    IF fs7 IS "1",
      REAP es7 FROM substring, ft7, 0, 7.
      IF es7 IS "STRUCT ",
        REAP fcn7 FROM ffi_struct_cname, ft7.
        SET h4 TO h4 + "  plant_map_set(r, \"" + fn7 + "\", plant_" + fcn7 + "_to_map(v." + fn7 + "));\n".
      /IF.
      IF es7 ISNT "STRUCT ",
        SET h4 TO h4 + "  plant_map_set(r, \"" + fn7 + "\", v." + fn7 + ");\n".
      /IF.
    /IF.
    IF fb7 IS "LIST",
      SET h4 TO h4 + "  plant_ffi_errno = FFI_ERR_TYPE;\n  return r;\n".
    /IF.
    SET fi7 TO fi7 + 2.
  /SEASON.
  SET h4 TO h4 + "  return r;\n\}\n".
  SET hall TO h1 + h2 + "".
  SET hall TO hall + h3 + "".
  SET hall TO hall + h4 + "".
  GIVE hall.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  trim — strip leading/trailing spaces
# ──────────────────────────────────────────────────────────────
ACTION trim(s(TX)),
    CREATE st(NUM) TO 0.
    CREATE en(NUM) TO LEN(s).
    SEASON st < en,
        REAP c FROM char_at, s, st.
        IF c ISNT " ", BREAK 0. /IF.
        SET st TO st + 1.
    /SEASON.
    SEASON en > st,
        REAP c FROM char_at, s, en - 1.
        IF c ISNT " ", BREAK 0. /IF.
        SET en TO en - 1.
    /SEASON.
    IF en <= st, GIVE "". /IF.
    GIVE substring(s, st, en).
/ACTION.

# ──────────────────────────────────────────────────────────────
#  Generics Engine — monomorphization helpers
#
#  subst is a flat key/value list [T, NUM, U, TX, …] mapping
#  generic type parameters to concrete types.
# ──────────────────────────────────────────────────────────────
ACTION subst_append(acc(TX), w(TX), subst(LIST)),
    CREATE fi(NUM) TO 0.
    CREATE fk(TX) TO "".
    CREATE fv(TX) TO "".
    SEASON fi + 1 < COUNT subst,
        REAP fk FROM plant_list_get, subst, fi.
        REAP fv FROM plant_list_get, subst, fi + 1.
        IF str_eq(fk, w) IS "1",
            GIVE acc + fv.
        /IF.
        SET fi TO fi + 2.
    /SEASON.
    GIVE acc + w.
/ACTION.

# subst_type — replace whole-token generic names inside a type
# string; separators are space ( ) [ ] ,
# Fast-path: with an empty substitution map nothing can change,
# so the type is returned as-is without scanning (v0.48.11).
ACTION subst_type(t(TX), subst(LIST)),
    IF COUNT subst IS 0, GIVE t. /IF.
    CREATE res(TX) TO "".
    CREATE w(TX) TO "".
    CREATE si(NUM) TO 0.
    CREATE ch(TX) TO "".
    SEASON si < LEN(t),
        REAP ch FROM char_at, t, si.
        IF ch IS " " OR ch IS "[" OR ch IS "]" OR ch IS "(" OR ch IS ")" OR ch IS ",",
            REAP res FROM subst_append, res, w, subst.
            SET w TO "".
            SET res TO res + ch.
        /IF.
        IF ch ISNT " " AND ch ISNT "[" AND ch ISNT "]" AND ch ISNT "(" AND ch ISNT ")" AND ch ISNT ",",
            SET w TO w + ch.
        /IF.
        SET si TO si + 1.
    /SEASON.
    REAP res FROM subst_append, res, w, subst.
    GIVE res.
/ACTION.

# subst_reap_act — substitute generic names inside the […] of an
# action name: foo[T] under T→NUM → foo[NUM]
ACTION subst_reap_act(act(TX), subst(LIST)),
    REAP bi FROM find_any, act, "[".
    IF bi IS -1, GIVE act. /IF.
    REAP head FROM substring, act, 0, bi.
    REAP tail FROM substring, act, bi, LEN(act).
    REAP stail FROM subst_type, tail, subst.
    GIVE head + stail.
/ACTION.

# base_of — action name without type args: foo[NUM] → foo
ACTION base_of(act(TX)),
    REAP bi FROM find_any, act, "[".
    IF bi IS -1, GIVE act. /IF.
    GIVE substring(act, 0, bi).
/ACTION.

# ffi_topo_order — reorder a list of {scn, flds} maps so that every
# struct comes after all structs referenced by its fields (deps not
# present in the entries are ignored). Returns the reordered list.
ACTION ffi_topo_order(entries(LIST)),
  CREATE tdone(LIST) TO plant_list_make(0).
  CREATE tprog(NUM) TO 1.
  CREATE ti(NUM) TO 0.
  CREATE te9(LIST) TO plant_list_make(0).
  CREATE tscn(TX) TO "".
  CREATE tflds2(LIST) TO plant_list_make(0).
  CREATE td1(TX) TO "0".
  CREATE td2(TX) TO "0".
  CREATE td3(TX) TO "0".
  CREATE tj(NUM) TO 0.
  CREATE tok(NUM) TO 1.
  CREATE ft9(TX) TO "".
  CREATE fs9(TX) TO "".
  CREATE fc9(TX) TO "".
  CREATE res(LIST) TO plant_list_make(0).
  CREATE entries_scns(LIST) TO plant_list_make(0).
  SET ti TO 0.
  SEASON ti < COUNT entries,
    REAP te9 FROM plant_list_get, entries, ti.
    REAP tscn FROM _map_get, te9, "scn".
    PUT tscn INTO entries_scns.
    SET ti TO ti + 1.
  /SEASON.
  SEASON tprog IS 1,
    SET tprog TO 0.
    SET ti TO 0.
    SEASON ti < COUNT entries,
      REAP te9 FROM plant_list_get, entries, ti.
      REAP tscn FROM _map_get, te9, "scn".
      REAP td1 FROM key_in_acc, tscn, tdone.
      IF td1 IS "1",
        SET ti TO ti + 1.
        CONTINUE.
      /IF.
      CREATE tflds2(LIST) TO _map_get(te9, "flds").
      SET tok TO 1.
      SET tj TO 0.
      SEASON tj < COUNT tflds2,
        REAP ft9 FROM plant_list_get, tflds2, tj.
        REAP fs9 FROM is_struct_type, ft9.
        IF fs9 IS "1",
          REAP fc9 FROM ffi_struct_cname, ft9.
          REAP td2 FROM key_in_acc, fc9, entries_scns.
          IF td2 IS "1",
            REAP td3 FROM key_in_acc, fc9, tdone.
            IF td3 IS "0",
              SET tok TO 0.
            /IF.
          /IF.
        /IF.
        SET tj TO tj + 1.
      /SEASON.
      IF tok IS 1,
        PUT te9 INTO res.
        PUT tscn INTO tdone.
        SET tprog TO 1.
      /IF.
      SET ti TO ti + 1.
    /SEASON.
  /SEASON.
  GIVE res.
/ACTION.

# ffi_topo_emit_helpers — emit FFI struct conversion helpers
# (ffi_fwd + ffi_def text) in dependency order so that structs
# referenced as fields are emitted before their parents.
ACTION ffi_topo_emit_helpers(entries(LIST)),
  REAP ord FROM ffi_topo_order, entries.
  CREATE tfw(TX) TO "".
  CREATE tdf(TX) TO "".
  CREATE tscn(TX) TO "".
  CREATE tflds2(LIST) TO plant_list_make(0).
  CREATE ffd1(TX) TO "".
  CREATE ti(NUM) TO 0.
  CREATE te9(LIST) TO plant_list_make(0).
  SEASON ti < COUNT ord,
    REAP te9 FROM plant_list_get, ord, ti.
    REAP tscn FROM _map_get, te9, "scn".
    SET tfw TO tfw + "static " + tscn + " plant_map_to_" + tscn + "_d(tx_t m, long depth);\nstatic " + tscn + " plant_map_to_" + tscn + "(tx_t m);\nstatic void* plant_struct_alloc_copy_" + tscn + "(" + tscn + " v);\nstatic " + tscn + "* plant_map_to_ref_" + tscn + "(tx_t m);\nstatic tx_t plant_" + tscn + "_to_map(" + tscn + " v);\n".
    CREATE tflds2(LIST) TO _map_get(te9, "flds").
    REAP ffd1 FROM ffi_emit_struct_helpers, tscn, tflds2.
    SET tdf TO tdf + ffd1 + "\n".
    SET ti TO ti + 1.
  /SEASON.
  GIVE tfw + tdf.
/ACTION.

# parse_type_args — extract the type-arg list from foo[NUM, TX]
ACTION parse_type_args(act(TX)),
    REAP bi FROM find_any, act, "[".
    REAP ei FROM find_any, act, "]".
    IF bi IS -1 OR ei IS -1, GIVE plant_list_make(0). /IF.
    IF ei <= bi + 1, GIVE plant_list_make(0). /IF.
    REAP inner FROM substring, act, bi + 1, ei.
    REAP parts FROM strings:SPLIT, inner, ",".
    CREATE out(LIST) TO plant_list_make(0).
    CREATE oi(NUM) TO 0.
    CREATE pe(TX) TO "".
    CREATE pt(TX) TO "".
    SEASON oi < COUNT parts,
        REAP pe FROM plant_list_get, parts, oi.
        REAP pt FROM trim, pe.
        IF pt > "",
            PUT pt INTO out.
        /IF.
        SET oi TO oi + 1.
    /SEASON.
    GIVE out.
/ACTION.

# mangle — unique C identifier: plant_<name>_<T1>_<T2>
ACTION mangle(base(TX), args(LIST)),
    CREATE res(TX) TO "plant_" + base.
    CREATE mi(NUM) TO 0.
    CREATE ae(TX) TO "".
    SEASON mi < COUNT args,
        REAP ae FROM plant_list_get, args, mi.
        SET res TO res + "_" + ae.
        SET mi TO mi + 1.
    /SEASON.
    GIVE res.
/ACTION.

# find_template — locate a generic action template by base name
# (returns a real empty LIST when missing, so COUNT on the result
# is safe — never the "" sentinel, which would be read as a list)
ACTION find_template(templates(LIST), base(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE found(LIST) TO plant_list_make(0).
    SEASON fi < COUNT templates,
        REAP fe FROM plant_list_get, templates, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, base) IS "1",
            SET found TO fe.
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE found.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  STRUCT generics — struct template table + instantiation scan
#
#  structs is a list of [name, generics, fields] maps. Struct
#  types map to tx_t in generated C (opaque handles); the
#  typedefs plant_<Name>[_<T1>_<T2>] are emitted so C FFI code
#  (mocks, libraries) can cast and read the concrete layout.
# ──────────────────────────────────────────────────────────────

# find_struct — locate a STRUCT template by base name
# (real empty LIST when missing — never the "" sentinel, so
# COUNT on the result is safe)
ACTION find_struct(structs(LIST), name(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE found(LIST) TO plant_list_make(0).
    SEASON fi < COUNT structs,
        REAP fe FROM plant_list_get, structs, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, name) IS "1",
            SET found TO fe.
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE found.
/ACTION.

# scan_type — collect every concrete struct instantiation named
# inside a type string (substituted first), recursing into the
# template's fields and into nested bracket args
# (LIST[Box[NUM]], Pair[NUM, Box[U]], Node[T] …).
ACTION scan_type(t(TX), subst(LIST), structs(LIST), acc(LIST)),
    CREATE st(TX) TO "".
    CREATE bi(NUM) TO -1.
    CREATE ai2b(NUM) TO -1.
    REAP st FROM subst_type, t, subst.
    REAP bi FROM find_any, st, "[".
    IF bi ISNT -1,
            REAP base FROM base_of, st.
        REAP btrim FROM trim, base.
        REAP rf FROM substring, btrim, 0, 4.
        IF rf IS "REF ",
            REAP btrim FROM substring, btrim, 4, LEN(btrim).
        /IF.
        REAP tpl FROM find_struct, structs, btrim.
        IF COUNT tpl > 0,
            REAP args FROM parse_type_args, st.
            REAP found FROM key_in_acc, st, acc.
            IF found IS "0",
                PUT st INTO acc.
                REAP generics FROM _map_get, tpl, "generics".
                REAP nsubst FROM build_subst, generics, args.
                REAP fields FROM _map_get, tpl, "fields".
                CREATE fi2(NUM) TO 0.
                CREATE fv(TX) TO "".
                SEASON fi2 < COUNT fields,
                    REAP fv FROM _map_get, fields[fi2], "type".
                    REAP acc FROM scan_type, fv, nsubst, structs, acc.
                    SET fi2 TO fi2 + 1.
                /SEASON.
            /IF.
        /IF.
        REAP args FROM parse_type_args, st.
        CREATE ai2(NUM) TO 0.
        CREATE av(TX) TO "".
        SEASON ai2 < COUNT args,
            REAP av FROM plant_list_get, args, ai2.
            REAP ai2b FROM find_any, av, "[".
            IF ai2b ISNT -1,
                REAP acc FROM scan_type, av, subst, structs, acc.
            /IF.
            SET ai2 TO ai2 + 1.
        /SEASON.
    /IF.
    GIVE acc.
/ACTION.

# scan_params — scan every param type of a decl
ACTION scan_params(params(LIST), subst(LIST), structs(LIST), acc(LIST)),
    CREATE pi(NUM) TO 0.
    CREATE pv(TX) TO "".
    SEASON pi < COUNT params,
        REAP pv FROM _map_get, params[pi], "type".
        REAP acc FROM scan_type, pv, subst, structs, acc.
        SET pi TO pi + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# scan_fields — scan every field type of a struct template
ACTION scan_fields(fields(LIST), subst(LIST), structs(LIST), acc(LIST)),
    CREATE fi(NUM) TO 0.
    CREATE fv(TX) TO "".
    SEASON fi < COUNT fields,
        REAP fv FROM _map_get, fields[fi], "type".
        REAP acc FROM scan_type, fv, subst, structs, acc.
        SET fi TO fi + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# collect_struct_insts — walk a body for struct-typed declarations
ACTION collect_struct_insts(bd(LIST), subst(LIST), structs(LIST), acc(LIST)),
    CREATE ci(NUM) TO 0.
    CREATE nd(TX) TO "".
    CREATE ty(TX) TO "".
    CREATE vt(TX) TO "".
    CREATE sub_bd(LIST) TO plant_list_make(0).
    SEASON ci < COUNT bd,
        REAP nd FROM plant_list_get, bd, ci.
        REAP ty FROM _map_get, nd, "type".
        IF ty IS "create_stmt" OR ty IS "let_stmt",
            REAP vt FROM _map_get, nd, "var_type".
            IF vt > "",
                REAP acc FROM scan_type, vt, subst, structs, acc.
            /IF.
        /IF.
        IF ty IS "if_stmt",
            REAP ib FROM _if_bodies, nd.
            CREATE ii8(NUM) TO 0.
            SEASON ii8 < COUNT ib,
                REAP ibd8 FROM plant_list_get, ib, ii8.
                REAP acc FROM collect_struct_insts, ibd8, subst, structs, acc.
                SET ii8 TO ii8 + 1.
            /SEASON.
        /IF.
        IF ty IS "season_stmt",
            REAP sub_bd FROM _map_get, nd, "body".
            REAP acc FROM collect_struct_insts, sub_bd, subst, structs, acc.
        /IF.
        SET ci TO ci + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# struct_typedef — C typedef text for a struct template, optionally
# instantiated: typedef struct { … } plant_<Name>[_<T1>_<T2>];
ACTION struct_typedef(tpl(LIST), args(LIST)),
    REAP sname FROM _map_get, tpl, "name".
    REAP generics FROM _map_get, tpl, "generics".
    REAP fields FROM _map_get, tpl, "fields".
    REAP subst FROM build_subst, generics, args.
    CREATE tname(TX) TO "plant_" + sname.
    CREATE mi(NUM) TO 0.
    CREATE ae(TX) TO "".
    SEASON mi < COUNT args,
        REAP ae FROM plant_list_get, args, mi.
        SET tname TO tname + "_" + ae.
        SET mi TO mi + 1.
    /SEASON.
    CREATE ccode(TX) TO "typedef struct \{\n".
    CREATE fi(NUM) TO 0.
    CREATE fel(LIST) TO plant_list_make(0).
    CREATE fname(TX) TO "".
    CREATE ftype(TX) TO "".
    CREATE fsub(TX) TO "".
    CREATE ctype(TX) TO "".
    SEASON fi < COUNT fields,
        REAP fel FROM plant_list_get, fields, fi.
        REAP fname FROM _map_get, fel, "name".
        REAP ftype FROM _map_get, fel, "type".
        REAP fsub FROM subst_type, ftype, subst.
        REAP sp8 FROM substring, fsub, 0, 7.
        IF sp8 IS "STRUCT ",
            REAP ctype FROM ffi_ctype, fsub.
        /IF.
        IF sp8 ISNT "STRUCT ",
            # Non-STRUCT fields: explicit REF STRUCT → pointer layout; a
            # plain/generic struct reference (Box[NUM]) is an opaque tx_t
            # handle at runtime, so the typedef keeps the handle and the
            # marshalling helpers pass it through (v0.48.5).
            REAP fk9 FROM ffi_param_kind, fsub.
            IF fk9 IS "struct_ref",
                REAP ctype FROM ffi_ctype, fsub.
            /IF.
            IF fk9 ISNT "struct_ref",
                REAP base9 FROM type_base, fsub.
                IF base9 IS "NUM" OR base9 IS "FACT" OR base9 IS "TX" OR base9 IS "LIST",
                    REAP ctype FROM plant_ctype, fsub.
                /IF.
                IF base9 ISNT "NUM" AND base9 ISNT "FACT" AND base9 ISNT "TX" AND base9 ISNT "LIST",
                    SET ctype TO "tx_t".
                /IF.
            /IF.
        /IF.
        SET ccode TO ccode + "  " + ctype + " " + fname + ";\n".
        SET fi TO fi + 1.
    /SEASON.
    SET ccode TO ccode + "\} " + tname + ";\n".
    GIVE ccode.
/ACTION.

# key_in_acc — is key already in the instantiation cache?
ACTION key_in_acc(key(TX), acc(LIST)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    SEASON fi < COUNT acc,
        REAP fe FROM plant_list_get, acc, fi.
        IF str_eq(fe, key) IS "1", GIVE "1". /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE "0".
/ACTION.

# build_subst — zip template generics with concrete type args
ACTION build_subst(generics(LIST), args(LIST)),
    CREATE subst(LIST) TO plant_list_make(0).
    CREATE zi(NUM) TO 0.
    CREATE gv(TX) TO "".
    CREATE av(TX) TO "".
    SEASON zi < COUNT generics,
        IF zi < COUNT args,
            REAP gv FROM plant_list_get, generics, zi.
            REAP av FROM plant_list_get, args, zi.
            PUT gv INTO subst.
            PUT av INTO subst.
        /IF.
        SET zi TO zi + 1.
    /SEASON.
    GIVE subst.
/ACTION.

# collect_insts — discover every concrete instantiation reachable
# from a body; walks into generic templates with the substituted
# type context. Functional accumulation (acc is returned).
ACTION collect_insts(bd(LIST), subst(LIST), templates(LIST), acc(LIST)),
    CREATE ci(NUM) TO 0.
    CREATE nd(TX) TO "".
    CREATE ty(TX) TO "".
    CREATE act(TX) TO "".
    CREATE gi(NUM) TO -1.
    SEASON ci < COUNT bd,
        REAP nd FROM plant_list_get, bd, ci.
        REAP ty FROM _map_get, nd, "type".
        IF ty IS "reap_stmt",
            REAP act FROM _map_get, nd, "action".
            REAP gi FROM find_any, act, "[".
            IF gi ISNT -1,
                REAP sact FROM subst_reap_act, act, subst.
                REAP base FROM base_of, sact.
                REAP tpl FROM find_template, templates, base.
                IF COUNT tpl > 0,
                    REAP found FROM key_in_acc, sact, acc.
                    IF found IS "0",
                        PUT sact INTO acc.
                        REAP args FROM parse_type_args, sact.
                        REAP generics FROM _map_get, tpl, "generics".
                        REAP nsubst FROM build_subst, generics, args.
                        REAP tbd FROM _map_get, tpl, "body".
                        REAP acc FROM collect_insts, tbd, nsubst, templates, acc.
                    /IF.
                /IF.
            /IF.
        /IF.
        IF ty IS "if_stmt",
            REAP ib FROM _if_bodies, nd.
            CREATE ii9(NUM) TO 0.
            SEASON ii9 < COUNT ib,
                REAP ibd9 FROM plant_list_get, ib, ii9.
                REAP acc FROM collect_insts, ibd9, subst, templates, acc.
                SET ii9 TO ii9 + 1.
            /SEASON.
        /IF.
        IF ty IS "season_stmt",
            REAP sub_bd FROM _map_get, nd, "body".
            REAP acc FROM collect_insts, sub_bd, subst, templates, acc.
        /IF.
        SET ci TO ci + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# inst_fwddecl — forward declaration for one instantiation
ACTION inst_fwddecl(inst(TX), templates(LIST)),
    REAP base FROM base_of, inst.
    REAP args FROM parse_type_args, inst.
    REAP tpl FROM find_template, templates, base.
    IF COUNT tpl IS 0, GIVE "". /IF.
    REAP generics FROM _map_get, tpl, "generics".
    REAP params FROM _map_get, tpl, "params".
    REAP subst FROM build_subst, generics, args.
    REAP mname FROM mangle, base, args.
    CREATE paramstr(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE param_el(TX) TO "".
    CREATE pname(TX) TO "".
    CREATE ptype(TX) TO "".
    CREATE psub(TX) TO "".
    CREATE ctype(TX) TO "".
    SEASON pi < COUNT params,
        REAP param_el FROM plant_list_get, params, pi.
        REAP pname FROM _map_get, param_el, "name".
        REAP ptype FROM _map_get, param_el, "type".
        REAP psub FROM subst_type, ptype, subst.
        REAP ctype FROM ffi_ctype, psub.
        IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
        SET paramstr TO paramstr + ctype + " " + pname.
        SET pi TO pi + 1.
    /SEASON.
    GIVE "tx_t " + mname + "(" + paramstr + ");\n".
/ACTION.

# emit_inst — full body emission for one instantiation
ACTION emit_inst(inst(TX), templates(LIST), sigs(LIST), reg(LIST)),
    REAP base FROM base_of, inst.
    REAP args FROM parse_type_args, inst.
    REAP tpl FROM find_template, templates, base.
    IF COUNT tpl IS 0, GIVE "". /IF.
    REAP generics FROM _map_get, tpl, "generics".
    REAP params FROM _map_get, tpl, "params".
    REAP bd FROM _map_get, tpl, "body".
    REAP subst FROM build_subst, generics, args.
    REAP mname FROM mangle, base, args.
    # v0.48.13: the template's declared -> Type after substitution
    # drives _from_long wrapping of numeric GIVEs ("" if implicit)
    CREATE rtpl(TX) TO _map_get(tpl, "ret").
    CREATE rty_m(TX) TO subst_type(rtpl, subst).
    CREATE paramstr(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE param_el(TX) TO "".
    CREATE pname(TX) TO "".
    CREATE ptype(TX) TO "".
    CREATE psub(TX) TO "".
    CREATE ctype(TX) TO "".
    SEASON pi < COUNT params,
        REAP param_el FROM plant_list_get, params, pi.
        REAP pname FROM _map_get, param_el, "name".
        REAP ptype FROM _map_get, param_el, "type".
        REAP psub FROM subst_type, ptype, subst.
        REAP ctype FROM ffi_ctype, psub.
        IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
        SET paramstr TO paramstr + ctype + " " + pname.
        SET pi TO pi + 1.
    /SEASON.
    CREATE ccode(TX) TO "tx_t " + mname + "(" + paramstr + ") \{\n".
    CREATE nums_m(LIST) TO collect_nums(bd, params, subst).
    CREATE stvars_m(LIST) TO collect_stvars(bd, params, subst).
    CREATE evars_m(LIST) TO collect_enums(bd, params, subst, reg, sigs).
    CREATE implicit(LIST) TO collect_implicit(bd, params).
    CREATE dcode(TX) TO "".
    CREATE di(NUM) TO 0.
    CREATE dv(TX) TO "".
    SEASON di < COUNT implicit,
        REAP dv FROM plant_list_get, implicit, di.
        SET dcode TO dcode + "  tx_t " + dv + " = \"\";\n".
        SET di TO di + 1.
    /SEASON.
    REAP bcode FROM generate_body, bd, 1, sigs, subst, plant_list_make(0), "", nums_m, stvars_m, evars_m, rty_m, "".
    IF (COUNT bd) IS 0,
        SET bcode TO "  return " + mname + ";\n".
    /IF.
    IF (COUNT bd) > 0,
        CREATE bd_count(NUM) TO COUNT bd.
        CREATE last_idx(NUM) TO bd_count - 1.
        CREATE last_nd(TX) TO plant_list_get(bd, last_idx).
        CREATE last_ty(TX) TO _map_get(last_nd, "type").
        IF last_ty ISNT "give_stmt", SET bcode TO bcode + "  return " + mname + ";\n". /IF.
    /IF.
    SET ccode TO ccode + dcode + bcode + "\}\n".
    GIVE ccode.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  find_params — look up a decl's params by name in sigs
# ──────────────────────────────────────────────────────────────
ACTION find_params(sigs(LIST), name(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE fp(LIST) TO plant_list_make(0).
    SEASON fi < COUNT sigs,
        REAP fe FROM plant_list_get, sigs, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, name) IS "1",
            REAP fp FROM _map_get, fe, "params".
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE fp.
/ACTION.

# find_ret — return type of a sig entry (by action name), or ""
ACTION find_ret(sigs(LIST), name(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE fr(TX) TO "".
    SEASON fi < COUNT sigs,
        REAP fe FROM plant_list_get, sigs, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, name) IS "1",
            REAP fr FROM _map_get, fe, "ret".
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE fr.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_ref_param — type string starts with "REF "
# ──────────────────────────────────────────────────────────────
ACTION is_ref_param(ptype(TX)),
    REAP pf FROM substring, ptype, 0, 4.
    IF pf IS "REF ", GIVE "1". /IF.
    GIVE "0".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_ref_at — params[idx] is a REF parameter
# ──────────────────────────────────────────────────────────────
ACTION is_ref_at(params(LIST), idx(NUM)),
    IF idx < COUNT params,
        REAP pel FROM plant_list_get, params, idx.
        REAP pty FROM _map_get, pel, "type".
        REAP rf FROM is_ref_param, pty.
        IF rf IS "1", GIVE "1". /IF.
    /IF.
    GIVE "0".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _map_get — safe MAP field access (external FFI)
# ──────────────────────────────────────────────────────────────
ACTION _map_get(m, key(TX)) -> external.
ACTION plant_list_get(lst, idx(NUM)) -> external.
ACTION char_at(s(TX), idx(NUM)) -> external.
ACTION substring(s(TX), start(NUM), end(NUM)) -> external.
ACTION find_any(s(TX), delims(TX)) -> external.
ACTION handle_brackets(expr(TX)) -> external.
ACTION handle_strcmp(expr(TX)) -> external.
ACTION str_eq(a(TX), b(TX)) -> external.

# ──────────────────────────────────────────────────────────────
#  find_node — AST action_decl node by name ("" if none)
# ──────────────────────────────────────────────────────────────
ACTION find_node(ast(LIST), name(TX)),
  CREATE fi(NUM) TO 0.
  CREATE fe(TX) TO "".
  CREATE fty(TX) TO "".
  CREATE fnm(TX) TO "".
  SEASON fi < COUNT ast,
    REAP fe FROM plant_list_get, ast, fi.
    REAP fty FROM _map_get, fe, "type".
    IF fty IS "action_decl",
      REAP fnm FROM _map_get, fe, "name".
      IF str_eq(fnm, name) IS "1", GIVE fe. /IF.
    /IF.
    SET fi TO fi + 1.
  /SEASON.
  GIVE "".
/ACTION.

# find_ext_node — locate an external_decl node by name (FFI
# signatures live on external_decl nodes, not action_decl)
ACTION find_ext_node(ast(LIST), name(TX)),
  CREATE fei(NUM) TO 0.
  CREATE fee(TX) TO "".
  CREATE fet(TX) TO "".
  CREATE fen(TX) TO "".
  SEASON fei < COUNT ast,
    REAP fee FROM plant_list_get, ast, fei.
    REAP fet FROM _map_get, fee, "type".
    IF fet IS "external_decl",
      REAP fen FROM _map_get, fee, "name".
      IF str_eq(fen, name) IS "1", GIVE fee. /IF.
    /IF.
    SET fei TO fei + 1.
  /SEASON.
  GIVE "".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  callees_of — flat list of action names invoked by a body:
#  REAP/START/ASYNC IN/AWAIT action fields plus "START name"
#  expressions inside SET/CREATE/etc. values. Recurses into
#  IF/SEASON/CYCLE/MATCH bodies. Callers must skip names that
#  aren't declared (module calls, external fns).
# ──────────────────────────────────────────────────────────────
ACTION callee_add(acc(LIST), name(TX)),
  CREATE cfound(NUM) TO 0.
  CREATE ci(NUM) TO 0.
  CREATE ce(TX) TO "".
  SEASON ci < COUNT acc,
    REAP ce FROM plant_list_get, acc, ci.
    IF str_eq(ce, name) IS "1", SET cfound TO 1. /IF.
    SET ci TO ci + 1.
  /SEASON.
  IF NOT cfound, PUT name INTO acc. /IF.
  GIVE acc.
/ACTION.

ACTION callee_from_value(acc(LIST), val(TX)),
  REAP v0 FROM substring, val, 0, 6.
  IF v0 IS "START ",
    REAP ve FROM substring, val, 6, LEN(val).
    REAP vcm FROM find_any, ve, ",".
    IF vcm IS -1,
      REAP vn0 FROM trim, ve.
      REAP acc FROM callee_add, acc, vn0.
    /IF.
    IF vcm ISNT -1,
      REAP vn1 FROM substring, ve, 0, vcm.
      REAP vn1b FROM trim, vn1.
      REAP acc FROM callee_add, acc, vn1b.
    /IF.
  /IF.
  GIVE acc.
/ACTION.

ACTION callees_of(bd(LIST)),
  CREATE acc(LIST) TO plant_list_make(0).
  CREATE ci(NUM) TO 0.
  CREATE cnd(TX) TO "".
  CREATE cty(TX) TO "".
  CREATE cact(TX) TO "".
  CREATE cval(TX) TO "".
  SEASON ci < COUNT bd,
    REAP cnd FROM plant_list_get, bd, ci.
    REAP cty FROM _map_get, cnd, "type".
    IF cty IS "reap_stmt" OR cty IS "start_stmt" OR cty IS "await_stmt",
      REAP cact FROM _map_get, cnd, "action".
      IF cact > "",
        REAP cact FROM strings:REPLACE, cact, ":", "_".
        REAP acc FROM callee_add, acc, cact.
      /IF.
    /IF.
    IF cty IS "set_stmt" OR cty IS "create_stmt" OR cty IS "let_stmt" OR cty IS "give_stmt" OR cty IS "show_stmt" OR cty IS "put_stmt" OR cty IS "cancel_stmt" OR cty IS "trace_stmt" OR cty IS "config_stmt",
      REAP cval FROM _map_get, cnd, "value".
      IF cval > "",
        REAP acc FROM callee_from_value, acc, cval.
      /IF.
    /IF.
    IF cty IS "if_stmt",
      REAP ib FROM _if_bodies, cnd.
      CREATE ii10(NUM) TO 0.
      SEASON ii10 < COUNT ib,
        REAP ibd10 FROM plant_list_get, ib, ii10.
        REAP cret2 FROM callees_of, ibd10.
        CREATE cj0(NUM) TO 0.
        CREATE cje0(TX) TO "".
        SEASON cj0 < COUNT cret2,
          REAP cje0 FROM plant_list_get, cret2, cj0.
          REAP acc FROM callee_add, acc, cje0.
          SET cj0 TO cj0 + 1.
        /SEASON.
        SET ii10 TO ii10 + 1.
      /SEASON.
    /IF.
    IF cty IS "season_stmt" OR cty IS "cycle_stmt" OR cty IS "match_stmt",
      REAP cbd2 FROM _map_get, cnd, "body".
      REAP cret2 FROM callees_of, cbd2.
      CREATE cj(NUM) TO 0.
      CREATE cje(TX) TO "".
      SEASON cj < COUNT cret2,
        REAP cje FROM plant_list_get, cret2, cj.
        REAP acc FROM callee_add, acc, cje.
        SET cj TO cj + 1.
      /SEASON.
    /IF.
    SET ci TO ci + 1.
  /SEASON.
  GIVE acc.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  async_reachable — BFS from "main": 1 if any reachable action
#  (via REAP/START/AWAIT/ASYNC IN calls) is an ASYNC ACTION.
#  Drives conditional plant_async_drain() injection in ACTION main.
# ──────────────────────────────────────────────────────────────
ACTION async_reachable(ast(LIST)),
  CREATE queue(LIST) TO plant_list_make(0).
  CREATE seen(LIST) TO plant_list_make(0).
  CREATE found(NUM) TO 0.
  PUT "main" INTO queue.
  CREATE qi(NUM) TO 0.
  CREATE front(TX) TO "".
  SEASON qi < COUNT queue,
    REAP front FROM plant_list_get, queue, qi.
    REAP sfound FROM list_contains, seen, front.
    IF sfound IS 0,
      REAP fnd FROM find_node, ast, front.
      IF fnd > "",
        REAP fas FROM _map_get, fnd, "async".
        IF fas IS "1", SET found TO 1. /IF.
        REAP fbod FROM _map_get, fnd, "body".
        REAP callers2 FROM callees_of, fbod.
        CREATE ck(NUM) TO 0.
        CREATE cke(TX) TO "".
        SEASON ck < COUNT callers2,
          REAP cke FROM plant_list_get, callers2, ck.
          REAP kf FROM list_contains, seen, cke.
          IF kf IS 0, PUT cke INTO queue. /IF.
          SET ck TO ck + 1.
        /SEASON.
      /IF.
      PUT front INTO seen.
    /IF.
    SET qi TO qi + 1.
  /SEASON.
  GIVE found.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  generate_c — main entry point
# ──────────────────────────────────────────────────────────────
ACTION generate_c(ast(LIST)),
    CREATE header(TX) TO "#include <plant_compat.h>\n\n".
    CREATE decl_code(TX) TO "".
    CREATE stmt_code(TX) TO "".
    CREATE has_decl(NUM) TO 0.
    CREATE has_stmt(NUM) TO 0.
    CREATE i(NUM) TO 0.
    CREATE node_el(TX) TO "".
    CREATE pro_code(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE param_el(TX) TO "".
    CREATE pname(TX) TO "".
    CREATE ptype(TX) TO "".
    CREATE ctype(TX) TO "".
    CREATE aname(TX) TO "".
    CREATE paramstr(TX) TO "".
    # pass 0: signature table (sigs) for REF-param call-site rewriting +
    # generic action template table (templates) + struct template table (structs)
    CREATE sigs(LIST) TO plant_list_make(0).
    CREATE templates(LIST) TO plant_list_make(0).
    CREATE structs(LIST) TO plant_list_make(0).
    CREATE eregs(LIST) TO build_enum_registry(ast).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl" OR ntype IS "external_decl",
            REAP aname FROM _map_get, node_el, "name".
            CREATE params2(LIST) TO _map_get(node_el, "params").
            CREATE rt2(TX) TO _map_get(node_el, "ret").
            CREATE vg2(TX) TO _map_get(node_el, "varargs").
            CREATE asy2(TX) TO _map_get(node_el, "async").
            PUT plant_list_make(12, "name", aname, "type", ntype, "params", params2, "ret", rt2, "varargs", vg2, "async", asy2) INTO sigs.
        /IF.
        IF ntype IS "action_decl",
            REAP aname FROM _map_get, node_el, "name".
            CREATE gens2(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens2 > 0,
                CREATE pms2(LIST) TO _map_get(node_el, "params").
                CREATE bd2(LIST) TO _map_get(node_el, "body").
                CREATE rt2b(TX) TO _map_get(node_el, "ret").
                PUT plant_list_make(10, "name", aname, "generics", gens2, "params", pms2, "body", bd2, "ret", rt2b) INTO templates.
            /IF.
        /IF.
        IF ntype IS "struct_decl",
            REAP sname FROM _map_get, node_el, "name".
            CREATE sgens2(LIST) TO _map_get(node_el, "generics").
            CREATE sfields2(LIST) TO _map_get(node_el, "fields").
            PUT plant_list_make(6, "name", sname, "generics", sgens2, "fields", sfields2) INTO structs.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 0f: FFI-extension externals (ffi_exts: STRUCT/CALLBACK/
    # void*/varargs signatures) + actions passed as callback args
    # (cb_acts — they get plant_cbw_<name> wrappers)
    CREATE ffi_exts(LIST) TO plant_list_make(0).
    CREATE cb_acts(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "external_decl",
            CREATE fparams7(LIST) TO _map_get(node_el, "params").
            CREATE fret7(TX) TO _map_get(node_el, "ret").
            CREATE fvg7(TX) TO _map_get(node_el, "varargs").
            CREATE ffi_ok(NUM) TO 0.
            IF fret7 > "", SET ffi_ok TO 1. /IF.
            IF fvg7 IS "1", SET ffi_ok TO 1. /IF.
            CREATE fai(NUM) TO 0.
            SEASON fai < COUNT fparams7,
                REAP fpel FROM plant_list_get, fparams7, fai.
                REAP fpty FROM _map_get, fpel, "type".
                REAP fk7 FROM ffi_param_kind, fpty.
                IF fk7 ISNT "plain", SET ffi_ok TO 1. /IF.
                SET fai TO fai + 1.
            /SEASON.
            IF ffi_ok IS 1,
                REAP anm7 FROM _map_get, node_el, "name".
                PUT anm7 INTO ffi_exts.
            /IF.
        /IF.
        IF ntype IS "action_decl",
            CREATE gsf(LIST) TO _map_get(node_el, "generics").
            IF COUNT gsf IS 0,
                CREATE bdf(LIST) TO _map_get(node_el, "body").
                REAP cb2 FROM collect_cb_uses, bdf, sigs, cb_acts.
                SET cb_acts TO cb2.
            /IF.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP cb3 FROM collect_cb_uses, plant_list_make(1, node_el), sigs, cb_acts.
            SET cb_acts TO cb3.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 0b: discover every reachable generic instantiation
    # (generic template bodies are walked per-instantiation inside
    # collect_insts with the proper type substitution, never bare)
    CREATE insts(LIST) TO plant_list_make(0).
    CREATE esub(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            CREATE gens5(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens5 IS 0,
                CREATE bd3(LIST) TO _map_get(node_el, "body").
                REAP insts FROM collect_insts, bd3, esub, templates, insts.
            /IF.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP insts FROM collect_insts, plant_list_make(1, node_el), esub, templates, insts.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 0c: discover every reachable struct instantiation from
    # type positions (params, struct fields, typed vars). Generic
    # struct templates are only scanned per-instantiation with the
    # substituted type context — never bare (avoids phantom T-typed
    # typedefs like plant_Box_T).
    CREATE structs_insts(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            CREATE gs5(LIST) TO _map_get(node_el, "generics").
            IF COUNT gs5 IS 0,
                CREATE ps5(LIST) TO _map_get(node_el, "params").
                CREATE bd5(LIST) TO _map_get(node_el, "body").
                REAP structs_insts FROM scan_params, ps5, esub, structs, structs_insts.
                REAP structs_insts FROM collect_struct_insts, bd5, esub, structs, structs_insts.
            /IF.
        /IF.
        IF ntype IS "external_decl",
            CREATE ps6(LIST) TO _map_get(node_el, "params").
            REAP structs_insts FROM scan_params, ps6, esub, structs, structs_insts.
        /IF.
        IF ntype IS "struct_decl",
            CREATE gs6(LIST) TO _map_get(node_el, "generics").
            IF COUNT gs6 IS 0,
                CREATE fs6(LIST) TO _map_get(node_el, "fields").
                REAP structs_insts FROM scan_fields, fs6, esub, structs, structs_insts.
            /IF.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP structs_insts FROM collect_struct_insts, plant_list_make(1, node_el), esub, structs, structs_insts.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # per-instantiation struct scans: generic action templates with
    # the substituted type context of each discovered instantiation
    SET i TO 0.
    SEASON i < COUNT insts,
        REAP node_el FROM plant_list_get, insts, i.
        REAP ibase FROM base_of, node_el.
        REAP iargs FROM parse_type_args, node_el.
        REAP itpl FROM find_template, templates, ibase.
        IF COUNT itpl > 0,
            REAP igns FROM _map_get, itpl, "generics".
            REAP insub FROM build_subst, igns, iargs.
            REAP ipms FROM _map_get, itpl, "params".
            REAP ibd FROM _map_get, itpl, "body".
            REAP structs_insts FROM scan_params, ipms, insub, structs, structs_insts.
            REAP structs_insts FROM collect_struct_insts, ibd, insub, structs, structs_insts.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # struct typedefs: plain templates + every instantiation, emitted
    # right after the includes so C FFI code can use them. The block
    # is bracketed by markers so run_native_tests.sh can extract it
    # into a header for mock_ffi.c (-include).
    CREATE struct_code(TX) TO "/*__PLANT_TYPES_BEGIN__*/\n#ifndef PLANT_TYPES_INCLUDED\n#define PLANT_TYPES_INCLUDED\n".
    # enum typedefs live in the shared types block (extracted into
    # the mock-FFI header), so both the generated C and the mock can
    # reference enum member constants — e.g. mock struct constructors
    # that fill enum fields (v0.48.10).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "enum_decl",
            REAP nd_code FROM generate_node, node_el, 0, sigs, esub, plant_list_make(0), "", plant_list_make(0), plant_list_make(0), eregs, "", "". "".
            SET struct_code TO struct_code + nd_code.
        /IF.
        SET i TO i + 1.
    /SEASON.
    CREATE ffi_tentries(LIST) TO plant_list_make(0).
    CREATE ffi_torder(LIST) TO plant_list_make(0).
    CREATE tscnX(TX) TO "".
    CREATE tstdef(TX) TO "".
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "struct_decl",
            CREATE sgens4(LIST) TO _map_get(node_el, "generics").
            IF COUNT sgens4 IS 0,
                REAP sname4 FROM _map_get, node_el, "name".
                REAP scn4 FROM ffi_struct_cname, sname4.
                CREATE eargs(LIST) TO plant_list_make(0).
                REAP stdef FROM struct_typedef, node_el, eargs.
                CREATE sfldsT(LIST) TO struct_fields_at(node_el, eargs).
                CREATE enT(LIST) TO plant_list_make(0).
                PUT "scn" INTO enT.
                PUT scn4 INTO enT.
                PUT "flds" INTO enT.
                PUT sfldsT INTO enT.
                PUT "stdef" INTO enT.
                PUT stdef INTO enT.
                PUT enT INTO ffi_tentries.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT structs_insts,
        REAP node_el FROM plant_list_get, structs_insts, i.
        REAP ibase FROM base_of, node_el.
        REAP ibtrim FROM trim, ibase.
        REAP iargs FROM parse_type_args, node_el.
        REAP itpl FROM find_struct, structs, ibtrim.
        IF COUNT itpl > 0,
            REAP scnA FROM ffi_struct_cname, node_el.
            REAP stdef FROM struct_typedef, itpl, iargs.
            CREATE sfldsT(LIST) TO struct_fields_at(itpl, iargs).
            CREATE enT(LIST) TO plant_list_make(0).
            PUT "scn" INTO enT.
            PUT scnA INTO enT.
            PUT "flds" INTO enT.
            PUT sfldsT INTO enT.
            PUT "stdef" INTO enT.
            PUT stdef INTO enT.
            PUT enT INTO ffi_tentries.
        /IF.
        SET i TO i + 1.
    /SEASON.
    REAP ffi_torder FROM ffi_topo_order, ffi_tentries.
    SET i TO 0.
    SEASON i < COUNT ffi_torder,
        REAP node_el FROM plant_list_get, ffi_torder, i.
        REAP tscnX FROM _map_get, node_el, "scn".
        SET struct_code TO struct_code + "#define PLANT_STRUCT_" + tscnX + " 1\n".
        REAP tstdef FROM _map_get, node_el, "stdef".
        SET struct_code TO struct_code + tstdef.
        SET i TO i + 1.
    /SEASON.
    # FFI-extension prototypes (STRUCT/CALLBACK/void*/varargs sigs) —
    # the mock defines matching functions; plain externals keep the
    # hand-written mock_ffi.h prototypes (no duplicates).
    CREATE ffi_has_cb(NUM) TO 0.
    CREATE ffi_has_vp(NUM) TO 0.
    CREATE ffi_has_va(NUM) TO 0.
    SET i TO 0.
    SEASON i < COUNT ffi_exts,
        REAP fex FROM plant_list_get, ffi_exts, i.
        REAP fnode FROM find_ext_node, ast, fex.
        IF COUNT fnode > 0,
            CREATE fpars(LIST) TO _map_get(fnode, "params").
            CREATE fret2(TX) TO _map_get(fnode, "ret").
            CREATE fvga(TX) TO _map_get(fnode, "varargs").
            REAP fretc FROM ffi_ret_ctype, fret2.
            CREATE fexneed(NUM) TO 0.
            REAP fkr2 FROM ffi_param_kind, fret2.
            IF fkr2 IS "plain", SET fexneed TO 0. /IF.
            IF fkr2 IS "struct_val", SET fexneed TO 1. /IF.
            IF fkr2 IS "struct_ref", SET fexneed TO 1. /IF.
            IF fkr2 IS "callback", SET fexneed TO 1. /IF.
            IF fkr2 IS "voidptr", SET fexneed TO 1. /IF.
            CREATE fci(NUM) TO 0.
            CREATE fcel(TX) TO "".
            SEASON fci < COUNT fpars,
                REAP fcel FROM plant_list_get, fpars, fci.
                REAP fcnx FROM _map_get, fcel, "name".
                REAP fct2 FROM _map_get, fcel, "type".
                REAP fccx FROM ffi_ctype, fct2.
                REAP fk9 FROM ffi_param_kind, fct2.
                IF fk9 IS "callback", SET ffi_has_cb TO 1. /IF.
                IF fk9 IS "voidptr", SET ffi_has_vp TO 1. /IF.
                IF fk9 IS "struct_val", SET fexneed TO 1. /IF.
                IF fk9 IS "struct_ref", SET fexneed TO 1. /IF.
                IF fk9 IS "callback", SET fexneed TO 1. /IF.
                IF fk9 IS "voidptr", SET fexneed TO 1. /IF.
                SET fci TO fci + 1.
            /SEASON.
            IF fvga IS "1",
                SET ffi_has_va TO 1.
                SET fexneed TO 1.
            /IF.
            # Only emit prototypes that mock_ffi.h does NOT already
            # cover: struct/callback/void*/varargs signatures. Plain
            # externs keep the hand-written prototypes (their C types
            # are mock-specific, e.g. `long` for Result<NUM,TX>).
            IF fexneed IS 1,
                SET struct_code TO struct_code + fretc + " " + fex + "(".
                SET fci TO 0.
                SEASON fci < COUNT fpars,
                    REAP fcel FROM plant_list_get, fpars, fci.
                    REAP fcnx FROM _map_get, fcel, "name".
                    REAP fct2 FROM _map_get, fcel, "type".
                    REAP fccx FROM ffi_ctype, fct2.
                    IF fci > 0, SET struct_code TO struct_code + ", ". /IF.
                    SET struct_code TO struct_code + fccx + " " + fcnx.
                    SET fci TO fci + 1.
                /SEASON.
                IF fvga IS "1",
                    SET struct_code TO struct_code + ", ...".
                /IF.
                SET struct_code TO struct_code + ");\n".
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    IF ffi_has_cb IS 1, SET struct_code TO struct_code + "#define PLANT_FFI_HAS_CALLBACKS 1\n". /IF.
    IF ffi_has_vp IS 1, SET struct_code TO struct_code + "#define PLANT_FFI_HAS_VOIDPTR 1\n". /IF.
    IF ffi_has_va IS 1, SET struct_code TO struct_code + "#define PLANT_FFI_HAS_VARARGS 1\n". /IF.
    SET struct_code TO struct_code + "#endif\n/*__PLANT_TYPES_END__*/\n\n".
    # FFI conversion helpers for every reachable struct type:
    # plant_map_to_X / plant_map_to_ref_X / plant_struct_alloc_copy_X /
    # plant_X_to_map. Emitted in dependency order (topo) so nested
    # struct fields can reference each other's helpers.
    CREATE ffi_entries(LIST) TO plant_list_make(0).
    CREATE ffi_topo(TX) TO "".
    CREATE enA(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "struct_decl",
            CREATE sgensQ(LIST) TO _map_get(node_el, "generics").
            IF COUNT sgensQ IS 0,
                REAP snameQ FROM _map_get, node_el, "name".
                CREATE eargsQ(LIST) TO plant_list_make(0).
                REAP scnA FROM ffi_struct_cname, snameQ.
                CREATE sfldsA(LIST) TO struct_fields_at(node_el, eargsQ).
                CREATE enA(LIST) TO plant_list_make(0).
                PUT "scn" INTO enA.
                PUT scnA INTO enA.
                PUT "flds" INTO enA.
                PUT sfldsA INTO enA.
                PUT enA INTO ffi_entries.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT structs_insts,
        REAP node_el FROM plant_list_get, structs_insts, i.
        REAP ibase2 FROM base_of, node_el.
        REAP ibtrim2 FROM trim, ibase2.
        REAP iargs2 FROM parse_type_args, node_el.
        REAP itpl2 FROM find_struct, structs, ibtrim2.
        IF COUNT itpl2 > 0,
            REAP scnB FROM ffi_struct_cname, node_el.
            CREATE sfldsB(LIST) TO struct_fields_at(itpl2, iargs2).
            CREATE enA(LIST) TO plant_list_make(0).
            PUT "scn" INTO enA.
            PUT scnB INTO enA.
            PUT "flds" INTO enA.
            PUT sfldsB INTO enA.
            PUT enA INTO ffi_entries.
        /IF.
        SET i TO i + 1.
    /SEASON.
    REAP ffi_topo FROM ffi_topo_emit_helpers, ffi_entries.
    # callback wrappers: static tx_t plant_cbw_<name>(long ctx,
    # tx_t val) { return <name>(...); } for every ACTION passed as a
    # CALLBACK argument (ABI: ctx is the ensure-token, val the call
    # value). A 2-param action maps (ctx → p0, val → p1); a 1-param
    # action gets val; 0 params gets a plain call.
    CREATE cb_code(TX) TO "".
    CREATE cbnode(LIST) TO plant_list_make(0).
    CREATE cbprms(LIST) TO plant_list_make(0).
    CREATE cbp(TX) TO "".
    CREATE cbt(TX) TO "".
    CREATE cbtk(TX) TO "".
    CREATE cbcn(TX) TO "".
    CREATE cbak(NUM) TO 0.
    CREATE cbcast(TX) TO "".
    SET i TO 0.
    SEASON i < COUNT cb_acts,
        REAP cba FROM plant_list_get, cb_acts, i.
        REAP cbnode FROM find_node, ast, cba.
        CREATE cbprms(LIST) TO _map_get(cbnode, "params").
        SET cbcn TO cba + "(".
        SET cbak TO 0.
        SEASON cbak < COUNT cbprms,
            REAP cbp FROM plant_list_get, cbprms, cbak.
            REAP cbt FROM _map_get, cbp, "type".
            REAP cbtk FROM ffi_param_kind, cbt.
            SET cbcast TO "".
            IF cbtk IS "plain" AND cbt IS "NUM", SET cbcast TO "(long)(intptr_t)". /IF.
            IF cbtk IS "plain" AND cbt IS "FACT", SET cbcast TO "(int)(intptr_t)". /IF.
            IF cbak > 0, SET cbcn TO cbcn + ", ". /IF.
            IF cbak IS 0 AND COUNT cbprms IS 1,
                SET cbcn TO cbcn + cbcast + "val".
            /IF.
            IF cbak IS 0 AND COUNT cbprms IS 2,
                SET cbcn TO cbcn + cbcast + "ctx".
            /IF.
            IF cbak IS 1,
                SET cbcn TO cbcn + cbcast + "val".
            /IF.
            SET cbak TO cbak + 1.
        /SEASON.
        SET cbcn TO cbcn + ")".
        SET cb_code TO cb_code + "static tx_t plant_cbw_" + cba + "(long ctx, tx_t val) { return " + cbcn + "; }\n".
        SET i TO i + 1.
    /SEASON.
    IF COUNT cb_acts > 0, SET cb_code TO cb_code + "\n". /IF.
    # v0.48.15: top-level MISSION CONFIG stmts force a wrapper main; a
    # plain ACTION main() is then emitted as plant_main() and invoked
    # by the wrapper so the config keys apply before any FAST heap use
    # (avoids the int-main/tx_t-main type clash in the generated C).
    CREATE has_cfg(TX) TO "0".
    CREATE has_plain_main(TX) TO "0".
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP ce_nd FROM plant_list_get, ast, i.
        REAP ce_ty FROM _map_get, ce_nd, "type".
        IF ce_ty IS "config_stmt", SET has_cfg TO "1". /IF.
        IF ce_ty IS "action_decl",
            REAP ce_nm FROM _map_get, ce_nd, "name".
            REAP ce_as FROM _map_get, ce_nd, "async".
            IF ce_nm IS "main" AND ce_as ISNT "1", SET has_plain_main TO "1". /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 1: forward declarations for every non-generic action_decl +
    # every monomorphized instantiation
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            REAP aname FROM _map_get, node_el, "name".
            CREATE gens3(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens3 IS 0,
                CREATE params3(LIST) TO _map_get(node_el, "params").
                REAP asymark FROM _map_get, node_el, "async".
                SET paramstr TO "".
                SET pi TO 0.
                SEASON pi < COUNT params3,
                    REAP param_el FROM plant_list_get, params3, pi.
                    REAP pname FROM _map_get, param_el, "name".
                    REAP ptype FROM _map_get, param_el, "type".
                    REAP ctype FROM ffi_ctype, ptype.
                    IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
                    SET paramstr TO paramstr + ctype + " " + pname.
                    SET pi TO pi + 1.
                /SEASON.
                IF asymark IS "1",
                    SET pro_code TO pro_code + "tx_t " + aname + "(tx_t __parent, tx_t __ctx".
                    IF paramstr > "", SET pro_code TO pro_code + ", " + paramstr. /IF.
                    SET pro_code TO pro_code + ");\n".
                /IF.
                IF asymark ISNT "1",
                    IF aname IS "main" AND has_cfg IS "1",
                        SET pro_code TO pro_code + "tx_t plant_main(" + paramstr + ");\n".
                    /IF.
                    IF aname ISNT "main" OR has_cfg ISNT "1",
                        SET pro_code TO pro_code + "tx_t " + aname + "(" + paramstr + ");\n".
                    /IF.
                /IF.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT insts,
        REAP node_el FROM plant_list_get, insts, i.
        REAP inst_code FROM inst_fwddecl, node_el, templates.
        SET pro_code TO pro_code + inst_code.
        SET i TO i + 1.
    /SEASON.
    # pass 0d: closure discovery — stamps closure nodes in place and
    # builds the per-action clmap table + the ordered closure list;
    # env typedefs and closure fn forwards/definitions go into
    # pro_code before the ACTION definitions so all calls resolve.
    REAP clres FROM collect_closures, ast, sigs.
    REAP clmaps FROM plant_list_get, clres, 0.
    REAP cllist FROM plant_list_get, clres, 1.
    CREATE cltype_code(TX) TO "".
    CREATE clfwd_code(TX) TO "".
    CREATE cldef_code(TX) TO "".
    # enum typedefs now live in the shared types block (struct_code),
    # before every consumer — closure defs, action defs, mock FFI.
    SET i TO 0.
    SEASON i < COUNT cllist,
        REAP cnode FROM plant_list_get, cllist, i.
        REAP tc FROM _cl_emit_typedef, cnode.
        SET cltype_code TO cltype_code + tc + "".
        REAP fnn FROM _map_get, cnode, "fnname".
        REAP cprm FROM _map_get, cnode, "params".
        REAP pstr2 FROM _cl_param_str, cprm.
        SET clfwd_code TO clfwd_code + "tx_t " + fnn + "(tx_t env".
        IF pstr2 > "", SET clfwd_code TO clfwd_code + ", " + pstr2. /IF.
        SET clfwd_code TO clfwd_code + ");\n".
        REAP fd FROM _cl_emit_fn, cnode, sigs, esub, eregs.
        SET cldef_code TO cldef_code + fd + "".
        SET i TO i + 1.
    /SEASON.
    CREATE implicit(LIST) TO collect_implicit(ast, plant_list_make(0)).
    CREATE dcode(TX) TO "".
    CREATE di(NUM) TO 0.
    CREATE dv(TX) TO "".
    SEASON di < COUNT implicit,
        REAP dv FROM plant_list_get, implicit, di.
        SET dcode TO dcode + "  tx_t " + dv + " = \"\";\n".
        SET di TO di + 1.
    /SEASON.
    # pass 2b: async reachability from ACTION main() — if any
    # action in main's call graph is an ASYNC ACTION, stamp main
    # with drain_after so generate_node emits plant_async_drain()
    # at the end of the C main() entry (v0.48.3a).
    CREATE drn_main(NUM) TO async_reachable(ast).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            CREATE gens4(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens4 IS 0,
                REAP aname FROM _map_get, node_el, "name".
                REAP asy4 FROM _map_get, node_el, "async".
                CREATE node_el2(TX) TO node_el.
                IF str_eq(aname, "main") IS "1" AND drn_main IS 1 AND asy4 ISNT "1",
                    REAP node_el2 FROM map_add, node_el, "drain_after", "1".
                /IF.
                IF str_eq(aname, "main") IS "1" AND has_cfg IS "1" AND asy4 ISNT "1",
                    REAP node_el2 FROM map_add, node_el2, "main_rename", "1".
                /IF.
                REAP cmact FROM _cl_map_get, clmaps, aname.
                REAP nd_code FROM generate_node, node_el2, 0, sigs, esub, cmact, "", plant_list_make(0), plant_list_make(0), eregs, "", "".
                SET decl_code TO decl_code + nd_code.
                SET has_decl TO 1.
            /IF.
        /IF.
        IF ntype IS "enum_decl",
            SET has_decl TO 1.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP ns_code FROM generate_node, node_el, 0, sigs, esub, plant_list_make(0), "", plant_list_make(0), plant_list_make(0), eregs, "", "". "".
            SET stmt_code TO stmt_code + ns_code.
            SET has_stmt TO 1.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 3: definitions of every monomorphized instantiation
    SET i TO 0.
    SEASON i < COUNT insts,
        REAP node_el FROM plant_list_get, insts, i.
        REAP nd_code FROM emit_inst, node_el, templates, sigs, eregs.
        SET decl_code TO decl_code + nd_code.
        SET has_decl TO 1.
        SET i TO i + 1.
    /SEASON.
    IF has_stmt,
        IF has_plain_main IS "1",
            SET stmt_code TO stmt_code + "  plant_main();\n".
        /IF.
        SET stmt_code TO "int main(int argc, char **argv) {\n  plant_init_cli(argc, argv);\n" + dcode + stmt_code + "  plant_async_drain();\n  return 0;\n}\n".
    /IF.
    GIVE header + struct_code + ffi_topo + cltype_code + pro_code + cb_code + clfwd_code + "\n" + cldef_code + "\n" + decl_code + stmt_code.
/ACTION.

# ═══════════════════════════════════════════════════════════════
#  Closures Engine — v0.48.2
#
#  Pass 0d runs in generate_c: collect_closures(ast) walks every
#  non-generic ACTION body with a scope stack (params + locals +
#  implicit vars) and stamps each closure node in place:
#    cid      — unique closure index N
#    envname  — plant_Env_N          (env struct typedef name)
#    fnname   — plant_Closure_N_fn   (C function name)
#    captures — flat [name, initCexpr, …]  (create-site assignments)
#    moved    — list of MOVE names (outer var cleared after create)
#    shadows  — list of 6-key maps (name, ctype, mode) driving the
#               closure fn's local shadows + env struct fields
#    clmap    — flat [varname, closurenode, …] of closures created
#               directly inside this closure's own body
#  Returns [clmaps, cllist]; clmaps is flat [actionname, clmap, …]
#  and cllist holds every closure node in discovery order.
#  Env typedefs + closure fn forwards + definitions are emitted
#  into pro_code (before the ACTION definitions) so calls resolve.
# ═══════════════════════════════════════════════════════════════

# _cl_is_arg — "1" when a reap argument is a @@CLOSURE@@ placeholder
ACTION _cl_is_arg(arg(TX)),
    REAP pre FROM substring, arg, 0, 11.
    IF pre IS "@@CLOSURE@@", GIVE "1". /IF.
    GIVE "0".
/ACTION.

# _cl_map_get — flat-pairs lookup: value for key, or ""
ACTION _cl_map_get(clmap(LIST), key(TX)),
    CREATE mi2(NUM) TO 0.
    CREATE me2(TX) TO "".
    SEASON mi2 < COUNT clmap,
        REAP me2 FROM plant_list_get, clmap, mi2.
        IF str_eq(me2, key) IS "1",
            REAP mret FROM plant_list_get, clmap, mi2 + 1.
            GIVE mret.
        /IF.
        SET mi2 TO mi2 + 2.
    /SEASON.
    GIVE "".
/ACTION.

# is_prim_type — "1" when a PlantLang type is a built-in scalar
# (NUM/FACT/TX/LIST/STRING/DOUBLE/JSON/SET/QUEUE/STACK/BYTES/FUNC);
# "0" for enum/struct/generic/REF types. Closure scopes skip the
# "#t" twin keys for primitives since only enum/struct types can
# carry enum values (v0.48.11).
ACTION is_prim_type(ptype(TX)),
  REAP pb FROM type_base, ptype.
  REAP pbt FROM trim, pb.
  IF pbt IS "NUM", GIVE "1". /IF.
  IF pbt IS "FACT", GIVE "1". /IF.
  IF pbt IS "LIST", GIVE "1". /IF.
  IF pbt IS "TX", GIVE "1". /IF.
  IF pbt IS "STRING", GIVE "1". /IF.
  IF pbt IS "DOUBLE", GIVE "1". /IF.
  IF pbt IS "JSON", GIVE "1". /IF.
  IF pbt IS "SET", GIVE "1". /IF.
  IF pbt IS "QUEUE", GIVE "1". /IF.
  IF pbt IS "STACK", GIVE "1". /IF.
  IF pbt IS "BYTES", GIVE "1". /IF.
  IF pbt IS "FUNC", GIVE "1". /IF.
  GIVE "0".
/ACTION.

# _cl_ccache_get — look up a resolved "ctype;prim" pair for a type
# in the per-scope cache (flat triples [type, ctype, prim]); "" on
# miss. Repeated types within one scope share one resolution
# instead of recomputing plant_ctype/is_prim_type (v0.48.11).
ACTION _cl_ccache_get(cache(LIST), t(TX)),
  CREATE ci(NUM) TO 0.
  CREATE ck(TX) TO "".
  CREATE cv(TX) TO "".
  CREATE cp(TX) TO "".
  SEASON ci + 2 < COUNT cache,
    REAP ck FROM plant_list_get, cache, ci.
    REAP cv FROM plant_list_get, cache, ci + 1.
    REAP cp FROM plant_list_get, cache, ci + 2.
    IF str_eq(ck, t) IS "1",
      GIVE cv + ";" + cp.
    /IF.
    SET ci TO ci + 3.
  /SEASON.
  GIVE "".
/ACTION.

# _cl_scopes — extend a scope stack with the declarations a
# statement list introduces (create/let locals, reap targets,
# cycle iterators, match bindings). sigs resolves reap targets to
# their callee return type for the "#t" twin keys (v0.48.10).
# Type resolution for create/let is memoized per call and the "#t"
# twin keys are skipped for primitive types (v0.48.11).
ACTION _cl_scopes(bd(LIST), scopes(LIST), sigs(LIST)),
    CREATE n2(NUM) TO 0.
    CREATE st(TX) TO "".
    CREATE res(LIST) TO scopes.
    CREATE cch(LIST) TO plant_list_make(0).
    SEASON n2 < COUNT bd,
        REAP st FROM plant_list_get, bd, n2.
        REAP sty FROM _map_get, st, "type".
        IF sty IS "create_stmt",
            REAP stg FROM _map_get, st, "target".
            REAP stv FROM _map_get, st, "var_type".
            REAP ccv FROM _cl_ccache_get, cch, stv.
            IF ccv IS "",
                REAP stc FROM plant_ctype, stv.
                REAP spr FROM is_prim_type, stv.
                IF COUNT cch < 36,
                    PUT stv INTO cch.
                    PUT stc INTO cch.
                    PUT spr INTO cch.
                /IF.
            /IF.
            IF ccv ISNT "",
                REAP ccparts FROM strings:SPLIT, ccv, ";".
                REAP stc FROM plant_list_get, ccparts, 0.
                REAP spr FROM plant_list_get, ccparts, 1.
            /IF.
            PUT stg INTO res.
            PUT stc INTO res.
            IF spr IS "0",
                PUT stg + "#t" INTO res.
                PUT stv INTO res.
            /IF.
        /IF.
        IF sty IS "let_stmt",
            REAP stg FROM _map_get, st, "target".
            REAP stv FROM _map_get, st, "var_type".
            REAP ccv FROM _cl_ccache_get, cch, stv.
            IF ccv IS "",
                REAP stc FROM plant_ctype, stv.
                REAP spr FROM is_prim_type, stv.
                IF COUNT cch < 36,
                    PUT stv INTO cch.
                    PUT stc INTO cch.
                    PUT spr INTO cch.
                /IF.
            /IF.
            IF ccv ISNT "",
                REAP ccparts FROM strings:SPLIT, ccv, ";".
                REAP stc FROM plant_list_get, ccparts, 0.
                REAP spr FROM plant_list_get, ccparts, 1.
            /IF.
            PUT stg INTO res.
            PUT stc INTO res.
            IF spr IS "0",
                PUT stg + "#t" INTO res.
                PUT stv INTO res.
            /IF.
        /IF.
        IF sty IS "reap_stmt",
            REAP stg FROM _map_get, st, "target".
            IF stg ISNT "_",
                REAP oldc FROM _cl_map_get, res, stg.
                IF oldc IS "",
                    PUT stg INTO res.
                    PUT "tx_t" INTO res.
                    REAP stact FROM _map_get, st, "action".
                    REAP stbs FROM base_of, stact.
                    REAP stre FROM find_ret, sigs, stbs.
                    IF stre > "",
                        PUT stg + "#t" INTO res.
                        PUT stre INTO res.
                    /IF.
                /IF.
            /IF.
        /IF.
        IF sty IS "cycle_stmt",
            REAP iv FROM _map_get, st, "iterVar".
            REAP le FROM _map_get, st, "listExpr".
            IF le > "",
                PUT iv INTO res.
                PUT "tx_t" INTO res.
            /IF.
            IF le IS "",
                PUT iv INTO res.
                PUT "long" INTO res.
            /IF.
        /IF.
        IF sty IS "match_stmt",
            REAP mcl FROM _map_get, st, "clauses".
            CREATE mn2(NUM) TO 0.
            CREATE mel(TX) TO "".
            SEASON mn2 < COUNT mcl,
                REAP mel FROM plant_list_get, mcl, mn2.
                REAP mb FROM _map_get, mel, "binding".
                IF mb > "" AND mb ISNT "null",
                    PUT mb INTO res.
                    PUT "tx_t" INTO res.
                /IF.
                SET mn2 TO mn2 + 1.
            /SEASON.
        /IF.
        SET n2 TO n2 + 1.
    /SEASON.
    GIVE res.
/ACTION.

# _cl_stamp_cnode — resolve a closure node's captures against the
# enclosing scope, recurse into its own body, stamp cid/envname/
# fnname/captures/moved/shadows/clmap keys in place, append it to
# the closure sequence. Returns [clseq, cid].
ACTION _cl_stamp_cnode(cnode(LIST), scopes(LIST), cc(NUM), res(LIST), sigs(LIST)),
    REAP cnp FROM _map_get, cnode, "params".
    REAP cnb FROM _map_get, cnode, "body".
    REAP ccap FROM _map_get, cnode, "captures".
    CREATE cid3(TX) TO _from_long(cc).
    CREATE envn3(TX) TO "plant_Env_" + cid3.
    CREATE fnn3(TX) TO "plant_Closure_" + cid3 + "_fn".
    CREATE capsflat(LIST) TO plant_list_make(0).
    CREATE moved3(LIST) TO plant_list_make(0).
    CREATE shads3(LIST) TO plant_list_make(0).
    CREATE cpsc(LIST) TO plant_list_make(0).
    # closure params are in scope inside the closure body
    CREATE cpi3(NUM) TO 0.
    CREATE cpe3(TX) TO "".
    SEASON cpi3 < COUNT cnp,
        REAP cpe3 FROM plant_list_get, cnp, cpi3.
        REAP cpn3 FROM _map_get, cpe3, "name".
        REAP cpt3 FROM _map_get, cpe3, "type".
        REAP cct3 FROM plant_ctype, cpt3.
        PUT cpn3 INTO cpsc.
        PUT cct3 INTO cpsc.
        REAP cpr3 FROM is_prim_type, cpt3.
        IF cpr3 IS "0",
            PUT cpn3 + "#t" INTO cpsc.
            PUT cpt3 INTO cpsc.
        /IF.
        SET cpi3 TO cpi3 + 1.
    /SEASON.
    # resolve each capture against the enclosing scope
    CREATE cci3(NUM) TO 0.
    CREATE cce3(TX) TO "".
    SEASON cci3 < COUNT ccap,
        REAP cce3 FROM plant_list_get, ccap, cci3.
        REAP capn3 FROM _map_get, cce3, "name".
        REAP capm3 FROM _map_get, cce3, "mode".
        REAP capct FROM _cl_map_get, scopes, capn3.
        IF capct IS "",
            SET capct TO "tx_t".
        /IF.
        REAP capty FROM _cl_map_get, scopes, capn3 + "#t".
        IF capty IS "",
            SET capty TO capct.
        /IF.
        IF str_eq(capm3, "MOVE") IS "1",
            PUT capn3 INTO capsflat.
            PUT capn3 INTO capsflat.
            PUT capn3 INTO moved3.
        /IF.
        IF str_eq(capm3, "REF") IS "1",
            PUT capn3 INTO capsflat.
            PUT "&" + capn3 INTO capsflat.
        /IF.
        PUT plant_list_make(8, "name", capn3, "ctype", capct, "mode", capm3, "ptype", capty) INTO shads3.
        PUT capn3 INTO cpsc.
        PUT capct INTO cpsc.
        PUT capn3 + "#t" INTO cpsc.
        PUT capty INTO cpsc.
        SET cci3 TO cci3 + 1.
    /SEASON.
    # nested closures inside this closure's own body (block form only;
    # expr bodies are plain text and contain no statements)
    CREATE cmap3(LIST) TO plant_list_make(0).
    CREATE cck(NUM) TO cc + 1.
    REAP cnk FROM _map_get, cnode, "bkind".
    IF str_eq(cnk, "block") IS "1",
        REAP cres FROM _cl_walk, cnb, cpsc, res, plant_list_make(0), cc + 1, sigs.
        REAP res FROM plant_list_get, cres, 0.
        REAP cmap3 FROM plant_list_get, cres, 1.
        REAP cck FROM plant_list_get, cres, 2.
    /IF.
    # stamp the closure node in place
    PUT "cid" INTO cnode.
    PUT cid3 INTO cnode.
    PUT "envname" INTO cnode.
    PUT envn3 INTO cnode.
    PUT "fnname" INTO cnode.
    PUT fnn3 INTO cnode.
    PUT "clcaps" INTO cnode.
    PUT capsflat INTO cnode.
    PUT "moved" INTO cnode.
    PUT moved3 INTO cnode.
    PUT "shadows" INTO cnode.
    PUT shads3 INTO cnode.
    PUT "clmap" INTO cnode.
    PUT cmap3 INTO cnode.
    PUT cnode INTO res.
    GIVE plant_list_make(2, res, cck).
/ACTION.

# _cl_walk — walk one statement list, stamping closures in place.
# scopes: flat [name, ctype, …] of the current C function scope.
# Returns the accumulator triple [clseq, clmap, cid].
ACTION _cl_walk(bd(LIST), scopes(LIST), clseq(LIST), clmap(LIST), cid(NUM), sigs(LIST)),
    CREATE n3(NUM) TO 0.
    CREATE st3(TX) TO "".
    CREATE res(LIST) TO clseq.
    CREATE rmap(LIST) TO clmap.
    CREATE cc(NUM) TO cid.
    SEASON n3 < COUNT bd,
        REAP st3 FROM plant_list_get, bd, n3.
        REAP sty3 FROM _map_get, st3, "type".
        REAP sc3 FROM _cl_scopes, plant_list_make(1, st3), scopes, sigs.
        # create_stmt / let_stmt carrying a closure node
        REAP cnode3 FROM _map_get, st3, "closure".
        IF cnode3 > "",
            REAP tgt3 FROM _map_get, st3, "target".
            REAP cres FROM _cl_stamp_cnode, cnode3, sc3, cc, res, sigs.
            REAP res FROM plant_list_get, cres, 0.
            REAP cc FROM plant_list_get, cres, 1.
            PUT tgt3 INTO rmap.
            PUT cnode3 INTO rmap.
        /IF.
        # inline closure arguments of reap statements are stamped too
        # (their envs are built inline at the call site)
        IF sty3 IS "reap_stmt",
            REAP cla3 FROM _map_get, st3, "clargs".
            IF cla3 > "",
                CREATE clai(NUM) TO 0.
                CREATE clae(TX) TO "".
                SEASON clai < COUNT cla3,
                    REAP clae FROM plant_list_get, cla3, clai.
                    REAP cres FROM _cl_stamp_cnode, clae, sc3, cc, res, sigs.
                    REAP res FROM plant_list_get, cres, 0.
                    REAP cc FROM plant_list_get, cres, 1.
                    SET clai TO clai + 1.
                /SEASON.
            /IF.
        /IF.
        # recurse into nested bodies (same scope + their own locals);
        # if_stmt branches are walked uniformly via _if_bodies (v0.48.20)
        IF sty3 ISNT "if_stmt",
            REAP bd3 FROM _map_get, st3, "body".
            IF bd3 > "",
                REAP scn FROM _cl_scopes, bd3, sc3, sigs.
                REAP cres FROM _cl_walk, bd3, scn, res, rmap, cc, sigs.
                REAP res FROM plant_list_get, cres, 0.
                REAP rmap FROM plant_list_get, cres, 1.
                REAP cc FROM plant_list_get, cres, 2.
            /IF.
        /IF.
        IF sty3 IS "if_stmt",
            REAP ib3 FROM _if_bodies, st3.
            CREATE ibi3(NUM) TO 0.
            SEASON ibi3 < COUNT ib3,
                REAP ibd5 FROM plant_list_get, ib3, ibi3.
                REAP scn FROM _cl_scopes, ibd5, sc3, sigs.
                REAP cres FROM _cl_walk, ibd5, scn, res, rmap, cc, sigs.
                REAP res FROM plant_list_get, cres, 0.
                REAP rmap FROM plant_list_get, cres, 1.
                REAP cc FROM plant_list_get, cres, 2.
                SET ibi3 TO ibi3 + 1.
            /SEASON.
        /IF.
        IF sty3 IS "match_stmt",
            REAP mcl3 FROM _map_get, st3, "clauses".
            CREATE mn3(NUM) TO 0.
            CREATE mel3(TX) TO "".
            SEASON mn3 < COUNT mcl3,
                REAP mel3 FROM plant_list_get, mcl3, mn3.
                REAP mb3 FROM _map_get, mel3, "bodyStatements".
                REAP scm FROM _cl_scopes, mb3, sc3, sigs.
                REAP cres FROM _cl_walk, mb3, scm, res, rmap, cc, sigs.
                REAP res FROM plant_list_get, cres, 0.
                REAP rmap FROM plant_list_get, cres, 1.
                REAP cc FROM plant_list_get, cres, 2.
                SET mn3 TO mn3 + 1.
            /SEASON.
        /IF.
        SET n3 TO n3 + 1.
    /SEASON.
    GIVE plant_list_make(3, res, rmap, cc).
/ACTION.

# collect_closures — pass 0d over the whole AST
ACTION collect_closures(ast(LIST), sigs(LIST)),
    CREATE clmaps(LIST) TO plant_list_make(0).
    CREATE cllist(LIST) TO plant_list_make(0).
    CREATE ai5(NUM) TO 0.
    CREATE ae5(TX) TO "".
    SEASON ai5 < COUNT ast,
        REAP ae5 FROM plant_list_get, ast, ai5.
        REAP aty FROM _map_get, ae5, "type".
        IF aty IS "action_decl",
            REAP agen FROM _map_get, ae5, "generics".
            IF COUNT agen IS 0,
                REAP aname5 FROM _map_get, ae5, "name".
                REAP apms5 FROM _map_get, ae5, "params".
                REAP abd5 FROM _map_get, ae5, "body".
                REAP apsc FROM _cl_scopes, abd5, plant_list_make(0), sigs.
                CREATE ai6(NUM) TO 0.
                CREATE ae6(TX) TO "".
                SEASON ai6 < COUNT apms5,
                    REAP ae6 FROM plant_list_get, apms5, ai6.
                    REAP apn6 FROM _map_get, ae6, "name".
                    REAP apt6 FROM _map_get, ae6, "type".
                    REAP act6 FROM plant_ctype, apt6.
                    PUT apn6 INTO apsc.
                    PUT act6 INTO apsc.
                    PUT apn6 + "#t" INTO apsc.
                    PUT apt6 INTO apsc.
                    SET ai6 TO ai6 + 1.
                /SEASON.
                REAP imp5 FROM collect_implicit, abd5, apms5.
                CREATE di5(NUM) TO 0.
                CREATE dv5(TX) TO "".
                SEASON di5 < COUNT imp5,
                    REAP dv5 FROM plant_list_get, imp5, di5.
                    PUT dv5 INTO apsc.
                    PUT "tx_t" INTO apsc.
                    SET di5 TO di5 + 1.
                /SEASON.
                CREATE cseedd(NUM) TO COUNT cllist.
                REAP cres FROM _cl_walk, abd5, apsc, cllist, plant_list_make(0), cseedd, sigs.
                REAP cllist FROM plant_list_get, cres, 0.
                REAP cmap5 FROM plant_list_get, cres, 1.
                PUT aname5 INTO clmaps.
                PUT cmap5 INTO clmaps.
            /IF.
        /IF.
        SET ai5 TO ai5 + 1.
    /SEASON.
    GIVE plant_list_make(2, clmaps, cllist).
/ACTION.

# _cl_param_str — "type name, type name" for a params list
ACTION _cl_param_str(params(LIST)),
    CREATE pstr(TX) TO "".
    CREATE pi3(NUM) TO 0.
    CREATE pe3(TX) TO "".
    SEASON pi3 < COUNT params,
        REAP pe3 FROM plant_list_get, params, pi3.
        REAP pn3 FROM _map_get, pe3, "name".
        REAP pt3 FROM _map_get, pe3, "type".
        REAP ct3 FROM plant_ctype, pt3.
        IF pi3 > 0, SET pstr TO pstr + ", ". /IF.
        SET pstr TO pstr + ct3 + " " + pn3.
        SET pi3 TO pi3 + 1.
    /SEASON.
    GIVE pstr.
/ACTION.

# _cl_emit_typedef — "typedef struct { … } plant_Env_N;"
# MOVE fields keep the captured value's C type; REF fields are
# always tx_t (a pointer to the borrowed outer variable).
ACTION _cl_emit_typedef(cnode(LIST)),
    REAP envn FROM _map_get, cnode, "envname".
    REAP shads FROM _map_get, cnode, "shadows".
    CREATE tc(TX) TO "typedef struct \{\n".
    CREATE si4(NUM) TO 0.
    CREATE se4(TX) TO "".
    CREATE sm4(TX) TO "".
    SEASON si4 < COUNT shads,
        REAP se4 FROM plant_list_get, shads, si4.
        REAP sm4 FROM _map_get, se4, "mode".
        REAP sct4 FROM _map_get, se4, "ctype".
        REAP sname4 FROM _map_get, se4, "name".
        IF str_eq(sm4, "MOVE") IS "1",
            SET tc TO tc + "  " + sct4 + " " + sname4 + ";\n".
        /IF.
        IF str_eq(sm4, "REF") IS "1",
            SET tc TO tc + "  tx_t " + sname4 + ";\n".
        /IF.
        SET si4 TO si4 + 1.
    /SEASON.
    SET tc TO tc + "\} " + envn + ";\n".
    GIVE tc.
/ACTION.

# _cl_emit_fn — the closure function definition:
#   tx_t plant_Closure_N_fn(tx_t env, params…) {
#     ctype name = env->name;            // MOVE shadow
#     ctype name = *((ctype*)env->name); // REF shadow
#     return expr;                       // or block body
#   }
#  reg: enum registry (build_enum_registry) — the closure body gets
#  its own enum table (closure params + captured shadows + enum
#  CREATE/LET targets) so SHOW/concat wrap with _from_enum (v0.48.9).
ACTION _cl_emit_fn(cnode(LIST), sigs(LIST), subst(LIST), reg(LIST)),
    REAP fname FROM _map_get, cnode, "fnname".
    REAP envn2 FROM _map_get, cnode, "envname".
    REAP params FROM _map_get, cnode, "params".
    REAP bk FROM _map_get, cnode, "bkind".
    REAP shads FROM _map_get, cnode, "shadows".
    REAP cm2 FROM _map_get, cnode, "clmap".
    REAP pstr FROM _cl_param_str, params.
    # closure-scope param-style maps: closure params + captured
    # shadows (as name/type pairs) feed the enum table
    CREATE cbpars2(LIST) TO plant_list_make(0).
    CREATE cbi(NUM) TO 0.
    CREATE cbe(TX) TO "".
    SEASON cbi < COUNT params,
        REAP cbe FROM plant_list_get, params, cbi.
        PUT cbe INTO cbpars2.
        SET cbi TO cbi + 1.
    /SEASON.
    CREATE cbsi(NUM) TO 0.
    CREATE cbse(TX) TO "".
    CREATE cbsn(TX) TO "".
    CREATE cbty(TX) TO "".
    SEASON cbsi < COUNT shads,
        REAP cbse FROM plant_list_get, shads, cbsi.
        REAP cbsn FROM _map_get, cbse, "name".
        REAP cbty FROM _map_get, cbse, "ptype".
        PUT plant_list_make(4, "name", cbsn, "type", cbty) INTO cbpars2.
        SET cbsi TO cbsi + 1.
    /SEASON.
    CREATE fnc(TX) TO "tx_t " + fname + "(tx_t env".
    IF pstr > "", SET fnc TO fnc + ", " + pstr. /IF.
    SET fnc TO fnc + ") \{\n".
    CREATE si5(NUM) TO 0.
    CREATE se5(TX) TO "".
    CREATE sm5(TX) TO "".
    CREATE sct5(TX) TO "".
    SEASON si5 < COUNT shads,
        REAP se5 FROM plant_list_get, shads, si5.
        REAP sm5 FROM _map_get, se5, "mode".
        REAP sct5 FROM _map_get, se5, "ctype".
        REAP snameQ FROM _map_get, se5, "name".
        IF str_eq(sm5, "MOVE") IS "1",
            SET fnc TO fnc + "  " + sct5 + " " + snameQ + " = ((" + envn2 + "*)env)->" + snameQ + ";\n".
        /IF.
        IF str_eq(sm5, "REF") IS "1",
            SET fnc TO fnc + "  " + sct5 + " " + snameQ + " = *(( " + sct5 + "*)((" + envn2 + "*)env)->" + snameQ + ");\n".
        /IF.
        SET si5 TO si5 + 1.
    /SEASON.
    IF str_eq(bk, "expr") IS "1",
        REAP bx FROM _map_get, cnode, "body".
        REAP cx3 FROM translate_expr, bx.
        CREATE nums_c(LIST) TO collect_nums_cb(plant_list_make(0), params, shads, subst).
        CREATE evars_c(LIST) TO collect_enums(plant_list_make(0), cbpars2, subst, reg, sigs).
        REAP cx3 FROM _handle_cat, cx3, nums_c, evars_c.
        SET fnc TO fnc + "  return " + cx3 + ";\n".
    /IF.
    IF str_eq(bk, "block") IS "1",
        REAP bb FROM _map_get, cnode, "body".
        CREATE nums_c(LIST) TO collect_nums_cb(bb, params, shads, subst).
        CREATE stvars_c(LIST) TO collect_stvars_walk(bb, subst, plant_list_make(0)).
        CREATE cbpars(LIST) TO params.
        CREATE si6(NUM) TO 0.
        CREATE se6(TX) TO "".
        SEASON si6 < COUNT shads,
            REAP se6 FROM plant_list_get, shads, si6.
            PUT se6 INTO cbpars.
            SET si6 TO si6 + 1.
        /SEASON.
        REAP imp6 FROM collect_implicit, bb, cbpars.
        CREATE di6(NUM) TO 0.
        CREATE dv6(TX) TO "".
        SEASON di6 < COUNT imp6,
            REAP dv6 FROM plant_list_get, imp6, di6.
            SET fnc TO fnc + "  tx_t " + dv6 + " = \"\";\n".
            SET di6 TO di6 + 1.
        /SEASON.
        CREATE evars_c(LIST) TO collect_enums(bb, cbpars2, subst, reg, sigs).
        REAP bc3 FROM generate_body, bb, 1, sigs, subst, cm2, "", nums_c, stvars_c, evars_c, "", "".
        SET fnc TO fnc + bc3 + "".
    /IF.
    SET fnc TO fnc + "\}\n".
    GIVE fnc.
/ACTION.


# ── get_cli_arg — FFI external stub ─────────────────────────
# Linked to process.argv in the JS runtime.
# Falls back to "test.plant" when no argument is provided.

ACTION get_cli_arg(idx(NUM)) -> external.

# ═══════════════════════════════════════════════════════════
#  Compiler Pipeline — Stage 0 self-hosting driver
# ═══════════════════════════════════════════════════════════

# 1. Source file path (default: test.plant)
REAP arg0 FROM get_cli_arg, 0.
IF arg0 IS "-h" OR arg0 IS "--help",
  SHOW "Chloroplast — Pure Native PlantLang compiler".
  SHOW "usage: Chloroplast <source.plant> [out.c]".
  SHOW "options:".
  SHOW "  -h, --help     show this help and exit".
  SHOW "  -v, --version  show version and exit".
  GIVE 0.
/IF.
IF arg0 IS "-v" OR arg0 IS "--version",
  SHOW "Chloroplast 0.48.20 (pure native)".
  GIVE 0.
/IF.
REAP source_path FROM get_cli_arg, 0.
SHOW "input: " + source_path.

# 2. Validate
REAP exists FROM fs:EXISTS, source_path.
IF exists ISNT "1",
  SHOW "Error: file not found — " + source_path.
  GIVE 1.
/IF.

# 3. Read
REAP source_text FROM fs:READ, source_path.

# 4. Tokenize
SHOW "tokenizing...".
REAP tokens FROM scan_tokens, source_text.

# 5. Parse
SHOW "parsing...".
REAP program_ast FROM parse_program, tokens.
REAP perr FROM _map_get, program_ast, "error".
IF perr > "",
  SHOW "Error: " + perr + ".".
  GIVE 1.
/IF.
REAP body FROM _map_get, program_ast, "body".

# 6. Code generate
SHOW "generating C...".
REAP c_code FROM generate_c, body.

# 7. Determine output path (use second CLI arg if provided)
REAP out_path FROM get_cli_arg, 1.
IF out_path IS "",
  REAP out_path FROM strings:REPLACE, source_path, ".plant", ".c".
/IF.
REAP written FROM fs:WRITE, out_path, c_code.
REAP c_len FROM strings:LENGTH, c_code.
SHOW "output: " + c_len + " bytes to " + out_path.
CALM.
