ACTION main(),
  REAP s FROM set_create.
  # ── basic add / has / dedup ────────────────────────────────
  REAP a1 FROM set_add, s, 10.
  SHOW "add10=" + a1.
  REAP a2 FROM set_add, s, 10.
  SHOW "add10-dup=" + a2.
  REAP a3 FROM set_add, s, 20.
  SHOW "add20=" + a3.
  REAP h1 FROM set_has, s, 10.
  SHOW "has10=" + h1.
  REAP h2 FROM set_has, s, 99.
  SHOW "has99=" + h2.
  CREATE sz1(NUM) TO 0.
  REAP sz1 FROM set_size, s.
  CREATE sz1s(TX) TO "".
  REAP sz1s FROM _from_long, sz1.
  SHOW "size=" + sz1s.
  # ── TX and LIST values (identity-based uniqueness) ────────
  CREATE t(TX) TO "alpha".
  REAP at1 FROM set_add, s, t.
  REAP at2 FROM set_add, s, t.
  SHOW "txt-dedup=" + at2.
  CREATE m(LIST) TO plant_list_make(0).
  REAP am1 FROM set_add, s, m.
  REAP am2 FROM set_add, s, m.
  SHOW "map-dedup=" + am2.
  # ── remove ─────────────────────────────────────────────────
  REAP r1 FROM set_remove, s, 10.
  SHOW "rm10=" + r1.
  REAP h3 FROM set_has, s, 10.
  SHOW "has10-after=" + h3.
  REAP r2 FROM set_remove, s, 10.
  SHOW "rm10-again=" + r2.
  REAP h4 FROM set_has, s, 20.
  SHOW "has20=" + h4.
  # ── stress: 2000 inserts + 2000 dupes + 1000 removes ──────
  CREATE si(NUM) TO 1.
  SEASON si <= 2000,
    REAP _ FROM set_add, s, si.
    REAP _ FROM set_add, s, si.
    SET si TO si + 1.
  /SEASON.
  CREATE sz2(NUM) TO 0.
  REAP sz2 FROM set_size, s.
  CREATE sz2s(TX) TO "".
  REAP sz2s FROM _from_long, sz2.
  SHOW "stress-size=" + sz2s.
  REAP h5 FROM set_has, s, 2000.
  SHOW "has2000=" + h5.
  CREATE sj(NUM) TO 1001.
  SEASON sj <= 2000,
    REAP _ FROM set_remove, s, sj.
    SET sj TO sj + 1.
  /SEASON.
  CREATE sz3(NUM) TO 0.
  REAP sz3 FROM set_size, s.
  CREATE sz3s(TX) TO "".
  REAP sz3s FROM _from_long, sz3.
  SHOW "stress-size-after-rm=" + sz3s.
  REAP h6 FROM set_has, s, 1500.
  SHOW "has1500=" + h6.
  # ── to_list ────────────────────────────────────────────────
  REAP lst FROM set_to_list, s.
  CREATE c1(NUM) TO COUNT lst.
  CREATE c1s(TX) TO "".
  REAP c1s FROM _from_long, c1.
  SHOW "tolist-count=" + c1s.
  REAP h7 FROM set_has, s, 1000.
  SHOW "has1000=" + h7.
  GIVE 0.
/GIVE main.
