# basic generic actions: single type param, multiple instantiations
ACTION echo[T](v(T)),
  GIVE v.
/ACTION.

ACTION wrap[T](v(T)),
  GIVE "[" + v + "]".
/ACTION.

ACTION mul2[T](a(T), b(T)),
  CREATE r(NUM) TO 0.
  SET r TO a * b.
  GIVE r.
/ACTION.

ACTION mk[T](v(T)),
  CREATE c(T) TO v.
  GIVE c.
/ACTION.

ACTION main(),
  REAP a FROM echo[TX], "hi".
  SHOW "a=" + a.
  REAP b FROM wrap[TX], "xy".
  SHOW "b=" + b.
  REAP c FROM echo[FACT], 7.
  REAP cs FROM _from_long, c.
  SHOW "c=" + cs.
  REAP m FROM mul2[NUM], 6, 7.
  CREATE mn(NUM) TO 0.
  SET mn TO m.
  REAP ms FROM _from_long, mn.
  SHOW "mul=" + ms.
  REAP k FROM mk[TX], "q".
  SHOW "mk=" + k.
  GIVE 0.
/GIVE main.
