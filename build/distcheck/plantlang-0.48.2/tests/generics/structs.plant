# non-generic STRUCT + FFI interop through opaque tx_t handles.
# STRUCT Point emits the C typedef plant_Point (checked via .grep);
# runtime values stay tx_t and the mock FFI casts internally.
STRUCT Point { x: NUM, y: NUM }

ACTION ffi_make_point(x(NUM), y(NUM)) -> external.
ACTION ffi_point_sum(p(Point)) -> external.

ACTION main(),
  REAP p FROM ffi_make_point, 3, 4.
  CREATE pp(Point) TO p.
  REAP s FROM ffi_point_sum, pp.
  SHOW "sum=" + s.
  REAP s2 FROM ffi_point_sum, p.
  SHOW "sum2=" + s2.
  GIVE 0.
/GIVE main.
