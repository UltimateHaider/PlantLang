# MOVE captures: value copied into the env at create time, the
# outer variable is cleared (consumed), and the closure keeps its
# own private state across invocations.
ACTION main(),
  CREATE x(NUM) TO 10.
  CREATE f TO [MOVE x](v(NUM)) -> v + x + 1.
  REAP r FROM f, 5.
  REAP rs FROM _from_long, r.
  SHOW "first=" + rs.
  REAP r2 FROM f, 100.
  REAP rs2 FROM _from_long, r2.
  SHOW "second=" + rs2.
  REAP zs FROM _from_long, x.
  SHOW "cleared=" + zs.
  GIVE 0.
/GIVE main.
