# ═══════════════════════════════════════════════════════════════
#  src/plantc/lexer.plant — Lexical analyzer for the
#  self-hosting PlantLang compiler.
# ═══════════════════════════════════════════════════════════════

# ── is_keyword(word) ──────────────────────────────────────
ACTION is_keyword(wrd(TX)),
  IF wrd IS "LET", GIVE TRUE. /IF.
  IF wrd IS "CREATE", GIVE TRUE. /IF.
  IF wrd IS "MATCH", GIVE TRUE. /IF.
  IF wrd IS "IF", GIVE TRUE. /IF.
  IF wrd IS "ELSE", GIVE TRUE. /IF.
  IF wrd IS "LOOP", GIVE TRUE. /IF.
  IF wrd IS "RETURN", GIVE TRUE. /IF.
  IF wrd IS "TYPE", GIVE TRUE. /IF.
  IF wrd IS "SHOW", GIVE TRUE. /IF.
  IF wrd IS "ACTION", GIVE TRUE. /IF.
  IF wrd IS "REAP", GIVE TRUE. /IF.
  IF wrd IS "GIVE", GIVE TRUE. /IF.
  IF wrd IS "SET", GIVE TRUE. /IF.
  IF wrd IS "PUT", GIVE TRUE. /IF.
  IF wrd IS "TAKE", GIVE TRUE. /IF.
  IF wrd IS "FOR", GIVE TRUE. /IF.
  IF wrd IS "CYCLE", GIVE TRUE. /IF.
  IF wrd IS "SEASON", GIVE TRUE. /IF.
  IF wrd IS "WEATHER", GIVE TRUE. /IF.
  IF wrd IS "SHELTER", GIVE TRUE. /IF.
  IF wrd IS "CALM", GIVE TRUE. /IF.
  IF wrd IS "AND", GIVE TRUE. /IF.
  IF wrd IS "OR", GIVE TRUE. /IF.
  IF wrd IS "NOT", GIVE TRUE. /IF.
  IF wrd IS "IS", GIVE TRUE. /IF.
  IF wrd IS "TRUE", GIVE TRUE. /IF.
  IF wrd IS "FALSE", GIVE TRUE. /IF.
  IF wrd IS "TO", GIVE TRUE. /IF.
  IF wrd IS "FROM", GIVE TRUE. /IF.
  IF wrd IS "AS", GIVE TRUE. /IF.
  IF wrd IS "IN", GIVE TRUE. /IF.
  IF wrd IS "SPLIT", GIVE TRUE. /IF.
  IF wrd IS "JOIN", GIVE TRUE. /IF.
  IF wrd IS "ENUM", GIVE TRUE. /IF.
  IF wrd IS "CONST", GIVE TRUE. /IF.
  IF wrd IS "FUNCTION", GIVE TRUE. /IF.
  IF wrd IS "IMPORT", GIVE TRUE. /IF.
  IF wrd IS "OPTION", GIVE TRUE. /IF.
  IF wrd IS "RESULT", GIVE TRUE. /IF.
  IF wrd IS "GREATER", GIVE TRUE. /IF.
  IF wrd IS "LESS", GIVE TRUE. /IF.
  IF wrd IS "THAN", GIVE TRUE. /IF.
  IF wrd IS "COUNT", GIVE TRUE. /IF.
  IF wrd IS "FIRST", GIVE TRUE. /IF.
  IF wrd IS "LAST", GIVE TRUE. /IF.
  IF wrd IS "SUM", GIVE TRUE. /IF.
  IF wrd IS "NULL", GIVE TRUE. /IF.
  IF wrd IS "ISNT", GIVE TRUE. /IF.
  IF wrd IS "TEST", GIVE TRUE. /IF.
  IF wrd IS "BREAK", GIVE TRUE. /IF.
  IF wrd IS "CONTINUE", GIVE TRUE. /IF.
  IF wrd IS "INTO", GIVE TRUE. /IF.
  GIVE FALSE.
/ACTION.

# ── keyword_to_type(word) ─────────────────────────────────
ACTION keyword_to_type(wrd(TX)),
  IF wrd IS "LET", GIVE "LET". /IF.
  IF wrd IS "CREATE", GIVE "CREATE". /IF.
  IF wrd IS "MATCH", GIVE "MATCH". /IF.
  IF wrd IS "IF", GIVE "IF". /IF.
  IF wrd IS "ELSE", GIVE "ELSE". /IF.
  IF wrd IS "LOOP", GIVE "LOOP". /IF.
  IF wrd IS "RETURN", GIVE "RETURN". /IF.
  IF wrd IS "TYPE", GIVE "TYPE". /IF.
  IF wrd IS "SHOW", GIVE "SHOW". /IF.
  IF wrd IS "ACTION", GIVE "ACTION". /IF.
  IF wrd IS "REAP", GIVE "REAP". /IF.
  IF wrd IS "GIVE", GIVE "GIVE". /IF.
  IF wrd IS "SET", GIVE "SET". /IF.
  IF wrd IS "PUT", GIVE "PUT". /IF.
  IF wrd IS "TAKE", GIVE "TAKE". /IF.
  IF wrd IS "FOR", GIVE "FOR". /IF.
  IF wrd IS "CYCLE", GIVE "CYCLE". /IF.
  IF wrd IS "SEASON", GIVE "SEASON". /IF.
  IF wrd IS "WEATHER", GIVE "WEATHER". /IF.
  IF wrd IS "SHELTER", GIVE "SHELTER". /IF.
  IF wrd IS "CALM", GIVE "CALM". /IF.
  IF wrd IS "AND", GIVE "AND". /IF.
  IF wrd IS "OR", GIVE "OR". /IF.
  IF wrd IS "NOT", GIVE "NOT". /IF.
  IF wrd IS "IS", GIVE "IS". /IF.
  IF wrd IS "TRUE", GIVE "TRUE". /IF.
  IF wrd IS "FALSE", GIVE "FALSE". /IF.
  IF wrd IS "TO", GIVE "TO". /IF.
  IF wrd IS "FROM", GIVE "FROM". /IF.
  IF wrd IS "AS", GIVE "AS". /IF.
  IF wrd IS "IN", GIVE "IN". /IF.
  IF wrd IS "SPLIT", GIVE "SPLIT". /IF.
  IF wrd IS "JOIN", GIVE "JOIN". /IF.
  IF wrd IS "ENUM", GIVE "ENUM". /IF.
  IF wrd IS "CONST", GIVE "CONST". /IF.
  IF wrd IS "FUNCTION", GIVE "FUNCTION". /IF.
  IF wrd IS "IMPORT", GIVE "IMPORT". /IF.
  IF wrd IS "OPTION", GIVE "OPTION". /IF.
  IF wrd IS "RESULT", GIVE "RESULT". /IF.
  IF wrd IS "GREATER", GIVE "GREATER". /IF.
  IF wrd IS "LESS", GIVE "LESS". /IF.
  IF wrd IS "THAN", GIVE "THAN". /IF.
  IF wrd IS "COUNT", GIVE "COUNT". /IF.
  IF wrd IS "FIRST", GIVE "FIRST". /IF.
  IF wrd IS "LAST", GIVE "LAST". /IF.
  IF wrd IS "SUM", GIVE "SUM". /IF.
  IF wrd IS "NULL", GIVE "NULL". /IF.
  IF wrd IS "ISNT", GIVE "ISNT". /IF.
  IF wrd IS "TEST", GIVE "TEST". /IF.
  IF wrd IS "BREAK", GIVE "BREAK". /IF.
  IF wrd IS "CONTINUE", GIVE "CONTINUE". /IF.
  IF wrd IS "INTO", GIVE "INTO". /IF.
  GIVE "IDENT".
/ACTION.

# ── char_type(ch) ─────────────────────────────────────────
ACTION char_type(ch(TX)),
  IF ch IS "+", GIVE "PLUS". /IF.
  IF ch IS "-", GIVE "MINUS". /IF.
  IF ch IS "*", GIVE "STAR". /IF.
  IF ch IS "/", GIVE "SLASH". /IF.
  IF ch IS "%", GIVE "PERCENT". /IF.
  IF ch IS "=", GIVE "EQUAL". /IF.
  IF ch IS ":", GIVE "COLON". /IF.
  IF ch IS "<", GIVE "LESS". /IF.
  IF ch IS ">", GIVE "GREATER". /IF.
  IF ch IS "!", GIVE "BANG". /IF.
  IF ch IS "?", GIVE "QUESTION". /IF.
  IF ch IS "&", GIVE "AMPERSAND". /IF.
  IF ch IS "|", GIVE "PIPE". /IF.
  IF ch IS ";", GIVE "SEMI". /IF.
  IF ch IS "(", GIVE "LPAREN". /IF.
  IF ch IS ")", GIVE "RPAREN". /IF.
  IF ch IS "{", GIVE "LBRACE". /IF.
  IF ch IS "}", GIVE "RBRACE". /IF.
  IF ch IS "[", GIVE "LBRACKET". /IF.
  IF ch IS "]", GIVE "RBRACKET". /IF.
  IF ch IS ",", GIVE "COMMA". /IF.
  IF ch IS ".", GIVE "DOT". /IF.
  IF ch IS "_", GIVE "WILDCARD". /IF.
  IF ch IS "#", GIVE "HASH". /IF.
  GIVE "".
/ACTION.

# ── is_alnum(ch) ──────────────────────────────────────────
ACTION is_alnum(ch(TX)),
  IF ch GREATER THAN OR EQUAL "a" AND ch LESS THAN OR EQUAL "z", GIVE TRUE. /IF.
  IF ch GREATER THAN OR EQUAL "A" AND ch LESS THAN OR EQUAL "Z", GIVE TRUE. /IF.
  IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", GIVE TRUE. /IF.
  IF ch IS "_", GIVE TRUE. /IF.
  GIVE FALSE.
/ACTION.

# ── is_alpha_start(ch) ────────────────────────────────────
ACTION is_alpha_start(ch(TX)),
  IF ch GREATER THAN OR EQUAL "a" AND ch LESS THAN OR EQUAL "z", GIVE TRUE. /IF.
  IF ch GREATER THAN OR EQUAL "A" AND ch LESS THAN OR EQUAL "Z", GIVE TRUE. /IF.
  IF ch IS "_", GIVE TRUE. /IF.
  GIVE FALSE.
/ACTION.

# ── match_ident_or_keyword(src, i, n) ─────────────────────
ACTION match_ident_or_keyword(src(TX), i(NUM), n(NUM)),
  CREATE wd(TX) TO "".
  CREATE ni(NUM) TO i.
  CREATE ch(TX) TO "".
  SEASON ni < n,
    REAP ok FROM is_alnum, char_at(src, ni).
    IF NOT ok, BREAK. /IF.
    REAP ch FROM char_at, src, ni.
    SET wd TO wd + ch.
    SET ni TO ni + 1.
  /SEASON.
  IF wd IS "null", SET wd TO "NULL". /IF.
  GIVE plant_list_make(2, wd, ni).
/ACTION.

# ── match_number(src, i, n) ───────────────────────────────
ACTION match_number(src(TX), i(NUM), n(NUM)),
  CREATE num(TX) TO "".
  CREATE ni(NUM) TO i.
  CREATE ch(TX) TO "".
  SEASON ni < n AND char_at(src, ni) GREATER THAN OR EQUAL "0" AND char_at(src, ni) LESS THAN OR EQUAL "9",
    REAP ch FROM char_at, src, ni.
    SET num TO num + ch.
    SET ni TO ni + 1.
  /SEASON.
  GIVE plant_list_make(2, num, ni).
/ACTION.

# ── match_string(src, i, n) ───────────────────────────────
ACTION match_string(src(TX), i(NUM), n(NUM)),
  CREATE val(TX) TO "".
  CREATE si(NUM) TO i.
  CREATE done(FACT) TO FALSE.
  CREATE ch(TX) TO "".
  IF si < n AND char_at(src, si) IS "\"", SET si TO si + 1. /IF.
  SEASON NOT done AND si < n,
    REAP ch FROM char_at, src, si.
    IF ch IS "\"", SET done TO TRUE. /IF.
    IF ch IS "\"", CONTINUE. /IF.
    IF ch IS "\\",
      SET si TO si + 1.
      IF si < n,
        REAP ch FROM char_at, src, si.
        IF ch IS "n", SET ch TO "\n". /IF.
        IF ch IS "t", SET ch TO "\t". /IF.
        IF ch IS "r", SET ch TO "\r". /IF.
      /IF.
    /IF.
    IF si < n,
      SET val TO val + ch.
      SET si TO si + 1.
    /IF.
  /SEASON.
  IF si < n AND char_at(src, si) IS "\"", SET si TO si + 1. /IF.
  GIVE plant_list_make(2, val, si).
/ACTION.

# ── skip_comment(src, i, n) ───────────────────────────────
ACTION skip_comment(src(TX), i(NUM), n(NUM)),
  SEASON i < n AND char_at(src, i) ISNT "\n",
    SET i TO i + 1.
  /SEASON.
  GIVE i.
/ACTION.

# ── scan_tokens(source) ───────────────────────────────────
ACTION scan_tokens(src(TX)),
  CREATE tokens(LIST) TO plant_list_make(0).
  CREATE i(NUM) TO 0.
  CREATE n(NUM) TO LEN(src).
  CREATE ch(TX) TO "".

  SEASON i < n,
    REAP ch FROM char_at, src, i.

    # Whitespace
    IF ch IS " " OR ch IS "\t" OR ch IS "\r", SET i TO i + 1. /IF.
    IF ch IS " " OR ch IS "\t" OR ch IS "\r", CONTINUE. /IF.

    # Newline
    IF ch IS "\n", SET i TO i + 1. /IF.
    IF ch IS "\n", CONTINUE. /IF.

    # Comment
    IF ch IS "#", REAP si FROM skip_comment, src, i + 1, n. /IF.
    IF ch IS "#", SET i TO si. /IF.
    IF ch IS "#", CONTINUE. /IF.

    # String literal
    IF ch IS "\"", REAP si FROM match_string, src, i, n. /IF.
    IF ch IS "\"", PUT plant_list_make(2, "STRING", si[0]) INTO tokens. /IF.
    IF ch IS "\"", SET i TO si[1]. /IF.
    IF ch IS "\"", CONTINUE. /IF.

    # Depth marker N\  — check before Number
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\",
      REAP si FROM match_number, src, i, n. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\",
      PUT plant_list_make(2, "DEPTH", si[0]) INTO tokens. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\",
      SET i TO si[1] + 1. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\" AND i < n AND char_at(src, i) IS " ",
      SET i TO i + 1. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9" AND i + 1 < n AND char_at(src, i + 1) IS "\\",
      CONTINUE. /IF.

    # Number
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", REAP si FROM match_number, src, i, n. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", PUT plant_list_make(2, "NUMBER", si[0]) INTO tokens. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", SET i TO si[1]. /IF.
    IF ch GREATER THAN OR EQUAL "0" AND ch LESS THAN OR EQUAL "9", CONTINUE. /IF.

    # Identifier
    REAP ok FROM is_alpha_start, ch.
    IF ok, REAP si FROM match_ident_or_keyword, src, i, n. /IF.
    IF ok, REAP tok_ty FROM keyword_to_type, si[0]. /IF.
    IF ok, PUT plant_list_make(2, tok_ty, si[0]) INTO tokens. /IF.
    IF ok, SET i TO si[1]. /IF.
    IF ok, CONTINUE. /IF.

    # DOT_DOT
    IF ch IS "." AND i + 1 < n AND char_at(src, i + 1) IS ".",
      PUT plant_list_make(2, "DOT_DOT", "..") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.

    # ARROW
    IF ch IS "-" AND i + 1 < n AND char_at(src, i + 1) IS ">",
      PUT plant_list_make(2, "ARROW", "->") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.

    # Combined comparisons >= <= == !=
    IF ch IS ">" AND i + 1 < n AND char_at(src, i + 1) IS "=",
      PUT plant_list_make(2, "GREATER", ">=") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.
    IF ch IS "<" AND i + 1 < n AND char_at(src, i + 1) IS "=",
      PUT plant_list_make(2, "LESS", "<=") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.
    IF ch IS "=" AND i + 1 < n AND char_at(src, i + 1) IS "=",
      PUT plant_list_make(2, "EQUAL", "==") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.
    IF ch IS "!" AND i + 1 < n AND char_at(src, i + 1) IS "=",
      PUT plant_list_make(2, "BANG", "!=") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.

    # STAR_STAR
    IF ch IS "*" AND i + 1 < n AND char_at(src, i + 1) IS "*",
      PUT plant_list_make(2, "STAR_STAR", "**") INTO tokens.
      SET i TO i + 2.
      CONTINUE.
    /IF.

    # Single-char
    REAP tok_ty FROM char_type, ch.
    IF tok_ty ISNT "", PUT plant_list_make(2, tok_ty, ch) INTO tokens. /IF.
    IF tok_ty ISNT "", SET i TO i + 1. /IF.
    IF tok_ty ISNT "", CONTINUE. /IF.

    # Unknown
    PUT plant_list_make(2, "ERROR", ch) INTO tokens.
    SET i TO i + 1.
  /SEASON.

  PUT plant_list_make(2, "EOF", "") INTO tokens.
  GIVE tokens.
/ACTION.
# ═══════════════════════════════════════════════════════════════
#  src/plantc/parser.plant — Recursive descent parser
#
#  All action calls use REAP (no inline calls).
#  SEASON is a while-loop, IF is a conditional.
#  Use SEASON only for loops, IF for single branches.
#  Block IFs (multi-line) for multiple body statements.
# ═══════════════════════════════════════════════════════════════


#── Utility actions ────────────────────────────────────────────

ACTION tok_lex(tok(LIST)),
  GIVE tok[1].
/ACTION.

ACTION tok_type(tok(LIST)),
  GIVE tok[0].
/ACTION.

ACTION peek(tokens(LIST), pos(NUM)),
  IF pos < COUNT tokens,
    GIVE tokens[pos].
  /IF.
  GIVE plant_list_make(2, null, "").
/ACTION.

ACTION consume(tokens(LIST), pos(NUM)),
  GIVE plant_list_make(2, tokens[pos], pos + 1).
/ACTION.

ACTION _first(pair(LIST)),
  GIVE pair[0].
/ACTION.

ACTION _second(pair(LIST)),
  GIVE pair[1].
/ACTION.

ACTION is_eof(tokens(LIST), pos(NUM)),
  IF pos >= COUNT tokens,
    GIVE TRUE.
  /IF.
  REAP tok FROM peek, tokens, pos.
  REAP tp FROM tok_type, tok.
  IF tp IS "EOF",
    GIVE TRUE.
  /IF.
  GIVE FALSE.
/ACTION.

# collect_value: collects text until "." or EOF (consumes the dot)
# escape_string — re-escape C-unsafe characters in string content for emission
ACTION escape_string(s(TX)),
  CREATE r(TX) TO "".
  CREATE ei(NUM) TO 0.
  CREATE en(NUM) TO LEN(s).
  CREATE ec(TX) TO "".
  SEASON ei < en,
    REAP ec FROM char_at, s, ei.
    IF ec IS "\\", SET r TO r + "\\" + "\\". /IF.
    IF ec IS "\"", SET r TO r + "\\" + "\"". /IF.
    IF ec IS "\n", SET r TO r + "\\" + "n". /IF.
    IF ec IS "\t", SET r TO r + "\\" + "t". /IF.
    IF ec IS "\r", SET r TO r + "\\" + "r". /IF.
    IF ec ISNT "\\" AND ec ISNT "\"" AND ec ISNT "\n" AND ec ISNT "\t" AND ec ISNT "\r",
      SET r TO r + ec.
    /IF.
    SET ei TO ei + 1.
  /SEASON.
  GIVE r.
/ACTION.

ACTION collect_value(tokens(LIST), start(NUM)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP tt FROM tok_type, tok.
    IF tt IS "STRING",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    IF lx IS "." AND depth IS 0,
      REAP cpair FROM consume, tokens, p2.
      REAP p2 FROM _second, cpair.
      GIVE plant_list_make(2, text, p2).
    /IF.
    # a ")" at depth 0 closes an enclosing closure block body; leave
    # it unconsumed so the caller (parse_statement loop) sees it
    IF lx IS ")" AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

# collect_until: collects text until delimiter at depth=0 (does NOT consume delimiter)
ACTION collect_until(tokens(LIST), start(NUM), delim(TX)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP tt FROM tok_type, tok.
    IF tt IS "STRING",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    IF _cat("", lx) IS _cat("", delim) AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

# collect_type_text: collects a type string until stopc (or "," when
# stopcomma=1) at depth 0, WITHOUT consuming the delimiter.
# Handles T, LIST[T], REF NUM, REF LIST[T], Box[NUM], Pair[NUM, TX] etc.
ACTION collect_type_text(tokens(LIST), start(NUM), stopc(TX), stopcomma(NUM)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE pdepth(NUM) TO 0.
  CREATE bdepth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF pdepth IS 0 AND bdepth IS 0,
      IF _cat("", lx) IS _cat("", stopc),
        GIVE plant_list_make(2, text, p2).
      /IF.
      IF stopcomma IS 1 AND lx IS ",",
        GIVE plant_list_make(2, text, p2).
      /IF.
    /IF.
    IF lx IS "(", SET pdepth TO pdepth + 1. /IF.
    IF lx IS ")", SET pdepth TO pdepth - 1. /IF.
    IF lx IS "[", SET bdepth TO bdepth + 1. /IF.
    IF lx IS "]", SET bdepth TO bdepth - 1. /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

#── Statement parsing ──────────────────────────────────────────

ACTION parse_create_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM consume, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tv FROM collect_type_text, tokens, p4, ")", 0.
    REAP tt FROM _first, tv.
    REAP p5 FROM _second, tv.
    REAP rp FROM consume, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tt.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM peek, tokens, p3.
  REAP lx2 FROM tok_lex, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

ACTION parse_show_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "show_stmt", "value", expr), p3).
/ACTION.

ACTION parse_give_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "give_stmt", "value", expr), p3).
/ACTION.

ACTION parse_set_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP eq FROM consume, tokens, p3.
  REAP p4 FROM _second, eq.
  REAP vpair FROM collect_value, tokens, p4.
  CREATE expr TO vpair[0].
  REAP p5 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "set_stmt", "target", id_name, "value", expr), p5).
/ACTION.

ACTION parse_let_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM consume, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tv FROM collect_type_text, tokens, p4, ")", 0.
    REAP tt FROM _first, tv.
    REAP p5 FROM _second, tv.
    REAP rp FROM consume, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tt.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM peek, tokens, p3.
  REAP lx2 FROM tok_lex, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

#── Closures ───────────────────────────────────────────────────
# parse_closure: [MOVE x, REF y](params) -> expr
#   or [MOVE x](params) -> ( stmts )  (multi-statement block).
# The closure body's single-expression form ends at "," or "."
# at depth 0; the block form ends at ")".
# Returns [closure_node, pos]; on failure [empty_list, start_pos].
# The terminating "," or "." is NOT consumed (the caller handles it).

ACTION parse_closure(tokens(LIST), pos(NUM)),
  CREATE start_pos(NUM) TO pos.
  REAP lb FROM consume, tokens, pos.
  REAP p2 FROM _second, lb.
  CREATE captures(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(0), start_pos).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF lx IS "]",
      REAP rb FROM consume, tokens, p2.
      REAP p2 FROM _second, rb.
      BREAK 0.
    /IF.
    REAP mode_pair FROM consume, tokens, p2.
    REAP mode FROM tok_lex, mode_pair[0].
    REAP p2 FROM _second, mode_pair.
    IF mode ISNT "MOVE" AND mode ISNT "REF",
      GIVE plant_list_make(2, plant_list_make(0), start_pos).
    /IF.
    REAP name_pair FROM consume, tokens, p2.
    REAP cap_name FROM tok_lex, name_pair[0].
    REAP p2 FROM _second, name_pair.
    PUT plant_list_make(4, "name", cap_name, "mode", mode) INTO captures.
    REAP tok2 FROM peek, tokens, p2.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p2.
      REAP p2 FROM _second, com.
    /IF.
  /SEASON.
  # "(params)"
  REAP ptok FROM peek, tokens, p2.
  REAP plx FROM tok_lex, ptok.
  IF plx ISNT "(",
    GIVE plant_list_make(2, plant_list_make(0), start_pos).
  /IF.
  REAP lp FROM consume, tokens, p2.
  REAP p3 FROM _second, lp.
  CREATE params(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p3.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(0), start_pos).
    /IF.
    REAP tok FROM peek, tokens, p3.
    REAP lx FROM tok_lex, tok.
    IF lx IS ")",
      REAP rp FROM consume, tokens, p3.
      REAP p4 FROM _second, rp.
      BREAK 0.
    /IF.
    REAP pn_pair FROM consume, tokens, p3.
    REAP pn FROM tok_lex, pn_pair[0].
    REAP p4 FROM _second, pn_pair.
    REAP tok2 FROM peek, tokens, p4.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS "(",
      REAP lp2 FROM consume, tokens, p4.
      REAP p5 FROM _second, lp2.
      REAP ptv FROM collect_type_text, tokens, p5, ")", 1.
      REAP pt FROM _first, ptv.
      REAP p5 FROM _second, ptv.
      REAP rp2 FROM consume, tokens, p5.
      REAP p5 FROM _second, rp2.
      PUT plant_list_make(4, "name", pn, "type", pt) INTO params.
      SET p4 TO p5.
    /IF.
    IF lx2 ISNT "(",
      PUT plant_list_make(4, "name", pn, "type", "") INTO params.
    /IF.
    REAP tok3 FROM peek, tokens, p4.
    REAP lx3 FROM tok_lex, tok3.
    IF lx3 IS ",",
      REAP com2 FROM consume, tokens, p4.
      REAP p4 FROM _second, com2.
    /IF.
    SET p3 TO p4.
  /SEASON.
  # "->"
  REAP atok FROM peek, tokens, p4.
  REAP alx FROM tok_lex, atok.
  IF alx ISNT "->",
    GIVE plant_list_make(2, plant_list_make(0), start_pos).
  /IF.
  REAP ap FROM consume, tokens, p4.
  REAP p5 FROM _second, ap.
  # defensive skip of a stray MINUS (mirrors parse_action_decl)
  REAP stok FROM peek, tokens, p5.
  REAP sty FROM tok_type, stok.
  IF sty IS "MINUS",
    REAP sp FROM consume, tokens, p5.
    REAP p5 FROM _second, sp.
  /IF.
  # body: block form "-> ( stmts )" when "(" is followed by a
  # statement keyword; otherwise a single expression
  CREATE body_kind(TX) TO "expr".
  REAP btok FROM peek, tokens, p5.
  REAP blx FROM tok_lex, btok.
  CREATE body(LIST) TO plant_list_make(0).
  IF blx IS "(",
    REAP btok2 FROM peek, tokens, p5 + 1.
    REAP blx2 FROM tok_lex, btok2.
    IF blx2 IS "CREATE" OR blx2 IS "SHOW" OR blx2 IS "GIVE" OR blx2 IS "SET" OR blx2 IS "LET" OR blx2 IS "IF" OR blx2 IS "SEASON" OR blx2 IS "REAP" OR blx2 IS "PUT" OR blx2 IS "BREAK" OR blx2 IS "CONTINUE",
      SET body_kind TO "block".
      REAP bp FROM consume, tokens, p5.
      REAP p6 FROM _second, bp.
      CREATE stmts(LIST) TO plant_list_make(0).
      SEASON TRUE,
        REAP is_eof_flag FROM is_eof, tokens, p6.
        IF is_eof_flag, BREAK 0. /IF.
        REAP btok3 FROM peek, tokens, p6.
        REAP blx3 FROM tok_lex, btok3.
        IF blx3 IS ")",
          REAP brp FROM consume, tokens, p6.
          REAP p6 FROM _second, brp.
          BREAK 0.
        /IF.
        REAP d_pair FROM parse_statement, tokens, p6.
        CREATE decl TO d_pair[0].
        REAP p6 FROM _second, d_pair.
        IF decl > "",
          PUT decl INTO stmts.
        /IF.
      /SEASON.
      SET body TO stmts.
      SET p5 TO p6.
    /IF.
  /IF.
  IF body_kind IS "expr",
    CREATE text(TX) TO "".
    CREATE bd(NUM) TO 0.
    CREATE pd(NUM) TO 0.
    SEASON TRUE,
      REAP is_eof_flag FROM is_eof, tokens, p5.
      IF is_eof_flag, BREAK 0. /IF.
      REAP etok FROM peek, tokens, p5.
      REAP elx FROM tok_lex, etok.
      REAP ety FROM tok_type, etok.
      IF ety IS "STRING",
        REAP elx FROM escape_string, elx.
        SET elx TO "\"" + elx + "\"".
      /IF.
      IF elx IS "," AND pd IS 0 AND bd IS 0, BREAK 0. /IF.
      IF elx IS "." AND pd IS 0 AND bd IS 0, BREAK 0. /IF.
      IF elx IS "(", SET pd TO pd + 1. /IF.
      IF elx IS ")", SET pd TO pd - 1. /IF.
      IF elx IS "[", SET bd TO bd + 1. /IF.
      IF elx IS "]", SET bd TO bd - 1. /IF.
      IF text > "",
        SET text TO text + " ".
      /IF.
      SET text TO text + elx.
      REAP ep FROM consume, tokens, p5.
      REAP p5 FROM _second, ep.
    /SEASON.
    SET body TO text.
  /IF.
  CREATE cnode(LIST) TO plant_list_make(12, "type", "closure", "params", params, "captures", captures, "body", body, "bkind", body_kind).
  GIVE plant_list_make(2, cnode, p5).
/ACTION.

ACTION parse_reap_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP var_pair FROM consume, tokens, p2.
  REAP var_name FROM tok_lex, var_pair[0].
  REAP p3 FROM _second, var_pair.
  REAP from_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, from_pair.
  REAP act_pair FROM consume, tokens, p4.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p5 FROM _second, act_pair.
  # Check for module:function syntax (e.g., strings:REPLACE)
  REAP next_tok FROM peek, tokens, p5.
  REAP next_lx FROM tok_lex, next_tok.
  REAP next_ty FROM tok_type, next_tok.
    IF next_ty IS "COLON",
      SET act_name TO act_name + ":".
      REAP colon_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, colon_pair.
      REAP func_pair FROM consume, tokens, p5.
      REAP func_name FROM tok_lex, func_pair[0].
      SET act_name TO act_name + func_name.
      REAP p5 FROM _second, func_pair.
    /IF.
  # generic type arguments at the call site: foo[NUM, TX]
  REAP ga_tok FROM peek, tokens, p5.
  REAP ga_lx FROM tok_lex, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p5, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p5 FROM _second, gv.
    REAP ga_rb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_rb.
    SET act_name TO act_name + "[" + gtext + "]".
  /IF.
  CREATE args(LIST) TO plant_list_make(0).
  CREATE clargs(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tok0 FROM peek, tokens, p5.
    REAP lx0 FROM tok_lex, tok0.
    REAP ty0 FROM tok_type, tok0.
    IF lx0 IS "," AND ty0 ISNT "STRING",
      REAP com0 FROM consume, tokens, p5.
      REAP p5 FROM _second, com0.
    /IF.
    # closure argument: [MOVE x, REF y](v(NUM)) -> expr
    REAP ctok FROM peek, tokens, p5.
    REAP clx FROM tok_lex, ctok.
    IF clx IS "[",
      REAP clp FROM parse_closure, tokens, p5.
      REAP cnode FROM _first, clp.
      REAP p6 FROM _second, clp.
      IF COUNT cnode > 0,
        PUT "@@CLOSURE@@" INTO args.
        PUT cnode INTO clargs.
        SET p5 TO p6.
        REAP ctok2 FROM peek, tokens, p5.
        REAP clx2 FROM tok_lex, ctok2.
        IF clx2 IS ",",
          REAP ccom FROM consume, tokens, p5.
          REAP p5 FROM _second, ccom.
        /IF.
        IF clx2 IS ".",
          REAP cdot FROM consume, tokens, p5.
          REAP p6 FROM _second, cdot.
          GIVE plant_list_make(2, plant_list_make(10, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs), p6).
        /IF.
      /IF.
    /IF.
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(10, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs), p5).
    /IF.
    REAP tok FROM peek, tokens, p5.
    REAP lx FROM tok_lex, tok.
    REAP ty FROM tok_type, tok.
    IF lx IS "." AND ty ISNT "STRING",
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(10, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs), p6).
    /IF.
    # collect one argument until , or . at depth 0 (do NOT consume delimiter)
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM peek, tokens, p5.
      REAP alx FROM tok_lex, atok.
      REAP atype FROM tok_type, atok.
      IF atype IS "STRING",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "." AND adepth IS 0, BREAK 0. /IF.
      # ")" at depth 0 closes an enclosing closure block body
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM consume, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    PUT arg_text INTO args.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    IF lx2 IS ".",
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(10, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs), p6).
    /IF.
  /SEASON.
/ACTION.

ACTION parse_put_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_until, tokens, p2, "INTO".
  CREATE item TO vpair[0].
  REAP p3 FROM _second, vpair.
  REAP into_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, into_pair.
  REAP tpair FROM collect_until, tokens, p4, ".".
  CREATE target TO tpair[0].
  REAP p5 FROM _second, tpair.
  REAP dot_pair FROM consume, tokens, p5.
  REAP p6 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "put_stmt", "item", item, "target", target), p6).
/ACTION.

ACTION parse_break_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  IF p2 < COUNT tokens,
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF lx IS "0",
      REAP drop FROM consume, tokens, p2.
      REAP p2 FROM _second, drop.
    /IF.
  /IF.
  REAP dot_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "break_stmt"), p3).
/ACTION.

ACTION parse_continue_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP dot_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "continue_stmt"), p3).
/ACTION.

ACTION parse_if_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM consume, tokens, p3.
  REAP p4 FROM _second, com.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "if_stmt", "cond", cond, "body", body), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP if_close FROM consume, tokens, p5.
      REAP p6 FROM _second, if_close.
      REAP dot FROM consume, tokens, p6.
      REAP p7 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(6, "type", "if_stmt", "cond", cond, "body", body), p7).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_season_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM consume, tokens, p3.
  REAP p4 FROM _second, com.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP season_close FROM consume, tokens, p5.
      REAP p6 FROM _second, season_close.
      REAP dot FROM consume, tokens, p6.
      REAP p7 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p7).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_statement(tokens(LIST), pos(NUM)),
  SEASON TRUE,
    REAP tok FROM peek, tokens, pos.
    REAP tp FROM tok_type, tok.
    IF tp ISNT "DEPTH", BREAK 0. /IF.
    REAP drop_pair FROM consume, tokens, pos.
    REAP pos FROM _second, drop_pair.
  /SEASON.
  REAP tok FROM peek, tokens, pos.
  REAP lx FROM tok_lex, tok.
  IF lx IS "CREATE",
    REAP r FROM parse_create_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SHOW",
    REAP r FROM parse_show_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "GIVE",
    REAP r FROM parse_give_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SET",
    REAP r FROM parse_set_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "LET",
    REAP r FROM parse_let_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "IF",
    REAP r FROM parse_if_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SEASON",
    REAP r FROM parse_season_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "REAP",
    REAP r FROM parse_reap_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "PUT",
    REAP r FROM parse_put_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "BREAK",
    REAP r FROM parse_break_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "CONTINUE",
    REAP r FROM parse_continue_stmt, tokens, pos.
    GIVE r.
  /IF.
  GIVE plant_list_make(2, null, pos + 1).
/ACTION.

#── Declaration parsing ────────────────────────────────────────

ACTION parse_enum_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP name FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  REAP lbr FROM consume, tokens, p3.
  REAP p4 FROM _second, lbr.
  CREATE members(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "}",
      REAP rbr FROM consume, tokens, p4.
      REAP p5 FROM _second, rbr.
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p5).
    /IF.
    REAP m_pair FROM consume, tokens, p4.
    REAP mname FROM tok_lex, m_pair[0].
    REAP p5 FROM _second, m_pair.
    PUT mname INTO members.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
/ACTION.

ACTION parse_struct_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP sname FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  # generic type parameter list: [T, U] right after the struct name
  CREATE generics(LIST) TO plant_list_make(0).
  REAP sg_tok FROM peek, tokens, p3.
  REAP sg_lx FROM tok_lex, sg_tok.
  IF sg_lx IS "[",
    REAP sg_lb FROM consume, tokens, p3.
    REAP p3 FROM _second, sg_lb.
    REAP sgv FROM collect_type_text, tokens, p3, "]", 0.
    REAP sgtext FROM _first, sgv.
    REAP p3 FROM _second, sgv.
    REAP sg_rb FROM consume, tokens, p3.
    REAP p3 FROM _second, sg_rb.
    REAP sgparts FROM strings:SPLIT, sgtext, ",".
    CREATE sgi(NUM) TO 0.
    CREATE sge(TX) TO "".
    SEASON sgi < COUNT sgparts,
      REAP sge FROM plant_list_get, sgparts, sgi.
      REAP sget FROM trim, sge.
      IF sget > "",
        PUT sget INTO generics.
      /IF.
      SET sgi TO sgi + 1.
    /SEASON.
  /IF.
  REAP lb FROM consume, tokens, p3.
  REAP p4 FROM _second, lb.
  CREATE fields(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(8, "type", "struct_decl", "name", sname, "generics", generics, "fields", fields), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "}",
      REAP rb FROM consume, tokens, p4.
      REAP p5 FROM _second, rb.
      GIVE plant_list_make(2, plant_list_make(8, "type", "struct_decl", "name", sname, "generics", generics, "fields", fields), p5).
    /IF.
    REAP fn_pair FROM consume, tokens, p4.
    REAP fname FROM tok_lex, fn_pair[0].
    REAP p5 FROM _second, fn_pair.
    REAP col_pair FROM consume, tokens, p5.
    REAP p6 FROM _second, col_pair.
    REAP ftv FROM collect_type_text, tokens, p6, "}", 1.
    REAP ftype FROM _first, ftv.
    REAP p7 FROM _second, ftv.
    REAP ftypet FROM trim, ftype.
    PUT plant_list_make(4, "name", fname, "type", ftypet) INTO fields.
    REAP tok2 FROM peek, tokens, p7.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p7.
      REAP p7 FROM _second, com.
    /IF.
    SET p4 TO p7.
  /SEASON.
/ACTION.

ACTION parse_action_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP aname FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  # generic type parameter list: [T, U] right after the action name
  CREATE generics(LIST) TO plant_list_make(0).
  REAP ga_tok FROM peek, tokens, p3.
  REAP ga_lx FROM tok_lex, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM consume, tokens, p3.
    REAP p3 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p3, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p3 FROM _second, gv.
    REAP ga_rb FROM consume, tokens, p3.
    REAP p3 FROM _second, ga_rb.
    REAP gparts FROM strings:SPLIT, gtext, ",".
    CREATE gi2(NUM) TO 0.
    CREATE ge2(TX) TO "".
    SEASON gi2 < COUNT gparts,
      REAP ge2 FROM plant_list_get, gparts, gi2.
      REAP ge2t FROM trim, ge2.
      IF ge2t > "",
        PUT ge2t INTO generics.
      /IF.
      SET gi2 TO gi2 + 1.
    /SEASON.
  /IF.
  REAP lp FROM consume, tokens, p3.
  REAP p4 FROM _second, lp.
  CREATE params(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(10, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", plant_list_make(0)), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS ")",
      REAP rp FROM consume, tokens, p4.
      REAP p5 FROM _second, rp.
      CREATE brk(NUM) TO 0.
      BREAK 0.
    /IF.
    REAP pn_pair FROM consume, tokens, p4.
    REAP pn FROM tok_lex, pn_pair[0].
    REAP p5 FROM _second, pn_pair.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS "(",
      REAP lp2 FROM consume, tokens, p5.
      REAP p6 FROM _second, lp2.
      # collect the full type text: T, LIST[T], REF NUM, REF LIST[T] …
      REAP ptv FROM collect_type_text, tokens, p6, ")", 1.
      REAP pt FROM _first, ptv.
      REAP p7 FROM _second, ptv.
      # consume the closing ")" of the type group
      REAP rp2 FROM consume, tokens, p7.
      REAP p7 FROM _second, rp2.
      PUT plant_list_make(4, "name", pn, "type", pt) INTO params.
      SET p5 TO p7.
    /IF.
    IF lx2 ISNT "(",
      PUT plant_list_make(4, "name", pn, "type", "") INTO params.
    /IF.
    REAP tok3 FROM peek, tokens, p5.
    REAP lx3 FROM tok_lex, tok3.
    IF lx3 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
  # skip optional -> Type (then check if , or .)
  REAP arrow_tok FROM peek, tokens, p5.
  REAP arrow_lx FROM tok_lex, arrow_tok.
  IF arrow_lx IS "->",
    REAP arrow_pair FROM consume, tokens, p5.
    REAP p5 FROM _second, arrow_pair.
    # skip bogus MINUS=- token (lexer bug: -> produces extra MINUS)
    REAP skip_tok FROM peek, tokens, p5.
    REAP skip_ty FROM tok_type, skip_tok.
    IF skip_ty IS "MINUS",
      REAP skip_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, skip_pair.
    /IF.
    REAP ret_pair FROM consume, tokens, p5.
    REAP ret_lx FROM tok_lex, ret_pair[0].
    REAP p5 FROM _second, ret_pair.
    # Result<T, E> generics: -> Result<NUM, TX>. (E = TX error string)
    IF ret_lx IS "Result",
      REAP lt_tok FROM peek, tokens, p5.
      REAP lt_lx FROM tok_lex, lt_tok.
      IF lt_lx IS "<",
        REAP lt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, lt_pair.
        REAP rt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, rt_pair.
        REAP rc_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, rc_pair.
        REAP re_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, re_pair.
        REAP gt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, gt_pair.
      /IF.
    /IF.
    REAP after_tok FROM peek, tokens, p5.
    REAP after_lx FROM tok_lex, after_tok.
    IF after_lx IS ",",
      REAP com_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, com_pair.
    /IF.
    IF after_lx IS ".",
      REAP dot_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, dot_pair.
      IF ret_lx IS "external",
        GIVE plant_list_make(2, plant_list_make(6, "type", "external_decl", "name", aname, "params", params), p5).
      /IF.
      IF ret_lx IS "Result",
        GIVE plant_list_make(2, plant_list_make(6, "type", "external_decl", "name", aname, "params", params), p5).
      /IF.
      GIVE plant_list_make(2, plant_list_make(10, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", plant_list_make(0)), p5).
    /IF.
  /IF.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(10, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", body), p5).
    /IF.
    REAP tok4 FROM peek, tokens, p5.
    REAP lx4 FROM tok_lex, tok4.
    IF lx4 IS "/",
      REAP slash FROM consume, tokens, p5.
      REAP p6 FROM _second, slash.
      REAP end FROM consume, tokens, p6.
      REAP p7 FROM _second, end.
      REAP dot FROM consume, tokens, p7.
      REAP p8 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(10, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", body), p8).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p5.
    CREATE stmt TO stmt_pair[0].
    REAP p5 FROM _second, stmt_pair.
    IF stmt > "",
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_declaration(tokens(LIST), pos(NUM)),
  REAP tok FROM peek, tokens, pos.
  REAP lx FROM tok_lex, tok.
  IF lx IS "ENUM",
    REAP r FROM parse_enum_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "STRUCT",
    REAP r FROM parse_struct_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ACTION",
    REAP r FROM parse_action_decl, tokens, pos.
    GIVE r.
  /IF.
  REAP r FROM parse_statement, tokens, pos.
  GIVE r.
/ACTION.

#── Top-level ──────────────────────────────────────────────────

ACTION parse_program(tokens(LIST)),
  CREATE pos(NUM) TO 0.
  CREATE nodes(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, pos.
    IF is_eof_flag,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    REAP d_pair FROM parse_declaration, tokens, pos.
    CREATE decl TO d_pair[0].
    REAP pos2 FROM _second, d_pair.
    IF pos2 <= pos,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    SET pos TO pos2.
    IF decl > "",
      PUT decl INTO nodes.
    /IF.
  /SEASON.
/ACTION.
# ═══════════════════════════════════════════════════════════════
#  src/plantc/codegen_c.plant — PlantLang → C99 Code Generator
#
#  Consumes AST maps produced by src/plantc/parser.plant and
#  emits valid C99 source compatible with <plant_runtime.h>.
#
#  Node types handled:
#    show_stmt, create_stmt, let_stmt, set_stmt, give_stmt,
#    reap_stmt, put_stmt, break_stmt, continue_stmt,
#    if_stmt, season_stmt, cycle_stmt, match_stmt,
#    action_decl, enum_decl, program
# ═══════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────
#  _substr — extract substring [start, end) from str
# ──────────────────────────────────────────────────────────────
ACTION _substr(str(TX), start(NUM), end(NUM)),
    GIVE substring(str, start, end).
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_func — translate "KW varname" -> "CFN(varname)"
# ──────────────────────────────────────────────────────────────
ACTION _handle_func(expr(TX), kw(TX), cfn(TX)),
    REAP parts FROM strings:SPLIT, expr, kw + " ".
    IF COUNT parts IS 1, GIVE expr. /IF.
    REAP p0 FROM plant_list_get, parts, 0.
    CREATE res(TX) TO p0.
    CREATE idx(NUM) TO 1.
    SEASON idx < COUNT parts,
        REAP cur FROM plant_list_get, parts, idx.
        REAP pos FROM find_any, cur, " +)(".
        IF pos IS -1, SET pos TO LEN(cur). /IF.
        REAP vname FROM substring, cur, 0, pos.
        REAP rest FROM substring, cur, pos, LEN(cur).
        SET res TO res + cfn + "(" + vname + ")" + rest.
        SET idx TO idx + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_func_paren — translate "LEN(expr)" -> "strlen(expr)"
# ──────────────────────────────────────────────────────────────
ACTION _handle_func_paren(expr(TX), kw(TX), cfn(TX)),
    REAP parts FROM strings:SPLIT, expr, kw + " (".
    IF COUNT parts IS 1,
        REAP parts FROM strings:SPLIT, expr, kw + "(".
    /IF.
    IF COUNT parts IS 1, GIVE expr. /IF.
    REAP p0 FROM plant_list_get, parts, 0.
    CREATE res(TX) TO p0.
    CREATE idx(NUM) TO 1.
    SEASON idx < COUNT parts,
        REAP p FROM plant_list_get, parts, idx.
        SET res TO res + cfn + "(" + p.
        SET idx TO idx + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_cat — convert + to _cat() for string concatenation
#  Only converts when string literals (") are present in expr
#  NOTE: does NOT handle quoted + inside string literals correctly
#  so it should only be called on show_stmt values which rarely
#  contain string literals with + as delimiter arguments
# ──────────────────────────────────────────────────────────────
ACTION _handle_cat(expr(TX)),
    CREATE parts(LIST) TO plant_list_make(0).
    CREATE depth(NUM) TO 0.
    CREATE instr(NUM) TO 0.
    CREATE i(NUM) TO 0.
    CREATE ch(TX) TO "".
    CREATE c0(TX) TO "".
    CREATE c1(TX) TO "".
    CREATE seg(TX) TO "".
    CREATE start(NUM) TO 0.
    CREATE res(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE pel(TX) TO "".
    CREATE has_str(NUM) TO 0.
    CREATE has_digit(NUM) TO 0.
    # scan for top-level " + " (outside parens and strings) and split there
    SEASON i < LEN(expr),
        REAP ch FROM char_at, expr, i.
        IF ch IS "\"", SET instr TO 1 - instr. SET has_str TO 1. /IF.
        IF instr IS 1 AND ch IS "\\", SET i TO i + 1. /IF.
        REAP isdigit FROM find_any, ch, "0123456789".
        IF isdigit ISNT -1, SET has_digit TO 1. /IF.
        IF instr IS 0 AND ch IS "(", SET depth TO depth + 1. /IF.
        IF instr IS 0 AND ch IS ")", SET depth TO depth - 1. /IF.
        IF instr IS 0 AND ch IS "+" AND depth IS 0,
            REAP c0 FROM char_at, expr, i - 1.
            REAP c1 FROM char_at, expr, i + 1.
            IF c0 IS " " AND c1 IS " ",
                REAP seg FROM substring, expr, start, i - 1.
                PUT seg INTO parts.
                SET start TO i + 2.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    IF (COUNT parts) IS 0, GIVE expr. /IF.
    IF has_str IS 0 AND has_digit IS 1,
        GIVE strings_REPLACE(expr, " + ", "+").
    /IF.
    REAP seg FROM substring, expr, start, LEN(expr).
    PUT seg INTO parts.
    CREATE nparts(LIST) TO plant_list_make(0).
    CREATE ni(NUM) TO 0.
    CREATE pel2(TX) TO "".
    CREATE pel2b(TX) TO "".
    CREATE pd(NUM) TO 0.
    CREATE pj(NUM) TO 0.
    CREATE pc(TX) TO "".
    SEASON ni < COUNT parts,
        REAP pel2 FROM plant_list_get, parts, ni.
        REAP pel2b FROM strings:REPLACE, pel2, " ", "".
        SET pd TO 1.
        IF pel2b IS "", SET pd TO 0. /IF.
        SET pj TO 0.
        SEASON pj < LEN(pel2b),
            REAP pc FROM char_at, pel2b, pj.
            IF pc ISNT "0" AND pc ISNT "1" AND pc ISNT "2" AND pc ISNT "3" AND pc ISNT "4" AND pc ISNT "5" AND pc ISNT "6" AND pc ISNT "7" AND pc ISNT "8" AND pc ISNT "9",
                SET pd TO 0.
            /IF.
            SET pj TO pj + 1.
        /SEASON.
        IF pd IS 1,
            SET pel2 TO "_from_long(" + pel2 + ")".
        /IF.
        PUT pel2 INTO nparts.
        SET ni TO ni + 1.
    /SEASON.
    SET res TO nparts[0].
    SET pi TO 1.
    SEASON pi < COUNT nparts,
        REAP pel FROM plant_list_get, nparts, pi.
        SET res TO "_cat(" + res + ", " + pel + ")".
        SET pi TO pi + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  collect_implicit — REAP targets never declared (params,
#  CREATE/LET) in an action body; auto-declare them as tx_t.
# ──────────────────────────────────────────────────────────────
ACTION collect_declared_walk(bd(LIST), declared(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "create_stmt" OR ty IS "let_stmt",
      REAP tgt FROM _map_get, nd, "target".
      PUT tgt INTO declared.
    /IF.
    IF ty IS "if_stmt" OR ty IS "season_stmt",
      REAP sub_bd FROM _map_get, nd, "body".
      REAP sub_ret FROM collect_declared_walk, sub_bd, declared.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE "ok".
/ACTION.

ACTION collect_used_walk(bd(LIST), used(LIST), declared(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "reap_stmt",
      REAP tgt FROM _map_get, nd, "target".
      CREATE found(NUM) TO 0.
      CREATE fi(NUM) TO 0.
      CREATE fe(TX) TO "".
      SEASON fi < COUNT declared,
        REAP fe FROM plant_list_get, declared, fi.
        IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
        SET fi TO fi + 1.
      /SEASON.
      SET fi TO 0.
      SEASON fi < COUNT used,
        REAP fe FROM plant_list_get, used, fi.
        IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
        SET fi TO fi + 1.
      /SEASON.
      IF NOT found,
        PUT tgt INTO used.
      /IF.
    /IF.
    IF ty IS "if_stmt" OR ty IS "season_stmt",
      REAP sub_bd FROM _map_get, nd, "body".
      REAP sub_ret FROM collect_used_walk, sub_bd, used, declared.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE "ok".
/ACTION.

ACTION collect_implicit(bd(LIST), params(LIST)),
  CREATE used(LIST) TO plant_list_make(0).
  CREATE declared(LIST) TO plant_list_make(0).
  CREATE ci(NUM) TO 0.
  CREATE pn(TX) TO "".
  SEASON ci < COUNT params,
    REAP pn FROM _map_get, params[ci], "name".
    PUT pn INTO declared.
    SET ci TO ci + 1.
  /SEASON.
  REAP sub_ret FROM collect_declared_walk, bd, declared.
  REAP sub_ret FROM collect_used_walk, bd, used, declared.
  GIVE used.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  translate_expr — PlantLang → C expression translation
# ──────────────────────────────────────────────────────────────
ACTION translate_expr(expr(TX)),
    CREATE e(TX) TO expr.
    REAP e FROM strings:REPLACE, e, "GREATER THAN OR EQUAL", ">=".
    REAP e FROM strings:REPLACE, e, "LESS THAN OR EQUAL", "<=".
    REAP e FROM strings:REPLACE, e, "GREATER THAN", ">".
    REAP e FROM strings:REPLACE, e, "LESS THAN", "<".
    REAP e FROM strings:REPLACE, e, "ISNT", "!=".
    REAP e FROM strings:REPLACE, e, "STAR_STAR", "**".
    REAP e FROM strings:REPLACE, e, " AND ", " && ".
    REAP e FROM strings:REPLACE, e, " OR ", " || ".
    REAP e FROM strings:REPLACE, e, "NOT ", "!".
    REAP e FROM strings:REPLACE, e, " IS ", " == ".
    REAP e FROM _handle_func, e, "COUNT", "plant_array_length".
    REAP e FROM _handle_func_paren, e, "LEN", "strlen".
    REAP e FROM _handle_func, e, "TEST", "!".
    REAP e FROM strings:REPLACE, e, "TRUE", "1".
    REAP e FROM strings:REPLACE, e, "FALSE", "0".
    REAP e FROM strings:REPLACE, e, "NULL", "NULL".
    REAP e FROM strings:REPLACE, e, " : ", "_".
    REAP e FROM handle_brackets, e.
    GIVE e.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  indent_str — generate indentation whitespace
# ──────────────────────────────────────────────────────────────
ACTION indent_str(level(NUM)),
    CREATE res(TX) TO "".
    CREATE i(NUM) TO 0.
    SEASON i < level,
        SET res TO res + "  ".
        SET i TO i + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  generate_body — generate C code for a list of AST nodes
#  clmap: closure-var map (flat [varname, closurenode]) for the
#  current C function scope (REAP action name lookup for closure
#  invocation); an empty list means no closures are in scope.
# ──────────────────────────────────────────────────────────────
ACTION generate_body(bd(LIST), indent(NUM), sigs(LIST), subst(LIST), clmap(LIST)),
    CREATE res(TX) TO "".
    CREATE i(NUM) TO 0.
    CREATE node_el(TX) TO "".
    SEASON i < COUNT bd,
        REAP node_el FROM plant_list_get, bd, i.
        REAP node_code FROM generate_node, node_el, indent, sigs, subst, clmap.
        IF node_code > "",
            SET res TO res + node_code.
        /IF.
        SET i TO i + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  generate_node — dispatch AST node by type
#  clmap: closure-var map (flat [varname, closurenode]) for the
#  current C function scope; "" (missing key) → empty list.
# ──────────────────────────────────────────────────────────────
ACTION generate_node(node, indent(NUM), sigs(LIST), subst(LIST), clmap(LIST)),
    REAP ntype FROM _map_get, node, "type".
    IF clmap IS "",
        SET clmap TO plant_list_make(0).
    /IF.
  
    # ── show_stmt: SHOW expr. → plant_print(expr); ────────────
    IF ntype IS "show_stmt",
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval.
        REAP isel FROM indent_str, indent.
        GIVE isel + "  plant_print(" + cval + ");\n".
    /IF.
  
    # ── create_stmt: CREATE var(TYPE) TO val. → long/TX var = val; ─
    IF ntype IS "create_stmt",
        REAP target FROM _map_get, node, "target".
        REAP vtype FROM _map_get, node, "var_type".
        REAP vtype FROM subst_type, vtype, subst.
        REAP isel FROM indent_str, indent.
        REAP cnd FROM _map_get, node, "closure".
        IF cnd > "",
            REAP envname FROM _map_get, cnd, "envname".
            REAP caps FROM _map_get, cnd, "clcaps".
            REAP moved FROM _map_get, cnd, "moved".
            REAP cid2 FROM _map_get, cnd, "cid".
            CREATE ccode2(TX) TO isel + "  tx_t " + target + " = (tx_t)0;\n".
            SET ccode2 TO ccode2 + isel + "  { " + envname + "* __env_" + cid2 + " = (" + envname + "*)plant_env_alloc(sizeof(" + envname + "));\n".
            CREATE cpi(NUM) TO 0.
            CREATE capn(TX) TO "".
            CREATE capi(TX) TO "".
            SEASON cpi + 1 < COUNT caps,
                REAP capn FROM plant_list_get, caps, cpi.
                REAP capi FROM plant_list_get, caps, cpi + 1.
                SET ccode2 TO ccode2 + isel + "    __env_" + cid2 + "->" + capn + " = " + capi + ";\n".
                SET cpi TO cpi + 2.
            /SEASON.
            SET ccode2 TO ccode2 + isel + "    " + target + " = (tx_t)__env_" + cid2 + ";\n".
            SET ccode2 TO ccode2 + isel + "  }\n".
            CREATE cmi(NUM) TO 0.
            CREATE cmv(TX) TO "".
            SEASON cmi < COUNT moved,
                REAP cmv FROM plant_list_get, moved, cmi.
                SET ccode2 TO ccode2 + isel + "  " + cmv + " = 0;\n".
                SET cmi TO cmi + 1.
            /SEASON.
            GIVE ccode2.
        /IF.
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval.
        IF vtype IS "NUM",
            GIVE isel + "  long " + target + " = " + cval + ";\n".
        /IF.
        IF vtype IS "FACT",
            GIVE isel + "  int " + target + " = " + cval + ";\n".
        /IF.
        IF vtype IS "LIST",
            GIVE isel + "  PlantArray* " + target + " = " + cval + ";\n".
        /IF.
        IF vtype ISNT "NUM" AND vtype ISNT "FACT" AND vtype ISNT "LIST",
            GIVE isel + "  tx_t " + target + " = " + cval + ";\n".
        /IF.
    /IF.
  
    # ── set_stmt: SET target TO val. → target = val; ──────────
    IF ntype IS "set_stmt",
        REAP target FROM _map_get, node, "target".
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval.
        REAP isel FROM indent_str, indent.
        GIVE isel + "  " + target + " = " + cval + ";\n".
    /IF.
  
    # ── let_stmt: LET var AS TYPE IS val. → type var = val; ──
    IF ntype IS "let_stmt",
        REAP target FROM _map_get, node, "target".
        REAP vtype FROM _map_get, node, "var_type".
        REAP vtype FROM subst_type, vtype, subst.
        REAP isel FROM indent_str, indent.
        REAP cnd FROM _map_get, node, "closure".
        IF cnd > "",
            REAP envname FROM _map_get, cnd, "envname".
            REAP caps FROM _map_get, cnd, "clcaps".
            REAP moved FROM _map_get, cnd, "moved".
            REAP cid2 FROM _map_get, cnd, "cid".
            CREATE ccode2(TX) TO isel + "  tx_t " + target + " = (tx_t)0;\n".
            SET ccode2 TO ccode2 + isel + "  { " + envname + "* __env_" + cid2 + " = (" + envname + "*)plant_env_alloc(sizeof(" + envname + "));\n".
            CREATE cpi(NUM) TO 0.
            CREATE capn(TX) TO "".
            CREATE capi(TX) TO "".
            SEASON cpi + 1 < COUNT caps,
                REAP capn FROM plant_list_get, caps, cpi.
                REAP capi FROM plant_list_get, caps, cpi + 1.
                SET ccode2 TO ccode2 + isel + "    __env_" + cid2 + "->" + capn + " = " + capi + ";\n".
                SET cpi TO cpi + 2.
            /SEASON.
            SET ccode2 TO ccode2 + isel + "    " + target + " = (tx_t)__env_" + cid2 + ";\n".
            SET ccode2 TO ccode2 + isel + "  }\n".
            CREATE cmi(NUM) TO 0.
            CREATE cmv(TX) TO "".
            SEASON cmi < COUNT moved,
                REAP cmv FROM plant_list_get, moved, cmi.
                SET ccode2 TO ccode2 + isel + "  " + cmv + " = 0;\n".
                SET cmi TO cmi + 1.
            /SEASON.
            GIVE ccode2.
        /IF.
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval.
        IF vtype IS "NUM",
            GIVE isel + "  long " + target + " = " + cval + ";\n".
        /IF.
        IF vtype ISNT "NUM",
            GIVE isel + "  tx_t " + target + " = " + cval + ";\n".
        /IF.
    /IF.
  
    # ── give_stmt: GIVE val. → return val; ────────────────────
    IF ntype IS "give_stmt",
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val.
        REAP cval FROM _handle_cat, cval.
        REAP isel FROM indent_str, indent.
        GIVE isel + "  return " + cval + ";\n".
    /IF.
  
    # ── break_stmt → break; ───────────────────────────────────
    IF ntype IS "break_stmt",
        REAP isel FROM indent_str, indent.
        GIVE isel + "  break;\n".
    /IF.
  
    # ── continue_stmt → continue; ─────────────────────────────
    IF ntype IS "continue_stmt",
        REAP isel FROM indent_str, indent.
        GIVE isel + "  continue;\n".
    /IF.
  
    # ── put_stmt: PUT item INTO target. → plant_array_push(…) ─
    IF ntype IS "put_stmt",
        REAP item FROM _map_get, node, "item".
        REAP target FROM _map_get, node, "target".
        REAP citem FROM translate_expr, item.
        REAP citem FROM _handle_cat, citem.
        REAP isel FROM indent_str, indent.
        GIVE isel + "  " + target + " = plant_list_push(" + target + ", " + citem + ");\n".
    /IF.
  
    # ── reap_stmt: REAP var FROM action, args. → var = action(…); ─
    # Generic calls (action[T1, T2]) emit the mangled monomorphized name.
    IF ntype IS "reap_stmt",
        REAP tgt FROM _map_get, node, "target".
        REAP act FROM _map_get, node, "action".
        REAP act FROM strings:REPLACE, act, ":", "_".
        CREATE callname(TX) TO act.
        CREATE fparams(LIST) TO plant_list_make(0).
        CREATE gi(NUM) TO -1.
        REAP gi FROM find_any, act, "[".
        IF gi ISNT -1,
            REAP sact FROM subst_reap_act, act, subst.
            REAP base FROM base_of, sact.
            REAP gargs FROM parse_type_args, sact.
            REAP mname FROM mangle, base, gargs.
            SET callname TO mname.
            REAP fparams FROM find_params, sigs, base.
        /IF.
        IF gi IS -1,
            REAP fparams FROM find_params, sigs, act.
        /IF.
        # closure-var invocation: REAP r FROM f, … where f holds a
        # closure created in this scope → r = plant_Closure_N_fn((tx_t)f, …)
        REAP cvar FROM _cl_map_get, clmap, act.
        CREATE clcall(TX) TO "".
        IF cvar > "",
            REAP cfn FROM _map_get, cvar, "fnname".
            SET callname TO cfn.
            SET clcall TO "(tx_t)" + act + ", ".
        /IF.
        CREATE args(LIST) TO _map_get(node, "args").
        CREATE clargs(LIST) TO plant_list_make(0).
        REAP clargs FROM _map_get, node, "clargs".
        IF clargs IS "",
            SET clargs TO plant_list_make(0).
        /IF.
        CREATE argstr(TX) TO "".
        CREATE clpre(TX) TO "".
        CREATE clclears(TX) TO "".
        CREATE ai(NUM) TO 0.
        CREATE arg_el(TX) TO "".
        REAP isel FROM indent_str, indent.
        SEASON ai < COUNT args,
            REAP arg_el FROM plant_list_get, args, ai.
            CREATE aexpr(TX) TO arg_el.
            # closure argument: emit the env-init prelude, pass the env
            CREATE cl_ok(TX) TO "0".
            REAP cl_ok FROM _cl_is_arg, arg_el.
            IF cl_ok IS "1",
                REAP cnd FROM plant_list_get, clargs, ai.
                CREATE cndok(TX) TO "0".
                IF cnd > "",
                    SET cndok TO "1".
                /IF.
                IF cndok IS "1",
                    REAP envname FROM _map_get, cnd, "envname".
                    REAP caps FROM _map_get, cnd, "clcaps".
                    REAP moved FROM _map_get, cnd, "moved".
                    SET clpre TO clpre + isel + "  tx_t __carg_" + ai + ";\n".
                    SET clpre TO clpre + isel + "  { " + envname + "* __env_" + ai + " = (" + envname + "*)plant_env_alloc(sizeof(" + envname + "));\n".
                    CREATE cpi(NUM) TO 0.
                    CREATE capn(TX) TO "".
                    CREATE capi(TX) TO "".
                    SEASON cpi + 1 < COUNT caps,
                        REAP capn FROM plant_list_get, caps, cpi.
                        REAP capi FROM plant_list_get, caps, cpi + 1.
                        SET clpre TO clpre + isel + "    __env_" + ai + "->" + capn + " = " + capi + ";\n".
                        SET cpi TO cpi + 2.
                    /SEASON.
                    SET clpre TO clpre + isel + "    __carg_" + ai + " = (tx_t)__env_" + ai + ";\n".
                    SET clpre TO clpre + isel + "  }\n".
                    CREATE cmi(NUM) TO 0.
                    CREATE cmv(TX) TO "".
                    SEASON cmi < COUNT moved,
                        REAP cmv FROM plant_list_get, moved, cmi.
                        SET clclears TO clclears + isel + "  " + cmv + " = 0;\n".
                        SET cmi TO cmi + 1.
                    /SEASON.
                    SET aexpr TO "__carg_" + ai.
                /IF.
                IF cndok IS "0",
                    SET aexpr TO arg_el.
                /IF.
            /IF.
            # plain argument: translate + REF handling
            IF cl_ok IS "0",
                REAP arg0 FROM substring, arg_el, 0, 1.
                IF arg0 ISNT "\"",
                    REAP aexpr FROM translate_expr, arg_el.
                    REAP aexpr FROM _handle_cat, aexpr.
                /IF.
                REAP rp FROM is_ref_at, fparams, ai.
                IF rp IS "1",
                    SET aexpr TO "&" + aexpr.
                /IF.
            /IF.
            IF ai > 0, SET argstr TO argstr + ", ". /IF.
            SET argstr TO argstr + aexpr.
            SET ai TO ai + 1.
        /SEASON.
        IF tgt IS "_",
            GIVE clpre + isel + "  " + callname + "(" + clcall + argstr + ");\n" + clclears.
        /IF.
        IF tgt ISNT "_",
            GIVE clpre + isel + "  " + tgt + " = " + callname + "(" + clcall + argstr + ");\n" + clclears.
        /IF.
    /IF.
  
    # ── if_stmt: IF cond, body /IF. ──────────────────────────
    IF ntype IS "if_stmt",
        REAP cond FROM _map_get, node, "cond".
        REAP bd FROM _map_get, node, "body".
        REAP ccond FROM translate_expr, cond.
        REAP ccond FROM handle_strcmp, ccond.
        REAP isel FROM indent_str, indent.
        CREATE ccode(TX) TO isel + "  if (" + ccond + ") \{\n".
        REAP bcode FROM generate_body, bd, indent + 2, sigs, subst, clmap.
        SET ccode TO ccode + bcode + isel + "  \}\n".
        GIVE ccode.
    /IF.
  
    # ── season_stmt: SEASON cond, body /SEASON. → while(cond) {…} ─
    IF ntype IS "season_stmt",
        REAP cond FROM _map_get, node, "cond".
        REAP bd FROM _map_get, node, "body".
        REAP ccond FROM translate_expr, cond.
        REAP ccond FROM handle_strcmp, ccond.
        REAP isel FROM indent_str, indent.
        CREATE ccode(TX) TO isel + "  while (" + ccond + ") \{\n".
        REAP bcode FROM generate_body, bd, indent + 2, sigs, subst, clmap.
        SET ccode TO ccode + bcode + isel + "  \}\n".
        GIVE ccode.
    /IF.
  
    # ── cycle_stmt: FROM/TO → for(iter=from; iter<=to; iter+=step) ─
    IF ntype IS "cycle_stmt",
        REAP ivar FROM _map_get, node, "iterVar".
        REAP fromExpr FROM _map_get, node, "fromExpr".
        REAP toExpr FROM _map_get, node, "toExpr".
        REAP stepExpr FROM _map_get, node, "stepExpr".
        REAP listExpr FROM _map_get, node, "listExpr".
        REAP indexVar FROM _map_get, node, "indexVar".
        REAP bd FROM _map_get, node, "body".
        REAP isel FROM indent_str, indent.
        CREATE ccode(TX) TO "".
    
        # FROM/TO form
        IF fromExpr ISNT "",
            REAP cfrom FROM translate_expr, fromExpr.
            REAP cto FROM translate_expr, toExpr.
            CREATE stepstr(TX) TO "1".
            IF stepExpr > "" AND stepExpr ISNT "null",
                REAP cstep FROM translate_expr, stepExpr.
                SET stepstr TO cstep.
            /IF.
            SET ccode TO isel + "  for (long " + ivar + " = " + cfrom + "; " + ivar + " <= " + cto + "; " + ivar + " += " + stepstr + ") \{\n".
            REAP bcode FROM generate_body, bd, indent + 2, sigs, subst, clmap.
            SET ccode TO ccode + bcode + isel + "  \}\n".
            GIVE ccode.
        /IF.
    
        # IN list form (CYCLE var IN list)
        IF listExpr ISNT "",
            CREATE idxvar(TX) TO "__cycle_i".
            IF indexVar ISNT "" AND indexVar ISNT "null",
                SET idxvar TO indexVar.
            /IF.
            REAP clist FROM translate_expr, listExpr.
            SET ccode TO isel + "  \{\n".
            SET ccode TO ccode + isel + "    long " + idxvar + " = 0;\n".
            SET ccode TO ccode + isel + "    while (" + idxvar + " < plant_array_length(" + clist + ")) \{\n".
            SET ccode TO ccode + isel + "      tx_t " + ivar + " = plant_array_get(" + clist + ", " + idxvar + ");\n".
            REAP bcode FROM generate_body, bd, indent + 4, sigs, subst, clmap.
            SET ccode TO ccode + bcode + isel + "      " + idxvar + "++;\n".
            SET ccode TO ccode + isel + "    }\n".
            SET ccode TO ccode + isel + "  }\n".
            GIVE ccode.
        /IF.
    
        GIVE "".
    /IF.
  
    # ── match_stmt: MATCH expr { Variant -> { stmts } } → switch ─
    IF ntype IS "match_stmt",
        REAP subj FROM _map_get, node, "subjectExpr".
        CREATE clauses(LIST) TO _map_get(node, "clauses").
        REAP csubj FROM translate_expr, subj.
        REAP isel FROM indent_str, indent.
        CREATE ccode(TX) TO isel + "  switch (" + csubj + ") \{\n".
        CREATE ci(NUM) TO 0.
        CREATE clause(TX) TO "".
        SEASON ci < COUNT clauses,
            REAP clause FROM plant_list_get, clauses, ci.
            REAP vname FROM _map_get, clause, "variantName".
            REAP binding FROM _map_get, clause, "binding".
            REAP cbody FROM _map_get, clause, "bodyStatements".
            SET ccode TO ccode + isel + "    case " + vname + ":\n".
            IF binding > "" AND binding ISNT "null",
                SET ccode TO ccode + isel + "      \{\n".
                SET ccode TO ccode + isel + "        tx_t " + binding + " = " + csubj + ";\n".
                REAP bcode FROM generate_body, cbody, indent + 4, sigs, subst, clmap.
                SET ccode TO ccode + bcode + isel + "      \}\n".
            /IF.
            IF binding IS "" OR binding IS "null",
                REAP bcode FROM generate_body, cbody, indent + 4, sigs, subst, clmap.
                SET ccode TO ccode + bcode.
            /IF.
            SET ccode TO ccode + isel + "      break;\n".
            SET ci TO ci + 1.
        /SEASON.
        SET ccode TO ccode + isel + "  \}\n".
        GIVE ccode.
    /IF.
  
    # ── external_decl: ACTION name(params) -> external. → no code (plant_compat.h) ─
    IF ntype IS "external_decl",
        GIVE "".
    /IF.

    # ── struct_decl: STRUCT name { field: TYPE, … } → no code here;
    #    typedefs (plain + mangled instantiations) come from the
    #    structs table pass in generate_c.
    IF ntype IS "struct_decl",
        GIVE "".
    /IF.

    # ── action_decl: ACTION name(params), body /ACTION. → void name(…) {…} ─
    # Generic templates emit nothing here; monomorphized copies are emitted
    # separately for each instantiation (see emit_inst).
    IF ntype IS "action_decl",
        CREATE gens_nd(LIST) TO _map_get(node, "generics").
        IF COUNT gens_nd IS 0,
            REAP aname FROM _map_get, node, "name".
            CREATE params(LIST) TO _map_get(node, "params").
            REAP bd FROM _map_get, node, "body".
        CREATE paramstr(TX) TO "".
        CREATE pi(NUM) TO 0.
        CREATE param_el(TX) TO "".
        SEASON pi < COUNT params,
            REAP param_el FROM plant_list_get, params, pi.
            REAP pname FROM _map_get, param_el, "name".
            REAP ptype FROM _map_get, param_el, "type".
            REAP ctype FROM plant_ctype, ptype.
            IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
            SET paramstr TO paramstr + ctype + " " + pname.
            SET pi TO pi + 1.
        /SEASON.
        CREATE ccode(TX) TO "tx_t " + aname + "(" + paramstr + ") \{\n".
        CREATE implicit(LIST) TO collect_implicit(bd, params).
        CREATE dcode(TX) TO "".
        CREATE di(NUM) TO 0.
        CREATE dv(TX) TO "".
        SEASON di < COUNT implicit,
            REAP dv FROM plant_list_get, implicit, di.
            SET dcode TO dcode + "  tx_t " + dv + " = \"\";\n".
            SET di TO di + 1.
        /SEASON.
        REAP bcode FROM generate_body, bd, 1, sigs, subst, clmap.
        IF (COUNT bd) IS 0,
            SET bcode TO "  return " + aname + ";\n".
        /IF.
        IF (COUNT bd) > 0,
            CREATE bd_count(NUM) TO COUNT bd.
            CREATE last_idx(NUM) TO bd_count - 1.
            CREATE last_nd(TX) TO plant_list_get(bd, last_idx).
            CREATE last_ty(TX) TO _map_get(last_nd, "type").
            IF last_ty ISNT "give_stmt", SET bcode TO bcode + "  return " + aname + ";\n". /IF.
        /IF.
        SET ccode TO ccode + dcode + bcode + "\}\n".
        GIVE ccode.
        /IF.
        GIVE "".
    /IF.
  
    # ── enum_decl: ENUM name { MEMBER, … } → typedef enum { … } name; ─
    IF ntype IS "enum_decl",
        REAP ename FROM _map_get, node, "name".
        CREATE members(LIST) TO _map_get(node, "members").
        CREATE ccode(TX) TO "typedef enum \{\n  ".
        CREATE mi(NUM) TO 0.
        CREATE member_el(TX) TO "".
        SEASON mi < COUNT members,
            REAP member_el FROM plant_list_get, members, mi.
            IF mi > 0, SET ccode TO ccode + ",\n  ". /IF.
            SET ccode TO ccode + member_el.
            SET mi TO mi + 1.
        /SEASON.
        SET ccode TO ccode + "\n\} " + ename + ";\n".
        GIVE ccode.
    /IF.
    GIVE "".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  plant_ctype — PlantLang param type → C type (REF → pointer)
#  Generic/container types (LIST[T]) are stripped to their base
#  before mapping, so LIST[NUM] → PlantArray*.
# ──────────────────────────────────────────────────────────────
ACTION type_base(ptype(TX)),
    REAP bi FROM find_any, ptype, "[".
    IF bi IS -1, GIVE ptype. /IF.
    REAP b FROM substring, ptype, 0, bi.
    REAP bt FROM trim, b.
    GIVE bt.
/ACTION.

ACTION plant_ctype(ptype(TX)),
    REAP base FROM type_base, ptype.
    IF base IS "NUM", GIVE "long". /IF.
    IF base IS "FACT", GIVE "int". /IF.
    IF base IS "LIST", GIVE "PlantArray*". /IF.
    IF base IS "REF NUM", GIVE "long*". /IF.
    IF base IS "REF FACT", GIVE "int*". /IF.
    IF base IS "REF LIST", GIVE "PlantArray**". /IF.
    IF base IS "REF TX", GIVE "tx_t*". /IF.
    GIVE "tx_t".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  trim — strip leading/trailing spaces
# ──────────────────────────────────────────────────────────────
ACTION trim(s(TX)),
    CREATE st(NUM) TO 0.
    CREATE en(NUM) TO LEN(s).
    SEASON st < en,
        REAP c FROM char_at, s, st.
        IF c ISNT " ", BREAK 0. /IF.
        SET st TO st + 1.
    /SEASON.
    SEASON en > st,
        REAP c FROM char_at, s, en - 1.
        IF c ISNT " ", BREAK 0. /IF.
        SET en TO en - 1.
    /SEASON.
    IF en <= st, GIVE "". /IF.
    GIVE substring(s, st, en).
/ACTION.

# ──────────────────────────────────────────────────────────────
#  Generics Engine — monomorphization helpers
#
#  subst is a flat key/value list [T, NUM, U, TX, …] mapping
#  generic type parameters to concrete types.
# ──────────────────────────────────────────────────────────────
ACTION subst_append(acc(TX), w(TX), subst(LIST)),
    CREATE fi(NUM) TO 0.
    CREATE fk(TX) TO "".
    CREATE fv(TX) TO "".
    SEASON fi + 1 < COUNT subst,
        REAP fk FROM plant_list_get, subst, fi.
        REAP fv FROM plant_list_get, subst, fi + 1.
        IF str_eq(fk, w) IS "1",
            GIVE acc + fv.
        /IF.
        SET fi TO fi + 2.
    /SEASON.
    GIVE acc + w.
/ACTION.

# subst_type — replace whole-token generic names inside a type
# string; separators are space ( ) [ ] ,
ACTION subst_type(t(TX), subst(LIST)),
    CREATE res(TX) TO "".
    CREATE w(TX) TO "".
    CREATE si(NUM) TO 0.
    CREATE ch(TX) TO "".
    SEASON si < LEN(t),
        REAP ch FROM char_at, t, si.
        IF ch IS " " OR ch IS "[" OR ch IS "]" OR ch IS "(" OR ch IS ")" OR ch IS ",",
            REAP res FROM subst_append, res, w, subst.
            SET w TO "".
            SET res TO res + ch.
        /IF.
        IF ch ISNT " " AND ch ISNT "[" AND ch ISNT "]" AND ch ISNT "(" AND ch ISNT ")" AND ch ISNT ",",
            SET w TO w + ch.
        /IF.
        SET si TO si + 1.
    /SEASON.
    REAP res FROM subst_append, res, w, subst.
    GIVE res.
/ACTION.

# subst_reap_act — substitute generic names inside the […] of an
# action name: foo[T] under T→NUM → foo[NUM]
ACTION subst_reap_act(act(TX), subst(LIST)),
    REAP bi FROM find_any, act, "[".
    IF bi IS -1, GIVE act. /IF.
    REAP head FROM substring, act, 0, bi.
    REAP tail FROM substring, act, bi, LEN(act).
    REAP stail FROM subst_type, tail, subst.
    GIVE head + stail.
/ACTION.

# base_of — action name without type args: foo[NUM] → foo
ACTION base_of(act(TX)),
    REAP bi FROM find_any, act, "[".
    IF bi IS -1, GIVE act. /IF.
    GIVE substring(act, 0, bi).
/ACTION.

# parse_type_args — extract the type-arg list from foo[NUM, TX]
ACTION parse_type_args(act(TX)),
    REAP bi FROM find_any, act, "[".
    REAP ei FROM find_any, act, "]".
    IF bi IS -1 OR ei IS -1, GIVE plant_list_make(0). /IF.
    IF ei <= bi + 1, GIVE plant_list_make(0). /IF.
    REAP inner FROM substring, act, bi + 1, ei.
    REAP parts FROM strings:SPLIT, inner, ",".
    CREATE out(LIST) TO plant_list_make(0).
    CREATE oi(NUM) TO 0.
    CREATE pe(TX) TO "".
    CREATE pt(TX) TO "".
    SEASON oi < COUNT parts,
        REAP pe FROM plant_list_get, parts, oi.
        REAP pt FROM trim, pe.
        IF pt > "",
            PUT pt INTO out.
        /IF.
        SET oi TO oi + 1.
    /SEASON.
    GIVE out.
/ACTION.

# mangle — unique C identifier: plant_<name>_<T1>_<T2>
ACTION mangle(base(TX), args(LIST)),
    CREATE res(TX) TO "plant_" + base.
    CREATE mi(NUM) TO 0.
    CREATE ae(TX) TO "".
    SEASON mi < COUNT args,
        REAP ae FROM plant_list_get, args, mi.
        SET res TO res + "_" + ae.
        SET mi TO mi + 1.
    /SEASON.
    GIVE res.
/ACTION.

# find_template — locate a generic action template by base name
# (returns a real empty LIST when missing, so COUNT on the result
# is safe — never the "" sentinel, which would be read as a list)
ACTION find_template(templates(LIST), base(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE found(LIST) TO plant_list_make(0).
    SEASON fi < COUNT templates,
        REAP fe FROM plant_list_get, templates, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, base) IS "1",
            SET found TO fe.
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE found.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  STRUCT generics — struct template table + instantiation scan
#
#  structs is a list of [name, generics, fields] maps. Struct
#  types map to tx_t in generated C (opaque handles); the
#  typedefs plant_<Name>[_<T1>_<T2>] are emitted so C FFI code
#  (mocks, libraries) can cast and read the concrete layout.
# ──────────────────────────────────────────────────────────────

# find_struct — locate a STRUCT template by base name
# (real empty LIST when missing — never the "" sentinel, so
# COUNT on the result is safe)
ACTION find_struct(structs(LIST), name(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE found(LIST) TO plant_list_make(0).
    SEASON fi < COUNT structs,
        REAP fe FROM plant_list_get, structs, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, name) IS "1",
            SET found TO fe.
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE found.
/ACTION.

# scan_type — collect every concrete struct instantiation named
# inside a type string (substituted first), recursing into the
# template's fields and into nested bracket args
# (LIST[Box[NUM]], Pair[NUM, Box[U]], Node[T] …).
ACTION scan_type(t(TX), subst(LIST), structs(LIST), acc(LIST)),
    CREATE st(TX) TO "".
    CREATE bi(NUM) TO -1.
    CREATE ai2b(NUM) TO -1.
    REAP st FROM subst_type, t, subst.
    REAP bi FROM find_any, st, "[".
    IF bi ISNT -1,
        REAP base FROM base_of, st.
        REAP btrim FROM trim, base.
        REAP rf FROM substring, btrim, 0, 4.
        IF rf IS "REF ",
            REAP btrim FROM substring, btrim, 4, LEN(btrim).
        /IF.
        REAP tpl FROM find_struct, structs, btrim.
        IF COUNT tpl > 0,
            REAP args FROM parse_type_args, st.
            REAP found FROM key_in_acc, st, acc.
            IF found IS "0",
                PUT st INTO acc.
                REAP generics FROM _map_get, tpl, "generics".
                REAP nsubst FROM build_subst, generics, args.
                REAP fields FROM _map_get, tpl, "fields".
                CREATE fi2(NUM) TO 0.
                CREATE fv(TX) TO "".
                SEASON fi2 < COUNT fields,
                    REAP fv FROM _map_get, fields[fi2], "type".
                    REAP acc FROM scan_type, fv, nsubst, structs, acc.
                    SET fi2 TO fi2 + 1.
                /SEASON.
            /IF.
        /IF.
        REAP args FROM parse_type_args, st.
        CREATE ai2(NUM) TO 0.
        CREATE av(TX) TO "".
        SEASON ai2 < COUNT args,
            REAP av FROM plant_list_get, args, ai2.
            REAP ai2b FROM find_any, av, "[".
            IF ai2b ISNT -1,
                REAP acc FROM scan_type, av, subst, structs, acc.
            /IF.
            SET ai2 TO ai2 + 1.
        /SEASON.
    /IF.
    GIVE acc.
/ACTION.

# scan_params — scan every param type of a decl
ACTION scan_params(params(LIST), subst(LIST), structs(LIST), acc(LIST)),
    CREATE pi(NUM) TO 0.
    CREATE pv(TX) TO "".
    SEASON pi < COUNT params,
        REAP pv FROM _map_get, params[pi], "type".
        REAP acc FROM scan_type, pv, subst, structs, acc.
        SET pi TO pi + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# scan_fields — scan every field type of a struct template
ACTION scan_fields(fields(LIST), subst(LIST), structs(LIST), acc(LIST)),
    CREATE fi(NUM) TO 0.
    CREATE fv(TX) TO "".
    SEASON fi < COUNT fields,
        REAP fv FROM _map_get, fields[fi], "type".
        REAP acc FROM scan_type, fv, subst, structs, acc.
        SET fi TO fi + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# collect_struct_insts — walk a body for struct-typed declarations
ACTION collect_struct_insts(bd(LIST), subst(LIST), structs(LIST), acc(LIST)),
    CREATE ci(NUM) TO 0.
    CREATE nd(TX) TO "".
    CREATE ty(TX) TO "".
    CREATE vt(TX) TO "".
    CREATE sub_bd(LIST) TO plant_list_make(0).
    SEASON ci < COUNT bd,
        REAP nd FROM plant_list_get, bd, ci.
        REAP ty FROM _map_get, nd, "type".
        IF ty IS "create_stmt" OR ty IS "let_stmt",
            REAP vt FROM _map_get, nd, "var_type".
            IF vt > "",
                REAP acc FROM scan_type, vt, subst, structs, acc.
            /IF.
        /IF.
        IF ty IS "if_stmt" OR ty IS "season_stmt",
            REAP sub_bd FROM _map_get, nd, "body".
            REAP acc FROM collect_struct_insts, sub_bd, subst, structs, acc.
        /IF.
        SET ci TO ci + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# struct_typedef — C typedef text for a struct template, optionally
# instantiated: typedef struct { … } plant_<Name>[_<T1>_<T2>];
ACTION struct_typedef(tpl(LIST), args(LIST)),
    REAP sname FROM _map_get, tpl, "name".
    REAP generics FROM _map_get, tpl, "generics".
    REAP fields FROM _map_get, tpl, "fields".
    REAP subst FROM build_subst, generics, args.
    CREATE tname(TX) TO "plant_" + sname.
    CREATE mi(NUM) TO 0.
    CREATE ae(TX) TO "".
    SEASON mi < COUNT args,
        REAP ae FROM plant_list_get, args, mi.
        SET tname TO tname + "_" + ae.
        SET mi TO mi + 1.
    /SEASON.
    CREATE ccode(TX) TO "typedef struct \{\n".
    CREATE fi(NUM) TO 0.
    CREATE fel(LIST) TO plant_list_make(0).
    CREATE fname(TX) TO "".
    CREATE ftype(TX) TO "".
    CREATE fsub(TX) TO "".
    CREATE ctype(TX) TO "".
    SEASON fi < COUNT fields,
        REAP fel FROM plant_list_get, fields, fi.
        REAP fname FROM _map_get, fel, "name".
        REAP ftype FROM _map_get, fel, "type".
        REAP fsub FROM subst_type, ftype, subst.
        REAP ctype FROM plant_ctype, fsub.
        SET ccode TO ccode + "  " + ctype + " " + fname + ";\n".
        SET fi TO fi + 1.
    /SEASON.
    SET ccode TO ccode + "\} " + tname + ";\n".
    GIVE ccode.
/ACTION.

# key_in_acc — is key already in the instantiation cache?
ACTION key_in_acc(key(TX), acc(LIST)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    SEASON fi < COUNT acc,
        REAP fe FROM plant_list_get, acc, fi.
        IF str_eq(fe, key) IS "1", GIVE "1". /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE "0".
/ACTION.

# build_subst — zip template generics with concrete type args
ACTION build_subst(generics(LIST), args(LIST)),
    CREATE subst(LIST) TO plant_list_make(0).
    CREATE zi(NUM) TO 0.
    CREATE gv(TX) TO "".
    CREATE av(TX) TO "".
    SEASON zi < COUNT generics,
        IF zi < COUNT args,
            REAP gv FROM plant_list_get, generics, zi.
            REAP av FROM plant_list_get, args, zi.
            PUT gv INTO subst.
            PUT av INTO subst.
        /IF.
        SET zi TO zi + 1.
    /SEASON.
    GIVE subst.
/ACTION.

# collect_insts — discover every concrete instantiation reachable
# from a body; walks into generic templates with the substituted
# type context. Functional accumulation (acc is returned).
ACTION collect_insts(bd(LIST), subst(LIST), templates(LIST), acc(LIST)),
    CREATE ci(NUM) TO 0.
    CREATE nd(TX) TO "".
    CREATE ty(TX) TO "".
    CREATE act(TX) TO "".
    CREATE gi(NUM) TO -1.
    SEASON ci < COUNT bd,
        REAP nd FROM plant_list_get, bd, ci.
        REAP ty FROM _map_get, nd, "type".
        IF ty IS "reap_stmt",
            REAP act FROM _map_get, nd, "action".
            REAP gi FROM find_any, act, "[".
            IF gi ISNT -1,
                REAP sact FROM subst_reap_act, act, subst.
                REAP base FROM base_of, sact.
                REAP tpl FROM find_template, templates, base.
                IF COUNT tpl > 0,
                    REAP found FROM key_in_acc, sact, acc.
                    IF found IS "0",
                        PUT sact INTO acc.
                        REAP args FROM parse_type_args, sact.
                        REAP generics FROM _map_get, tpl, "generics".
                        REAP nsubst FROM build_subst, generics, args.
                        REAP tbd FROM _map_get, tpl, "body".
                        REAP acc FROM collect_insts, tbd, nsubst, templates, acc.
                    /IF.
                /IF.
            /IF.
        /IF.
        IF ty IS "if_stmt" OR ty IS "season_stmt",
            REAP sub_bd FROM _map_get, nd, "body".
            REAP acc FROM collect_insts, sub_bd, subst, templates, acc.
        /IF.
        SET ci TO ci + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# inst_fwddecl — forward declaration for one instantiation
ACTION inst_fwddecl(inst(TX), templates(LIST)),
    REAP base FROM base_of, inst.
    REAP args FROM parse_type_args, inst.
    REAP tpl FROM find_template, templates, base.
    IF COUNT tpl IS 0, GIVE "". /IF.
    REAP generics FROM _map_get, tpl, "generics".
    REAP params FROM _map_get, tpl, "params".
    REAP subst FROM build_subst, generics, args.
    REAP mname FROM mangle, base, args.
    CREATE paramstr(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE param_el(TX) TO "".
    CREATE pname(TX) TO "".
    CREATE ptype(TX) TO "".
    CREATE psub(TX) TO "".
    CREATE ctype(TX) TO "".
    SEASON pi < COUNT params,
        REAP param_el FROM plant_list_get, params, pi.
        REAP pname FROM _map_get, param_el, "name".
        REAP ptype FROM _map_get, param_el, "type".
        REAP psub FROM subst_type, ptype, subst.
        REAP ctype FROM plant_ctype, psub.
        IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
        SET paramstr TO paramstr + ctype + " " + pname.
        SET pi TO pi + 1.
    /SEASON.
    GIVE "tx_t " + mname + "(" + paramstr + ");\n".
/ACTION.

# emit_inst — full body emission for one instantiation
ACTION emit_inst(inst(TX), templates(LIST), sigs(LIST)),
    REAP base FROM base_of, inst.
    REAP args FROM parse_type_args, inst.
    REAP tpl FROM find_template, templates, base.
    IF COUNT tpl IS 0, GIVE "". /IF.
    REAP generics FROM _map_get, tpl, "generics".
    REAP params FROM _map_get, tpl, "params".
    REAP bd FROM _map_get, tpl, "body".
    REAP subst FROM build_subst, generics, args.
    REAP mname FROM mangle, base, args.
    CREATE paramstr(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE param_el(TX) TO "".
    CREATE pname(TX) TO "".
    CREATE ptype(TX) TO "".
    CREATE psub(TX) TO "".
    CREATE ctype(TX) TO "".
    SEASON pi < COUNT params,
        REAP param_el FROM plant_list_get, params, pi.
        REAP pname FROM _map_get, param_el, "name".
        REAP ptype FROM _map_get, param_el, "type".
        REAP psub FROM subst_type, ptype, subst.
        REAP ctype FROM plant_ctype, psub.
        IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
        SET paramstr TO paramstr + ctype + " " + pname.
        SET pi TO pi + 1.
    /SEASON.
    CREATE ccode(TX) TO "tx_t " + mname + "(" + paramstr + ") \{\n".
    CREATE implicit(LIST) TO collect_implicit(bd, params).
    CREATE dcode(TX) TO "".
    CREATE di(NUM) TO 0.
    CREATE dv(TX) TO "".
    SEASON di < COUNT implicit,
        REAP dv FROM plant_list_get, implicit, di.
        SET dcode TO dcode + "  tx_t " + dv + " = \"\";\n".
        SET di TO di + 1.
    /SEASON.
    REAP bcode FROM generate_body, bd, 1, sigs, subst, plant_list_make(0).
    IF (COUNT bd) IS 0,
        SET bcode TO "  return " + mname + ";\n".
    /IF.
    IF (COUNT bd) > 0,
        CREATE bd_count(NUM) TO COUNT bd.
        CREATE last_idx(NUM) TO bd_count - 1.
        CREATE last_nd(TX) TO plant_list_get(bd, last_idx).
        CREATE last_ty(TX) TO _map_get(last_nd, "type").
        IF last_ty ISNT "give_stmt", SET bcode TO bcode + "  return " + mname + ";\n". /IF.
    /IF.
    SET ccode TO ccode + dcode + bcode + "\}\n".
    GIVE ccode.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  find_params — look up a decl's params by name in sigs
# ──────────────────────────────────────────────────────────────
ACTION find_params(sigs(LIST), name(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE fp(LIST) TO plant_list_make(0).
    SEASON fi < COUNT sigs,
        REAP fe FROM plant_list_get, sigs, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, name) IS "1",
            REAP fp FROM _map_get, fe, "params".
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE fp.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_ref_param — type string starts with "REF "
# ──────────────────────────────────────────────────────────────
ACTION is_ref_param(ptype(TX)),
    REAP pf FROM substring, ptype, 0, 4.
    IF pf IS "REF ", GIVE "1". /IF.
    GIVE "0".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_ref_at — params[idx] is a REF parameter
# ──────────────────────────────────────────────────────────────
ACTION is_ref_at(params(LIST), idx(NUM)),
    IF idx < COUNT params,
        REAP pel FROM plant_list_get, params, idx.
        REAP pty FROM _map_get, pel, "type".
        REAP rf FROM is_ref_param, pty.
        IF rf IS "1", GIVE "1". /IF.
    /IF.
    GIVE "0".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _map_get — safe MAP field access (external FFI)
# ──────────────────────────────────────────────────────────────
ACTION _map_get(m, key(TX)) -> external.
ACTION plant_list_get(lst, idx(NUM)) -> external.
ACTION char_at(s(TX), idx(NUM)) -> external.
ACTION substring(s(TX), start(NUM), end(NUM)) -> external.
ACTION find_any(s(TX), delims(TX)) -> external.
ACTION handle_brackets(expr(TX)) -> external.
ACTION handle_strcmp(expr(TX)) -> external.
ACTION str_eq(a(TX), b(TX)) -> external.

# ──────────────────────────────────────────────────────────────
#  generate_c — main entry point
# ──────────────────────────────────────────────────────────────
ACTION generate_c(ast(LIST)),
    CREATE header(TX) TO "#include <plant_compat.h>\n\n".
    CREATE decl_code(TX) TO "".
    CREATE stmt_code(TX) TO "".
    CREATE has_decl(NUM) TO 0.
    CREATE has_stmt(NUM) TO 0.
    CREATE i(NUM) TO 0.
    CREATE node_el(TX) TO "".
    CREATE pro_code(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE param_el(TX) TO "".
    CREATE pname(TX) TO "".
    CREATE ptype(TX) TO "".
    CREATE ctype(TX) TO "".
    CREATE aname(TX) TO "".
    CREATE paramstr(TX) TO "".
    # pass 0: signature table (sigs) for REF-param call-site rewriting +
    # generic action template table (templates) + struct template table (structs)
    CREATE sigs(LIST) TO plant_list_make(0).
    CREATE templates(LIST) TO plant_list_make(0).
    CREATE structs(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl" OR ntype IS "external_decl",
            REAP aname FROM _map_get, node_el, "name".
            CREATE params2(LIST) TO _map_get(node_el, "params").
            PUT plant_list_make(4, "name", aname, "params", params2) INTO sigs.
        /IF.
        IF ntype IS "action_decl",
            REAP aname FROM _map_get, node_el, "name".
            CREATE gens2(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens2 > 0,
                CREATE pms2(LIST) TO _map_get(node_el, "params").
                CREATE bd2(LIST) TO _map_get(node_el, "body").
                PUT plant_list_make(8, "name", aname, "generics", gens2, "params", pms2, "body", bd2) INTO templates.
            /IF.
        /IF.
        IF ntype IS "struct_decl",
            REAP sname FROM _map_get, node_el, "name".
            CREATE sgens2(LIST) TO _map_get(node_el, "generics").
            CREATE sfields2(LIST) TO _map_get(node_el, "fields").
            PUT plant_list_make(6, "name", sname, "generics", sgens2, "fields", sfields2) INTO structs.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 0b: discover every reachable generic instantiation
    # (generic template bodies are walked per-instantiation inside
    # collect_insts with the proper type substitution, never bare)
    CREATE insts(LIST) TO plant_list_make(0).
    CREATE esub(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            CREATE gens5(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens5 IS 0,
                CREATE bd3(LIST) TO _map_get(node_el, "body").
                REAP insts FROM collect_insts, bd3, esub, templates, insts.
            /IF.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP insts FROM collect_insts, plant_list_make(1, node_el), esub, templates, insts.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 0c: discover every reachable struct instantiation from
    # type positions (params, struct fields, typed vars). Generic
    # struct templates are only scanned per-instantiation with the
    # substituted type context — never bare (avoids phantom T-typed
    # typedefs like plant_Box_T).
    CREATE structs_insts(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            CREATE gs5(LIST) TO _map_get(node_el, "generics").
            IF COUNT gs5 IS 0,
                CREATE ps5(LIST) TO _map_get(node_el, "params").
                CREATE bd5(LIST) TO _map_get(node_el, "body").
                REAP structs_insts FROM scan_params, ps5, esub, structs, structs_insts.
                REAP structs_insts FROM collect_struct_insts, bd5, esub, structs, structs_insts.
            /IF.
        /IF.
        IF ntype IS "external_decl",
            CREATE ps6(LIST) TO _map_get(node_el, "params").
            REAP structs_insts FROM scan_params, ps6, esub, structs, structs_insts.
        /IF.
        IF ntype IS "struct_decl",
            CREATE gs6(LIST) TO _map_get(node_el, "generics").
            IF COUNT gs6 IS 0,
                CREATE fs6(LIST) TO _map_get(node_el, "fields").
                REAP structs_insts FROM scan_fields, fs6, esub, structs, structs_insts.
            /IF.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP structs_insts FROM collect_struct_insts, plant_list_make(1, node_el), esub, structs, structs_insts.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # per-instantiation struct scans: generic action templates with
    # the substituted type context of each discovered instantiation
    SET i TO 0.
    SEASON i < COUNT insts,
        REAP node_el FROM plant_list_get, insts, i.
        REAP ibase FROM base_of, node_el.
        REAP iargs FROM parse_type_args, node_el.
        REAP itpl FROM find_template, templates, ibase.
        IF COUNT itpl > 0,
            REAP igns FROM _map_get, itpl, "generics".
            REAP insub FROM build_subst, igns, iargs.
            REAP ipms FROM _map_get, itpl, "params".
            REAP ibd FROM _map_get, itpl, "body".
            REAP structs_insts FROM scan_params, ipms, insub, structs, structs_insts.
            REAP structs_insts FROM collect_struct_insts, ibd, insub, structs, structs_insts.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # struct typedefs: plain templates + every instantiation, emitted
    # right after the includes so C FFI code can use them.
    CREATE struct_code(TX) TO "".
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "struct_decl",
            CREATE sgens4(LIST) TO _map_get(node_el, "generics").
            IF COUNT sgens4 IS 0,
                CREATE eargs(LIST) TO plant_list_make(0).
                REAP stdef FROM struct_typedef, node_el, eargs.
                SET struct_code TO struct_code + stdef.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT structs_insts,
        REAP node_el FROM plant_list_get, structs_insts, i.
        REAP ibase FROM base_of, node_el.
        REAP ibtrim FROM trim, ibase.
        REAP iargs FROM parse_type_args, node_el.
        REAP itpl FROM find_struct, structs, ibtrim.
        IF COUNT itpl > 0,
            REAP stdef FROM struct_typedef, itpl, iargs.
            SET struct_code TO struct_code + stdef.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 1: forward declarations for every non-generic action_decl +
    # every monomorphized instantiation
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            REAP aname FROM _map_get, node_el, "name".
            CREATE gens3(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens3 IS 0,
                CREATE params3(LIST) TO _map_get(node_el, "params").
                SET paramstr TO "".
                SET pi TO 0.
                SEASON pi < COUNT params3,
                    REAP param_el FROM plant_list_get, params3, pi.
                    REAP pname FROM _map_get, param_el, "name".
                    REAP ptype FROM _map_get, param_el, "type".
                    REAP ctype FROM plant_ctype, ptype.
                    IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
                    SET paramstr TO paramstr + ctype + " " + pname.
                    SET pi TO pi + 1.
                /SEASON.
                SET pro_code TO pro_code + "tx_t " + aname + "(" + paramstr + ");\n".
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT insts,
        REAP node_el FROM plant_list_get, insts, i.
        REAP inst_code FROM inst_fwddecl, node_el, templates.
        SET pro_code TO pro_code + inst_code.
        SET i TO i + 1.
    /SEASON.
    # pass 0d: closure discovery — stamps closure nodes in place and
    # builds the per-action clmap table + the ordered closure list;
    # env typedefs and closure fn forwards/definitions go into
    # pro_code before the ACTION definitions so all calls resolve.
    REAP clres FROM collect_closures, ast.
    REAP clmaps FROM plant_list_get, clres, 0.
    REAP cllist FROM plant_list_get, clres, 1.
    CREATE cltype_code(TX) TO "".
    CREATE clfwd_code(TX) TO "".
    CREATE cldef_code(TX) TO "".
    SET i TO 0.
    SEASON i < COUNT cllist,
        REAP cnode FROM plant_list_get, cllist, i.
        REAP tc FROM _cl_emit_typedef, cnode.
        SET cltype_code TO cltype_code + tc + "".
        REAP fnn FROM _map_get, cnode, "fnname".
        REAP cprm FROM _map_get, cnode, "params".
        REAP pstr2 FROM _cl_param_str, cprm.
        SET clfwd_code TO clfwd_code + "tx_t " + fnn + "(tx_t env".
        IF pstr2 > "", SET clfwd_code TO clfwd_code + ", " + pstr2. /IF.
        SET clfwd_code TO clfwd_code + ");\n".
        REAP fd FROM _cl_emit_fn, cnode, sigs, esub.
        SET cldef_code TO cldef_code + fd + "".
        SET i TO i + 1.
    /SEASON.
    CREATE implicit(LIST) TO collect_implicit(ast, plant_list_make(0)).
    CREATE dcode(TX) TO "".
    CREATE di(NUM) TO 0.
    CREATE dv(TX) TO "".
    SEASON di < COUNT implicit,
        REAP dv FROM plant_list_get, implicit, di.
        SET dcode TO dcode + "  tx_t " + dv + " = \"\";\n".
        SET di TO di + 1.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            CREATE gens4(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens4 IS 0,
                REAP aname FROM _map_get, node_el, "name".
                REAP cmact FROM _cl_map_get, clmaps, aname.
                REAP nd_code FROM generate_node, node_el, 0, sigs, esub, cmact.
                SET decl_code TO decl_code + nd_code.
                SET has_decl TO 1.
            /IF.
        /IF.
        IF ntype IS "enum_decl",
            REAP nd_code FROM generate_node, node_el, 0, sigs, esub, plant_list_make(0).
            SET decl_code TO decl_code + nd_code.
            SET has_decl TO 1.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP ns_code FROM generate_node, node_el, 0, sigs, esub, plant_list_make(0).
            SET stmt_code TO stmt_code + ns_code.
            SET has_stmt TO 1.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 3: definitions of every monomorphized instantiation
    SET i TO 0.
    SEASON i < COUNT insts,
        REAP node_el FROM plant_list_get, insts, i.
        REAP nd_code FROM emit_inst, node_el, templates, sigs.
        SET decl_code TO decl_code + nd_code.
        SET has_decl TO 1.
        SET i TO i + 1.
    /SEASON.
    IF has_stmt,
        SET stmt_code TO "int main(int argc, char **argv) {\n  plant_init_cli(argc, argv);\n" + dcode + stmt_code + "  return 0;\n}\n".
    /IF.
    GIVE header + struct_code + cltype_code + pro_code + clfwd_code + "\n" + cldef_code + "\n" + decl_code + stmt_code.
/ACTION.

# ═══════════════════════════════════════════════════════════════
#  Closures Engine — v0.48.2
#
#  Pass 0d runs in generate_c: collect_closures(ast) walks every
#  non-generic ACTION body with a scope stack (params + locals +
#  implicit vars) and stamps each closure node in place:
#    cid      — unique closure index N
#    envname  — plant_Env_N          (env struct typedef name)
#    fnname   — plant_Closure_N_fn   (C function name)
#    captures — flat [name, initCexpr, …]  (create-site assignments)
#    moved    — list of MOVE names (outer var cleared after create)
#    shadows  — list of 6-key maps (name, ctype, mode) driving the
#               closure fn's local shadows + env struct fields
#    clmap    — flat [varname, closurenode, …] of closures created
#               directly inside this closure's own body
#  Returns [clmaps, cllist]; clmaps is flat [actionname, clmap, …]
#  and cllist holds every closure node in discovery order.
#  Env typedefs + closure fn forwards + definitions are emitted
#  into pro_code (before the ACTION definitions) so calls resolve.
# ═══════════════════════════════════════════════════════════════

# _cl_is_arg — "1" when a reap argument is a @@CLOSURE@@ placeholder
ACTION _cl_is_arg(arg(TX)),
    REAP pre FROM substring, arg, 0, 11.
    IF pre IS "@@CLOSURE@@", GIVE "1". /IF.
    GIVE "0".
/ACTION.

# _cl_map_get — flat-pairs lookup: value for key, or ""
ACTION _cl_map_get(clmap(LIST), key(TX)),
    CREATE mi2(NUM) TO 0.
    CREATE me2(TX) TO "".
    SEASON mi2 < COUNT clmap,
        REAP me2 FROM plant_list_get, clmap, mi2.
        IF str_eq(me2, key) IS "1",
            REAP mret FROM plant_list_get, clmap, mi2 + 1.
            GIVE mret.
        /IF.
        SET mi2 TO mi2 + 2.
    /SEASON.
    GIVE "".
/ACTION.

# _cl_scopes — extend a scope stack with the declarations a
# statement list introduces (create/let locals, reap targets,
# cycle iterators, match bindings)
ACTION _cl_scopes(bd(LIST), scopes(LIST)),
    CREATE n2(NUM) TO 0.
    CREATE st(TX) TO "".
    CREATE res(LIST) TO scopes.
    SEASON n2 < COUNT bd,
        REAP st FROM plant_list_get, bd, n2.
        REAP sty FROM _map_get, st, "type".
        IF sty IS "create_stmt",
            REAP stg FROM _map_get, st, "target".
            REAP stv FROM _map_get, st, "var_type".
            REAP stc FROM plant_ctype, stv.
            PUT stg INTO res.
            PUT stc INTO res.
        /IF.
        IF sty IS "let_stmt",
            REAP stg FROM _map_get, st, "target".
            REAP stv FROM _map_get, st, "var_type".
            REAP stc FROM plant_ctype, stv.
            PUT stg INTO res.
            PUT stc INTO res.
        /IF.
        IF sty IS "reap_stmt",
            REAP stg FROM _map_get, st, "target".
            IF stg ISNT "_",
                REAP oldc FROM _cl_map_get, res, stg.
                IF oldc IS "",
                    PUT stg INTO res.
                    PUT "tx_t" INTO res.
                /IF.
            /IF.
        /IF.
        IF sty IS "cycle_stmt",
            REAP iv FROM _map_get, st, "iterVar".
            REAP le FROM _map_get, st, "listExpr".
            IF le > "",
                PUT iv INTO res.
                PUT "tx_t" INTO res.
            /IF.
            IF le IS "",
                PUT iv INTO res.
                PUT "long" INTO res.
            /IF.
        /IF.
        IF sty IS "match_stmt",
            REAP mcl FROM _map_get, st, "clauses".
            CREATE mn2(NUM) TO 0.
            CREATE mel(TX) TO "".
            SEASON mn2 < COUNT mcl,
                REAP mel FROM plant_list_get, mcl, mn2.
                REAP mb FROM _map_get, mel, "binding".
                IF mb > "" AND mb ISNT "null",
                    PUT mb INTO res.
                    PUT "tx_t" INTO res.
                /IF.
                SET mn2 TO mn2 + 1.
            /SEASON.
        /IF.
        SET n2 TO n2 + 1.
    /SEASON.
    GIVE res.
/ACTION.

# _cl_stamp_cnode — resolve a closure node's captures against the
# enclosing scope, recurse into its own body, stamp cid/envname/
# fnname/captures/moved/shadows/clmap keys in place, append it to
# the closure sequence. Returns [clseq, cid].
ACTION _cl_stamp_cnode(cnode(LIST), scopes(LIST), cc(NUM), res(LIST)),
    REAP cnp FROM _map_get, cnode, "params".
    REAP cnb FROM _map_get, cnode, "body".
    REAP ccap FROM _map_get, cnode, "captures".
    CREATE cid3(TX) TO _from_long(cc).
    CREATE envn3(TX) TO "plant_Env_" + cid3.
    CREATE fnn3(TX) TO "plant_Closure_" + cid3 + "_fn".
    CREATE capsflat(LIST) TO plant_list_make(0).
    CREATE moved3(LIST) TO plant_list_make(0).
    CREATE shads3(LIST) TO plant_list_make(0).
    CREATE cpsc(LIST) TO plant_list_make(0).
    # closure params are in scope inside the closure body
    CREATE cpi3(NUM) TO 0.
    CREATE cpe3(TX) TO "".
    SEASON cpi3 < COUNT cnp,
        REAP cpe3 FROM plant_list_get, cnp, cpi3.
        REAP cpn3 FROM _map_get, cpe3, "name".
        REAP cpt3 FROM _map_get, cpe3, "type".
        REAP cct3 FROM plant_ctype, cpt3.
        PUT cpn3 INTO cpsc.
        PUT cct3 INTO cpsc.
        SET cpi3 TO cpi3 + 1.
    /SEASON.
    # resolve each capture against the enclosing scope
    CREATE cci3(NUM) TO 0.
    CREATE cce3(TX) TO "".
    SEASON cci3 < COUNT ccap,
        REAP cce3 FROM plant_list_get, ccap, cci3.
        REAP capn3 FROM _map_get, cce3, "name".
        REAP capm3 FROM _map_get, cce3, "mode".
        REAP capct FROM _cl_map_get, scopes, capn3.
        IF capct IS "",
            SET capct TO "tx_t".
        /IF.
        IF str_eq(capm3, "MOVE") IS "1",
            PUT capn3 INTO capsflat.
            PUT capn3 INTO capsflat.
            PUT capn3 INTO moved3.
        /IF.
        IF str_eq(capm3, "REF") IS "1",
            PUT capn3 INTO capsflat.
            PUT "&" + capn3 INTO capsflat.
        /IF.
        PUT plant_list_make(6, "name", capn3, "ctype", capct, "mode", capm3) INTO shads3.
        PUT capn3 INTO cpsc.
        PUT capct INTO cpsc.
        SET cci3 TO cci3 + 1.
    /SEASON.
    # nested closures inside this closure's own body (block form only;
    # expr bodies are plain text and contain no statements)
    CREATE cmap3(LIST) TO plant_list_make(0).
    CREATE cck(NUM) TO cc + 1.
    REAP cnk FROM _map_get, cnode, "bkind".
    IF str_eq(cnk, "block") IS "1",
        REAP cres FROM _cl_walk, cnb, cpsc, res, plant_list_make(0), cc + 1.
        REAP res FROM plant_list_get, cres, 0.
        REAP cmap3 FROM plant_list_get, cres, 1.
        REAP cck FROM plant_list_get, cres, 2.
    /IF.
    # stamp the closure node in place
    PUT "cid" INTO cnode.
    PUT cid3 INTO cnode.
    PUT "envname" INTO cnode.
    PUT envn3 INTO cnode.
    PUT "fnname" INTO cnode.
    PUT fnn3 INTO cnode.
    PUT "clcaps" INTO cnode.
    PUT capsflat INTO cnode.
    PUT "moved" INTO cnode.
    PUT moved3 INTO cnode.
    PUT "shadows" INTO cnode.
    PUT shads3 INTO cnode.
    PUT "clmap" INTO cnode.
    PUT cmap3 INTO cnode.
    PUT cnode INTO res.
    GIVE plant_list_make(2, res, cck).
/ACTION.

# _cl_walk — walk one statement list, stamping closures in place.
# scopes: flat [name, ctype, …] of the current C function scope.
# Returns the accumulator triple [clseq, clmap, cid].
ACTION _cl_walk(bd(LIST), scopes(LIST), clseq(LIST), clmap(LIST), cid(NUM)),
    CREATE n3(NUM) TO 0.
    CREATE st3(TX) TO "".
    CREATE res(LIST) TO clseq.
    CREATE rmap(LIST) TO clmap.
    CREATE cc(NUM) TO cid.
    SEASON n3 < COUNT bd,
        REAP st3 FROM plant_list_get, bd, n3.
        REAP sty3 FROM _map_get, st3, "type".
        REAP sc3 FROM _cl_scopes, plant_list_make(1, st3), scopes.
        # create_stmt / let_stmt carrying a closure node
        REAP cnode3 FROM _map_get, st3, "closure".
        IF cnode3 > "",
            REAP tgt3 FROM _map_get, st3, "target".
            REAP cres FROM _cl_stamp_cnode, cnode3, sc3, cc, res.
            REAP res FROM plant_list_get, cres, 0.
            REAP cc FROM plant_list_get, cres, 1.
            PUT tgt3 INTO rmap.
            PUT cnode3 INTO rmap.
        /IF.
        # inline closure arguments of reap statements are stamped too
        # (their envs are built inline at the call site)
        IF sty3 IS "reap_stmt",
            REAP cla3 FROM _map_get, st3, "clargs".
            IF cla3 > "",
                CREATE clai(NUM) TO 0.
                CREATE clae(TX) TO "".
                SEASON clai < COUNT cla3,
                    REAP clae FROM plant_list_get, cla3, clai.
                    REAP cres FROM _cl_stamp_cnode, clae, sc3, cc, res.
                    REAP res FROM plant_list_get, cres, 0.
                    REAP cc FROM plant_list_get, cres, 1.
                    SET clai TO clai + 1.
                /SEASON.
            /IF.
        /IF.
        # recurse into nested bodies (same scope + their own locals)
        REAP bd3 FROM _map_get, st3, "body".
        IF bd3 > "",
            REAP scn FROM _cl_scopes, bd3, sc3.
            REAP cres FROM _cl_walk, bd3, scn, res, rmap, cc.
            REAP res FROM plant_list_get, cres, 0.
            REAP rmap FROM plant_list_get, cres, 1.
            REAP cc FROM plant_list_get, cres, 2.
        /IF.
        IF sty3 IS "match_stmt",
            REAP mcl3 FROM _map_get, st3, "clauses".
            CREATE mn3(NUM) TO 0.
            CREATE mel3(TX) TO "".
            SEASON mn3 < COUNT mcl3,
                REAP mel3 FROM plant_list_get, mcl3, mn3.
                REAP mb3 FROM _map_get, mel3, "bodyStatements".
                REAP scm FROM _cl_scopes, mb3, sc3.
                REAP cres FROM _cl_walk, mb3, scm, res, rmap, cc.
                REAP res FROM plant_list_get, cres, 0.
                REAP rmap FROM plant_list_get, cres, 1.
                REAP cc FROM plant_list_get, cres, 2.
                SET mn3 TO mn3 + 1.
            /SEASON.
        /IF.
        SET n3 TO n3 + 1.
    /SEASON.
    GIVE plant_list_make(3, res, rmap, cc).
/ACTION.

# collect_closures — pass 0d over the whole AST
ACTION collect_closures(ast(LIST)),
    CREATE clmaps(LIST) TO plant_list_make(0).
    CREATE cllist(LIST) TO plant_list_make(0).
    CREATE ai5(NUM) TO 0.
    CREATE ae5(TX) TO "".
    SEASON ai5 < COUNT ast,
        REAP ae5 FROM plant_list_get, ast, ai5.
        REAP aty FROM _map_get, ae5, "type".
        IF aty IS "action_decl",
            REAP agen FROM _map_get, ae5, "generics".
            IF COUNT agen IS 0,
                REAP aname5 FROM _map_get, ae5, "name".
                REAP apms5 FROM _map_get, ae5, "params".
                REAP abd5 FROM _map_get, ae5, "body".
                REAP apsc FROM _cl_scopes, abd5, plant_list_make(0).
                CREATE ai6(NUM) TO 0.
                CREATE ae6(TX) TO "".
                SEASON ai6 < COUNT apms5,
                    REAP ae6 FROM plant_list_get, apms5, ai6.
                    REAP apn6 FROM _map_get, ae6, "name".
                    REAP apt6 FROM _map_get, ae6, "type".
                    REAP act6 FROM plant_ctype, apt6.
                    PUT apn6 INTO apsc.
                    PUT act6 INTO apsc.
                    SET ai6 TO ai6 + 1.
                /SEASON.
                REAP imp5 FROM collect_implicit, abd5, apms5.
                CREATE di5(NUM) TO 0.
                CREATE dv5(TX) TO "".
                SEASON di5 < COUNT imp5,
                    REAP dv5 FROM plant_list_get, imp5, di5.
                    PUT dv5 INTO apsc.
                    PUT "tx_t" INTO apsc.
                    SET di5 TO di5 + 1.
                /SEASON.
                CREATE cseedd(NUM) TO COUNT cllist.
                REAP cres FROM _cl_walk, abd5, apsc, cllist, plant_list_make(0), cseedd.
                REAP cllist FROM plant_list_get, cres, 0.
                REAP cmap5 FROM plant_list_get, cres, 1.
                PUT aname5 INTO clmaps.
                PUT cmap5 INTO clmaps.
            /IF.
        /IF.
        SET ai5 TO ai5 + 1.
    /SEASON.
    GIVE plant_list_make(2, clmaps, cllist).
/ACTION.

# _cl_param_str — "type name, type name" for a params list
ACTION _cl_param_str(params(LIST)),
    CREATE pstr(TX) TO "".
    CREATE pi3(NUM) TO 0.
    CREATE pe3(TX) TO "".
    SEASON pi3 < COUNT params,
        REAP pe3 FROM plant_list_get, params, pi3.
        REAP pn3 FROM _map_get, pe3, "name".
        REAP pt3 FROM _map_get, pe3, "type".
        REAP ct3 FROM plant_ctype, pt3.
        IF pi3 > 0, SET pstr TO pstr + ", ". /IF.
        SET pstr TO pstr + ct3 + " " + pn3.
        SET pi3 TO pi3 + 1.
    /SEASON.
    GIVE pstr.
/ACTION.

# _cl_emit_typedef — "typedef struct { … } plant_Env_N;"
# MOVE fields keep the captured value's C type; REF fields are
# always tx_t (a pointer to the borrowed outer variable).
ACTION _cl_emit_typedef(cnode(LIST)),
    REAP envn FROM _map_get, cnode, "envname".
    REAP shads FROM _map_get, cnode, "shadows".
    CREATE tc(TX) TO "typedef struct \{\n".
    CREATE si4(NUM) TO 0.
    CREATE se4(TX) TO "".
    CREATE sm4(TX) TO "".
    SEASON si4 < COUNT shads,
        REAP se4 FROM plant_list_get, shads, si4.
        REAP sm4 FROM _map_get, se4, "mode".
        REAP sct4 FROM _map_get, se4, "ctype".
        REAP sname4 FROM _map_get, se4, "name".
        IF str_eq(sm4, "MOVE") IS "1",
            SET tc TO tc + "  " + sct4 + " " + sname4 + ";\n".
        /IF.
        IF str_eq(sm4, "REF") IS "1",
            SET tc TO tc + "  tx_t " + sname4 + ";\n".
        /IF.
        SET si4 TO si4 + 1.
    /SEASON.
    SET tc TO tc + "\} " + envn + ";\n".
    GIVE tc.
/ACTION.

# _cl_emit_fn — the closure function definition:
#   tx_t plant_Closure_N_fn(tx_t env, params…) {
#     ctype name = env->name;            // MOVE shadow
#     ctype name = *((ctype*)env->name); // REF shadow
#     return expr;                       // or block body
#   }
ACTION _cl_emit_fn(cnode(LIST), sigs(LIST), subst(LIST)),
    REAP fname FROM _map_get, cnode, "fnname".
    REAP envn2 FROM _map_get, cnode, "envname".
    REAP params FROM _map_get, cnode, "params".
    REAP bk FROM _map_get, cnode, "bkind".
    REAP shads FROM _map_get, cnode, "shadows".
    REAP cm2 FROM _map_get, cnode, "clmap".
    REAP pstr FROM _cl_param_str, params.
    CREATE fnc(TX) TO "tx_t " + fname + "(tx_t env".
    IF pstr > "", SET fnc TO fnc + ", " + pstr. /IF.
    SET fnc TO fnc + ") \{\n".
    CREATE si5(NUM) TO 0.
    CREATE se5(TX) TO "".
    CREATE sm5(TX) TO "".
    CREATE sct5(TX) TO "".
    SEASON si5 < COUNT shads,
        REAP se5 FROM plant_list_get, shads, si5.
        REAP sm5 FROM _map_get, se5, "mode".
        REAP sct5 FROM _map_get, se5, "ctype".
        REAP sname5 FROM _map_get, se5, "name".
        IF str_eq(sm5, "MOVE") IS "1",
            SET fnc TO fnc + "  " + sct5 + " " + sname5 + " = ((" + envn2 + "*)env)->" + sname5 + ";\n".
        /IF.
        IF str_eq(sm5, "REF") IS "1",
            SET fnc TO fnc + "  " + sct5 + " " + sname5 + " = *(( " + sct5 + "*)((" + envn2 + "*)env)->" + sname5 + ");\n".
        /IF.
        SET si5 TO si5 + 1.
    /SEASON.
    IF str_eq(bk, "expr") IS "1",
        REAP bx FROM _map_get, cnode, "body".
        REAP cx3 FROM translate_expr, bx.
        REAP cx3 FROM _handle_cat, cx3.
        SET fnc TO fnc + "  return " + cx3 + ";\n".
    /IF.
    IF str_eq(bk, "block") IS "1",
        REAP bb FROM _map_get, cnode, "body".
        CREATE cbpars(LIST) TO params.
        CREATE si6(NUM) TO 0.
        CREATE se6(TX) TO "".
        SEASON si6 < COUNT shads,
            REAP se6 FROM plant_list_get, shads, si6.
            PUT se6 INTO cbpars.
            SET si6 TO si6 + 1.
        /SEASON.
        REAP imp6 FROM collect_implicit, bb, cbpars.
        CREATE di6(NUM) TO 0.
        CREATE dv6(TX) TO "".
        SEASON di6 < COUNT imp6,
            REAP dv6 FROM plant_list_get, imp6, di6.
            SET fnc TO fnc + "  tx_t " + dv6 + " = \"\";\n".
            SET di6 TO di6 + 1.
        /SEASON.
        REAP bc3 FROM generate_body, bb, 1, sigs, subst, cm2.
        SET fnc TO fnc + bc3 + "".
    /IF.
    SET fnc TO fnc + "\}\n".
    GIVE fnc.
/ACTION.


# ── get_cli_arg — FFI external stub ─────────────────────────
# Linked to process.argv in the JS runtime.
# Falls back to "test.plant" when no argument is provided.

ACTION get_cli_arg(idx(NUM)) -> external.

# ═══════════════════════════════════════════════════════════
#  Compiler Pipeline — Stage 0 self-hosting driver
# ═══════════════════════════════════════════════════════════

# 1. Source file path (default: test.plant)
REAP arg0 FROM get_cli_arg, 0.
IF arg0 IS "-h" OR arg0 IS "--help",
  SHOW "Chloroplast — Pure Native PlantLang compiler".
  SHOW "usage: Chloroplast <source.plant> [out.c]".
  SHOW "options:".
  SHOW "  -h, --help     show this help and exit".
  SHOW "  -v, --version  show version and exit".
  GIVE 0.
/IF.
IF arg0 IS "-v" OR arg0 IS "--version",
  SHOW "Chloroplast 0.48.2 (pure native)".
  GIVE 0.
/IF.
REAP source_path FROM get_cli_arg, 0.
SHOW "input: " + source_path.

# 2. Validate
REAP exists FROM fs:EXISTS, source_path.
IF exists ISNT "1",
  SHOW "Error: file not found — " + source_path.
  GIVE 1.
/IF.

# 3. Read
REAP source_text FROM fs:READ, source_path.

# 4. Tokenize
SHOW "tokenizing...".
REAP tokens FROM scan_tokens, source_text.

# 5. Parse
SHOW "parsing...".
REAP program_ast FROM parse_program, tokens.
REAP body FROM _map_get, program_ast, "body".

# 6. Code generate
SHOW "generating C...".
REAP c_code FROM generate_c, body.

# 7. Determine output path (use second CLI arg if provided)
REAP out_path FROM get_cli_arg, 1.
IF out_path IS "",
  REAP out_path FROM strings:REPLACE, source_path, ".plant", ".c".
/IF.
REAP written FROM fs:WRITE, out_path, c_code.
REAP c_len FROM strings:LENGTH, c_code.
SHOW "output: " + c_len + " bytes to " + out_path.
CALM.
