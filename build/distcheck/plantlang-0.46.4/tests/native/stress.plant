ACTION join(lst(LIST), sep(TX)),
  CREATE out(TX) TO "".
  CREATE i(NUM) TO 0.
  SEASON i < COUNT lst,
    IF out > "", SET out TO out + sep. /IF.
    SET out TO out + _at(lst, i).
    SET i TO i + 1.
  /SEASON.
  GIVE out.
/GIVE join.

ACTION main(),
  CREATE parts(LIST) TO plant_list_make(0).
  PUT "a" INTO parts.
  PUT "b" INTO parts.
  PUT "c" INTO parts.
  REAP r FROM join, parts, "-".
  SHOW "joined: " + r + " len: " + strings:LENGTH(r).
  GIVE 0.
/GIVE main.
