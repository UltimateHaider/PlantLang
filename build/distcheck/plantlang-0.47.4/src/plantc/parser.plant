# ═══════════════════════════════════════════════════════════════
#  src/plantc/parser.plant — Recursive descent parser
#
#  All action calls use REAP (no inline calls).
#  SEASON is a while-loop, IF is a conditional.
#  Use SEASON only for loops, IF for single branches.
#  Block IFs (multi-line) for multiple body statements.
# ═══════════════════════════════════════════════════════════════

IMPORT "tokens.plant".
IMPORT "ast.plant".

#── Utility actions ────────────────────────────────────────────

ACTION tok_lex(tok(LIST)),
  GIVE tok[1].
/ACTION.

ACTION tok_type(tok(LIST)),
  GIVE tok[0].
/ACTION.

ACTION peek(tokens(LIST), pos(NUM)),
  IF pos < COUNT tokens,
    GIVE tokens[pos].
  /IF.
  GIVE plant_list_make(2, null, "").
/ACTION.

ACTION consume(tokens(LIST), pos(NUM)),
  GIVE plant_list_make(2, tokens[pos], pos + 1).
/ACTION.

ACTION _first(pair(LIST)),
  GIVE pair[0].
/ACTION.

ACTION _second(pair(LIST)),
  GIVE pair[1].
/ACTION.

ACTION is_eof(tokens(LIST), pos(NUM)),
  IF pos >= COUNT tokens,
    GIVE TRUE.
  /IF.
  REAP tok FROM peek, tokens, pos.
  REAP tp FROM tok_type, tok.
  IF tp IS "EOF",
    GIVE TRUE.
  /IF.
  GIVE FALSE.
/ACTION.

# collect_value: collects text until "." or EOF (consumes the dot)
# escape_string — re-escape C-unsafe characters in string content for emission
ACTION escape_string(s(TX)),
  CREATE r(TX) TO "".
  CREATE ei(NUM) TO 0.
  CREATE en(NUM) TO LEN(s).
  CREATE ec(TX) TO "".
  SEASON ei < en,
    REAP ec FROM char_at, s, ei.
    IF ec IS "\\", SET r TO r + "\\" + "\\". /IF.
    IF ec IS "\"", SET r TO r + "\\" + "\"". /IF.
    IF ec IS "\n", SET r TO r + "\\" + "n". /IF.
    IF ec IS "\t", SET r TO r + "\\" + "t". /IF.
    IF ec IS "\r", SET r TO r + "\\" + "r". /IF.
    IF ec ISNT "\\" AND ec ISNT "\"" AND ec ISNT "\n" AND ec ISNT "\t" AND ec ISNT "\r",
      SET r TO r + ec.
    /IF.
    SET ei TO ei + 1.
  /SEASON.
  GIVE r.
/ACTION.

ACTION collect_value(tokens(LIST), start(NUM)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP tt FROM tok_type, tok.
    IF tt IS "STRING",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    IF lx IS "." AND depth IS 0,
      REAP cpair FROM consume, tokens, p2.
      REAP p2 FROM _second, cpair.
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

# collect_until: collects text until delimiter at depth=0 (does NOT consume delimiter)
ACTION collect_until(tokens(LIST), start(NUM), delim(TX)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP tt FROM tok_type, tok.
    IF tt IS "STRING",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    IF _cat("", lx) IS _cat("", delim) AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

#── Statement parsing ──────────────────────────────────────────

ACTION parse_create_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM consume, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tp FROM consume, tokens, p4.
    REAP tp_name FROM tok_lex, tp[0].
    REAP p5 FROM _second, tp.
    REAP rp FROM consume, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tp_name.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM peek, tokens, p3.
  REAP lx2 FROM tok_lex, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

ACTION parse_show_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "show_stmt", "value", expr), p3).
/ACTION.

ACTION parse_give_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "give_stmt", "value", expr), p3).
/ACTION.

ACTION parse_set_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP eq FROM consume, tokens, p3.
  REAP p4 FROM _second, eq.
  REAP vpair FROM collect_value, tokens, p4.
  CREATE expr TO vpair[0].
  REAP p5 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "set_stmt", "target", id_name, "value", expr), p5).
/ACTION.

ACTION parse_let_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM consume, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tp FROM consume, tokens, p4.
    REAP tp_name FROM tok_lex, tp[0].
    REAP p5 FROM _second, tp.
    REAP rp FROM consume, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tp_name.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM peek, tokens, p3.
  REAP lx2 FROM tok_lex, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

ACTION parse_reap_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP var_pair FROM consume, tokens, p2.
  REAP var_name FROM tok_lex, var_pair[0].
  REAP p3 FROM _second, var_pair.
  REAP from_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, from_pair.
  REAP act_pair FROM consume, tokens, p4.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p5 FROM _second, act_pair.
  # Check for module:function syntax (e.g., strings:REPLACE)
  REAP next_tok FROM peek, tokens, p5.
  REAP next_lx FROM tok_lex, next_tok.
  REAP next_ty FROM tok_type, next_tok.
  IF next_ty IS "COLON",
    SET act_name TO act_name + ":".
    REAP colon_pair FROM consume, tokens, p5.
    REAP p5 FROM _second, colon_pair.
    REAP func_pair FROM consume, tokens, p5.
    REAP func_name FROM tok_lex, func_pair[0].
    SET act_name TO act_name + func_name.
    REAP p5 FROM _second, func_pair.
  /IF.
  CREATE args(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tok0 FROM peek, tokens, p5.
    REAP lx0 FROM tok_lex, tok0.
    REAP ty0 FROM tok_type, tok0.
    IF lx0 IS "," AND ty0 ISNT "STRING",
      REAP com0 FROM consume, tokens, p5.
      REAP p5 FROM _second, com0.
    /IF.
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(8, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args), p5).
    /IF.
    REAP tok FROM peek, tokens, p5.
    REAP lx FROM tok_lex, tok.
    REAP ty FROM tok_type, tok.
    IF lx IS "." AND ty ISNT "STRING",
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(8, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args), p6).
    /IF.
    # collect one argument until , or . at depth 0 (do NOT consume delimiter)
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM peek, tokens, p5.
      REAP alx FROM tok_lex, atok.
      REAP atype FROM tok_type, atok.
      IF atype IS "STRING",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "." AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM consume, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    PUT arg_text INTO args.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    IF lx2 IS ".",
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(8, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args), p6).
    /IF.
  /SEASON.
/ACTION.

ACTION parse_put_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_until, tokens, p2, "INTO".
  CREATE item TO vpair[0].
  REAP p3 FROM _second, vpair.
  REAP into_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, into_pair.
  REAP tpair FROM collect_until, tokens, p4, ".".
  CREATE target TO tpair[0].
  REAP p5 FROM _second, tpair.
  REAP dot_pair FROM consume, tokens, p5.
  REAP p6 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "put_stmt", "item", item, "target", target), p6).
/ACTION.

ACTION parse_break_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  IF p2 < COUNT tokens,
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF lx IS "0",
      REAP drop FROM consume, tokens, p2.
      REAP p2 FROM _second, drop.
    /IF.
  /IF.
  REAP dot_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "break_stmt"), p3).
/ACTION.

ACTION parse_continue_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP dot_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "continue_stmt"), p3).
/ACTION.

ACTION parse_if_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM consume, tokens, p3.
  REAP p4 FROM _second, com.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "if_stmt", "cond", cond, "body", body), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP if_close FROM consume, tokens, p5.
      REAP p6 FROM _second, if_close.
      REAP dot FROM consume, tokens, p6.
      REAP p7 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(6, "type", "if_stmt", "cond", cond, "body", body), p7).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_season_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM consume, tokens, p3.
  REAP p4 FROM _second, com.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP season_close FROM consume, tokens, p5.
      REAP p6 FROM _second, season_close.
      REAP dot FROM consume, tokens, p6.
      REAP p7 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p7).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_statement(tokens(LIST), pos(NUM)),
  SEASON TRUE,
    REAP tok FROM peek, tokens, pos.
    REAP tp FROM tok_type, tok.
    IF tp ISNT "DEPTH", BREAK 0. /IF.
    REAP drop_pair FROM consume, tokens, pos.
    REAP pos FROM _second, drop_pair.
  /SEASON.
  REAP tok FROM peek, tokens, pos.
  REAP lx FROM tok_lex, tok.
  IF lx IS "CREATE",
    REAP r FROM parse_create_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SHOW",
    REAP r FROM parse_show_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "GIVE",
    REAP r FROM parse_give_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SET",
    REAP r FROM parse_set_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "LET",
    REAP r FROM parse_let_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "IF",
    REAP r FROM parse_if_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SEASON",
    REAP r FROM parse_season_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "REAP",
    REAP r FROM parse_reap_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "PUT",
    REAP r FROM parse_put_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "BREAK",
    REAP r FROM parse_break_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "CONTINUE",
    REAP r FROM parse_continue_stmt, tokens, pos.
    GIVE r.
  /IF.
  GIVE plant_list_make(2, null, pos + 1).
/ACTION.

#── Declaration parsing ────────────────────────────────────────

ACTION parse_enum_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP name FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  REAP lbr FROM consume, tokens, p3.
  REAP p4 FROM _second, lbr.
  CREATE members(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "}",
      REAP rbr FROM consume, tokens, p4.
      REAP p5 FROM _second, rbr.
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p5).
    /IF.
    REAP m_pair FROM consume, tokens, p4.
    REAP mname FROM tok_lex, m_pair[0].
    REAP p5 FROM _second, m_pair.
    PUT mname INTO members.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
/ACTION.

ACTION parse_action_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP aname FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  REAP lp FROM consume, tokens, p3.
  REAP p4 FROM _second, lp.
  CREATE params(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(8, "type", "action_decl", "name", aname, "params", params, "body", plant_list_make(0)), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS ")",
      REAP rp FROM consume, tokens, p4.
      REAP p5 FROM _second, rp.
      CREATE brk(NUM) TO 0.
      BREAK 0.
    /IF.
    REAP pn_pair FROM consume, tokens, p4.
    REAP pn FROM tok_lex, pn_pair[0].
    REAP p5 FROM _second, pn_pair.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS "(",
      REAP lp2 FROM consume, tokens, p5.
      REAP p6 FROM _second, lp2.
      REAP pt_pair FROM consume, tokens, p6.
      REAP pt FROM tok_lex, pt_pair[0].
      REAP p7 FROM _second, pt_pair.
      # REF var syntax: (REF TYPE) — pass-by-reference parameter
      IF pt IS "REF",
        REAP rt_pair FROM consume, tokens, p7.
        REAP rt FROM tok_lex, rt_pair[0].
        REAP p8 FROM _second, rt_pair.
        SET pt TO "REF " + rt.
        SET p7 TO p8.
      /IF.
      REAP rp2 FROM consume, tokens, p7.
      REAP p8 FROM _second, rp2.
      PUT plant_list_make(4, "name", pn, "type", pt) INTO params.
      SET p5 TO p8.
    /IF.
    IF lx2 ISNT "(",
      PUT plant_list_make(4, "name", pn, "type", "") INTO params.
    /IF.
    REAP tok3 FROM peek, tokens, p5.
    REAP lx3 FROM tok_lex, tok3.
    IF lx3 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
  # skip optional -> Type (then check if , or .)
  REAP arrow_tok FROM peek, tokens, p5.
  REAP arrow_lx FROM tok_lex, arrow_tok.
  IF arrow_lx IS "->",
    REAP arrow_pair FROM consume, tokens, p5.
    REAP p5 FROM _second, arrow_pair.
    # skip bogus MINUS=- token (lexer bug: -> produces extra MINUS)
    REAP skip_tok FROM peek, tokens, p5.
    REAP skip_ty FROM tok_type, skip_tok.
    IF skip_ty IS "MINUS",
      REAP skip_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, skip_pair.
    /IF.
    REAP ret_pair FROM consume, tokens, p5.
    REAP ret_lx FROM tok_lex, ret_pair[0].
    REAP p5 FROM _second, ret_pair.
    # Result<T, E> generics: -> Result<NUM, TX>. (E = TX error string)
    IF ret_lx IS "Result",
      REAP lt_tok FROM peek, tokens, p5.
      REAP lt_lx FROM tok_lex, lt_tok.
      IF lt_lx IS "<",
        REAP lt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, lt_pair.
        REAP rt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, rt_pair.
        REAP rc_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, rc_pair.
        REAP re_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, re_pair.
        REAP gt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, gt_pair.
      /IF.
    /IF.
    REAP after_tok FROM peek, tokens, p5.
    REAP after_lx FROM tok_lex, after_tok.
    IF after_lx IS ",",
      REAP com_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, com_pair.
    /IF.
    IF after_lx IS ".",
      REAP dot_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, dot_pair.
      IF ret_lx IS "external",
        GIVE plant_list_make(2, plant_list_make(6, "type", "external_decl", "name", aname, "params", params), p5).
      /IF.
      IF ret_lx IS "Result",
        GIVE plant_list_make(2, plant_list_make(6, "type", "external_decl", "name", aname, "params", params), p5).
      /IF.
      GIVE plant_list_make(2, plant_list_make(8, "type", "action_decl", "name", aname, "params", params, "body", plant_list_make(0)), p5).
    /IF.
  /IF.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(8, "type", "action_decl", "name", aname, "params", params, "body", body), p5).
    /IF.
    REAP tok4 FROM peek, tokens, p5.
    REAP lx4 FROM tok_lex, tok4.
    IF lx4 IS "/",
      REAP slash FROM consume, tokens, p5.
      REAP p6 FROM _second, slash.
      REAP end FROM consume, tokens, p6.
      REAP p7 FROM _second, end.
      REAP dot FROM consume, tokens, p7.
      REAP p8 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(8, "type", "action_decl", "name", aname, "params", params, "body", body), p8).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p5.
    CREATE stmt TO stmt_pair[0].
    REAP p5 FROM _second, stmt_pair.
    IF stmt > "",
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_declaration(tokens(LIST), pos(NUM)),
  REAP tok FROM peek, tokens, pos.
  REAP lx FROM tok_lex, tok.
  IF lx IS "ENUM",
    REAP r FROM parse_enum_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ACTION",
    REAP r FROM parse_action_decl, tokens, pos.
    GIVE r.
  /IF.
  REAP r FROM parse_statement, tokens, pos.
  GIVE r.
/ACTION.

#── Top-level ──────────────────────────────────────────────────

ACTION parse_program(tokens(LIST)),
  CREATE pos(NUM) TO 0.
  CREATE nodes(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, pos.
    IF is_eof_flag,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    REAP d_pair FROM parse_declaration, tokens, pos.
    CREATE decl TO d_pair[0].
    REAP pos2 FROM _second, d_pair.
    IF pos2 <= pos,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    SET pos TO pos2.
    IF decl > "",
      PUT decl INTO nodes.
    /IF.
  /SEASON.
/ACTION.
