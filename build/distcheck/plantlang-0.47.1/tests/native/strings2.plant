ACTION main(),
  REAP r1 FROM string_repeat, "ab", 3.
  SHOW r1.
  REAP r2 FROM string_repeat, "x", 0.
  SHOW "[" + r2 + "]".
  REAP r3 FROM string_reverse, "abc".
  SHOW r3.
  REAP r4 FROM string_reverse, "".
  SHOW "[" + r4 + "]".
  REAP r5 FROM string_pad, "x", 5, ".".
  SHOW r5.
  REAP r6 FROM string_pad, "hello", 3, ".".
  SHOW r6.
  GIVE 0.
/GIVE main.
