# Test self-hosted pipeline on hello_world
IMPORT "tokens.plant".
IMPORT "ast.plant".
IMPORT "lexer.plant".
IMPORT "parser.plant".
IMPORT "codegen_c.plant".

PLANT strings.

REAP src FROM strings:READ, "tests/fixtures/hello_world.plant".
SHOW "src: " + src.
REAP toks FROM scan_tokens, src.
SHOW "toks count: " + COUNT toks.
REAP ast FROM parse_program, toks.
REAP body FROM _map_get, ast, "body".
SHOW "body count: " + COUNT body.
REAP first FROM _map_get, body, 0.
REAP ftype FROM _map_get, first, "type".
SHOW "first type: " + ftype.
REAP val FROM _map_get, first, "value".
SHOW "first val: " + val.
REAP code FROM generate_c, body.
SHOW "code(" + COUNT code + "): " + code.
CALM.
