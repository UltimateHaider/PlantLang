# ═══════════════════════════════════════════════════════════════
#  src/plantc/tokens.plant — Token definitions for the
#  self-hosting PlantLang compiler.
# ═══════════════════════════════════════════════════════════════

# ── TokenType ENUM ──────────────────────────────────────────
ENUM TokenType {
  LET, CREATE, MATCH, OPTION, RESULT, IF, ELSE, LOOP, RETURN,
  TYPE, ENUM, CONST, FUNCTION, SHOW, IMPORT, ACTION, REAP, GIVE,
  ROOT, ROOT_SCOPE, WEATHER, SHELTER, CALM, SET, PUT, TAKE, LINK, FOR, CYCLE, SEASON,
  AND, OR, NOT, IS, TRUE, FALSE, TO, FROM, AS, IN, SPLIT, JOIN,
  GREATER, LESS, THAN, COUNT, FIRST, LAST, SUM,
  NOW, ANALYZE, TYPEOF,
  IDENT, NUMBER, STRING,
  PLUS, MINUS, STAR, SLASH, PERCENT, STAR_STAR,
  EQUAL, COLON, LPAREN, RPAREN, LBRACE, RBRACE,
  LBRACKET, RBRACKET, COMMA, DOT, ARROW,
  DOT_DOT, WILDCARD, HASH, TOK_EOF, ERROR
}

# ── Token struct (doc sketch) ────────────────────────────────
# v0.48.1: the language keyword is STRUCT; a generic form would be
# STRUCT TokenData[T] { lexeme: T, line: NUM, col: NUM }.
STRUCT TokenData { type: NUM, lexeme: TX, line: NUM, col: NUM }
