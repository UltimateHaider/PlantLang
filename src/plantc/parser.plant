# ═══════════════════════════════════════════════════════════════
#  src/plantc/parser.plant — Recursive descent parser
#
#  All action calls use REAP (no inline calls).
#  SEASON is a while-loop, IF is a conditional.
#  Use SEASON only for loops, IF for single branches.
#  Block IFs (multi-line) for multiple body statements.
# ═══════════════════════════════════════════════════════════════

IMPORT "tokens.plant".
IMPORT "ast.plant".

#── Utility actions ────────────────────────────────────────────

#── Token interface (v0.49.55) ──────────────────────────────
# The parser consumes tokens exclusively through the public
# lexer interface: tokenize(), peek(), consume(), is_eof(),
# tok_lex(), tok_type(). These are defined in lexer.plant and
# available to the concatenated compiler source.
#────────────────────────────────────────────────────────────

ACTION escape_string(s(TX)),
  REAP lexer FROM get_lexer.
  CREATE r(TX) TO "".
  CREATE ei(NUM) TO 0.
  CREATE en(NUM) TO LEN(s).
  CREATE ec(TX) TO "".
  SEASON ei < en,
    REAP ec FROM char_at, s, ei.
    IF ec IS "\\", SET r TO r + "\\" + "\\". /IF.
    IF ec IS "\"", SET r TO r + "\\" + "\"". /IF.
    IF ec IS "\n", SET r TO r + "\\" + "n". /IF.
    IF ec IS "\t", SET r TO r + "\\" + "t". /IF.
    IF ec IS "\r", SET r TO r + "\\" + "r". /IF.
    IF ec ISNT "\\" AND ec ISNT "\"" AND ec ISNT "\n" AND ec ISNT "\t" AND ec ISNT "\r",
      SET r TO r + ec.
    /IF.
    SET ei TO ei + 1.
  /SEASON.
  GIVE r.
/ACTION.

# v0.49.10 — field access: at a dot inside a collected value, a
# following non-keyword IDENT is a map/struct field selector, not a
# statement terminator. The lowered text is emitted directly, so the
# caller loop's re-entry chains levels: a.b.c → _map_get(a, "b") →
# _map_get(_map_get(a, "b"), "c") (translate_expr passes the call
# through untouched). Statement keywords and collect delimiters are
# never field names, and IDENT( / IDENT: ( after the dot starts a
# new statement — the dot stays a terminator. At depth 0 the target
# is the whole accumulated text; inside parens/brackets (dpth "1")
# only a bare IDENT target is supported (f(a.b), [a.b, c]).
ACTION parse_field_access(tokens(LIST), pos(NUM), text(TX), dpth(TX)),
  REAP lexer FROM get_lexer.

  REAP ftok FROM plant_iLexer_peek_at, lexer, tokens, pos + 1.
  REAP flx FROM plant_iLexer_tok_lex, lexer, ftok.
  REAP fty FROM plant_iLexer_tok_type, lexer, ftok.
  IF fty ISNT "IDENT", GIVE plant_list_make(3, "0", text, pos). /IF.
  # v0.49.11 — a chain never opens a new line: a line-leading IDENT at
  # pos+1 is the first token of the next statement, so this dot is a
  # statement terminator (m.name. / m.put(...) must not merge into the
  # previous statement's chain)
  REAP fll FROM tok_line_leading, ftok.
  IF fll IS "1", GIVE plant_list_make(3, "0", text, pos). /IF.
  IF text IS "", GIVE plant_list_make(3, "0", text, pos). /IF.
  IF flx IS "SET" OR flx IS "REAP" OR flx IS "SHOW" OR flx IS "CREATE" OR flx IS "GIVE" OR flx IS "IF" OR flx IS "ORIF" OR flx IS "SEASON" OR flx IS "WHILE" OR flx IS "FOR" OR flx IS "CALL" OR flx IS "START" OR flx IS "AWAIT" OR flx IS "CANCEL" OR flx IS "TRACE" OR flx IS "MISSION" OR flx IS "FREE" OR flx IS "WAIT" OR flx IS "LOCK" OR flx IS "ARC" OR flx IS "PUT" OR flx IS "TAKE" OR flx IS "BRAID" OR flx IS "LINK" OR flx IS "SORT" OR flx IS "SHAKE" OR flx IS "BREAK" OR flx IS "CONTINUE" OR flx IS "LET" OR flx IS "NOW" OR flx IS "ANALYZE" OR flx IS "TYPEOF" OR flx IS "ROOT" OR flx IS "ROOT_SCOPE" OR flx IS "CONST" OR flx IS "IN" OR flx IS "FROM" OR flx IS "TO" OR flx IS "WITH" OR flx IS "AS" OR flx IS "INTO" OR flx IS "BY" OR flx IS "ASYNC" OR flx IS "MATCH" OR flx IS "CYCLE" OR flx IS "WEATHER" OR flx IS "THROW" OR flx IS "STOP" OR flx IS "INCREASE" OR flx IS "DECREASE" OR flx IS "HARVEST" OR flx IS "LISTEN" OR flx IS "FAST",
    GIVE plant_list_make(3, "0", text, pos).
  /IF.
  REAP nt2 FROM plant_iLexer_peek_at, lexer, tokens, pos + 2.
  REAP nt2_ty FROM plant_iLexer_tok_type, lexer, nt2.
  IF nt2_ty IS "LPAREN",
    REAP mpp0 FROM parse_method_call, tokens, pos, text.
    REAP mpf0 FROM _first, mpp0.
    IF mpf0 IS "1", GIVE mpp0. /IF.
    GIVE plant_list_make(3, "0", text, pos).
  /IF.
  IF nt2_ty IS "COLON", GIVE plant_list_make(3, "0", text, pos). /IF.
  REAP ltk FROM plant_iLexer_peek_at, lexer, tokens, pos - 1.
  REAP lt_ty FROM plant_iLexer_tok_type, lexer, ltk.
  IF dpth ISNT "0",
    IF lt_ty ISNT "IDENT", GIVE plant_list_make(3, "0", text, pos). /IF.
  /IF.
  REAP dotp FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, dotp.
  REAP fldp FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP fld FROM plant_iLexer_tok_lex, lexer, fldp[0].
  REAP p3 FROM _second, fldp.
  # stepwise two-operand concatenations: the stale bootstrap
  # compiler only _cat's simple pairs, not multi-segment chains
  CREATE nfld(TX) TO "\"" + fld + "\"".
  CREATE fin(TX) TO "_map_get(".
  # target selection: a trailing bare IDENT is the lookup target
  # ("x=" + m.name → "x=" + _map_get(m, "name")); a text ending
  # in ")" (previous emission — a.b.c chains the last lookup) or
  # any other non-IDENT tail (x[0].name) takes the whole text
  REAP ttail FROM substring, text, LEN(text) - 2, LEN(text).
  IF lt_ty IS "IDENT",
    IF ttail ISNT "\")",
      REAP lt_lx FROM plant_iLexer_tok_lex, lexer, ltk.
      REAP cut FROM substring, text, 0, LEN(text) - LEN(lt_lx).
      SET fin TO fin + lt_lx.
      SET fin TO cut + fin.
    /IF.
    IF ttail IS "\")",
      SET fin TO fin + text.
    /IF.
  /IF.
  IF lt_ty ISNT "IDENT",
    SET fin TO fin + text.
  /IF.
  SET fin TO fin + ", ".
  SET fin TO fin + nfld.
  SET fin TO fin + ")".
  GIVE plant_list_make(3, "1", fin, p3).
/ACTION.

ACTION parse_method_call(tokens(LIST), pos(NUM), text(TX)),
  REAP lexer FROM get_lexer.
  # v0.49.11 — obj.method(args): the token at pos is ".", pos+1 the
  # method IDENT, pos+2 the opening "(" (the caller guarantees this).
  # The receiver selection mirrors parse_field_access: a trailing bare
  # IDENT is the receiver ("x=" + m.push(v) → m); a previous emission
  # (chained m.push(a).pop() or m.a.pop()) or indexed/other tail takes
  # the whole collected text as the receiver.
  REAP mtok0 FROM plant_iLexer_peek_at, lexer, tokens, pos + 1.
  REAP mname FROM plant_iLexer_tok_lex, lexer, mtok0.
  REAP ltk0 FROM plant_iLexer_peek_at, lexer, tokens, pos - 1.
  REAP lt_ty0 FROM plant_iLexer_tok_type, lexer, ltk0.
  REAP ttail0 FROM substring, text, LEN(text) - 2, LEN(text).
  CREATE recv(TX) TO text.
  CREATE pre(TX) TO "".
  IF lt_ty0 IS "IDENT",
    IF ttail0 ISNT "\")",
      REAP lt_lx0 FROM plant_iLexer_tok_lex, lexer, ltk0.
      SET recv TO lt_lx0.
      REAP cut0 FROM substring, text, 0, LEN(text) - LEN(lt_lx0).
      SET pre TO cut0.
    /IF.
  /IF.
  # method dispatch — maps directly onto the runtime API
  CREATE mfn(TX) TO "".
  IF mname IS "push", SET mfn TO "plant_list_push". /IF.
  IF mname IS "pop", SET mfn TO "plant_list_pop". /IF.
  IF mname IS "get", SET mfn TO "plant_map_get". /IF.
  IF mname IS "put", SET mfn TO "plant_map_set". /IF.
  IF mname IS "has", SET mfn TO "plant_map_has". /IF.
  # v0.49.29 - unknown methods dispatch as user functions taking
  # the receiver as their leading argument (SPECIES methods lift to
  # exactly this shape).
  IF mfn IS "",
    SET mfn TO mname.
  /IF.
  # consume ".", the method name, and the opening "("
  REAP mcp FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP mpp FROM _second, mcp.
  REAP mcp2 FROM plant_iLexer_consume_at, lexer, tokens, mpp.
  REAP mpp FROM _second, mcp2.
  REAP mcp3 FROM plant_iLexer_consume_at, lexer, tokens, mpp.
  REAP mpp FROM _second, mcp3.
  # the argument list is the collected value up to the closing ")"
  # at depth 0 (collect_value already handles commas, nesting, field
  # access and nested method calls inside the arguments)
  REAP mvp FROM collect_value, tokens, mpp.
  REAP margs FROM _first, mvp.
  REAP mpp FROM _second, mvp.
  REAP mcp4 FROM plant_iLexer_consume_at, lexer, tokens, mpp.
  REAP mpp FROM _second, mcp4.
  # build the emission in stepwise two-operand concats (the stale
  # bootstrap only _cat's simple pairs): pre + fn(recv, args)
  CREATE minner(TX) TO mfn.
  SET minner TO minner + "(".
  SET minner TO minner + recv.
  IF margs > "",
    SET minner TO minner + ", ".
    SET minner TO minner + margs.
  /IF.
  SET minner TO minner + ")".
  CREATE mres(TX) TO minner.
  IF mname IS "has",
    SET mres TO "_from_long(" + minner + ")".
  /IF.
  IF pre > "",
    SET mres TO pre + mres.
  /IF.
  GIVE plant_list_make(3, "1", mres, mpp).
/ACTION.

ACTION collect_value(tokens(LIST), start(NUM)),
  REAP lexer FROM get_lexer.
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    REAP tt FROM plant_iLexer_tok_type, lexer, tok.
    IF tt IS "STRING" OR tt IS "INTERP",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    # v0.49.10 — a dot followed by a field name (see
    # parse_field_access) extends the value; otherwise a depth-0
    # dot still terminates the statement
    IF lx IS "." AND text > "",
      REAP fpp FROM parse_field_access, tokens, p2, text, _from_long(depth).
      REAP fpf FROM _first, fpp.
      IF fpf IS "1",
        REAP fpt FROM _second, fpp.
        REAP fpp2 FROM _third, fpp.
        SET text TO fpt.
        SET p2 TO fpp2.
        CONTINUE 0.
      /IF.
    /IF.
    IF lx IS "." AND depth IS 0,
      REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p2 FROM _second, cpair.
      GIVE plant_list_make(2, text, p2).
    /IF.
    # a ")" at depth 0 closes an enclosing closure block body; leave
    # it unconsumed so the caller (parse_statement loop) sees it
    IF lx IS ")" AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    # a top-level "IN" terminates the value (CANCEL/TRACE ... IN ctx);
    # left unconsumed so the caller parses the context
    IF lx IS "IN" AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    # v0.49.5 — { ... } map literal spans also hold depth, so a
    # statement terminator (or delimiter) inside them never fires
    IF lx IS "{",
      SET depth TO depth + 1.
    /IF.
    IF lx IS "}",
      SET depth TO depth - 1.
    /IF.
    # v0.49.6 — [ ... ] list literal spans hold depth too, so a
    # terminator/delimiter inside them never fires (REAP r FROM f,
    # [1, 2]. — the comma inside the literal is not an arg split)
    IF lx IS "[",
      SET depth TO depth + 1.
    /IF.
    IF lx IS "]",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

# collect_until: collects text until delimiter at depth=0 (does NOT consume delimiter)
ACTION collect_until(tokens(LIST), start(NUM), delim(TX)),
  REAP lexer FROM get_lexer.
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    REAP tt FROM plant_iLexer_tok_type, lexer, tok.
    IF tt IS "STRING" OR tt IS "INTERP",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    IF _cat("", lx) IS _cat("", delim) AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    # v0.49.10 — field access before a delimiter/terminator dot
    IF lx IS "." AND text > "",
      REAP fpp FROM parse_field_access, tokens, p2, text, _from_long(depth).
      REAP fpf FROM _first, fpp.
      IF fpf IS "1",
        REAP fpt FROM _second, fpp.
        REAP fpp2 FROM _third, fpp.
        SET text TO fpt.
        SET p2 TO fpp2.
        CONTINUE 0.
      /IF.
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    # v0.49.5 — { ... } map literal spans also hold depth, so a
    # statement terminator (or delimiter) inside them never fires
    IF lx IS "{",
      SET depth TO depth + 1.
    /IF.
    IF lx IS "}",
      SET depth TO depth - 1.
    /IF.
    # v0.49.6 — [ ... ] list literal spans hold depth too (a
    # delimiter inside a literal is not a terminator)
    IF lx IS "[",
      SET depth TO depth + 1.
    /IF.
    IF lx IS "]",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

# collect_type_text: collects a type string until stopc (or "," when
# stopcomma=1) at depth 0, WITHOUT consuming the delimiter.
# Handles T, LIST[T], REF NUM, REF LIST[T], Box[NUM], Pair[NUM, TX] etc.
ACTION collect_type_text(tokens(LIST), start(NUM), stopc(TX), stopcomma(NUM)),
  REAP lexer FROM get_lexer.
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE pdepth(NUM) TO 0.
  CREATE bdepth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF pdepth IS 0 AND bdepth IS 0,
      IF _cat("", lx) IS _cat("", stopc),
        GIVE plant_list_make(2, text, p2).
      /IF.
      IF stopcomma IS 1 AND lx IS ",",
        GIVE plant_list_make(2, text, p2).
      /IF.
    /IF.
    IF lx IS "(", SET pdepth TO pdepth + 1. /IF.
    IF lx IS ")", SET pdepth TO pdepth - 1. /IF.
    IF lx IS "[", SET bdepth TO bdepth + 1. /IF.
    IF lx IS "]", SET bdepth TO bdepth - 1. /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

#── Statement parsing ──────────────────────────────────────────

# collect_args: collect call arguments into a flat list until ",", "."
# or ")" at depth 0 (delimiters NOT consumed). Strings escaped.
ACTION collect_args(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  CREATE args(LIST) TO plant_list_make(0).
  CREATE p5(NUM) TO pos.
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, args, p5).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    REAP ty FROM plant_iLexer_tok_type, lexer, tok.
    IF lx IS "," AND ty ISNT "STRING",
      REAP com FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    IF lx IS "." AND ty ISNT "STRING",
      GIVE plant_list_make(2, args, p5).
    /IF.
    IF lx IS ")" AND ty ISNT "STRING",
      GIVE plant_list_make(2, args, p5).
    /IF.
    # "IN" at depth 0 terminates the argument list (START/AWAIT/REAP
    # ... IN ctx); left unconsumed so the caller parses the context
    IF lx IS "IN" AND ty ISNT "STRING",
      GIVE plant_list_make(2, args, p5).
    /IF.
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM plant_iLexer_peek_at, lexer, tokens, p5.
      REAP alx FROM plant_iLexer_tok_lex, lexer, atok.
      REAP atype FROM plant_iLexer_tok_type, lexer, atok.
      IF atype IS "STRING" OR atype IS "INTERP",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "." AND adepth IS 0, BREAK 0. /IF.
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "IN" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    PUT arg_text INTO args.
    REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
    IF lx2 IS ",",
      REAP com2 FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, com2.
    /IF.
  /SEASON.
/ACTION.

# AWAIT callname, args [IN ctx]. — suspend until the async action
# completes; the child task is spawned into ctx when given
ACTION parse_await_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP act_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP act_name FROM plant_iLexer_tok_lex, lexer, act_pair[0].
  REAP p3 FROM _second, act_pair.
  REAP ap FROM collect_args, tokens, p3.
  CREATE args(LIST) TO ap[0].
  REAP p4 FROM _second, ap.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "IN",
    REAP in_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP p5 FROM _second, in_pair.
    REAP ctx_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP ctx_name FROM plant_iLexer_tok_lex, lexer, ctx_pair[0].
    REAP p6 FROM _second, ctx_pair.
    REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p6.
    REAP p7 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(8, "type", "await_stmt", "action", act_name, "args", args, "ctx", ctx_name), p7).
  /IF.
  REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP p5 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(8, "type", "await_stmt", "action", act_name, "args", args, "ctx", ctx_name), p5).
/ACTION.

# START callname, args [IN ctx]. — fire-and-forget spawn
ACTION parse_start_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP act_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP act_name FROM plant_iLexer_tok_lex, lexer, act_pair[0].
  REAP p3 FROM _second, act_pair.
  REAP ap FROM collect_args, tokens, p3.
  CREATE args(LIST) TO ap[0].
  REAP p4 FROM _second, ap.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "IN",
    REAP in_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP p5 FROM _second, in_pair.
    REAP ctx_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP ctx_name FROM plant_iLexer_tok_lex, lexer, ctx_pair[0].
    REAP p6 FROM _second, ctx_pair.
    REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p6.
    REAP p7 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(8, "type", "start_stmt", "action", act_name, "args", args, "ctx", ctx_name), p7).
  /IF.
  REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP p5 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(8, "type", "start_stmt", "action", act_name, "args", args, "ctx", ctx_name), p5).
/ACTION.

# ASYNC IN ctx, callname, args. — spawn into a structured context
ACTION parse_async_in_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP in_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP p3 FROM _second, in_pair.
  REAP ctx_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP ctx_name FROM plant_iLexer_tok_lex, lexer, ctx_pair[0].
  REAP p4 FROM _second, ctx_pair.
  REAP com FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP p5 FROM _second, com.
  REAP act_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP act_name FROM plant_iLexer_tok_lex, lexer, act_pair[0].
  REAP p6 FROM _second, act_pair.
  REAP ap FROM collect_args, tokens, p6.
  CREATE args(LIST) TO ap[0].
  REAP p7 FROM _second, ap.
  REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p7.
  REAP p8 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(10, "type", "start_stmt", "action", act_name, "args", args, "ctx", ctx_name, "kind", "async_in"), p8).
/ACTION.

# CANCEL tok. or CANCEL tok IN ctx. — immediate cancellation + teardown;
# the IN form is scoped: only cancels the handle if it lives in ctx
ACTION parse_cancel_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "IN",
    REAP in_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p4 FROM _second, in_pair.
    REAP ctx_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP ctx_name FROM plant_iLexer_tok_lex, lexer, ctx_pair[0].
    REAP p5 FROM _second, ctx_pair.
    REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p6 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(6, "type", "cancel_stmt", "value", expr, "ctx", ctx_name), p6).
  /IF.
  GIVE plant_list_make(2, plant_list_make(6, "type", "cancel_stmt", "value", expr, "ctx", ctx_name), p3).
/ACTION.

# TRACE INFO|DEBUG|PERF msg [IN ctx]. — scoped trace event; the IN
# form tags the event with the context name
ACTION parse_trace_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP lv_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP lv FROM plant_iLexer_tok_lex, lexer, lv_pair[0].
  REAP p3 FROM _second, lv_pair.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4b FROM _second, vpair.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4b.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "IN",
    REAP in_pair FROM plant_iLexer_consume_at, lexer, tokens, p4b.
    REAP p5 FROM _second, in_pair.
    REAP ctx_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP ctx_name FROM plant_iLexer_tok_lex, lexer, ctx_pair[0].
    REAP p6 FROM _second, ctx_pair.
    REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p6.
    REAP p7 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(8, "type", "trace_stmt", "level", lv, "value", expr, "ctx", ctx_name), p7).
  /IF.
  # collect_value already consumed the dot; p4b is after it
  GIVE plant_list_make(2, plant_list_make(8, "type", "trace_stmt", "level", lv, "value", expr, "ctx", ctx_name), p4b).
/ACTION.

# MISSION CONFIG KEY = VALUE. — runtime configuration directive
ACTION parse_mission_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cfg_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP p3 FROM _second, cfg_pair.
  REAP key_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP cfg_key FROM plant_iLexer_tok_lex, lexer, key_pair[0].
  REAP p4 FROM _second, key_pair.
  REAP eq_tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
  REAP eq_lx FROM plant_iLexer_tok_lex, lexer, eq_tok.
  IF eq_lx IS "=" OR eq_lx IS "IS",
    REAP eq_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP p4 FROM _second, eq_pair.
  /IF.
  REAP val_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP cfg_val FROM plant_iLexer_tok_lex, lexer, val_pair[0].
  REAP vty FROM plant_iLexer_tok_type, lexer, val_pair[0].
  # quoted values (paths, strings with spaces) keep the whole token;
  # strip the quotes so the codegen emits a clean "value"
  IF vty IS "STRING",
    REAP cfg_val FROM escape_string, cfg_val.
  /IF.
  REAP p5 FROM _second, val_pair.
  REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP p6 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(6, "type", "config_stmt", "key", cfg_key, "value", cfg_val), p6).
/ACTION.

ACTION parse_create_stmt(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP id_name FROM plant_iLexer_tok_lex, lexer, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tv FROM collect_type_text, tokens, p4, ")", 0.
    REAP tt FROM _first, tv.
    REAP p5 FROM _second, tv.
    REAP rp FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tt.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP cb_tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP cb_lx FROM plant_iLexer_tok_lex, lexer, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP cb_tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP cb_lx FROM plant_iLexer_tok_lex, lexer, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

# v0.50.0e — parse_array_decl: array[T, N] varname = [init...].
#   Parses the array type bracket, collects element type and size,
#   then the variable name, = or TO, and the initializer list.
ACTION parse_array_decl(tokens(LIST), pos(NUM), rtab(LIST)),
  REAP lexer FROM get_lexer.
  # consume 'ARRAY' / 'array' token
  REAP arr_pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, arr_pair.
  # expect '['
  REAP lb_tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP lb_lx FROM plant_iLexer_tok_lex, lexer, lb_tok.
  IF lb_lx ISNT "[",
    GIVE plant_list_make(2, plant_list_make(6, "type", "syntax_error", "message", "expected bracket after array"), p2).
  /IF.
  REAP lb_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP p3 FROM _second, lb_pair.
  # collect element type until ',' at depth 0
  REAP et_pair FROM collect_type_text, tokens, p3, "]", 1.
  REAP elem_type FROM _first, et_pair.
  REAP p4 FROM _second, et_pair.
  # skip ','
  REAP comma_tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
  REAP comma_lx FROM plant_iLexer_tok_lex, lexer, comma_tok.
  IF comma_lx IS ",",
    REAP comma_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP p4 FROM _second, comma_pair.
  /IF.
  # collect size until ']' at depth 0
  REAP sz_pair FROM collect_type_text, tokens, p4, "]", 0.
  REAP arr_size FROM _first, sz_pair.
  REAP p5 FROM _second, sz_pair.
  # consume ']'
  REAP rb_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP p6 FROM _second, rb_pair.
  # construct the type string: "ARRAY[NUM, 5]"
  CREATE _lb(TX) TO _cat("[", "").
  CREATE _rb(TX) TO _cat("]", "").
  CREATE _cm(TX) TO ", ".
  CREATE vtype(TX) TO _cat(_cat4("ARRAY", _lb, elem_type, _cm), _cat(arr_size, _rb)).
  # consume variable name
  REAP name_pair FROM plant_iLexer_consume_at, lexer, tokens, p6.
  REAP id_name FROM plant_iLexer_tok_lex, lexer, name_pair[0].
  REAP p7 FROM _second, name_pair.
  # expect '=' or 'TO'
  REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p7.
  REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
  CREATE p8(NUM) TO p7.
  IF lx2 IS "=",
    REAP eq_pair FROM plant_iLexer_consume_at, lexer, tokens, p7.
    REAP p8 FROM _second, eq_pair.
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM plant_iLexer_consume_at, lexer, tokens, p7.
    REAP p8 FROM _second, to_pair.
  /IF.
  # collect value
  REAP vpair FROM collect_value, tokens, p8.
  REAP expr FROM _first, vpair.
  REAP p9 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p9).
/ACTION.

ACTION parse_show_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.

  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "show_stmt", "value", expr), p3).
/ACTION.

# v0.49.53 — VERIFY "label" condition. → emits plant_verify(label, cond).
# The label is a string literal, the condition is any expression.
ACTION parse_verify_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP lbl_tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP lbl_ty FROM plant_iLexer_tok_type, lexer, lbl_tok.
  IF lbl_ty IS "STRING",
    REAP lbl_lx FROM plant_iLexer_tok_lex, lexer, lbl_tok.
    REAP lbl_lx FROM escape_string, lbl_lx.
    REAP lbl_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p3 FROM _second, lbl_pair.
    REAP lbl FROM _cat, '"', lbl_lx.
    REAP lbl FROM _cat, lbl, '"'.
  /IF.
  REAP vp FROM collect_value, tokens, p3.
  REAP cond FROM _first, vp.
  REAP p4 FROM _second, vp.
  REAP sep_tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
  REAP sep_ty FROM plant_iLexer_tok_type, lexer, sep_tok.
  IF sep_ty IS "PERIOD",
    REAP sp FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP p4 FROM _second, sp.
  /IF.
  GIVE plant_list_make(2, plant_list_make(8, "type", "verify_stmt", "label", lbl, "cond", cond, "end_pos", _from_long(p4)), p4).
/ACTION.

# v0.49.54 — SETUP statement (suite lifecycle hook).
ACTION parse_setup_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vp FROM collect_value, tokens, p2.
  REAP val FROM _first, vp.
  REAP p3 FROM _second, vp.
  REAP sep_tok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP sep_ty FROM plant_iLexer_tok_type, lexer, sep_tok.
  IF sep_ty IS "PERIOD",
    REAP sp FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p3 FROM _second, sp.
  /IF.
  GIVE plant_list_make(2, plant_list_make(6, "type", "setup_stmt", "value", val, "end_pos", _from_long(p3)), p3).
/ACTION.

# v0.49.54 — TEARDOWN statement (suite lifecycle hook).
ACTION parse_teardown_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vp FROM collect_value, tokens, p2.
  REAP val FROM _first, vp.
  REAP p3 FROM _second, vp.
  REAP sep_tok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP sep_ty FROM plant_iLexer_tok_type, lexer, sep_tok.
  IF sep_ty IS "PERIOD",
    REAP sp FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p3 FROM _second, sp.
  /IF.
  GIVE plant_list_make(2, plant_list_make(6, "type", "teardown_stmt", "value", val, "end_pos", _from_long(p3)), p3).
/ACTION.

# v0.49.54 — SUITE "name", SETUP ... TEARDOWN ... statements /SUITE .
ACTION parse_suite_stmt(tokens(LIST), pos(NUM), clv(TX), ctab(LIST), rtab(LIST), bstart(NUM), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  CREATE sname(TX) TO "".
  CREATE body(LIST) TO plant_list_make(0).
  # v0.49.54: Optional suite name: SUITE "name", ... /SUITE .
  REAP ntok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP nty FROM plant_iLexer_tok_type, lexer, ntok.
  IF nty IS "STRING",
    REAP nl FROM plant_iLexer_tok_lex, lexer, ntok.
    REAP nl FROM escape_string, nl.
    REAP ncons FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, ncons.
    SET sname TO nl.
    REAP ctok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP clx FROM plant_iLexer_tok_lex, lexer, ctok.
    IF clx IS ",",
      REAP ccons FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p2 FROM _second, ccons.
    /IF.
  /IF.
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(6, "type", "syntax_error", "msg", "unterminated SUITE", "pos", _from_long(p2)).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    REAP tt FROM plant_iLexer_tok_type, lexer, tok.
    IF lx IS "/",
      REAP slash FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p3 FROM _second, slash.
      REAP kw FROM plant_iLexer_consume_at, lexer, tokens, p3.
      REAP p4 FROM _second, kw.
      REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(6, "type", "suite_stmt", "name", sname, "body", body), _from_long(p5)).
    /IF.
    IF tt IS "SETUP",
      REAP sb_pair FROM parse_setup_stmt, tokens, p2.
      REAP sb_node FROM _first, sb_pair.
      PUT sb_node INTO body.
      REAP p2 FROM _second, sb_pair.
      CONTINUE 0.
    /IF.
    IF tt IS "TEARDOWN",
      REAP td_pair FROM parse_teardown_stmt, tokens, p2.
      REAP td_node FROM _first, td_pair.
      PUT td_node INTO body.
      REAP p2 FROM _second, td_pair.
      CONTINUE 0.
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p2, clv, ctab, rtab, bstart, emode.
    REAP stmt FROM _first, stmt_pair.
    IF stmt > "",
      PUT stmt INTO body.
    /IF.
    REAP p2 FROM _second, stmt_pair.
  /SEASON.
/ACTION.

# v0.48.36 — NOW [FORMAT:x]. — temporal query statement. The format
#   qualifier is optional (bare NOW. → default stamp); when present
#   it must be written FORMAT:NAME (FORMAT, colon, identifier). The
#   runtime routes the name to a formatting branch; unknown names are
#   reported by plant_now itself (bad-format:<name>), so the parser
#   accepts any identifier. AST node: now_stmt { fmt }.
ACTION parse_now_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  CREATE fmt(TX) TO "".
  REAP ntok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP nlx FROM plant_iLexer_tok_lex, lexer, ntok.
  IF nlx IS "FORMAT",
    REAP fpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, fpair.
    REAP ctok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP cty FROM plant_iLexer_tok_type, lexer, ctok.
    IF cty ISNT "COLON",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "NOW FORMAT requires ':' before the format name"), p2).
    /IF.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP qpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP qlx FROM plant_iLexer_tok_lex, lexer, qpair[0].
    REAP qty FROM plant_iLexer_tok_type, lexer, qpair[0].
    REAP p2 FROM _second, qpair.
    IF qty ISNT "IDENT",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "NOW FORMAT expects a format name after ':'"), p2).
    /IF.
    SET fmt TO qlx.
  /IF.
  REAP dpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP dlx FROM plant_iLexer_tok_lex, lexer, dpair[0].
  REAP p3 FROM _second, dpair.
  IF dlx ISNT ".",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "NOW expects '.' after the format"), p2).
  /IF.
  GIVE plant_list_make(2, plant_list_make(4, "type", "now_stmt", "fmt", fmt), p3).
/ACTION.

# v0.48.36 — ANALYZE x. — structural introspection statement. The
#   target is any expression; the runtime inspects the value and the
#   statement prints the unified metadata MAP. AST node:
#   analyze_stmt { target }.
ACTION parse_analyze_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  IF expr IS "" OR expr IS null,
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "ANALYZE requires a target expression"), p2).
  /IF.
  GIVE plant_list_make(2, plant_list_make(4, "type", "analyze_stmt", "target", expr), p3).
/ACTION.

# v0.48.36 — TYPEOF x. — type query statement. The target is any
#   expression; the runtime resolves its type string ("int",
#   "string", "map", "list", "closure", "null") and the statement
#   prints it. AST node: typeof_stmt { target }.
ACTION parse_typeof_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  IF expr IS "" OR expr IS null,
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "TYPEOF requires a target expression"), p2).
  /IF.
  GIVE plant_list_make(2, plant_list_make(4, "type", "typeof_stmt", "target", expr), p3).
/ACTION.

# v0.48.37 — FREE x. deallocates x via the slab-aware plant_mem_free
#   and sets the variable to NULL (double-free safe). The target must
#   be a plain identifier.
ACTION parse_free_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP id_name FROM plant_iLexer_tok_lex, lexer, id_pair[0].
  REAP id_type FROM plant_iLexer_tok_type, lexer, id_pair[0].
  REAP p3 FROM _second, id_pair.
  IF id_type ISNT "IDENT",
    CREATE dmsg(TX) TO "FREE requires an identifier target".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p3).
  /IF.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "free_stmt", "target", id_name), p4).
/ACTION.

# ── WAIT [n]. — execution pause / throttling (v0.48.37e) ──────
#    WAIT n. pauses the program for n milliseconds; a bare WAIT. (the
#    legacy async phase-boundary spelling) and zero/negative durations
#    are no-ops at runtime. The duration is the token text up to the
#    terminating "."; string operands are rejected as invalid timing
#    arguments. AST node: wait_stmt { ms }.
ACTION parse_wait_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP mpair FROM collect_until, tokens, p2, ".".
  CREATE ms TO mpair[0].
  REAP p3 FROM _second, mpair.
  IF ms > "",
    REAP mtok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP mty FROM plant_iLexer_tok_type, lexer, mtok.
    IF mty IS "STRING",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "WAIT expects a numeric duration in milliseconds"), p2).
    /IF.
  /IF.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "wait_stmt", "ms", ms), p4).
/ACTION.

# ── LOCK var. — synchronization primitive (v0.48.37e) ──────────
#    LOCK var. registers a locking flag against the variable's value in
#    the centralized lock table; concurrent re-lock of a locked key is
#    refused by the runtime. The target must be a plain identifier.
#    AST node: lock_stmt { var }.
ACTION parse_lock_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP id_name FROM plant_iLexer_tok_lex, lexer, id_pair[0].
  REAP id_type FROM plant_iLexer_tok_type, lexer, id_pair[0].
  REAP p3 FROM _second, id_pair.
  IF id_type ISNT "IDENT",
    CREATE dmsg(TX) TO "LOCK requires an identifier target".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p3).
  /IF.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "lock_stmt", "var", id_name), p4).
/ACTION.

# v0.48.37 — ARC LINK parent TO child. adds a strong edge (the parent
#   keeps the child alive); ARC UNLINK parent FROM child. drops it.
ACTION parse_arc_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP k_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP k_lx FROM plant_iLexer_tok_lex, lexer, k_pair[0].
  REAP p3 FROM _second, k_pair.
  REAP a_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP a_name FROM plant_iLexer_tok_lex, lexer, a_pair[0].
  REAP p4 FROM _second, a_pair.
  IF k_lx IS "LINK",
    REAP t_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP p5 FROM _second, t_pair.
    REAP c_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP c_name FROM plant_iLexer_tok_lex, lexer, c_pair[0].
    REAP p6 FROM _second, c_pair.
    REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p6.
    REAP p7 FROM _second, dot_pair.
    GIVE plant_list_make(2, plant_list_make(6, "type", "arc_link_stmt", "parent", a_name, "child", c_name), p7).
  /IF.
  REAP f_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP p5 FROM _second, f_pair.
  REAP c_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP c_name FROM plant_iLexer_tok_lex, lexer, c_pair[0].
  REAP p6 FROM _second, c_pair.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p6.
  REAP p7 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "arc_unlink_stmt", "parent", a_name, "child", c_name), p7).
/ACTION.

# v0.48.37 — FAST RESET. releases the bump heap and closes the FAST
#   scope (RAII counterpart of WITH MISSION FAST).
ACTION parse_fast_reset_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP r_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP r_lx FROM plant_iLexer_tok_lex, lexer, r_pair[0].
  REAP p3 FROM _second, r_pair.
  IF r_lx ISNT "RESET",
    CREATE dmsg(TX) TO "FAST requires RESET".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p3).
  /IF.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "fast_reset_stmt"), p4).
/ACTION.

# v0.48.33 — GIVE val. returns val (give_stmt); GIVE val AS RESPONSE.
#   replies on the active LISTEN request (respond_stmt node; the req
#   slot is filled with the request variable tracked by the statement
#   loops, or stays empty when no LISTEN is bound in the block).
ACTION _is_idch(c(TX)),
  REAP lexer FROM get_lexer.
  REAP r1 FROM str_eq, c, "_".
  IF r1 IS "1", GIVE "1". /IF.
  IF c GREATER THAN OR EQUAL "a" AND c LESS THAN OR EQUAL "z", GIVE "1". /IF.
  IF c GREATER THAN OR EQUAL "A" AND c LESS THAN OR EQUAL "Z", GIVE "1". /IF.
  IF c GREATER THAN OR EQUAL "0" AND c LESS THAN OR EQUAL "9", GIVE "1". /IF.
  GIVE "0".
/ACTION.

# _lower_dots - textual IDENT.IDENT[.IDENT...] -> _map_get chains,
# outside string literals. Used by GIVE (legacy collector has no
# token-level field lowering).
ACTION _lower_dots(e(TX)),
  REAP lexer FROM get_lexer.
  CREATE out(TX) TO "".
  CREATE res(TX) TO "".
  CREATE i(NUM) TO 0.
  CREATE n(NUM) TO LEN(e).
  CREATE q(TX) TO "".
  SEASON i < n,
    REAP ch FROM char_at, e, i.
    IF q IS "",
      IF ch IS "\"" OR ch IS "'", SET q TO ch. /IF.
    /IF.
    IF q ISNT "",
      SET out TO out + ch.
      IF ch IS q, SET q TO "". /IF.
      SET i TO i + 1.
      CONTINUE.
    /IF.
    IF ch IS "." AND i > 0 AND i + 1 < n,
      REAP pv FROM char_at, e, i - 1.
      REAP nx FROM char_at, e, i + 1.
      REAP pid FROM _is_idch, pv.
      REAP nid0 FROM _is_idch, nx.
      REAP nz FROM str_eq, nx, "_".
      IF pid IS "1" AND (nid0 IS "1" OR nz IS "1"),
        # gather base backwards
        CREATE js(NUM) TO i - 1.
        SEASON js > 0,
          REAP pj FROM char_at, e, js - 1.
          REAP pjok FROM _is_idch, pj.
          IF pjok ISNT "1", BREAK 0. /IF.
          SET js TO js - 1.
        /SEASON.
        REAP base FROM substring, e, js, i.
        # gather chain identifiers
        CREATE ids(LIST) TO plant_list_make(0).
        CREATE pending(TX) TO base.
        CREATE k(NUM) TO i + 1.
        SEASON k < n,
          REAP kid FROM char_at, e, k.
          REAP kok FROM _is_idch, kid.
          IF kok ISNT "1", BREAK 0. /IF.
          CREATE w(TX) TO "".
          SEASON k < n,
            REAP kc FROM char_at, e, k.
            REAP kcok FROM _is_idch, kc.
            IF kcok ISNT "1", BREAK 0. /IF.
            SET w TO w + kc.
            SET k TO k + 1.
          /SEASON.
          PUT w INTO ids.
          REAP dchk FROM char_at, e, k.
          REAP disdot FROM str_eq, dchk, ".".
          IF disdot IS "1",
            SET k TO k + 1.
          /IF.
          IF disdot ISNT "1", BREAK 0. /IF.
        /SEASON.
        CREATE mi(NUM) TO 0.
        SEASON mi < COUNT ids,
          REAP idv FROM plant_list_get, ids, mi.
          SET res TO "_map_get(".
          SET res TO res + pending.
          SET res TO res + ", \"".
          SET res TO res + idv.
          SET res TO res + "\")".
          SET pending TO res.
          SET mi TO mi + 1.
        /SEASON.
        SET out TO out + res.
        SET i TO k.
        CONTINUE.
      /IF.
    /IF.
    SET out TO out + ch.
    SET i TO i + 1.
  /SEASON.
  GIVE out.
/ACTION.

# _swap_super_prefix - v0.49.31: rewrite SUPER_ to <Parent>_ prefix
# inside all string-valued fields of every statement node in a body list.
ACTION _swap_super_prefix(bd(LIST), parent(TX)),
  REAP lexer FROM get_lexer.
  CREATE i(NUM) TO 0.
  SEASON i < COUNT bd,
    REAP nd FROM plant_list_get, bd, i.
    REAP vx FROM _map_get, nd, "value".
    IF vx > "",
      REAP nvx FROM strings:REPLACE, vx, "SUPER_", parent + "_".
      REAP nnx FROM _map_replace, nd, "value", nvx.
      REAP bd FROM _map_replace, bd, i, nnx.
    /IF.
    SET i TO i + 1.
  /SEASON.
  GIVE bd.
/ACTION.

ACTION parse_give_stmt(tokens(LIST), pos(NUM), clv(TX)),
  REAP lexer FROM get_lexer.

  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  CREATE gkws(LIST) TO plant_list_make(3, "AS", ")", ".").
  REAP vpair FROM collect_until_keyword, tokens, p2, gkws.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  REAP gtok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP glx FROM plant_iLexer_tok_lex, lexer, gtok.
  IF glx IS "AS",
    REAP gtok2 FROM plant_iLexer_peek_at, lexer, tokens, p3 + 1.
    REAP glx2 FROM plant_iLexer_tok_lex, lexer, gtok2.
    IF glx2 IS "RESPONSE",
      REAP as_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
      REAP p4 FROM _second, as_pair.
      REAP rs_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, rs_pair.
      CREATE rjson(TX) TO "".
      REAP rtok FROM plant_iLexer_peek_at, lexer, tokens, p5.
      REAP rlx FROM plant_iLexer_tok_lex, lexer, rtok.
      IF rlx IS "JSON",
        REAP drop_rj FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p5 FROM _second, drop_rj.
        SET rjson TO "1".
      /IF.
      REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, dot_pair.
      GIVE plant_list_make(2, plant_list_make(8, "type", "respond_stmt", "content", expr, "req", clv, "json", rjson), p6).
    /IF.
  /IF.
  REAP lexpr FROM _lower_dots, expr.
  SET expr TO lexpr.
  GIVE plant_list_make(2, plant_list_make(4, "type", "give_stmt", "value", expr), p3).
/ACTION.

ACTION parse_set_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP id_name FROM plant_iLexer_tok_lex, lexer, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP eq FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, eq.
  REAP vpair FROM collect_value, tokens, p4.
  CREATE expr TO vpair[0].
  REAP p5 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "set_stmt", "target", id_name, "value", expr), p5).
/ACTION.

#── INCREASE / DECREASE ─────────────────────────────────────────
# INCREASE target BY expr.  →  target += expr;
# DECREASE target BY expr.  →  target -= expr;
# op is "increase" or "decrease" (legacy PlantLang, gap 3.2).
# Returns [node, pos]; a missing "BY" is a syntax error.
ACTION parse_incdec_stmt(tokens(LIST), pos(NUM), op(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP id_name FROM plant_iLexer_tok_lex, lexer, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP by_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP by_lx FROM plant_iLexer_tok_lex, lexer, by_pair[0].
  REAP p4 FROM _second, by_pair.
  IF by_lx ISNT "BY",
    CREATE dmsg(TX) TO "Expected BY in " + op + " statement".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p3).
  /IF.
  REAP vpair FROM collect_value, tokens, p4.
  CREATE expr TO vpair[0].
  REAP p5 FROM _second, vpair.
  CREATE nty(TX) TO op + "_stmt".
  GIVE plant_list_make(2, plant_list_make(6, "type", nty, "target", id_name, "value", expr), p5).
/ACTION.

# parse_bloom_stmt - BLOOM Species AS var. (v0.49.28)
ACTION parse_bloom_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP kw_pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p FROM _second, kw_pair.
  REAP spair FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP species FROM plant_iLexer_tok_lex, lexer, spair[0].
  REAP p FROM _second, spair.
  REAP aspair FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP aslx FROM plant_iLexer_tok_lex, lexer, aspair[0].
  IF aslx ISNT "AS",
    CREATE berr(TX) TO "BLOOM requires AS var".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", berr), p).
  /IF.
  REAP p FROM _second, aspair.
  REAP vpair FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP vty FROM plant_iLexer_tok_type, lexer, vpair[0].
  IF vty ISNT "IDENT",
    CREATE berr2(TX) TO "BLOOM requires a variable name".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", berr2), p).
  /IF.
  REAP var FROM plant_iLexer_tok_lex, lexer, vpair[0].
  REAP p FROM _second, vpair.
  REAP dtp FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP p FROM _second, dtp.
  GIVE plant_list_make(2, plant_list_make(6, "type", "bloom_stmt", "species", species, "var", var), p).
/ACTION.

# _parse_ds_pattern - destructuring pattern for LET (v0.49.26).
ACTION _parse_ds_pattern(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP op_pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP oty FROM plant_iLexer_tok_type, lexer, op_pair[0].
  REAP p FROM _second, op_pair.
  CREATE kind(TX) TO "array".
  CREATE closek(TX) TO "RBRACKET".
  IF oty IS "LBRACE",
    SET kind TO "object".
    SET closek TO "RBRACE".
  /IF.
  CREATE items(LIST) TO plant_list_make(0).
  CREATE nm(TX) TO "".
  CREATE sub(TX) TO "".
  SEASON TRUE,
    REAP tk FROM plant_iLexer_peek_at, lexer, tokens, p.
    REAP ty FROM plant_iLexer_tok_type, lexer, tk.
    IF ty IS closek,
      REAP cp FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP p FROM _second, cp.
      BREAK 0.
    /IF.
    IF kind IS "object",
      REAP kp FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP key FROM plant_iLexer_tok_lex, lexer, kp[0].
      REAP p FROM _second, kp.
      SET nm TO key.
      SET sub TO "".
      REAP ctok FROM plant_iLexer_peek_at, lexer, tokens, p.
      REAP clx FROM plant_iLexer_tok_lex, lexer, ctok.
      IF clx IS ":",
        REAP cp_pair FROM plant_iLexer_consume_at, lexer, tokens, p.
        REAP p FROM _second, cp_pair.
        REAP ntok FROM plant_iLexer_peek_at, lexer, tokens, p.
        REAP nty FROM plant_iLexer_tok_type, lexer, ntok.
        IF nty IS "LBRACE" OR nty IS "LBRACKET",
          REAP spair FROM _parse_ds_pattern, tokens, p.
          REAP subn FROM _first, spair.
          SET sub TO subn.
          REAP p FROM _second, spair.
        /IF.
        IF nty ISNT "LBRACE" AND nty ISNT "LBRACKET",
          REAP npair FROM plant_iLexer_consume_at, lexer, tokens, p.
          REAP bn FROM plant_iLexer_tok_lex, lexer, npair[0].
          REAP p FROM _second, npair.
          SET nm TO bn.
        /IF.
      /IF.
      PUT plant_list_make(6, "key", key, "name", nm, "sub", sub) INTO items.
    /IF.
    IF kind ISNT "object",
      REAP etok FROM plant_iLexer_peek_at, lexer, tokens, p.
      REAP ety FROM plant_iLexer_tok_type, lexer, etok.
      IF ety IS "LBRACE" OR ety IS "LBRACKET",
        REAP spair FROM _parse_ds_pattern, tokens, p.
        REAP subn FROM _first, spair.
        SET sub TO subn.
        REAP p FROM _second, spair.
        PUT plant_list_make(6, "key", "", "name", "_", "sub", sub) INTO items.
      /IF.
      IF ety ISNT "LBRACE" AND ety ISNT "LBRACKET",
        REAP npair FROM plant_iLexer_consume_at, lexer, tokens, p.
        REAP en FROM plant_iLexer_tok_lex, lexer, npair[0].
        REAP p FROM _second, npair.
        PUT plant_list_make(6, "key", "", "name", en, "sub", "") INTO items.
      /IF.
    /IF.
    REAP stok FROM plant_iLexer_peek_at, lexer, tokens, p.
    REAP slx FROM plant_iLexer_tok_lex, lexer, stok.
    IF slx IS ",",
      REAP cmpair FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP p FROM _second, cmpair.
    /IF.
  /SEASON.
  GIVE plant_list_make(2, plant_list_make(8, "type", "ds_pat", "kind", kind, "items", items), p).
/ACTION.

ACTION parse_let_stmt(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  # v0.49.26 - destructuring patterns
  REAP dtk FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP dty FROM plant_iLexer_tok_type, lexer, dtk.
  IF dty IS "LBRACE" OR dty IS "LBRACKET",
    REAP dpat_pair FROM _parse_ds_pattern, tokens, p2.
    REAP dnode FROM _first, dpat_pair.
    REAP ditems FROM _map_get, dnode, "items".
    REAP dkind FROM _map_get, dnode, "kind".
    REAP p3d FROM _second, dpat_pair.
    REAP eqtok FROM plant_iLexer_peek_at, lexer, tokens, p3d.
    REAP eqlx FROM plant_iLexer_tok_lex, lexer, eqtok.
    IF eqlx ISNT "=",
      CREATE dderr(TX) TO "destructuring requires = expression".
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dderr), p3d).
    /IF.
    REAP eqpair FROM plant_iLexer_consume_at, lexer, tokens, p3d.
    REAP p4d FROM _second, eqpair.
    REAP dvpair FROM collect_value, tokens, p4d.
    CREATE dsrc TO dvpair[0].
    REAP p5d FROM _second, dvpair.
    GIVE plant_list_make(2, plant_list_make(10, "type", "let_destructure", "pattern", dkind, "vars", ditems, "source", dsrc), p5d).
  /IF.
  REAP id_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP id_name FROM plant_iLexer_tok_lex, lexer, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tv FROM collect_type_text, tokens, p4, ")", 0.
    REAP tt FROM _first, tv.
    REAP p5 FROM _second, tv.
    REAP rp FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tt.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP cb_tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP cb_lx FROM plant_iLexer_tok_lex, lexer, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP cb_tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP cb_lx FROM plant_iLexer_tok_lex, lexer, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

#── Closures ───────────────────────────────────────────────────
# parse_closure:
#   long form:  [MOVE x, REF y](params) -> expr
#   short form: [MOVE x] -> expr            (bracket entries ARE params)
#   short form: [MOVE x y z] -> expr        (multiple bare parameters)
# A bracket may also hold a block body: [MOVE x](params) -> ( stmts ).
# The closure body's single-expression form ends at "," or "."
# at depth 0; the block form ends at ")".
# Returns [closure_node, pos]; on failure [empty_list, start_pos];
# on mixed/invalid syntax [syntax_error_node, pos].
# The terminating "," or "." is NOT consumed (the caller handles it).

ACTION parse_closure(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  CREATE start_pos(NUM) TO pos.
  REAP lb FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, lb.
  CREATE captures(LIST) TO plant_list_make(0).
  CREATE entries(LIST) TO plant_list_make(0).
  CREATE had_comma(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(0), start_pos).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    REAP ty FROM plant_iLexer_tok_type, lexer, tok.
    IF lx IS "]",
      REAP rb FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p2 FROM _second, rb.
      BREAK 0.
    /IF.
    # a parenthesized parameter list inside the bracket mixes the
    # short (bare) and long (parenthesized) parameter forms
    IF lx IS "(",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Mixed closure parameter syntax"), p2).
    /IF.
    REAP ent_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP en0 FROM plant_iLexer_tok_lex, lexer, ent_pair[0].
    REAP p2 FROM _second, ent_pair.
    CREATE en_mode(TX) TO "".
    CREATE en_name(TX) TO "".
    IF en0 IS "MOVE" OR en0 IS "REF",
      SET en_mode TO en0.
      REAP ntok FROM plant_iLexer_peek_at, lexer, tokens, p2.
      REAP nlx FROM plant_iLexer_tok_lex, lexer, ntok.
      REAP nty FROM plant_iLexer_tok_type, lexer, ntok.
      IF nlx IS "(",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Mixed closure parameter syntax"), p2).
      /IF.
      IF nty ISNT "IDENT",
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      REAP npair FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP en_name FROM plant_iLexer_tok_lex, lexer, npair[0].
      REAP p2 FROM _second, npair.
    /IF.
    IF en_mode IS "",
      IF ty ISNT "IDENT",
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      SET en_name TO en0.
    /IF.
    PUT plant_list_make(2, en_mode, en_name) INTO entries.
    REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
    IF lx2 IS ",",
      SET had_comma TO "1".
      REAP com FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p2 FROM _second, com.
    /IF.
  /SEASON.
  # after "]": a "(" selects the long form (bracket = captures),
  # anything else selects the short form (bracket = bare parameters)
  REAP ptok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP plx FROM plant_iLexer_tok_lex, lexer, ptok.
  CREATE params(LIST) TO plant_list_make(0).
  IF plx IS "(",
    # a bare (comma-less) multi-entry bracket followed by a
    # parenthesized parameter list mixes the two parameter forms
    IF had_comma IS "0",
      IF COUNT entries > 1,
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Mixed closure parameter syntax"), p2).
      /IF.
    /IF.
    # long form: the bracket entries are captures
    CREATE ci2(NUM) TO 0.
    SEASON ci2 < COUNT entries,
      REAP ce2 FROM plant_list_get, entries, ci2.
      REAP cm2 FROM _first, ce2.
      REAP cn2 FROM _second, ce2.
      IF cm2 IS "",
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      PUT plant_list_make(4, "name", cn2, "mode", cm2) INTO captures.
      SET ci2 TO ci2 + 1.
    /SEASON.
    REAP lp FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p3 FROM _second, lp.
    SEASON TRUE,
      REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p3.
      IF is_eof_flag,
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p3.
      REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
      IF lx IS ")",
        REAP rp FROM plant_iLexer_consume_at, lexer, tokens, p3.
        REAP p4 FROM _second, rp.
        BREAK 0.
      /IF.
      REAP pn_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
      REAP pn FROM plant_iLexer_tok_lex, lexer, pn_pair[0].
      REAP p4 FROM _second, pn_pair.
      REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p4.
      REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
      IF lx2 IS "(",
        REAP lp2 FROM plant_iLexer_consume_at, lexer, tokens, p4.
        REAP p5 FROM _second, lp2.
        REAP ptv FROM collect_type_text, tokens, p5, ")", 1.
        REAP pt FROM _first, ptv.
        REAP p5 FROM _second, ptv.
        REAP rp2 FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p5 FROM _second, rp2.
        PUT plant_list_make(4, "name", pn, "type", pt) INTO params.
        SET p4 TO p5.
      /IF.
      IF lx2 ISNT "(",
        PUT plant_list_make(4, "name", pn, "type", "") INTO params.
      /IF.
      REAP tok3 FROM plant_iLexer_peek_at, lexer, tokens, p4.
      REAP lx3 FROM plant_iLexer_tok_lex, lexer, tok3.
      IF lx3 IS ",",
        REAP com2 FROM plant_iLexer_consume_at, lexer, tokens, p4.
        REAP p4 FROM _second, com2.
      /IF.
      SET p3 TO p4.
    /SEASON.
  /IF.
  IF plx ISNT "(",
    # short form: the bracket entries ARE the parameters; they default
    # to NUM so concise closures can be used in arithmetic directly
    CREATE si2(NUM) TO 0.
    SEASON si2 < COUNT entries,
      REAP se2 FROM plant_list_get, entries, si2.
      REAP sn2 FROM _second, se2.
      PUT plant_list_make(4, "name", sn2, "type", "NUM") INTO params.
      SET si2 TO si2 + 1.
    /SEASON.
    SET p4 TO p2.
  /IF.
  # "->"
  REAP atok FROM plant_iLexer_peek_at, lexer, tokens, p4.
  REAP alx FROM plant_iLexer_tok_lex, lexer, atok.
  IF alx ISNT "->",
    GIVE plant_list_make(2, plant_list_make(0), start_pos).
  /IF.
  REAP ap FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP p5 FROM _second, ap.
  # defensive skip of a stray MINUS (mirrors parse_action_decl)
  REAP stok FROM plant_iLexer_peek_at, lexer, tokens, p5.
  REAP sty FROM plant_iLexer_tok_type, lexer, stok.
  IF sty IS "MINUS",
    REAP sp FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p5 FROM _second, sp.
  /IF.
  # body: block form "-> ( stmts )" when "(" is followed by a
  # statement keyword; otherwise a single expression
  CREATE body_kind(TX) TO "expr".
  REAP btok FROM plant_iLexer_peek_at, lexer, tokens, p5.
  REAP blx FROM plant_iLexer_tok_lex, lexer, btok.
  CREATE body(LIST) TO plant_list_make(0).
  IF blx IS "(",
    REAP btok2 FROM plant_iLexer_peek_at, lexer, tokens, p5 + 1.
    REAP blx2 FROM plant_iLexer_tok_lex, lexer, btok2.
    IF blx2 IS "CREATE" OR blx2 IS "SHOW" OR blx2 IS "GIVE" OR blx2 IS "SET" OR blx2 IS "LET" OR blx2 IS "IF" OR blx2 IS "SEASON" OR blx2 IS "REAP" OR blx2 IS "PUT" OR blx2 IS "TAKE" OR blx2 IS "BREAK" OR blx2 IS "CONTINUE" OR blx2 IS "SORT" OR blx2 IS "SHAKE" OR blx2 IS "BRAID" OR blx2 IS "LINK" OR blx2 IS "HARVEST" OR blx2 IS "LISTEN" OR blx2 IS "CONST" OR blx2 IS "ROOT" OR blx2 IS "ROOT_SCOPE" OR blx2 IS "NOW" OR blx2 IS "ANALYZE" OR blx2 IS "TYPEOF" OR blx2 IS "FREE" OR blx2 IS "ARC" OR blx2 IS "FAST" OR blx2 IS "WAIT" OR blx2 IS "LOCK",
      SET body_kind TO "block".
      CREATE clv(TX) TO "".
      # v0.48.35: the closure block is its own C scope → own table
      CREATE ctab7(LIST) TO plant_list_make(0).
      CREATE bstart7(NUM) TO p6.
      REAP bp FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, bp.
      CREATE stmts(LIST) TO plant_list_make(0).
      SEASON TRUE,
        REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p6.
        IF is_eof_flag, BREAK 0. /IF.
        REAP btok3 FROM plant_iLexer_peek_at, lexer, tokens, p6.
        REAP blx3 FROM plant_iLexer_tok_lex, lexer, btok3.
        IF blx3 IS ")",
          REAP brp FROM plant_iLexer_consume_at, lexer, tokens, p6.
          REAP p6 FROM _second, brp.
          BREAK 0.
        /IF.
        REAP d_pair FROM parse_statement, tokens, p6, clv, ctab7, rtab, bstart7, emode.
        CREATE decl TO d_pair[0].
        REAP p6 FROM _second, d_pair.
        IF decl > "",
          REAP dty FROM _map_get, decl, "type".
          IF dty IS "syntax_error",
            GIVE d_pair.
          /IF.
          IF dty IS "listen_stmt",
            REAP dlv FROM _map_get, decl, "resp".
            SET clv TO dlv.
          /IF.
          PUT decl INTO stmts.
        /IF.
      /SEASON.
      SET body TO stmts.
      SET p5 TO p6.
    /IF.
  /IF.
  IF body_kind IS "expr",
    CREATE text(TX) TO "".
    CREATE bd(NUM) TO 0.
    CREATE pd(NUM) TO 0.
    SEASON TRUE,
      REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p5.
      IF is_eof_flag, BREAK 0. /IF.
      REAP etok FROM plant_iLexer_peek_at, lexer, tokens, p5.
      REAP elx FROM plant_iLexer_tok_lex, lexer, etok.
      REAP ety FROM plant_iLexer_tok_type, lexer, etok.
      IF ety IS "STRING",
        REAP elx FROM escape_string, elx.
        SET elx TO "\"" + elx + "\"".
      /IF.
      IF elx IS "," AND pd IS 0 AND bd IS 0, BREAK 0. /IF.
      IF elx IS "." AND pd IS 0 AND bd IS 0, BREAK 0. /IF.
      IF elx IS "(", SET pd TO pd + 1. /IF.
      IF elx IS ")", SET pd TO pd - 1. /IF.
      IF elx IS "[", SET bd TO bd + 1. /IF.
      IF elx IS "]", SET bd TO bd - 1. /IF.
      IF text > "",
        SET text TO text + " ".
      /IF.
      SET text TO text + elx.
      REAP ep FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, ep.
    /SEASON.
    SET body TO text.
  /IF.
  CREATE cnode(LIST) TO plant_list_make(10, "type", "closure", "params", params, "captures", captures, "body", body, "bkind", body_kind).
  GIVE plant_list_make(2, cnode, p5).
/ACTION.

# _is_type_text — "1" when t is comma-separated type names (plain
# identifiers, optionally REF-prefixed or LIST[...]-parameterized).
# v0.49.6 — distinguishes generic args (foo[NUM, TX], ped[Color])
# from index expressions at REAP call sites: any digit literal,
# operator, or quote in the content marks an index (REAP x FROM
# a[0].), since type names are always identifier-shaped.
ACTION _is_type_text(t(TX), rtab(LIST)),
  REAP lexer FROM get_lexer.
  REAP parts FROM strings:SPLIT, t, ",".
  CREATE ti(NUM) TO 0.
  CREATE tp(TX) TO "".
  SEASON ti < COUNT parts,
    REAP tp FROM plant_list_get, parts, ti.
    REAP tp FROM trim, tp.
    IF LEN(tp) IS 0, GIVE 0. /IF.
    REAP refp FROM substring, tp, 0, 3.
    IF refp IS "REF",
      REAP tp FROM substring, tp, 4, LEN(tp).
      REAP tp FROM trim, tp.
    /IF.
    REAP bi FROM find_any, tp, "[".
    IF bi ISNT -1,
      REAP tp FROM substring, tp, 0, bi.
      REAP tp FROM trim, tp.
    /IF.
    REAP tk FROM is_identifier, tp.
    IF tk IS 0, GIVE 0. /IF.
    SET ti TO ti + 1.
  /SEASON.
  GIVE 1.
/ACTION.

ACTION parse_reap_stmt(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP var_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP var_name FROM plant_iLexer_tok_lex, lexer, var_pair[0].
  REAP p3 FROM _second, var_pair.
  REAP from_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, from_pair.
  REAP act_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP act_name FROM plant_iLexer_tok_lex, lexer, act_pair[0].
  REAP act_ty FROM plant_iLexer_tok_type, lexer, act_pair[0].
  REAP p5 FROM _second, act_pair.
  # Check for module:function syntax (e.g., strings:REPLACE)
  REAP next_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
  REAP next_lx FROM plant_iLexer_tok_lex, lexer, next_tok.
  REAP next_ty FROM plant_iLexer_tok_type, lexer, next_tok.
    IF next_ty IS "COLON",
      SET act_name TO act_name + ":".
      REAP colon_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, colon_pair.
      REAP func_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP func_name FROM plant_iLexer_tok_lex, lexer, func_pair[0].
      SET act_name TO act_name + func_name.
      REAP p5 FROM _second, func_pair.
    /IF.
  # generic type arguments at the call site: foo[NUM, TX]
  CREATE is_genargs(TX) TO "0".
  REAP ga_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
  REAP ga_lx FROM plant_iLexer_tok_lex, lexer, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p5 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p5, "]", 0.
    REAP gtext FROM _first, gv.
    # v0.49.6 — the [ ... ] after a REAP action is generic type args
    # only when its content is pure type text (identifiers, commas,
    # and registered generic names). Otherwise it is an index
    # expression: REAP x FROM a[0]. — re-collect the whole value
    # starting at the action token (p4) and emit an expression reap
    # that the codegen translates like any other value.
    REAP isgt FROM _is_type_text, gtext, rtab.
    IF isgt IS 0,
      REAP vpair FROM collect_value, tokens, p4.
      REAP exprt FROM _first, vpair.
      REAP p6 FROM _second, vpair.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_expr_stmt", "target", var_name, "expr", exprt, "args", plant_list_make(0), "clargs", plant_list_make(0), "ctx", ""), p6).
    /IF.
    IF isgt IS 1,
    REAP p5 FROM _second, gv.
    REAP ga_rb FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p5 FROM _second, ga_rb.
    SET act_name TO act_name + "[" + gtext + "]".
    SET is_genargs TO "1".
    /IF.
  /IF.
  # v0.49.9 — general-expression REAP: REAP x FROM FIND(s, t). /
  # ABS(-7) / a + b / COUNT lst / literals — the value is any
  # translate-time expression, not an action call. The legacy action
  # forms win: ",", ":", and "[" type args were handled above, and a
  # parens call keeps the legacy path UNLESS the name is a
  # translate-time builtin (the legacy path would emit a raw C
  # name(...) call and fail at link time). A bare IDENT keeps the
  # legacy path too (zero-arg action call or space-form args).
  IF is_genargs ISNT "1",
    REAP ex_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP ex_lx FROM plant_iLexer_tok_lex, lexer, ex_tok.
    REAP ex_ty FROM plant_iLexer_tok_type, lexer, ex_tok.
    IF ex_ty ISNT "COLON" AND ex_lx ISNT "," AND ex_lx ISNT "[",
      # bare name followed by "." is a legacy zero-arg call
      # (action or module function) — never an expression; unless
      # the dot opens a field access (a.b), which is an expression
      CREATE bare_call(TX) TO "0".
      IF act_ty IS "IDENT",
        IF ex_lx IS ".",
          REAP fchk FROM parse_field_access, tokens, p5, act_name, "0".
          REAP fchk0 FROM _first, fchk.
          IF fchk0 ISNT "1",
            SET bare_call TO "1".
          /IF.
        /IF.
      /IF.
      IF bare_call ISNT "1",
      CREATE ex_builtin(TX) TO "0".
      REAP ex_builtin FROM is_reap_builtin, act_name.
      CREATE ex_ok(TX) TO "0".
      IF ex_builtin IS "1", SET ex_ok TO "1". /IF.
      IF ex_builtin ISNT "1",
        IF ex_ty ISNT "IDENT",
          IF ex_lx ISNT "(",
            SET ex_ok TO "1".
          /IF.
        /IF.
      /IF.
      IF ex_ok IS "1",
        REAP vpair2 FROM collect_value, tokens, p4.
        REAP exprt2 FROM _first, vpair2.
        REAP p6 FROM _second, vpair2.
        GIVE plant_list_make(2, plant_list_make(12, "type", "reap_expr_stmt", "target", var_name, "expr", exprt2, "args", plant_list_make(0), "clargs", plant_list_make(0), "ctx", ""), p6).
      /IF.
      /IF.
    /IF.
  /IF.
  # v0.48.37c: REAP r FROM f(a, b, c). — consume the call parens
  # upfront so multi-arg calls split on "," at depth 0 instead of
  # collapsing into a single "( a , b , c )" expression (previously
  # only single-arg calls worked; f() and bare f. are still valid).
  CREATE has_cparen(TX) TO "0".
  REAP cp_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
  REAP cp_lx FROM plant_iLexer_tok_lex, lexer, cp_tok.
  IF cp_lx IS "(",
    REAP cp_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p5 FROM _second, cp_pair.
    SET has_cparen TO "1".
  /IF.
  CREATE args(LIST) TO plant_list_make(0).
  CREATE clargs(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tok0 FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx0 FROM plant_iLexer_tok_lex, lexer, tok0.
    REAP ty0 FROM plant_iLexer_tok_type, lexer, tok0.
    IF lx0 IS "," AND ty0 ISNT "STRING",
      REAP com0 FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, com0.
    /IF.
    # closure argument: [MOVE x, REF y](v(NUM)) -> expr
    REAP ctok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP clx FROM plant_iLexer_tok_lex, lexer, ctok.
    IF clx IS "[",
      REAP clp FROM parse_closure, tokens, p5, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p6 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p6).
      /IF.
      IF COUNT cnode > 0,
        PUT "@@CLOSURE@@" INTO args.
        PUT cnode INTO clargs.
        SET p5 TO p6.
        REAP ctok2 FROM plant_iLexer_peek_at, lexer, tokens, p5.
        REAP clx2 FROM plant_iLexer_tok_lex, lexer, ctok2.
        IF clx2 IS ",",
          REAP ccom FROM plant_iLexer_consume_at, lexer, tokens, p5.
          REAP p5 FROM _second, ccom.
        /IF.
        IF clx2 IS ".",
          REAP cdot FROM plant_iLexer_consume_at, lexer, tokens, p5.
          REAP p6 FROM _second, cdot.
          GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6).
        /IF.
      /IF.
    /IF.
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p5).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    REAP ty FROM plant_iLexer_tok_type, lexer, tok.
    # "IN" at depth 0 after the args → REAP ... IN ctx (async spawn
    # into a context; the reaped handle belongs to that context)
    IF lx IS "IN" AND ty ISNT "STRING",
      REAP in_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5b FROM _second, in_pair.
      REAP ctx_pair FROM plant_iLexer_consume_at, lexer, tokens, p5b.
      REAP ctx_name FROM plant_iLexer_tok_lex, lexer, ctx_pair[0].
      REAP p6b FROM _second, ctx_pair.
      REAP dot2 FROM plant_iLexer_consume_at, lexer, tokens, p6b.
      REAP p7b FROM _second, dot2.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ctx_name), p7b).
    /IF.
    IF lx IS "." AND ty ISNT "STRING",
      REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6).
    /IF.
    # v0.48.37c: closing call paren consumed by f(…). — end the arg
    # list. Also covers the zero-arg f() form (empty args list).
    # f() IN ctx. is handled too (ctx after the closing paren).
    IF has_cparen IS "1" AND lx IS ")" AND ty ISNT "STRING",
      REAP rp FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5r FROM _second, rp.
      REAP in_tok FROM plant_iLexer_peek_at, lexer, tokens, p5r.
      REAP in_lx FROM plant_iLexer_tok_lex, lexer, in_tok.
      REAP in_ty FROM plant_iLexer_tok_type, lexer, in_tok.
      IF in_lx IS "IN" AND in_ty ISNT "STRING",
        REAP in_pair FROM plant_iLexer_consume_at, lexer, tokens, p5r.
        REAP p5r FROM _second, in_pair.
        REAP ctx_pair FROM plant_iLexer_consume_at, lexer, tokens, p5r.
        REAP ctx_name FROM plant_iLexer_tok_lex, lexer, ctx_pair[0].
        REAP p5r FROM _second, ctx_pair.
        REAP dot3 FROM plant_iLexer_consume_at, lexer, tokens, p5r.
        REAP p5r FROM _second, dot3.
        GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ctx_name), p5r).
      /IF.
      REAP dot3 FROM plant_iLexer_consume_at, lexer, tokens, p5r.
      REAP p6r FROM _second, dot3.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6r).
    /IF.
    # collect one argument until , or . at depth 0 (do NOT consume delimiter)
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM plant_iLexer_peek_at, lexer, tokens, p5.
      REAP alx FROM plant_iLexer_tok_lex, lexer, atok.
      REAP atype FROM plant_iLexer_tok_type, lexer, atok.
      IF atype IS "STRING" OR atype IS "INTERP",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      # v0.49.10 — field access extends the arg text before the
      # comma/dot/close splits it (REAP x FROM f, a.b.)
      IF alx IS "." AND arg_text > "",
        REAP fpp FROM parse_field_access, tokens, p5, arg_text, _from_long(adepth).
        REAP fpf FROM _first, fpp.
        IF fpf IS "1",
          REAP fpt FROM _second, fpp.
          REAP fpp2 FROM _third, fpp.
          SET arg_text TO fpt.
          SET p5 TO fpp2.
          CONTINUE 0.
        /IF.
      /IF.
      IF alx IS "." AND adepth IS 0, BREAK 0. /IF.
      # ")" at depth 0 closes an enclosing closure block body
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "IN" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      # v0.49.6 — [ ... ] literal spans hold depth, so a comma inside
      # [1, 2] is not an arg split (REAP r FROM f, [1, 2].)
      IF alx IS "[", SET adepth TO adepth + 1. /IF.
      IF alx IS "]", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    # v0.48.18: `REAP r FROM f().` — the empty parens are collected
    # as a "( )" arg expression; drop them so zero-arg reaps emit
    # f() instead of the invalid f(( )).
    IF arg_text ISNT "( )",
        PUT arg_text INTO args.
    /IF.
    REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
    IF lx2 IS ",",
      REAP com FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    IF lx2 IS ".",
      REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6).
    /IF.
  /SEASON.
/ACTION.

# v0.49.9 — is this name a translate-time builtin (mirrors the
# _handle_func_paren / _handle_func / _ni_replace list in
# translate_expr)? The legacy REAP action path would emit it as a
# raw C name(...) call and fail at link time, so builtin REAPs are
# routed to the expression path. Bare action identifiers are never
# builtins.
ACTION is_reap_builtin(name(TX)),
  REAP lexer FROM get_lexer.
  IF name IS "LEN" OR name IS "JOIN" OR name IS "FIRST" OR name IS "LAST" OR name IS "SUM" OR name IS "UPPER" OR name IS "LOWER" OR name IS "TRIM" OR name IS "REVERSE" OR name IS "ABS" OR name IS "ROUND" OR name IS "POW" OR name IS "CEIL" OR name IS "FLOOR" OR name IS "RANDOM" OR name IS "SIN" OR name IS "COS" OR name IS "SQRT" OR name IS "HAS" OR name IS "ANY" OR name IS "ALL" OR name IS "PICK" OR name IS "FIND" OR name IS "COUNT_OF" OR name IS "SLICE" OR name IS "TAP" OR name IS "INFUSE" OR name IS "ABSORB" OR name IS "SEAL" OR name IS "TEST" OR name IS "COUNT" OR name IS "NOW" OR name IS "ANALYZE" OR name IS "TYPEOF" OR name IS "INCLUDES" OR name IS "STARTS_WITH" OR name IS "ENDS_WITH" OR name IS "REPEAT" OR name IS "PAD" OR name IS "PAD_LEFT" OR name IS "REVERSE" OR name IS "RANGE" OR name IS "SORT" OR name IS "INDEX_OF" OR name IS "UNIQUE" OR name IS "AVERAGE" OR name IS "MEDIAN" OR name IS "FLATTEN" OR name IS "CHUNK" OR name IS "ZIP" OR name IS "FILTER_GT" OR name IS "FILTER_LT",
    GIVE "1".
  /IF.
  # v0.49.17 — extended math built-ins (REAP ingestion).
  IF name IS "MIN" OR name IS "MAX" OR name IS "TAN" OR name IS "ATAN" OR name IS "COT" OR name IS "ASIN" OR name IS "ACOS" OR name IS "ATAN2" OR name IS "SINH" OR name IS "COSH" OR name IS "TANH" OR name IS "EXP" OR name IS "EXPM1" OR name IS "LOG10" OR name IS "LOG2" OR name IS "LOG1P" OR name IS "HYPOT",
    GIVE "1".
  /IF.
  # v0.49.18 — advanced math built-ins (REAP ingestion).
  IF name IS "SEC" OR name IS "CSC" OR name IS "ASINH" OR name IS "ACOSH" OR name IS "ATANH" OR name IS "ERF" OR name IS "ERFC" OR name IS "GAMMA" OR name IS "LGAMMA" OR name IS "EXP2" OR name IS "LOG_BASE",
    GIVE "1".
  /IF.
  # v0.49.19 — natural logarithm built-in (REAP ingestion).
  IF name IS "LOG",
    GIVE "1".
  /IF.
  # v0.49.23 — numerical analysis built-ins (REAP ingestion).
  IF name IS "LU" OR name IS "EIGEN" OR name IS "SVD" OR name IS "SOLVE" OR name IS "COND",
    GIVE "1".
  /IF.
  # v0.49.22 — linear algebra built-ins (REAP ingestion).
  IF name IS "DOT" OR name IS "CROSS" OR name IS "NORM" OR name IS "TRANSPOSE" OR name IS "MATRIX_MULT" OR name IS "INVERSE" OR name IS "DET",
    GIVE "1".
  /IF.
  # v0.49.21 — statistical & array aggregation built-ins.
  IF name IS "VARIANCE" OR name IS "STDDEV" OR name IS "PRODUCT" OR name IS "MODE",
    GIVE "1".
  /IF.
  # v0.49.20 — monadic constructors (REAP ingestion; underscore
  # compounds avoid dot-notation ambiguity).
  IF name IS "Option_Some" OR name IS "Option_None" OR name IS "Result_Ok" OR name IS "Result_Err",
    GIVE "1".
  /IF.
  GIVE "0".
/ACTION.

# parse_call_stmt — bare call: name(args). → call_stmt node.
# (void FFI calls like plant_map_set / ffi_swap_ref; the codegen
#  reuses the reap_stmt discard path with target "_")
ACTION parse_call_stmt(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP act_pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP act_name FROM plant_iLexer_tok_lex, lexer, act_pair[0].
  REAP p5 FROM _second, act_pair.
  REAP next_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
  REAP next_ty FROM plant_iLexer_tok_type, lexer, next_tok.
  IF next_ty IS "COLON",
    SET act_name TO act_name + ":".
    REAP colon_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p5 FROM _second, colon_pair.
    REAP func_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP func_name FROM plant_iLexer_tok_lex, lexer, func_pair[0].
    SET act_name TO act_name + func_name.
    REAP p5 FROM _second, func_pair.
  /IF.
  REAP ga_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
  REAP ga_lx FROM plant_iLexer_tok_lex, lexer, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p5 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p5, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p5 FROM _second, gv.
    REAP ga_rb FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p5 FROM _second, ga_rb.
    SET act_name TO act_name + "[" + gtext + "]".
  /IF.
  REAP lpar FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP p5 FROM _second, lpar.
  CREATE args(LIST) TO plant_list_make(0).
  CREATE clargs(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tok0 FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx0 FROM plant_iLexer_tok_lex, lexer, tok0.
    REAP ty0 FROM plant_iLexer_tok_type, lexer, tok0.
    IF lx0 IS "," AND ty0 ISNT "STRING",
      REAP com0 FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, com0.
    /IF.
    REAP ctok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP clx FROM plant_iLexer_tok_lex, lexer, ctok.
    IF clx IS "[",
      REAP clp FROM parse_closure, tokens, p5, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p6 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p6).
      /IF.
      IF COUNT cnode > 0,
        PUT "@@CLOSURE@@" INTO args.
        PUT cnode INTO clargs.
        SET p5 TO p6.
        REAP ctok2 FROM plant_iLexer_peek_at, lexer, tokens, p5.
        REAP clx2 FROM plant_iLexer_tok_lex, lexer, ctok2.
        IF clx2 IS ",",
          REAP ccom FROM plant_iLexer_consume_at, lexer, tokens, p5.
          REAP p5 FROM _second, ccom.
        /IF.
      /IF.
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS ")",
      REAP rp FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, rp.
      REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(8, "type", "call_stmt", "action", act_name, "args", args, "clargs", clargs), p6).
    /IF.
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM plant_iLexer_peek_at, lexer, tokens, p5.
      REAP alx FROM plant_iLexer_tok_lex, lexer, atok.
      REAP atype FROM plant_iLexer_tok_type, lexer, atok.
      IF atype IS "STRING" OR atype IS "INTERP",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    PUT arg_text INTO args.
    REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
    IF lx2 IS ",",
      REAP com FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_put_stmt(tokens(LIST), pos(NUM)),  REAP lexer FROM get_lexer.    REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_until, tokens, p2, "INTO".
  CREATE item TO vpair[0].
  REAP p3 FROM _second, vpair.
  REAP into_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, into_pair.
  REAP tpair FROM collect_until, tokens, p4, ".".
  CREATE target TO tpair[0].
  REAP p5 FROM _second, tpair.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP p6 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "put_stmt", "item", item, "target", target), p6).
/ACTION.

# v0.48.30 — TAKE val FROM list. (removes the first matching item)
ACTION parse_take_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_until, tokens, p2, "FROM".
  CREATE item TO vpair[0].
  REAP p3 FROM _second, vpair.
  REAP from_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, from_pair.
  REAP tpair FROM collect_until, tokens, p4, ".".
  CREATE target TO tpair[0].
  REAP p5 FROM _second, tpair.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP p6 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "take_stmt", "item", item, "target", target), p6).
/ACTION.

# v0.48.31 — BRAID l1 WITH l2 AS name [MAP].
#   no MAP  → pair-list zip (plant_braid)
#   with MAP → map build with unique keys (plant_braid_map)
ACTION parse_braid_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP lpair FROM collect_until, tokens, p2, "WITH".
  CREATE left TO lpair[0].
  REAP p3 FROM _second, lpair.
  REAP with_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, with_pair.
  REAP rpair FROM collect_until, tokens, p4, "AS".
  CREATE right TO rpair[0].
  REAP p5 FROM _second, rpair.
  REAP as_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP p6 FROM _second, as_pair.
  CREATE target(TX) TO "".
  SEASON TRUE,
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p6.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "MAP" OR lx IS "." OR lx IS "",
      BREAK 0.
    /IF.
    SET target TO target + lx.
    REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p6.
    REAP p6 FROM _second, drop.
  /SEASON.
  CREATE is_map(TX) TO "0".
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p6.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "MAP",
    SET is_map TO "1".
    REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p6.
    REAP p6 FROM _second, drop.
  /IF.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p6.
  REAP p7 FROM _second, dot_pair.
  IF is_map IS "1",
    GIVE plant_list_make(2, plant_list_make(8, "type", "braid_map_stmt", "left", left, "right", right, "target", target), p7).
  /IF.
  GIVE plant_list_make(2, plant_list_make(8, "type", "braid_stmt", "left", left, "right", right, "target", target), p7).
/ACTION.

# v0.48.31 — LINK key WITH value IN map. (upsert: update in place
#   when the key exists, append a new pair otherwise)
ACTION parse_link_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP kpair FROM collect_until, tokens, p2, "WITH".
  CREATE key TO kpair[0].
  REAP p3 FROM _second, kpair.
  REAP with_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, with_pair.
  REAP vpair FROM collect_until, tokens, p4, "IN".
  CREATE value TO vpair[0].
  REAP p5 FROM _second, vpair.
  REAP in_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP p6 FROM _second, in_pair.
  REAP mpair FROM collect_until, tokens, p6, ".".
  CREATE target TO mpair[0].
  REAP p7 FROM _second, mpair.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p7.
  REAP p8 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "link_stmt", "key", key, "value", value, "target", target), p8).
/ACTION.

# v0.48.29 — SORT l [ASC|DESC] [BY f [ASC|DESC] {, g [ASC|DESC]}].
#   no BY   → plain element sort, direction gdir (default ASC)
#   BY list → per-field directions, each defaulting to gdir (ASC)
ACTION parse_sort_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  CREATE target(TX) TO "".
  CREATE gdir(TX) TO "".
  SEASON TRUE,
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "BY" OR lx IS "ASC" OR lx IS "DESC" OR lx IS "." OR lx IS "",
      BREAK 0.
    /IF.
    SET target TO target + lx.
    REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, drop.
  /SEASON.
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "ASC" OR lx IS "DESC",
    SET gdir TO lx.
    REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, drop.
  /IF.
  CREATE fields(LIST) TO plant_list_make(0).
  CREATE dirs(LIST) TO plant_list_make(0).
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "BY",
    REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, drop.
    SEASON TRUE,
      REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
      REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
      IF lx IS ",",
        REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p2.
        REAP p2 FROM _second, drop.
      /IF.
      REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
      REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
      IF lx IS "." OR lx IS "" OR lx IS ",",
        BREAK 0.
      /IF.
      SET fields TO plant_list_push(fields, lx).
      REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p2 FROM _second, drop.
      REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
      REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok.
      IF lx2 IS "ASC" OR lx2 IS "DESC",
        SET dirs TO plant_list_push(dirs, lx2).
        REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p2.
        REAP p2 FROM _second, drop.
      /IF.
      IF lx2 ISNT "ASC" AND lx2 ISNT "DESC",
        SET dirs TO plant_list_push(dirs, "").
      /IF.
    /SEASON.
  /IF.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(10, "type", "sort_stmt", "target", target, "gdir", gdir, "fields", fields, "dirs", dirs), p3).
/ACTION.

# v0.48.29 — SHAKE l. (Fisher-Yates random reordering)
ACTION parse_shake_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP tpair FROM collect_until, tokens, p2, ".".
  CREATE target TO tpair[0].
  REAP p3 FROM _second, tpair.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "shake_stmt", "target", target), p4).
/ACTION.

ACTION parse_break_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  IF p2 < COUNT tokens,
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "0",
      REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p2 FROM _second, drop.
    /IF.
  /IF.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "break_stmt"), p3).
/ACTION.

ACTION parse_continue_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "continue_stmt"), p3).
/ACTION.

ACTION parse_if_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, com.
  # v0.48.35: each branch is its own C block → its own CONST table
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p4.
  CREATE body(LIST) TO plant_list_make(0).
  CREATE cur_cond(TX) TO "".
  CREATE cur_body(LIST) TO plant_list_make(0).
  CREATE elif(LIST) TO plant_list_make(0).
  CREATE else_body(LIST) TO plant_list_make(0).
  CREATE in_elif(TX) TO "0".
  CREATE in_else(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p4.
    IF is_eof_flag,
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      GIVE plant_list_make(2, plant_list_make(10, "type", "if_stmt", "cond", cond, "body", body, "elif", elif, "else", else_body), p4).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "/",
      REAP slash FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP if_close FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, if_close.
      REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p6.
      REAP p7 FROM _second, dot.
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      GIVE plant_list_make(2, plant_list_make(10, "type", "if_stmt", "cond", cond, "body", body, "elif", elif, "else", else_body), p7).
    /IF.
    IF lx IS "ORIF",
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      REAP o_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, o_pair.
      REAP ocp FROM collect_until, tokens, p5, ",".
      REAP ocond FROM _first, ocp.
      REAP p6 FROM _second, ocp.
      REAP ocom FROM plant_iLexer_consume_at, lexer, tokens, p6.
      REAP p7 FROM _second, ocom.
      SET cur_cond TO ocond.
      SET cur_body TO plant_list_make(0).
      SET in_elif TO "1".
      SET in_else TO "0".
      SET p4 TO p7.
      SET ctab TO plant_list_make(0).
      SET bstart TO p7.
      CONTINUE 0.
    /IF.
    IF lx IS "ELSE",
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      REAP e_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, e_pair.
      SET in_else TO "1".
      SET p4 TO p5.
      SET ctab TO plant_list_make(0).
      SET bstart TO p5.
      CONTINUE 0.
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4, clv, ctab, rtab, bstart, emode.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      IF in_else IS "1",
        PUT stmt INTO else_body.
      /IF.
      IF in_else IS "0",
        IF in_elif IS "1",
          PUT stmt INTO cur_body.
        /IF.
        IF in_elif IS "0",
          PUT stmt INTO body.
        /IF.
      /IF.
    /IF.
  /SEASON.
/ACTION.

# v0.49.7 — MATCH subject { pattern -> body } — pattern dispatch over
#   a subject expression. Patterns:
#     - static literals: NUMBER, quoted STRING, TRUE/FALSE
#     - wildcard: _ (must be the last arm)
#     - tagged binding: Name(var) — matches a [tag, payload] pair
#       list and binds the payload to var in the arm body; bare Name
#       matches the tag without binding.
#   Bodies are a single statement or a { … } group of statements.
#   AST: match_stmt with subjectExpr and clauses (a list of
#   [variantName, binding, bodyStatements] triples; variantName is
#   the C-quoted literal text, "_", or the bare tag name).
ACTION parse_match_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP spair FROM collect_until_keyword, tokens, p2, plant_list_make(1, "{").
  CREATE subj(TX) TO spair[0].
  REAP p3 FROM _second, spair.
  IF subj IS "",
    GIVE plant_list_make(2, null, p3).
  /IF.
  REAP lb FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, lb.
  CREATE clauses(LIST) TO plant_list_make(0).
  CREATE wild_seen(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(12, "type", "match_stmt", "subjectExpr", subj, "clauses", clauses), p4).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    REAP tt FROM plant_iLexer_tok_type, lexer, tok.
    IF lx IS "}",
      REAP rb FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, rb.
      GIVE plant_list_make(2, plant_list_make(12, "type", "match_stmt", "subjectExpr", subj, "clauses", clauses), p5).
    /IF.
    CREATE ptext(TX) TO "".
    CREATE pbind(TX) TO "".
    IF tt IS "NUMBER" OR tt IS "STRING" OR tt IS "INTERP" OR tt IS _cat("TR", "UE") OR tt IS _cat("FA", "LSE"),
      IF tt IS "STRING" OR tt IS "INTERP",
        REAP esc FROM escape_string, lx.
        SET ptext TO esc.
      /IF.
      IF tt IS "NUMBER", SET ptext TO lx. /IF.
      IF tt IS _cat("TR", "UE"), SET ptext TO _cat("\"T", "RUE\""). /IF.
      IF tt IS _cat("FA", "LSE"), SET ptext TO _cat("\"F", "ALSE\""). /IF.
      REAP pcons FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p4 FROM _second, pcons.
    /IF.
    IF tt IS "WILDCARD",
      SET ptext TO "_".
      REAP pcons FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p4 FROM _second, pcons.
    /IF.
    IF tt IS "IDENT",
      REAP pcons FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p4 FROM _second, pcons.
      REAP ntok FROM plant_iLexer_peek_at, lexer, tokens, p4.
      REAP ntt FROM plant_iLexer_tok_type, lexer, ntok.
      IF ntt IS "LPAREN",
        REAP ntok2 FROM plant_iLexer_peek_at, lexer, tokens, p4 + 1.
        REAP ntt2 FROM plant_iLexer_tok_type, lexer, ntok2.
        IF ntt2 ISNT "IDENT",
          GIVE plant_list_make(2, null, p4).
        /IF.
        CREATE bnd TO ntok2[1].
        REAP lpair FROM plant_iLexer_consume_at, lexer, tokens, p4.
        REAP p4b FROM _second, lpair.
        REAP bpair FROM plant_iLexer_consume_at, lexer, tokens, p4b.
        REAP p4c FROM _second, bpair.
        REAP rpair FROM plant_iLexer_consume_at, lexer, tokens, p4c.
        REAP p4 FROM _second, rpair.
        SET ptext TO lx.
        SET pbind TO bnd.
      /IF.
      IF ntt ISNT "LPAREN",
        SET ptext TO lx.
      /IF.
    /IF.
    IF ptext IS "",
      GIVE plant_list_make(2, null, p4).
    /IF.
    IF ptext IS "_" AND wild_seen IS "1",
      GIVE plant_list_make(2, null, p4).
    /IF.
    IF ptext IS "_", SET wild_seen TO "1". /IF.
    IF wild_seen IS "1" AND ptext ISNT "_",
      GIVE plant_list_make(2, null, p4).
    /IF.
    REAP atok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP alx FROM plant_iLexer_tok_lex, lexer, atok.
    IF alx ISNT "->",
      GIVE plant_list_make(2, null, p4).
    /IF.
    REAP ar FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP p4 FROM _second, ar.
    CREATE ctab(LIST) TO plant_list_make(0).
    CREATE bstart(NUM) TO p4.
    CREATE cbody(LIST) TO plant_list_make(0).
    REAP btok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP blx FROM plant_iLexer_tok_lex, lexer, btok.
    IF blx IS "{",
      REAP lbg FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p4 FROM _second, lbg.
      SEASON TRUE,
        REAP is_eof2 FROM plant_iLexer_is_eof_at, lexer, tokens, p4.
        IF is_eof2, BREAK 0. /IF.
        REAP btok2 FROM plant_iLexer_peek_at, lexer, tokens, p4.
        REAP blx2 FROM plant_iLexer_tok_lex, lexer, btok2.
        IF blx2 IS "}",
          REAP rbg FROM plant_iLexer_consume_at, lexer, tokens, p4.
          REAP p4 FROM _second, rbg.
          BREAK 0.
        /IF.
        REAP bpair2 FROM parse_statement, tokens, p4, clv, ctab, rtab, bstart, emode.
        CREATE bstmt TO bpair2[0].
        REAP p4 FROM _second, bpair2.
        IF bstmt > "",
          PUT bstmt INTO cbody.
        /IF.
      /SEASON.
    /IF.
    IF blx ISNT "{",
      REAP bpair2 FROM parse_statement, tokens, p4, clv, ctab, rtab, bstart, emode.
      CREATE bstmt TO bpair2[0].
      REAP p4 FROM _second, bpair2.
      IF bstmt > "",
        PUT bstmt INTO cbody.
      /IF.
    /IF.
    REAP dotok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP dotlx FROM plant_iLexer_tok_lex, lexer, dotok.
    IF dotlx IS ".",
      REAP dcons FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p4 FROM _second, dcons.
    /IF.
    PUT plant_list_make(12, "variantName", ptext, "binding", pbind, "bodyStatements", cbody) INTO clauses.
  /SEASON.
/ACTION.

ACTION parse_season_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, com.
  # v0.48.35: the SEASON body is its own C block → own CONST table
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p4.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p4).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "/",
      REAP slash FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP season_close FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, season_close.
      REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p6.
      REAP p7 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p7).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4, clv, ctab, rtab, bstart, emode.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

# ── CYCLE forms: FROM/TO numeric range (v0.48.21), IN list
#    iteration with optional index (v0.48.22) →
#    cycle_stmt AST node:
#    CYCLE i FROM lo TO hi [STEP k],      → fromExpr/toExpr/stepExpr
#    CYCLE item IN list,                  → listExpr, indexVar ""
#    CYCLE item, idx IN list,             → listExpr + indexVar
# STEP defaults to 1; since v0.49.8 the STEP clause is parsed
# token-wise with collect_until_keyword (STEP is a lexer keyword), so
# "STEP 2", "STEP  2", "STEP -2" and "STEP-2" all parse, with a
# guarded prefix split recovering the attached "STEP2" form (see the
# FROM branch).
ACTION parse_cycle_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP ivar FROM plant_iLexer_tok_lex, lexer, tok.
  REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP p2 FROM _second, cpair.
  CREATE fromExpr(TX) TO "".
  CREATE toExpr(TX) TO "".
  CREATE stepExpr(TX) TO "".
  CREATE listExpr(TX) TO "".
  CREATE indexVar(TX) TO "".
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "FROM",
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP cpair FROM collect_until, tokens, p2, "TO".
    SET fromExpr TO cpair[0].
    REAP p3 FROM _second, cpair.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p3 FROM _second, cpair.
    # v0.49.8 — the to-expression is collected token-wise and stops at
    # the STEP keyword (or the comma), so any spacing around STEP is
    # accepted: "STEP 2", "STEP  2", "STEP -2" and "STEP-2" (the '-'
    # is its own MINUS token, so both lex identically). The old
    # strings:SPLIT on " STEP " is gone. Only the attached form
    # "STEP2" (no gap at all) lexes as a single NAME token; it is
    # recovered here with a guarded prefix split of the collected
    # to-expression (word-boundary "STEP" followed by a digit).
    REAP cpair FROM collect_until_keyword, tokens, p3, plant_list_make(2, "STEP", ",").
    SET toExpr TO cpair[0].
    REAP p4 FROM _second, cpair.
    REAP stok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP slx FROM plant_iLexer_tok_lex, lexer, stok.
    IF slx IS "STEP",
      REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p4 FROM _second, cpair.
      REAP cpair FROM collect_until, tokens, p4, ",".
      SET stepExpr TO cpair[0].
      REAP p4 FROM _second, cpair.
    /IF.
    IF slx ISNT "STEP",
      # attached form "STEP2": the lexer glues "STEP" to the digits
      # into one NAME token, so it can only be recovered from the
      # collected text. Guarded: split on "STEP", then require the
      # remainder to start with a digit and the prefix to be empty or
      # space-terminated (a variable named e.g. MYSTEP2 or a bare
      # "STEP" suffix never matches).
      REAP sparts FROM strings:SPLIT, toExpr, "STEP".
      IF COUNT sparts IS 2,
        REAP sbefore FROM plant_list_get, sparts, 0.
        REAP safter FROM plant_list_get, sparts, 1.
        REAP after_c FROM substring, safter, 0, 1.
        CREATE before_ok(TX) TO "0".
        IF sbefore IS "", SET before_ok TO "1". /IF.
        IF sbefore ISNT "",
          REAP last_c FROM substring, sbefore, LEN(sbefore) - 1, LEN(sbefore).
          IF last_c IS " ", SET before_ok TO "1". /IF.
        /IF.
        IF before_ok IS "1" AND _is_digit(after_c) IS 1,
          SET toExpr TO sbefore.
          SET stepExpr TO safter.
        /IF.
      /IF.
    /IF.
    IF stepExpr > "",
      # v0.48.22-patch3: a statically-zero STEP (literal "0" or a
      # constant expression such as "2 - 2") is a compile-time error,
      # intercepted here prior to code emission so it can never
      # compile into a for loop that spins forever.
      REAP sgn FROM _step_sign, stepExpr.
      IF sgn IS "0",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "#error STEP cannot be 0"), p4).
      /IF.
    /IF.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP p4 FROM _second, cpair.
  /IF.
  IF lx IS "IN",
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP cpair FROM collect_until, tokens, p2, ",".
    SET listExpr TO cpair[0].
    REAP p3 FROM _second, cpair.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p4 FROM _second, cpair.
  /IF.
  IF lx IS ",",
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP indexVar FROM plant_iLexer_tok_lex, lexer, tok.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx2 ISNT "IN",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Expected IN in CYCLE header"), p2).
    /IF.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP cpair FROM collect_until, tokens, p2, ",".
    SET listExpr TO cpair[0].
    REAP p3 FROM _second, cpair.
    REAP cpair FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p4 FROM _second, cpair.
  /IF.
  IF lx ISNT "FROM" AND lx ISNT "IN" AND lx ISNT ",",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Expected FROM or IN in CYCLE header"), p2).
  /IF.
  # v0.48.35: the CYCLE body is its own C block → own CONST table
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p4.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(16, "type", "cycle_stmt", "iterVar", ivar, "fromExpr", fromExpr, "toExpr", toExpr, "stepExpr", stepExpr, "listExpr", listExpr, "indexVar", indexVar, "body", body), p4).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "/",
      REAP slash FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP cclose FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, cclose.
      REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p6.
      REAP p7 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(16, "type", "cycle_stmt", "iterVar", ivar, "fromExpr", fromExpr, "toExpr", toExpr, "stepExpr", stepExpr, "listExpr", listExpr, "indexVar", indexVar, "body", body), p7).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4, clv, ctab, rtab, bstart, emode.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

# ── THROW <stormtype> ["msg".] → throw_stmt AST node ────────
#    v0.48.23 — raises a storm through the innermost WEATHER
#    checkpoint; the message is an optional expression collected
#    until the terminating ".".
ACTION parse_throw_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP t_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP p3 FROM _second, t_pair.
  REAP stype FROM plant_iLexer_tok_lex, lexer, t_pair[0].
  CREATE msg(TX) TO "".
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "(",
    # v0.48.38a — THROW storm("TYPE", "msg"). factory form: the whole
    # call expression is collected as the payload and the classic
    # type token is emptied (codegen emits plant_throw_obj).
    REAP dot2 FROM collect_until, tokens, p2, ".".
    REAP msg FROM _first, dot2.
    REAP p3 FROM _second, dot2.
    SET stype TO "".
  /IF.
  IF lx ISNT "." AND lx ISNT "(",
    REAP dot2 FROM collect_until, tokens, p3, ".".
    REAP msg FROM _first, dot2.
    REAP p3 FROM _second, dot2.
  /IF.
  REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(6, "type", "throw_stmt", "storm", stype, "msg", msg), p4).
/ACTION.

# ── STOP IF <condition>. ────────────────────────────────────────
# v0.48.25 — conditional execution halting. The condition is the
# token list up to the terminating "."; a missing or empty condition
# is a syntax error. AST node: stop_if_stmt { cond }.
ACTION parse_stop_if_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP if_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP if_lx FROM plant_iLexer_tok_lex, lexer, if_pair[0].
  REAP p3 FROM _second, if_pair.
  IF if_lx ISNT "IF",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Expected IF after STOP"), p2).
  /IF.
  REAP cond_pair FROM collect_until, tokens, p3, ".".
  CREATE cond TO cond_pair[0].
  REAP p4 FROM _second, cond_pair.
  IF cond IS "" OR cond IS null,
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "STOP IF requires a condition expression"), p3).
  /IF.
  REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP p5 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(4, "type", "stop_if_stmt", "cond", cond), p5).
/ACTION.

# ── WEATHER … SHELTER [type [AS err]] … CALM … /WEATHER. ────
#    v0.48.23 — WEATHER opens a protected block; every SHELTER
#    clause (optionally typed by a storm identifier, optionally
#    binding the storm message to `AS err`) is a recovery handler;
#    the mandatory terminal CALM clause is the unconditional
#    finalization body. AST node:
#      weather_stmt { body, shelters, calm, exit_list }
#    shelters is a flat [type, bind, body, …] triple list; an
#    untyped SHELTER is stored as the ANY_STORM catch-all.
#    v0.48.37d — every WEATHER node provisions a dedicated local
#    exit-list (exit_list), binding the block to its resource-
#    reclamation structure so the runtime teardown (plant_weather_leave
#    walking the frame's exit-list) runs deterministically on normal
#    completion and exceptional propagation alike.
ACTION parse_weather_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  # v0.48.35: one CONST table + scan range for the whole protected
  # block (phases share a single lexical wrapper)
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p2.
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS ",",
    REAP c_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, c_pair.
  /IF.
  CREATE body(LIST) TO plant_list_make(0).
  CREATE shelters(LIST) TO plant_list_make(0).
  CREATE calm_body(LIST) TO plant_list_make(0).
  CREATE cur_type(TX) TO "ANY_STORM".
  CREATE cur_bind(TX) TO "".
  CREATE cur_body(LIST) TO plant_list_make(0).
  CREATE phase(TX) TO "body".
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Unterminated WEATHER block (missing /WEATHER.)"), p2).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "/",
      REAP slash FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p3 FROM _second, slash.
      REAP cclose FROM plant_iLexer_consume_at, lexer, tokens, p3.
      REAP p4 FROM _second, cclose.
      REAP clx FROM plant_iLexer_tok_lex, lexer, cclose[0].
      IF clx ISNT "WEATHER",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Expected /WEATHER. to close WEATHER block"), p2).
      /IF.
      REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, dot.
      IF phase IS "calm",
        GIVE plant_list_make(2, plant_list_make(10, "type", "weather_stmt", "body", body, "shelters", shelters, "calm", calm_body, "exit_list", plant_list_make(0)), p5).
      /IF.
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "WEATHER block missing CALM clause (mandatory finalization)"), p2).
    /IF.
    IF lx IS "SHELTER",
      IF phase IS "shelter",
        PUT cur_type INTO shelters.
        PUT cur_bind INTO shelters.
        PUT cur_body INTO shelters.
      /IF.
      IF phase IS "calm",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "SHELTER after CALM in WEATHER block"), p2).
      /IF.
      REAP s_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p3 FROM _second, s_pair.
      CREATE stype(TX) TO "ANY_STORM".
      CREATE sbind(TX) TO "".
      REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p3.
      REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
      IF lx2 ISNT ",",
        REAP t_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
        REAP p3 FROM _second, t_pair.
        REAP stype FROM plant_iLexer_tok_lex, lexer, t_pair[0].
        REAP tok3 FROM plant_iLexer_peek_at, lexer, tokens, p3.
        REAP lx3 FROM plant_iLexer_tok_lex, lexer, tok3.
        IF lx3 IS "AS",
          REAP a_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
          REAP p3 FROM _second, a_pair.
          REAP b_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
          REAP p3 FROM _second, b_pair.
          REAP sbind FROM plant_iLexer_tok_lex, lexer, b_pair[0].
        /IF.
      /IF.
      REAP tok4 FROM plant_iLexer_peek_at, lexer, tokens, p3.
      REAP lx4 FROM plant_iLexer_tok_lex, lexer, tok4.
      IF lx4 IS ",",
        REAP cm_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
        REAP p3 FROM _second, cm_pair.
      /IF.
      SET cur_type TO stype.
      SET cur_bind TO sbind.
      SET cur_body TO plant_list_make(0).
      SET phase TO "shelter".
      SET p2 TO p3.
      CONTINUE 0.
    /IF.
    IF lx IS "CALM",
      IF phase IS "shelter",
        PUT cur_type INTO shelters.
        PUT cur_bind INTO shelters.
        PUT cur_body INTO shelters.
      /IF.
      IF phase IS "calm",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Multiple CALM clauses in WEATHER block"), p2).
      /IF.
      REAP c_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p3 FROM _second, c_pair.
      REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p3.
      REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
      IF lx2 IS ",",
        REAP cm_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
        REAP p3 FROM _second, cm_pair.
      /IF.
      SET calm_body TO plant_list_make(0).
      SET phase TO "calm".
      SET p2 TO p3.
      CONTINUE 0.
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p2, clv, ctab, rtab, bstart, emode.
    CREATE stmt TO stmt_pair[0].
    REAP p2 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      IF phase IS "shelter",
        PUT stmt INTO cur_body.
      /IF.
      IF phase IS "body",
        PUT stmt INTO body.
      /IF.
      IF phase IS "calm",
        PUT stmt INTO calm_body.
      /IF.
    /IF.
  /SEASON.
/ACTION.

# v0.48.33 — clv threads the active LISTEN request variable through
#   the statement loops so GIVE ... AS RESPONSE. can bind to it.
# v0.48.35 — ctab (current block's CONST table), rtab (module ROOT
#   table), bstart (token position where the current block's body
#   begins — the use-before-definition scan range) and emode
#   ("1" inside ROOT_SCOPE: CONST is elevated to ROOT) join the
#   threading.
ACTION parse_statement(tokens(LIST), pos(NUM), clv(TX), ctab(LIST), rtab(LIST), bstart(NUM), emode(TX)),
  REAP lexer FROM get_lexer.
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, pos.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  # v0.49.27 - TYPE aliases inside action bodies
  IF lx IS "TYPE",
    REAP r FROM parse_type_decl, tokens, pos.
    GIVE r.
  /IF.
  # v0.49.28 - BLOOM Species AS var.
  IF lx IS "BLOOM",
    REAP r FROM parse_bloom_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "CONST",
    REAP r FROM parse_const_like, tokens, pos, ctab, rtab, bstart, emode, "const_stmt".
    GIVE r.
  /IF.
  IF lx IS "ROOT",
    REAP r FROM parse_const_like, tokens, pos, ctab, rtab, bstart, "1", "root_stmt".
    GIVE r.
  /IF.
  IF lx IS "ROOT_SCOPE",
    REAP r FROM parse_root_scope_stmt, tokens, pos, clv, rtab.
    GIVE r.
  /IF.
  IF lx IS "CREATE",
    REAP r FROM parse_create_stmt, tokens, pos, rtab, emode.
    GIVE r.
  /IF.
  # v0.50.0e — native fixed-size arrays (inside action bodies).
  IF lx IS "ARRAY" OR lx IS "array",
    REAP r FROM parse_array_decl, tokens, pos, rtab.
    GIVE r.
  /IF.
  IF lx IS "SHOW",
    REAP r FROM parse_show_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "NOW",
    REAP r FROM parse_now_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ANALYZE",
    REAP r FROM parse_analyze_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "TYPEOF",
    REAP r FROM parse_typeof_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "FREE",
    REAP r FROM parse_free_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "WAIT",
    REAP r FROM parse_wait_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "LOCK",
    REAP r FROM parse_lock_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ARC",
    REAP r FROM parse_arc_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "FAST",
    REAP r FROM parse_fast_reset_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "GIVE",
    REAP r FROM parse_give_stmt, tokens, pos, clv.
    GIVE r.
  /IF.
  IF lx IS "SET",
    REAP r FROM parse_set_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "INCREASE",
    REAP r FROM parse_incdec_stmt, tokens, pos, "increase".
    GIVE r.
  /IF.
  IF lx IS "DECREASE",
    REAP r FROM parse_incdec_stmt, tokens, pos, "decrease".
    GIVE r.
  /IF.
  IF lx IS "LET",
    REAP r FROM parse_let_stmt, tokens, pos, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "IF",
    REAP r FROM parse_if_stmt, tokens, pos, clv, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "SEASON",
    REAP r FROM parse_season_stmt, tokens, pos, clv, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "MATCH",
    REAP r FROM parse_match_stmt, tokens, pos, clv, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "CYCLE",
    REAP r FROM parse_cycle_stmt, tokens, pos, clv, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "WEATHER",
    REAP r FROM parse_weather_stmt, tokens, pos, clv, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "THROW",
    REAP r FROM parse_throw_stmt, tokens, pos.
    GIVE r.
  /IF.

  IF lx IS "STOP",
    REAP r FROM parse_stop_if_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "REAP",
    REAP r FROM parse_reap_stmt, tokens, pos, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "PUT",
    REAP r FROM parse_put_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "TAKE",
    REAP r FROM parse_take_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "BRAID",
    REAP r FROM parse_braid_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "LINK",
    REAP r FROM parse_link_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "BREAK",
    REAP r FROM parse_break_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "CONTINUE",
    REAP r FROM parse_continue_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "AWAIT",
    REAP r FROM parse_await_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "START",
    REAP r FROM parse_start_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ASYNC",
    REAP r FROM parse_async_in_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "CANCEL",
    REAP r FROM parse_cancel_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "TRACE",
    REAP r FROM parse_trace_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SORT",
    REAP r FROM parse_sort_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SHAKE",
    REAP r FROM parse_shake_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "HARVEST",
    REAP r FROM parse_harvest_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "VERIFY",
    REAP r FROM parse_verify_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "LISTEN",
    REAP r FROM parse_listen_stmt, tokens, pos.
    GIVE r.
  /IF.
  # v0.49.54 — SUITE ... SETUP/TEARDOWN ... /SUITE
  IF lx IS "SUITE",
    REAP r FROM parse_suite_stmt, tokens, pos, clv, ctab, rtab, bstart, emode.
    GIVE r.
  /IF.
  IF lx IS "SETUP",
    REAP r FROM parse_setup_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "TEARDOWN",
    REAP r FROM parse_teardown_stmt, tokens, pos.
    GIVE r.
  /IF.
  # bare call: IDENT( or module:IDENT( → call_stmt (void FFI calls)
  REAP nx FROM plant_iLexer_peek_at, lexer, tokens, pos + 1.
  REAP nx_ty FROM plant_iLexer_tok_type, lexer, nx.
  IF nx_ty IS "LPAREN",
    REAP r FROM parse_call_stmt, tokens, pos, rtab, emode.
    GIVE r.
  /IF.
  # v0.49.11 — method-call statement: IDENT . IDENT ( → collect the
  # whole expression (chained calls included) and emit it raw
  # (l.push("d"). → plant_list_push(l, "d");)
  IF nx_ty IS "DOT",
    REAP mm1 FROM plant_iLexer_peek_at, lexer, tokens, pos + 2.
    REAP mm1_ty FROM plant_iLexer_tok_type, lexer, mm1.
    IF mm1_ty IS "IDENT",
      REAP mm2 FROM plant_iLexer_peek_at, lexer, tokens, pos + 3.
      REAP mm2_ty FROM plant_iLexer_tok_type, lexer, mm2.
      IF mm2_ty IS "LPAREN",
        REAP mv1 FROM collect_value, tokens, pos.
        REAP mvt FROM _first, mv1.
        REAP mvp FROM _second, mv1.
        GIVE plant_list_make(2, plant_list_make(4, "type", "emit_stmt", "code", mvt), mvp).
      /IF.
    /IF.
  /IF.
  REAP nx2 FROM plant_iLexer_peek_at, lexer, tokens, pos + 1.
  REAP nx2_ty FROM plant_iLexer_tok_type, lexer, nx2.
  IF nx2_ty IS "COLON",
    REAP nx3 FROM plant_iLexer_peek_at, lexer, tokens, pos + 2.
    REAP nx3_ty FROM plant_iLexer_tok_type, lexer, nx3.
    IF nx3_ty IS "LPAREN",
      REAP r FROM parse_call_stmt, tokens, pos, rtab, emode.
      GIVE r.
    /IF.
  /IF.
  GIVE plant_list_make(2, null, pos + 1).
/ACTION.

# collect_until_keyword: collects text until ANY token in kws at
# depth=0 (does NOT consume it); identical to collect_until but the
# terminator is a list of keywords instead of a single delimiter
# (v0.48.32, for HARVEST options).
ACTION collect_until_keyword(tokens(LIST), start(NUM), kws(LIST)),
  REAP lexer FROM get_lexer.

  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    REAP tt FROM plant_iLexer_tok_type, lexer, tok.
    IF tt IS "STRING" OR tt IS "INTERP",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    CREATE kw_hit(TX) TO "0".
    CREATE ki(NUM) TO 0.
    SEASON ki < COUNT kws,
      REAP kw FROM plant_list_get, kws, ki.
      IF _cat("", lx) IS _cat("", kw) AND depth IS 0,
        SET kw_hit TO "1".
      /IF.
      SET ki TO ki + 1.
    /SEASON.
    # v0.49.10 — field access before a keyword terminator
    IF lx IS "." AND text > "",
      REAP fpp FROM parse_field_access, tokens, p2, text, _from_long(depth).
      REAP fpf FROM _first, fpp.
      IF fpf IS "1",
        REAP fpt FROM _second, fpp.
        REAP fpp2 FROM _third, fpp.
        SET text TO fpt.
        SET p2 TO fpp2.
        CONTINUE 0.
      /IF.
    /IF.
    IF kw_hit IS "1",
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(", SET depth TO depth + 1. /IF.
    IF lx IS ")", SET depth TO depth - 1. /IF.
    IF text > "", SET text TO text + " ". /IF.
    SET text TO text + lx.
    REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP p2 FROM _second, drop.
  /SEASON.
/ACTION.

# v0.48.32 — HARVEST url AS resp [METHOD m] [BODY b] [HEADERS h]
#   [TIMEOUT t]. Options may appear in any order after the result
#   name; METHOD defaults to GET. AST: harvest_stmt with url, resp,
#   and the option strings.
ACTION parse_harvest_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP upair FROM collect_until, tokens, p2, "AS".
  CREATE url TO upair[0].
  REAP p3 FROM _second, upair.
  REAP as_pair FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, as_pair.
  CREATE resp(TX) TO "".
  CREATE method(TX) TO "".
  CREATE body(TX) TO "".
  CREATE headers(TX) TO "".
  CREATE timeout(TX) TO "".
  CREATE map(TX) TO "".
  CREATE json(TX) TO "".
  CREATE okws(LIST) TO plant_list_make(7, "METHOD", "BODY", "HEADERS", "TIMEOUT", "MAP", "JSON", ".").
  REAP rpair FROM collect_until_keyword, tokens, p4, okws.
  SET resp TO rpair[0].
  REAP p4 FROM _second, rpair.
  SEASON TRUE,
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "." OR lx IS "",
      BREAK 0.
    /IF.
    IF lx IS "MAP",
      REAP dropm FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p4 FROM _second, dropm.
      SET map TO "1".
      CONTINUE 0.
    /IF.
    IF lx IS "JSON",
      REAP dropj FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p4 FROM _second, dropj.
      SET json TO "1".
      CONTINUE 0.
    /IF.
    IF lx IS "METHOD" OR lx IS "BODY" OR lx IS "HEADERS" OR lx IS "TIMEOUT",
      REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p4 FROM _second, drop.
      REAP opair FROM collect_until_keyword, tokens, p4, okws.
      CREATE oval TO opair[0].
      REAP p4 FROM _second, opair.
      IF lx IS "METHOD", SET method TO oval. /IF.
      IF lx IS "BODY", SET body TO oval. /IF.
      IF lx IS "HEADERS", SET headers TO oval. /IF.
      IF lx IS "TIMEOUT", SET timeout TO oval. /IF.
      REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p4.
      REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
      IF lx2 IS ",",
        REAP drop2 FROM plant_iLexer_consume_at, lexer, tokens, p4.
        REAP p4 FROM _second, drop2.
      /IF.
      CONTINUE 0.
    /IF.
    REAP drop FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP p4 FROM _second, drop.
  /SEASON.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP p5 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(20, "type", "harvest_stmt", "url", url, "resp", resp, "method", method, "payload", body, "headers", headers, "timeout", timeout, "map", map, "json", json), p5).
/ACTION.

# v0.48.33 — LISTEN ON port AS req. opens an HTTP server socket on
#   the given port, waits for ONE client connection, reads and parses
#   the HTTP request into a request MAP stored in req (keys:
#   ok/method/path/headers/body plus an internal sock used by
#   GIVE ... AS RESPONSE.). Binding: the GIVE ... AS RESPONSE.
#   statement replies on the most recent LISTEN in the same block.
#   AST: listen_stmt with port and resp.
ACTION parse_listen_stmt(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP on_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP p3 FROM _second, on_pair.
  CREATE okws2(LIST) TO plant_list_make(3, "AS", ")", ".").
  REAP opair FROM collect_until_keyword, tokens, p3, okws2.
  CREATE port TO opair[0].
  REAP p4 FROM _second, opair.
  REAP as_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP p5 FROM _second, as_pair.
  REAP id_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP reqname FROM plant_iLexer_tok_lex, lexer, id_pair[0].
  REAP p6 FROM _second, id_pair.
  CREATE tmo(TX) TO "".
  REAP tok_t FROM plant_iLexer_peek_at, lexer, tokens, p6.
  REAP lx_t FROM plant_iLexer_tok_lex, lexer, tok_t.
  IF lx_t IS "TIMEOUT",
    REAP drop_t FROM plant_iLexer_consume_at, lexer, tokens, p6.
    REAP p6 FROM _second, drop_t.
    REAP tpair FROM collect_until_keyword, tokens, p6, okws2.
    SET tmo TO tpair[0].
    REAP p6 FROM _second, tpair.
  /IF.
  REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p6.
  REAP p7 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "listen_stmt", "port", port, "resp", reqname, "timeout", tmo), p7).
/ACTION.

#── Declaration parsing ────────────────────────────────────────

ACTION parse_enum_decl(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP name FROM plant_iLexer_tok_lex, lexer, name_pair[0].
  REAP p3 FROM _second, name_pair.
  REAP lbr FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, lbr.
  CREATE members(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p4).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "}",
      REAP rbr FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, rbr.
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p5).
    /IF.
    REAP m_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP mname FROM plant_iLexer_tok_lex, lexer, m_pair[0].
    REAP p5 FROM _second, m_pair.
    PUT mname INTO members.
    REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
    IF lx2 IS ",",
      REAP com FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
/ACTION.

ACTION parse_struct_decl(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  # v0.50.0a: anonymous struct — STRUCT { ... } without a name.
  REAP sg_tok0 FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP sg_lx0 FROM plant_iLexer_tok_lex, lexer, sg_tok0.
  CREATE sname(TX) TO "".
  CREATE p3(NUM) TO p2.
  IF sg_lx0 ISNT "{",
    REAP name_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
    REAP sname FROM plant_iLexer_tok_lex, lexer, name_pair[0].
    REAP p3 FROM _second, name_pair.
  /IF.
  # generic type parameter list: [T, U] right after the struct name
  CREATE generics(LIST) TO plant_list_make(0).
  REAP sg_tok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP sg_lx FROM plant_iLexer_tok_lex, lexer, sg_tok.
  IF sg_lx IS "[",
    REAP sg_lb FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p3 FROM _second, sg_lb.
    REAP sgv FROM collect_type_text, tokens, p3, "]", 0.
    REAP sgtext FROM _first, sgv.
    REAP p3 FROM _second, sgv.
    REAP sg_rb FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p3 FROM _second, sg_rb.
    REAP sgparts FROM strings:SPLIT, sgtext, ",".
    CREATE sgi(NUM) TO 0.
    CREATE sge(TX) TO "".
    SEASON sgi < COUNT sgparts,
      REAP sge FROM plant_list_get, sgparts, sgi.
      REAP sget FROM trim, sge.
      IF sget > "",
        PUT sget INTO generics.
      /IF.
      SET sgi TO sgi + 1.
    /SEASON.
  /IF.
  REAP lb FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, lb.
  CREATE fields(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(8, "type", "struct_decl", "name", sname, "generics", generics, "fields", fields), p4).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "}",
      REAP rb FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, rb.
      GIVE plant_list_make(2, plant_list_make(8, "type", "struct_decl", "name", sname, "generics", generics, "fields", fields), p5).
    /IF.
    REAP fn_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP fname FROM plant_iLexer_tok_lex, lexer, fn_pair[0].
    REAP p5 FROM _second, fn_pair.
    REAP col_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p6 FROM _second, col_pair.
    REAP ftv FROM collect_type_text, tokens, p6, "}", 1.
    REAP ftype FROM _first, ftv.
    REAP p7 FROM _second, ftv.
    REAP ftypet FROM trim, ftype.
    PUT plant_list_make(4, "name", fname, "type", ftypet) INTO fields.
    REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p7.
    REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
    IF lx2 IS ",",
      REAP com FROM plant_iLexer_consume_at, lexer, tokens, p7.
      REAP p7 FROM _second, com.
    /IF.
    SET p4 TO p7.
  /SEASON.
/ACTION.

# v0.50.0d — UNION declaration parsing.
ACTION parse_union_decl(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  # UNION Name { fields } — fields comma-separated like STRUCT
  REAP name_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP uname FROM plant_iLexer_tok_lex, lexer, name_pair[0].
  REAP p3 FROM _second, name_pair.
  REAP lb FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, lb.
  CREATE fields(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "union_decl", "name", uname, "fields", fields), p4).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "}",
      REAP rb FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, rb.
      GIVE plant_list_make(2, plant_list_make(6, "type", "union_decl", "name", uname, "fields", fields), p5).
    /IF.
    REAP fn_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP fname FROM plant_iLexer_tok_lex, lexer, fn_pair[0].
    REAP p5 FROM _second, fn_pair.
    REAP col_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p6 FROM _second, col_pair.
    REAP ftv FROM collect_type_text, tokens, p6, "}", 1.
    REAP ftype FROM _first, ftv.
    REAP p7 FROM _second, ftv.
    REAP ftypet FROM trim, ftype.
    PUT plant_list_make(4, "name", fname, "type", ftypet) INTO fields.
    REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p7.
    REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
    IF lx2 IS ",",
      REAP com FROM plant_iLexer_consume_at, lexer, tokens, p7.
      REAP p7 FROM _second, com.
    /IF.
    SET p4 TO p7.
  /SEASON.
/ACTION.

ACTION parse_action_decl(tokens(LIST), pos(NUM), rtab(LIST)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP aname FROM plant_iLexer_tok_lex, lexer, name_pair[0].
  REAP p3 FROM _second, name_pair.
  # v0.48.33: active LISTEN request variable for GIVE ... AS RESPONSE.
  CREATE clv(TX) TO "".
  # async priority modifier (default NORMAL=1)
  CREATE prio(TX) TO "1".
  # v0.48.15: mission mode (default BALANCED; WITH MISSION FAST/SAFE)
  CREATE mission_mode(TX) TO "BALANCED".
  # v0.49.24: curly-brace body mode (ACTION name(args) { ... })
  CREATE bracemode(TX) TO "0".
  CREATE closep(NUM) TO -1.
  # generic type parameter list: [T, U] right after the action name
  CREATE generics(LIST) TO plant_list_make(0).
  REAP ga_tok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP ga_lx FROM plant_iLexer_tok_lex, lexer, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p3 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p3, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p3 FROM _second, gv.
    REAP ga_rb FROM plant_iLexer_consume_at, lexer, tokens, p3.
    REAP p3 FROM _second, ga_rb.
    REAP gparts FROM strings:SPLIT, gtext, ",".
    CREATE gi2(NUM) TO 0.
    CREATE ge2(TX) TO "".
    SEASON gi2 < COUNT gparts,
      REAP ge2 FROM plant_list_get, gparts, gi2.
      REAP ge2t FROM trim, ge2.
      IF ge2t > "",
        PUT ge2t INTO generics.
      /IF.
      SET gi2 TO gi2 + 1.
    /SEASON.
  /IF.
  REAP lp FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, lp.
  CREATE params(LIST) TO plant_list_make(0).
  CREATE vararg(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", plant_list_make(0), "prio", prio, "ret", "", "mission_mode", mission_mode), p4).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p4.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    # v0.48.4: variadic marker "..." — lexer yields DOT_DOT+DOT or
    # DOT DOT DOT
    IF lx IS "..",
      REAP tokv2 FROM plant_iLexer_peek_at, lexer, tokens, p4 + 1.
      REAP lxv2 FROM plant_iLexer_tok_lex, lexer, tokv2.
      IF lxv2 IS ".",
        SET vararg TO "1".
        SET p4 TO p4 + 2.
        REAP ctok2 FROM plant_iLexer_peek_at, lexer, tokens, p4.
        REAP clx2 FROM plant_iLexer_tok_lex, lexer, ctok2.
        IF clx2 IS ")", SET p4 TO p4 + 1. /IF.
        IF clx2 IS ",", SET p4 TO p4 + 2. /IF.
        SET p5 TO p4.
        BREAK 0.
      /IF.
    /IF.
    IF lx IS ".",
      REAP tokv2 FROM plant_iLexer_peek_at, lexer, tokens, p4 + 1.
      REAP lxv2 FROM plant_iLexer_tok_lex, lexer, tokv2.
      IF lxv2 IS "..",
        SET vararg TO "1".
        SET p4 TO p4 + 2.
        REAP ctok2 FROM plant_iLexer_peek_at, lexer, tokens, p4.
        REAP clx2 FROM plant_iLexer_tok_lex, lexer, ctok2.
        IF clx2 IS ")", SET p4 TO p4 + 1. /IF.
        IF clx2 IS ",", SET p4 TO p4 + 2. /IF.
        SET p5 TO p4.
        BREAK 0.
      /IF.
      IF lxv2 IS ".",
        REAP tokv3 FROM plant_iLexer_peek_at, lexer, tokens, p4 + 2.
        REAP lxv3 FROM plant_iLexer_tok_lex, lexer, tokv3.
        IF lxv3 IS ".",
          SET vararg TO "1".
          SET p4 TO p4 + 3.
          REAP ctok2 FROM plant_iLexer_peek_at, lexer, tokens, p4.
          REAP clx2 FROM plant_iLexer_tok_lex, lexer, ctok2.
          IF clx2 IS ")", SET p4 TO p4 + 1. /IF.
          IF clx2 IS ",", SET p4 TO p4 + 2. /IF.
          SET p5 TO p4.
          BREAK 0.
        /IF.
      /IF.
    /IF.
    IF lx IS ")",
      REAP rp FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, rp.
      CREATE brk(NUM) TO 0.
      BREAK 0.
    /IF.
    REAP pn_pair FROM plant_iLexer_consume_at, lexer, tokens, p4.
    REAP pn FROM plant_iLexer_tok_lex, lexer, pn_pair[0].
    REAP p5 FROM _second, pn_pair.
    REAP tok2 FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx2 FROM plant_iLexer_tok_lex, lexer, tok2.
    IF lx2 IS "(",
      REAP lp2 FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, lp2.
      # collect the full type text: T, LIST[T], REF NUM, REF LIST[T] …
      REAP ptv FROM collect_type_text, tokens, p6, ")", 1.
      REAP pt FROM _first, ptv.
      REAP p7 FROM _second, ptv.
      # normalize pointer markers: "void *" → "void*" (lexer splits *)
      REAP pt FROM strings:REPLACE, pt, " *", "*".
      REAP pt FROM strings:REPLACE, pt, "* ", "*".
      # consume the closing ")" of the type group
      REAP rp2 FROM plant_iLexer_consume_at, lexer, tokens, p7.
      REAP p7 FROM _second, rp2.
      PUT plant_list_make(4, "name", pn, "type", pt) INTO params.
      SET p5 TO p7.
    /IF.
    IF lx2 ISNT "(",
      PUT plant_list_make(4, "name", pn, "type", "") INTO params.
    /IF.
    REAP tok3 FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx3 FROM plant_iLexer_tok_lex, lexer, tok3.
    IF lx3 IS ",",
      REAP com FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
  # skip optional -> Type (then check if , or .)
  CREATE ret(TX) TO "".
  REAP arrow_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
  REAP arrow_lx FROM plant_iLexer_tok_lex, lexer, arrow_tok.
  IF arrow_lx IS "->",
    REAP arrow_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP p5 FROM _second, arrow_pair.
    # skip bogus MINUS=- token (lexer bug: -> produces extra MINUS)
    REAP skip_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP skip_ty FROM plant_iLexer_tok_type, lexer, skip_tok.
    IF skip_ty IS "MINUS",
      REAP skip_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, skip_pair.
    /IF.
    REAP ret_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
    REAP ret_lx FROM plant_iLexer_tok_lex, lexer, ret_pair[0].
    REAP p5 FROM _second, ret_pair.
    # v0.48.4: FFI return types — external (default), Result<T,E>,
    # STRUCT X (by-value struct), void*
    IF ret_lx IS "Result", SET ret TO "Result". /IF.
    IF ret_lx IS "STRUCT",
      REAP rtv FROM collect_type_text, tokens, p5, ".", 0.
      REAP rtt FROM _first, rtv.
      REAP p5 FROM _second, rtv.
      SET ret TO "STRUCT " + rtt.
    /IF.
    # v0.48.12: ENUM X — FFI boundary enums (raw member ints in C,
    # wrapped with _from_enum on the PlantLang side)
    IF ret_lx IS "ENUM",
      REAP rtv FROM collect_type_text, tokens, p5, ".", 0.
      REAP rtt FROM _first, rtv.
      REAP p5 FROM _second, rtv.
      SET ret TO "ENUM " + rtt.
    /IF.
    IF ret_lx IS "void",
      REAP vst FROM plant_iLexer_peek_at, lexer, tokens, p5.
      REAP vsl FROM plant_iLexer_tok_lex, lexer, vst.
      IF vsl IS "*",
        REAP vsp FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p5 FROM _second, vsp.
        SET ret TO "void*".
      /IF.
    /IF.
    # Result<T, E> generics: -> Result<NUM, TX>. (E = TX error string)
    IF ret_lx IS "Result",
      REAP lt_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
      REAP lt_lx FROM plant_iLexer_tok_lex, lexer, lt_tok.
      IF lt_lx IS "<",
        REAP lt_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p5 FROM _second, lt_pair.
        REAP rt_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p5 FROM _second, rt_pair.
        REAP rc_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p5 FROM _second, rc_pair.
        REAP re_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p5 FROM _second, re_pair.
        REAP gt_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p5 FROM _second, gt_pair.
      /IF.
    /IF.
    # v0.48.13: plain return types (T, NUM, TX, enum names…) are
    # stored on the action_decl node so generic instantiations know
    # their substituted return type (drives _from_long wrapping of
    # numeric GIVEs). FFI marker keywords are never stored here.
    IF ret IS "" AND ret_lx ISNT "external" AND ret_lx ISNT "Result" AND ret_lx ISNT "STRUCT" AND ret_lx ISNT "ENUM" AND ret_lx ISNT "void",
      SET ret TO ret_lx.
    /IF.
  /IF.
  # optional PRIORITY HIGH|NORMAL|LOW modifier (async actions)
  REAP pr_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP pr_lx FROM plant_iLexer_tok_lex, lexer, pr_tok.
    IF pr_lx IS "PRIORITY",
      REAP pr_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, pr_pair.
      REAP lv_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP lv_lx FROM plant_iLexer_tok_lex, lexer, lv_pair[0].
      REAP p5 FROM _second, lv_pair.
      IF lv_lx IS "HIGH", SET prio TO "0". /IF.
      IF lv_lx IS "NORMAL", SET prio TO "1". /IF.
      IF lv_lx IS "LOW", SET prio TO "2". /IF.
    /IF.
    # v0.48.15: WITH MISSION <MODE> — FAST (bump heap) / SAFE (boundary
    # guarded) / BALANCED (default). Optional; comes after PRIORITY.
    REAP wm_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP wm_lx FROM plant_iLexer_tok_lex, lexer, wm_tok.
    IF wm_lx IS "WITH",
      REAP wm_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, wm_pair.
      REAP ms_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP ms_lx FROM plant_iLexer_tok_lex, lexer, ms_pair[0].
      REAP p5 FROM _second, ms_pair.
      IF ms_lx IS "MISSION",
        REAP md_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP md_lx FROM plant_iLexer_tok_lex, lexer, md_pair[0].
        REAP p5 FROM _second, md_pair.
        SET mission_mode TO md_lx.
      /IF.
    /IF.
    REAP after_tok FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP after_lx FROM plant_iLexer_tok_lex, lexer, after_tok.
    IF after_lx IS ",",
      REAP com_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, com_pair.
    /IF.
    IF after_lx IS ".",
      REAP dot_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, dot_pair.
      IF ret_lx IS "external" OR ret_lx IS "Result" OR ret_lx IS "STRUCT" OR ret_lx IS "ENUM" OR ret IS "void*",
        GIVE plant_list_make(2, plant_list_make(10, "type", "external_decl", "name", aname, "params", params, "ret", ret, "varargs", vararg), p5).
      /IF.
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", plant_list_make(0), "prio", prio, "ret", ret, "mission_mode", mission_mode), p5).
    /IF.
    IF after_lx IS "{",
      REAP lb2_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p5 FROM _second, lb2_pair.
      SET bracemode TO "1".
      CREATE bd2(NUM) TO 1.
      CREATE sp2(NUM) TO p5.
      SEASON sp2 < COUNT tokens,
        REAP tk2 FROM plant_iLexer_peek_at, lexer, tokens, sp2.
        REAP ty2 FROM plant_iLexer_tok_type, lexer, tk2.
        IF ty2 IS "LBRACE", SET bd2 TO bd2 + 1. /IF.
        IF ty2 IS "RBRACE",
          SET bd2 TO bd2 - 1.
          IF bd2 IS 0, SET closep TO sp2. /IF.
          IF bd2 IS 0, BREAK 0. /IF.
        /IF.
        SET sp2 TO sp2 + 1.
      /SEASON.
    /IF.
  # v0.48.35: each action body has its own CONST table
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p5.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    # v0.49.24: brace bodies terminate at the matching RBRACE token
    IF bracemode IS "1",
      REAP tk9 FROM plant_iLexer_peek_at, lexer, tokens, p5.
      REAP ty9 FROM plant_iLexer_tok_type, lexer, tk9.
      IF ty9 IS "RBRACE",
        REAP rb9_pair FROM plant_iLexer_consume_at, lexer, tokens, p5.
        REAP p5 FROM _second, rb9_pair.
        GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", body, "prio", prio, "ret", ret, "mission_mode", mission_mode), p5).
      /IF.
    /IF.
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", body, "prio", prio, "ret", ret, "mission_mode", mission_mode), p5).
    /IF.
    REAP tok4 FROM plant_iLexer_peek_at, lexer, tokens, p5.
    REAP lx4 FROM plant_iLexer_tok_lex, lexer, tok4.
    IF lx4 IS "/",
      REAP slash FROM plant_iLexer_consume_at, lexer, tokens, p5.
      REAP p6 FROM _second, slash.
      REAP end FROM plant_iLexer_consume_at, lexer, tokens, p6.
      REAP p7 FROM _second, end.
      REAP dot FROM plant_iLexer_consume_at, lexer, tokens, p7.
      REAP p8 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", body, "prio", prio, "ret", ret, "mission_mode", mission_mode), p8).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p5, clv, ctab, rtab, bstart, "0".
    CREATE stmt TO stmt_pair[0].
    REAP p5 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      IF sty IS "listen_stmt",
        REAP slv FROM _map_get, stmt, "resp".
        SET clv TO slv.
      /IF.
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

# parse_species_decl - SPECIES name { field: TYPE, ... } (v0.49.28)
ACTION parse_species_decl(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  CREATE srtab(LIST) TO plant_list_make(0).

  REAP kw_pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p FROM _second, kw_pair.
  REAP npair FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP nty FROM plant_iLexer_tok_type, lexer, npair[0].
  IF nty ISNT "IDENT",
    CREATE serr(TX) TO "SPECIES requires a name".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", serr), p).
  /IF.
  REAP sname FROM plant_iLexer_tok_lex, lexer, npair[0].
  REAP p FROM _second, npair.
  CREATE stparams(LIST) TO plant_list_make(0).
  REAP sgtk FROM plant_iLexer_peek_at, lexer, tokens, p.
  REAP sglx FROM plant_iLexer_tok_lex, lexer, sgtk.
  IF sglx IS "[",
    REAP sglb FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP p FROM _second, sglb.
    REAP sgv FROM collect_type_text, tokens, p, "]", 0.
    REAP p FROM _second, sgv.
    REAP sgt FROM _first, sgv.
    REAP sgrb FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP p FROM _second, sgrb.
    REAP sgparts FROM strings:SPLIT, sgt, ",".
    CREATE sgi(NUM) TO 0.
    SEASON sgi < COUNT sgparts,
      REAP sge FROM plant_list_get, sgparts, sgi.
      REAP sget FROM trim, sge.
      IF sget > "", PUT sget INTO stparams. /IF.
      SET sgi TO sgi + 1.
    /SEASON.
  /IF.
  CREATE implifs(LIST) TO plant_list_make(0).
  REAP impl_tk FROM plant_iLexer_peek_at, lexer, tokens, p.
  REAP impl_lx FROM plant_iLexer_tok_lex, lexer, impl_tk.
  IF impl_lx IS "IMPLEMENTS",
    REAP impl_c1 FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP p FROM _second, impl_c1.
    REAP impl_n1 FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP p FROM _second, impl_n1.
    REAP cm1t FROM plant_iLexer_peek_at, lexer, tokens, p.
    REAP cm1l FROM plant_iLexer_tok_lex, lexer, cm1t.
    IF cm1l IS ",",
      REAP cc9a FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP p FROM _second, cc9a.
      REAP in9a FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP p FROM _second, in9a.
      PUT in9a INTO implifs.
      REAP cm2t FROM plant_iLexer_peek_at, lexer, tokens, p.
      REAP cm2l FROM plant_iLexer_tok_lex, lexer, cm2t.
      IF cm2l IS ",",
        REAP cc9b FROM plant_iLexer_consume_at, lexer, tokens, p.
        REAP p FROM _second, cc9b.
        REAP in9b FROM plant_iLexer_consume_at, lexer, tokens, p.
        REAP p FROM _second, in9b.
        PUT in9b INTO implifs.
      /IF.
    /IF.
  /IF.
  # v0.49.30 - optional FROM Parent clause
  CREATE parent(TX) TO "".
  REAP ftk FROM plant_iLexer_peek_at, lexer, tokens, p.
  REAP flx9 FROM plant_iLexer_tok_lex, lexer, ftk.
  IF flx9 IS "FROM",
    REAP fpair FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP p FROM _second, fpair.
    REAP ppair FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP pnm FROM plant_iLexer_tok_lex, lexer, ppair[0].
    SET parent TO pnm.
    REAP p FROM _second, ppair.
  /IF.
  REAP lb FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP p FROM _second, lb.
  CREATE fields(LIST) TO plant_list_make(0).
  CREATE methods(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tk FROM plant_iLexer_peek_at, lexer, tokens, p.
    REAP ty FROM plant_iLexer_tok_type, lexer, tk.
    REAP slx FROM plant_iLexer_tok_lex, lexer, tk.
    IF ty IS "RBRACE",
      REAP rb FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP p FROM _second, rb.
      BREAK 0.
    /IF.
    # v0.49.29 - embedded ACTION members (brace-form bodies)
    IF slx IS "ACTION",
          REAP mpair FROM parse_action_decl, tokens, p, srtab.

      REAP mnode FROM _first, mpair.
      REAP p FROM _second, mpair.
      REAP mnty FROM _map_get, mnode, "type".
      IF mnty IS "action_decl",
        REAP mn FROM _map_get, mnode, "name".
        # v0.49.29: lift under the BARE method name (must be unique
        # across species) so receiver.method() dispatch resolves.
        REAP onm FROM _map_replace, mnode, "name", mn.
        REAP oldp FROM _map_get, onm, "params".
        CREATE np2(LIST) TO plant_list_make(0).
        PUT plant_list_make(4, "name", "self", "type", "TX") INTO np2.
        CREATE ci2(NUM) TO 0.
        SEASON ci2 < COUNT oldp,
          REAP pel FROM plant_list_get, oldp, ci2.
          PUT pel INTO np2.
          SET ci2 TO ci2 + 1.
        /SEASON.
        REAP nn2 FROM _map_replace, onm, "params", np2.
        PUT nn2 INTO methods.
      /IF.
      REAP stk9 FROM plant_iLexer_peek_at, lexer, tokens, p.
      REAP sty9 FROM plant_iLexer_tok_type, lexer, stk9.
      IF sty9 IS "RBRACE",
        REAP rb9 FROM plant_iLexer_consume_at, lexer, tokens, p.
        REAP p FROM _second, rb9.
        BREAK 0.
      /IF.
      CONTINUE.
    /IF.
    REAP fpair FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP fname FROM plant_iLexer_tok_lex, lexer, fpair[0].
    REAP p FROM _second, fpair.
    REAP cpa9 FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP p FROM _second, cpa9.
    # v0.49.29: type = single IDENT with optional [T] group, so that
    # embedded ACTION members after the fields are left untouched.
    REAP ttok FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP ftt FROM plant_iLexer_tok_lex, lexer, ttok[0].
    REAP p FROM _second, ttok.
    REAP btk FROM plant_iLexer_peek_at, lexer, tokens, p.
    REAP blx FROM plant_iLexer_tok_lex, lexer, btk.
    IF blx IS "[",
      REAP btv FROM collect_type_text, tokens, p, "]", 0.
      REAP btx FROM _first, btv.
      REAP p FROM _second, btv.
      SET ftt TO ftt + btx + "]".
      REAP brb FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP p FROM _second, brb.
    /IF.
    PUT plant_list_make(4, "name", fname, "type", ftt) INTO fields.
  /SEASON.
  GIVE plant_list_make(2, plant_list_make(12, "type", "species_decl", "name", sname, "type_params", stparams, "parent", parent, "fields", fields, "methods", methods), p).
/ACTION.

# parse_type_decl - TYPE alias = target. (v0.49.27)
ACTION parse_type_decl(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP kw_pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p FROM _second, kw_pair.
  REAP apair FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP aty FROM plant_iLexer_tok_type, lexer, apair[0].
  IF aty ISNT "IDENT",
    CREATE terr(TX) TO "TYPE requires an alias name".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", terr), p).
  /IF.
  REAP alias FROM plant_iLexer_tok_lex, lexer, apair[0].
  REAP p FROM _second, apair.
  REAP eqtok FROM plant_iLexer_peek_at, lexer, tokens, p.
  REAP eqlx FROM plant_iLexer_tok_lex, lexer, eqtok.
  IF eqlx ISNT "=",
    CREATE terr2(TX) TO "TYPE requires = target".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", terr2), p).
  /IF.
  REAP eqpair FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP p FROM _second, eqpair.
  REAP tv FROM collect_type_text, tokens, p, ".", 0.
  REAP target FROM _first, tv.
  REAP p FROM _second, tv.
  REAP dpair FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP p FROM _second, dpair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "type_decl", "alias", alias, "target", target), p).
/ACTION.

# parse_interface_decl - INTERFACE Name { method_sig. ... } (v0.49.33)
ACTION parse_interface_decl(tokens(LIST), pos(NUM)),
  REAP lexer FROM get_lexer.
  REAP kw_pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p FROM _second, kw_pair.
  REAP npair FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP iname FROM plant_iLexer_tok_lex, lexer, npair[0].
  REAP p FROM _second, npair.
  CREATE itparams(LIST) TO plant_list_make(0).
  REAP igtk FROM plant_iLexer_peek_at, lexer, tokens, p.
  REAP iglx FROM plant_iLexer_tok_lex, lexer, igtk.
  IF iglx IS "[",
    REAP iglb FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP p FROM _second, iglb.
    REAP igv FROM collect_type_text, tokens, p, "]", 0.
    REAP p FROM _second, igv.
    REAP igt FROM _first, igv.
    REAP igrb FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP p FROM _second, igrb.
    REAP igparts FROM strings:SPLIT, igt, ",".
    CREATE igi(NUM) TO 0.
    SEASON igi < COUNT igparts,
      REAP ige FROM plant_list_get, igparts, igi.
      REAP iget FROM trim, ige.
      IF iget > "", PUT iget INTO itparams. /IF.
      SET igi TO igi + 1.
    /SEASON.
  /IF.
  CREATE iparents(LIST) TO plant_list_make(0).
  REAP iftk FROM plant_iLexer_peek_at, lexer, tokens, p.
  REAP iflx FROM plant_iLexer_tok_lex, lexer, iftk.
  IF iflx IS "FROM",
    REAP ifp FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP p FROM _second, ifp.
    SEASON TRUE,
      REAP pip FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP pin FROM plant_iLexer_tok_lex, lexer, pip[0].
      PUT pin INTO iparents.
      REAP pctk FROM plant_iLexer_peek_at, lexer, tokens, p.
      REAP pclx FROM plant_iLexer_tok_lex, lexer, pctk.
      IF pclx IS ",",
        REAP pcc FROM plant_iLexer_consume_at, lexer, tokens, p.
        REAP p FROM _second, pcc.
      /IF.
      IF pclx ISNT ",", BREAK 0. /IF.
    /SEASON.
  /IF.
  REAP lb FROM plant_iLexer_consume_at, lexer, tokens, p.
  REAP p FROM _second, lb.
  CREATE imethods(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tk9 FROM plant_iLexer_peek_at, lexer, tokens, p.
    REAP ty9 FROM plant_iLexer_tok_type, lexer, tk9.
    IF ty9 IS "RBRACE",
      REAP rb9 FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP p FROM _second, rb9.
      BREAK 0.
    /IF.
    REAP mpair FROM plant_iLexer_consume_at, lexer, tokens, p.
    REAP mnine FROM plant_iLexer_tok_lex, lexer, mpair[0].
    REAP p FROM _second, mpair.
    PUT mnine INTO imethods.
    REAP dtok FROM plant_iLexer_peek_at, lexer, tokens, p.
    REAP dlx FROM plant_iLexer_tok_lex, lexer, dtok.
    IF dlx IS ".",
      REAP dcon FROM plant_iLexer_consume_at, lexer, tokens, p.
      REAP p FROM _second, dcon.
      BREAK 0.
    /IF.
  /SEASON.
  GIVE plant_list_make(2, plant_list_make(10, "type", "interface_decl", "name", iname, "type_params", itparams, "parents", iparents, "methods", imethods), p).
/ACTION.

ACTION parse_declaration(tokens(LIST), pos(NUM), clv(TX), ctab(LIST), rtab(LIST), bstart(NUM)),
  REAP lexer FROM get_lexer.
  REAP tok FROM plant_iLexer_peek_at, lexer, tokens, pos.
  REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
  IF lx IS "ENUM",
    REAP r FROM parse_enum_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "INTERFACE",
    REAP r FROM parse_interface_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "STRUCT",
    REAP r FROM parse_struct_decl, tokens, pos.
    GIVE r.
  /IF.
  # v0.50.0d — UNION composite type.
  IF lx IS "UNION",
    REAP r FROM parse_union_decl, tokens, pos.
    GIVE r.
  /IF.
  # v0.50.0e — native fixed-size arrays.
  IF lx IS "ARRAY" OR lx IS "array",
    REAP r FROM parse_array_decl, tokens, pos, rtab.
    GIVE r.
  /IF.
  # v0.49.27 - TYPE alias = target.
  IF lx IS "TYPE",
    REAP r FROM parse_type_decl, tokens, pos.
    GIVE r.
  /IF.
  # v0.49.28 - SPECIES name { field: TYPE, ... }
  IF lx IS "SPECIES",
    REAP r FROM parse_species_decl, tokens, pos.
    GIVE r.
  /IF.
  # v0.49.25 - IMPORT "path". The compiler's loader (main.plant)
  # expands imports textually before tokenization; this parser rule
  # recognizes any residual IMPORT statement so it becomes a typed
  # no-op node instead of falling into unknown-token tolerance.
  IF lx IS "IMPORT",
    REAP im_pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
    REAP im_p2 FROM _second, im_pair.
    REAP stok FROM plant_iLexer_peek_at, lexer, tokens, im_p2.
    REAP sty2 FROM plant_iLexer_tok_type, lexer, stok.
    IF sty2 ISNT "STRING",
      CREATE ierr(TX) TO "IMPORT requires a quoted path string".
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", ierr), im_p2).
    /IF.
    REAP spair FROM plant_iLexer_consume_at, lexer, tokens, im_p2.
    REAP ipath FROM plant_iLexer_tok_lex, lexer, spair.
    REAP im_p3 FROM _second, spair.
    REAP dtok FROM plant_iLexer_peek_at, lexer, tokens, im_p3.
    REAP dlx FROM plant_iLexer_tok_lex, lexer, dtok.
    IF dlx IS ".",
      REAP dpair FROM plant_iLexer_consume_at, lexer, tokens, im_p3.
      REAP im_p4 FROM _second, dpair.
      GIVE plant_list_make(2, plant_list_make(6, "type", "import_stmt", "path", ipath), im_p4).
    /IF.
    GIVE plant_list_make(2, plant_list_make(6, "type", "import_stmt", "path", ipath), im_p3).
  /IF.
  IF lx IS "ACTION",
    REAP r FROM parse_action_decl, tokens, pos, rtab.
    GIVE r.
  /IF.
  IF lx IS "ASYNC",
    REAP pair FROM plant_iLexer_peek_at, lexer, tokens, pos + 1.
    REAP nx FROM plant_iLexer_tok_lex, lexer, pair.
    IF nx IS "IN",
      REAP r FROM parse_async_in_stmt, tokens, pos.
      GIVE r.
    /IF.
    REAP r FROM parse_action_decl, tokens, pos + 1, rtab.
    REAP nd FROM _first, r.
    REAP np FROM _second, r.
    REAP nt FROM _map_get, nd, "type".
    IF nt IS "action_decl",
      REAP nd2 FROM map_add, nd, "async", "1".
      GIVE plant_list_make(2, nd2, np).
    /IF.
    GIVE r.
  /IF.
  IF lx IS "MISSION",
    REAP r FROM parse_mission_stmt, tokens, pos.
    GIVE r.
  /IF.
  REAP r FROM parse_statement, tokens, pos, clv, ctab, rtab, bstart, "0".
  GIVE r.
/ACTION.

# map_add: append a key/value pair to a flat map list
ACTION map_add(m(LIST), k(TX), v(TX)),
  REAP lexer FROM get_lexer.
  CREATE out(LIST) TO plant_list_make(0).
  CREATE mi3(NUM) TO 0.
  SEASON mi3 < COUNT m,
    REAP me3 FROM plant_list_get, m, mi3.
    PUT me3 INTO out.
    SET mi3 TO mi3 + 1.
  /SEASON.
  PUT k INTO out.
  PUT v INTO out.
  GIVE out.
/ACTION.

# ── Constant symbol tables (v0.48.35) ─────────────────────────
#   Two flat pairs-list tables live in the parser:
#     ctab — the CURRENT block's local CONST names+values
#     rtab — the module-wide ROOT table (ROOT + ROOT_SCOPE consts)
#   Lookup follows the language rule: a block's own table shadows
#   the global root table (local-first), which the emitted C
#   reproduces naturally (block-scoped static const over file-scope
#   static const). Tables are used at parse time for redeclaration
#   rejection and use-before-definition detection only; the codegen
#   performs its own first-pass collection for the actual ROOT
#   emission.

# tab_has: "1" when a flat pairs-list table contains key (step 2 so
# values can never be mistaken for names)
ACTION tab_has(tab(LIST), key(TX)),
  REAP lexer FROM get_lexer.
  CREATE ti4(NUM) TO 0.
  CREATE te4(TX) TO "".
  SEASON ti4 < COUNT tab,
    REAP te4 FROM plant_list_get, tab, ti4.
    IF str_eq(te4, key) IS "1",
      GIVE "1".
    /IF.
    SET ti4 TO ti4 + 2.
  /SEASON.
  GIVE "0".
/ACTION.

# scan_ident_used: "1" when an IDENT token equal to name appears in
# tokens[start, end). Used to reject local-const use-before-definition
# in the enclosing block. String tokens are never IDENT so quoted
# text cannot false-positive; keyword lexemes compare unequal to
# identifiers, so CONST names (which must be plain identifiers) are
# matched exactly.
ACTION scan_ident_used(tokens(LIST), start(NUM), end(NUM), name(TX)),
  REAP lexer FROM get_lexer.
  CREATE si3(NUM) TO start.
  CREATE stk3(TX) TO "".
  CREATE stt3(TX) TO "".
  SEASON si3 < end,
    REAP stk3 FROM plant_iLexer_peek_at, lexer, tokens, si3.
    REAP stt3 FROM plant_iLexer_tok_type, lexer, stk3.
    IF stt3 IS "IDENT",
      REAP slx3 FROM plant_iLexer_tok_lex, lexer, stk3.
      IF str_eq(slx3, name) IS "1",
        GIVE "1".
      /IF.
    /IF.
    SET si3 TO si3 + 1.
  /SEASON.
  GIVE "0".
/ACTION.

# v0.48.35 — CONST name TO "literal". / ROOT name TO "literal".
# Shared kernel. ntype is "const_stmt" (local constant; or elevated
# to a root constant when elevate="1", e.g. inside ROOT_SCOPE) or
# "root_stmt" (always a global). The value MUST be a single quoted
# string literal — constants become C string initializers, so raw
# expressions are rejected up front with a clean parse error.
# Registration: elevate="1" → rtab (with redeclaration check, no
# use-before-definition scan — ROOT constants are hoisted); else →
# ctab (with same-block redeclaration + use-before-definition
# checks). Returns syntax_error nodes for every violation.
ACTION parse_const_like(tokens(LIST), pos(NUM), ctab(LIST), rtab(LIST), bstart(NUM), elevate(TX), ntype(TX)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP nt FROM plant_iLexer_peek_at, lexer, tokens, p2.
  REAP nty FROM plant_iLexer_tok_type, lexer, nt.
  IF nty ISNT "IDENT",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "CONST/ROOT requires an identifier name"), p2).
  /IF.
  REAP npr FROM plant_iLexer_consume_at, lexer, tokens, p2.
  REAP cname FROM plant_iLexer_tok_lex, lexer, npr[0].
  REAP p3 FROM _second, npr.
  REAP ttok FROM plant_iLexer_peek_at, lexer, tokens, p3.
  REAP tlx FROM plant_iLexer_tok_lex, lexer, ttok.
  IF tlx ISNT "TO",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "CONST/ROOT requires TO after the constant name"), p3).
  /IF.
  REAP tp FROM plant_iLexer_consume_at, lexer, tokens, p3.
  REAP p4 FROM _second, tp.
  REAP vt FROM plant_iLexer_peek_at, lexer, tokens, p4.
  REAP vty FROM plant_iLexer_tok_type, lexer, vt.
  IF vty ISNT "STRING",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "CONST/ROOT value must be a quoted string literal"), p4).
  /IF.
  REAP vp FROM plant_iLexer_consume_at, lexer, tokens, p4.
  REAP vraw FROM plant_iLexer_tok_lex, lexer, vp[0].
  REAP p5 FROM _second, vp.
  REAP esc FROM escape_string, vraw.
  CREATE cval TO "\"" + esc + "\"".
  REAP dt FROM plant_iLexer_peek_at, lexer, tokens, p5.
  REAP dlx FROM plant_iLexer_tok_lex, lexer, dt.
  IF dlx ISNT ".",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "CONST/ROOT expects '.' after the value"), p5).
  /IF.
  REAP dp FROM plant_iLexer_consume_at, lexer, tokens, p5.
  REAP p6 FROM _second, dp.
  IF elevate IS "1",
    IF tab_has(rtab, cname) IS "1",
      CREATE rmsg(TX) TO "ROOT constant already declared: " + cname.
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", rmsg), p6).
    /IF.
    PUT cname INTO rtab.
    PUT cval INTO rtab.
    IF ntype IS "const_stmt",
      REAP nd2 FROM map_add, plant_list_make(6, "type", "const_stmt", "name", cname, "value", cval), "root", "1".
      GIVE plant_list_make(2, nd2, p6).
    /IF.
    GIVE plant_list_make(2, plant_list_make(6, "type", "root_stmt", "name", cname, "value", cval), p6).
  /IF.
  # local constant: same-block redeclaration and use-before-definition
  # are both rejected (use-before-definition of a ROOT is legal — the
  # first pass hoists it; a block-scoped CONST is only visible after
  # its declaration point).
  IF tab_has(ctab, cname) IS "1",
    CREATE dmsg(TX) TO "CONST '" + cname + "' is already declared in this block".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p6).
  /IF.
  IF scan_ident_used(tokens, bstart, pos, cname) IS "1",
    CREATE umsg(TX) TO "CONST '" + cname + "' is used before its definition in this block".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", umsg), p6).
  /IF.
  PUT cname INTO ctab.
  PUT cval INTO ctab.
  GIVE plant_list_make(2, plant_list_make(6, "type", "const_stmt", "name", cname, "value", cval), p6).
/ACTION.

# v0.48.35 — ROOT_SCOPE /ROOT_SCOPE. block: every CONST declared
# inside is automatically elevated to a ROOT constant (the const
# parser runs in elevation mode via emode="1", so it registers in
# rtab and skips the use-before-definition scan — hoisted constants
# are order-independent). ROOT directives nested inside are parsed
# as-is and also land in rtab. The wrapper node keeps its body so
# the codegen first pass can walk it and non-constant statements
# (rare) still generate inline.
ACTION parse_root_scope_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST)),
  REAP lexer FROM get_lexer.
  REAP pair FROM plant_iLexer_consume_at, lexer, tokens, pos.
  REAP p2 FROM _second, pair.
  CREATE ctab5(LIST) TO plant_list_make(0).
  CREATE body5(LIST) TO plant_list_make(0).
  CREATE bstart5(NUM) TO p2.
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(4, "type", "root_scope", "body", body5), p2).
    /IF.
    REAP tok FROM plant_iLexer_peek_at, lexer, tokens, p2.
    REAP lx FROM plant_iLexer_tok_lex, lexer, tok.
    IF lx IS "/",
      REAP slash FROM plant_iLexer_consume_at, lexer, tokens, p2.
      REAP p3 FROM _second, slash.
      REAP kp FROM plant_iLexer_consume_at, lexer, tokens, p3.
      REAP klx FROM plant_iLexer_tok_lex, lexer, kp[0].
      REAP p4 FROM _second, kp.
      IF klx ISNT "ROOT_SCOPE",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "expected /ROOT_SCOPE. to close ROOT_SCOPE block"), p4).
      /IF.
      REAP dp FROM plant_iLexer_consume_at, lexer, tokens, p4.
      REAP p5 FROM _second, dp.
      GIVE plant_list_make(2, plant_list_make(4, "type", "root_scope", "body", body5), p5).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p2, clv, ctab5, rtab, bstart5, "1".
    CREATE stmt TO stmt_pair[0].
    REAP p2 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      PUT stmt INTO body5.
    /IF.
  /SEASON.
/ACTION.

#── Top-level ──────────────────────────────────────────────────

ACTION parse_program(tokens(LIST)),
  REAP lexer FROM get_lexer.
  CREATE pos(NUM) TO 0.
  CREATE clv(TX) TO "".
  # v0.48.35: module-wide ROOT table + top-level CONST table. The
  # top-level scan range for use-before-definition starts where the
  # current top-level statement begins (bstart is re-armed each
  # iteration below so ACTION/ENUM/STRUCT token spans never pollute
  # the scan range).
  CREATE rtab(LIST) TO plant_list_make(0).
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO 0.
  CREATE nodes(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM plant_iLexer_is_eof_at, lexer, tokens, pos.
    IF is_eof_flag,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    SET bstart TO pos.
    REAP d_pair FROM parse_declaration, tokens, pos, clv, ctab, rtab, bstart.
    CREATE decl TO d_pair[0].
    REAP pos2 FROM _second, d_pair.
    IF decl > "",
      REAP dty FROM _map_get, decl, "type".
      IF dty IS "syntax_error",
        REAP dmsg FROM _map_get, decl, "msg".
        GIVE plant_list_make(6, "type", "program", "body", nodes, "error", dmsg).
      /IF.
      IF dty IS "listen_stmt",
        REAP plv FROM _map_get, decl, "resp".
        SET clv TO plv.
      /IF.
    /IF.
    IF pos2 <= pos,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    SET pos TO pos2.
    IF decl > "",
      REAP dsplice FROM _map_get, decl, "type".
      REAP is_sp FROM str_eq, dsplice, "species_decl".
      IF is_sp IS "1",
        REAP ml FROM _map_get, decl, "methods".
        CREATE mi9(NUM) TO 0.
        SEASON mi9 < COUNT ml,
          REAP mn9 FROM plant_list_get, ml, mi9.
          PUT mn9 INTO nodes.
          SET mi9 TO mi9 + 1.
        /SEASON.
      /IF.
      IF is_sp ISNT "1",
        PUT decl INTO nodes.
      /IF.
    /IF.
  /SEASON.
/ACTION.


