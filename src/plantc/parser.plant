# ═══════════════════════════════════════════════════════════════
#  src/plantc/parser.plant — Recursive descent parser
#
#  All action calls use REAP (no inline calls).
#  SEASON is a while-loop, IF is a conditional.
#  Use SEASON only for loops, IF for single branches.
#  Block IFs (multi-line) for multiple body statements.
# ═══════════════════════════════════════════════════════════════

IMPORT "tokens.plant".
IMPORT "ast.plant".

#── Utility actions ────────────────────────────────────────────

ACTION tok_lex(tok(LIST)),
  GIVE tok[1].
/ACTION.

ACTION tok_type(tok(LIST)),
  GIVE tok[0].
/ACTION.

ACTION peek(tokens(LIST), pos(NUM)),
  IF pos < COUNT tokens,
    GIVE tokens[pos].
  /IF.
  GIVE plant_list_make(2, null, "").
/ACTION.

ACTION consume(tokens(LIST), pos(NUM)),
  GIVE plant_list_make(2, tokens[pos], pos + 1).
/ACTION.

ACTION _first(pair(LIST)),
  GIVE pair[0].
/ACTION.

ACTION _second(pair(LIST)),
  GIVE pair[1].
/ACTION.

ACTION is_eof(tokens(LIST), pos(NUM)),
  IF pos >= COUNT tokens,
    GIVE TRUE.
  /IF.
  REAP tok FROM peek, tokens, pos.
  REAP tp FROM tok_type, tok.
  IF tp IS "EOF",
    GIVE TRUE.
  /IF.
  GIVE FALSE.
/ACTION.

# collect_value: collects text until "." or EOF (consumes the dot)
# escape_string — re-escape C-unsafe characters in string content for emission
ACTION escape_string(s(TX)),
  CREATE r(TX) TO "".
  CREATE ei(NUM) TO 0.
  CREATE en(NUM) TO LEN(s).
  CREATE ec(TX) TO "".
  SEASON ei < en,
    REAP ec FROM char_at, s, ei.
    IF ec IS "\\", SET r TO r + "\\" + "\\". /IF.
    IF ec IS "\"", SET r TO r + "\\" + "\"". /IF.
    IF ec IS "\n", SET r TO r + "\\" + "n". /IF.
    IF ec IS "\t", SET r TO r + "\\" + "t". /IF.
    IF ec IS "\r", SET r TO r + "\\" + "r". /IF.
    IF ec ISNT "\\" AND ec ISNT "\"" AND ec ISNT "\n" AND ec ISNT "\t" AND ec ISNT "\r",
      SET r TO r + ec.
    /IF.
    SET ei TO ei + 1.
  /SEASON.
  GIVE r.
/ACTION.

ACTION collect_value(tokens(LIST), start(NUM)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP tt FROM tok_type, tok.
    IF tt IS "STRING" OR tt IS "INTERP",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    IF lx IS "." AND depth IS 0,
      REAP cpair FROM consume, tokens, p2.
      REAP p2 FROM _second, cpair.
      GIVE plant_list_make(2, text, p2).
    /IF.
    # a ")" at depth 0 closes an enclosing closure block body; leave
    # it unconsumed so the caller (parse_statement loop) sees it
    IF lx IS ")" AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    # a top-level "IN" terminates the value (CANCEL/TRACE ... IN ctx);
    # left unconsumed so the caller parses the context
    IF lx IS "IN" AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

# collect_until: collects text until delimiter at depth=0 (does NOT consume delimiter)
ACTION collect_until(tokens(LIST), start(NUM), delim(TX)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP tt FROM tok_type, tok.
    IF tt IS "STRING" OR tt IS "INTERP",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    IF _cat("", lx) IS _cat("", delim) AND depth IS 0,
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(",
      SET depth TO depth + 1.
    /IF.
    IF lx IS ")",
      SET depth TO depth - 1.
    /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

# collect_type_text: collects a type string until stopc (or "," when
# stopcomma=1) at depth 0, WITHOUT consuming the delimiter.
# Handles T, LIST[T], REF NUM, REF LIST[T], Box[NUM], Pair[NUM, TX] etc.
ACTION collect_type_text(tokens(LIST), start(NUM), stopc(TX), stopcomma(NUM)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE pdepth(NUM) TO 0.
  CREATE bdepth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF pdepth IS 0 AND bdepth IS 0,
      IF _cat("", lx) IS _cat("", stopc),
        GIVE plant_list_make(2, text, p2).
      /IF.
      IF stopcomma IS 1 AND lx IS ",",
        GIVE plant_list_make(2, text, p2).
      /IF.
    /IF.
    IF lx IS "(", SET pdepth TO pdepth + 1. /IF.
    IF lx IS ")", SET pdepth TO pdepth - 1. /IF.
    IF lx IS "[", SET bdepth TO bdepth + 1. /IF.
    IF lx IS "]", SET bdepth TO bdepth - 1. /IF.
    IF text > "",
      SET text TO text + " ".
    /IF.
    SET text TO text + lx.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
  /SEASON.
/ACTION.

#── Statement parsing ──────────────────────────────────────────

# collect_args: collect call arguments into a flat list until ",", "."
# or ")" at depth 0 (delimiters NOT consumed). Strings escaped.
ACTION collect_args(tokens(LIST), pos(NUM)),
  CREATE args(LIST) TO plant_list_make(0).
  CREATE p5(NUM) TO pos.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, args, p5).
    /IF.
    REAP tok FROM peek, tokens, p5.
    REAP lx FROM tok_lex, tok.
    REAP ty FROM tok_type, tok.
    IF lx IS "," AND ty ISNT "STRING",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    IF lx IS "." AND ty ISNT "STRING",
      GIVE plant_list_make(2, args, p5).
    /IF.
    IF lx IS ")" AND ty ISNT "STRING",
      GIVE plant_list_make(2, args, p5).
    /IF.
    # "IN" at depth 0 terminates the argument list (START/AWAIT/REAP
    # ... IN ctx); left unconsumed so the caller parses the context
    IF lx IS "IN" AND ty ISNT "STRING",
      GIVE plant_list_make(2, args, p5).
    /IF.
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM peek, tokens, p5.
      REAP alx FROM tok_lex, atok.
      REAP atype FROM tok_type, atok.
      IF atype IS "STRING" OR atype IS "INTERP",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "." AND adepth IS 0, BREAK 0. /IF.
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "IN" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM consume, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    PUT arg_text INTO args.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com2 FROM consume, tokens, p5.
      REAP p5 FROM _second, com2.
    /IF.
  /SEASON.
/ACTION.

# AWAIT callname, args [IN ctx]. — suspend until the async action
# completes; the child task is spawned into ctx when given
ACTION parse_await_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP act_pair FROM consume, tokens, p2.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p3 FROM _second, act_pair.
  REAP ap FROM collect_args, tokens, p3.
  CREATE args(LIST) TO ap[0].
  REAP p4 FROM _second, ap.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM peek, tokens, p4.
  REAP lx FROM tok_lex, tok.
  IF lx IS "IN",
    REAP in_pair FROM consume, tokens, p4.
    REAP p5 FROM _second, in_pair.
    REAP ctx_pair FROM consume, tokens, p5.
    REAP ctx_name FROM tok_lex, ctx_pair[0].
    REAP p6 FROM _second, ctx_pair.
    REAP dot FROM consume, tokens, p6.
    REAP p7 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(8, "type", "await_stmt", "action", act_name, "args", args, "ctx", ctx_name), p7).
  /IF.
  REAP dot FROM consume, tokens, p4.
  REAP p5 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(8, "type", "await_stmt", "action", act_name, "args", args, "ctx", ctx_name), p5).
/ACTION.

# START callname, args [IN ctx]. — fire-and-forget spawn
ACTION parse_start_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP act_pair FROM consume, tokens, p2.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p3 FROM _second, act_pair.
  REAP ap FROM collect_args, tokens, p3.
  CREATE args(LIST) TO ap[0].
  REAP p4 FROM _second, ap.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM peek, tokens, p4.
  REAP lx FROM tok_lex, tok.
  IF lx IS "IN",
    REAP in_pair FROM consume, tokens, p4.
    REAP p5 FROM _second, in_pair.
    REAP ctx_pair FROM consume, tokens, p5.
    REAP ctx_name FROM tok_lex, ctx_pair[0].
    REAP p6 FROM _second, ctx_pair.
    REAP dot FROM consume, tokens, p6.
    REAP p7 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(8, "type", "start_stmt", "action", act_name, "args", args, "ctx", ctx_name), p7).
  /IF.
  REAP dot FROM consume, tokens, p4.
  REAP p5 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(8, "type", "start_stmt", "action", act_name, "args", args, "ctx", ctx_name), p5).
/ACTION.

# ASYNC IN ctx, callname, args. — spawn into a structured context
ACTION parse_async_in_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP in_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, in_pair.
  REAP ctx_pair FROM consume, tokens, p3.
  REAP ctx_name FROM tok_lex, ctx_pair[0].
  REAP p4 FROM _second, ctx_pair.
  REAP com FROM consume, tokens, p4.
  REAP p5 FROM _second, com.
  REAP act_pair FROM consume, tokens, p5.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p6 FROM _second, act_pair.
  REAP ap FROM collect_args, tokens, p6.
  CREATE args(LIST) TO ap[0].
  REAP p7 FROM _second, ap.
  REAP dot FROM consume, tokens, p7.
  REAP p8 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(10, "type", "start_stmt", "action", act_name, "args", args, "ctx", ctx_name, "kind", "async_in"), p8).
/ACTION.

# CANCEL tok. or CANCEL tok IN ctx. — immediate cancellation + teardown;
# the IN form is scoped: only cancels the handle if it lives in ctx
ACTION parse_cancel_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  IF lx IS "IN",
    REAP in_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, in_pair.
    REAP ctx_pair FROM consume, tokens, p4.
    REAP ctx_name FROM tok_lex, ctx_pair[0].
    REAP p5 FROM _second, ctx_pair.
    REAP dot FROM consume, tokens, p5.
    REAP p6 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(6, "type", "cancel_stmt", "value", expr, "ctx", ctx_name), p6).
  /IF.
  GIVE plant_list_make(2, plant_list_make(6, "type", "cancel_stmt", "value", expr, "ctx", ctx_name), p3).
/ACTION.

# TRACE INFO|DEBUG|PERF msg [IN ctx]. — scoped trace event; the IN
# form tags the event with the context name
ACTION parse_trace_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP lv_pair FROM consume, tokens, p2.
  REAP lv FROM tok_lex, lv_pair[0].
  REAP p3 FROM _second, lv_pair.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4b FROM _second, vpair.
  CREATE ctx_name(TX) TO "".
  REAP tok FROM peek, tokens, p4b.
  REAP lx FROM tok_lex, tok.
  IF lx IS "IN",
    REAP in_pair FROM consume, tokens, p4b.
    REAP p5 FROM _second, in_pair.
    REAP ctx_pair FROM consume, tokens, p5.
    REAP ctx_name FROM tok_lex, ctx_pair[0].
    REAP p6 FROM _second, ctx_pair.
    REAP dot FROM consume, tokens, p6.
    REAP p7 FROM _second, dot.
    GIVE plant_list_make(2, plant_list_make(8, "type", "trace_stmt", "level", lv, "value", expr, "ctx", ctx_name), p7).
  /IF.
  # collect_value already consumed the dot; p4b is after it
  GIVE plant_list_make(2, plant_list_make(8, "type", "trace_stmt", "level", lv, "value", expr, "ctx", ctx_name), p4b).
/ACTION.

# MISSION CONFIG KEY = VALUE. — runtime configuration directive
ACTION parse_mission_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cfg_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, cfg_pair.
  REAP key_pair FROM consume, tokens, p3.
  REAP cfg_key FROM tok_lex, key_pair[0].
  REAP p4 FROM _second, key_pair.
  REAP eq_tok FROM peek, tokens, p4.
  REAP eq_lx FROM tok_lex, eq_tok.
  IF eq_lx IS "=" OR eq_lx IS "IS",
    REAP eq_pair FROM consume, tokens, p4.
    REAP p4 FROM _second, eq_pair.
  /IF.
  REAP val_pair FROM consume, tokens, p4.
  REAP cfg_val FROM tok_lex, val_pair[0].
  REAP vty FROM tok_type, val_pair[0].
  # quoted values (paths, strings with spaces) keep the whole token;
  # strip the quotes so the codegen emits a clean "value"
  IF vty IS "STRING",
    REAP cfg_val FROM escape_string, cfg_val.
  /IF.
  REAP p5 FROM _second, val_pair.
  REAP dot FROM consume, tokens, p5.
  REAP p6 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(6, "type", "config_stmt", "key", cfg_key, "value", cfg_val), p6).
/ACTION.

ACTION parse_create_stmt(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM consume, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tv FROM collect_type_text, tokens, p4, ")", 0.
    REAP tt FROM _first, tv.
    REAP p5 FROM _second, tv.
    REAP rp FROM consume, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tt.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM peek, tokens, p3.
  REAP lx2 FROM tok_lex, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "create_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

ACTION parse_show_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "show_stmt", "value", expr), p3).
/ACTION.

# v0.48.36 — NOW [FORMAT:x]. — temporal query statement. The format
#   qualifier is optional (bare NOW. → default stamp); when present
#   it must be written FORMAT:NAME (FORMAT, colon, identifier). The
#   runtime routes the name to a formatting branch; unknown names are
#   reported by plant_now itself (bad-format:<name>), so the parser
#   accepts any identifier. AST node: now_stmt { fmt }.
ACTION parse_now_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  CREATE fmt(TX) TO "".
  REAP ntok FROM peek, tokens, p2.
  REAP nlx FROM tok_lex, ntok.
  IF nlx IS "FORMAT",
    REAP fpair FROM consume, tokens, p2.
    REAP p2 FROM _second, fpair.
    REAP ctok FROM peek, tokens, p2.
    REAP cty FROM tok_type, ctok.
    IF cty ISNT "COLON",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "NOW FORMAT requires ':' before the format name"), p2).
    /IF.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP qpair FROM consume, tokens, p2.
    REAP qlx FROM tok_lex, qpair[0].
    REAP qty FROM tok_type, qpair[0].
    REAP p2 FROM _second, qpair.
    IF qty ISNT "IDENT",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "NOW FORMAT expects a format name after ':'"), p2).
    /IF.
    SET fmt TO qlx.
  /IF.
  REAP dpair FROM consume, tokens, p2.
  REAP dlx FROM tok_lex, dpair[0].
  REAP p3 FROM _second, dpair.
  IF dlx ISNT ".",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "NOW expects '.' after the format"), p2).
  /IF.
  GIVE plant_list_make(2, plant_list_make(4, "type", "now_stmt", "fmt", fmt), p3).
/ACTION.

# v0.48.36 — ANALYZE x. — structural introspection statement. The
#   target is any expression; the runtime inspects the value and the
#   statement prints the unified metadata MAP. AST node:
#   analyze_stmt { target }.
ACTION parse_analyze_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  IF expr IS "" OR expr IS null,
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "ANALYZE requires a target expression"), p2).
  /IF.
  GIVE plant_list_make(2, plant_list_make(4, "type", "analyze_stmt", "target", expr), p3).
/ACTION.

# v0.48.36 — TYPEOF x. — type query statement. The target is any
#   expression; the runtime resolves its type string ("int",
#   "string", "map", "list", "closure", "null") and the statement
#   prints it. AST node: typeof_stmt { target }.
ACTION parse_typeof_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_value, tokens, p2.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  IF expr IS "" OR expr IS null,
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "TYPEOF requires a target expression"), p2).
  /IF.
  GIVE plant_list_make(2, plant_list_make(4, "type", "typeof_stmt", "target", expr), p3).
/ACTION.

# v0.48.37 — FREE x. deallocates x via the slab-aware plant_mem_free
#   and sets the variable to NULL (double-free safe). The target must
#   be a plain identifier.
ACTION parse_free_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP id_type FROM tok_type, id_pair[0].
  REAP p3 FROM _second, id_pair.
  IF id_type ISNT "IDENT",
    CREATE dmsg(TX) TO "FREE requires an identifier target".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p3).
  /IF.
  REAP dot_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "free_stmt", "target", id_name), p4).
/ACTION.

# ── WAIT [n]. — execution pause / throttling (v0.48.37e) ──────
#    WAIT n. pauses the program for n milliseconds; a bare WAIT. (the
#    legacy async phase-boundary spelling) and zero/negative durations
#    are no-ops at runtime. The duration is the token text up to the
#    terminating "."; string operands are rejected as invalid timing
#    arguments. AST node: wait_stmt { ms }.
ACTION parse_wait_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP mpair FROM collect_until, tokens, p2, ".".
  CREATE ms TO mpair[0].
  REAP p3 FROM _second, mpair.
  IF ms > "",
    REAP mtok FROM peek, tokens, p2.
    REAP mty FROM tok_type, mtok.
    IF mty IS "STRING",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "WAIT expects a numeric duration in milliseconds"), p2).
    /IF.
  /IF.
  REAP dot_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "wait_stmt", "ms", ms), p4).
/ACTION.

# ── LOCK var. — synchronization primitive (v0.48.37e) ──────────
#    LOCK var. registers a locking flag against the variable's value in
#    the centralized lock table; concurrent re-lock of a locked key is
#    refused by the runtime. The target must be a plain identifier.
#    AST node: lock_stmt { var }.
ACTION parse_lock_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP id_type FROM tok_type, id_pair[0].
  REAP p3 FROM _second, id_pair.
  IF id_type ISNT "IDENT",
    CREATE dmsg(TX) TO "LOCK requires an identifier target".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p3).
  /IF.
  REAP dot_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "lock_stmt", "var", id_name), p4).
/ACTION.

# v0.48.37 — ARC LINK parent TO child. adds a strong edge (the parent
#   keeps the child alive); ARC UNLINK parent FROM child. drops it.
ACTION parse_arc_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP k_pair FROM consume, tokens, p2.
  REAP k_lx FROM tok_lex, k_pair[0].
  REAP p3 FROM _second, k_pair.
  REAP a_pair FROM consume, tokens, p3.
  REAP a_name FROM tok_lex, a_pair[0].
  REAP p4 FROM _second, a_pair.
  IF k_lx IS "LINK",
    REAP t_pair FROM consume, tokens, p4.
    REAP p5 FROM _second, t_pair.
    REAP c_pair FROM consume, tokens, p5.
    REAP c_name FROM tok_lex, c_pair[0].
    REAP p6 FROM _second, c_pair.
    REAP dot_pair FROM consume, tokens, p6.
    REAP p7 FROM _second, dot_pair.
    GIVE plant_list_make(2, plant_list_make(6, "type", "arc_link_stmt", "parent", a_name, "child", c_name), p7).
  /IF.
  REAP f_pair FROM consume, tokens, p4.
  REAP p5 FROM _second, f_pair.
  REAP c_pair FROM consume, tokens, p5.
  REAP c_name FROM tok_lex, c_pair[0].
  REAP p6 FROM _second, c_pair.
  REAP dot_pair FROM consume, tokens, p6.
  REAP p7 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "arc_unlink_stmt", "parent", a_name, "child", c_name), p7).
/ACTION.

# v0.48.37 — FAST RESET. releases the bump heap and closes the FAST
#   scope (RAII counterpart of WITH MISSION FAST).
ACTION parse_fast_reset_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP r_pair FROM consume, tokens, p2.
  REAP r_lx FROM tok_lex, r_pair[0].
  REAP p3 FROM _second, r_pair.
  IF r_lx ISNT "RESET",
    CREATE dmsg(TX) TO "FAST requires RESET".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p3).
  /IF.
  REAP dot_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "fast_reset_stmt"), p4).
/ACTION.

# v0.48.33 — GIVE val. returns val (give_stmt); GIVE val AS RESPONSE.
#   replies on the active LISTEN request (respond_stmt node; the req
#   slot is filled with the request variable tracked by the statement
#   loops, or stays empty when no LISTEN is bound in the block).
ACTION parse_give_stmt(tokens(LIST), pos(NUM), clv(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  CREATE gkws(LIST) TO plant_list_make(3, "AS", ")", ".").
  REAP vpair FROM collect_until_keyword, tokens, p2, gkws.
  CREATE expr TO vpair[0].
  REAP p3 FROM _second, vpair.
  REAP gtok FROM peek, tokens, p3.
  REAP glx FROM tok_lex, gtok.
  IF glx IS "AS",
    REAP gtok2 FROM peek, tokens, p3 + 1.
    REAP glx2 FROM tok_lex, gtok2.
    IF glx2 IS "RESPONSE",
      REAP as_pair FROM consume, tokens, p3.
      REAP p4 FROM _second, as_pair.
      REAP rs_pair FROM consume, tokens, p4.
      REAP p5 FROM _second, rs_pair.
      REAP dot_pair FROM consume, tokens, p5.
      REAP p6 FROM _second, dot_pair.
      GIVE plant_list_make(2, plant_list_make(6, "type", "respond_stmt", "content", expr, "req", clv), p6).
    /IF.
  /IF.
  GIVE plant_list_make(2, plant_list_make(4, "type", "give_stmt", "value", expr), p3).
/ACTION.

ACTION parse_set_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP eq FROM consume, tokens, p3.
  REAP p4 FROM _second, eq.
  REAP vpair FROM collect_value, tokens, p4.
  CREATE expr TO vpair[0].
  REAP p5 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "set_stmt", "target", id_name, "value", expr), p5).
/ACTION.

#── INCREASE / DECREASE ─────────────────────────────────────────
# INCREASE target BY expr.  →  target += expr;
# DECREASE target BY expr.  →  target -= expr;
# op is "increase" or "decrease" (legacy PlantLang, gap 3.2).
# Returns [node, pos]; a missing "BY" is a syntax error.
ACTION parse_incdec_stmt(tokens(LIST), pos(NUM), op(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP by_pair FROM consume, tokens, p3.
  REAP by_lx FROM tok_lex, by_pair[0].
  REAP p4 FROM _second, by_pair.
  IF by_lx ISNT "BY",
    CREATE dmsg(TX) TO "Expected BY in " + op + " statement".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p3).
  /IF.
  REAP vpair FROM collect_value, tokens, p4.
  CREATE expr TO vpair[0].
  REAP p5 FROM _second, vpair.
  CREATE nty(TX) TO op + "_stmt".
  GIVE plant_list_make(2, plant_list_make(6, "type", nty, "target", id_name, "value", expr), p5).
/ACTION.

ACTION parse_let_stmt(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP id_pair FROM consume, tokens, p2.
  REAP id_name FROM tok_lex, id_pair[0].
  REAP p3 FROM _second, id_pair.
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  CREATE vtype(TX) TO "".
  IF lx IS "(",
    REAP lp FROM consume, tokens, p3.
    REAP p4 FROM _second, lp.
    REAP tv FROM collect_type_text, tokens, p4, ")", 0.
    REAP tt FROM _first, tv.
    REAP p5 FROM _second, tv.
    REAP rp FROM consume, tokens, p5.
    REAP p6 FROM _second, rp.
    SET vtype TO tt.
    SET p3 TO p6.
  /IF.
  REAP tok2 FROM peek, tokens, p3.
  REAP lx2 FROM tok_lex, tok2.
  IF lx2 IS "=",
    REAP eq_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, eq_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  IF lx2 IS "TO",
    REAP to_pair FROM consume, tokens, p3.
    REAP p4 FROM _second, to_pair.
    REAP cb_tok FROM peek, tokens, p4.
    REAP cb_lx FROM tok_lex, cb_tok.
    IF cb_lx IS "[",
      REAP clp FROM parse_closure, tokens, p4, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p5 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p5).
      /IF.
      IF COUNT cnode > 0,
        REAP dotp FROM consume, tokens, p5.
        REAP p6 FROM _second, dotp.
        GIVE plant_list_make(2, plant_list_make(10, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", "", "closure", cnode), p6).
      /IF.
    /IF.
    REAP vpair FROM collect_value, tokens, p4.
    CREATE expr TO vpair[0].
    REAP p5 FROM _second, vpair.
    GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p5).
  /IF.
  REAP vpair FROM collect_value, tokens, p3.
  CREATE expr TO vpair[0].
  REAP p4 FROM _second, vpair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "let_stmt", "target", id_name, "var_type", vtype, "value", expr), p4).
/ACTION.

#── Closures ───────────────────────────────────────────────────
# parse_closure:
#   long form:  [MOVE x, REF y](params) -> expr
#   short form: [MOVE x] -> expr            (bracket entries ARE params)
#   short form: [MOVE x y z] -> expr        (multiple bare parameters)
# A bracket may also hold a block body: [MOVE x](params) -> ( stmts ).
# The closure body's single-expression form ends at "," or "."
# at depth 0; the block form ends at ")".
# Returns [closure_node, pos]; on failure [empty_list, start_pos];
# on mixed/invalid syntax [syntax_error_node, pos].
# The terminating "," or "." is NOT consumed (the caller handles it).

ACTION parse_closure(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  CREATE start_pos(NUM) TO pos.
  REAP lb FROM consume, tokens, pos.
  REAP p2 FROM _second, lb.
  CREATE captures(LIST) TO plant_list_make(0).
  CREATE entries(LIST) TO plant_list_make(0).
  CREATE had_comma(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(0), start_pos).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP ty FROM tok_type, tok.
    IF lx IS "]",
      REAP rb FROM consume, tokens, p2.
      REAP p2 FROM _second, rb.
      BREAK 0.
    /IF.
    # a parenthesized parameter list inside the bracket mixes the
    # short (bare) and long (parenthesized) parameter forms
    IF lx IS "(",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Mixed closure parameter syntax"), p2).
    /IF.
    REAP ent_pair FROM consume, tokens, p2.
    REAP en0 FROM tok_lex, ent_pair[0].
    REAP p2 FROM _second, ent_pair.
    CREATE en_mode(TX) TO "".
    CREATE en_name(TX) TO "".
    IF en0 IS "MOVE" OR en0 IS "REF",
      SET en_mode TO en0.
      REAP ntok FROM peek, tokens, p2.
      REAP nlx FROM tok_lex, ntok.
      REAP nty FROM tok_type, ntok.
      IF nlx IS "(",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Mixed closure parameter syntax"), p2).
      /IF.
      IF nty ISNT "IDENT",
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      REAP npair FROM consume, tokens, p2.
      REAP en_name FROM tok_lex, npair[0].
      REAP p2 FROM _second, npair.
    /IF.
    IF en_mode IS "",
      IF ty ISNT "IDENT",
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      SET en_name TO en0.
    /IF.
    PUT plant_list_make(2, en_mode, en_name) INTO entries.
    REAP tok2 FROM peek, tokens, p2.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      SET had_comma TO "1".
      REAP com FROM consume, tokens, p2.
      REAP p2 FROM _second, com.
    /IF.
  /SEASON.
  # after "]": a "(" selects the long form (bracket = captures),
  # anything else selects the short form (bracket = bare parameters)
  REAP ptok FROM peek, tokens, p2.
  REAP plx FROM tok_lex, ptok.
  CREATE params(LIST) TO plant_list_make(0).
  IF plx IS "(",
    # a bare (comma-less) multi-entry bracket followed by a
    # parenthesized parameter list mixes the two parameter forms
    IF had_comma IS "0",
      IF COUNT entries > 1,
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Mixed closure parameter syntax"), p2).
      /IF.
    /IF.
    # long form: the bracket entries are captures
    CREATE ci2(NUM) TO 0.
    SEASON ci2 < COUNT entries,
      REAP ce2 FROM plant_list_get, entries, ci2.
      REAP cm2 FROM _first, ce2.
      REAP cn2 FROM _second, ce2.
      IF cm2 IS "",
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      PUT plant_list_make(4, "name", cn2, "mode", cm2) INTO captures.
      SET ci2 TO ci2 + 1.
    /SEASON.
    REAP lp FROM consume, tokens, p2.
    REAP p3 FROM _second, lp.
    SEASON TRUE,
      REAP is_eof_flag FROM is_eof, tokens, p3.
      IF is_eof_flag,
        GIVE plant_list_make(2, plant_list_make(0), start_pos).
      /IF.
      REAP tok FROM peek, tokens, p3.
      REAP lx FROM tok_lex, tok.
      IF lx IS ")",
        REAP rp FROM consume, tokens, p3.
        REAP p4 FROM _second, rp.
        BREAK 0.
      /IF.
      REAP pn_pair FROM consume, tokens, p3.
      REAP pn FROM tok_lex, pn_pair[0].
      REAP p4 FROM _second, pn_pair.
      REAP tok2 FROM peek, tokens, p4.
      REAP lx2 FROM tok_lex, tok2.
      IF lx2 IS "(",
        REAP lp2 FROM consume, tokens, p4.
        REAP p5 FROM _second, lp2.
        REAP ptv FROM collect_type_text, tokens, p5, ")", 1.
        REAP pt FROM _first, ptv.
        REAP p5 FROM _second, ptv.
        REAP rp2 FROM consume, tokens, p5.
        REAP p5 FROM _second, rp2.
        PUT plant_list_make(4, "name", pn, "type", pt) INTO params.
        SET p4 TO p5.
      /IF.
      IF lx2 ISNT "(",
        PUT plant_list_make(4, "name", pn, "type", "") INTO params.
      /IF.
      REAP tok3 FROM peek, tokens, p4.
      REAP lx3 FROM tok_lex, tok3.
      IF lx3 IS ",",
        REAP com2 FROM consume, tokens, p4.
        REAP p4 FROM _second, com2.
      /IF.
      SET p3 TO p4.
    /SEASON.
  /IF.
  IF plx ISNT "(",
    # short form: the bracket entries ARE the parameters; they default
    # to NUM so concise closures can be used in arithmetic directly
    CREATE si2(NUM) TO 0.
    SEASON si2 < COUNT entries,
      REAP se2 FROM plant_list_get, entries, si2.
      REAP sn2 FROM _second, se2.
      PUT plant_list_make(4, "name", sn2, "type", "NUM") INTO params.
      SET si2 TO si2 + 1.
    /SEASON.
    SET p4 TO p2.
  /IF.
  # "->"
  REAP atok FROM peek, tokens, p4.
  REAP alx FROM tok_lex, atok.
  IF alx ISNT "->",
    GIVE plant_list_make(2, plant_list_make(0), start_pos).
  /IF.
  REAP ap FROM consume, tokens, p4.
  REAP p5 FROM _second, ap.
  # defensive skip of a stray MINUS (mirrors parse_action_decl)
  REAP stok FROM peek, tokens, p5.
  REAP sty FROM tok_type, stok.
  IF sty IS "MINUS",
    REAP sp FROM consume, tokens, p5.
    REAP p5 FROM _second, sp.
  /IF.
  # body: block form "-> ( stmts )" when "(" is followed by a
  # statement keyword; otherwise a single expression
  CREATE body_kind(TX) TO "expr".
  REAP btok FROM peek, tokens, p5.
  REAP blx FROM tok_lex, btok.
  CREATE body(LIST) TO plant_list_make(0).
  IF blx IS "(",
    REAP btok2 FROM peek, tokens, p5 + 1.
    REAP blx2 FROM tok_lex, btok2.
    IF blx2 IS "CREATE" OR blx2 IS "SHOW" OR blx2 IS "GIVE" OR blx2 IS "SET" OR blx2 IS "LET" OR blx2 IS "IF" OR blx2 IS "SEASON" OR blx2 IS "REAP" OR blx2 IS "PUT" OR blx2 IS "TAKE" OR blx2 IS "BREAK" OR blx2 IS "CONTINUE" OR blx2 IS "SORT" OR blx2 IS "SHAKE" OR blx2 IS "BRAID" OR blx2 IS "LINK" OR blx2 IS "HARVEST" OR blx2 IS "LISTEN" OR blx2 IS "CONST" OR blx2 IS "ROOT" OR blx2 IS "ROOT_SCOPE" OR blx2 IS "NOW" OR blx2 IS "ANALYZE" OR blx2 IS "TYPEOF" OR blx2 IS "FREE" OR blx2 IS "ARC" OR blx2 IS "FAST" OR blx2 IS "WAIT" OR blx2 IS "LOCK",
      SET body_kind TO "block".
      CREATE clv(TX) TO "".
      # v0.48.35: the closure block is its own C scope → own table
      CREATE ctab7(LIST) TO plant_list_make(0).
      CREATE bstart7(NUM) TO p6.
      REAP bp FROM consume, tokens, p5.
      REAP p6 FROM _second, bp.
      CREATE stmts(LIST) TO plant_list_make(0).
      SEASON TRUE,
        REAP is_eof_flag FROM is_eof, tokens, p6.
        IF is_eof_flag, BREAK 0. /IF.
        REAP btok3 FROM peek, tokens, p6.
        REAP blx3 FROM tok_lex, btok3.
        IF blx3 IS ")",
          REAP brp FROM consume, tokens, p6.
          REAP p6 FROM _second, brp.
          BREAK 0.
        /IF.
        REAP d_pair FROM parse_statement, tokens, p6, clv, ctab7, rtab, bstart7, emode.
        CREATE decl TO d_pair[0].
        REAP p6 FROM _second, d_pair.
        IF decl > "",
          REAP dty FROM _map_get, decl, "type".
          IF dty IS "syntax_error",
            GIVE d_pair.
          /IF.
          IF dty IS "listen_stmt",
            REAP dlv FROM _map_get, decl, "resp".
            SET clv TO dlv.
          /IF.
          PUT decl INTO stmts.
        /IF.
      /SEASON.
      SET body TO stmts.
      SET p5 TO p6.
    /IF.
  /IF.
  IF body_kind IS "expr",
    CREATE text(TX) TO "".
    CREATE bd(NUM) TO 0.
    CREATE pd(NUM) TO 0.
    SEASON TRUE,
      REAP is_eof_flag FROM is_eof, tokens, p5.
      IF is_eof_flag, BREAK 0. /IF.
      REAP etok FROM peek, tokens, p5.
      REAP elx FROM tok_lex, etok.
      REAP ety FROM tok_type, etok.
      IF ety IS "STRING",
        REAP elx FROM escape_string, elx.
        SET elx TO "\"" + elx + "\"".
      /IF.
      IF elx IS "," AND pd IS 0 AND bd IS 0, BREAK 0. /IF.
      IF elx IS "." AND pd IS 0 AND bd IS 0, BREAK 0. /IF.
      IF elx IS "(", SET pd TO pd + 1. /IF.
      IF elx IS ")", SET pd TO pd - 1. /IF.
      IF elx IS "[", SET bd TO bd + 1. /IF.
      IF elx IS "]", SET bd TO bd - 1. /IF.
      IF text > "",
        SET text TO text + " ".
      /IF.
      SET text TO text + elx.
      REAP ep FROM consume, tokens, p5.
      REAP p5 FROM _second, ep.
    /SEASON.
    SET body TO text.
  /IF.
  CREATE cnode(LIST) TO plant_list_make(10, "type", "closure", "params", params, "captures", captures, "body", body, "bkind", body_kind).
  GIVE plant_list_make(2, cnode, p5).
/ACTION.

ACTION parse_reap_stmt(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP var_pair FROM consume, tokens, p2.
  REAP var_name FROM tok_lex, var_pair[0].
  REAP p3 FROM _second, var_pair.
  REAP from_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, from_pair.
  REAP act_pair FROM consume, tokens, p4.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p5 FROM _second, act_pair.
  # Check for module:function syntax (e.g., strings:REPLACE)
  REAP next_tok FROM peek, tokens, p5.
  REAP next_lx FROM tok_lex, next_tok.
  REAP next_ty FROM tok_type, next_tok.
    IF next_ty IS "COLON",
      SET act_name TO act_name + ":".
      REAP colon_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, colon_pair.
      REAP func_pair FROM consume, tokens, p5.
      REAP func_name FROM tok_lex, func_pair[0].
      SET act_name TO act_name + func_name.
      REAP p5 FROM _second, func_pair.
    /IF.
  # generic type arguments at the call site: foo[NUM, TX]
  REAP ga_tok FROM peek, tokens, p5.
  REAP ga_lx FROM tok_lex, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p5, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p5 FROM _second, gv.
    REAP ga_rb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_rb.
    SET act_name TO act_name + "[" + gtext + "]".
  /IF.
  # v0.48.37c: REAP r FROM f(a, b, c). — consume the call parens
  # upfront so multi-arg calls split on "," at depth 0 instead of
  # collapsing into a single "( a , b , c )" expression (previously
  # only single-arg calls worked; f() and bare f. are still valid).
  CREATE has_cparen(TX) TO "0".
  REAP cp_tok FROM peek, tokens, p5.
  REAP cp_lx FROM tok_lex, cp_tok.
  IF cp_lx IS "(",
    REAP cp_pair FROM consume, tokens, p5.
    REAP p5 FROM _second, cp_pair.
    SET has_cparen TO "1".
  /IF.
  CREATE args(LIST) TO plant_list_make(0).
  CREATE clargs(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tok0 FROM peek, tokens, p5.
    REAP lx0 FROM tok_lex, tok0.
    REAP ty0 FROM tok_type, tok0.
    IF lx0 IS "," AND ty0 ISNT "STRING",
      REAP com0 FROM consume, tokens, p5.
      REAP p5 FROM _second, com0.
    /IF.
    # closure argument: [MOVE x, REF y](v(NUM)) -> expr
    REAP ctok FROM peek, tokens, p5.
    REAP clx FROM tok_lex, ctok.
    IF clx IS "[",
      REAP clp FROM parse_closure, tokens, p5, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p6 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p6).
      /IF.
      IF COUNT cnode > 0,
        PUT "@@CLOSURE@@" INTO args.
        PUT cnode INTO clargs.
        SET p5 TO p6.
        REAP ctok2 FROM peek, tokens, p5.
        REAP clx2 FROM tok_lex, ctok2.
        IF clx2 IS ",",
          REAP ccom FROM consume, tokens, p5.
          REAP p5 FROM _second, ccom.
        /IF.
        IF clx2 IS ".",
          REAP cdot FROM consume, tokens, p5.
          REAP p6 FROM _second, cdot.
          GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6).
        /IF.
      /IF.
    /IF.
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p5).
    /IF.
    REAP tok FROM peek, tokens, p5.
    REAP lx FROM tok_lex, tok.
    REAP ty FROM tok_type, tok.
    # "IN" at depth 0 after the args → REAP ... IN ctx (async spawn
    # into a context; the reaped handle belongs to that context)
    IF lx IS "IN" AND ty ISNT "STRING",
      REAP in_pair FROM consume, tokens, p5.
      REAP p5b FROM _second, in_pair.
      REAP ctx_pair FROM consume, tokens, p5b.
      REAP ctx_name FROM tok_lex, ctx_pair[0].
      REAP p6b FROM _second, ctx_pair.
      REAP dot2 FROM consume, tokens, p6b.
      REAP p7b FROM _second, dot2.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ctx_name), p7b).
    /IF.
    IF lx IS "." AND ty ISNT "STRING",
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6).
    /IF.
    # v0.48.37c: closing call paren consumed by f(…). — end the arg
    # list. Also covers the zero-arg f() form (empty args list).
    # f() IN ctx. is handled too (ctx after the closing paren).
    IF has_cparen IS "1" AND lx IS ")" AND ty ISNT "STRING",
      REAP rp FROM consume, tokens, p5.
      REAP p5r FROM _second, rp.
      REAP in_tok FROM peek, tokens, p5r.
      REAP in_lx FROM tok_lex, in_tok.
      REAP in_ty FROM tok_type, in_tok.
      IF in_lx IS "IN" AND in_ty ISNT "STRING",
        REAP in_pair FROM consume, tokens, p5r.
        REAP p5r FROM _second, in_pair.
        REAP ctx_pair FROM consume, tokens, p5r.
        REAP ctx_name FROM tok_lex, ctx_pair[0].
        REAP p5r FROM _second, ctx_pair.
        REAP dot3 FROM consume, tokens, p5r.
        REAP p5r FROM _second, dot3.
        GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ctx_name), p5r).
      /IF.
      REAP dot3 FROM consume, tokens, p5r.
      REAP p6r FROM _second, dot3.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6r).
    /IF.
    # collect one argument until , or . at depth 0 (do NOT consume delimiter)
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM peek, tokens, p5.
      REAP alx FROM tok_lex, atok.
      REAP atype FROM tok_type, atok.
      IF atype IS "STRING" OR atype IS "INTERP",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "." AND adepth IS 0, BREAK 0. /IF.
      # ")" at depth 0 closes an enclosing closure block body
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "IN" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM consume, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    # v0.48.18: `REAP r FROM f().` — the empty parens are collected
    # as a "( )" arg expression; drop them so zero-arg reaps emit
    # f() instead of the invalid f(( )).
    IF arg_text ISNT "( )",
        PUT arg_text INTO args.
    /IF.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    IF lx2 IS ".",
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(12, "type", "reap_stmt", "target", var_name, "action", act_name, "args", args, "clargs", clargs, "ctx", ""), p6).
    /IF.
  /SEASON.
/ACTION.

# parse_call_stmt — bare call: name(args). → call_stmt node.
# (void FFI calls like plant_map_set / ffi_swap_ref; the codegen
#  reuses the reap_stmt discard path with target "_")
ACTION parse_call_stmt(tokens(LIST), pos(NUM), rtab(LIST), emode(TX)),
  REAP act_pair FROM consume, tokens, pos.
  REAP act_name FROM tok_lex, act_pair[0].
  REAP p5 FROM _second, act_pair.
  REAP next_tok FROM peek, tokens, p5.
  REAP next_ty FROM tok_type, next_tok.
  IF next_ty IS "COLON",
    SET act_name TO act_name + ":".
    REAP colon_pair FROM consume, tokens, p5.
    REAP p5 FROM _second, colon_pair.
    REAP func_pair FROM consume, tokens, p5.
    REAP func_name FROM tok_lex, func_pair[0].
    SET act_name TO act_name + func_name.
    REAP p5 FROM _second, func_pair.
  /IF.
  REAP ga_tok FROM peek, tokens, p5.
  REAP ga_lx FROM tok_lex, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p5, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p5 FROM _second, gv.
    REAP ga_rb FROM consume, tokens, p5.
    REAP p5 FROM _second, ga_rb.
    SET act_name TO act_name + "[" + gtext + "]".
  /IF.
  REAP lpar FROM consume, tokens, p5.
  REAP p5 FROM _second, lpar.
  CREATE args(LIST) TO plant_list_make(0).
  CREATE clargs(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP tok0 FROM peek, tokens, p5.
    REAP lx0 FROM tok_lex, tok0.
    REAP ty0 FROM tok_type, tok0.
    IF lx0 IS "," AND ty0 ISNT "STRING",
      REAP com0 FROM consume, tokens, p5.
      REAP p5 FROM _second, com0.
    /IF.
    REAP ctok FROM peek, tokens, p5.
    REAP clx FROM tok_lex, ctok.
    IF clx IS "[",
      REAP clp FROM parse_closure, tokens, p5, rtab, emode.
      REAP cnode FROM _first, clp.
      REAP p6 FROM _second, clp.
      REAP cn_ty FROM _map_get, cnode, "type".
      IF cn_ty IS "syntax_error",
        GIVE plant_list_make(2, cnode, p6).
      /IF.
      IF COUNT cnode > 0,
        PUT "@@CLOSURE@@" INTO args.
        PUT cnode INTO clargs.
        SET p5 TO p6.
        REAP ctok2 FROM peek, tokens, p5.
        REAP clx2 FROM tok_lex, ctok2.
        IF clx2 IS ",",
          REAP ccom FROM consume, tokens, p5.
          REAP p5 FROM _second, ccom.
        /IF.
      /IF.
    /IF.
    REAP tok FROM peek, tokens, p5.
    REAP lx FROM tok_lex, tok.
    IF lx IS ")",
      REAP rp FROM consume, tokens, p5.
      REAP p5 FROM _second, rp.
      REAP dot FROM consume, tokens, p5.
      REAP p6 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(8, "type", "call_stmt", "action", act_name, "args", args, "clargs", clargs), p6).
    /IF.
    CREATE arg_text(TX) TO "".
    CREATE adepth(NUM) TO 0.
    SEASON TRUE,
      REAP atok FROM peek, tokens, p5.
      REAP alx FROM tok_lex, atok.
      REAP atype FROM tok_type, atok.
      IF atype IS "STRING" OR atype IS "INTERP",
        REAP alx FROM escape_string, alx.
        SET alx TO "\"" + alx + "\"".
      /IF.
      IF alx IS "," AND adepth IS 0, BREAK 0. /IF.
      IF alx IS ")" AND adepth IS 0, BREAK 0. /IF.
      IF alx IS "(", SET adepth TO adepth + 1. /IF.
      IF alx IS ")", SET adepth TO adepth - 1. /IF.
      IF arg_text > "", SET arg_text TO arg_text + " ". /IF.
      SET arg_text TO arg_text + alx.
      REAP cp FROM consume, tokens, p5.
      REAP p5 FROM _second, cp.
    /SEASON.
    PUT arg_text INTO args.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_put_stmt(tokens(LIST), pos(NUM)),  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_until, tokens, p2, "INTO".
  CREATE item TO vpair[0].
  REAP p3 FROM _second, vpair.
  REAP into_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, into_pair.
  REAP tpair FROM collect_until, tokens, p4, ".".
  CREATE target TO tpair[0].
  REAP p5 FROM _second, tpair.
  REAP dot_pair FROM consume, tokens, p5.
  REAP p6 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "put_stmt", "item", item, "target", target), p6).
/ACTION.

# v0.48.30 — TAKE val FROM list. (removes the first matching item)
ACTION parse_take_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP vpair FROM collect_until, tokens, p2, "FROM".
  CREATE item TO vpair[0].
  REAP p3 FROM _second, vpair.
  REAP from_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, from_pair.
  REAP tpair FROM collect_until, tokens, p4, ".".
  CREATE target TO tpair[0].
  REAP p5 FROM _second, tpair.
  REAP dot_pair FROM consume, tokens, p5.
  REAP p6 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "take_stmt", "item", item, "target", target), p6).
/ACTION.

# v0.48.31 — BRAID l1 WITH l2 AS name [MAP].
#   no MAP  → pair-list zip (plant_braid)
#   with MAP → map build with unique keys (plant_braid_map)
ACTION parse_braid_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP lpair FROM collect_until, tokens, p2, "WITH".
  CREATE left TO lpair[0].
  REAP p3 FROM _second, lpair.
  REAP with_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, with_pair.
  REAP rpair FROM collect_until, tokens, p4, "AS".
  CREATE right TO rpair[0].
  REAP p5 FROM _second, rpair.
  REAP as_pair FROM consume, tokens, p5.
  REAP p6 FROM _second, as_pair.
  CREATE target(TX) TO "".
  SEASON TRUE,
    REAP tok FROM peek, tokens, p6.
    REAP lx FROM tok_lex, tok.
    IF lx IS "MAP" OR lx IS "." OR lx IS "",
      BREAK 0.
    /IF.
    SET target TO target + lx.
    REAP drop FROM consume, tokens, p6.
    REAP p6 FROM _second, drop.
  /SEASON.
  CREATE is_map(TX) TO "0".
  REAP tok FROM peek, tokens, p6.
  REAP lx FROM tok_lex, tok.
  IF lx IS "MAP",
    SET is_map TO "1".
    REAP drop FROM consume, tokens, p6.
    REAP p6 FROM _second, drop.
  /IF.
  REAP dot_pair FROM consume, tokens, p6.
  REAP p7 FROM _second, dot_pair.
  IF is_map IS "1",
    GIVE plant_list_make(2, plant_list_make(8, "type", "braid_map_stmt", "left", left, "right", right, "target", target), p7).
  /IF.
  GIVE plant_list_make(2, plant_list_make(8, "type", "braid_stmt", "left", left, "right", right, "target", target), p7).
/ACTION.

# v0.48.31 — LINK key WITH value IN map. (upsert: update in place
#   when the key exists, append a new pair otherwise)
ACTION parse_link_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP kpair FROM collect_until, tokens, p2, "WITH".
  CREATE key TO kpair[0].
  REAP p3 FROM _second, kpair.
  REAP with_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, with_pair.
  REAP vpair FROM collect_until, tokens, p4, "IN".
  CREATE value TO vpair[0].
  REAP p5 FROM _second, vpair.
  REAP in_pair FROM consume, tokens, p5.
  REAP p6 FROM _second, in_pair.
  REAP mpair FROM collect_until, tokens, p6, ".".
  CREATE target TO mpair[0].
  REAP p7 FROM _second, mpair.
  REAP dot_pair FROM consume, tokens, p7.
  REAP p8 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(8, "type", "link_stmt", "key", key, "value", value, "target", target), p8).
/ACTION.

# v0.48.29 — SORT l [ASC|DESC] [BY f [ASC|DESC] {, g [ASC|DESC]}].
#   no BY   → plain element sort, direction gdir (default ASC)
#   BY list → per-field directions, each defaulting to gdir (ASC)
ACTION parse_sort_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  CREATE target(TX) TO "".
  CREATE gdir(TX) TO "".
  SEASON TRUE,
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF lx IS "BY" OR lx IS "ASC" OR lx IS "DESC" OR lx IS "." OR lx IS "",
      BREAK 0.
    /IF.
    SET target TO target + lx.
    REAP drop FROM consume, tokens, p2.
    REAP p2 FROM _second, drop.
  /SEASON.
  REAP tok FROM peek, tokens, p2.
  REAP lx FROM tok_lex, tok.
  IF lx IS "ASC" OR lx IS "DESC",
    SET gdir TO lx.
    REAP drop FROM consume, tokens, p2.
    REAP p2 FROM _second, drop.
  /IF.
  CREATE fields(LIST) TO plant_list_make(0).
  CREATE dirs(LIST) TO plant_list_make(0).
  REAP tok FROM peek, tokens, p2.
  REAP lx FROM tok_lex, tok.
  IF lx IS "BY",
    REAP drop FROM consume, tokens, p2.
    REAP p2 FROM _second, drop.
    SEASON TRUE,
      REAP tok FROM peek, tokens, p2.
      REAP lx FROM tok_lex, tok.
      IF lx IS ",",
        REAP drop FROM consume, tokens, p2.
        REAP p2 FROM _second, drop.
      /IF.
      REAP tok FROM peek, tokens, p2.
      REAP lx FROM tok_lex, tok.
      IF lx IS "." OR lx IS "" OR lx IS ",",
        BREAK 0.
      /IF.
      SET fields TO plant_list_push(fields, lx).
      REAP drop FROM consume, tokens, p2.
      REAP p2 FROM _second, drop.
      REAP tok FROM peek, tokens, p2.
      REAP lx2 FROM tok_lex, tok.
      IF lx2 IS "ASC" OR lx2 IS "DESC",
        SET dirs TO plant_list_push(dirs, lx2).
        REAP drop FROM consume, tokens, p2.
        REAP p2 FROM _second, drop.
      /IF.
      IF lx2 ISNT "ASC" AND lx2 ISNT "DESC",
        SET dirs TO plant_list_push(dirs, "").
      /IF.
    /SEASON.
  /IF.
  REAP dot_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(10, "type", "sort_stmt", "target", target, "gdir", gdir, "fields", fields, "dirs", dirs), p3).
/ACTION.

# v0.48.29 — SHAKE l. (Fisher-Yates random reordering)
ACTION parse_shake_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP tpair FROM collect_until, tokens, p2, ".".
  CREATE target TO tpair[0].
  REAP p3 FROM _second, tpair.
  REAP dot_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(4, "type", "shake_stmt", "target", target), p4).
/ACTION.

ACTION parse_break_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  IF p2 < COUNT tokens,
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF lx IS "0",
      REAP drop FROM consume, tokens, p2.
      REAP p2 FROM _second, drop.
    /IF.
  /IF.
  REAP dot_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "break_stmt"), p3).
/ACTION.

ACTION parse_continue_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP dot_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(2, "type", "continue_stmt"), p3).
/ACTION.

ACTION parse_if_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST), emode(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM consume, tokens, p3.
  REAP p4 FROM _second, com.
  # v0.48.35: each branch is its own C block → its own CONST table
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p4.
  CREATE body(LIST) TO plant_list_make(0).
  CREATE cur_cond(TX) TO "".
  CREATE cur_body(LIST) TO plant_list_make(0).
  CREATE elif(LIST) TO plant_list_make(0).
  CREATE else_body(LIST) TO plant_list_make(0).
  CREATE in_elif(TX) TO "0".
  CREATE in_else(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      GIVE plant_list_make(2, plant_list_make(10, "type", "if_stmt", "cond", cond, "body", body, "elif", elif, "else", else_body), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP if_close FROM consume, tokens, p5.
      REAP p6 FROM _second, if_close.
      REAP dot FROM consume, tokens, p6.
      REAP p7 FROM _second, dot.
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      GIVE plant_list_make(2, plant_list_make(10, "type", "if_stmt", "cond", cond, "body", body, "elif", elif, "else", else_body), p7).
    /IF.
    IF lx IS "ORIF",
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      REAP o_pair FROM consume, tokens, p4.
      REAP p5 FROM _second, o_pair.
      REAP ocp FROM collect_until, tokens, p5, ",".
      REAP ocond FROM _first, ocp.
      REAP p6 FROM _second, ocp.
      REAP ocom FROM consume, tokens, p6.
      REAP p7 FROM _second, ocom.
      SET cur_cond TO ocond.
      SET cur_body TO plant_list_make(0).
      SET in_elif TO "1".
      SET in_else TO "0".
      SET p4 TO p7.
      SET ctab TO plant_list_make(0).
      SET bstart TO p7.
      CONTINUE 0.
    /IF.
    IF lx IS "ELSE",
      IF in_elif IS "1",
        PUT cur_cond INTO elif.
        PUT cur_body INTO elif.
      /IF.
      REAP e_pair FROM consume, tokens, p4.
      REAP p5 FROM _second, e_pair.
      SET in_else TO "1".
      SET p4 TO p5.
      SET ctab TO plant_list_make(0).
      SET bstart TO p5.
      CONTINUE 0.
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4, clv, ctab, rtab, bstart, emode.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      IF in_else IS "1",
        PUT stmt INTO else_body.
      /IF.
      IF in_else IS "0",
        IF in_elif IS "1",
          PUT stmt INTO cur_body.
        /IF.
        IF in_elif IS "0",
          PUT stmt INTO body.
        /IF.
      /IF.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_season_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST), emode(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP cpair FROM collect_until, tokens, p2, ",".
  CREATE cond TO cpair[0].
  REAP p3 FROM _second, cpair.
  REAP com FROM consume, tokens, p3.
  REAP p4 FROM _second, com.
  # v0.48.35: the SEASON body is its own C block → own CONST table
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p4.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP season_close FROM consume, tokens, p5.
      REAP p6 FROM _second, season_close.
      REAP dot FROM consume, tokens, p6.
      REAP p7 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(6, "type", "season_stmt", "cond", cond, "body", body), p7).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4, clv, ctab, rtab, bstart, emode.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

# ── CYCLE forms: FROM/TO numeric range (v0.48.21), IN list
#    iteration with optional index (v0.48.22) →
#    cycle_stmt AST node:
#    CYCLE i FROM lo TO hi [STEP k],      → fromExpr/toExpr/stepExpr
#    CYCLE item IN list,                  → listExpr, indexVar ""
#    CYCLE item, idx IN list,             → listExpr + indexVar
# STEP defaults to 1; the STEP clause is detected in the collected
# to-expression text (split on " STEP "); keywords are consumed
# token-wise so nested parens and commas inside expressions survive.
ACTION parse_cycle_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST), emode(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP tok FROM peek, tokens, p2.
  REAP ivar FROM tok_lex, tok.
  REAP cpair FROM consume, tokens, p2.
  REAP p2 FROM _second, cpair.
  CREATE fromExpr(TX) TO "".
  CREATE toExpr(TX) TO "".
  CREATE stepExpr(TX) TO "".
  CREATE listExpr(TX) TO "".
  CREATE indexVar(TX) TO "".
  REAP tok FROM peek, tokens, p2.
  REAP lx FROM tok_lex, tok.
  IF lx IS "FROM",
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP cpair FROM collect_until, tokens, p2, "TO".
    SET fromExpr TO cpair[0].
    REAP p3 FROM _second, cpair.
    REAP cpair FROM consume, tokens, p3.
    REAP p3 FROM _second, cpair.
    REAP cpair FROM collect_until, tokens, p3, ",".
    SET toExpr TO cpair[0].
    REAP p4 FROM _second, cpair.
    REAP sparts FROM strings:SPLIT, toExpr, " STEP ".
    IF COUNT sparts IS 2,
      REAP toExpr FROM plant_list_get, sparts, 0.
      REAP stepExpr FROM plant_list_get, sparts, 1.
      # v0.48.22-patch3: a statically-zero STEP (literal "0" or a
      # constant expression such as "2 - 2") is a compile-time error,
      # intercepted here prior to code emission so it can never
      # compile into a for loop that spins forever.
      REAP sgn FROM _step_sign, stepExpr.
      IF sgn IS "0",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "#error STEP cannot be 0"), p4).
      /IF.
    /IF.
    REAP cpair FROM consume, tokens, p4.
    REAP p4 FROM _second, cpair.
  /IF.
  IF lx IS "IN",
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP cpair FROM collect_until, tokens, p2, ",".
    SET listExpr TO cpair[0].
    REAP p3 FROM _second, cpair.
    REAP cpair FROM consume, tokens, p3.
    REAP p4 FROM _second, cpair.
  /IF.
  IF lx IS ",",
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP tok FROM peek, tokens, p2.
    REAP indexVar FROM tok_lex, tok.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP tok FROM peek, tokens, p2.
    REAP lx2 FROM tok_lex, tok.
    IF lx2 ISNT "IN",
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Expected IN in CYCLE header"), p2).
    /IF.
    REAP cpair FROM consume, tokens, p2.
    REAP p2 FROM _second, cpair.
    REAP cpair FROM collect_until, tokens, p2, ",".
    SET listExpr TO cpair[0].
    REAP p3 FROM _second, cpair.
    REAP cpair FROM consume, tokens, p3.
    REAP p4 FROM _second, cpair.
  /IF.
  IF lx ISNT "FROM" AND lx ISNT "IN" AND lx ISNT ",",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Expected FROM or IN in CYCLE header"), p2).
  /IF.
  # v0.48.35: the CYCLE body is its own C block → own CONST table
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p4.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(16, "type", "cycle_stmt", "iterVar", ivar, "fromExpr", fromExpr, "toExpr", toExpr, "stepExpr", stepExpr, "listExpr", listExpr, "indexVar", indexVar, "body", body), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p4.
      REAP p5 FROM _second, slash.
      REAP cclose FROM consume, tokens, p5.
      REAP p6 FROM _second, cclose.
      REAP dot FROM consume, tokens, p6.
      REAP p7 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(16, "type", "cycle_stmt", "iterVar", ivar, "fromExpr", fromExpr, "toExpr", toExpr, "stepExpr", stepExpr, "listExpr", listExpr, "indexVar", indexVar, "body", body), p7).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p4, clv, ctab, rtab, bstart, emode.
    CREATE stmt TO stmt_pair[0].
    REAP p4 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

# ── THROW <stormtype> ["msg".] → throw_stmt AST node ────────
#    v0.48.23 — raises a storm through the innermost WEATHER
#    checkpoint; the message is an optional expression collected
#    until the terminating ".".
ACTION parse_throw_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP t_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, t_pair.
  REAP stype FROM tok_lex, t_pair[0].
  CREATE msg(TX) TO "".
  REAP tok FROM peek, tokens, p3.
  REAP lx FROM tok_lex, tok.
  IF lx ISNT ".",
    REAP dot2 FROM collect_until, tokens, p3, ".".
    REAP msg FROM _first, dot2.
    REAP p3 FROM _second, dot2.
  /IF.
  REAP dot FROM consume, tokens, p3.
  REAP p4 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(6, "type", "throw_stmt", "storm", stype, "msg", msg), p4).
/ACTION.

# ── STOP IF <condition>. ────────────────────────────────────────
# v0.48.25 — conditional execution halting. The condition is the
# token list up to the terminating "."; a missing or empty condition
# is a syntax error. AST node: stop_if_stmt { cond }.
ACTION parse_stop_if_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP if_pair FROM consume, tokens, p2.
  REAP if_lx FROM tok_lex, if_pair[0].
  REAP p3 FROM _second, if_pair.
  IF if_lx ISNT "IF",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Expected IF after STOP"), p2).
  /IF.
  REAP cond_pair FROM collect_until, tokens, p3, ".".
  CREATE cond TO cond_pair[0].
  REAP p4 FROM _second, cond_pair.
  IF cond IS "" OR cond IS null,
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "STOP IF requires a condition expression"), p3).
  /IF.
  REAP dot FROM consume, tokens, p4.
  REAP p5 FROM _second, dot.
  GIVE plant_list_make(2, plant_list_make(4, "type", "stop_if_stmt", "cond", cond), p5).
/ACTION.

# ── WEATHER … SHELTER [type [AS err]] … CALM … /WEATHER. ────
#    v0.48.23 — WEATHER opens a protected block; every SHELTER
#    clause (optionally typed by a storm identifier, optionally
#    binding the storm message to `AS err`) is a recovery handler;
#    the mandatory terminal CALM clause is the unconditional
#    finalization body. AST node:
#      weather_stmt { body, shelters, calm, exit_list }
#    shelters is a flat [type, bind, body, …] triple list; an
#    untyped SHELTER is stored as the ANY_STORM catch-all.
#    v0.48.37d — every WEATHER node provisions a dedicated local
#    exit-list (exit_list), binding the block to its resource-
#    reclamation structure so the runtime teardown (plant_weather_leave
#    walking the frame's exit-list) runs deterministically on normal
#    completion and exceptional propagation alike.
ACTION parse_weather_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST), emode(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  # v0.48.35: one CONST table + scan range for the whole protected
  # block (phases share a single lexical wrapper)
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p2.
  REAP tok FROM peek, tokens, p2.
  REAP lx FROM tok_lex, tok.
  IF lx IS ",",
    REAP c_pair FROM consume, tokens, p2.
    REAP p2 FROM _second, c_pair.
  /IF.
  CREATE body(LIST) TO plant_list_make(0).
  CREATE shelters(LIST) TO plant_list_make(0).
  CREATE calm_body(LIST) TO plant_list_make(0).
  CREATE cur_type(TX) TO "ANY_STORM".
  CREATE cur_bind(TX) TO "".
  CREATE cur_body(LIST) TO plant_list_make(0).
  CREATE phase(TX) TO "body".
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Unterminated WEATHER block (missing /WEATHER.)"), p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p2.
      REAP p3 FROM _second, slash.
      REAP cclose FROM consume, tokens, p3.
      REAP p4 FROM _second, cclose.
      REAP clx FROM tok_lex, cclose[0].
      IF clx ISNT "WEATHER",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Expected /WEATHER. to close WEATHER block"), p2).
      /IF.
      REAP dot FROM consume, tokens, p4.
      REAP p5 FROM _second, dot.
      IF phase IS "calm",
        GIVE plant_list_make(2, plant_list_make(10, "type", "weather_stmt", "body", body, "shelters", shelters, "calm", calm_body, "exit_list", plant_list_make(0)), p5).
      /IF.
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "WEATHER block missing CALM clause (mandatory finalization)"), p2).
    /IF.
    IF lx IS "SHELTER",
      IF phase IS "shelter",
        PUT cur_type INTO shelters.
        PUT cur_bind INTO shelters.
        PUT cur_body INTO shelters.
      /IF.
      IF phase IS "calm",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "SHELTER after CALM in WEATHER block"), p2).
      /IF.
      REAP s_pair FROM consume, tokens, p2.
      REAP p3 FROM _second, s_pair.
      CREATE stype(TX) TO "ANY_STORM".
      CREATE sbind(TX) TO "".
      REAP tok2 FROM peek, tokens, p3.
      REAP lx2 FROM tok_lex, tok2.
      IF lx2 ISNT ",",
        REAP t_pair FROM consume, tokens, p3.
        REAP p3 FROM _second, t_pair.
        REAP stype FROM tok_lex, t_pair[0].
        REAP tok3 FROM peek, tokens, p3.
        REAP lx3 FROM tok_lex, tok3.
        IF lx3 IS "AS",
          REAP a_pair FROM consume, tokens, p3.
          REAP p3 FROM _second, a_pair.
          REAP b_pair FROM consume, tokens, p3.
          REAP p3 FROM _second, b_pair.
          REAP sbind FROM tok_lex, b_pair[0].
        /IF.
      /IF.
      REAP tok4 FROM peek, tokens, p3.
      REAP lx4 FROM tok_lex, tok4.
      IF lx4 IS ",",
        REAP cm_pair FROM consume, tokens, p3.
        REAP p3 FROM _second, cm_pair.
      /IF.
      SET cur_type TO stype.
      SET cur_bind TO sbind.
      SET cur_body TO plant_list_make(0).
      SET phase TO "shelter".
      SET p2 TO p3.
      CONTINUE 0.
    /IF.
    IF lx IS "CALM",
      IF phase IS "shelter",
        PUT cur_type INTO shelters.
        PUT cur_bind INTO shelters.
        PUT cur_body INTO shelters.
      /IF.
      IF phase IS "calm",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "Multiple CALM clauses in WEATHER block"), p2).
      /IF.
      REAP c_pair FROM consume, tokens, p2.
      REAP p3 FROM _second, c_pair.
      REAP tok2 FROM peek, tokens, p3.
      REAP lx2 FROM tok_lex, tok2.
      IF lx2 IS ",",
        REAP cm_pair FROM consume, tokens, p3.
        REAP p3 FROM _second, cm_pair.
      /IF.
      SET calm_body TO plant_list_make(0).
      SET phase TO "calm".
      SET p2 TO p3.
      CONTINUE 0.
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p2, clv, ctab, rtab, bstart, emode.
    CREATE stmt TO stmt_pair[0].
    REAP p2 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      IF phase IS "shelter",
        PUT stmt INTO cur_body.
      /IF.
      IF phase IS "body",
        PUT stmt INTO body.
      /IF.
      IF phase IS "calm",
        PUT stmt INTO calm_body.
      /IF.
    /IF.
  /SEASON.
/ACTION.

# v0.48.33 — clv threads the active LISTEN request variable through
#   the statement loops so GIVE ... AS RESPONSE. can bind to it.
# v0.48.35 — ctab (current block's CONST table), rtab (module ROOT
#   table), bstart (token position where the current block's body
#   begins — the use-before-definition scan range) and emode
#   ("1" inside ROOT_SCOPE: CONST is elevated to ROOT) join the
#   threading.
ACTION parse_statement(tokens(LIST), pos(NUM), clv(TX), ctab(LIST), rtab(LIST), bstart(NUM), emode(TX)),
  SEASON TRUE,
    REAP tok FROM peek, tokens, pos.
    REAP tp FROM tok_type, tok.
    IF tp ISNT "DEPTH", BREAK 0. /IF.
    REAP drop_pair FROM consume, tokens, pos.
    REAP pos FROM _second, drop_pair.
  /SEASON.
  REAP tok FROM peek, tokens, pos.
  REAP lx FROM tok_lex, tok.
  IF lx IS "CONST",
    REAP r FROM parse_const_like, tokens, pos, ctab, rtab, bstart, emode, "const_stmt".
    GIVE r.
  /IF.
  IF lx IS "ROOT",
    REAP r FROM parse_const_like, tokens, pos, ctab, rtab, bstart, "1", "root_stmt".
    GIVE r.
  /IF.
  IF lx IS "ROOT_SCOPE",
    REAP r FROM parse_root_scope_stmt, tokens, pos, clv, rtab.
    GIVE r.
  /IF.
  IF lx IS "CREATE",
    REAP r FROM parse_create_stmt, tokens, pos, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "SHOW",
    REAP r FROM parse_show_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "NOW",
    REAP r FROM parse_now_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ANALYZE",
    REAP r FROM parse_analyze_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "TYPEOF",
    REAP r FROM parse_typeof_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "FREE",
    REAP r FROM parse_free_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "WAIT",
    REAP r FROM parse_wait_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "LOCK",
    REAP r FROM parse_lock_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ARC",
    REAP r FROM parse_arc_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "FAST",
    REAP r FROM parse_fast_reset_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "GIVE",
    REAP r FROM parse_give_stmt, tokens, pos, clv.
    GIVE r.
  /IF.
  IF lx IS "SET",
    REAP r FROM parse_set_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "INCREASE",
    REAP r FROM parse_incdec_stmt, tokens, pos, "increase".
    GIVE r.
  /IF.
  IF lx IS "DECREASE",
    REAP r FROM parse_incdec_stmt, tokens, pos, "decrease".
    GIVE r.
  /IF.
  IF lx IS "LET",
    REAP r FROM parse_let_stmt, tokens, pos, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "IF",
    REAP r FROM parse_if_stmt, tokens, pos, clv, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "SEASON",
    REAP r FROM parse_season_stmt, tokens, pos, clv, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "CYCLE",
    REAP r FROM parse_cycle_stmt, tokens, pos, clv, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "WEATHER",
    REAP r FROM parse_weather_stmt, tokens, pos, clv, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "THROW",
    REAP r FROM parse_throw_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "STOP",
    REAP r FROM parse_stop_if_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "REAP",
    REAP r FROM parse_reap_stmt, tokens, pos, rtab, emode.
    GIVE r.
  /IF.
  IF lx IS "PUT",
    REAP r FROM parse_put_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "TAKE",
    REAP r FROM parse_take_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "BRAID",
    REAP r FROM parse_braid_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "LINK",
    REAP r FROM parse_link_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "BREAK",
    REAP r FROM parse_break_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "CONTINUE",
    REAP r FROM parse_continue_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "AWAIT",
    REAP r FROM parse_await_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "START",
    REAP r FROM parse_start_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ASYNC",
    REAP r FROM parse_async_in_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "CANCEL",
    REAP r FROM parse_cancel_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "TRACE",
    REAP r FROM parse_trace_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SORT",
    REAP r FROM parse_sort_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "SHAKE",
    REAP r FROM parse_shake_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "HARVEST",
    REAP r FROM parse_harvest_stmt, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "LISTEN",
    REAP r FROM parse_listen_stmt, tokens, pos.
    GIVE r.
  /IF.
  # bare call: IDENT( or module:IDENT( → call_stmt (void FFI calls)
  REAP nx FROM peek, tokens, pos + 1.
  REAP nx_ty FROM tok_type, nx.
  IF nx_ty IS "LPAREN",
    REAP r FROM parse_call_stmt, tokens, pos, rtab, emode.
    GIVE r.
  /IF.
  REAP nx2 FROM peek, tokens, pos + 1.
  REAP nx2_ty FROM tok_type, nx2.
  IF nx2_ty IS "COLON",
    REAP nx3 FROM peek, tokens, pos + 2.
    REAP nx3_ty FROM tok_type, nx3.
    IF nx3_ty IS "LPAREN",
      REAP r FROM parse_call_stmt, tokens, pos, rtab, emode.
      GIVE r.
    /IF.
  /IF.
  GIVE plant_list_make(2, null, pos + 1).
/ACTION.

# collect_until_keyword: collects text until ANY token in kws at
# depth=0 (does NOT consume it); identical to collect_until but the
# terminator is a list of keywords instead of a single delimiter
# (v0.48.32, for HARVEST options).
ACTION collect_until_keyword(tokens(LIST), start(NUM), kws(LIST)),
  CREATE text(TX) TO "".
  CREATE p2(NUM) TO start.
  CREATE depth(NUM) TO 0.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, text, p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    REAP tt FROM tok_type, tok.
    IF tt IS "STRING" OR tt IS "INTERP",
      REAP lx FROM escape_string, lx.
      SET lx TO "\"" + lx + "\"".
    /IF.
    CREATE kw_hit(TX) TO "0".
    CREATE ki(NUM) TO 0.
    SEASON ki < COUNT kws,
      REAP kw FROM plant_list_get, kws, ki.
      IF _cat("", lx) IS _cat("", kw) AND depth IS 0,
        SET kw_hit TO "1".
      /IF.
      SET ki TO ki + 1.
    /SEASON.
    IF kw_hit IS "1",
      GIVE plant_list_make(2, text, p2).
    /IF.
    IF lx IS "(", SET depth TO depth + 1. /IF.
    IF lx IS ")", SET depth TO depth - 1. /IF.
    IF text > "", SET text TO text + " ". /IF.
    SET text TO text + lx.
    REAP drop FROM consume, tokens, p2.
    REAP p2 FROM _second, drop.
  /SEASON.
/ACTION.

# v0.48.32 — HARVEST url AS resp [METHOD m] [BODY b] [HEADERS h]
#   [TIMEOUT t]. Options may appear in any order after the result
#   name; METHOD defaults to GET. AST: harvest_stmt with url, resp,
#   and the option strings.
ACTION parse_harvest_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP upair FROM collect_until, tokens, p2, "AS".
  CREATE url TO upair[0].
  REAP p3 FROM _second, upair.
  REAP as_pair FROM consume, tokens, p3.
  REAP p4 FROM _second, as_pair.
  CREATE resp(TX) TO "".
  CREATE method(TX) TO "".
  CREATE body(TX) TO "".
  CREATE headers(TX) TO "".
  CREATE timeout(TX) TO "".
  CREATE map(TX) TO "".
  CREATE okws(LIST) TO plant_list_make(6, "METHOD", "BODY", "HEADERS", "TIMEOUT", "MAP", ".").
  REAP rpair FROM collect_until_keyword, tokens, p4, okws.
  SET resp TO rpair[0].
  REAP p4 FROM _second, rpair.
  SEASON TRUE,
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "." OR lx IS "",
      BREAK 0.
    /IF.
    IF lx IS "MAP",
      REAP dropm FROM consume, tokens, p4.
      REAP p4 FROM _second, dropm.
      SET map TO "1".
      CONTINUE 0.
    /IF.
    IF lx IS "METHOD" OR lx IS "BODY" OR lx IS "HEADERS" OR lx IS "TIMEOUT",
      REAP drop FROM consume, tokens, p4.
      REAP p4 FROM _second, drop.
      REAP opair FROM collect_until_keyword, tokens, p4, okws.
      CREATE oval TO opair[0].
      REAP p4 FROM _second, opair.
      IF lx IS "METHOD", SET method TO oval. /IF.
      IF lx IS "BODY", SET body TO oval. /IF.
      IF lx IS "HEADERS", SET headers TO oval. /IF.
      IF lx IS "TIMEOUT", SET timeout TO oval. /IF.
      REAP tok2 FROM peek, tokens, p4.
      REAP lx2 FROM tok_lex, tok2.
      IF lx2 IS ",",
        REAP drop2 FROM consume, tokens, p4.
        REAP p4 FROM _second, drop2.
      /IF.
      CONTINUE 0.
    /IF.
    REAP drop FROM consume, tokens, p4.
    REAP p4 FROM _second, drop.
  /SEASON.
  REAP dot_pair FROM consume, tokens, p4.
  REAP p5 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(16, "type", "harvest_stmt", "url", url, "resp", resp, "method", method, "payload", body, "headers", headers, "timeout", timeout, "map", map), p5).
/ACTION.

# v0.48.33 — LISTEN ON port AS req. opens an HTTP server socket on
#   the given port, waits for ONE client connection, reads and parses
#   the HTTP request into a request MAP stored in req (keys:
#   ok/method/path/headers/body plus an internal sock used by
#   GIVE ... AS RESPONSE.). Binding: the GIVE ... AS RESPONSE.
#   statement replies on the most recent LISTEN in the same block.
#   AST: listen_stmt with port and resp.
ACTION parse_listen_stmt(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP on_pair FROM consume, tokens, p2.
  REAP p3 FROM _second, on_pair.
  CREATE okws2(LIST) TO plant_list_make(3, "AS", ")", ".").
  REAP opair FROM collect_until_keyword, tokens, p3, okws2.
  CREATE port TO opair[0].
  REAP p4 FROM _second, opair.
  REAP as_pair FROM consume, tokens, p4.
  REAP p5 FROM _second, as_pair.
  REAP id_pair FROM consume, tokens, p5.
  REAP reqname FROM tok_lex, id_pair[0].
  REAP p6 FROM _second, id_pair.
  REAP dot_pair FROM consume, tokens, p6.
  REAP p7 FROM _second, dot_pair.
  GIVE plant_list_make(2, plant_list_make(6, "type", "listen_stmt", "port", port, "resp", reqname), p7).
/ACTION.

#── Declaration parsing ────────────────────────────────────────

ACTION parse_enum_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP name FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  REAP lbr FROM consume, tokens, p3.
  REAP p4 FROM _second, lbr.
  CREATE members(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "}",
      REAP rbr FROM consume, tokens, p4.
      REAP p5 FROM _second, rbr.
      GIVE plant_list_make(2, plant_list_make(6, "type", "enum_decl", "name", name, "members", members), p5).
    /IF.
    REAP m_pair FROM consume, tokens, p4.
    REAP mname FROM tok_lex, m_pair[0].
    REAP p5 FROM _second, m_pair.
    PUT mname INTO members.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
/ACTION.

ACTION parse_struct_decl(tokens(LIST), pos(NUM)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP sname FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  # generic type parameter list: [T, U] right after the struct name
  CREATE generics(LIST) TO plant_list_make(0).
  REAP sg_tok FROM peek, tokens, p3.
  REAP sg_lx FROM tok_lex, sg_tok.
  IF sg_lx IS "[",
    REAP sg_lb FROM consume, tokens, p3.
    REAP p3 FROM _second, sg_lb.
    REAP sgv FROM collect_type_text, tokens, p3, "]", 0.
    REAP sgtext FROM _first, sgv.
    REAP p3 FROM _second, sgv.
    REAP sg_rb FROM consume, tokens, p3.
    REAP p3 FROM _second, sg_rb.
    REAP sgparts FROM strings:SPLIT, sgtext, ",".
    CREATE sgi(NUM) TO 0.
    CREATE sge(TX) TO "".
    SEASON sgi < COUNT sgparts,
      REAP sge FROM plant_list_get, sgparts, sgi.
      REAP sget FROM trim, sge.
      IF sget > "",
        PUT sget INTO generics.
      /IF.
      SET sgi TO sgi + 1.
    /SEASON.
  /IF.
  REAP lb FROM consume, tokens, p3.
  REAP p4 FROM _second, lb.
  CREATE fields(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(8, "type", "struct_decl", "name", sname, "generics", generics, "fields", fields), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    IF lx IS "}",
      REAP rb FROM consume, tokens, p4.
      REAP p5 FROM _second, rb.
      GIVE plant_list_make(2, plant_list_make(8, "type", "struct_decl", "name", sname, "generics", generics, "fields", fields), p5).
    /IF.
    REAP fn_pair FROM consume, tokens, p4.
    REAP fname FROM tok_lex, fn_pair[0].
    REAP p5 FROM _second, fn_pair.
    REAP col_pair FROM consume, tokens, p5.
    REAP p6 FROM _second, col_pair.
    REAP ftv FROM collect_type_text, tokens, p6, "}", 1.
    REAP ftype FROM _first, ftv.
    REAP p7 FROM _second, ftv.
    REAP ftypet FROM trim, ftype.
    PUT plant_list_make(4, "name", fname, "type", ftypet) INTO fields.
    REAP tok2 FROM peek, tokens, p7.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS ",",
      REAP com FROM consume, tokens, p7.
      REAP p7 FROM _second, com.
    /IF.
    SET p4 TO p7.
  /SEASON.
/ACTION.

ACTION parse_action_decl(tokens(LIST), pos(NUM), rtab(LIST)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP name_pair FROM consume, tokens, p2.
  REAP aname FROM tok_lex, name_pair[0].
  REAP p3 FROM _second, name_pair.
  # v0.48.33: active LISTEN request variable for GIVE ... AS RESPONSE.
  CREATE clv(TX) TO "".
  # async priority modifier (default NORMAL=1)
  CREATE prio(TX) TO "1".
  # v0.48.15: mission mode (default BALANCED; WITH MISSION FAST/SAFE)
  CREATE mission_mode(TX) TO "BALANCED".
  # generic type parameter list: [T, U] right after the action name
  CREATE generics(LIST) TO plant_list_make(0).
  REAP ga_tok FROM peek, tokens, p3.
  REAP ga_lx FROM tok_lex, ga_tok.
  IF ga_lx IS "[",
    REAP ga_lb FROM consume, tokens, p3.
    REAP p3 FROM _second, ga_lb.
    REAP gv FROM collect_type_text, tokens, p3, "]", 0.
    REAP gtext FROM _first, gv.
    REAP p3 FROM _second, gv.
    REAP ga_rb FROM consume, tokens, p3.
    REAP p3 FROM _second, ga_rb.
    REAP gparts FROM strings:SPLIT, gtext, ",".
    CREATE gi2(NUM) TO 0.
    CREATE ge2(TX) TO "".
    SEASON gi2 < COUNT gparts,
      REAP ge2 FROM plant_list_get, gparts, gi2.
      REAP ge2t FROM trim, ge2.
      IF ge2t > "",
        PUT ge2t INTO generics.
      /IF.
      SET gi2 TO gi2 + 1.
    /SEASON.
  /IF.
  REAP lp FROM consume, tokens, p3.
  REAP p4 FROM _second, lp.
  CREATE params(LIST) TO plant_list_make(0).
  CREATE vararg(TX) TO "0".
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p4.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", plant_list_make(0), "prio", prio, "ret", "", "mission_mode", mission_mode), p4).
    /IF.
    REAP tok FROM peek, tokens, p4.
    REAP lx FROM tok_lex, tok.
    # v0.48.4: variadic marker "..." — lexer yields DOT_DOT+DOT or
    # DOT DOT DOT
    IF lx IS "..",
      REAP tokv2 FROM peek, tokens, p4 + 1.
      REAP lxv2 FROM tok_lex, tokv2.
      IF lxv2 IS ".",
        SET vararg TO "1".
        SET p4 TO p4 + 2.
        REAP ctok2 FROM peek, tokens, p4.
        REAP clx2 FROM tok_lex, ctok2.
        IF clx2 IS ")", SET p4 TO p4 + 1. /IF.
        IF clx2 IS ",", SET p4 TO p4 + 2. /IF.
        SET p5 TO p4.
        BREAK 0.
      /IF.
    /IF.
    IF lx IS ".",
      REAP tokv2 FROM peek, tokens, p4 + 1.
      REAP lxv2 FROM tok_lex, tokv2.
      IF lxv2 IS "..",
        SET vararg TO "1".
        SET p4 TO p4 + 2.
        REAP ctok2 FROM peek, tokens, p4.
        REAP clx2 FROM tok_lex, ctok2.
        IF clx2 IS ")", SET p4 TO p4 + 1. /IF.
        IF clx2 IS ",", SET p4 TO p4 + 2. /IF.
        SET p5 TO p4.
        BREAK 0.
      /IF.
      IF lxv2 IS ".",
        REAP tokv3 FROM peek, tokens, p4 + 2.
        REAP lxv3 FROM tok_lex, tokv3.
        IF lxv3 IS ".",
          SET vararg TO "1".
          SET p4 TO p4 + 3.
          REAP ctok2 FROM peek, tokens, p4.
          REAP clx2 FROM tok_lex, ctok2.
          IF clx2 IS ")", SET p4 TO p4 + 1. /IF.
          IF clx2 IS ",", SET p4 TO p4 + 2. /IF.
          SET p5 TO p4.
          BREAK 0.
        /IF.
      /IF.
    /IF.
    IF lx IS ")",
      REAP rp FROM consume, tokens, p4.
      REAP p5 FROM _second, rp.
      CREATE brk(NUM) TO 0.
      BREAK 0.
    /IF.
    REAP pn_pair FROM consume, tokens, p4.
    REAP pn FROM tok_lex, pn_pair[0].
    REAP p5 FROM _second, pn_pair.
    REAP tok2 FROM peek, tokens, p5.
    REAP lx2 FROM tok_lex, tok2.
    IF lx2 IS "(",
      REAP lp2 FROM consume, tokens, p5.
      REAP p6 FROM _second, lp2.
      # collect the full type text: T, LIST[T], REF NUM, REF LIST[T] …
      REAP ptv FROM collect_type_text, tokens, p6, ")", 1.
      REAP pt FROM _first, ptv.
      REAP p7 FROM _second, ptv.
      # normalize pointer markers: "void *" → "void*" (lexer splits *)
      REAP pt FROM strings:REPLACE, pt, " *", "*".
      REAP pt FROM strings:REPLACE, pt, "* ", "*".
      # consume the closing ")" of the type group
      REAP rp2 FROM consume, tokens, p7.
      REAP p7 FROM _second, rp2.
      PUT plant_list_make(4, "name", pn, "type", pt) INTO params.
      SET p5 TO p7.
    /IF.
    IF lx2 ISNT "(",
      PUT plant_list_make(4, "name", pn, "type", "") INTO params.
    /IF.
    REAP tok3 FROM peek, tokens, p5.
    REAP lx3 FROM tok_lex, tok3.
    IF lx3 IS ",",
      REAP com FROM consume, tokens, p5.
      REAP p5 FROM _second, com.
    /IF.
    SET p4 TO p5.
  /SEASON.
  # skip optional -> Type (then check if , or .)
  CREATE ret(TX) TO "".
  REAP arrow_tok FROM peek, tokens, p5.
  REAP arrow_lx FROM tok_lex, arrow_tok.
  IF arrow_lx IS "->",
    REAP arrow_pair FROM consume, tokens, p5.
    REAP p5 FROM _second, arrow_pair.
    # skip bogus MINUS=- token (lexer bug: -> produces extra MINUS)
    REAP skip_tok FROM peek, tokens, p5.
    REAP skip_ty FROM tok_type, skip_tok.
    IF skip_ty IS "MINUS",
      REAP skip_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, skip_pair.
    /IF.
    REAP ret_pair FROM consume, tokens, p5.
    REAP ret_lx FROM tok_lex, ret_pair[0].
    REAP p5 FROM _second, ret_pair.
    # v0.48.4: FFI return types — external (default), Result<T,E>,
    # STRUCT X (by-value struct), void*
    IF ret_lx IS "Result", SET ret TO "Result". /IF.
    IF ret_lx IS "STRUCT",
      REAP rtv FROM collect_type_text, tokens, p5, ".", 0.
      REAP rtt FROM _first, rtv.
      REAP p5 FROM _second, rtv.
      SET ret TO "STRUCT " + rtt.
    /IF.
    # v0.48.12: ENUM X — FFI boundary enums (raw member ints in C,
    # wrapped with _from_enum on the PlantLang side)
    IF ret_lx IS "ENUM",
      REAP rtv FROM collect_type_text, tokens, p5, ".", 0.
      REAP rtt FROM _first, rtv.
      REAP p5 FROM _second, rtv.
      SET ret TO "ENUM " + rtt.
    /IF.
    IF ret_lx IS "void",
      REAP vst FROM peek, tokens, p5.
      REAP vsl FROM tok_lex, vst.
      IF vsl IS "*",
        REAP vsp FROM consume, tokens, p5.
        REAP p5 FROM _second, vsp.
        SET ret TO "void*".
      /IF.
    /IF.
    # Result<T, E> generics: -> Result<NUM, TX>. (E = TX error string)
    IF ret_lx IS "Result",
      REAP lt_tok FROM peek, tokens, p5.
      REAP lt_lx FROM tok_lex, lt_tok.
      IF lt_lx IS "<",
        REAP lt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, lt_pair.
        REAP rt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, rt_pair.
        REAP rc_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, rc_pair.
        REAP re_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, re_pair.
        REAP gt_pair FROM consume, tokens, p5.
        REAP p5 FROM _second, gt_pair.
      /IF.
    /IF.
    # v0.48.13: plain return types (T, NUM, TX, enum names…) are
    # stored on the action_decl node so generic instantiations know
    # their substituted return type (drives _from_long wrapping of
    # numeric GIVEs). FFI marker keywords are never stored here.
    IF ret IS "" AND ret_lx ISNT "external" AND ret_lx ISNT "Result" AND ret_lx ISNT "STRUCT" AND ret_lx ISNT "ENUM" AND ret_lx ISNT "void",
      SET ret TO ret_lx.
    /IF.
  /IF.
  # optional PRIORITY HIGH|NORMAL|LOW modifier (async actions)
  REAP pr_tok FROM peek, tokens, p5.
    REAP pr_lx FROM tok_lex, pr_tok.
    IF pr_lx IS "PRIORITY",
      REAP pr_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, pr_pair.
      REAP lv_pair FROM consume, tokens, p5.
      REAP lv_lx FROM tok_lex, lv_pair[0].
      REAP p5 FROM _second, lv_pair.
      IF lv_lx IS "HIGH", SET prio TO "0". /IF.
      IF lv_lx IS "NORMAL", SET prio TO "1". /IF.
      IF lv_lx IS "LOW", SET prio TO "2". /IF.
    /IF.
    # v0.48.15: WITH MISSION <MODE> — FAST (bump heap) / SAFE (boundary
    # guarded) / BALANCED (default). Optional; comes after PRIORITY.
    REAP wm_tok FROM peek, tokens, p5.
    REAP wm_lx FROM tok_lex, wm_tok.
    IF wm_lx IS "WITH",
      REAP wm_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, wm_pair.
      REAP ms_pair FROM consume, tokens, p5.
      REAP ms_lx FROM tok_lex, ms_pair[0].
      REAP p5 FROM _second, ms_pair.
      IF ms_lx IS "MISSION",
        REAP md_pair FROM consume, tokens, p5.
        REAP md_lx FROM tok_lex, md_pair[0].
        REAP p5 FROM _second, md_pair.
        SET mission_mode TO md_lx.
      /IF.
    /IF.
    REAP after_tok FROM peek, tokens, p5.
    REAP after_lx FROM tok_lex, after_tok.
    IF after_lx IS ",",
      REAP com_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, com_pair.
    /IF.
    IF after_lx IS ".",
      REAP dot_pair FROM consume, tokens, p5.
      REAP p5 FROM _second, dot_pair.
      IF ret_lx IS "external" OR ret_lx IS "Result" OR ret_lx IS "STRUCT" OR ret_lx IS "ENUM" OR ret IS "void*",
        GIVE plant_list_make(2, plant_list_make(10, "type", "external_decl", "name", aname, "params", params, "ret", ret, "varargs", vararg), p5).
      /IF.
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", plant_list_make(0), "prio", prio, "ret", ret, "mission_mode", mission_mode), p5).
    /IF.
  # v0.48.35: each action body has its own CONST table
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO p5.
  CREATE body(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p5.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", body, "prio", prio, "ret", ret, "mission_mode", mission_mode), p5).
    /IF.
    REAP tok4 FROM peek, tokens, p5.
    REAP lx4 FROM tok_lex, tok4.
    IF lx4 IS "/",
      REAP slash FROM consume, tokens, p5.
      REAP p6 FROM _second, slash.
      REAP end FROM consume, tokens, p6.
      REAP p7 FROM _second, end.
      REAP dot FROM consume, tokens, p7.
      REAP p8 FROM _second, dot.
      GIVE plant_list_make(2, plant_list_make(16, "type", "action_decl", "name", aname, "generics", generics, "params", params, "body", body, "prio", prio, "ret", ret, "mission_mode", mission_mode), p8).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p5, clv, ctab, rtab, bstart, "0".
    CREATE stmt TO stmt_pair[0].
    REAP p5 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      IF sty IS "listen_stmt",
        REAP slv FROM _map_get, stmt, "resp".
        SET clv TO slv.
      /IF.
      PUT stmt INTO body.
    /IF.
  /SEASON.
/ACTION.

ACTION parse_declaration(tokens(LIST), pos(NUM), clv(TX), ctab(LIST), rtab(LIST), bstart(NUM)),
  REAP tok FROM peek, tokens, pos.
  REAP lx FROM tok_lex, tok.
  IF lx IS "ENUM",
    REAP r FROM parse_enum_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "STRUCT",
    REAP r FROM parse_struct_decl, tokens, pos.
    GIVE r.
  /IF.
  IF lx IS "ACTION",
    REAP r FROM parse_action_decl, tokens, pos, rtab.
    GIVE r.
  /IF.
  IF lx IS "ASYNC",
    REAP pair FROM peek, tokens, pos + 1.
    REAP nx FROM tok_lex, pair.
    IF nx IS "IN",
      REAP r FROM parse_async_in_stmt, tokens, pos.
      GIVE r.
    /IF.
    REAP r FROM parse_action_decl, tokens, pos + 1, rtab.
    REAP nd FROM _first, r.
    REAP np FROM _second, r.
    REAP nt FROM _map_get, nd, "type".
    IF nt IS "action_decl",
      REAP nd2 FROM map_add, nd, "async", "1".
      GIVE plant_list_make(2, nd2, np).
    /IF.
    GIVE r.
  /IF.
  IF lx IS "MISSION",
    REAP r FROM parse_mission_stmt, tokens, pos.
    GIVE r.
  /IF.
  REAP r FROM parse_statement, tokens, pos, clv, ctab, rtab, bstart, "0".
  GIVE r.
/ACTION.

# map_add: append a key/value pair to a flat map list
ACTION map_add(m(LIST), k(TX), v(TX)),
  CREATE out(LIST) TO plant_list_make(0).
  CREATE mi3(NUM) TO 0.
  SEASON mi3 < COUNT m,
    REAP me3 FROM plant_list_get, m, mi3.
    PUT me3 INTO out.
    SET mi3 TO mi3 + 1.
  /SEASON.
  PUT k INTO out.
  PUT v INTO out.
  GIVE out.
/ACTION.

# ── Constant symbol tables (v0.48.35) ─────────────────────────
#   Two flat pairs-list tables live in the parser:
#     ctab — the CURRENT block's local CONST names+values
#     rtab — the module-wide ROOT table (ROOT + ROOT_SCOPE consts)
#   Lookup follows the language rule: a block's own table shadows
#   the global root table (local-first), which the emitted C
#   reproduces naturally (block-scoped static const over file-scope
#   static const). Tables are used at parse time for redeclaration
#   rejection and use-before-definition detection only; the codegen
#   performs its own first-pass collection for the actual ROOT
#   emission.

# tab_has: "1" when a flat pairs-list table contains key (step 2 so
# values can never be mistaken for names)
ACTION tab_has(tab(LIST), key(TX)),
  CREATE ti4(NUM) TO 0.
  CREATE te4(TX) TO "".
  SEASON ti4 < COUNT tab,
    REAP te4 FROM plant_list_get, tab, ti4.
    IF str_eq(te4, key) IS "1",
      GIVE "1".
    /IF.
    SET ti4 TO ti4 + 2.
  /SEASON.
  GIVE "0".
/ACTION.

# scan_ident_used: "1" when an IDENT token equal to name appears in
# tokens[start, end). Used to reject local-const use-before-definition
# in the enclosing block. String tokens are never IDENT so quoted
# text cannot false-positive; keyword lexemes compare unequal to
# identifiers, so CONST names (which must be plain identifiers) are
# matched exactly.
ACTION scan_ident_used(tokens(LIST), start(NUM), end(NUM), name(TX)),
  CREATE si3(NUM) TO start.
  CREATE stk3(TX) TO "".
  CREATE stt3(TX) TO "".
  SEASON si3 < end,
    REAP stk3 FROM peek, tokens, si3.
    REAP stt3 FROM tok_type, stk3.
    IF stt3 IS "IDENT",
      REAP slx3 FROM tok_lex, stk3.
      IF str_eq(slx3, name) IS "1",
        GIVE "1".
      /IF.
    /IF.
    SET si3 TO si3 + 1.
  /SEASON.
  GIVE "0".
/ACTION.

# v0.48.35 — CONST name TO "literal". / ROOT name TO "literal".
# Shared kernel. ntype is "const_stmt" (local constant; or elevated
# to a root constant when elevate="1", e.g. inside ROOT_SCOPE) or
# "root_stmt" (always a global). The value MUST be a single quoted
# string literal — constants become C string initializers, so raw
# expressions are rejected up front with a clean parse error.
# Registration: elevate="1" → rtab (with redeclaration check, no
# use-before-definition scan — ROOT constants are hoisted); else →
# ctab (with same-block redeclaration + use-before-definition
# checks). Returns syntax_error nodes for every violation.
ACTION parse_const_like(tokens(LIST), pos(NUM), ctab(LIST), rtab(LIST), bstart(NUM), elevate(TX), ntype(TX)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  REAP nt FROM peek, tokens, p2.
  REAP nty FROM tok_type, nt.
  IF nty ISNT "IDENT",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "CONST/ROOT requires an identifier name"), p2).
  /IF.
  REAP npr FROM consume, tokens, p2.
  REAP cname FROM tok_lex, npr[0].
  REAP p3 FROM _second, npr.
  REAP ttok FROM peek, tokens, p3.
  REAP tlx FROM tok_lex, ttok.
  IF tlx ISNT "TO",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "CONST/ROOT requires TO after the constant name"), p3).
  /IF.
  REAP tp FROM consume, tokens, p3.
  REAP p4 FROM _second, tp.
  REAP vt FROM peek, tokens, p4.
  REAP vty FROM tok_type, vt.
  IF vty ISNT "STRING",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "CONST/ROOT value must be a quoted string literal"), p4).
  /IF.
  REAP vp FROM consume, tokens, p4.
  REAP vraw FROM tok_lex, vp[0].
  REAP p5 FROM _second, vp.
  REAP esc FROM escape_string, vraw.
  CREATE cval TO "\"" + esc + "\"".
  REAP dt FROM peek, tokens, p5.
  REAP dlx FROM tok_lex, dt.
  IF dlx ISNT ".",
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "CONST/ROOT expects '.' after the value"), p5).
  /IF.
  REAP dp FROM consume, tokens, p5.
  REAP p6 FROM _second, dp.
  IF elevate IS "1",
    IF tab_has(rtab, cname) IS "1",
      CREATE rmsg(TX) TO "ROOT constant already declared: " + cname.
      GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", rmsg), p6).
    /IF.
    PUT cname INTO rtab.
    PUT cval INTO rtab.
    IF ntype IS "const_stmt",
      REAP nd2 FROM map_add, plant_list_make(6, "type", "const_stmt", "name", cname, "value", cval), "root", "1".
      GIVE plant_list_make(2, nd2, p6).
    /IF.
    GIVE plant_list_make(2, plant_list_make(6, "type", "root_stmt", "name", cname, "value", cval), p6).
  /IF.
  # local constant: same-block redeclaration and use-before-definition
  # are both rejected (use-before-definition of a ROOT is legal — the
  # first pass hoists it; a block-scoped CONST is only visible after
  # its declaration point).
  IF tab_has(ctab, cname) IS "1",
    CREATE dmsg(TX) TO "CONST '" + cname + "' is already declared in this block".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", dmsg), p6).
  /IF.
  IF scan_ident_used(tokens, bstart, pos, cname) IS "1",
    CREATE umsg(TX) TO "CONST '" + cname + "' is used before its definition in this block".
    GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", umsg), p6).
  /IF.
  PUT cname INTO ctab.
  PUT cval INTO ctab.
  GIVE plant_list_make(2, plant_list_make(6, "type", "const_stmt", "name", cname, "value", cval), p6).
/ACTION.

# v0.48.35 — ROOT_SCOPE /ROOT_SCOPE. block: every CONST declared
# inside is automatically elevated to a ROOT constant (the const
# parser runs in elevation mode via emode="1", so it registers in
# rtab and skips the use-before-definition scan — hoisted constants
# are order-independent). ROOT directives nested inside are parsed
# as-is and also land in rtab. The wrapper node keeps its body so
# the codegen first pass can walk it and non-constant statements
# (rare) still generate inline.
ACTION parse_root_scope_stmt(tokens(LIST), pos(NUM), clv(TX), rtab(LIST)),
  REAP pair FROM consume, tokens, pos.
  REAP p2 FROM _second, pair.
  CREATE ctab5(LIST) TO plant_list_make(0).
  CREATE body5(LIST) TO plant_list_make(0).
  CREATE bstart5(NUM) TO p2.
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, p2.
    IF is_eof_flag,
      GIVE plant_list_make(2, plant_list_make(4, "type", "root_scope", "body", body5), p2).
    /IF.
    REAP tok FROM peek, tokens, p2.
    REAP lx FROM tok_lex, tok.
    IF lx IS "/",
      REAP slash FROM consume, tokens, p2.
      REAP p3 FROM _second, slash.
      REAP kp FROM consume, tokens, p3.
      REAP klx FROM tok_lex, kp[0].
      REAP p4 FROM _second, kp.
      IF klx ISNT "ROOT_SCOPE",
        GIVE plant_list_make(2, plant_list_make(4, "type", "syntax_error", "msg", "expected /ROOT_SCOPE. to close ROOT_SCOPE block"), p4).
      /IF.
      REAP dp FROM consume, tokens, p4.
      REAP p5 FROM _second, dp.
      GIVE plant_list_make(2, plant_list_make(4, "type", "root_scope", "body", body5), p5).
    /IF.
    REAP stmt_pair FROM parse_statement, tokens, p2, clv, ctab5, rtab, bstart5, "1".
    CREATE stmt TO stmt_pair[0].
    REAP p2 FROM _second, stmt_pair.
    IF stmt > "",
      REAP sty FROM _map_get, stmt, "type".
      IF sty IS "syntax_error",
        GIVE stmt_pair.
      /IF.
      PUT stmt INTO body5.
    /IF.
  /SEASON.
/ACTION.

#── Top-level ──────────────────────────────────────────────────

ACTION parse_program(tokens(LIST)),
  CREATE pos(NUM) TO 0.
  CREATE clv(TX) TO "".
  # v0.48.35: module-wide ROOT table + top-level CONST table. The
  # top-level scan range for use-before-definition starts where the
  # current top-level statement begins (bstart is re-armed each
  # iteration below so ACTION/ENUM/STRUCT token spans never pollute
  # the scan range).
  CREATE rtab(LIST) TO plant_list_make(0).
  CREATE ctab(LIST) TO plant_list_make(0).
  CREATE bstart(NUM) TO 0.
  CREATE nodes(LIST) TO plant_list_make(0).
  SEASON TRUE,
    REAP is_eof_flag FROM is_eof, tokens, pos.
    IF is_eof_flag,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    SET bstart TO pos.
    REAP d_pair FROM parse_declaration, tokens, pos, clv, ctab, rtab, bstart.
    CREATE decl TO d_pair[0].
    REAP pos2 FROM _second, d_pair.
    IF decl > "",
      REAP dty FROM _map_get, decl, "type".
      IF dty IS "syntax_error",
        REAP dmsg FROM _map_get, decl, "msg".
        GIVE plant_list_make(6, "type", "program", "body", nodes, "error", dmsg).
      /IF.
      IF dty IS "listen_stmt",
        REAP plv FROM _map_get, decl, "resp".
        SET clv TO plv.
      /IF.
    /IF.
    IF pos2 <= pos,
      GIVE plant_list_make(4, "type", "program", "body", nodes).
    /IF.
    SET pos TO pos2.
    IF decl > "",
      PUT decl INTO nodes.
    /IF.
  /SEASON.
/ACTION.
