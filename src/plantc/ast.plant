# ═══════════════════════════════════════════════════════════════
#  src/plantc/ast.plant — AST Node definitions & helpers for
#  the self-hosting PlantLang compiler.
#
#  AST nodes are represented as MAP values with a "type" key.
#  Children are stored in LIST values.
# ═══════════════════════════════════════════════════════════════

# ── Factory: make_node(type, value, children) ──────────────
# Creates a generic AST node.
ACTION make_node(ty(TX), val(TX), kids(LIST)),
  GIVE { type: ty, value: val, children: kids }.
/ACTION.

# ── Factory: make_leaf(type, value) ────────────────────────
ACTION make_leaf(ty(TX), val(TX)),
  GIVE make_node(ty, val, []).
/ACTION.

# ── Factory: make_unary(type, op, operand) ─────────────────
ACTION make_unary(ty(TX), op(TX), operand),
  GIVE make_node(ty, op, [operand]).
/ACTION.

# ── Factory: make_binary(type, op, left, right) ────────────
ACTION make_binary(ty(TX), op(TX), left, right),
  GIVE make_node(ty, op, [left, right]).
/ACTION.
