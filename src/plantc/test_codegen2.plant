IMPORT "tokens.plant".
IMPORT "ast.plant".
IMPORT "lexer.plant".
IMPORT "parser.plant".
IMPORT "codegen_c.plant".

CREATE test_ast(LIST) TO [
  { "type": "create_stmt", "target": "x", "var_type": "NUM", "value": "42" },
  { "type": "set_stmt", "target": "x", "value": "x + 1" },
  { "type": "show_stmt", "value": "x" },
  { "type": "give_stmt", "value": "x" },
  { "type": "break_stmt" },
  { "type": "continue_stmt" },
  { "type": "put_stmt", "item": "x", "target": "arr" }
].

# Manually test generate_node for each type
REAP n0 FROM _map_get, test_ast, 0.
REAP gn0 FROM generate_node, n0, 0.
SHOW "create_stmt result:".
SHOW gn0.

REAP n1 FROM _map_get, test_ast, 1.
REAP gn1 FROM generate_node, n1, 0.
SHOW "set_stmt result:".
SHOW gn1.

REAP n2 FROM _map_get, test_ast, 2.
REAP gn2 FROM generate_node, n2, 0.
SHOW "show_stmt result:".
SHOW gn2.

REAP n3 FROM _map_get, test_ast, 3.
REAP gn3 FROM generate_node, n3, 0.
SHOW "give_stmt result:".
SHOW gn3.

REAP n4 FROM _map_get, test_ast, 4.
REAP gn4 FROM generate_node, n4, 0.
SHOW "break_stmt result:".
SHOW gn4.

REAP n5 FROM _map_get, test_ast, 5.
REAP gn5 FROM generate_node, n5, 0.
SHOW "continue_stmt result:".
SHOW gn5.

REAP n6 FROM _map_get, test_ast, 6.
REAP gn6 FROM generate_node, n6, 0.
SHOW "put_stmt result:".
SHOW gn6.
