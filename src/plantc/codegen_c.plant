# ═══════════════════════════════════════════════════════════════
#  src/plantc/codegen_c.plant — PlantLang → C99 Code Generator
#
#  Consumes AST maps produced by src/plantc/parser.plant and
#  emits valid C99 source compatible with <plant_runtime.h>.
#
#  Node types handled:
#    show_stmt, create_stmt, let_stmt, set_stmt, give_stmt,
#    reap_stmt, put_stmt, break_stmt, continue_stmt,
#    if_stmt, season_stmt, cycle_stmt, match_stmt,
#    action_decl, enum_decl, program
# ═══════════════════════════════════════════════════════════════

IMPORT "ast.plant".
PLANT strings.

# ──────────────────────────────────────────────────────────────
#  _substr — extract substring [start, end) from str
# ──────────────────────────────────────────────────────────────
1\ACTION _substr(str(TX), start(NUM), end(NUM)),
2\  CREATE res(TX) TO "".
2\  CREATE idx(NUM) TO start.
2\  SEASON idx < end,
3\    SET res TO res + str[idx].
3\    SET idx TO idx + 1.
2\  /SEASON.
2\  GIVE res.
1\/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_func — translate "KW varname" -> "CFN(varname)"
# ──────────────────────────────────────────────────────────────
1\ACTION _handle_func(expr(TX), kw(TX), cfn(TX)),
2\  REAP parts FROM strings:SPLIT, expr, kw + " ".
2\  IF COUNT parts IS 1, GIVE expr. /IF.
2\  CREATE res(TX) TO parts[0].
2\  CREATE idx(NUM) TO 1.
2\  SEASON idx < COUNT parts,
3\    CREATE cur(TX) TO parts[idx].
3\    CREATE n(NUM) TO LEN(cur).
3\    CREATE pos(NUM) TO 0.
3\    SEASON pos < n AND cur[pos] ISNT " " AND cur[pos] ISNT "+" AND cur[pos] ISNT ")" AND cur[pos] ISNT "(",
4\      SET pos TO pos + 1.
3\    /SEASON.
3\    REAP vname FROM _substr, cur, 0, pos.
3\    REAP rest FROM _substr, cur, pos, n.
3\    SET res TO res + cfn + "(" + vname + ")" + rest.
3\    SET idx TO idx + 1.
2\  /SEASON.
2\  GIVE res.
1\/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_func_paren — translate "LEN(expr)" -> "strlen(expr)"
# ──────────────────────────────────────────────────────────────
1\ACTION _handle_func_paren(expr(TX), kw(TX), cfn(TX)),
2\  REAP parts FROM strings:SPLIT, expr, kw + "(".
2\  IF COUNT parts IS 1, GIVE expr. /IF.
2\  CREATE res(TX) TO parts[0].
2\  CREATE idx(NUM) TO 1.
2\  SEASON idx < COUNT parts,
3\    SET res TO res + cfn + "(" + parts[idx].
3\    SET idx TO idx + 1.
2\  /SEASON.
2\  GIVE res.
1\/ACTION.

# ──────────────────────────────────────────────────────────────
#  translate_expr — PlantLang → C expression translation
# ──────────────────────────────────────────────────────────────
1\ACTION translate_expr(expr(TX)),
2\  CREATE e(TX) TO expr.
2\  REAP e FROM strings:REPLACE, e, "GREATER THAN OR EQUAL", ">=".
2\  REAP e FROM strings:REPLACE, e, "LESS THAN OR EQUAL", "<=".
2\  REAP e FROM strings:REPLACE, e, "GREATER THAN", ">".
2\  REAP e FROM strings:REPLACE, e, "LESS THAN", "<".
2\  REAP e FROM strings:REPLACE, e, "ISNT", "!=".
2\  REAP e FROM strings:REPLACE, e, "STAR_STAR", "**".
2\  REAP e FROM strings:REPLACE, e, " AND ", " && ".
2\  REAP e FROM strings:REPLACE, e, " OR ", " || ".
2\  REAP e FROM strings:REPLACE, e, "NOT ", "!".
2\  REAP e FROM strings:REPLACE, e, " IS ", " == ".
2\  REAP e FROM _handle_func, e, "COUNT", "plant_array_length".
2\  REAP e FROM _handle_func_paren, e, "LEN", "strlen".
2\  REAP e FROM _handle_func, e, "TEST", "!".
2\  REAP e FROM strings:REPLACE, e, "TRUE", "1".
2\  REAP e FROM strings:REPLACE, e, "FALSE", "0".
2\  REAP e FROM strings:REPLACE, e, "NULL", "NULL".
2\  GIVE e.
1\/ACTION.

# ──────────────────────────────────────────────────────────────
#  indent_str — generate indentation whitespace
# ──────────────────────────────────────────────────────────────
1\ACTION indent_str(level(NUM)),
2\  CREATE res(TX) TO "".
2\  CREATE i(NUM) TO 0.
2\  SEASON i < level,
3\    SET res TO res + "  ".
3\    SET i TO i + 1.
2\  /SEASON.
2\  GIVE res.
1\/ACTION.

# ──────────────────────────────────────────────────────────────
#  generate_body — generate C code for a list of AST nodes
# ──────────────────────────────────────────────────────────────
1\ACTION generate_body(bd(LIST), indent(NUM)),
2\  CREATE res(TX) TO "".
2\  CREATE i(NUM) TO 0.
2\  SEASON i < COUNT bd,
3\    REAP node_el FROM _map_get, bd, i.
3\    REAP node_code FROM generate_node, node_el, indent.
3\    IF node_code > "",
4\      SET res TO res + node_code.
3\    /IF.
3\    SET i TO i + 1.
2\  /SEASON.
2\  GIVE res.
1\/ACTION.

# ──────────────────────────────────────────────────────────────
#  generate_node — dispatch AST node by type
# ──────────────────────────────────────────────────────────────
1\ACTION generate_node(node, indent(NUM)),
2\  REAP ntype FROM _map_get, node, "type".
2\
2\  # ── show_stmt: SHOW expr. → plant_print(expr); ────────────
2\  IF ntype IS "show_stmt",
3\    REAP val FROM _map_get, node, "value".
3\    REAP cval FROM translate_expr, val.
3\    REAP isel FROM indent_str, indent.
3\    GIVE isel + "  plant_print(" + cval + ");\n".
2\  /IF.
2\
2\  # ── create_stmt: CREATE var(TYPE) TO val. → long/TX var = val; ─
2\  IF ntype IS "create_stmt",
3\    REAP target FROM _map_get, node, "target".
3\    REAP vtype FROM _map_get, node, "var_type".
3\    REAP val FROM _map_get, node, "value".
3\    REAP cval FROM translate_expr, val.
3\    REAP isel FROM indent_str, indent.
3\    IF vtype IS "NUM",
4\      GIVE isel + "  long " + target + " = " + cval + ";\n".
3\    /IF.
3\    IF vtype IS "FACT",
4\      GIVE isel + "  int " + target + " = " + cval + ";\n".
3\    /IF.
3\    IF vtype ISNT "NUM" AND vtype ISNT "FACT",
4\      GIVE isel + "  tx_t " + target + " = " + cval + ";\n".
3\    /IF.
2\  /IF.
2\
2\  # ── set_stmt: SET target TO val. → target = val; ──────────
2\  IF ntype IS "set_stmt",
3\    REAP target FROM _map_get, node, "target".
3\    REAP val FROM _map_get, node, "value".
3\    REAP cval FROM translate_expr, val.
3\    REAP isel FROM indent_str, indent.
3\    GIVE isel + "  " + target + " = " + cval + ";\n".
2\  /IF.
2\
2\  # ── let_stmt: LET var AS TYPE IS val. → type var = val; ──
2\  IF ntype IS "let_stmt",
3\    REAP target FROM _map_get, node, "target".
3\    REAP vtype FROM _map_get, node, "var_type".
3\    REAP val FROM _map_get, node, "value".
3\    REAP cval FROM translate_expr, val.
3\    REAP isel FROM indent_str, indent.
3\    IF vtype IS "NUM",
4\      GIVE isel + "  long " + target + " = " + cval + ";\n".
3\    /IF.
3\    IF vtype ISNT "NUM",
4\      GIVE isel + "  tx_t " + target + " = " + cval + ";\n".
3\    /IF.
2\  /IF.
2\
2\  # ── give_stmt: GIVE val. → return val; ────────────────────
2\  IF ntype IS "give_stmt",
3\    REAP val FROM _map_get, node, "value".
3\    REAP cval FROM translate_expr, val.
3\    REAP isel FROM indent_str, indent.
3\    GIVE isel + "  return " + cval + ";\n".
2\  /IF.
2\
2\  # ── break_stmt → break; ───────────────────────────────────
2\  IF ntype IS "break_stmt",
3\    REAP isel FROM indent_str, indent.
3\    GIVE isel + "  break;\n".
2\  /IF.
2\
2\  # ── continue_stmt → continue; ─────────────────────────────
2\  IF ntype IS "continue_stmt",
3\    REAP isel FROM indent_str, indent.
3\    GIVE isel + "  continue;\n".
2\  /IF.
2\
2\  # ── put_stmt: PUT item INTO target. → plant_array_push(…) ─
2\  IF ntype IS "put_stmt",
3\    REAP item FROM _map_get, node, "item".
3\    REAP target FROM _map_get, node, "target".
3\    REAP citem FROM translate_expr, item.
3\    REAP isel FROM indent_str, indent.
3\    GIVE isel + "  plant_array_push(" + target + ", " + citem + ");\n".
2\  /IF.
2\
2\  # ── reap_stmt: REAP var FROM action, args. → var = action(…); ─
2\  IF ntype IS "reap_stmt",
3\    REAP tgt FROM _map_get, node, "target".
3\    REAP act FROM _map_get, node, "action".
3\    REAP args FROM _map_get, node, "args".
3\    CREATE argstr(TX) TO "".
3\    CREATE ai(NUM) TO 0.
3\    SEASON ai < COUNT args,
4\      REAP arg_el FROM _map_get, args, ai.
4\      REAP aexpr FROM translate_expr, arg_el.
4\      IF ai > 0, SET argstr TO argstr + ", ". /IF.
4\      SET argstr TO argstr + aexpr.
4\      SET ai TO ai + 1.
3\    /SEASON.
3\    REAP isel FROM indent_str, indent.
3\    IF tgt IS "_",
4\      GIVE isel + "  " + act + "(" + argstr + ");\n".
3\    /IF.
3\    IF tgt ISNT "_",
4\      GIVE isel + "  " + tgt + " = " + act + "(" + argstr + ");\n".
3\    /IF.
2\  /IF.
2\
2\  # ── if_stmt: IF cond, body /IF. ──────────────────────────
2\  IF ntype IS "if_stmt",
3\    REAP cond FROM _map_get, node, "cond".
3\    REAP bd FROM _map_get, node, "body".
3\    REAP ccond FROM translate_expr, cond.
3\    REAP isel FROM indent_str, indent.
3\    CREATE ccode(TX) TO isel + "  if (" + ccond + ") \{\n".
3\    REAP bcode FROM generate_body, bd, indent + 2.
3\    SET ccode TO ccode + bcode + isel + "  \}\n".
3\    GIVE ccode.
2\  /IF.
2\
2\  # ── season_stmt: SEASON cond, body /SEASON. → while(cond) {…} ─
2\  IF ntype IS "season_stmt",
3\    REAP cond FROM _map_get, node, "cond".
3\    REAP bd FROM _map_get, node, "body".
3\    REAP ccond FROM translate_expr, cond.
3\    REAP isel FROM indent_str, indent.
3\    CREATE ccode(TX) TO isel + "  while (" + ccond + ") \{\n".
3\    REAP bcode FROM generate_body, bd, indent + 2.
3\    SET ccode TO ccode + bcode + isel + "  \}\n".
3\    GIVE ccode.
2\  /IF.
2\
2\  # ── cycle_stmt: FROM/TO → for(iter=from; iter<=to; iter+=step) ─
2\  IF ntype IS "cycle_stmt",
3\    REAP ivar FROM _map_get, node, "iterVar".
3\    REAP fromExpr FROM _map_get, node, "fromExpr".
3\    REAP toExpr FROM _map_get, node, "toExpr".
3\    REAP stepExpr FROM _map_get, node, "stepExpr".
3\    REAP listExpr FROM _map_get, node, "listExpr".
3\    REAP indexVar FROM _map_get, node, "indexVar".
3\    REAP bd FROM _map_get, node, "body".
3\    REAP isel FROM indent_str, indent.
3\    CREATE ccode(TX) TO "".
3\
3\    # FROM/TO form
3\    IF fromExpr ISNT "",
4\      REAP cfrom FROM translate_expr, fromExpr.
4\      REAP cto FROM translate_expr, toExpr.
4\      CREATE stepstr(TX) TO "1".
4\      IF stepExpr > "" AND stepExpr ISNT "null",
5\        REAP cstep FROM translate_expr, stepExpr.
5\        SET stepstr TO cstep.
4\      /IF.
4\      SET ccode TO isel + "  for (long " + ivar + " = " + cfrom + "; " + ivar + " <= " + cto + "; " + ivar + " += " + stepstr + ") \{\n".
4\      REAP bcode FROM generate_body, bd, indent + 2.
4\      SET ccode TO ccode + bcode + isel + "  \}\n".
4\      GIVE ccode.
3\    /IF.
3\
3\    # IN list form (CYCLE var IN list)
3\    IF listExpr ISNT "",
4\      CREATE idxvar(TX) TO "__cycle_i".
4\      IF indexVar ISNT "" AND indexVar ISNT "null",
5\        SET idxvar TO indexVar.
4\      /IF.
4\      REAP clist FROM translate_expr, listExpr.
4\      SET ccode TO isel + "  \{\n".
4\      SET ccode TO ccode + isel + "    long " + idxvar + " = 0;\n".
4\      SET ccode TO ccode + isel + "    while (" + idxvar + " < plant_array_length(" + clist + ")) \{\n".
4\      SET ccode TO ccode + isel + "      tx_t " + ivar + " = plant_array_get(" + clist + ", " + idxvar + ");\n".
4\      REAP bcode FROM generate_body, bd, indent + 4.
4\      SET ccode TO ccode + bcode + isel + "      " + idxvar + "++;\n".
4\      SET ccode TO ccode + isel + "    }\n".
4\      SET ccode TO ccode + isel + "  }\n".
4\      GIVE ccode.
3\    /IF.
3\
3\    GIVE "".
2\  /IF.
2\
2\  # ── match_stmt: MATCH expr { Variant -> { stmts } } → switch ─
2\  IF ntype IS "match_stmt",
3\    REAP subj FROM _map_get, node, "subjectExpr".
3\    REAP clauses FROM _map_get, node, "clauses".
3\    REAP csubj FROM translate_expr, subj.
3\    REAP isel FROM indent_str, indent.
3\    CREATE ccode(TX) TO isel + "  switch (" + csubj + ") \{\n".
3\    CREATE ci(NUM) TO 0.
3\    SEASON ci < COUNT clauses,
4\      REAP clause FROM _map_get, clauses, ci.
4\      REAP vname FROM _map_get, clause, "variantName".
4\      REAP binding FROM _map_get, clause, "binding".
4\      REAP cbody FROM _map_get, clause, "bodyStatements".
4\      SET ccode TO ccode + isel + "    case " + vname + ":\n".
4\      IF binding > "" AND binding ISNT "null",
5\        SET ccode TO ccode + isel + "      \{\n".
5\        SET ccode TO ccode + isel + "        tx_t " + binding + " = " + csubj + ";\n".
5\        REAP bcode FROM generate_body, cbody, indent + 4.
5\        SET ccode TO ccode + bcode + isel + "      \}\n".
4\      /IF.
4\      IF binding IS "" OR binding IS "null",
5\        REAP bcode FROM generate_body, cbody, indent + 4.
5\        SET ccode TO ccode + bcode.
4\      /IF.
4\      SET ccode TO ccode + isel + "      break;\n".
4\      SET ci TO ci + 1.
3\    /SEASON.
3\    SET ccode TO ccode + isel + "  \}\n".
3\    GIVE ccode.
2\  /IF.
2\
2\  # ── action_decl: ACTION name(params), body /ACTION. → void name(…) {…} ─
2\  IF ntype IS "action_decl",
3\    REAP aname FROM _map_get, node, "name".
3\    REAP params FROM _map_get, node, "params".
3\    REAP bd FROM _map_get, node, "body".
3\    CREATE paramstr(TX) TO "".
3\    CREATE pi(NUM) TO 0.
3\    SEASON pi < COUNT params,
4\      REAP param_el FROM _map_get, params, pi.
4\      REAP pname FROM _map_get, param_el, "name".
4\      REAP ptype FROM _map_get, param_el, "type".
4\      CREATE ctype(TX) TO "tx_t".
4\      IF ptype IS "NUM", SET ctype TO "long". /IF.
4\      IF ptype IS "FACT", SET ctype TO "int". /IF.
4\      IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
4\      SET paramstr TO paramstr + ctype + " " + pname.
4\      SET pi TO pi + 1.
3\    /SEASON.
3\    CREATE ccode(TX) TO "void " + aname + "(" + paramstr + ") \{\n".
3\    REAP bcode FROM generate_body, bd, 1.
3\    SET ccode TO ccode + bcode + "\}\n".
3\    GIVE ccode.
2\  /IF.
2\
2\  # ── enum_decl: ENUM name { MEMBER, … } → typedef enum { … } name; ─
2\  IF ntype IS "enum_decl",
3\    REAP ename FROM _map_get, node, "name".
3\    REAP members FROM _map_get, node, "members".
3\    CREATE ccode(TX) TO "typedef enum \{\n  ".
3\    CREATE mi(NUM) TO 0.
3\    SEASON mi < COUNT members,
4\      REAP member_el FROM _map_get, members, mi.
4\      IF mi > 0, SET ccode TO ccode + ",\n  ". /IF.
4\      SET ccode TO ccode + member_el.
4\      SET mi TO mi + 1.
3\    /SEASON.
3\    SET ccode TO ccode + "\n\} " + ename + ";\n".
3\    GIVE ccode.
2\  /IF.
2\
2\  # fallback — unhandled node type
2\  GIVE "".
1\/ACTION.

# ──────────────────────────────────────────────────────────────
#  _map_get — safe MAP field access (external FFI)
# ──────────────────────────────────────────────────────────────
1\ACTION _map_get(m, key(TX)) -> external.

# ──────────────────────────────────────────────────────────────
#  generate_c — main entry point
# ──────────────────────────────────────────────────────────────
1\ACTION generate_c(ast(LIST)),
2\  CREATE header(TX) TO "#include <plant_runtime.h>\n#include <string.h>\n\n".
2\  CREATE body_code(TX) TO "".
2\  CREATE i(NUM) TO 0.
2\  SEASON i < COUNT ast,
3\    REAP node_el FROM _map_get, ast, i.
3\    REAP node_code FROM generate_node, node_el, 0.
3\    SET body_code TO body_code + node_code.
3\    SET i TO i + 1.
2\  /SEASON.
2\  GIVE header + body_code.
1\/ACTION.
