# ═══════════════════════════════════════════════════════════════
#  src/plantc/codegen_c.plant — PlantLang → C99 Code Generator
#
#  Consumes AST maps produced by src/plantc/parser.plant and
#  emits valid C99 source compatible with <plant_runtime.h>.
#
#  Node types handled:
#    show_stmt, create_stmt, let_stmt, set_stmt, give_stmt,
#    reap_stmt, put_stmt, break_stmt, continue_stmt,
#    if_stmt, season_stmt, cycle_stmt, match_stmt,
#    action_decl, enum_decl, program, verify_stmt
# ═══════════════════════════════════════════════════════════════

IMPORT "ast.plant".
PLANT strings.

# ──────────────────────────────────────────────────────────────
#  _substr — extract substring [start, end) from str
# ──────────────────────────────────────────────────────────────
ACTION _substr(str(TX), start(NUM), end(NUM)),
    GIVE substring(str, start, end).
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_func — translate "KW varname" -> "CFN(varname)"
# ──────────────────────────────────────────────────────────────
ACTION _handle_func(expr(TX), kw(TX), cfn(TX)),
    REAP parts FROM strings:SPLIT, expr, kw + " ".
    IF COUNT parts IS 1, GIVE expr. /IF.
    REAP p0 FROM plant_list_get, parts, 0.
    CREATE res(TX) TO p0.
    CREATE idx(NUM) TO 1.
    SEASON idx < COUNT parts,
        REAP cur FROM plant_list_get, parts, idx.
        REAP pos FROM find_any, cur, " +)(".
        IF pos IS -1, SET pos TO LEN(cur). /IF.
        REAP vname FROM substring, cur, 0, pos.
        REAP rest FROM substring, cur, pos, LEN(cur).
        SET res TO res + cfn + "(" + vname + ")" + rest.
        SET idx TO idx + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_func_paren — translate "LEN(expr)" -> "strlen(expr)"
# ──────────────────────────────────────────────────────────────
ACTION _handle_func_paren(expr(TX), kw(TX), cfn(TX)),
    REAP parts FROM strings:SPLIT, expr, kw + " (".
    IF COUNT parts IS 1,
        REAP parts FROM strings:SPLIT, expr, kw + "(".
    /IF.
    IF COUNT parts IS 1, GIVE expr. /IF.
    REAP p0 FROM plant_list_get, parts, 0.
    CREATE res(TX) TO p0.
    CREATE idx(NUM) TO 1.
    SEASON idx < COUNT parts,
        REAP p FROM plant_list_get, parts, idx.
        SET res TO res + cfn + "(" + p.
        SET idx TO idx + 1.
    /SEASON.
    GIVE res.
/ACTION.

# _is_num_literal — "1" when s (spaces ignored) is a bare numeric
# literal: optional single leading '-', digits with at most one '.'.
# Used by _wrap_math_args to decide which call arguments need a
# tx_t constructor.
ACTION _is_num_literal(s(TX)),
  CREATE comp(TX) TO "".
  CREATE q(NUM) TO 0.
  CREATE n(NUM) TO LEN(s).
  SEASON q < n,
    REAP cq FROM char_at, s, q.
    IF cq ISNT " ", SET comp TO comp + cq. /IF.
    SET q TO q + 1.
  /SEASON.
  CREATE m(NUM) TO LEN(comp).
  IF m IS 0, GIVE "0". /IF.
  CREATE i(NUM) TO 0.
  IF char_at(comp, 0) IS "-",
    SET i TO 1.
    IF m IS 1, GIVE "0". /IF.
  /IF.
  CREATE digits(NUM) TO 0.
  CREATE dots(NUM) TO 0.
  CREATE ok(NUM) TO 1.
  SEASON i < m,
    REAP c3 FROM char_at, comp, i.
    IF c3 IS ".",
      SET dots TO dots + 1.
      IF dots GREATER THAN 1, SET ok TO 0. /IF.
    /IF.
    IF c3 ISNT "." AND (c3 LESS THAN "0" OR c3 GREATER THAN "9"), SET ok TO 0. /IF.
    IF c3 GREATER THAN OR EQUAL "0" AND c3 LESS THAN OR EQUAL "9", SET digits TO digits + 1. /IF.
    SET i TO i + 1.
  /SEASON.
  IF ok IS 1 AND digits GREATER THAN 0 AND dots LESS THAN 2, GIVE "1". /IF.
  GIVE "0".
/ACTION.

# _wrap_math_args — for every occurrence of cfn( ... ) in e (depth-
# aware scan), split the argument list on top-level commas and wrap
# bare numeric literal arguments in _from_double(...) so decimal
# literals and integers beyond the tagged-int range arrive as valid
# tx_t values. Non-numeric args (variables, nested calls, strings)
# pass through untouched; recurses on the tail so multiple
# occurrences in one expression are all rewritten.
ACTION _wrap_math_args(e(TX), cfn(TX)),
  REAP hpos FROM _find_substr, e, cfn + "(".
  IF hpos IS -1, GIVE e. /IF.
  # _to_long: hpos arrives from a REAP'd user action, so the numeric
  # analyzer cannot prove its type — without the coercion the '+'
  # below lowers to _cat (string concat) and poisons every index
  # computed from it.
  # plant_rw_arg_long: hpos arrives from a REAP'd user action whose
  # GIVE lowers to a raw tagged long — _to_long would deref small
  # pointer values (hpos=1 → atol(*(char*)1) → segfault). The compat
  # converter checks (uintptr_t)v < 4096 first; registered as a known
  # numeric call in seg_is_numeric so '+' stays arithmetic.
  CREATE open(NUM) TO plant_rw_arg_long(hpos) + LEN(cfn).
  CREATE i(NUM) TO open + 1.
  CREATE dep(NUM) TO 1.
  CREATE close(NUM) TO -1.
  SEASON i < LEN(e),
    REAP ch FROM char_at, e, i.
    IF ch IS "(", SET dep TO dep + 1. /IF.
    IF ch IS ")",
      SET dep TO dep - 1.
      IF dep IS 0, SET close TO i. /IF.
      IF dep IS 0, BREAK 0. /IF.
    /IF.
    SET i TO i + 1.
  /SEASON.
  IF close IS -1, GIVE e. /IF.
  REAP inner FROM substring, e, open + 1, close.
  CREATE parts(LIST) TO plant_list_make(0).
  CREATE cur(TX) TO "".
  CREATE d2(NUM) TO 0.
  CREATE k(NUM) TO 0.
  CREATE mm(NUM) TO LEN(inner).
  SEASON k < mm,
    REAP ck FROM char_at, inner, k.
    IF ck IS "(" OR ck IS "[", SET d2 TO d2 + 1. /IF.
    IF ck IS ")" OR ck IS "]", SET d2 TO d2 - 1. /IF.
    IF ck IS "," AND d2 IS 0,
      PUT cur INTO parts.
      SET cur TO "".
    /IF.
    IF ck ISNT "," OR d2 ISNT 0, SET cur TO cur + ck. /IF.
    SET k TO k + 1.
  /SEASON.
  PUT cur INTO parts.
  CREATE res(TX) TO "".
  CREATE idx(NUM) TO 0.
  CREATE cn(NUM) TO COUNT parts.
  SEASON idx < cn,
    REAP p FROM plant_list_get, parts, idx.
    REAP isnum FROM _is_num_literal, p.
    IF idx GREATER THAN 0, SET res TO res + ", ". /IF.
    IF isnum IS "1", SET res TO res + "_from_double(" + p + ")". /IF.
    IF isnum ISNT "1", SET res TO res + p. /IF.
    SET idx TO idx + 1.
  /SEASON.
  REAP head FROM substring, e, 0, open + 1.
  REAP tail FROM substring, e, close, LEN(e).
  REAP rest FROM _wrap_math_args, tail, cfn.
  GIVE head + res + rest.
/ACTION.

# _math_func_paren — math built-ins route through the textual paren
# mapper, then get their bare numeric literal arguments wrapped in
# _from_double(...) (the math_* runtime helpers take tx_t; raw C
# doubles do not compile against them).
ACTION _math_func_paren(expr(TX), kw(TX), cfn(TX)),
  REAP e2 FROM _handle_func_paren, expr, kw, cfn.
  REAP e3 FROM _wrap_math_args, e2, cfn.
  GIVE e3.
/ACTION.

# _trim_sp — leading/trailing space strip (small local helper).
ACTION _trim_sp(s(TX)),
  CREATE st(NUM) TO 0.
  CREATE en(NUM) TO LEN(s) - 1.
  SEASON st <= en,
    REAP c FROM char_at, s, st.
    IF c ISNT " ", BREAK 0. /IF.
    SET st TO st + 1.
  /SEASON.
  SEASON en >= st,
    REAP c2 FROM char_at, s, en.
    IF c2 ISNT " ", BREAK 0. /IF.
    SET en TO en - 1.
  /SEASON.
  IF en < st, GIVE "". /IF.
  GIVE substring(s, st, en + 1).
/ACTION.

# _kw_commacount — top-level comma count inside the first kw( ... )
# argument span, or "-1" when the keyword call is absent. Depth-aware
# across () and [] so list-literal arguments do not inflate the count.
ACTION _kw_commacount(expr(TX), kw(TX)),
  REAP h1 FROM _find_substr, expr, kw + " (".
  CREATE open(NUM) TO -1.
  IF h1 ISNT -1, SET open TO h1 + LEN(kw) + 1. /IF.
  IF open IS -1,
    REAP h2 FROM _find_substr, expr, kw + "(".
    IF h2 ISNT -1, SET open TO h2 + LEN(kw). /IF.
  /IF.
  IF open IS -1, GIVE "-1". /IF.
  CREATE i(NUM) TO open + 1.
  CREATE dep(NUM) TO 1.
  CREATE commas(NUM) TO 0.
  SEASON i < LEN(expr),
    REAP ch FROM char_at, expr, i.
    IF ch IS "(" OR ch IS "[", SET dep TO dep + 1. /IF.
    IF ch IS ")" OR ch IS "]",
      SET dep TO dep - 1.
      IF dep IS 0, BREAK 0. /IF.
    /IF.
    IF ch IS "," AND dep IS 1, SET commas TO commas + 1. /IF.
    SET i TO i + 1.
  /SEASON.
  GIVE _from_long(commas).
/ACTION.

# _stat_paren — arity dispatch for overloaded statistical keywords:
# single argument → the list-aggregation helper; two or more → the
# scalar helper (keeps MIN(a, b)/MAX(a, b)/RANGE(a, b) intact while
# enabling MIN(nums)/MAX(nums)/RANGE(nums)).
ACTION _stat_paren(expr(TX), kw(TX), cscalar(TX), clist(TX)),
  REAP cc FROM _kw_commacount, expr, kw.
  IF cc IS "-1", GIVE expr. /IF.
  IF cc IS "0",
    REAP e3 FROM _math_func_paren, expr, kw, clist.
    GIVE e3.
  /IF.
  IF cc ISNT "0" AND cc ISNT "-1",
    REAP e2 FROM _math_func_paren, expr, kw, cscalar.
    GIVE e2.
  /IF.
/ACTION.

# _handle_range — v0.49.20 infix range shorthand: rewrites the FIRST
# top-level "A .. B" occurrence to plant_range_list(A, B). Depth-
# aware, so dots nested in parens/brackets are untouched; decimal
# literals never form ".." (the lexer consumes them whole). Numeric
# literal bounds are tx_t-coerced via _wrap_math_args afterwards.
ACTION _handle_range(e(TX)),
  CREATE res(TX) TO "".
  SET res TO res + e.
  # repeat: rewrite the first in-range occurrence, splice, rescan
  # (terminates because each splice removes one "..")
  CREATE scanning(FACT) TO TRUE.
  SEASON scanning IS TRUE,
    REAP f FROM _range_once, res.
    IF str_eq(f, res) IS "1", SET scanning TO FALSE. /IF.
    SET res TO f.
  /SEASON.
  GIVE res.
/ACTION.

# _range_once — one splice pass: finds the first ".." outside string
# literals at any bracket depth, walks outward to the enclosing
# argument boundaries (depth-matched ',' '(' ')'), and splices
# plant_range_list(lhs, rhs) in place. Returns e unchanged when no
# range is present (compared via str_eq by the caller).
ACTION _range_once(e(TX)),
  CREATE i(NUM) TO 0.
  CREATE dep(NUM) TO 0.
  CREATE hit(NUM) TO -1.
  CREATE instr(FACT) TO FALSE.
  CREATE wasin(FACT) TO FALSE.
  CREATE qch(TX) TO "\"".
  SEASON i + 1 < LEN(e),
    REAP c3 FROM char_at, e, i.
    SET wasin TO instr.
    IF wasin IS FALSE,
      IF c3 IS "\"", SET instr TO TRUE. /IF.
      IF c3 IS "\"", SET qch TO "\"". /IF.
      IF c3 IS "'", SET instr TO TRUE. /IF.
      IF c3 IS "'", SET qch TO "'". /IF.
    /IF.
    IF wasin IS TRUE,
      IF c3 IS "\\", SET i TO i + 1. /IF.
      REAP isclose FROM str_eq, c3, qch.
      IF isclose IS "1", SET instr TO FALSE. /IF.
    /IF.
    IF instr IS FALSE,
      IF c3 IS "(" OR c3 IS "[", SET dep TO dep + 1. /IF.
      IF c3 IS ")" OR c3 IS "]", SET dep TO dep - 1. /IF.
      IF dep >= 0 AND c3 IS ".",
        REAP c4 FROM char_at, e, i + 1.
        IF c4 IS ".",
          SET hit TO i.
          BREAK 0.
        /IF.
      /IF.
    /IF.
    SET i TO i + 1.
  /SEASON.
  IF hit IS -1, GIVE e. /IF.
  # left boundary: nearest depth-matched '(', '[' or ',' before hit
  CREATE p(NUM) TO hit - 1.
  CREATE cur(NUM) TO dep.
  SEASON p >= 0,
    REAP lc FROM char_at, e, p.
    IF lc IS ")" OR lc IS "]", SET cur TO cur + 1. /IF.
    IF lc IS "(" OR lc IS "[",
      IF cur IS dep, BREAK 0. /IF.
      SET cur TO cur - 1.
    /IF.
    IF lc IS "," AND cur IS dep, BREAK 0. /IF.
    SET p TO p - 1.
  /SEASON.
  CREATE lstart(NUM) TO p + 1.
  # right boundary: nearest depth-matched ',', ')' or ']' after hit+2
  CREATE k(NUM) TO hit + 2.
  CREATE rend(NUM) TO LEN(e).
  CREATE cur2(NUM) TO dep.
  SEASON k < LEN(e),
    REAP rc FROM char_at, e, k.
    IF rc IS "(" OR rc IS "[", SET cur2 TO cur2 + 1. /IF.
    IF rc IS ")" OR rc IS "]",
      IF cur2 IS dep,
        SET rend TO k.
        BREAK 0.
      /IF.
      SET cur2 TO cur2 - 1.
    /IF.
    IF rc IS "," AND cur2 IS dep,
      SET rend TO k.
      BREAK 0.
    /IF.
    SET k TO k + 1.
  /SEASON.
  REAP lhs FROM _trim_sp, substring(e, lstart, hit).
  REAP rhs FROM _trim_sp, substring(e, hit + 2, rend).
  IF lhs IS "" OR rhs IS "", GIVE e. /IF.
  # tx_t-coerce numeric literal bounds
  CREATE calltxt(TX) TO "plant_range_list(".
  SET calltxt TO calltxt + lhs.
  SET calltxt TO calltxt + ", ".
  SET calltxt TO calltxt + rhs.
  SET calltxt TO calltxt + ")".
  REAP wrapped FROM _wrap_math_args, calltxt, "plant_range_list".
  # splice: head + wrapped + tail via SET-appends
  CREATE head(TX) TO substring(e, 0, lstart).
  CREATE tail(TX) TO substring(e, rend, LEN(e)).
  CREATE out(TX) TO head.
  SET out TO out + wrapped.
  SET out TO out + tail.
  GIVE out.
/ACTION.

# _find_substr — position of the first occurrence of the substring
# needle inside s, or -1 when absent. (find_any only searches for a
# single character of its delimiter set — NOT a substring — so a
# dedicated helper is required here.)
ACTION _find_substr(s(TX), needle(TX)),
  CREATE nlen(NUM) TO LEN(needle).
  IF nlen IS 0, GIVE 0. /IF.
  CREATE slen(NUM) TO LEN(s).
  CREATE fi(NUM) TO 0.
  SEASON fi + nlen <= slen,
    CREATE bd(NUM) TO fi + nlen + 0.
    REAP seg FROM substring, s, fi, bd.
    IF str_eq(seg, needle) IS "1", GIVE fi. /IF.
    SET fi TO fi + 1.
  /SEASON.
  GIVE -1.
/ACTION.

# _quote_cond_arg — wrap the trailing condition argument of a
# plant_any(...) / plant_all(...) call in a string literal. The
# condition text ("> 2") would be invalid C as a bare expression;
# the runtime evaluates it as text. Scans backward from the closing
# paren for the depth-0 comma separating the list argument from the
# condition, then quotes the remainder (conditions the user already
# quoted pass through untouched).
ACTION _quote_cond_arg(e(TX), cfn(TX)),
    REAP cpos FROM _find_substr, e, cfn + "(".
    IF cpos IS -1, GIVE e. /IF.
    CREATE dep(NUM) TO 0.
    CREATE qi(NUM) TO LEN(e) - 2.
    CREATE qch(TX) TO "".
    CREATE qcomma(NUM) TO -1.
    SEASON qi > cpos,
        REAP qch FROM char_at, e, qi.
        IF qch IS ")", SET dep TO dep + 1. /IF.
        IF qch IS "(",
            SET dep TO dep - 1.
            IF dep IS 0, BREAK 0. /IF.
        /IF.
        IF dep IS 0 AND qch IS ",",
            SET qcomma TO qi.
            BREAK 0.
        /IF.
        SET qi TO qi - 1.
    /SEASON.
    IF qcomma IS -1, GIVE e. /IF.
    REAP qcond FROM substring, e, qcomma + 1, LEN(e) - 1.
    REAP qcond FROM trim, qcond.
    REAP qhead FROM substring, e, 0, qcomma + 1.
    REAP qc0 FROM char_at, qcond, 0.
    IF qc0 IS "\"",
        GIVE qhead + qcond + ")".
    /IF.
    GIVE qhead + "\"" + qcond + "\")".
/ACTION.

# v0.48.38b — storm() source-context injection. The factory rewrite
# maps storm( → plant_storm( AND appends compile-time source metadata
# (__FILE__, __LINE__ and a zero column — column tracking is
# non-standard, and 0 makes the runtime omit the field) just before
# each storm call's matching close paren, so every factory object
# packs its origin. The close-paren scan is paren-depth and
# string-literal aware; the split fires on "storm (" (or "storm(")
# exactly like _handle_func_paren — but only when the token is NOT
# part of a longer identifier (e.g. "plant_storm("), which both keeps
# pre-rewritten text intact and protects the self-hosted compiler
# from rewriting its own literals during bootstrap.
ACTION _storm_inject(expr(TX)),
    # delimiters live in variables: literal-first REAP/CALL args skip
    # _handle_cat, and a raw "storm (" / "storm(" literal inside the
    # compiler's own source would be rewritten during bootstrap.
    CREATE sdela(TX) TO "storm ".
    CREATE sdelb(TX) TO "storm".
    CREATE sopen(TX) TO "(".
    CREATE sparts(LIST) TO plant_list_make(0).
    REAP sparts FROM strings:SPLIT, expr, sdela + sopen.
    IF COUNT sparts IS 1,
        REAP sparts FROM strings:SPLIT, expr, sdelb + sopen.
    /IF.
    IF COUNT sparts IS 1, GIVE expr. /IF.
    REAP s0 FROM plant_list_get, sparts, 0.
    CREATE sres(TX) TO s0.
    CREATE si2(NUM) TO 1.
    CREATE sp(TX) TO "".
    SEASON si2 < COUNT sparts,
        REAP sp FROM plant_list_get, sparts, si2.
        # identifier-guard: the char immediately before the split point
        # belongs to the previous part (sres). A letter/digit/_ there
        # means "storm (" is inside a longer identifier, not a call.
        CREATE sisid(NUM) TO 0.
        IF LEN(sres) > 0,
            CREATE slast(TX) TO "".
            REAP slast FROM char_at, sres, LEN(sres) - 1.
            REAP sip FROM find_any, slast, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".
            IF sip ISNT -1, SET sisid TO 1. /IF.
        /IF.
        IF sisid IS 0,
            CREATE sdep(NUM) TO 0.
            CREATE sinstr(NUM) TO 0.
            CREATE sch(TX) TO "".
            CREATE j2(NUM) TO 0.
            CREATE sfin(NUM) TO 0.
            CREATE smat(NUM) TO 0.
            SEASON j2 < LEN(sp) AND sfin IS 0,
                REAP sch FROM char_at, sp, j2.
                IF sch IS "\"", SET sinstr TO 1 - sinstr. /IF.
                IF sinstr IS 1 AND sch IS "\\", SET j2 TO j2 + 1. /IF.
                IF sinstr IS 0 AND sch IS "(", SET sdep TO sdep + 1. /IF.
                IF sinstr IS 0 AND sch IS ")" AND sdep IS 0,
                    SET sfin TO 1.
                    SET smat TO j2.
                /IF.
                IF sinstr IS 0 AND sch IS ")" AND sdep > 0, SET sdep TO sdep - 1. /IF.
                SET j2 TO j2 + 1.
            /SEASON.
            IF sfin IS 1,
                CREATE sh2(TX) TO "".
                REAP sh2 FROM substring, sp, 0, smat.
                CREATE st2(TX) TO "".
                REAP st2 FROM substring, sp, smat, LEN(sp).
                SET sp TO sh2 + ", __FILE__, __LINE__, 0" + st2.
            /IF.
            SET sres TO sres + "plant" + "_storm" + "(" + sp.
        /IF.
        IF sisid IS 1,
            SET sres TO sres + sp.
        /IF.
        SET si2 TO si2 + 1.
    /SEASON.
    GIVE sres.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  v0.48.38c — literal list syntax [expr (, expr)*].
#  The parser already passes bracketed tokens through in expression
#  position (there is no expression AST — expression text flows to
#  translate_expr, the same seam as the LEN/JOIN/storm rewrites),
#  so the bracket literal is translated textually: each [ ... ]
#  span becomes plant_list_make(count, elem, ...). Elements are
#  split on top-level commas (paren/bracket/brace depth and string
#  literal aware); integer literals wrap in _from_long (tx_t are
#  strings, so numeric elements must be converted); nested [ ... ]
#  spans recurse; everything else passes through as tx_t text.
#  Indexing (name[expr]) is left alone — handle_brackets, which
#  runs after this rewrite, still maps it to plant_list_get.
# ──────────────────────────────────────────────────────────────

ACTION _is_int(t(TX)),
    CREATE k(NUM) TO 0.
    CREATE ch(TX) TO "".
    IF LEN(t) IS 0, GIVE 0. /IF.
    IF t IS "-", GIVE 0. /IF.
    REAP ch FROM char_at, t, 0.
    IF ch IS "-", SET k TO 1. /IF.
    SEASON k < LEN(t),
        REAP ch FROM char_at, t, k.
        REAP fp FROM find_any, ch, "0123456789".
        IF fp IS -1, GIVE 0. /IF.
        SET k TO k + 1.
    /SEASON.
    GIVE 1.
/ACTION.

# _is_decimal — true for a bare decimal literal: only digits and a
# single dot, with a digit on each side (1.5 yes; .5, 5., 1.2.3 no).
# v0.49.6 — routes [1.5, 2.7] elements to _from_double.
ACTION _is_decimal(t(TX)),
    CREATE k(NUM) TO 0.
    CREATE ch(TX) TO "".
    CREATE dots(NUM) TO 0.
    CREATE digs(NUM) TO 0.
    IF LEN(t) IS 0, GIVE 0. /IF.
    SEASON k < LEN(t),
        REAP ch FROM char_at, t, k.
        REAP fp FROM find_any, ch, "0123456789".
        IF fp ISNT -1, SET digs TO digs + 1. /IF.
        IF ch IS ".",
            SET dots TO dots + 1.
        /IF.
        IF ch ISNT "." AND fp IS -1, GIVE 0. /IF.
        SET k TO k + 1.
    /SEASON.
    IF dots IS 1 AND digs > 0,
        REAP fc FROM char_at, t, 0.
        REAP lc FROM char_at, t, LEN(t) - 1.
        IF fc ISNT "." AND lc ISNT ".",
            GIVE 1.
        /IF.
    /IF.
    GIVE 0.
/ACTION.

ACTION _push_el(els(LIST), cur(TX), nums(LIST), evars(LIST)),
    REAP elt FROM trim, cur.
    IF LEN(elt) IS 0, GIVE els. /IF.
    REAP ef FROM _enc_el, elt, nums, evars.
    REAP els FROM plant_list_push, els, ef.
    GIVE els.
/ACTION.

# _enc_el — encode a single list/map element or pair value into the
# C expression emitted inside plant_list_make / plant_map_set: quoted
# strings pass through as tx_t text; [ ... ] spans recurse into
# _seg_list; { ... } spans recurse into _seg_map; bare booleans
# materialize as the quoted strings; integer literals and arithmetic
# expressions wrap in _from_long (NUM-typed values arrive as raw C
# longs — pointer-truncation would crash the runtime's serializer);
# v0.49.6 — " + " concatenation runs through _handle_cat (so ["a" +
# "b"] emits _cat(...)), bare NUM variables wrap in _from_long (so
# [n, "x"] is valid), and decimal literals wrap in _from_double (so
# [1.5, 2.7] is valid); everything else passes through as tx_t.
ACTION _enc_el(elt(TX), nums(LIST), evars(LIST)),
    CREATE ef(TX) TO "".
    REAP ec0 FROM char_at, elt, 0.
    IF ec0 IS "[",
        REAP is2 FROM substring, elt, 1, LEN(elt) - 1.
        REAP ef FROM _seg_list, is2, nums, evars.
    /IF.
    IF ec0 IS "{",
        REAP is2 FROM substring, elt, 1, LEN(elt) - 1.
        REAP ef FROM _seg_map, is2, nums, evars.
    /IF.
    IF ec0 ISNT "[" AND ec0 ISNT "{",
        # v0.49.6 — a concatenation span first: "a" + "b" becomes
        # _cat("a", "b"); [x + 1, n] wraps the numeric segments the
        # same way statement-level SET/CREATE values do. _handle_cat
        # returns the element untouched when there is no top-level
        # " + " (quoted "a+b" passes through raw).
        REAP cplus FROM find_any, elt, "+".
        IF cplus ISNT -1,
            REAP elt FROM _handle_cat, elt, nums, evars.
        /IF.
        REAP eq1 FROM char_at, elt, 0.
        IF eq1 IS "\"",
            # quoted element passes through raw (tx_t text); the
            # bool/int/numeric checks below must not touch it —
            # find_any would see "+" inside "a+b" and wrap a string
            SET ef TO elt.
        /IF.
        IF eq1 ISNT "\"",
        # bare booleans inside a literal materialize as the
        # quoted string "TRUE"/"FALSE": a non-numeric element for
        # SUM (skipped), and visible as text in JOIN/FIRST/LAST.
        REAP ebv FROM str_eq, elt, "TRUE".
        IF ebv IS "1",
            SET ef TO "\"TRUE\"".
        /IF.
        REAP ebf FROM str_eq, elt, "FALSE".
        IF ebf IS "1",
            SET ef TO "\"FALSE\"".
        /IF.
        IF ebv IS "0" AND ebf IS "0",
        REAP isi FROM _is_int, elt.
        IF isi IS 1,
            SET ef TO "_from_long(" + elt + ")".
        /IF.
        IF isi IS 0,
            # v0.49.6 — decimal literal element: [1.5, 2.7] wraps
            # in _from_double so the fractional value survives.
            REAP dci FROM _is_decimal, elt.
            IF dci IS 1,
                SET ef TO "_from_double(" + elt + ")".
            /IF.
            IF dci IS 0,
            # v0.49.6 — bare numeric variable: an identifier (or
            # numeric helper call) in nums wraps in _from_long;
            # _from_long(strlen(x)) is a bonus fix — before, the
            # truncating-pointer path stored garbage.
            REAP sgn FROM seg_is_numeric, elt, nums.
            IF sgn IS 1,
                SET ef TO "_from_long(" + elt + ")".
            /IF.
            IF sgn IS 0,
            # v0.49.4 — arithmetic element (unquoted, contains an
            # operator): NUM-typed expressions like "x + 1" arrive as
            # raw C longs; wrap so the runtime stores a tx_t number
            # string. Quoted strings and bare identifiers pass
            # through untouched.
            REAP opf FROM find_any, elt, "+-*/".
            IF opf IS -1,
                SET ef TO elt.
            /IF.
            IF opf ISNT -1,
                SET ef TO "_from_long(" + elt + ")".
            /IF.
            /IF.
            /IF.
        /IF.
        /IF.
        /IF.
    /IF.
    GIVE ef.
/ACTION.

ACTION _seg_list(inner(TX), nums(LIST), evars(LIST)),
    CREATE els(LIST) TO plant_list_make(0).
    CREATE cur(TX) TO "".
    CREATE dep(NUM) TO 0.
    CREATE ist(NUM) TO 0.
    CREATE ii(NUM) TO 0.
    CREATE ch(TX) TO "".
    CREATE esc2(NUM) TO 0.
    SEASON ii < LEN(inner),
        SET esc2 TO 0.
        REAP ch FROM char_at, inner, ii.
        IF ist IS 1 AND ch IS "\\" AND ii + 1 < LEN(inner),
            SET cur TO cur + ch.
            SET ii TO ii + 1.
            REAP ch FROM char_at, inner, ii.
            SET cur TO cur + ch.
            SET esc2 TO 1.
        /IF.
        IF esc2 IS 0,
        IF ch IS "\"", SET ist TO 1 - ist. /IF.
        IF ist IS 0,
            IF ch IS "[" OR ch IS "(" OR ch IS "{", SET dep TO dep + 1. /IF.
            IF ch IS "]" OR ch IS ")" OR ch IS "}", SET dep TO dep - 1. /IF.
            IF ch IS "," AND dep IS 0,
                REAP els FROM _push_el, els, cur, nums, evars.
                SET cur TO "".
            /IF.
        /IF.
        IF ch ISNT "," OR ist IS 1 OR dep ISNT 0,
            SET cur TO cur + ch.
        /IF.
        /IF.
        SET ii TO ii + 1.
    /SEASON.
    REAP els FROM _push_el, els, cur, nums, evars.
    IF COUNT els IS 0, GIVE "plant_list_make(0)". /IF.
    # count text via _from_long: numeric segments inside string
    # concatenation must stay TX (the v0.46.3-era bootstrap compiler
    # does not _from_long-wrap numeric segments in _handle_cat)
    CREATE cnt(TX) TO "".
    REAP cnt FROM _from_long, COUNT els.
    CREATE res(TX) TO "plant_list_make(" + cnt + ", ".
    CREATE sii(NUM) TO 0.
    SEASON sii < COUNT els,
        REAP elx FROM plant_list_get, els, sii.
        SET res TO res + elx.
        IF sii < COUNT els - 1, SET res TO res + ", ". /IF.
        SET sii TO sii + 1.
    /SEASON.
    SET res TO res + ")".
    GIVE res.
/ACTION.

ACTION _list_literal(expr(TX), nums(LIST), evars(LIST)),
    CREATE chk0(TX) TO "".
    REAP chk0 FROM find_any, expr, "[".
    IF chk0 IS -1, GIVE expr. /IF.
    CREATE out(TX) TO "".
    CREATE bd(NUM) TO 0.
    CREATE inst(NUM) TO 0.
    CREATE ls(NUM) TO 0.
    CREATE lc(NUM) TO 0.
    CREATE lst(TX) TO "".
    CREATE li(NUM) TO 0.
    CREATE ch(TX) TO "".
    CREATE lesc(NUM) TO 0.
    SEASON li < LEN(expr),
        SET lc TO 0.
        SET lesc TO 0.
        REAP ch FROM char_at, expr, li.
        IF inst IS 1 AND ch IS "\\" AND li + 1 < LEN(expr),
            SET out TO out + ch.
            SET li TO li + 1.
            REAP ch FROM char_at, expr, li.
            SET out TO out + ch.
            SET lc TO 1.
            SET lesc TO 1.
        /IF.
        IF lesc IS 0,
        IF ch IS "\"", SET inst TO 1 - inst. /IF.
        IF ch IS "\"" AND ls IS 0,
            SET out TO out + ch.
            SET lc TO 1.
        /IF.
        IF ch IS "\"" AND ls IS 1,
            SET lst TO lst + ch.
            SET lc TO 1.
        /IF.
        IF ch ISNT "\"" AND inst IS 0 AND ls IS 1,
            IF ch IS "[", SET bd TO bd + 1. /IF.
            IF ch IS "]",
                SET bd TO bd - 1.
                IF bd IS 0,
                    REAP isub FROM substring, lst, 1, LEN(lst).
                    SET out TO out + _seg_list(isub, nums, evars).
                    SET ls TO 0.
                    SET lc TO 1.
                /IF.
            /IF.
            IF bd > 0, SET lst TO lst + ch. /IF.
            IF ch ISNT "]",
                SET lc TO 1.
            /IF.
            IF ch IS "]" AND bd > 0,
                SET lc TO 1.
            /IF.
        /IF.
        IF ch ISNT "\"" AND inst IS 1 AND ls IS 1,
            SET lst TO lst + ch.
            SET lc TO 1.
        /IF.
        IF ch ISNT "\"" AND inst IS 0 AND ls IS 0 AND ch IS "[",
            # identifier-guard: skip whitespace backwards — tokenized
            # expression text is space-joined ("si [ 2 ]"), so the
            # char right before "[" may be a space. `)` / `]` also
            # block (call-result / chained indexing is not a list).
            CREATE pvc(TX) TO "".
            CREATE pj(NUM) TO li - 1.
            CREATE pch(TX) TO "".
            SEASON pj >= 0,
                REAP pch FROM char_at, expr, pj.
                IF pch ISNT " " AND pch ISNT "\t",
                    SET pvc TO pch.
                    SET pj TO -1.
                /IF.
                IF pch IS " " OR pch IS "\t",
                    SET pj TO pj - 1.
                /IF.
            /SEASON.
            REAP pvi FROM find_any, pvc, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_)]".
            IF li IS 0 OR pvi IS -1,
                SET ls TO 1.
                SET bd TO 1.
                SET lst TO "".
                SET lc TO 1.
            /IF.
            IF li > 0 AND pvi ISNT -1,
                SET out TO out + ch.
                SET lc TO 1.
            /IF.
        /IF.
        IF ch ISNT "\"" AND inst IS 0 AND ls IS 0 AND ch ISNT "[" AND lc IS 0,
            SET out TO out + ch.
        /IF.
        IF ch ISNT "\"" AND inst IS 1 AND ls IS 0,
            SET out TO out + ch.
        /IF.
        /IF.
        SET li TO li + 1.
    /SEASON.
    GIVE out.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  Map literal translation (v0.49.5): {k: v} pairs compile to a
#  chain of pair-list MAP setters —
#  { "name": "plant", "year": 2026 } →
#    plant_map_set(plant_map_set(plant_map_create(),
#      "name", "plant"), "year", _from_long(2026))
#  Empty {} → plant_map_create(). Nested { ... } and [ ... ]
#  values recurse through _enc_el.
# ──────────────────────────────────────────────────────────────

# _seg_map — split the inner text of { ... } on top-level commas
# (quote-, paren-, bracket- and brace-depth aware) and fold the
# pairs into the plant_map_set chain.
ACTION _seg_map(inner(TX), nums(LIST), evars(LIST)),
    CREATE acc(TX) TO "plant_map_create()".
    CREATE cur(TX) TO "".
    CREATE dep(NUM) TO 0.
    CREATE ist(NUM) TO 0.
    CREATE ii(NUM) TO 0.
    CREATE ch(TX) TO "".
    CREATE esc2(NUM) TO 0.
    SEASON ii < LEN(inner),
        SET esc2 TO 0.
        REAP ch FROM char_at, inner, ii.
        IF ist IS 1 AND ch IS "\\" AND ii + 1 < LEN(inner),
            SET cur TO cur + ch.
            SET ii TO ii + 1.
            REAP ch FROM char_at, inner, ii.
            SET cur TO cur + ch.
            SET esc2 TO 1.
        /IF.
        IF esc2 IS 0,
        IF ch IS "\"", SET ist TO 1 - ist. /IF.
        IF ist IS 0,
            IF ch IS "[" OR ch IS "(" OR ch IS "{", SET dep TO dep + 1. /IF.
            IF ch IS "]" OR ch IS ")" OR ch IS "}", SET dep TO dep - 1. /IF.
            IF ch IS "," AND dep IS 0,
                REAP acc FROM _push_pair, acc, cur, nums, evars.
                SET cur TO "".
            /IF.
        /IF.
        IF ch ISNT "," OR ist IS 1 OR dep ISNT 0,
            SET cur TO cur + ch.
        /IF.
        /IF.
        SET ii TO ii + 1.
    /SEASON.
    REAP acc FROM _push_pair, acc, cur, nums, evars.
    GIVE acc.
/ACTION.

# _find_colon — index of the first top-level ":" (quote-, paren-,
# bracket- and brace-aware); -1 when absent.
ACTION _find_colon(ptext(TX)),
    CREATE dep(NUM) TO 0.
    CREATE ist(NUM) TO 0.
    CREATE ii(NUM) TO 0.
    CREATE ch(TX) TO "".
    SEASON ii < LEN(ptext),
        REAP ch FROM char_at, ptext, ii.
        IF ch IS "\"", SET ist TO 1 - ist. /IF.
        IF ist IS 0,
            IF ch IS "[" OR ch IS "(" OR ch IS "{", SET dep TO dep + 1. /IF.
            IF ch IS "]" OR ch IS ")" OR ch IS "}", SET dep TO dep - 1. /IF.
            IF ch IS ":" AND dep IS 0, GIVE ii. /IF.
        /IF.
        SET ii TO ii + 1.
    /SEASON.
    GIVE -1.
/ACTION.

# _push_pair — encode one "key: value" pair and fold it into the
# chain: plant_map_set(<acc>, <key>, <value>). Empty / malformed
# pairs are skipped.
ACTION _push_pair(acc(TX), cur(TX), nums(LIST), evars(LIST)),
    REAP ptext FROM trim, cur.
    IF LEN(ptext) IS 0, GIVE acc. /IF.
    REAP ci FROM _find_colon, ptext.
    IF ci IS -1, GIVE acc. /IF.
    REAP ktxt FROM substring, ptext, 0, ci.
    REAP vtxt FROM substring, ptext, ci + 1, LEN(ptext).
    REAP kt FROM trim, ktxt.
    REAP vt FROM trim, vtxt.
    IF LEN(kt) IS 0, GIVE acc. /IF.
    IF LEN(vt) IS 0, GIVE acc. /IF.
    REAP ken FROM _enc_el, kt, nums, evars.
    REAP ven FROM _enc_el, vt, nums, evars.
    SET acc TO "plant_map_set(" + acc + ", " + ken + ", " + ven + ")".
    GIVE acc.
/ACTION.

# _map_literal — scan an expression for top-level { ... } spans and
# rewrite them through _seg_map. Quote- and escape-aware; braces
# inside strings are literal text. The identifier-guard mirrors
# _list_literal: a "{" preceded by an identifier (or ) or ]) is
# legacy struct-literal syntax and passes through untouched.
ACTION _map_literal(expr(TX), nums(LIST), evars(LIST)),
    CREATE chk0(TX) TO "".
    REAP chk0 FROM find_any, expr, "{".
    IF chk0 IS -1, GIVE expr. /IF.
    CREATE out(TX) TO "".
    CREATE bd(NUM) TO 0.
    CREATE inst(NUM) TO 0.
    CREATE ls(NUM) TO 0.
    CREATE lc(NUM) TO 0.
    CREATE lst(TX) TO "".
    CREATE li(NUM) TO 0.
    CREATE ch(TX) TO "".
    CREATE lesc(NUM) TO 0.
    SEASON li < LEN(expr),
        SET lc TO 0.
        SET lesc TO 0.
        REAP ch FROM char_at, expr, li.
        IF inst IS 1 AND ch IS "\\" AND li + 1 < LEN(expr),
            SET out TO out + ch.
            SET li TO li + 1.
            REAP ch FROM char_at, expr, li.
            SET out TO out + ch.
            SET lc TO 1.
            SET lesc TO 1.
        /IF.
        IF lesc IS 0,
        IF ch IS "\"", SET inst TO 1 - inst. /IF.
        IF ch IS "\"" AND ls IS 0,
            SET out TO out + ch.
            SET lc TO 1.
        /IF.
        IF ch IS "\"" AND ls IS 1,
            SET lst TO lst + ch.
            SET lc TO 1.
        /IF.
        IF ch ISNT "\"" AND inst IS 0 AND ls IS 1,
            IF ch IS "{", SET bd TO bd + 1. /IF.
            IF ch IS "}",
                SET bd TO bd - 1.
                IF bd IS 0,
                    REAP isub FROM substring, lst, 1, LEN(lst).
                    SET out TO out + _seg_map(isub, nums, evars).
                    SET ls TO 0.
                    SET lc TO 1.
                /IF.
            /IF.
            IF bd > 0, SET lst TO lst + ch. /IF.
            IF ch ISNT "}",
                SET lc TO 1.
            /IF.
            IF ch IS "}" AND bd > 0,
                SET lc TO 1.
            /IF.
        /IF.
        IF ch ISNT "\"" AND inst IS 1 AND ls IS 1,
            SET lst TO lst + ch.
            SET lc TO 1.
        /IF.
        IF ch ISNT "\"" AND inst IS 0 AND ls IS 0 AND ch IS "{",
            # identifier-guard: skip whitespace backwards — tokenized
            # expression text is space-joined, so the char right
            # before "{" may be a space. `)` / `]` also block
            # (call-result / chained access is not a map literal).
            CREATE pvc(TX) TO "".
            CREATE pj(NUM) TO li - 1.
            CREATE pch(TX) TO "".
            SEASON pj >= 0,
                REAP pch FROM char_at, expr, pj.
                IF pch ISNT " " AND pch ISNT "\t",
                    SET pvc TO pch.
                    SET pj TO -1.
                /IF.
                IF pch IS " " OR pch IS "\t",
                    SET pj TO pj - 1.
                /IF.
            /SEASON.
            REAP pvi FROM find_any, pvc, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_)]".
            IF li IS 0 OR pvi IS -1,
                SET ls TO 1.
                SET bd TO 1.
                SET lst TO "".
                SET lc TO 1.
            /IF.
            IF li > 0 AND pvi ISNT -1,
                SET out TO out + ch.
                SET lc TO 1.
            /IF.
        /IF.
        IF ch ISNT "\"" AND inst IS 0 AND ls IS 0 AND ch ISNT "{" AND lc IS 0,
            SET out TO out + ch.
        /IF.
        IF ch ISNT "\"" AND inst IS 1 AND ls IS 0,
            SET out TO out + ch.
        /IF.
        /IF.
        SET li TO li + 1.
    /SEASON.
    GIVE out.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_identifier — 1 when the text is a C/PlantLang identifier
#  (letter or _ first, then letters/digits/_). Digit literals like
#  "2" or "0x10" are NOT identifiers. Used by seg_is_numeric so
# ═══════════════════════════════════════════════════════════════
#  SHARED UTILITIES
#  These functions are called by both parser.plant and codegen_c.plant.
#  They live in the codegen module by convention (they were originally
#  codegen helpers), but they are NOT codegen implementation details —
#  they are the shared utility layer. In v0.49.57 these will be extracted
#  to a dedicated utils.plant module.
#    Identifiers: is_identifier, _step_sign, _st_expr, _st_term
#    String ops:  trim, _first, _second, _third, str_eq, find_any
#    List ops:    _map_get, _map_replace, plant_list_get
#  ═══════════════════════════════════════════════════════════════

# is_identifier: checks if a token text is a valid identifier
# (v0.48.20-patch: identifiers that merely contain digits (eb2, n2)
# are never mistaken for raw numeric literals)
# ──────────────────────────────────────────────────────────────
ACTION is_identifier(tok(TX)),
  CREATE i0(NUM) TO 0.
  CREATE ch0(TX) TO "".
  IF LEN(tok) IS 0, GIVE 0. /IF.
  REAP ch0 FROM char_at, tok, 0.
  REAP f0 FROM find_any, ch0, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_".
  IF f0 IS -1, GIVE 0. /IF.
  SET i0 TO 1.
  SEASON i0 < LEN(tok),
    REAP ch0 FROM char_at, tok, i0.
    REAP f0 FROM find_any, ch0, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_".
    IF f0 IS -1, GIVE 0. /IF.
    SET i0 TO i0 + 1.
  /SEASON.
  GIVE 1.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  seg_is_numeric — 1 when a concatenation segment is a numeric
#  value or expression: digit literals and identifiers/expressions
#  built only from NUM/FACT vars (nums) and arithmetic operators.
#  Identifier tokens are checked against nums even when they
#  contain digits (is_identifier), so "eb2" is never treated as a
#  raw literal (v0.48.20-patch).
#  Used by _handle_cat to decide _from_long() wrapping.
# ──────────────────────────────────────────────────────────────
#  seg_has_literal_digit — 1 when the segment text contains a digit
#  that belongs to a genuine numeric literal rather than an
#  identifier (is_identifier). "p5" has a digit but is an
#  identifier → 0; "1" and "(2 + 3)" are literals → 1. Lets
#  _handle_cat keep the raw C "+" arithmetic shortcut (which REAP'd
#  index vars like p5 rely on) without letting identifier digits
#  like "eb2" trigger it (v0.48.20-patch).
# ──────────────────────────────────────────────────────────────
ACTION seg_has_literal_digit(seg(TX)),
  REAP sid FROM is_identifier, seg.
  IF sid IS 1, GIVE 0. /IF.
  REAP sb FROM strings:REPLACE, seg, " ", "".
  CREATE si2(NUM) TO 0.
  CREATE sc2(TX) TO "".
  SEASON si2 < LEN(sb),
    REAP sc2 FROM char_at, sb, si2.
    REAP sd FROM find_any, sc2, "0123456789".
    IF sd ISNT -1, GIVE 1. /IF.
    SET si2 TO si2 + 1.
  /SEASON.
  GIVE 0.
/ACTION.

ACTION is_lookup_prefix(seg(TX)),
  # v0.49.11 — parser-emitted lookups that carry tx_t (or raw-long)
  # values and must be coerced in numeric contexts and never treated
  # as string segments by has_str: v0.49.10 field access (_map_get),
  # method-call get/pop (plant_map_get/plant_list_pop), and the
  # _from_long wrapper the parser puts around has() results.
  IF substring(seg, 0, 9) IS "_map_get(", GIVE "1". /IF.
  IF substring(seg, 0, 14) IS "plant_map_get(", GIVE "1". /IF.
  IF substring(seg, 0, 15) IS "plant_list_pop(", GIVE "1". /IF.
  IF substring(seg, 0, 11) IS "_from_long(", GIVE "1". /IF.
  GIVE "0".
/ACTION.

ACTION seg_is_numeric(seg(TX), nums(LIST)),
  REAP sb FROM strings:REPLACE, seg, " ", "".
  IF sb IS "", GIVE 0. /IF.
  # known numeric-returning calls (translate_expr output): LEN→strlen,
  # COUNT→plant_array_length, _to_long — their results are C longs.
  REAP pre0 FROM substring, sb, 0, 7.
  IF pre0 IS "strlen(", GIVE 1. /IF.
  REAP pre1 FROM substring, sb, 0, 19.
  IF pre1 IS "plant_array_length(", GIVE 1. /IF.
  REAP pre2 FROM substring, sb, 0, 9.
  IF pre2 IS "_to_long(", GIVE 1. /IF.
  REAP pre3 FROM substring, sb, 0, 9.
  IF pre3 IS "json_len(", GIVE 1. /IF.
  REAP pre4 FROM substring, sb, 0, 10.
  IF pre4 IS "json_kind(", GIVE 1. /IF.
  REAP pre5 FROM substring, sb, 0, 9.
  IF pre5 IS "set_size(", GIVE 1. /IF.
  REAP pre6 FROM substring, sb, 0, 11.
  IF pre6 IS "queue_size(", GIVE 1. /IF.
  REAP pre7 FROM substring, sb, 0, 11.
  IF pre7 IS "stack_size(", GIVE 1. /IF.
  REAP pre8 FROM substring, sb, 0, 14.
  IF pre8 IS "ffi_last_error(", GIVE 1. /IF.
  REAP pre9 FROM substring, sb, 0, 18.
  IF pre9 IS "plant_rw_arg_long(", GIVE 1. /IF.
  REAP pre10 FROM substring, sb, 0, 13.
  IF pre10 IS "plant_is_some(", GIVE 1. /IF.
  REAP pre11 FROM substring, sb, 0, 13.
  IF pre11 IS "plant_is_none(", GIVE 1. /IF.
  REAP pre12 FROM substring, sb, 0, 11.
  IF pre12 IS "plant_is_ok(", GIVE 1. /IF.
  REAP pre13 FROM substring, sb, 0, 12.
  IF pre13 IS "plant_is_err(", GIVE 1. /IF.
  CREATE si(NUM) TO 0.
  CREATE sc(TX) TO "".
  CREATE tok(TX) TO "".
  CREATE toknum(NUM) TO 1.
  SEASON si < LEN(sb),
    REAP sc FROM char_at, sb, si.
    REAP isid FROM find_any, sc, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_".
    IF isid ISNT -1,
      SET tok TO tok + sc.
    /IF.
    IF isid IS -1,
      REAP isop FROM find_any, sc, "+-*/%^<>=!&|()".
      IF isop IS -1, GIVE 0. /IF.
      IF tok > "",
        REAP tokid FROM is_identifier, tok.
        IF tokid IS 1, SET toknum TO 0. /IF.
        IF toknum IS 0,
          REAP mf FROM list_contains, nums, tok.
          IF mf IS 0, GIVE 0. /IF.
        /IF.
        SET tok TO "".
        SET toknum TO 1.
      /IF.
    /IF.
    SET si TO si + 1.
  /SEASON.
  IF tok > "",
    REAP tokid FROM is_identifier, tok.
    IF tokid IS 1, SET toknum TO 0. /IF.
    IF toknum IS 0,
      REAP mf FROM list_contains, nums, tok.
      IF mf IS 0, GIVE 0. /IF.
    /IF.
  /IF.
  GIVE 1.
/ACTION.

# ──────────────────────────────────────────────
#  expr_is_numeric — 1 when a tx_t-context value expression is a
#  scalar C numeric: a digit literal, a NUM/FACT var reference,
#  arithmetic built only from numerics, or a known numeric-returning
#  call (LEN/COUNT/_to_long/std numeric readers). Quoted string
#  literals are never numeric ("12" stays text). Used by the
#  show_stmt generator to wrap raw longs in _from_long before
#  plant_print (v0.48.5 numeric SHOW).
# ──────────────────────────────────────────────
ACTION expr_is_numeric(e(TX), nums(LIST)),
    REAP q0 FROM substring, e, 0, 1.
    IF q0 IS "\"", GIVE 0. /IF.
    REAP sn FROM seg_is_numeric, e, nums.
    GIVE sn.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_numeric_type — 1 when a (substituted) PlantLang type is a
#  scalar numeric type (NUM/FACT). gen_give_stmt wraps the GIVE
#  value of NUM-typed actions in _from_long so callers receive the
#  value as text instead of raw long bits (v0.48.13).
# ──────────────────────────────────────────────────────────────
ACTION is_numeric_type(t(TX)),
  IF t IS "NUM" OR t IS "FACT", GIVE 1. /IF.
  GIVE 0.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _handle_cat — convert + to _cat() for string concatenation
#  Raw C "+" only when every top-level segment is verifiably
#  numeric (seg_is_numeric); identifiers containing digits like
#  "eb2" now concatenate instead of producing void*+void* C errors
#  (v0.48.20-patch).
#  nums: names of scalar NUM/FACT vars in scope; bare identifiers
#  listed there get _from_long() so "x" + n works (v0.48.3a)
#  NOTE: does NOT handle quoted + inside string literals correctly
#  so it should only be called on show_stmt values which rarely
#  contain string literals with + as delimiter arguments
# ──────────────────────────────────────────────────────────────
# ──────────────────────────────────────────────────────────────
#  String interpolation ("...${expr}...") — v0.48.22-patch2
#
#  The lexer tags interpolated strings as INTERP tokens; the parser
#  quote-wraps them like plain strings. At codegen, _interp_to_cat
#  (invoked at the top of _handle_cat, so every value position
#  inherits it) rebuilds each quoted string that contains ${...}
#  into a nested _cat(...) chain: literal segments stay C string
#  literals, embedded expressions go through unescape → nested
#  interpolation → translate_expr → _handle_cat, and numerically
#  typed results are wrapped in _from_long (enum refs in _from_enum).
# ──────────────────────────────────────────────────────────────

# _find_interp — 1 when t contains "${"
ACTION _find_interp(t(TX)),
  CREATE i(NUM) TO 0.
  CREATE n(NUM) TO LEN(t).
  SEASON i < n - 1,
    REAP c FROM char_at, t, i.
    IF c IS "$" AND char_at(t, i + 1) IS "{", GIVE 1. /IF.
    SET i TO i + 1.
  /SEASON.
  GIVE 0.
/ACTION.

# _unescape — undo escape_string's \" and \\ inside embedded
# expressions (the embedded text is C-escaped inside the value).
# NOTE: variables kept digit-free so the (stale) bootstrap compiler
# doesn't take its has_digit raw-+ shortcut on pure var+var concats.
ACTION _unescape(s(TX)),
  CREATE rr(TX) TO "".
  CREATE ii(NUM) TO 0.
  CREATE nn(NUM) TO LEN(s).
  SEASON ii < nn,
    REAP cc FROM char_at, s, ii.
    IF cc IS "\\" AND ii + 1 < nn,
      REAP nx FROM char_at, s, ii + 1.
      IF nx IS "\"" OR nx IS "\\",
        SET rr TO rr + nx.
        SET ii TO ii + 2.
        CONTINUE.
      /IF.
    /IF.
    SET rr TO rr + cc.
    SET ii TO ii + 1.
  /SEASON.
  GIVE rr.
/ACTION.

# v0.48.22-patch4 — _is_digit_lit: 1 when s is exactly one of 0..9.
# Used at the _from_long wrap sites to select the _from_digit fast
# path for single-digit literal segments.
ACTION _is_digit_lit(s(TX)),
  CREATE dn(NUM) TO 0.
  CREATE dc(TX) TO "".
  IF LEN(s) ISNT 1, GIVE 0. /IF.
  REAP dc FROM char_at, s, 0.
  IF dc GREATER THAN OR EQUAL "0" AND dc LESS THAN OR EQUAL "9", GIVE 1. /IF.
  GIVE 0.
/ACTION.

# v0.48.22-patch4 — _emit_cat_chain: flatten a list of emission-ready
# segments into _cat4/_cat3/_cat calls. Left-deep _cat(_cat(a,b),c)
# chains allocate once per pair; grouping 3-4 segments per call cuts
# allocations and memcpys on interpolation-heavy expressions. A 2-part
# chain keeps the plain _cat form (identical emission to before).
ACTION _emit_cat_chain(parts(LIST)),
  CREATE cn(NUM) TO COUNT parts.
  CREATE co(TX) TO "".
  CREATE a0(TX) TO "".
  CREATE a1(TX) TO "".
  CREATE a2(TX) TO "".
  CREATE a3(TX) TO "".
  IF cn IS 1,
    REAP co FROM plant_list_get, parts, 0.
  /IF.
  IF cn IS 2,
    REAP a0 FROM plant_list_get, parts, 0.
    REAP a1 FROM plant_list_get, parts, 1.
    SET co TO "_cat(" + a0 + ", " + a1 + ")".
  /IF.
  IF cn IS 3,
    REAP a0 FROM plant_list_get, parts, 0.
    REAP a1 FROM plant_list_get, parts, 1.
    REAP a2 FROM plant_list_get, parts, 2.
    SET co TO "_cat3(" + a0 + ", " + a1 + ", " + a2 + ")".
  /IF.
  IF cn IS 4,
    REAP a0 FROM plant_list_get, parts, 0.
    REAP a1 FROM plant_list_get, parts, 1.
    REAP a2 FROM plant_list_get, parts, 2.
    REAP a3 FROM plant_list_get, parts, 3.
    SET co TO "_cat4(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ")".
  /IF.
  IF cn > 4,
    CREATE cix(NUM) TO 0.
    CREATE cres(TX) TO "".
    CREATE rem(NUM) TO 0.
    REAP a0 FROM plant_list_get, parts, 0.
    REAP a1 FROM plant_list_get, parts, 1.
    REAP a2 FROM plant_list_get, parts, 2.
    REAP a3 FROM plant_list_get, parts, 3.
    SET cres TO "_cat4(" + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ")".
    SET cix TO 4.
    SEASON cix <= cn - 3,
      REAP a0 FROM plant_list_get, parts, cix.
      REAP a1 FROM plant_list_get, parts, cix + 1.
      REAP a2 FROM plant_list_get, parts, cix + 2.
      SET cres TO "_cat4(" + cres + ", " + a0 + ", " + a1 + ", " + a2 + ")".
      SET cix TO cix + 3.
    /SEASON.
    SET rem TO cn - cix.
    IF rem IS 1,
      REAP a0 FROM plant_list_get, parts, cix.
      SET cres TO "_cat(" + cres + ", " + a0 + ")".
    /IF.
    IF rem IS 2,
      REAP a0 FROM plant_list_get, parts, cix.
      REAP a1 FROM plant_list_get, parts, cix + 1.
      SET cres TO "_cat3(" + cres + ", " + a0 + ", " + a1 + ")".
    /IF.
    SET co TO cres.
  /IF.
  GIVE co.
/ACTION.

# _interp_to_cat — scan expr text; expand any quoted string that
# contains ${...}; copy everything else unchanged
ACTION _interp_to_cat(expr(TX), nums(LIST), evars(LIST)),
  CREATE res(TX) TO "".
  CREATE i(NUM) TO 0.
  CREATE n(NUM) TO LEN(expr).
  CREATE ch(TX) TO "".
  SEASON i < n,
    REAP ch FROM char_at, expr, i.
    IF ch ISNT "\"",
      SET res TO res + ch.
      SET i TO i + 1.
      CONTINUE.
    /IF.
    CREATE j(NUM) TO i + 1.
    CREATE dn(NUM) TO 0.
    SEASON dn IS 0 AND j < n,
      REAP cj FROM char_at, expr, j.
      IF cj IS "\\",
        SET j TO j + 2.
        CONTINUE.
      /IF.
      IF cj IS "\"",
        SET dn TO 1.
        SET j TO j + 1.
        CONTINUE.
      /IF.
      SET j TO j + 1.
    /SEASON.
    REAP raw FROM substring, expr, i, j.
    REAP hp FROM _find_interp, raw.
    IF hp IS 0,
      SET res TO res + raw.
      SET i TO j.
      CONTINUE.
    /IF.
    REAP chain FROM _interp_expand, raw, nums, evars.
    SET res TO res + chain.
    SET i TO j.
  /SEASON.
  GIVE res.
/ACTION.

# _expand_bare — replace unquoted ${...} inside an embedded
# expression with the raw C of the inner expression (e.g.
# "${n + ${n}}" → "n + n"); recursion covers deeper nesting.
# The inner C is deliberately NOT _from_long-wrapped here — the
# surrounding expression supplies the type.
ACTION _expand_bare(t(TX), nums(LIST), evars(LIST)),
  CREATE res(TX) TO "".
  CREATE i(NUM) TO 0.
  CREATE n(NUM) TO LEN(t).
  CREATE instr(NUM) TO 0.
  SEASON i < n,
    REAP c FROM char_at, t, i.
    IF c IS "\"",
      SET instr TO 1 - instr.
      SET res TO res + c.
      SET i TO i + 1.
      CONTINUE.
    /IF.
    IF c IS "\\" AND instr IS 1,
      SET res TO res + c + "".
      SET i TO i + 1.
      IF i < n,
        REAP c2 FROM char_at, t, i.
        SET res TO res + c2 + "".
        SET i TO i + 1.
      /IF.
      CONTINUE.
    /IF.
    # v0.48.22-patch4 — escaped marker inside an embedded expression:
    # a `${` preceded by a backslash (post-_unescape text) is literal.
    IF instr IS 0 AND c IS "$" AND i + 1 < n AND char_at(t, i + 1) IS "{" AND i > 0 AND char_at(t, i - 1) IS "\\",
      SET res TO res + c + "".
      SET i TO i + 1.
      CONTINUE.
    /IF.
    IF instr IS 0 AND c IS "$" AND i + 1 < n AND char_at(t, i + 1) IS "{",
      CREATE d(NUM) TO 1.
      CREATE j(NUM) TO i + 2.
      SEASON d > 0 AND j < n,
        REAP c2 FROM char_at, t, j.
        IF c2 IS "\\",
          SET j TO j + 2.
          CONTINUE.
        /IF.
        IF c2 IS "$" AND j + 1 < n AND char_at(t, j + 1) IS "{",
          SET d TO d + 1.
          SET j TO j + 2.
          CONTINUE.
        /IF.
        IF c2 IS "}",
          SET d TO d - 1.
          IF d IS 0,
            SET j TO j + 1.
            CONTINUE.
          /IF.
        /IF.
        SET j TO j + 1.
      /SEASON.
      REAP inner FROM substring, t, i + 2, j - 1.
      REAP inner FROM _expand_bare, inner, nums, evars.
      REAP inner FROM translate_expr, inner, nums, evars.
      REAP inner FROM _handle_cat, inner, nums, evars.
      SET res TO res + inner.
      SET i TO j.
      CONTINUE.
    /IF.
    SET res TO res + c.
    SET i TO i + 1.
  /SEASON.
  GIVE res.
/ACTION.

# _interp_expand — decompose one quoted interpolated string (raw
# includes the outer quotes) into a nested _cat(...) chain
ACTION _interp_expand(raw(TX), nums(LIST), evars(LIST)),
  CREATE content(TX) TO substring(raw, 1, LEN(raw) - 1).
  CREATE segs(LIST) TO plant_list_make(0).
  CREATE i(NUM) TO 0.
  CREATE n(NUM) TO LEN(content).
  SEASON TRUE,
    CREATE fnd(NUM) TO -1.
    CREATE k(NUM) TO i.
    SEASON k < n,
      REAP ck FROM char_at, content, k.
      # v0.48.22-patch4 — escaped marker: a `${` preceded by a
      # backslash in the content (from a source `\${`) is literal
      # text, not an interpolation start.
      IF ck IS "$" AND k + 1 < n AND char_at(content, k + 1) IS "{" AND k > 0 AND char_at(content, k - 1) IS "\\",
        SET k TO k + 1.
        CONTINUE.
      /IF.
      IF ck IS "$" AND k + 1 < n AND char_at(content, k + 1) IS "{",
        SET fnd TO k.
        BREAK 0.
      /IF.
      SET k TO k + 1.
    /SEASON.
    IF fnd IS -1,
      REAP last FROM substring, content, i, n.
      PUT last INTO segs.
      BREAK 0.
    /IF.
    REAP lit FROM substring, content, i, fnd.
    PUT lit INTO segs.
    CREATE d2(NUM) TO 1.
    CREATE j2(NUM) TO fnd + 2.
    CREATE inner(TX) TO "".
    SEASON d2 > 0 AND j2 < n,
      REAP cj2 FROM char_at, content, j2.
      IF cj2 IS "\\",
        SET j2 TO j2 + 2.
        CONTINUE.
      /IF.
      IF cj2 IS "$" AND j2 + 1 < n AND char_at(content, j2 + 1) IS "{",
        SET d2 TO d2 + 1.
        SET j2 TO j2 + 2.
        CONTINUE.
      /IF.
      IF cj2 IS "}",
        SET d2 TO d2 - 1.
        IF d2 IS 0,
          SET inner TO substring(content, fnd + 2, j2).
          SET j2 TO j2 + 1.
          CONTINUE.
        /IF.
      /IF.
      SET j2 TO j2 + 1.
    /SEASON.
    IF inner IS "",
      PUT "__PLANT_EMPTY_INTERP__" INTO segs.
    /IF.
    IF inner ISNT "",
      PUT inner INTO segs.
    /IF.
    SET i TO j2.
    IF d2 > 0,
      GIVE "\n#error unterminated string interpolation: missing }\n".
    /IF.
  /SEASON.
  CREATE fparts(LIST) TO plant_list_make(0).
  CREATE si2(NUM) TO 0.
  CREATE is_lit(NUM) TO 1.
  CREATE seg(TX) TO "".
  CREATE ws(TX) TO "".
  CREATE seg2(TX) TO "".
  SEASON si2 < COUNT segs,
    REAP seg FROM plant_list_get, segs, si2.
    IF is_lit IS 1,
      SET ws TO "\"" + seg + "\"".
      PUT ws INTO fparts.
    /IF.
    IF is_lit IS 0,
      SET seg2 TO "".
      IF seg IS "__PLANT_EMPTY_INTERP__",
        SET seg2 TO "\"" + "\"".
      /IF.
      IF seg ISNT "__PLANT_EMPTY_INTERP__",
        REAP seg2 FROM _unescape, seg.
        REAP seg2 FROM _expand_bare, seg2, nums, evars.
        REAP seg2 FROM _interp_to_cat, seg2, nums, evars.
        REAP seg2 FROM translate_expr, seg2, nums, evars.
        REAP seg2 FROM _handle_cat, seg2, nums, evars.
        REAP sg2n FROM seg_is_numeric, seg2, nums.
        IF sg2n IS 1,
          REAP dgl FROM _is_digit_lit, seg2.
          IF dgl IS 1,
            SET seg2 TO "_from_digit(" + seg2 + ")".
          /IF.
          IF dgl ISNT 1,
            SET seg2 TO "_from_long(" + seg2 + ")".
          /IF.
        /IF.
        IF sg2n IS 0,
          REAP snm2 FROM enum_expr_of, evars, seg2.
          IF snm2 ISNT "",
            SET seg2 TO "_from_enum(" + seg2 + ", \"" + snm2 + "\")".
          /IF.
        /IF.
      /IF.
      SET ws TO seg2.
      PUT ws INTO fparts.
    /IF.
    SET is_lit TO 1 - is_lit.
    SET si2 TO si2 + 1.
  /SEASON.
  REAP out FROM _emit_cat_chain, fparts.
  GIVE out.
/ACTION.

# ──────────────────────────────────────────────────────────────
ACTION _handle_cat(expr(TX), nums(LIST), evars(LIST)),
    REAP expr FROM _interp_to_cat, expr, nums, evars.
    CREATE parts(LIST) TO plant_list_make(0).
    CREATE depth(NUM) TO 0.
    CREATE instr(NUM) TO 0.
    CREATE i(NUM) TO 0.
    CREATE ch(TX) TO "".
    CREATE c0(TX) TO "".
    CREATE c1(TX) TO "".
    CREATE seg(TX) TO "".
    CREATE start(NUM) TO 0.
    CREATE res(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE pel(TX) TO "".
    CREATE has_str(NUM) TO 0.
    # scan for top-level " + " (outside parens, brackets, and
    # strings) and split there. v0.49.6 — [ and { join the depth
    # tracking so a whole [ ... ] / { ... } literal passes through
    # the splitter untouched (["a" + "b", "c"] reaches _list_literal
    # whole; the elements get their own concat handling in _enc_el).
    SEASON i < LEN(expr),
        REAP ch FROM char_at, expr, i.
        IF ch IS "\"", SET instr TO 1 - instr. /IF.
        IF instr IS 1 AND ch IS "\\", SET i TO i + 1. /IF.
        IF instr IS 0 AND (ch IS "(" OR ch IS "[" OR ch IS "{"), SET depth TO depth + 1. /IF.
        IF instr IS 0 AND (ch IS ")" OR ch IS "]" OR ch IS "}"), SET depth TO depth - 1. /IF.
        IF instr IS 0 AND ch IS "+" AND depth IS 0,
            REAP c0 FROM char_at, expr, i - 1.
            REAP c1 FROM char_at, expr, i + 1.
            IF c0 IS " " AND c1 IS " ",
                REAP seg FROM substring, expr, start, i - 1.
                PUT seg INTO parts.
                SET start TO i + 2.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    REAP seg FROM substring, expr, start, LEN(expr).
    IF (COUNT parts) IS 0, GIVE expr. /IF.
    # v0.49.10 — has_str is a top-level string-literal segment, not
    # any quote in the text: the field-name strings inside
    # _map_get(...) segments (parser-emitted a.b.c lookups) must not
    # force the _cat path when a numeric literal is also present
    # (m.count + 1 is long arithmetic)
    CREATE hp9(NUM) TO 0.
    CREATE hseg(TX) TO "".
    CREATE hqb(NUM) TO 0.
    CREATE hqc(TX) TO "".
    CREATE hp1(TX) TO "".
    # a top-level segment is a string when it starts with a quote
    # ("x=" + m.name) or carries quotes inside a call (interp
    # results like _cat3("", s, "")), but NOT when it is a
    # parser-emitted field lookup — m.count + 1 stays arithmetic
    # (the raw path wraps those in _to_long)
    SEASON hp9 < COUNT parts,
        REAP hseg FROM plant_list_get, parts, hp9.
        REAP hp0 FROM substring, hseg, 0, 1.
        IF hp0 IS "\"", SET has_str TO 1. /IF.
        IF is_lookup_prefix(hseg) ISNT "1",
            SET hqb TO 0.
            SEASON hqb < LEN(hseg),
                REAP hqc FROM char_at, hseg, hqb.
                IF hqc IS "\"", SET has_str TO 1. /IF.
                SET hqb TO hqb + 1.
            /SEASON.
        /IF.
        SET hp9 TO hp9 + 1.
    /SEASON.
    # the tail segment after the final " + " lives in seg, not in
    # parts — it must count as a top-level string literal too
    REAP sp0 FROM substring, seg, 0, 1.
    IF sp0 IS "\"", SET has_str TO 1. /IF.
    IF is_lookup_prefix(seg) ISNT "1",
        SET hqb TO 0.
        SEASON hqb < LEN(seg),
            REAP hqc FROM char_at, seg, hqb.
            IF hqc IS "\"", SET has_str TO 1. /IF.
            SET hqb TO hqb + 1.
        /SEASON.
    /IF.
    # genuine numeric literal present (digit outside identifiers, e.g.
    # "1" in "p5 + 1") and no quoted string → raw numeric C "+", the
    # v0.48.3 shortcut REAP'd index vars (tx_t holding bit patterns)
    # depend on. Identifier digits alone (ccode + eb2) never fire it.
    CREATE has_lit(NUM) TO 0.
    CREATE ni9(NUM) TO 0.
    CREATE p9(TX) TO "".
    SEASON ni9 < COUNT parts,
        REAP p9 FROM plant_list_get, parts, ni9.
        REAP hl9 FROM seg_has_literal_digit, p9.
        IF hl9 IS 1, SET has_lit TO 1. /IF.
        SET ni9 TO ni9 + 1.
    /SEASON.
    REAP hl9 FROM seg_has_literal_digit, seg.
    IF hl9 IS 1, SET has_lit TO 1. /IF.
    IF has_str IS 0 AND has_lit IS 1,
        # v0.49.10 — field-access segments (parser-emitted
        # _map_get(...) calls) are tx_t lookups; a numeric literal
        # elsewhere in the chain makes it arithmetic, so each
        # top-level field segment wraps in _to_long before the raw
        # "+" shortcut (n + 1 stays long arithmetic; n + s stays _cat)
        CREATE wparts(LIST) TO plant_list_make(0).
        CREATE wi2(NUM) TO 0.
        CREATE wseg(TX) TO "".
        SEASON wi2 < COUNT parts,
            REAP wseg FROM plant_list_get, parts, wi2.
            IF is_lookup_prefix(wseg) IS "1",
                SET wseg TO "_to_long(" + wseg + ")".
            /IF.
            PUT wseg INTO wparts.
            SET wi2 TO wi2 + 1.
        /SEASON.
        IF is_lookup_prefix(seg) IS "1",
            SET seg TO "_to_long(" + seg + ")".
        /IF.
        PUT seg INTO wparts.
        # digit-free vars: the stale bootstrap compiler takes its
        # has_digit raw-+ shortcut on pure var+var concatenations
        CREATE wres(TX) TO "".
        CREATE wi3(NUM) TO 0.
        CREATE wsegb(TX) TO "".
        SEASON wi3 < COUNT wparts,
            REAP wsegb FROM plant_list_get, wparts, wi3.
            IF wres > "", SET wres TO wres + " + ". /IF.
            SET wres TO wres + wsegb.
            SET wi3 TO wi3 + 1.
        /SEASON.
        GIVE strings_REPLACE(wres, " + ", "+").
    /IF.
    # no genuine literal: ambiguous — every segment verifiably numeric
    # (digit literal, NUM/FACT var in nums, known numeric-returning
    # call) → keep C "+"; otherwise fall through so string variables
    # concatenate (identifiers with digits like eb2 route to _cat,
    # v0.48.20-patch).
    IF has_str IS 0,
        CREATE allnum(NUM) TO 1.
        CREATE ni0(NUM) TO 0.
        CREATE pe0(TX) TO "".
        SEASON ni0 < COUNT parts,
            REAP pe0 FROM plant_list_get, parts, ni0.
            REAP sg0 FROM seg_is_numeric, pe0, nums.
            IF sg0 IS 0, SET allnum TO 0. /IF.
            SET ni0 TO ni0 + 1.
        /SEASON.
        REAP sg0 FROM seg_is_numeric, seg, nums.
        IF sg0 IS 0, SET allnum TO 0. /IF.
        IF allnum IS 1,
            GIVE strings_REPLACE(expr, " + ", "+").
        /IF.
    /IF.
    PUT seg INTO parts.
    CREATE nparts(LIST) TO plant_list_make(0).
    CREATE ni(NUM) TO 0.
    CREATE pel2(TX) TO "".
    CREATE dgl(NUM) TO 0.
    SEASON ni < COUNT parts,
        REAP pel2 FROM plant_list_get, parts, ni.
        REAP sgn FROM seg_is_numeric, pel2, nums.
        IF sgn IS 1,
            REAP dgl FROM _is_digit_lit, pel2.
            IF dgl IS 1,
                SET pel2 TO "_from_digit(" + pel2 + ")".
            /IF.
            IF dgl ISNT 1,
                SET pel2 TO "_from_long(" + pel2 + ")".
            /IF.
        /IF.
        REAP snm FROM enum_expr_of, evars, pel2.
        IF sgn IS 0 AND snm ISNT "",
            SET pel2 TO "_from_enum(" + pel2 + ", \"" + snm + "\")".
        /IF.
        PUT pel2 INTO nparts.
        SET ni TO ni + 1.
    /SEASON.
    REAP res FROM _emit_cat_chain, nparts.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  collect_implicit — REAP targets never declared (params,
#  CREATE/LET) in an action body; auto-declare them as tx_t.
# ──────────────────────────────────────────────────────────────
#  _if_bodies — flatten an if_stmt's branch bodies (main body,
#  every ORIF body, and the ELSE body) into one list so every
#  statement-walking pass treats all branches uniformly (v0.48.20).
# ──────────────────────────────────────────────────────────────
ACTION _if_bodies(nd),
  CREATE out(LIST) TO plant_list_make(0).
  REAP mb FROM _map_get, nd, "body".
  PUT mb INTO out.
  REAP el FROM _map_get, nd, "elif".
  CREATE ei(NUM) TO 1.
  SEASON ei < COUNT el,
    REAP eb FROM plant_list_get, el, ei.
    PUT eb INTO out.
    SET ei TO ei + 2.
  /SEASON.
  REAP eb2 FROM _map_get, nd, "else".
  IF COUNT eb2 > 0,
    PUT eb2 INTO out.
  /IF.
  GIVE out.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _weather_bodies — flatten a weather_stmt's protected body,
#  every SHELTER handler body, and the CALM body into one list so
#  every statement-walking pass treats all three uniformly
#  (v0.48.23). The shelters table is a flat [type, bind, body, …]
#  triple list, so handler bodies sit at indices 2, 5, 8, …
# ──────────────────────────────────────────────────────────────
ACTION _weather_bodies(nd),
  CREATE out(LIST) TO plant_list_make(0).
  REAP wb FROM _map_get, nd, "body".
  PUT wb INTO out.
  REAP sh FROM _map_get, nd, "shelters".
  CREATE si(NUM) TO 2.
  SEASON si < COUNT sh,
    REAP sb FROM plant_list_get, sh, si.
    PUT sb INTO out.
    SET si TO si + 3.
  /SEASON.
  REAP cb FROM _map_get, nd, "calm".
  IF COUNT cb > 0,
    PUT cb INTO out.
  /IF.
  GIVE out.
/ACTION.

ACTION collect_declared_walk(bd(LIST), declared(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "create_stmt" OR ty IS "let_stmt",
      REAP tgt FROM _map_get, nd, "target".
      PUT tgt INTO declared.
    /IF.
    IF ty IS "if_stmt",
      REAP ib FROM _if_bodies, nd.
      CREATE ii2(NUM) TO 0.
      SEASON ii2 < COUNT ib,
        REAP ibd FROM plant_list_get, ib, ii2.
        REAP sub_ret FROM collect_declared_walk, ibd, declared.
        SET ii2 TO ii2 + 1.
      /SEASON.
    /IF.
    IF ty IS "season_stmt",
      REAP sub_bd FROM _map_get, nd, "body".
      REAP sub_ret FROM collect_declared_walk, sub_bd, declared.
    /IF.
    IF ty IS "cycle_stmt",
      REAP sub_bd FROM _map_get, nd, "body".
      REAP sub_ret FROM collect_declared_walk, sub_bd, declared.
    /IF.
    IF ty IS "weather_stmt",
      REAP wbd2 FROM _weather_bodies, nd.
      CREATE wbi2(NUM) TO 0.
      SEASON wbi2 < COUNT wbd2,
        REAP wbel2 FROM plant_list_get, wbd2, wbi2.
        REAP sub_ret FROM collect_declared_walk, wbel2, declared.
        SET wbi2 TO wbi2 + 1.
      /SEASON.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE "ok".
/ACTION.

ACTION collect_used_walk(bd(LIST), used(LIST), declared(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "reap_stmt",
      REAP tgt FROM _map_get, nd, "target".
      CREATE found(NUM) TO 0.
      CREATE fi(NUM) TO 0.
      CREATE fe(TX) TO "".
      SEASON fi < COUNT declared,
        REAP fe FROM plant_list_get, declared, fi.
        IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
        SET fi TO fi + 1.
      /SEASON.
      SET fi TO 0.
      SEASON fi < COUNT used,
        REAP fe FROM plant_list_get, used, fi.
        IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
        SET fi TO fi + 1.
      /SEASON.
      IF NOT found,
        PUT tgt INTO used.
      /IF.
    /IF.
    # v0.49.9 — reap_expr_stmt targets (REAP x FROM a[0]. / FIND(…)
    # / a + b) are implicit vars too: they need the tx_t "" implicit
    # declaration pass exactly like reap_stmt targets.
    IF ty IS "reap_expr_stmt",
      REAP tgt FROM _map_get, nd, "target".
      CREATE found(NUM) TO 0.
      CREATE fi(NUM) TO 0.
      CREATE fe(TX) TO "".
      SEASON fi < COUNT declared,
        REAP fe FROM plant_list_get, declared, fi.
        IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
        SET fi TO fi + 1.
      /SEASON.
      SET fi TO 0.
      SEASON fi < COUNT used,
        REAP fe FROM plant_list_get, used, fi.
        IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
        SET fi TO fi + 1.
      /SEASON.
      IF NOT found,
        PUT tgt INTO used.
      /IF.
    /IF.
    # v0.48.36 — TYPEOF/ANALYZE on a bare identifier that is never
    # declared (params, CREATE/LET) or REAP'd: auto-declare it as
    # tx_t "" so the query runs against an empty (null) value instead
    # of producing undeclared-identifier C. Expression targets
    # (calls, concats) are left to the declared set.
    IF ty IS "typeof_stmt" OR ty IS "analyze_stmt",
      REAP tgt FROM _map_get, nd, "target".
      REAP tid FROM is_identifier, tgt.
      # NULL/TRUE/FALSE are C-side constants, never implicit vars
      IF tid IS 1 AND tgt ISNT "NULL" AND tgt ISNT "TRUE" AND tgt ISNT "FALSE",
        CREATE found(NUM) TO 0.
        CREATE fi(NUM) TO 0.
        CREATE fe(TX) TO "".
        SEASON fi < COUNT declared,
          REAP fe FROM plant_list_get, declared, fi.
          IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
          SET fi TO fi + 1.
        /SEASON.
        SET fi TO 0.
        SEASON fi < COUNT used,
          REAP fe FROM plant_list_get, used, fi.
          IF str_eq(fe, tgt) IS "1", SET found TO 1. /IF.
          SET fi TO fi + 1.
        /SEASON.
        IF NOT found,
          PUT tgt INTO used.
        /IF.
      /IF.
    /IF.
    IF ty IS "if_stmt",
      REAP ib FROM _if_bodies, nd.
      CREATE ii2(NUM) TO 0.
      SEASON ii2 < COUNT ib,
        REAP ibd FROM plant_list_get, ib, ii2.
        REAP sub_ret FROM collect_used_walk, ibd, used, declared.
        SET ii2 TO ii2 + 1.
      /SEASON.
    /IF.
    IF ty IS "season_stmt",
      REAP sub_bd FROM _map_get, nd, "body".
      REAP sub_ret FROM collect_used_walk, sub_bd, used, declared.
    /IF.
    IF ty IS "cycle_stmt",
      REAP sub_bd FROM _map_get, nd, "body".
      REAP sub_ret FROM collect_used_walk, sub_bd, used, declared.
    /IF.
    IF ty IS "weather_stmt",
      REAP wbd3 FROM _weather_bodies, nd.
      CREATE wbi3(NUM) TO 0.
      SEASON wbi3 < COUNT wbd3,
        REAP wbel3 FROM plant_list_get, wbd3, wbi3.
        REAP sub_ret FROM collect_used_walk, wbel3, used, declared.
        SET wbi3 TO wbi3 + 1.
      /SEASON.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE "ok".
/ACTION.

ACTION collect_implicit(bd(LIST), params(LIST)),
  CREATE used(LIST) TO plant_list_make(0).
  CREATE declared(LIST) TO plant_list_make(0).
  CREATE ci(NUM) TO 0.
  CREATE pn(TX) TO "".
  SEASON ci < COUNT params,
    REAP pn FROM _map_get, params[ci], "name".
    PUT pn INTO declared.
    SET ci TO ci + 1.
  /SEASON.
  REAP sub_ret FROM collect_declared_walk, bd, declared.
  REAP sub_ret FROM collect_used_walk, bd, used, declared.
  GIVE used.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  v0.48.6 — ENUM display repair
#  collect_enums_* — flat [name, membersCsv, …] table of every
#  enum-typed variable reachable in an action body plus every enum
#  member constant (module-scope). membersCsv is the comma-joined
#  member list of the enum type (built by build_enum_registry from
#  the module AST). Used at SHOW/concat sites to wrap enum refs
#  with _from_enum(var, "RED,GREEN,BLUE") so they print member
#  names instead of crashing on raw enum-int-as-pointer.
# ──────────────────────────────────────────────────────────────
ACTION build_enum_registry(ast(LIST)),
  CREATE reg(LIST) TO plant_list_make(0).
  CREATE ei(NUM) TO 0.
  CREATE ne(TX) TO "".
  CREATE nty(TX) TO "".
  SEASON ei < COUNT ast,
    REAP ne FROM plant_list_get, ast, ei.
    REAP nty FROM _map_get, ne, "type".
    IF nty IS "enum_decl",
      REAP enm FROM _map_get, ne, "name".
      CREATE mems(LIST) TO _map_get(ne, "members").
      CREATE csv(TX) TO "".
      CREATE mi(NUM) TO 0.
      SEASON mi < COUNT mems,
        IF mi > 0, SET csv TO csv + ",". /IF.
        SET csv TO csv + plant_list_get(mems, mi).
        SET mi TO mi + 1.
      /SEASON.
      PUT enm INTO reg.
      PUT csv INTO reg.
    /IF.
    SET ei TO ei + 1.
  /SEASON.
  # struct entries: "STRUCT.<Name>" → "gensCsv;fieldCsv" (raw field
  # types, generics comma-joined, fields "name:type" comma-joined).
  # collect_enums uses them to register enum field reads of
  # struct-typed vars as plant_map_get(var, "field") keys (v0.48.10).
  CREATE si(NUM) TO 0.
  CREATE sn(TX) TO "".
  CREATE sty(TX) TO "".
  SEASON si < COUNT ast,
    REAP sn FROM plant_list_get, ast, si.
    REAP sty FROM _map_get, sn, "type".
    IF sty IS "struct_decl",
      REAP sname2 FROM _map_get, sn, "name".
      CREATE gslst(LIST) TO _map_get(sn, "generics").
      CREATE fslst(LIST) TO _map_get(sn, "fields").
      CREATE gcsv(TX) TO "".
      CREATE gidx(NUM) TO 0.
      SEASON gidx < COUNT gslst,
        IF gidx > 0, SET gcsv TO gcsv + ",". /IF.
        SET gcsv TO gcsv + plant_list_get(gslst, gidx).
        SET gidx TO gidx + 1.
      /SEASON.
      CREATE fcsv(TX) TO "".
      CREATE fidx(NUM) TO 0.
      CREATE fel3(TX) TO "".
      SEASON fidx < COUNT fslst,
        REAP fel3 FROM plant_list_get, fslst, fidx.
        IF fidx > 0, SET fcsv TO fcsv + ",". /IF.
        SET fcsv TO fcsv + _map_get(fel3, "name") + ":" + _map_get(fel3, "type").
        SET fidx TO fidx + 1.
      /SEASON.
      CREATE srekey(TX) TO "STRUCT." + sname2.
      CREATE sreval(TX) TO gcsv + ";" + fcsv.
      PUT srekey INTO reg.
      PUT sreval INTO reg.
    /IF.
    SET si TO si + 1.
  /SEASON.
  GIVE reg.
/ACTION.

# add_struct_enum_keys — for a struct-typed variable, register the
# enum field reads plant_map_get(var, "field") into the flat table
# res (keyed by the canonical token-joined expression form emitted
# by translate_expr). vtype is the (subst'd) declared type; enum
# fields of generic structs resolve through their type args.
ACTION add_struct_enum_keys(reg(LIST), vtype(TX), vname(TX), res(LIST)),
  CREATE vty2(TX) TO vtype.
  REAP rp0 FROM substring, vty2, 0, 4.
  IF rp0 IS "REF ", SET vty2 TO substring(vty2, 4, LEN(vty2)). /IF.
  REAP rp1 FROM substring, vty2, 0, 7.
  IF rp1 IS "STRUCT ", SET vty2 TO substring(vty2, 7, LEN(vty2)). /IF.
  REAP wbase2 FROM type_base, vty2.
  CREATE srlk(TX) TO "STRUCT." + wbase2.
  REAP raw2 FROM _cl_map_get, reg, srlk.
  IF raw2 IS "", GIVE res. /IF.
  REAP halves FROM strings:SPLIT, raw2, ";".
  CREATE gens2(LIST) TO plant_list_make(0).
  CREATE flds2(LIST) TO plant_list_make(0).
  IF COUNT halves > 0, REAP gens2 FROM strings:SPLIT, halves[0], ",". /IF.
  IF COUNT halves > 1, REAP flds2 FROM strings:SPLIT, halves[1], ",". /IF.
  REAP args2 FROM parse_type_args, vtype.
  CREATE fsub2(LIST) TO build_subst(gens2, args2).
  CREATE fi2(NUM) TO 0.
  CREATE fe2(TX) TO "".
  CREATE fnm2(TX) TO "".
  CREATE fty2(TX) TO "".
  SEASON fi2 < COUNT flds2,
    REAP fe2 FROM plant_list_get, flds2, fi2.
    REAP colon2 FROM find_any, fe2, ":".
    IF colon2 ISNT -1,
      REAP fnm2 FROM substring, fe2, 0, colon2.
      REAP fty2 FROM substring, fe2, colon2 + 1, LEN(fe2).
      REAP fty2 FROM subst_type, fty2, fsub2.
      REAP fcsv2 FROM enum_members_of, reg, fty2.
      IF fcsv2 ISNT "",
        CREATE ekey2(TX) TO "plant_map_get ( " + vname + " , \"" + fnm2 + "\" )".
        REAP ef2 FROM list_contains, res, ekey2.
        IF ef2 IS 0,
          PUT ekey2 INTO res.
          PUT fcsv2 INTO res.
        /IF.
      /IF.
    /IF.
    SET fi2 TO fi2 + 1.
  /SEASON.
  GIVE res.
/ACTION.

# enum_members_of — membersCsv for a type in a flat registry, or ""
ACTION enum_members_of(reg(LIST), ty(TX)),
  CREATE res(TX) TO "".
  CREATE ty2(TX) TO ty.
  REAP rp0 FROM substring, ty2, 0, 5.
  IF rp0 IS "ENUM ", SET ty2 TO substring(ty2, 5, LEN(ty2)). /IF.
  CREATE ri(NUM) TO 0.
  CREATE rn(TX) TO "".
  CREATE rv(TX) TO "".
  SEASON ri + 1 < COUNT reg,
    REAP rn FROM plant_list_get, reg, ri.
    REAP rv FROM plant_list_get, reg, ri + 1.
    IF str_eq(rn, ty2) IS "1", SET res TO rv. /IF.
    SET ri TO ri + 2.
  /SEASON.
  GIVE res.
/ACTION.

# reg_has_enum — 1 when the registry carries at least one ENUM
# entry (a key that is not one of the "STRUCT." field tables).
# Modules without enums fast-skip the whole collect_enums body
# traversal instead of walking every statement (v0.48.11).
ACTION reg_has_enum(reg(LIST)),
  CREATE ri(NUM) TO 0.
  CREATE rk(TX) TO "".
  CREATE rpre(TX) TO "".
  SEASON ri + 1 < COUNT reg,
    REAP rk FROM plant_list_get, reg, ri.
    REAP rpre FROM substring, rk, 0, 7.
    IF rpre ISNT "STRUCT.",
      GIVE 1.
    /IF.
    SET ri TO ri + 2.
  /SEASON.
  GIVE 0.
/ACTION.

# collect_enums_walk — add enum-typed CREATE/LET targets (as
# [name, membersCsv] pairs) from a body, recursing IF/SEASON/CYCLE/
# MATCH bodies, into the flat table res. REAP targets inherit the
# callee's return type from sigs so struct-returning calls register
# their struct field reads too (v0.48.10).
ACTION collect_enums_walk(bd, subst, reg, sigs, res),
  CREATE wi(NUM) TO 0.
  CREATE wnd(TX) TO "".
  CREATE wty(TX) TO "".
  CREATE wtg(TX) TO "".
  CREATE wvt(TX) TO "".
  CREATE wbs(TX) TO "".
  CREATE wms(TX) TO "".
  SEASON wi < COUNT bd,
    REAP wnd FROM plant_list_get, bd, wi.
    REAP wty FROM _map_get, wnd, "type".
    IF wty IS "create_stmt" OR wty IS "let_stmt",
      REAP wtg FROM _map_get, wnd, "target".
      REAP wvt FROM _map_get, wnd, "var_type".
      REAP wbs FROM subst_type, wvt, subst.
      REAP wms FROM enum_members_of, reg, wbs.
      IF wms > "",
        REAP wfound FROM list_contains, res, wtg.
        IF wfound IS 0,
          PUT wtg INTO res.
          PUT wms INTO res.
        /IF.
      /IF.
      IF wms IS "",
        REAP wrf FROM add_struct_enum_keys, reg, wbs, wtg, res.
      /IF.
    /IF.
    IF wty IS "reap_stmt",
      REAP wtg FROM _map_get, wnd, "target".
      IF wtg ISNT "_" AND wtg ISNT "null",
        REAP wact FROM _map_get, wnd, "action".
        REAP wbase FROM base_of, wact.
        REAP wsig FROM find_sig, sigs, wbase.
        IF COUNT wsig > 0,
          REAP wst2 FROM _map_get, wsig, "type".
          REAP wret FROM _map_get, wsig, "ret".
          IF wret > "",
            REAP wrf FROM add_struct_enum_keys, reg, wret, wtg, res.
            # FFI (external) callees return raw member ints from C:
            # register the target so the call site wraps it with
            # _from_enum and displays/concat resolve (v0.48.12)
            IF wst2 IS "external_decl",
              REAP wretb FROM subst_type, wret, subst.
              REAP wms2 FROM enum_members_of, reg, wretb.
              IF wms2 > "",
                REAP wf2 FROM list_contains, res, wtg.
                IF wf2 IS 0,
                  PUT wtg INTO res.
                  PUT wms2 INTO res.
                /IF.
              /IF.
            /IF.
          /IF.
        /IF.
      /IF.
    /IF.
    IF wty IS "if_stmt",
      REAP ib FROM _if_bodies, wnd.
      CREATE ii3(NUM) TO 0.
      SEASON ii3 < COUNT ib,
        REAP ibd3 FROM plant_list_get, ib, ii3.
        REAP wret FROM collect_enums_walk, ibd3, subst, reg, sigs, res.
        SET ii3 TO ii3 + 1.
      /SEASON.
    /IF.
    IF wty IS "season_stmt" OR wty IS "cycle_stmt",
      CREATE sbl(LIST) TO _map_get(wnd, "body").
      REAP wret FROM collect_enums_walk, sbl, subst, reg, sigs, res.
    /IF.
    IF wty IS "match_stmt",
      CREATE mcl1(LIST) TO _map_get(wnd, "clauses").
      CREATE mci1(NUM) TO 0.
      SEASON mci1 < COUNT mcl1,
        REAP mcl2 FROM plant_list_get, mcl1, mci1.
        REAP mcb1 FROM _map_get, mcl2, "bodyStatements".
        REAP wret FROM collect_enums_walk, mcb1, subst, reg, sigs, res.
        SET mci1 TO mci1 + 1.
      /SEASON.
    /IF.
    IF wty IS "weather_stmt",
      REAP wbl4 FROM _weather_bodies, wnd.
      CREATE wbi4(NUM) TO 0.
      SEASON wbi4 < COUNT wbl4,
        REAP wbel4 FROM plant_list_get, wbl4, wbi4.
        REAP wret FROM collect_enums_walk, wbel4, subst, reg, sigs, res.
        SET wbi4 TO wbi4 + 1.
      /SEASON.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE res.
/ACTION.

# collect_enums — every enum member name (module-scope constants)
# plus enum-typed params and CREATE/LET targets, as a flat
# [name, membersCsv, …] table. Struct-typed vars/params/reap targets
# contribute plant_map_get(var, "field") keys for enum fields.
ACTION collect_enums(bd, params, subst, reg, sigs),
  CREATE res(LIST) TO plant_list_make(0).
  REAP he2 FROM reg_has_enum, reg.
  IF he2 IS 0, GIVE res. /IF.
  CREATE pi(NUM) TO 0.
  CREATE pn2(TX) TO "".
  CREATE pt2(TX) TO "".
  CREATE psu2(TX) TO "".
  CREATE pm2(TX) TO "".
  SEASON pi < COUNT params,
    REAP pn2 FROM _map_get, params[pi], "name".
    REAP pt2 FROM _map_get, params[pi], "type".
    REAP psu2 FROM subst_type, pt2, subst.
    REAP pm2 FROM enum_members_of, reg, psu2.
    IF pm2 ISNT "",
      REAP pfound FROM list_contains, res, pn2.
      IF pfound IS 0,
        PUT pn2 INTO res.
        PUT pm2 INTO res.
      /IF.
    /IF.
    IF pm2 IS "",
      REAP prf FROM add_struct_enum_keys, reg, psu2, pn2, res.
    /IF.
    SET pi TO pi + 1.
  /SEASON.
  # member constants: every member name maps to its enum's csv
  CREATE ri(NUM) TO 0.
  CREATE rn(TX) TO "".
  CREATE rv(TX) TO "".
  SEASON ri + 1 < COUNT reg,
    REAP rn FROM plant_list_get, reg, ri.
    REAP rv FROM plant_list_get, reg, ri + 1.
    CREATE ms(LIST) TO plant_list_make(0).
    REAP ms FROM strings:SPLIT, rv, ",".
    CREATE mi(NUM) TO 0.
    CREATE mname(TX) TO "".
    SEASON mi < COUNT ms,
      REAP mname FROM plant_list_get, ms, mi.
      IF mname > "",
        REAP mf FROM list_contains, res, mname.
        IF mf IS 0,
          PUT mname INTO res.
          PUT rv INTO res.
        /IF.
      /IF.
      SET mi TO mi + 1.
    /SEASON.
    # enum type names resolve FFI formal params at call sites (v0.48.12)
    REAP rpre0 FROM substring, rn, 0, 7.
    IF rpre0 ISNT "STRUCT.",
      REAP tf FROM list_contains, res, rn.
      IF tf IS 0,
        PUT rn INTO res.
        PUT rv INTO res.
      /IF.
    /IF.
    SET ri TO ri + 2.
  /SEASON.
  # FFI call names with ENUM returns: inline ffi_color() expressions
  # display/concat correctly (matched via enum_expr_of) (v0.48.12)
  CREATE fi3(NUM) TO 0.
  CREATE fs3(TX) TO "".
  SEASON fi3 < COUNT sigs,
    REAP fs3 FROM plant_list_get, sigs, fi3.
    REAP fst3 FROM _map_get, fs3, "type".
    IF fst3 IS "external_decl",
      REAP fsnm3 FROM _map_get, fs3, "name".
      REAP fsrt3 FROM _map_get, fs3, "ret".
      REAP fsc3 FROM enum_members_of, reg, fsrt3.
      IF fsc3 ISNT "",
        REAP fsf3 FROM list_contains, res, fsnm3.
        IF fsf3 IS 0,
          PUT fsnm3 INTO res.
          PUT fsc3 INTO res.
        /IF.
      /IF.
    /IF.
    SET fi3 TO fi3 + 1.
  /SEASON.
  REAP wr FROM collect_enums_walk, bd, subst, reg, sigs, res.
  GIVE res.
/ACTION.

# enum_in_table — membersCsv for a name in a flat enum table, or ""
ACTION enum_in_table(evars(LIST), name(TX)),
  CREATE res(TX) TO "".
  CREATE ej(NUM) TO 0.
  CREATE ekey(TX) TO "".
  CREATE eval(TX) TO "".
  SEASON ej + 1 < COUNT evars,
    REAP ekey FROM plant_list_get, evars, ej.
    REAP eval FROM plant_list_get, evars, ej + 1.
    IF str_eq(ekey, name) IS "1", SET res TO eval. /IF.
    SET ej TO ej + 2.
  /SEASON.
  GIVE res.
/ACTION.

# enum_expr_of — membersCsv for a value expression: exact key, or
# the call prefix of an inline call like ffi_color(1) → ffi_color
# (FFI call names with ENUM returns are registered bare) (v0.48.12)
ACTION enum_expr_of(evars(LIST), cval(TX)),
  REAP e2 FROM enum_in_table, evars, cval.
  IF e2 ISNT "", GIVE e2. /IF.
  REAP lp2 FROM find_any, cval, "(".
  IF lp2 ISNT -1,
    REAP lpre2 FROM substring, cval, 0, lp2.
    REAP lpre2 FROM trim, lpre2.
    REAP e2 FROM enum_in_table, evars, lpre2.
    IF e2 ISNT "", GIVE e2. /IF.
  /IF.
  GIVE "".
/ACTION.
ACTION list_contains(lst(LIST), x(TX)),
  CREATE found(NUM) TO 0.
  CREATE li(NUM) TO 0.
  CREATE le(TX) TO "".
  SEASON li < COUNT lst,
    REAP le FROM plant_list_get, lst, li.
    IF str_eq(le, x) IS "1", SET found TO 1. /IF.
    SET li TO li + 1.
  /SEASON.
  GIVE found.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  collect_nums_walk — add names of scalar NUM/FACT CREATE/LET
#  targets in bd (recursing into IF/SEASON/CYCLE/MATCH bodies)
# ──────────────────────────────────────────────────────────────
ACTION collect_nums_walk(bd(LIST), subst(LIST), res(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE wnd(TX) TO "".
  CREATE wty(TX) TO "".
  CREATE wtg(TX) TO "".
  CREATE wvt(TX) TO "".
  CREATE wbs(TX) TO "".
  CREATE wbb(TX) TO "".
  SEASON wi < COUNT bd,
    REAP wnd FROM plant_list_get, bd, wi.
    REAP wty FROM _map_get, wnd, "type".
    IF wty IS "create_stmt" OR wty IS "let_stmt",
      REAP wtg FROM _map_get, wnd, "target".
      REAP wvt FROM _map_get, wnd, "var_type".
      REAP wbs FROM subst_type, wvt, subst.
      REAP wbb FROM type_base, wbs.
      IF wbb IS "NUM" OR wbb IS "FACT",
        REAP wfound FROM list_contains, res, wtg.
        IF wfound IS 0, PUT wtg INTO res. /IF.
      /IF.
    /IF.
    IF wty IS "if_stmt",
      REAP ib FROM _if_bodies, wnd.
      CREATE ii4(NUM) TO 0.
      SEASON ii4 < COUNT ib,
        REAP ibd4 FROM plant_list_get, ib, ii4.
        REAP wret2 FROM collect_nums_walk, ibd4, subst, res.
        SET ii4 TO ii4 + 1.
      /SEASON.
    /IF.
    IF wty IS "season_stmt" OR wty IS "cycle_stmt",
      REAP wbd2 FROM _map_get, wnd, "body".
      REAP wret2 FROM collect_nums_walk, wbd2, subst, res.
    /IF.
    IF wty IS "match_stmt",
      CREATE mcl3(LIST) TO _map_get(wnd, "clauses").
      CREATE mci3(NUM) TO 0.
      SEASON mci3 < COUNT mcl3,
        REAP mcl4 FROM plant_list_get, mcl3, mci3.
        REAP mcb2 FROM _map_get, mcl4, "bodyStatements".
        REAP wret2 FROM collect_nums_walk, mcb2, subst, res.
        SET mci3 TO mci3 + 1.
      /SEASON.
    /IF.
    IF wty IS "weather_stmt",
      REAP wbl5 FROM _weather_bodies, wnd.
      CREATE wbi5(NUM) TO 0.
      SEASON wbi5 < COUNT wbl5,
        REAP wbel5 FROM plant_list_get, wbl5, wbi5.
        REAP wret2 FROM collect_nums_walk, wbel5, subst, res.
        SET wbi5 TO wbi5 + 1.
      /SEASON.
    /IF.
    IF wty IS "cycle_stmt",
      REAP wle2 FROM _map_get, wnd, "listExpr".
      IF wle2 IS "",
        REAP wit FROM _map_get, wnd, "iterVar".
        REAP wf2 FROM list_contains, res, wit.
        IF wf2 IS 0, PUT wit INTO res. /IF.
      /IF.
      IF wle2 ISNT "",
        REAP widx FROM _map_get, wnd, "indexVar".
        IF widx > "" AND widx ISNT "null",
          REAP wf3 FROM list_contains, res, widx.
          IF wf3 IS 0, PUT widx INTO res. /IF.
        /IF.
      /IF.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  collect_nums — names of numeric scalar vars in scope for an
#  action body: NUM/FACT params (after subst) plus NUM/FACT
#  CREATE/LET targets anywhere in the body. Used by _handle_cat
#  so "text" + i concatenates numeric vars via _from_long.
# ──────────────────────────────────────────────────────────────
ACTION collect_nums(bd(LIST), params(LIST), subst(LIST)),
  CREATE res(LIST) TO plant_list_make(0).
  CREATE pi(NUM) TO 0.
  CREATE pnd(TX) TO "".
  CREATE pn2(TX) TO "".
  CREATE pty2(TX) TO "".
  CREATE psu2(TX) TO "".
  CREATE pbs2(TX) TO "".
  SEASON pi < COUNT params,
    REAP pnd FROM plant_list_get, params, pi.
    REAP pn2 FROM _map_get, pnd, "name".
    REAP pty2 FROM _map_get, pnd, "type".
    REAP psu2 FROM subst_type, pty2, subst.
    REAP pbs2 FROM type_base, psu2.
    IF pbs2 IS "NUM" OR pbs2 IS "FACT",
      PUT pn2 INTO res.
    /IF.
    SET pi TO pi + 1.
  /SEASON.
  REAP ret FROM collect_nums_walk, bd, subst, res.
  GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  nums_from_avars — numeric var names from an async var table
#  (flat [name, ctype, …] pairs as built by async_var_add)
# ──────────────────────────────────────────────────────────────
ACTION nums_from_avars(vars(LIST)),
  CREATE res(LIST) TO plant_list_make(0).
  CREATE vi(NUM) TO 0.
  CREATE vn(TX) TO "".
  CREATE vt(TX) TO "".
  SEASON vi + 1 < COUNT vars,
    REAP vn FROM plant_list_get, vars, vi.
    REAP vt FROM plant_list_get, vars, vi + 1.
    IF vt IS "long" OR vt IS "int",
      REAP vf FROM list_contains, res, vn.
      IF vf IS 0, PUT vn INTO res. /IF.
    /IF.
    SET vi TO vi + 2.
  /SEASON.
  GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  collect_nums_cb — numeric var names for closure bodies:
#  NUM/FACT closure params (after subst) + MOVE/REF shadows with
#  numeric ctype + numeric CREATE/LET targets in the body.
# ──────────────────────────────────────────────────────────────
ACTION collect_nums_cb(bd(LIST), params(LIST), shads(LIST), subst(LIST)),
  CREATE res(LIST) TO plant_list_make(0).
  CREATE ci(NUM) TO 0.
  CREATE cnd(TX) TO "".
  CREATE cn2(TX) TO "".
  CREATE cty2(TX) TO "".
  CREATE csu2(TX) TO "".
  CREATE cbs2(TX) TO "".
  SEASON ci < COUNT params,
    REAP cnd FROM plant_list_get, params, ci.
    REAP cn2 FROM _map_get, cnd, "name".
    REAP cty2 FROM _map_get, cnd, "type".
    REAP csu2 FROM subst_type, cty2, subst.
    REAP cbs2 FROM type_base, csu2.
    IF cbs2 IS "NUM" OR cbs2 IS "FACT",
      PUT cn2 INTO res.
    /IF.
    SET ci TO ci + 1.
  /SEASON.
  CREATE si7(NUM) TO 0.
  CREATE se7(TX) TO "".
  CREATE sn7(TX) TO "".
  CREATE sc7(TX) TO "".
  SEASON si7 < COUNT shads,
    REAP se7 FROM plant_list_get, shads, si7.
    REAP sn7 FROM _map_get, se7, "name".
    REAP sc7 FROM _map_get, se7, "ctype".
    IF sc7 IS "long" OR sc7 IS "int",
      REAP sf7 FROM list_contains, res, sn7.
      IF sf7 IS 0, PUT sn7 INTO res. /IF.
    /IF.
    SET si7 TO si7 + 1.
  /SEASON.
  REAP ret7 FROM collect_nums_walk, bd, subst, res.
  GIVE res.
/ACTION.

# ═══════════════════════════════════════════════════════════════
#  Async codegen — v0.48.3
#
#  ASYNC ACTION name(params), PRIORITY p, body /ACTION. compiles to:
#    plant_a_name_state — state struct (field 0 = __self task ptr,
#                          then __pc phase, then params + locals)
#    plant_a_name_step  — single step function driving all phases;
#                          local copies of every state var are
#                          restored at entry and saved back at each
#                          suspension point (AWAIT)
#    name(...)          — entry: alloc state, register the task
#                          (tx_t __parent, tx_t __ctx, user params)
#  AWAIT foo, args. (top-level only) slices the body into phases;
#  AWAIT inside IF/SEASON/CYCLE/MATCH or a plain ACTION is a
#  compile-time #error. Generic async actions unsupported.
# ═══════════════════════════════════════════════════════════════

# async_argstr — C argument list for an async action call site
# (mirrors reap_stmt arg handling: strings raw, exprs translated,
# REF params get &; async ABI adds __parent/__ctx before user args)
ACTION async_argstr(args(LIST), sigs(LIST), act(TX), nums(LIST), stvars(LIST), evars(LIST)),
  CREATE argstr(TX) TO "".
  REAP fparams FROM find_params, sigs, act.
  CREATE ai(NUM) TO 0.
  CREATE ael(TX) TO "".
  SEASON ai < COUNT args,
    REAP ael FROM plant_list_get, args, ai.
    CREATE aex(TX) TO ael.
    REAP a0 FROM substring, ael, 0, 1.
    IF a0 ISNT "\"",
      REAP aex FROM translate_expr, ael, nums, evars.
      REAP aex FROM _handle_cat, aex, nums, evars.
    /IF.
    REAP rp FROM is_ref_at, fparams, ai.
    IF rp IS "1", SET aex TO "&" + aex. /IF.
    IF ai < COUNT fparams,
      REAP fp_el FROM plant_list_get, fparams, ai.
      REAP fp_ty FROM _map_get, fp_el, "type".
      REAP fp_kind FROM ffi_param_kind, fp_ty.
      IF fp_kind IS "struct_val",
        REAP fpx FROM is_bare_id, ael.
        REAP fpk2 FROM stvar_kind, stvars, ael.
        IF fpx IS "1" AND fpk2 > "",
          IF fpk2 IS "struct_ref", SET aex TO "*" + aex. /IF.
        /IF.
        IF fpx IS "0" OR fpk2 IS "",
          REAP e0 FROM substring, ael, 0, 1.
          IF e0 ISNT "\"",
            REAP cnm3 FROM ffi_struct_cname, fp_ty.
            SET aex TO "plant_map_to_" + cnm3 + "(" + aex + ")".
          /IF.
        /IF.
      /IF.
      IF fp_kind IS "struct_ref",
        REAP fpx FROM is_bare_id, ael.
        REAP fpk2 FROM stvar_kind, stvars, ael.
        REAP amp0 FROM substring, aex, 0, 1.
        IF amp0 IS "&", SET aex TO substring(aex, 1, LEN(aex)). /IF.
        IF fpx IS "1" AND fpk2 IS "struct_val", SET aex TO "&" + aex. /IF.
        IF fpx IS "0" OR fpk2 IS "",
          REAP e0 FROM substring, ael, 0, 1.
          IF e0 ISNT "\"",
            REAP cnm3 FROM ffi_struct_cname, fp_ty.
            SET aex TO "plant_map_to_ref_" + cnm3 + "(" + aex + ")".
          /IF.
        /IF.
      /IF.
      IF fp_kind IS "callback",
        REAP fpx FROM is_bare_id, ael.
        IF fpx IS "1",
          REAP fpk2 FROM stvar_kind, stvars, ael.
          IF fpk2 IS "",
            REAP fs2 FROM find_sig, sigs, ael.
            IF COUNT fs2 > 0,
              SET aex TO "plant_cb_ensure(\"" + ael + "\", plant_cbw_" + ael + ")".
            /IF.
          /IF.
        /IF.
      /IF.
    /IF.
    IF ai > 0, SET argstr TO argstr + ", ". /IF.
    SET argstr TO argstr + aex.
    SET ai TO ai + 1.
  /SEASON.
  GIVE argstr.
/ACTION.

# async_var_add — append [name, ctype] to acc unless name exists
ACTION async_var_add(acc(LIST), name(TX), ctype(TX)),
  CREATE found(NUM) TO 0.
  CREATE fi(NUM) TO 0.
  CREATE fe(TX) TO "".
  SEASON fi < COUNT acc,
    REAP fe FROM plant_list_get, acc, fi.
    IF str_eq(fe, name) IS "1", SET found TO 1. /IF.
    SET fi TO fi + 1.
  /SEASON.
  IF NOT found,
    PUT name INTO acc.
    PUT ctype INTO acc.
  /IF.
  GIVE acc.
/ACTION.

# async_walk_decl — collect CREATE/LET targets (recursive into
# IF/SEASON/CYCLE bodies and MATCH clauses)
ACTION async_walk_decl(bd(LIST), acc(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "create_stmt" OR ty IS "let_stmt",
      REAP tg FROM _map_get, nd, "target".
      REAP vt FROM _map_get, nd, "var_type".
      REAP ct FROM ffi_ctype, vt.
      REAP acc FROM async_var_add, acc, tg, ct.
    /IF.
    IF ty IS "if_stmt",
      REAP ib FROM _if_bodies, nd.
      CREATE ii5(NUM) TO 0.
      SEASON ii5 < COUNT ib,
        REAP ibd5 FROM plant_list_get, ib, ii5.
        REAP acc FROM async_walk_decl, ibd5, acc.
        SET ii5 TO ii5 + 1.
      /SEASON.
    /IF.
    IF ty IS "season_stmt",
      REAP sb FROM _map_get, nd, "body".
      REAP acc FROM async_walk_decl, sb, acc.
    /IF.
    IF ty IS "cycle_stmt",
      REAP sb FROM _map_get, nd, "body".
      REAP acc FROM async_walk_decl, sb, acc.
    /IF.
    IF ty IS "match_stmt",
      CREATE cl(LIST) TO _map_get(nd, "clauses").
      CREATE ci(NUM) TO 0.
      SEASON ci < COUNT cl,
        REAP cl2 FROM plant_list_get, cl, ci.
        REAP cb FROM _map_get, cl2, "bodyStatements".
        REAP acc FROM async_walk_decl, cb, acc.
        SET ci TO ci + 1.
      /SEASON.
    /IF.
    IF ty IS "weather_stmt",
      REAP wbl6 FROM _weather_bodies, nd.
      CREATE wbi6(NUM) TO 0.
      SEASON wbi6 < COUNT wbl6,
        REAP wbel6 FROM plant_list_get, wbl6, wbi6.
        REAP acc FROM async_walk_decl, wbel6, acc.
        SET wbi6 TO wbi6 + 1.
      /SEASON.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE acc.
/ACTION.

# async_collect_vars — flat [name, ctype, …] for the state struct:
# params first, then CREATE/LET targets, then implicit (tx_t)
ACTION async_collect_vars(bd(LIST), params(LIST)),
  CREATE acc(LIST) TO plant_list_make(0).
  CREATE pi(NUM) TO 0.
  CREATE pe(TX) TO "".
  SEASON pi < COUNT params,
    REAP pe FROM plant_list_get, params, pi.
    REAP pn FROM _map_get, pe, "name".
    REAP pt FROM _map_get, pe, "type".
    REAP ct FROM ffi_ctype, pt.
    REAP acc FROM async_var_add, acc, pn, ct.
    SET pi TO pi + 1.
  /SEASON.
  REAP acc FROM async_walk_decl, bd, acc.
  REAP imp FROM collect_implicit, bd, params.
  CREATE ii(NUM) TO 0.
  SEASON ii < COUNT imp,
    REAP iv FROM plant_list_get, imp, ii.
    REAP acc FROM async_var_add, acc, iv, "tx_t".
    SET ii TO ii + 1.
  /SEASON.
  GIVE acc.
/ACTION.

# async_split_phases — slice the body into phases at top-level
# AWAIT statements; every phase except the last ends with its AWAIT
ACTION async_split_phases(bd(LIST)),
  CREATE phases(LIST) TO plant_list_make(0).
  CREATE cur(LIST) TO plant_list_make(0).
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "await_stmt",
      PUT nd INTO cur.
      PUT cur INTO phases.
      SET cur TO plant_list_make(0).
    /IF.
    IF ty ISNT "await_stmt",
      PUT nd INTO cur.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  PUT cur INTO phases.
  GIVE phases.
/ACTION.

# async_emit_state — typedef for the per-action state struct
ACTION async_emit_state(name(TX), vars(LIST)),
  CREATE code(TX) TO "typedef struct \{\n".
  SET code TO code + "  tx_t __self;\n".
  SET code TO code + "  long __pc;\n".
  CREATE vi(NUM) TO 0.
  CREATE vn(TX) TO "".
  CREATE vt(TX) TO "".
  SEASON vi + 1 < COUNT vars,
    REAP vn FROM plant_list_get, vars, vi.
    REAP vt FROM plant_list_get, vars, vi + 1.
    SET code TO code + "  " + vt + " " + vn + ";\n".
    SET vi TO vi + 2.
  /SEASON.
  SET code TO code + "\} plant_a_" + name + "_state;\n\n".
  GIVE code.
/ACTION.

# async_emit_entry — tx_t name(tx_t __parent, tx_t __ctx, params):
# alloc the state, copy params in, register the task (prio/deadline
# inheritance handled by the engine via __parent)
ACTION async_emit_entry(name(TX), params(LIST), prio(TX), mmode(TX)),
  CREATE pstr(TX) TO "".
  CREATE pi(NUM) TO 0.
  CREATE pe(TX) TO "".
  SEASON pi < COUNT params,
    REAP pe FROM plant_list_get, params, pi.
    REAP pn FROM _map_get, pe, "name".
    REAP pt FROM _map_get, pe, "type".
    REAP ct FROM ffi_ctype, pt.
    IF pi > 0, SET pstr TO pstr + ", ". /IF.
    SET pstr TO pstr + ct + " " + pn.
    SET pi TO pi + 1.
  /SEASON.
  CREATE code(TX) TO "tx_t " + name + "(tx_t __parent, tx_t __ctx".
  IF pstr > "", SET code TO code + ", " + pstr. /IF.
  SET code TO code + ") \{\n".
  IF mmode IS "FAST",
    SET code TO code + "  plant_fast_enter(\"" + name + "\");\n".
  /IF.
  SET code TO code + "  plant_a_" + name + "_state* s = (plant_a_" + name + "_state*)plant_async_alloc_state(sizeof(plant_a_" + name + "_state), \"" + name + "\");\n".
  CREATE ci(NUM) TO 0.
  SEASON ci < COUNT params,
    REAP pe2 FROM plant_list_get, params, ci.
    REAP pn2 FROM _map_get, pe2, "name".
    SET code TO code + "  s->" + pn2 + " = " + pn2 + ";\n".
    SET ci TO ci + 1.
  /SEASON.
  SET code TO code + "  return plant_async_register((tx_t)s, plant_a_" + name + "_step, __parent, __ctx, " + prio + ", -1, -1, 0, \"" + name + "\");\n".
  SET code TO code + "\}\n\n".
  GIVE code.
/ACTION.

# async_emit_step — one step function driving every phase. Locals
# (aliases of the state fields) are restored at entry; the phase
# dispatch jumps to the saved program counter; AWAIT saves all
# locals back, bumps __pc and suspends on the child task.
ACTION async_emit_step(name(TX), phases(LIST), vars(LIST), sigs(LIST), subst(LIST), clmap(LIST), stvars(LIST), evars(LIST)),
  CREATE code(TX) TO "static int plant_a_" + name + "_step(tx_t st) \{\n".
  SET code TO code + "  plant_a_" + name + "_state* s = (plant_a_" + name + "_state*)st;\n".
  SET code TO code + "  if (s->__pc > 0) plant_async_await_result(st);\n".
  CREATE vi(NUM) TO 0.
  CREATE vn(TX) TO "".
  CREATE vt(TX) TO "".
  SEASON vi + 1 < COUNT vars,
    REAP vn FROM plant_list_get, vars, vi.
    REAP vt FROM plant_list_get, vars, vi + 1.
    SET code TO code + "  " + vt + " " + vn + " = s->" + vn + ";\n".
    SET vi TO vi + 2.
  /SEASON.
  SET code TO code + "  switch (s->__pc) \{\n".
  CREATE nums_s(LIST) TO nums_from_avars(vars).
  CREATE ph(NUM) TO 0.
  SEASON ph < COUNT phases,
    CREATE phs(TX) TO _from_long(ph).
    SET code TO code + "    case " + phs + ": goto plant_a_" + name + "_L" + phs + ";\n".
    SET ph TO ph + 1.
  /SEASON.
  SET code TO code + "  \}\n".
  CREATE ph2(NUM) TO 0.
  SEASON ph2 < COUNT phases,
    CREATE ph2s(TX) TO _from_long(ph2).
    SET code TO code + "  plant_a_" + name + "_L" + ph2s + ":\n".
    REAP phd FROM plant_list_get, phases, ph2.
    CREATE nph(NUM) TO COUNT phases.
    CREATE nst(NUM) TO COUNT phd.
    CREATE nxt(NUM) TO ph2 + 1.
    IF nxt < nph,
      CREATE lead(LIST) TO plant_list_make(0).
      CREATE lj(NUM) TO 0.
      SEASON lj < nst - 1,
        REAP ls FROM plant_list_get, phd, lj.
        PUT ls INTO lead.
        SET lj TO lj + 1.
      /SEASON.
      REAP lcode FROM generate_body, lead, env_make(1, sigs, subst, clmap, "a", nums_s, stvars, evars, "", "", "").
      SET code TO code + lcode.
      CREATE aw_last(NUM) TO nst - 1.
      REAP awnd FROM plant_list_get, phd, aw_last.
      REAP act_s FROM _map_get, awnd, "action".
      REAP awctx FROM _map_get, awnd, "ctx".
      CREATE awargs(LIST) TO _map_get(awnd, "args").
      REAP arg_s FROM async_argstr, awargs, sigs, act_s, nums_s, stvars, evars.
      CREATE vi2(NUM) TO 0.
      CREATE vn2(TX) TO "".
      SEASON vi2 + 1 < COUNT vars,
        REAP vn2 FROM plant_list_get, vars, vi2.
        SET code TO code + "  s->" + vn2 + " = " + vn2 + ";\n".
        SET vi2 TO vi2 + 2.
      /SEASON.
      CREATE nxts(TX) TO _from_long(nxt).
      SET code TO code + "  s->__pc = " + nxts + ";\n".
      # AWAIT ... IN ctx (v0.48.14): the child task is spawned into the
      # context and the suspension is ctx-scoped; standard AWAIT keeps
      # the plain spawn with the default context.
      IF awctx ISNT "" AND awctx ISNT "null",
        SET code TO code + "  plant_async_await_in(st, " + awctx + ", " + act_s + "(st, " + awctx + "".
        IF arg_s > "", SET code TO code + ", " + arg_s. /IF.
        SET code TO code + "));\n  return 0;\n".
      /IF.
      IF awctx IS "" OR awctx IS "null",
        SET code TO code + "  plant_async_suspend(st, " + act_s + "(st, 0".
        IF arg_s > "", SET code TO code + ", " + arg_s. /IF.
        SET code TO code + "));\n  return 0;\n".
      /IF.
    /IF.
    IF nxt IS nph,
      REAP tcode FROM generate_body, phd, env_make(1, sigs, subst, clmap, "a", nums_s, stvars, evars, "", "", "").
      SET code TO code + tcode.
    /IF.
    SET ph2 TO ph2 + 1.
  /SEASON.
  SET code TO code + "  plant_async_finish(st, \"" + name + "\");\n".
  SET code TO code + "  return 1;\n".
  SET code TO code + "\}\n\n".
  GIVE code.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  translate_expr — PlantLang → C expression translation
# ──────────────────────────────────────────────────────────────
ACTION _ni_replace(e(TX)),
    CREATE out(TX) TO "".
    CREATE i(NUM) TO 0.
    CREATE ins(TX) TO "0".
    SEASON i < LEN(e),
        REAP ch FROM char_at, e, i.
        IF ins IS "0",
            REAP pre1 FROM substring, e, i, i + 11.
            IF pre1 IS "NOW FORMAT ",
                REAP c1 FROM char_at, e, i + 11.
                REAP c2 FROM char_at, e, i + 12.
                IF c1 IS ":" AND c2 IS " ",
                    CREATE nm(TX) TO "".
                    CREATE j(NUM) TO i + 13.
                    SEASON j < LEN(e),
                        REAP jch FROM char_at, e, j.
                        IF jch IS " " OR jch IS "\"" OR jch IS "(" OR jch IS ")" OR jch IS ".",
                            BREAK 0.
                        /IF.
                        SET nm TO nm + jch.
                        SET j TO j + 1.
                    /SEASON.
                    SET out TO out + "plant_now(" + "\"" + nm + "\"" + ")".
                    SET i TO j.
                    CONTINUE 0.
                /IF.
            /IF.
            REAP pre2 FROM substring, e, i, i + 8.
            IF pre2 IS "ANALYZE ",
                CREATE dep(NUM) TO 0.
                CREATE qs(TX) TO "0".
                CREATE opr(TX) TO "".
                CREATE j2(NUM) TO i + 8.
                SEASON j2 < LEN(e),
                    REAP jch FROM char_at, e, j2.
                    IF jch IS "(", SET dep TO dep + 1. /IF.
                    IF jch IS ")", SET dep TO dep - 1. /IF.
                    IF jch IS "\"",
                        SET qs TO _from_long(1 - _to_long(qs)).
                    /IF.
                    IF dep IS 0 AND qs IS "0",
                        REAP p3 FROM substring, e, j2, j2 + 3.
                        IF p3 IS " + ",
                            BREAK 0.
                        /IF.
                    /IF.
                    SET opr TO opr + jch.
                    SET j2 TO j2 + 1.
                /SEASON.
                REAP opr FROM _ni_replace, opr.
                SET out TO out + "plant_map_to_string(plant_analyze(" + opr + "))".
                SET i TO j2.
                CONTINUE 0.
            /IF.
            REAP pre3 FROM substring, e, i, i + 7.
            IF pre3 IS "TYPEOF ",
                CREATE dep2(NUM) TO 0.
                CREATE qs2(TX) TO "0".
                CREATE oprb(TX) TO "".
                CREATE j3(NUM) TO i + 7.
                SEASON j3 < LEN(e),
                    REAP jch FROM char_at, e, j3.
                    IF jch IS "(", SET dep2 TO dep2 + 1. /IF.
                    IF jch IS ")", SET dep2 TO dep2 - 1. /IF.
                    IF jch IS "\"",
                        SET qs2 TO _from_long(1 - _to_long(qs2)).
                    /IF.
                    IF dep2 IS 0 AND qs2 IS "0",
                        REAP p4 FROM substring, e, j3, j3 + 3.
                        IF p4 IS " + ",
                            BREAK 0.
                        /IF.
                    /IF.
                    SET oprb TO oprb + jch.
                    SET j3 TO j3 + 1.
                /SEASON.
                REAP oprb FROM _ni_replace, oprb.
                SET out TO out + "plant_typeof(" + oprb + ")".
                SET i TO j3.
                CONTINUE 0.
            /IF.
        /IF.
        IF ch IS "\"",
            SET ins TO _from_long(1 - _to_long(ins)).
        /IF.
        SET out TO out + ch.
        SET i TO i + 1.
    /SEASON.
    GIVE out.
/ACTION.

# _emit_ds - recursive code generator for let_destructure patterns.
# base is the C expression holding the current value; object entries
# extract via _map_get(base, "key"), array entries via
# plant_list_get(base, index). Nested patterns get a uniquely named
# intermediate (plant_unique_seq) and recurse; "_" bindings are
# skipped unless they carry a nested pattern.
ACTION _emit_ds(items(LIST), kind(TX), base(TX), isel(TX), tag(TX)),
  CREATE code(TX) TO "".
  CREATE i(NUM) TO 0.
  SEASON i < COUNT items,
    REAP it FROM plant_list_get, items, i.
    REAP key FROM _map_get, it, "key".
    REAP nm FROM _map_get, it, "name".
    REAP sub FROM _map_get, it, "sub".
    CREATE ex(TX) TO "".
    IF kind IS "object",
      SET ex TO ex + "_map_get(".
      SET ex TO ex + base.
      SET ex TO ex + ", \"".
      SET ex TO ex + key.
      SET ex TO ex + "\")".
    /IF.
    IF kind ISNT "object",
      SET ex TO ex + "plant_list_get(".
      SET ex TO ex + base.
      SET ex TO ex + ", ".
      SET ex TO ex + _from_long(i).
      SET ex TO ex + ")".
    /IF.
    IF sub IS "",
      IF nm ISNT "_",
        SET code TO code + isel + "  tx_t " + nm + " = " + ex + ";\n".
      /IF.
    /IF.
    IF sub ISNT "",
      CREATE tname(TX) TO "_ds_" + tag + "_" + _from_long(plant_unique_seq()) + "_" + _from_long(i).
      SET code TO code + isel + "  tx_t " + tname + " = " + ex + ";\n".
      REAP skind FROM _map_get, sub, "kind".
      REAP sitems FROM _map_get, sub, "items".
      SET code TO code + _emit_ds(sitems, skind, tname, isel, tag).
    /IF.
    SET i TO i + 1.
  /SEASON.
  GIVE code.
/ACTION.

# _swap_self - v0.49.29: rewrite standalone SELF tokens to self
# (word-boundary aware so SELFISH etc. are untouched).
ACTION _swap_self(e(TX)),
  # standalone-word rewrite only: SELF -> self. Member access uses
  # the modern dot form (self.field, self.method()); the legacy
  # colon form (SELF:field) is not rewritten here.
  CREATE out2(TX) TO "".
  CREATE i(NUM) TO 0.
  CREATE n(NUM) TO LEN(e).
  SEASON i < n,
    REAP c FROM char_at, e, i.
    IF c IS "S" AND i + 3 < n,
      REAP s4 FROM substring, e, i, i + 4.
      REAP isself FROM str_eq, s4, "SELF".
      IF isself IS "1",
        CREATE okL(NUM) TO 1.
        CREATE okR(NUM) TO 1.
        IF i > 0,
          REAP pc FROM char_at, e, i - 1.
          IF pc GREATER THAN OR EQUAL "a" AND pc LESS THAN OR EQUAL "z", SET okL TO 0. /IF.
          IF pc GREATER THAN OR EQUAL "A" AND pc LESS THAN OR EQUAL "Z", SET okL TO 0. /IF.
          IF pc GREATER THAN OR EQUAL "0" AND pc LESS THAN OR EQUAL "9", SET okL TO 0. /IF.
          IF pc IS "_", SET okL TO 0. /IF.
        /IF.
        IF i + 4 < n,
          REAP nc FROM char_at, e, i + 4.
          IF nc GREATER THAN OR EQUAL "a" AND nc LESS THAN OR EQUAL "z", SET okR TO 0. /IF.
          IF nc GREATER THAN OR EQUAL "A" AND nc LESS THAN OR EQUAL "Z", SET okR TO 0. /IF.
          IF nc GREATER THAN OR EQUAL "0" AND nc LESS THAN OR EQUAL "9", SET okR TO 0. /IF.
          IF nc IS "_", SET okR TO 0. /IF.
        /IF.
        IF okL IS 1 AND okR IS 1,
          REAP out2 FROM plant_str_concat, out2, "self".
          SET i TO i + 4.
          CONTINUE.
        /IF.
      /IF.
    /IF.
    REAP out2 FROM plant_str_concat, out2, c.
    SET i TO i + 1.
  /SEASON.
  GIVE out2.
/ACTION.



ACTION translate_expr(expr(TX), nums(LIST), evars(LIST)),
    REAP expr FROM _swap_self, expr.
    CREATE e(TX) TO expr.
    # ── v0.48.36 — temporal queries / introspection in expression
    #    position: NOW [FORMAT : x] → plant_now("x"), ANALYZE x →
    #    plant_analyze(x), TYPEOF x → plant_typeof(x). _ni_replace
    #    walks the text quote-aware so string literals ("NOW", "… +
    #    TYPEOF …") are never rewritten.
    REAP e FROM _ni_replace, e.
    IF e IS "NOW",
        GIVE "plant_now(\"\")".
    /IF.
    # ── START foo, args. in expression position: spawn and keep the
    #    task handle (tx_t) for later CANCEL / AWAIT on the child. ─
    REAP e0 FROM substring, e, 0, 6.
    IF e0 IS "START ",
        REAP e1 FROM substring, e, 6, LEN(e).
        REAP cm FROM find_any, e1, ",".
        IF cm IS -1,
            GIVE e1 + "(0, 0)".
        /IF.
        REAP anm FROM substring, e1, 0, cm.
        REAP args1 FROM substring, e1, cm + 1, LEN(e1).
        GIVE anm + "(0, 0, " + args1 + ")".
    /IF.
    REAP e FROM strings:REPLACE, e, "GREATER THAN OR EQUAL", ">=".
    REAP e FROM strings:REPLACE, e, "LESS THAN OR EQUAL", "<=".
    REAP e FROM strings:REPLACE, e, "GREATER THAN", ">".
    REAP e FROM strings:REPLACE, e, "LESS THAN", "<".
    REAP e FROM strings:REPLACE, e, "ISNT", "!=".
    REAP e FROM strings:REPLACE, e, "STAR_STAR", "**".
    REAP e FROM strings:REPLACE, e, " AND ", " && ".
    REAP e FROM strings:REPLACE, e, " OR ", " || ".
    REAP e FROM strings:REPLACE, e, "NOT ", "!".
    REAP e FROM strings:REPLACE, e, " IS ", " == ".
    REAP e FROM _handle_func, e, "COUNT", "plant_array_length".
    # v0.49.18 shadow-order guard: these seven must
    # rewrite BEFORE their shorter substrings (SINH/COSH/TANH/GAMMA,
    # SIN/COS/TAN) — the paren mapper splits
    # on plain substrings, so "SINH (" would otherwise carve
    # "ASINH (" into "A"+"math_sinh(...)". Rewritten (lowercase) C
    # can never rematch an uppercase needle.
    REAP e FROM _math_func_paren, e, "ASINH", "math_asinh".
    REAP e FROM _math_func_paren, e, "ACOSH", "math_acosh".
    REAP e FROM _math_func_paren, e, "ATANH", "math_atanh".
    REAP e FROM _math_func_paren, e, "LGAMMA", "math_lgamma".
    REAP e FROM _math_func_paren, e, "ASIN", "math_asin".
    REAP e FROM _math_func_paren, e, "ACOS", "math_acos".
    REAP e FROM _math_func_paren, e, "ATAN", "math_atan".
    # v0.49.19 — natural logarithm as a bare built-in: LOG(x) →
    # math_log(x). No shadow hazard (LOG10/LOG2/LOG1P needles require
    # the digit right after "LOG").
    # v0.49.21 — statistical aggregations (single list argument).
    REAP e FROM _math_func_paren, e, "VARIANCE", "plant_list_variance".
    REAP e FROM _math_func_paren, e, "STDDEV", "plant_list_stddev".
    REAP e FROM _math_func_paren, e, "PRODUCT", "plant_list_product".
    REAP e FROM _math_func_paren, e, "MODE", "plant_list_mode".
    # v0.49.22 — linear algebra (nested-list matrices/vectors).
    REAP e FROM _math_func_paren, e, "DOT", "plant_dot".
    REAP e FROM _math_func_paren, e, "CROSS", "plant_cross".
    REAP e FROM _math_func_paren, e, "NORM", "plant_norm".
    REAP e FROM _math_func_paren, e, "TRANSPOSE", "plant_transpose".
    REAP e FROM _math_func_paren, e, "MATRIX_MULT", "plant_matrix_mult".
    REAP e FROM _math_func_paren, e, "INVERSE", "plant_inverse".
    REAP e FROM _math_func_paren, e, "DET", "plant_det".
    # v0.49.23 — numerical analysis (factorization/eigen/solver).
    REAP e FROM _math_func_paren, e, "LU", "plant_lu".
    REAP e FROM _math_func_paren, e, "EIGEN", "plant_eigen".
    REAP e FROM _math_func_paren, e, "SVD", "plant_svd".
    REAP e FROM _math_func_paren, e, "SOLVE", "plant_solve".
    REAP e FROM _math_func_paren, e, "COND", "plant_cond".
    REAP e FROM _math_func_paren, e, "LOG", "math_log".
    # v0.49.20 — Option/Result monadic constructors (underscore
    # compounds; no collision with dot-notation field access).
    REAP e FROM _handle_func_paren, e, "Option_Some", "plant_option_some".
    REAP e FROM _handle_func_paren, e, "Option_None", "plant_option_none".
    REAP e FROM _handle_func_paren, e, "Result_Ok", "plant_result_ok".
    REAP e FROM _handle_func_paren, e, "Result_Err", "plant_result_err".
    # v0.49.20 — infix range shorthand: 1..4 → plant_range_list(1, 4)
    REAP e FROM _handle_range, e.

    REAP e FROM _handle_func_paren, e, "LEN", "strlen".
    REAP e FROM _handle_func_paren, e, "JOIN", "plant_join".
    REAP e FROM _handle_func_paren, e, "FIRST", "plant_first".
    REAP e FROM _handle_func_paren, e, "LAST", "plant_last".
    REAP e FROM _handle_func_paren, e, "SUM", "plant_sum".
    REAP e FROM _handle_func_paren, e, "UPPER", "plant_upper".
    REAP e FROM _handle_func_paren, e, "LOWER", "plant_lower".
    REAP e FROM _handle_func_paren, e, "TRIM", "plant_trim".
    REAP e FROM _handle_func_paren, e, "REVERSE", "plant_list_reverse".
    # v0.48.38f — math built-ins (single-argument, dual-argument
    # POW, and parameterless RANDOM all flow through the paren
    # mapper; the runtime coerces tx_t operands to doubles)
    REAP e FROM _math_func_paren, e, "ABS", "plant_abs".
    REAP e FROM _math_func_paren, e, "ROUND", "plant_round".
    REAP e FROM _math_func_paren, e, "POW", "plant_pow".
    REAP e FROM _math_func_paren, e, "CEIL", "plant_ceil".
    REAP e FROM _math_func_paren, e, "FLOOR", "plant_floor".
    REAP e FROM _handle_func_paren, e, "RANDOM", "plant_random".
    REAP e FROM _math_func_paren, e, "SIN", "plant_sin".
    REAP e FROM _math_func_paren, e, "COS", "plant_cos".
    REAP e FROM _math_func_paren, e, "SQRT", "plant_sqrt".
    # v0.48.38g — conditional list built-ins: HAS passes its value
    # through as an expression; ANY/ALL get their condition text
    # quoted into a string literal ("> 2" would be invalid C as a
    # bare expression — the runtime evaluates it as text).
    REAP e FROM _handle_func_paren, e, "HAS", "plant_has".
    REAP e FROM _handle_func_paren, e, "ANY", "plant_any".
    REAP e FROM _handle_func_paren, e, "ALL", "plant_all".
    REAP e FROM _quote_cond_arg, e, "plant_any".
    REAP e FROM _quote_cond_arg, e, "plant_all".
    # v0.48.38h — ternary built-in: PICK(cond, true_val, false_val)
    # maps through _handle_func_paren like the other built-ins; bare
    # TRUE/FALSE conditions become 1/0 via plant_sanitize_bools.
    REAP e FROM _handle_func_paren, e, "PICK", "plant_pick".
    # v0.48.38j — string analysis: FIND(text, sub) and
    # COUNT_OF(text, sub) map through _handle_func_paren like the
    # other dual-argument built-ins.
    REAP e FROM _handle_func_paren, e, "FIND", "plant_find".
    REAP e FROM _handle_func_paren, e, "COUNT_OF", "plant_count_of".
    # v0.48.38i — universal slicing: SLICE(data, start, end) maps
    # through _handle_func_paren; string and list arguments both
    # arrive as expressions, the runtime dispatches on the value.
    REAP e FROM _handle_func_paren, e, "SLICE", "plant_slice".
    # v0.49.13 — bare string built-ins: INCLUDES / STARTS_WITH /
    # ENDS_WITH / REPEAT / PAD / PAD_LEFT map through the paren
    # mapper straight to their runtime helpers; the strings:
    # module-qualified forms remain fully supported.
    REAP e FROM _handle_func_paren, e, "INCLUDES", "plant_list_includes".
    REAP e FROM _handle_func_paren, e, "STARTS_WITH", "string_starts_with".
    REAP e FROM _handle_func_paren, e, "ENDS_WITH", "string_ends_with".
    REAP e FROM _handle_func_paren, e, "REPEAT", "string_repeat".
    REAP e FROM _handle_func_paren, e, "PAD", "string_pad".
    REAP e FROM _handle_func_paren, e, "PAD_LEFT", "string_pad_left".
    # v0.49.15 — list built-ins (batch 1): REVERSE / RANGE / SORT /
    # INCLUDES / INDEX_OF / UNIQUE / AVERAGE / MEDIAN map through the
    # paren mapper to list-aware runtime helpers (REVERSE and INCLUDES
    # dispatch on the first argument's type, so the string built-ins
    # keep their behavior).
    REAP e FROM _stat_paren, e, "RANGE", "plant_range_list", "plant_list_range".
    REAP e FROM _handle_func_paren, e, "SORT", "plant_list_sort".
    REAP e FROM _handle_func_paren, e, "INDEX_OF", "plant_list_index_of".
    REAP e FROM _handle_func_paren, e, "UNIQUE", "plant_list_unique".
    REAP e FROM _handle_func_paren, e, "AVERAGE", "plant_list_average".
    REAP e FROM _handle_func_paren, e, "MEDIAN", "plant_list_median".
    # v0.49.16 — list built-ins (batch 2): FLATTEN / CHUNK / ZIP /
    # FILTER_GT / FILTER_LT complete the list toolkit (the full
    # legacy `lists` (14) surface now has expression built-ins).
    REAP e FROM _handle_func_paren, e, "FLATTEN", "plant_list_flatten".
    REAP e FROM _handle_func_paren, e, "CHUNK", "plant_list_chunk".
    REAP e FROM _handle_func_paren, e, "ZIP", "plant_list_zip".
    REAP e FROM _handle_func_paren, e, "FILTER_GT", "plant_list_filter_gt".
    REAP e FROM _handle_func_paren, e, "FILTER_LT", "plant_list_filter_lt".
    # v0.49.17 — extended math library (17 built-ins): MIN / MAX /
    # TAN / ATAN / COT / ASIN / ACOS / ATAN2 / SINH / COSH / TANH /
    # EXP / EXPM1 / LOG10 / LOG2 / LOG1P / HYPOT map through the paren
    # mapper to their C math runtime helpers (math_*). Numeric args
    # arrive as tagged small ints and are decoded safely by
    # _plant_math_num; domain errors return "-nan" (ASIN/ACOS/LOG*).
    # v0.49.21 — MIN/MAX/RANGE gain single-list-argument forms via
    # arity dispatch (two args keep the v0.49.17/v0.49.15 semantics).
    REAP e FROM _stat_paren, e, "MIN", "math_min", "plant_list_min".
    REAP e FROM _stat_paren, e, "MAX", "math_max", "plant_list_max".
    REAP e FROM _math_func_paren, e, "TAN", "math_tan".
    REAP e FROM _math_func_paren, e, "COT", "math_cot".
    REAP e FROM _math_func_paren, e, "ATAN2", "math_atan2".
    REAP e FROM _math_func_paren, e, "SINH", "math_sinh".
    REAP e FROM _math_func_paren, e, "COSH", "math_cosh".
    REAP e FROM _math_func_paren, e, "TANH", "math_tanh".
    REAP e FROM _math_func_paren, e, "EXP", "math_exp".
    REAP e FROM _math_func_paren, e, "EXPM1", "math_expm1".
    REAP e FROM _math_func_paren, e, "LOG10", "math_log10".
    REAP e FROM _math_func_paren, e, "LOG2", "math_log2".
    REAP e FROM _math_func_paren, e, "LOG1P", "math_log1p".
    REAP e FROM _math_func_paren, e, "HYPOT", "math_hypot".
    # v0.49.18 — advanced math library (11 built-ins): SEC / CSC /
    # ASINH / ACOSH / ATANH / ERF / ERFC / GAMMA / LGAMMA / EXP2 /
    # LOG_BASE map through the paren mapper to their C math runtime
    # helpers (math_*). Domain guards live in the runtime (zero
    # divisors → "-nan", acosh x >= 1, atanh |x| < 1, gamma x > 0,
    # log_base x > 0 /\ b > 0 /\ b != 1).
    REAP e FROM _math_func_paren, e, "SEC", "math_sec".
    REAP e FROM _math_func_paren, e, "CSC", "math_csc".
    REAP e FROM _math_func_paren, e, "ERF", "math_erf".
    REAP e FROM _math_func_paren, e, "ERFC", "math_erfc".
    REAP e FROM _math_func_paren, e, "GAMMA", "math_gamma".
    REAP e FROM _math_func_paren, e, "EXP2", "math_exp2".
    REAP e FROM _math_func_paren, e, "LOG_BASE", "math_log_base".
    # v0.48.38k — VEIN resource management: TAP / INFUSE use the
    # paren form; ABSORB / SEAL accept both the paren form (used by
    # the test suite) and the space form (the _handle_func pattern).
    REAP e FROM _handle_func_paren, e, "TAP", "plant_tap".
    REAP e FROM _handle_func_paren, e, "INFUSE", "plant_infuse".
    REAP e FROM _handle_func_paren, e, "ABSORB", "plant_absorb".
    REAP e FROM _handle_func_paren, e, "SEAL", "plant_seal".
    REAP e FROM _handle_func, e, "ABSORB", "plant_absorb".
    REAP e FROM _handle_func, e, "SEAL", "plant_seal".
    REAP e FROM _storm_inject, e.
    REAP e FROM _handle_func, e, "TEST", "!".
    # map literals rewrite BEFORE list literals so { ... } spans
    # (and [ ... ] values nested inside them) are fully converted;
    # the emitted plant_map_set/plant_map_create chains contain no
    # brackets or bare colons for the later passes to see.
    REAP e FROM _map_literal, e, nums, evars.
    # list literals rewrite BEFORE boolean sanitization so a bare
    # TRUE/FALSE inside [ ... ] survives as the quoted string
    # "TRUE"/"FALSE" (a non-numeric element — SUM skips it, and
    # the sanitizer then leaves quoted booleans untouched).
    REAP e FROM _list_literal, e, nums, evars.
    REAP e FROM plant_sanitize_bools, e.
    REAP e FROM strings:REPLACE, e, "NULL", "NULL".
    REAP e FROM strings:REPLACE, e, " : ", "_".
    REAP e FROM handle_brackets, e.
    GIVE e.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  indent_str — generate indentation whitespace
# ──────────────────────────────────────────────────────────────
ACTION indent_str(level(NUM)),
    CREATE res(TX) TO "".
    CREATE i(NUM) TO 0.
    SEASON i < level,
        SET res TO res + "  ".
        SET i TO i + 1.
    /SEASON.
    GIVE res.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  generate_body — generate C code for a list of AST nodes
#  clmap: closure-var map (flat [varname, closurenode]) for the
#  current C function scope (REAP action name lookup for closure
#  invocation); an empty list means no closures are in scope.
#  actx: "" = normal C function body, "a" = async step phase body
#  (CREATE/LET emit assignments into the state struct, GIVE emits
#  plant_async_finish + return 1).
#  nums: names of numeric scalar vars in scope (_handle_cat).
#  rty: the enclosing action's return type after substitution (""
#  for implicit returns / async steps / closures); gen_give_stmt
#  uses it to wrap NUM-typed returns in _from_long (v0.48.13).
# ──────────────────────────────────────────────────────────────
ACTION _gb_dump(bd(LIST)),
  CREATE i(NUM) TO 0.
  SEASON i < COUNT bd,
    REAP nd FROM plant_list_get, bd, i.
    REAP ty FROM _map_get, nd, "type".
    SHOW "GB:" + ty.
    SET i TO i + 1.
  /SEASON.
  GIVE 0.
/ACTION.

# ──────────────────────────────────────────────────────────────
# v0.49.57b: Environment Container Primitives
# Bundle the 11 auxiliary generate_node parameters into a single env(LIST).
# Index mapping: 0=indent(isel), 1=sigs, 2=subst, 3=clmap, 4=actx, 5=nums,
# 6=stvars, 7=evars, 8=rty, 9=mexit, 10=wexit, 11=indent_num
# ──────────────────────────────────────────────────────────────
ACTION env_set(env(LIST), idx(NUM), value(TX)),
  REAP _ FROM plant_list_set, env, idx, value.
  GIVE env.
/ACTION.

ACTION env_get(env(LIST), idx(NUM)),
  GIVE plant_list_get(env, idx).
/ACTION.

ACTION env_indent(env(LIST)),
  GIVE env_get(env, 0).
/ACTION.

ACTION env_sigs(env(LIST)),
  GIVE env_get(env, 1).
/ACTION.

ACTION env_subst(env(LIST)),
  GIVE env_get(env, 2).
/ACTION.

ACTION env_clmap(env(LIST)),
  GIVE env_get(env, 3).
/ACTION.

ACTION env_actx(env(LIST)),
  GIVE env_get(env, 4).
/ACTION.

ACTION env_nums(env(LIST)),
  GIVE env_get(env, 5).
/ACTION.

ACTION env_stvars(env(LIST)),
  GIVE env_get(env, 6).
/ACTION.

ACTION env_evars(env(LIST)),
  GIVE env_get(env, 7).
/ACTION.

ACTION env_rty(env(LIST)),
  GIVE env_get(env, 8).
/ACTION.

ACTION env_mexit(env(LIST)),
  GIVE env_get(env, 9).
/ACTION.

ACTION env_wexit(env(LIST)),
  GIVE env_get(env, 10).
/ACTION.

ACTION env_indent_num(env(LIST)),
  GIVE env_get(env, 11).
/ACTION.

# ──────────────────────────────────────────────────────────────
#  env_make — create and populate an env in one call
#  Takes numeric indent (pre-computed into isel string for slot 0
#  and _from_long for slot 11) plus all 11 state params.
# ──────────────────────────────────────────────────────────────
ACTION env_make(indent_num(NUM), sigs(LIST), subst(LIST), clmap(LIST), actx(TX), nums(LIST), stvars(LIST), evars(LIST), rty(TX), mexit(TX), wexit(TX)),
  REAP isel FROM indent_str, indent_num.
  REAP env FROM plant_list_create(12).
  REAP _ FROM env_set, env, 0, isel.
  REAP _ FROM env_set, env, 1, sigs.
  REAP _ FROM env_set, env, 2, subst.
  REAP _ FROM env_set, env, 3, clmap.
  REAP _ FROM env_set, env, 4, actx.
  REAP _ FROM env_set, env, 5, nums.
  REAP _ FROM env_set, env, 6, stvars.
  REAP _ FROM env_set, env, 7, evars.
  REAP _ FROM env_set, env, 8, rty.
  REAP _ FROM env_set, env, 9, mexit.
  REAP _ FROM env_set, env, 10, wexit.
  REAP _ FROM env_set, env, 11, _from_long(indent_num).
  GIVE env.
/ACTION.

ACTION gen_show_stmt(node, nums(LIST), evars(LIST), isel(TX)),
  REAP val FROM _map_get, node, "value".
  REAP cval FROM translate_expr, val, nums, evars.
  REAP cval FROM _handle_cat, cval, nums, evars.
  REAP isn2 FROM expr_is_numeric, cval, nums.
  IF isn2 IS 1,
      SET cval TO "_from_long(" + cval + ")".
  /IF.
  REAP snm2 FROM enum_expr_of, evars, cval.
  IF isn2 IS 0 AND snm2 ISNT "",
      SET cval TO "_from_enum(" + cval + ", \"" + snm2 + "\")".
  /IF.
  IF isn2 IS 0,
      REAP sl0 FROM substring, cval, 0, 12.
      IF sl0 IS "plant_slice(",
          SET cval TO "plant_map_to_string(" + cval + ")".
      /IF.
  /IF.
  GIVE isel + "  plant_iReport_print(get_report(), " + cval + ");\n".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  gen_create_stmt — env-based CREATE handler
#  Env slots: 0=indent(isel), 2=subst, 4=actx, 5=nums, 7=evars
# ──────────────────────────────────────────────────────────────
ACTION gen_create_stmt(node, subst(LIST), nums(LIST), evars(LIST), actx(TX), isel(TX)),
  REAP target FROM _map_get, node, "target".
  REAP vtype FROM _map_get, node, "var_type".
  REAP vtype FROM subst_type, vtype, subst.
  REAP cnd FROM _map_get, node, "closure".
  IF cnd > "",
      REAP envname FROM _map_get, cnd, "envname".
      REAP caps FROM _map_get, cnd, "clcaps".
      REAP moved FROM _map_get, cnd, "moved".
      REAP cid2 FROM _map_get, cnd, "cid".
      CREATE ccode2(TX) TO isel + "  tx_t " + target + " = (tx_t)0;\n".
      IF actx IS "a", SET ccode2 TO isel + "  " + target + " = (tx_t)0;\n". /IF.
      SET ccode2 TO ccode2 + isel + "  { " + envname + "* __env_" + cid2 + " = (" + envname + "*)plant_env_alloc(sizeof(" + envname + "));\n".
      CREATE cpi(NUM) TO 0.
      CREATE capn(TX) TO "".
      CREATE capi(TX) TO "".
      SEASON cpi + 1 < COUNT caps,
          REAP capn FROM plant_list_get, caps, cpi.
          REAP capi FROM plant_list_get, caps, cpi + 1.
          SET ccode2 TO ccode2 + isel + "    __env_" + cid2 + "->" + capn + " = " + capi + ";\n".
          SET cpi TO cpi + 2.
      /SEASON.
      SET ccode2 TO ccode2 + isel + "    " + target + " = (tx_t)__env_" + cid2 + ";\n".
      SET ccode2 TO ccode2 + isel + "  }\n".
      CREATE cmi(NUM) TO 0.
      CREATE cmv(TX) TO "".
      SEASON cmi < COUNT moved,
          REAP cmv FROM plant_list_get, moved, cmi.
          SET ccode2 TO ccode2 + isel + "  " + cmv + " = 0;\n".
          SET cmi TO cmi + 1.
      /SEASON.
      GIVE ccode2.
  /IF.
  REAP val FROM _map_get, node, "value".
  REAP cval FROM translate_expr, val, nums, evars.
  REAP cval FROM _handle_cat, cval, nums, evars.
  IF actx IS "a",
      GIVE isel + "  " + target + " = " + cval + ";\n".
  /IF.
  REAP isnc2 FROM expr_is_numeric, cval, nums.
  IF vtype IS "NUM",
      IF isnc2 IS 0 AND is_lookup_prefix(cval) IS "1",
          SET cval TO "_to_long(" + cval + ")".
      /IF.
      GIVE isel + "  long " + target + " = " + cval + ";\n".
  /IF.
  IF vtype IS "FACT",
      IF isnc2 IS 0 AND is_lookup_prefix(cval) IS "1",
          SET cval TO "_to_long(" + cval + ")".
      /IF.
      GIVE isel + "  int " + target + " = " + cval + ";\n".
  /IF.
  IF vtype IS "LIST",
      GIVE isel + "  PlantArray* " + target + " = " + cval + ";\n".
  /IF.
  REAP vst2 FROM is_struct_type, vtype.
  IF vst2 IS "1",
      REAP vct2 FROM ffi_ctype, vtype.
      IF actx IS "a",
          GIVE isel + "  " + target + " = " + cval + ";\n".
      /IF.
      GIVE isel + "  " + vct2 + " " + target + " = " + cval + ";\n".
  /IF.
  IF vtype ISNT "NUM" AND vtype ISNT "FACT" AND vtype ISNT "LIST",
      REAP vst3 FROM is_struct_type, vtype.
      IF vst3 ISNT "1",
          GIVE isel + "  tx_t " + target + " = " + cval + ";\n".
      /IF.
  /IF.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  gen_set_stmt — env-based SET handler
#  Env slots: 0=indent(isel), 5=nums, 7=evars
# ──────────────────────────────────────────────────────────────
ACTION gen_set_stmt(node, nums(LIST), evars(LIST), isel(TX)),
  REAP target FROM _map_get, node, "target".
  REAP val FROM _map_get, node, "value".
  REAP cval FROM translate_expr, val, nums, evars.
  REAP cval FROM _handle_cat, cval, nums, evars.
  GIVE isel + "  " + target + " = " + cval + ";\n".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  gen_give_stmt — env-based GIVE handler
#  Env slots: 0=indent(isel), 4=actx, 5=nums, 7=evars, 8=rty, 9=mexit
# ──────────────────────────────────────────────────────────────
ACTION gen_give_stmt(node, nums(LIST), evars(LIST), rty(TX), actx(TX), mexit(TX), isel(TX)),
  REAP val FROM _map_get, node, "value".
  REAP cval FROM translate_expr, val, nums, evars.
  REAP cval FROM _handle_cat, cval, nums, evars.
  REAP isn3 FROM expr_is_numeric, cval, nums.
  IF isn3 IS 0,
      REAP snm3 FROM enum_expr_of, evars, cval.
      IF snm3 ISNT "",
          SET cval TO "_from_enum(" + cval + ", \"" + snm3 + "\")".
      /IF.
  /IF.
  IF isn3 IS 1 AND rty ISNT "",
      REAP in3 FROM is_numeric_type, rty.
      IF in3 IS 1,
          SET cval TO "_from_long(" + cval + ")".
      /IF.
  /IF.
  IF isn3 IS 0 AND rty ISNT "",
      REAP in3 FROM is_numeric_type, rty.
      IF in3 IS 1 AND snm3 IS "" AND is_lookup_prefix(cval) IS "1",
          SET cval TO "_to_long(" + cval + ")".
      /IF.
  /IF.
  IF actx IS "a",
      GIVE isel + "  plant_async_finish(st, " + cval + ");\n  return 1;\n".
  /IF.
  IF mexit > "",
      GIVE isel + mexit + "  return " + cval + ";\n".
  /IF.
  GIVE isel + "  return " + cval + ";\n".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  gen_if_stmt — env-based IF handler
#  Env slots: 0=indent(isel), 1=sigs, 2=subst, 3=clmap, 4=actx,
#  5=nums, 6=stvars, 7=evars, 8=rty, 9=mexit, 10=wexit
# ──────────────────────────────────────────────────────────────
ACTION gen_if_stmt(node, nums(LIST), evars(LIST), isel(TX), indent_num(NUM), env(LIST)),
  REAP cond FROM _map_get, node, "cond".
  REAP bd FROM _map_get, node, "body".
  REAP ccond FROM translate_expr, cond, nums, evars.
  REAP ccond FROM handle_strcmp, ccond.
  CREATE ccode(TX) TO isel + "  if (" + ccond + ") \{\n".
  REAP sigs FROM env_sigs, env.
  REAP subst FROM env_subst, env.
  REAP clmap FROM env_clmap, env.
  REAP actx FROM env_actx, env.
  REAP stvars FROM env_stvars, env.
  REAP rty FROM env_rty, env.
  REAP mexit FROM env_mexit, env.
  REAP wexit FROM env_wexit, env.
  REAP _ FROM env_set, env, 11, _from_long(indent_num + 2).
  REAP bcode FROM generate_body, bd, env.
  REAP _ FROM env_set, env, 11, _from_long(indent_num).
  SET ccode TO ccode + bcode.
  REAP elif FROM _map_get, node, "elif".
  IF COUNT elif > 0,
      CREATE ei2(NUM) TO 0.
      SEASON ei2 < COUNT elif,
          REAP econd FROM plant_list_get, elif, ei2.
          REAP ebd FROM plant_list_get, elif, ei2 + 1.
          REAP ecc FROM translate_expr, econd, nums, evars.
          REAP ecc FROM handle_strcmp, ecc.
          SET ccode TO ccode + isel + "  \} else if (" + ecc + ") \{\n".
          REAP _ FROM env_set, env, 11, _from_long(indent_num + 2).
          REAP ebc FROM generate_body, ebd, env.
          REAP _ FROM env_set, env, 11, _from_long(indent_num).
          SET ccode TO ccode + ebc.
          SET ei2 TO ei2 + 2.
      /SEASON.
  /IF.
  REAP ebody FROM _map_get, node, "else".
  IF COUNT ebody > 0,
      SET ccode TO ccode + isel + "  \} else \{\n".
      REAP _ FROM env_set, env, 11, _from_long(indent_num + 2).
      REAP ebod FROM generate_body, ebody, env.
      REAP _ FROM env_set, env, 11, _from_long(indent_num).
      SET ccode TO ccode + ebod.
  /IF.
  SET ccode TO ccode + isel + "  \}\n".
  GIVE ccode.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  gen_reap_stmt — env-based REAP handler
#  Env slots: 0=indent(isel), 1=sigs, 2=subst, 3=clmap,
#  5=nums, 6=stvars, 7=evars, 11=indent_num
# ──────────────────────────────────────────────────────────────
ACTION gen_reap_stmt(node, sigs(LIST), subst(LIST), clmap(LIST), nums(LIST), stvars(LIST), evars(LIST), isel(TX)),
  REAP tgt FROM _map_get, node, "target".
  REAP act FROM _map_get, node, "action".
  REAP act FROM strings:REPLACE, act, ":", "_".
  IF act IS "storm", SET act TO "plant_storm". /IF.
  CREATE callname(TX) TO act.
  CREATE fparams(LIST) TO plant_list_make(0).
  CREATE gi(NUM) TO -1.
  REAP gi FROM find_any, act, "[".
  IF gi ISNT -1,
      REAP sact FROM subst_reap_act, act, subst.
      REAP base FROM base_of, sact.
      REAP gargs FROM parse_type_args, sact.
      REAP mname FROM mangle, base, gargs.
      SET callname TO mname.
      REAP fparams FROM find_params, sigs, base.
  /IF.
  IF gi IS -1,
      REAP fparams FROM find_params, sigs, act.
  /IF.
  REAP cvar FROM _cl_map_get, clmap, act.
  CREATE clcall(TX) TO "".
  IF cvar > "",
      REAP cfn FROM _map_get, cvar, "fnname".
      SET callname TO cfn.
      SET clcall TO "(tx_t)" + act + ", ".
  /IF.
  CREATE args(LIST) TO _map_get(node, "args").
  CREATE clargs(LIST) TO plant_list_make(0).
  REAP clargs FROM _map_get, node, "clargs".
  IF clargs IS "",
      SET clargs TO plant_list_make(0).
  /IF.
  CREATE argstr(TX) TO "".
  CREATE clpre(TX) TO "".
  CREATE clclears(TX) TO "".
  CREATE ai(NUM) TO 0.
  CREATE arg_el(TX) TO "".
  CREATE safm(TX) TO "".
  REAP sfz2 FROM find_sig, sigs, act.
  IF COUNT sfz2 > 0,
      REAP safm FROM _map_get, sfz2, "mission_mode".
  /IF.
  CREATE safe_call(TX) TO "0".
  IF safm IS "SAFE", SET safe_call TO "1". /IF.
  CREATE sargstr(TX) TO "".
  CREATE sarg_el(TX) TO "".
  CREATE sarcn(NUM) TO 0.
  SEASON ai < COUNT args,
      REAP arg_el FROM plant_list_get, args, ai.
      CREATE aexpr(TX) TO arg_el.
      CREATE cl_ok(TX) TO "0".
      REAP cl_ok FROM _cl_is_arg, arg_el.
      IF cl_ok IS "1",
          REAP cnd FROM plant_list_get, clargs, ai.
          CREATE cndok(TX) TO "0".
          IF cnd > "",
              SET cndok TO "1".
          /IF.
          IF cndok IS "1",
              REAP envname FROM _map_get, cnd, "envname".
              REAP caps FROM _map_get, cnd, "clcaps".
              REAP moved FROM _map_get, cnd, "moved".
              SET clpre TO clpre + isel + "  tx_t __carg_" + ai + ";\n".
              SET clpre TO clpre + isel + "  { " + envname + "* __env_" + ai + " = (" + envname + "*)plant_env_alloc(sizeof(" + envname + "));\n".
              CREATE cpi(NUM) TO 0.
              CREATE capn(TX) TO "".
              CREATE capi(TX) TO "".
              SEASON cpi + 1 < COUNT caps,
                  REAP capn FROM plant_list_get, caps, cpi.
                  REAP capi FROM plant_list_get, caps, cpi + 1.
                  SET clpre TO clpre + isel + "    __env_" + ai + "->" + capn + " = " + capi + ";\n".
                  SET cpi TO cpi + 2.
              /SEASON.
              SET clpre TO clpre + isel + "    __carg_" + ai + " = (tx_t)__env_" + ai + ";\n".
              SET clpre TO clpre + isel + "  }\n".
              CREATE cmi(NUM) TO 0.
              CREATE cmv(TX) TO "".
              SEASON cmi < COUNT moved,
                  REAP cmv FROM plant_list_get, moved, cmi.
                  SET clclears TO clclears + isel + "  " + cmv + " = 0;\n".
                  SET cmi TO cmi + 1.
              /SEASON.
              SET aexpr TO "__carg_" + ai.
          /IF.
          IF cndok IS "0",
              SET aexpr TO arg_el.
          /IF.
      /IF.
      IF cl_ok IS "0",
          REAP arg0 FROM substring, arg_el, 0, 1.
          IF arg0 ISNT "\"",
             REAP aexpr FROM translate_expr, arg_el, nums, evars.
             REAP aexpr FROM _handle_cat, aexpr, nums, evars.
          /IF.
          IF safe_call IS "1",
              SET sarg_el TO aexpr.
          /IF.
          CREATE fp_ty(TX) TO "".
          IF ai < COUNT fparams,
              REAP fp_el FROM plant_list_get, fparams, ai.
              REAP fp_ty FROM _map_get, fp_el, "type".
          /IF.
          IF safe_call IS "1" AND cl_ok IS "0",
              REAP sct2 FROM ffi_ctype, fp_ty.
              IF sct2 IS "long" OR sct2 IS "int",
                  SET sarg_el TO "_from_long(" + sarg_el + ")".
              /IF.
          /IF.
          REAP fk2 FROM ffi_param_kind, fp_ty.
          IF fk2 IS "struct_val",
              REAP fpx FROM is_bare_id, arg_el.
              REAP fpk2 FROM stvar_kind, stvars, arg_el.
              IF fpx IS "1" AND fpk2 IS "struct_ref", SET aexpr TO "*" + aexpr. /IF.
              IF fpx IS "0" OR fpk2 IS "",
                  REAP e0 FROM substring, arg_el, 0, 1.
                  IF e0 ISNT "\"",
                      REAP cnm4 FROM ffi_struct_cname, fp_ty.
                      SET aexpr TO "plant_map_to_" + cnm4 + "(" + aexpr + ")".
                  /IF.
              /IF.
          /IF.
          IF fk2 IS "struct_ref",
              REAP fpx FROM is_bare_id, arg_el.
              REAP fpk2 FROM stvar_kind, stvars, arg_el.
              REAP amp0 FROM substring, aexpr, 0, 1.
              IF amp0 IS "&", SET aexpr TO substring(aexpr, 1, LEN(aexpr)). /IF.
              IF fpx IS "1" AND fpk2 IS "struct_val", SET aexpr TO "&" + aexpr. /IF.
              IF fpx IS "0" OR fpk2 IS "",
                  REAP e0 FROM substring, arg_el, 0, 1.
                  IF e0 ISNT "\"",
                      REAP cnm4 FROM ffi_struct_cname, fp_ty.
                      SET aexpr TO "plant_map_to_ref_" + cnm4 + "(" + aexpr + ")".
                  /IF.
              /IF.
          /IF.
          IF fk2 IS "callback",
              REAP fpx FROM is_bare_id, arg_el.
              IF fpx IS "1",
                  REAP fpk2 FROM stvar_kind, stvars, arg_el.
                  IF fpk2 IS "",
                      REAP fs2 FROM find_sig, sigs, arg_el.
                      IF COUNT fs2 > 0,
                          SET aexpr TO "plant_cb_ensure(\"" + arg_el + "\", plant_cbw_" + arg_el + ")".
                      /IF.
                  /IF.
              /IF.
          /IF.
          IF fk2 IS "plain",
              CREATE fty0(TX) TO fp_ty.
              REAP fp0 FROM substring, fty0, 0, 4.
              IF fp0 IS "REF ", SET fty0 TO substring(fty0, 4, LEN(fty0)). /IF.
              REAP fp0 FROM substring, fty0, 0, 5.
              IF fp0 IS "ENUM ", SET fty0 TO substring(fty0, 5, LEN(fty0)). /IF.
              REAP fcsv2 FROM enum_in_table, evars, fty0.
              IF fcsv2 ISNT "",
                  SET aexpr TO "_to_enum(" + aexpr + ", \"" + fty0 + "\")".
              /IF.
              REAP rp3 FROM is_ref_at, fparams, ai.
              IF rp3 IS "1",
                  SET aexpr TO "&" + aexpr.
              /IF.
          /IF.
          IF fk2 IS "voidptr",
              SET aexpr TO "(void*)" + aexpr.
          /IF.
      /IF.
      IF ai IS 0,
          SET argstr TO aexpr.
      /IF.
      IF ai > 0,
          SET argstr TO argstr + ", " + aexpr.
      /IF.
      IF safe_call IS "1" AND cl_ok IS "0",
          IF sarcn IS 0,
              SET sargstr TO sarg_el.
          /IF.
          IF sarcn > 0,
              SET sargstr TO sargstr + ", " + sarg_el.
          /IF.
          SET sarcn TO sarcn + 1.
      /IF.
      SET ai TO ai + 1.
  /SEASON.
  # FFI extension return handling
  CREATE ffi_ret(TX) TO "".
  CREATE ffi_rtk(TX) TO "".
  REAP sig2 FROM find_sig, sigs, act.
  IF COUNT sig2 > 0,
      REAP ffi_ret FROM _map_get, sig2, "ret".
      REAP fp9 FROM substring, ffi_ret, 0, 5.
      IF fp9 IS "ENUM ", SET ffi_ret TO substring(ffi_ret, 5, LEN(ffi_ret)). /IF.
      REAP ffi_rtk FROM ffi_param_kind, ffi_ret.
  /IF.
  CREATE call_expr(TX) TO callname + "(" + clcall + argstr + ")".
  REAP asy3 FROM _map_get, sig2, "async".
  IF asy3 IS "1",
      REAP reap_ctx FROM _map_get, node, "ctx".
      IF reap_ctx IS "" OR reap_ctx IS "null", SET reap_ctx TO "0". /IF.
      IF argstr > "",
          SET call_expr TO callname + "(0, " + reap_ctx + ", " + clcall + argstr + ")".
      /IF.
      IF argstr IS "",
          SET call_expr TO callname + "(0, " + reap_ctx + ")".
      /IF.
  /IF.
  IF safe_call IS "1",
      IF sarcn > 0,
          SET call_expr TO "plant_safe_call(\"" + act + "\", " + sarcn + ", " + sargstr + ")".
      /IF.
      IF sarcn IS 0,
          SET call_expr TO "plant_safe_call(\"" + act + "\", 0)".
      /IF.
  /IF.
  CREATE ffi_pref(TX) TO "".
  IF ffi_rtk IS "struct_val",
      REAP rcnm FROM ffi_struct_cname, ffi_ret.
      SET ffi_pref TO ffi_pref + isel + "  plant_ffi_errno = 0;\n".
      IF tgt IS "_",
          GIVE clpre + ffi_pref + isel + "  " + call_expr + ";\n" + clclears.
      /IF.
      REAP stk2 FROM stvar_kind, stvars, tgt.
      IF stk2 > "",
          GIVE clpre + ffi_pref + isel + "  " + tgt + " = plant_" + rcnm + "_to_map(" + call_expr + ");\n" + clclears.
      /IF.
      GIVE clpre + ffi_pref + isel + "  " + tgt + " = plant_" + rcnm + "_to_map(" + call_expr + ");\n" + clclears.
  /IF.
  IF ffi_rtk ISNT "struct_val",
      IF ffi_rtk IS "voidptr" OR ffi_rtk IS "struct_ref",
          SET ffi_pref TO ffi_pref + isel + "  plant_ffi_errno = 0;\n".
      /IF.
      IF tgt IS "_",
          GIVE clpre + ffi_pref + isel + "  " + call_expr + ";\n" + clclears.
      /IF.
      IF tgt ISNT "_",
          REAP ffr2 FROM enum_in_table, evars, ffi_ret.
          IF ffr2 ISNT "",
              REAP rtg2 FROM enum_in_table, evars, tgt.
              IF rtg2 ISNT "",
                  SET call_expr TO "_from_enum(" + call_expr + ", \"" + rtg2 + "\")".
              /IF.
          /IF.
          GIVE clpre + ffi_pref + isel + "  " + tgt + " = " + call_expr + ";\n" + clclears.
      /IF.
  /IF.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  gen_season_stmt — env-based SEASON (while) handler
#  Env slots: 0=indent(isel), 1=sigs, 2=subst, 3=clmap, 4=actx,
#  5=nums, 6=stvars, 7=evars, 8=rty, 9=mexit, 10=wexit, 11=indent_num
# ──────────────────────────────────────────────────────────────
ACTION gen_season_stmt(node, nums(LIST), evars(LIST), isel(TX), indent_num(NUM), env(LIST)),
  REAP cond FROM _map_get, node, "cond".
  REAP bd FROM _map_get, node, "body".
  REAP ccond FROM translate_expr, cond, nums, evars.
  REAP ccond FROM handle_strcmp, ccond.
  CREATE ccode(TX) TO isel + "  while (" + ccond + ") \{\n".
  REAP sigs FROM env_sigs, env.
  REAP subst FROM env_subst, env.
  REAP clmap FROM env_clmap, env.
  REAP actx FROM env_actx, env.
  REAP stvars FROM env_stvars, env.
  REAP rty FROM env_rty, env.
  REAP mexit FROM env_mexit, env.
  REAP wexit FROM env_wexit, env.
  REAP _ FROM env_set, env, 11, _from_long(indent_num + 2).
  REAP bcode FROM generate_body, bd, env.
  REAP _ FROM env_set, env, 11, _from_long(indent_num).
  SET ccode TO ccode + bcode + isel + "  \}\n".
  GIVE ccode.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  gen_cycle_stmt — env-based CYCLE (for) handler
#  Env slots: 0=indent(isel), 1=sigs, 2=subst, 3=clmap, 4=actx,
#  5=nums, 6=stvars, 7=evars, 8=rty, 9=mexit, 10=wexit, 11=indent_num
# ──────────────────────────────────────────────────────────────
ACTION gen_cycle_stmt(node, nums(LIST), evars(LIST), isel(TX), indent_num(NUM), env(LIST)),
  REAP ivar FROM _map_get, node, "iterVar".
  REAP fromExpr FROM _map_get, node, "fromExpr".
  REAP toExpr FROM _map_get, node, "toExpr".
  REAP stepExpr FROM _map_get, node, "stepExpr".
  REAP listExpr FROM _map_get, node, "listExpr".
  REAP indexVar FROM _map_get, node, "indexVar".
  REAP bd FROM _map_get, node, "body".
  CREATE ccode(TX) TO "".
  IF fromExpr ISNT "",
      REAP cfrom FROM translate_expr, fromExpr, nums, evars.
      REAP cto FROM translate_expr, toExpr, nums, evars.
      CREATE stepstr(TX) TO "1".
      IF stepExpr > "" AND stepExpr ISNT "null",
          REAP cstep FROM translate_expr, stepExpr, nums, evars.
          SET stepstr TO cstep.
      /IF.
      REAP sgn FROM _step_sign, stepstr.
      IF sgn IS "0",
          GIVE "#error STEP cannot be 0\n".
      /IF.
      CREATE bound(TX) TO ivar + " <= " + cto.
      IF sgn IS "-",
          SET bound TO ivar + " >= " + cto.
      /IF.
      IF sgn IS "?",
          SET bound TO "((" + stepstr + " != 0) && (((" + stepstr + " > 0) && (" + ivar + " <= " + cto + ")) || ((" + stepstr + " <= 0) && (" + ivar + " >= " + cto + "))))".
      /IF.
      SET ccode TO isel + "  for (long " + ivar + " = " + cfrom + "; " + bound + "; " + ivar + " += " + stepstr + ") \{\n".
      REAP _ FROM env_set, env, 11, _from_long(indent_num + 2).
      REAP bcode FROM generate_body, bd, env.
      REAP _ FROM env_set, env, 11, _from_long(indent_num).
      SET ccode TO ccode + bcode + isel + "  \}\n".
      GIVE ccode.
  /IF.
  IF listExpr ISNT "",
      CREATE idxvar(TX) TO "__cycle_i".
      IF indexVar ISNT "" AND indexVar ISNT "null",
          SET idxvar TO indexVar.
      /IF.
      REAP clist FROM translate_expr, listExpr, nums, evars.
      SET ccode TO isel + "  for (long " + idxvar + " = 0; " + idxvar + " < plant_array_length(" + clist + "); " + idxvar + "++) \{\n".
      SET ccode TO ccode + isel + "    tx_t " + ivar + " = plant_list_get(" + clist + ", " + idxvar + ");\n".
      REAP _ FROM env_set, env, 11, _from_long(indent_num + 2).
      REAP bcode FROM generate_body, bd, env.
      REAP _ FROM env_set, env, 11, _from_long(indent_num).
      SET ccode TO ccode + bcode + isel + "  \}\n".
      GIVE ccode.
  /IF.
  GIVE "".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  gen_weather_stmt — env-based WEATHER handler
#  Env slots: 0=indent(isel), 1=sigs, 2=subst, 3=clmap, 4=actx,
#  5=nums, 6=stvars, 7=evars, 8=rty, 9=mexit, 10=wexit, 11=indent_num
# ──────────────────────────────────────────────────────────────
ACTION gen_weather_stmt(node, isel(TX), indent_num(NUM), env(LIST)),
  REAP bd FROM _map_get, node, "body".
  REAP sh FROM _map_get, node, "shelters".
  REAP cb FROM _map_get, node, "calm".
  CREATE wnm(TX) TO "__w" + _from_long(indent_num).
  REAP wexit FROM env_wexit, env.
  REAP mexit FROM env_mexit, env.
  REAP sigs FROM env_sigs, env.
  REAP subst FROM env_subst, env.
  REAP clmap FROM env_clmap, env.
  REAP actx FROM env_actx, env.
  REAP nums FROM env_nums, env.
  REAP stvars FROM env_stvars, env.
  REAP evars FROM env_evars, env.
  REAP rty FROM env_rty, env.
  CREATE wx0(TX) TO wexit + "  plant_calm(&" + wnm + ");\n".
  CREATE mx0(TX) TO mexit + "  plant_calm(&" + wnm + ");\n".
  REAP _ FROM env_set, env, 11, _from_long(indent_num + 1).
  REAP _ FROM env_set, env, 9, mx0.
  REAP _ FROM env_set, env, 10, wx0.
  REAP cbcode FROM generate_body, cb, env.
  REAP _ FROM env_set, env, 11, _from_long(indent_num).
  REAP _ FROM env_set, env, 9, mexit.
  REAP _ FROM env_set, env, 10, wexit.
  CREATE wx(TX) TO wexit + cbcode + "  plant_calm(&" + wnm + ");\n".
  CREATE mx2(TX) TO mexit + cbcode + "  plant_calm(&" + wnm + ");\n".
  CREATE ccode(TX) TO isel + "  \{\n".
  SET ccode TO ccode + isel + "    PlantWeather " + wnm + " = \{0\};\n".
  SET ccode TO ccode + isel + "    plant_weather_enter(&" + wnm + ", " + _from_long(COUNT sh / 3) + ");\n".
  SET ccode TO ccode + isel + "    if (setjmp(" + wnm + ".buf) == 0) \{\n".
  REAP _ FROM env_set, env, 11, _from_long(indent_num + 2).
  REAP _ FROM env_set, env, 9, mx2.
  REAP _ FROM env_set, env, 10, wx.
  REAP bcode FROM generate_body, bd, env.
  REAP _ FROM env_set, env, 11, _from_long(indent_num).
  REAP _ FROM env_set, env, 9, mexit.
  REAP _ FROM env_set, env, 10, wexit.
  SET ccode TO ccode + bcode + isel + "    \} else \{\n".
  SET ccode TO ccode + isel + "      const char* __et = plant_exc_type();\n".
  SET ccode TO ccode + isel + "      const char* __em = plant_exc_msg();\n".
  SET ccode TO ccode + isel + "      tx_t __ev = plant_exc_val();\n".
  SET ccode TO ccode + isel + "      plant_weather_leave(&" + wnm + ");\n".
  SET ccode TO ccode + isel + "      plant_weather_handling_begin(&" + wnm + ");\n".
  CREATE si2(NUM) TO 0.
  CREATE wty2(TX) TO "".
  CREATE wbd2(TX) TO "".
  CREATE wbind2(TX) TO "".
  SEASON si2 < COUNT sh,
      REAP wty2 FROM plant_list_get, sh, si2.
      REAP wbind2 FROM plant_list_get, sh, si2 + 1.
      REAP wbd2 FROM plant_list_get, sh, si2 + 2.
      IF si2 IS 0,
          SET ccode TO ccode + isel + "      if (plant_storm_match(__et, \"" + wty2 + "\")) \{\n".
      /IF.
      IF si2 > 0,
          SET ccode TO ccode + isel + "      \} else if (plant_storm_match(__et, \"" + wty2 + "\")) \{\n".
      /IF.
      SET ccode TO ccode + isel + "        plant_weather_shelter_enter(&" + wnm + ");\n".
      SET ccode TO ccode + isel + "        " + wnm + ".handled = 1;\n".
      IF wbind2 ISNT "" AND wbind2 ISNT "null",
          SET ccode TO ccode + isel + "        tx_t " + wbind2 + " = __ev;\n".
      /IF.
      REAP _ FROM env_set, env, 11, _from_long(indent_num + 3).
      REAP _ FROM env_set, env, 9, mx2.
      REAP _ FROM env_set, env, 10, wx.
      REAP hcode FROM generate_body, wbd2, env.
      REAP _ FROM env_set, env, 11, _from_long(indent_num).
      REAP _ FROM env_set, env, 9, mexit.
      REAP _ FROM env_set, env, 10, wexit.
      SET ccode TO ccode + hcode.
      SET ccode TO ccode + isel + "        plant_storm_release(__ev);\n".
      SET ccode TO ccode + isel + "        plant_weather_shelter_leave(&" + wnm + ");\n".
      SET si2 TO si2 + 3.
  /SEASON.
  IF COUNT sh > 0,
      SET ccode TO ccode + isel + "      \}\n".
  /IF.
  SET ccode TO ccode + isel + "      plant_weather_handling_end(&" + wnm + ");\n".
  SET ccode TO ccode + isel + "    \}\n".
  SET ccode TO ccode + cbcode.
  SET ccode TO ccode + isel + "    plant_calm(&" + wnm + ");\n".
  SET ccode TO ccode + isel + "  \}\n".
  GIVE ccode.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  gen_throw_stmt — env-based THROW handler
#  Env slots: 0=indent(isel), 5=nums, 7=evars
# ──────────────────────────────────────────────────────────────
ACTION gen_throw_stmt(node, nums(LIST), evars(LIST), isel(TX)),
  REAP wtype2 FROM _map_get, node, "storm".
  REAP wmsg2 FROM _map_get, node, "msg".
  CREATE cmsg(TX) TO "NULL".
  IF wmsg2 > "",
      REAP cmsg FROM translate_expr, wmsg2, nums, evars.
      REAP cmsg FROM _handle_cat, cmsg, nums, evars.
  /IF.
  IF wtype2 IS "",
      GIVE isel + "  plant_throw_obj(" + cmsg + ");\n".
  /IF.
  GIVE isel + "  plant_throw(\"" + wtype2 + "\", " + cmsg + ");\n".
/ACTION.

ACTION generate_body(bd(LIST), env(LIST)),
  CREATE res(TX) TO "".
  CREATE i(NUM) TO 0.
  CREATE node_el(TX) TO "".
  SEASON i < COUNT bd,
    REAP node_el FROM plant_list_get, bd, i.
    REAP node_code FROM generate_node, node_el, env.
    IF node_code > "",
      SET res TO res + node_code.
    /IF.
    SET i TO i + 1.
  /SEASON.
  GIVE res.
/ACTION.

# ═══════════════════════════════════════════════════════════════
#  generate_node — dispatch AST node by type
#  v0.49.56c: This is the EXCLUSIVE parser-to-codegen interface.
#  The parser (parser.plant) builds AST nodes and hands them to
#  generate_node for C code emission — no direct codegen calls
#  from the parser are permitted.
#
#  Parameters:
#    node  — AST node (flat key-value LIST) produced by the parser
#    env   — contextual environment bundle:
#      indent  — current indentation level (NUM)
#      sigs    — action signature map for call resolution (LIST)
#      subst   — type substitution map (LIST)
#      clmap   — closure-var map (flat [varname, closurenode])
#      actx    — "" = normal body, "a" = async step phase body (TX)
#      nums    — names of numeric scalar vars in scope (LIST)
#      stvars   — state variables for async step phases (LIST)
#      evars   — expression-local temp variables (LIST)
#      rty     — enclosing action's substituted return type (TX)
#      mexit   — mid-exit code for async step phases (TX)
#      wexit   — wrap-exit code for async step phases (TX)
#  Returns: C code string (TX) for the given node
# ──────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────
#  v0.48.22-patch3: static STEP evaluation. _step_sign folds a
#  pure-literal integer expression (spaces stripped, + - * / and
#  parens allowed) to its sign: "-" negative, "0" zero, "+"
#  positive, "?" when the step is a runtime expression. A zero
#  step is a compile-time error (parser intercepts it; the codegen
#  re-checks as a backstop), and the bound operator follows the
#  folded sign so "STEP 0 - 2" descends and "STEP 1 + 1" ascends.
# ──────────────────────────────────────────────────────────────
ACTION _is_digit(c(TX)),
  IF c IS "0" OR c IS "1" OR c IS "2" OR c IS "3" OR c IS "4" OR c IS "5" OR c IS "6" OR c IS "7" OR c IS "8" OR c IS "9",
    GIVE 1.
  /IF.
  GIVE 0.
/ACTION.

ACTION _st_num(s(TX), p(NUM)),
  CREATE v(NUM) TO 0.
  SEASON p < LEN(s),
    REAP c FROM char_at, s, p.
    IF _is_digit(c) IS 1,
      SET v TO v * 10 + _to_long(c).
      SET p TO p + 1.
    /IF.
    IF _is_digit(c) ISNT 1, BREAK 0. /IF.
  /SEASON.
  GIVE plant_list_make(2, _from_long(v), _from_long(p)).
/ACTION.

ACTION _st_factor(s(TX), p(NUM)),
  REAP c FROM char_at, s, p.
  IF c IS "-",
    REAP q FROM _st_factor, s, p + 1.
    CREATE v(NUM) TO 0.
    SET v TO _to_long(_first(q)).
    CREATE p2(NUM) TO 0.
    SET p2 TO _to_long(_second(q)).
    IF p2 IS -1, GIVE q. /IF.
    CREATE nv(NUM) TO 0.
    SET nv TO 0 - v.
    GIVE plant_list_make(2, _from_long(nv), _from_long(p2)).
  /IF.
  IF c IS "(",
    REAP q FROM _st_expr, s, p + 1.
    CREATE v(NUM) TO 0.
    SET v TO _to_long(_first(q)).
    CREATE p2(NUM) TO 0.
    SET p2 TO _to_long(_second(q)).
    IF p2 IS -1, GIVE q. /IF.
    REAP c2 FROM char_at, s, p2.
    IF c2 ISNT ")",
      GIVE plant_list_make(2, _from_long(0), _from_long(-1)).
    /IF.
    GIVE plant_list_make(2, _from_long(v), _from_long(p2 + 1)).
  /IF.
  GIVE _st_num(s, p).
/ACTION.

ACTION _st_term(s(TX), p(NUM)),
  REAP q FROM _st_factor, s, p.
  CREATE v(NUM) TO 0.
  SET v TO _to_long(_first(q)).
  CREATE p2(NUM) TO 0.
  SET p2 TO _to_long(_second(q)).
  SEASON TRUE,
    IF p2 IS -1, BREAK 0. /IF.
    REAP c FROM char_at, s, p2.
    IF c IS "*",
      REAP q2 FROM _st_factor, s, p2 + 1.
      CREATE v2(NUM) TO 0.
      SET v2 TO _to_long(_first(q2)).
      CREATE p3(NUM) TO 0.
      SET p3 TO _to_long(_second(q2)).
      IF p3 IS -1, SET p2 TO -1. /IF.
      IF p3 ISNT -1,
        SET v TO v * v2.
        SET p2 TO p3.
      /IF.
      CONTINUE 0.
    /IF.
    IF c IS "/",
      REAP q2 FROM _st_factor, s, p2 + 1.
      CREATE v2(NUM) TO 0.
      SET v2 TO _to_long(_first(q2)).
      CREATE p3(NUM) TO 0.
      SET p3 TO _to_long(_second(q2)).
      IF p3 IS -1, SET p2 TO -1. /IF.
      IF p3 ISNT -1 AND v2 ISNT 0,
        SET v TO v / v2.
        SET p2 TO p3.
      /IF.
      IF p3 ISNT -1 AND v2 IS 0, SET p2 TO -1. /IF.
      CONTINUE 0.
    /IF.
    BREAK 0.
  /SEASON.
  GIVE plant_list_make(2, _from_long(v), _from_long(p2)).
/ACTION.

ACTION _st_expr(s(TX), p(NUM)),
  REAP q FROM _st_term, s, p.
  CREATE v(NUM) TO 0.
  SET v TO _to_long(_first(q)).
  CREATE p2(NUM) TO 0.
  SET p2 TO _to_long(_second(q)).
  SEASON TRUE,
    IF p2 IS -1, BREAK 0. /IF.
    REAP c FROM char_at, s, p2.
    IF c IS "+",
      REAP q2 FROM _st_term, s, p2 + 1.
      CREATE v2(NUM) TO 0.
      SET v2 TO _to_long(_first(q2)).
      CREATE p3(NUM) TO 0.
      SET p3 TO _to_long(_second(q2)).
      IF p3 IS -1, SET p2 TO -1. /IF.
      IF p3 ISNT -1,
        SET v TO v + v2.
        SET p2 TO p3.
      /IF.
      CONTINUE 0.
    /IF.
    IF c IS "-",
      REAP q2 FROM _st_term, s, p2 + 1.
      CREATE v2(NUM) TO 0.
      SET v2 TO _to_long(_first(q2)).
      CREATE p3(NUM) TO 0.
      SET p3 TO _to_long(_second(q2)).
      IF p3 IS -1, SET p2 TO -1. /IF.
      IF p3 ISNT -1,
        SET v TO v - v2.
        SET p2 TO p3.
      /IF.
      CONTINUE 0.
    /IF.
    BREAK 0.
  /SEASON.
  GIVE plant_list_make(2, _from_long(v), _from_long(p2)).
/ACTION.

ACTION _step_sign(e(TX)),
  REAP ne FROM strings:REPLACE, e, " ", "".
  IF ne IS "", GIVE "+". /IF.
  REAP q FROM _st_expr, ne, 0.
  CREATE v(NUM) TO 0.
  SET v TO _to_long(_first(q)).
  CREATE p2(NUM) TO 0.
  SET p2 TO _to_long(_second(q)).
  IF p2 IS -1, GIVE "?". /IF.
  IF p2 < LEN(ne), GIVE "?". /IF.
  IF v > 0, GIVE "+". /IF.
  IF v < 0, GIVE "-". /IF.
  GIVE "0".
/ACTION.

ACTION generate_node(node, env(LIST)),
    REAP ntype FROM _map_get, node, "type".
    REAP indent_num FROM _to_long(env_indent_num(env)).
    REAP sigs FROM env_sigs, env.
    REAP subst FROM env_subst, env.
    REAP clmap FROM env_clmap, env.
    REAP actx FROM env_actx, env.
    REAP nums FROM env_nums, env.
    REAP stvars FROM env_stvars, env.
    REAP evars FROM env_evars, env.
    REAP rty FROM env_rty, env.
    REAP mexit FROM env_mexit, env.
    REAP wexit FROM env_wexit, env.
    REAP isel0 FROM env_indent, env.
    IF clmap IS "",
        SET clmap TO plant_list_make(0).
    /IF.
    IF evars IS "",
        SET evars TO plant_list_make(0).
    /IF.
  
    # ── show_stmt: SHOW expr. → plant_print(expr); ────────────
    #    numeric expressions are wrapped in _from_long so a bare
    #    NUM var / arithmetic / numeric reader prints its value
    #    instead of raw long-as-pointer bits (v0.48.5).
    IF ntype IS "show_stmt",
        REAP code FROM gen_show_stmt, node, nums, evars, isel0.
        GIVE code.
    /IF.

    # -- verify_stmt: VERIFY "label" cond. → plant_verify(label, cond); --
    # v0.49.53: emits plant_verify call with colorized output from runtime.
    IF ntype IS "verify_stmt",
        REAP lbl FROM _map_get, node, "label".
        REAP cond FROM _map_get, node, "cond".
        REAP lbl FROM translate_expr, lbl, nums, evars.
        REAP lbl FROM _handle_cat, lbl, nums, evars.
        REAP ccond FROM translate_expr, cond, nums, evars.
        REAP ccond FROM _handle_cat, ccond, nums, evars.
        REAP isn FROM expr_is_numeric, ccond, nums.
        IF isn IS 1,
            SET ccond TO "_from_long(" + ccond + ")".
        /IF.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  plant_iRuntime_verify(get_runtime(), " + lbl + ", " + ccond + ");\n".
    /IF.

    # -- suite_stmt: SUITE "name", body /SUITE . --
    # v0.49.54: wraps body with plant_suite_setup/teardown calls.
    IF ntype IS "suite_stmt",
        REAP body_nodes FROM _map_get, node, "body".
        CREATE body_code(TX) TO "".
        CREATE bi(NUM) TO 0.
        SEASON bi < COUNT body_nodes,
            REAP bnode FROM plant_list_get, body_nodes, bi.
            REAP bnode_code FROM generate_node, bnode, env.
            SET body_code TO body_code + bnode_code.
            SET bi TO bi + 1.
        /SEASON.
        REAP isel FROM indent_str, indent_num.
        CREATE has_st(TX) TO "0".
        CREATE bdi(NUM) TO 0.
        SEASON bdi < COUNT body_nodes,
            REAP bsn FROM _map_get, plant_list_get(body_nodes, bdi), "type".
            IF bsn IS "setup_stmt", SET has_st TO "1". /IF.
            SET bdi TO bdi + 1.
        /SEASON.
        CREATE has_verify(TX) TO "0".
        CREATE vdi(NUM) TO 0.
        SEASON vdi < COUNT body_nodes,
            REAP vsn FROM _map_get, plant_list_get(body_nodes, vdi), "type".
            IF vsn IS "verify_stmt", SET has_verify TO "1". /IF.
            SET vdi TO vdi + 1.
        /SEASON.
        IF has_st IS "1",
            IF has_verify IS "1",
                GIVE isel + "  plant_iRuntime_suite_setup(get_runtime());\n" + "  plant_iRuntime_verify_begin(get_runtime());\n" + body_code + "  plant_iRuntime_verify_end(get_runtime());\n" + "  plant_iRuntime_suite_teardown(get_runtime());\n".
            /IF.
            IF has_verify IS "0",
                GIVE isel + "  plant_iRuntime_suite_setup(get_runtime());\n" + body_code + "  plant_iRuntime_suite_teardown(get_runtime());\n".
            /IF.
        /IF.
        IF has_st IS "0",
            IF has_verify IS "1",
                GIVE isel + "  plant_iRuntime_verify_begin(get_runtime());\n" + body_code + "  plant_iRuntime_verify_end(get_runtime());\n".
            /IF.
            IF has_verify IS "0",
                GIVE body_code.
            /IF.
        /IF.
    /IF.

    # -- setup_stmt: SETUP expr. --> plant_suite_setup_hook(expr);
    IF ntype IS "setup_stmt",
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val, nums, evars.
        REAP cval FROM _handle_cat, cval, nums, evars.
        REAP isn FROM expr_is_numeric, cval, nums.
        IF isn IS 1,
            SET cval TO "_from_long(" + cval + ")".
        /IF.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  plant_suite_setup_hook(" + cval + ");\n".
    /IF.

    # -- teardown_stmt: TEARDOWN expr. --> plant_suite_teardown_hook(expr);
    IF ntype IS "teardown_stmt",
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val, nums, evars.
        REAP cval FROM _handle_cat, cval, nums, evars.
        REAP isn FROM expr_is_numeric, cval, nums.
        IF isn IS 1,
            SET cval TO "_from_long(" + cval + ")".
        /IF.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  plant_suite_teardown_hook(" + cval + ");\n".
    /IF.
    
    # ── create_stmt: CREATE var(TYPE) TO val. → long/TX var = val; ─
    #    In async step phases the variable lives in the state struct,
    #    restored as a local at step entry → plain assignment, no decl.
    IF ntype IS "create_stmt",
        REAP code FROM gen_create_stmt, node, subst, nums, evars, actx, isel0.
        GIVE code.
    /IF.
  
    # ── set_stmt: SET target TO val. → target = val; ──────────
    IF ntype IS "set_stmt",
        REAP code FROM gen_set_stmt, node, nums, evars, isel0.
        GIVE code.
    /IF.
  
    # ── increase_stmt / decrease_stmt: INCREASE x BY n. → x += n; ─
    #    compound C assignment for numeric targets; a non-numeric
    #    target is rejected at compile time with a #error line
    #    (v0.48.22-patch). The RHS goes through _handle_cat so
    #    numeric literals/vars keep raw arithmetic and text
    #    expressions degrade to concatenation as usual.
    IF ntype IS "increase_stmt" OR ntype IS "decrease_stmt",
        REAP target FROM _map_get, node, "target".
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val, nums, evars.
        REAP cval FROM _handle_cat, cval, nums, evars.
        REAP isel FROM indent_str, indent_num.
        REAP isnc FROM list_contains, nums, target.
        IF isnc IS 0,
            GIVE "#error " + target + " is not a numeric variable; INCREASE/DECREASE require a NUM variable\n".
        /IF.
        IF ntype IS "increase_stmt",
            GIVE isel + "  " + target + " += " + cval + ";\n".
        /IF.
        GIVE isel + "  " + target + " -= " + cval + ";\n".
    /IF.
  
    # ── let_stmt: LET var AS TYPE IS val. → type var = val; ──
    #    async step phases: assignment into the state-backed local.
    # v0.49.27: type_decl is compile-time only; aliases are applied
    # by the parser-side rewrite pass above and the C typedef block.
    # v0.49.33: interface_decl is documentation-only; conformance
    # checks happen at runtime via plant_is_a.
    IF ntype IS "interface_decl",
        GIVE "".
    /IF.

    # v0.49.34: interface_decl is compile-time documentation only.
    IF ntype IS "interface_decl",
        GIVE "".
    /IF.

    IF ntype IS "type_decl",
        GIVE "".
    /IF.

    # v0.49.28 - BLOOM Species AS var -> registered record
    IF ntype IS "bloom_stmt",
        REAP bsp FROM _map_get, node, "species".
        REAP bvar FROM _map_get, node, "var".
        REAP bisel FROM indent_str, indent_num.
        CREATE bb9(TX) TO "".
        SET bb9 TO bb9 + bisel + "  tx_t " + bvar + " = plant_species_create_by_name(\"" + bsp + "\");\n".
        GIVE bb9.
    /IF.

    # v0.49.26 - LET destructuring
    IF ntype IS "let_destructure",
        REAP dsrc FROM _map_get, node, "source".
        REAP ditems FROM _map_get, node, "vars".
        REAP dkind FROM _map_get, node, "pattern".
        REAP srcc FROM translate_expr, dsrc, nums, evars.
        REAP isel FROM indent_str, indent_num.
        CREATE tag(TX) TO _from_long(plant_unique_seq()).
        CREATE dsbase(TX) TO "(".
        SET dsbase TO dsbase + srcc.
        SET dsbase TO dsbase + ")".
        CREATE dcode(TX) TO "".
        REAP dcode FROM _emit_ds, ditems, dkind, dsbase, isel, tag.
        GIVE dcode.
    /IF.

    IF ntype IS "let_stmt",
        REAP target FROM _map_get, node, "target".
        REAP vtype FROM _map_get, node, "var_type".
        REAP vtype FROM subst_type, vtype, subst.
        REAP isel FROM indent_str, indent_num.
        REAP cnd FROM _map_get, node, "closure".
        IF cnd > "",
            REAP envname FROM _map_get, cnd, "envname".
            REAP caps FROM _map_get, cnd, "clcaps".
            REAP moved FROM _map_get, cnd, "moved".
            REAP cid2 FROM _map_get, cnd, "cid".
            CREATE ccode2(TX) TO isel + "  tx_t " + target + " = (tx_t)0;\n".
            IF actx IS "a", SET ccode2 TO isel + "  " + target + " = (tx_t)0;\n". /IF.
            SET ccode2 TO ccode2 + isel + "  { " + envname + "* __env_" + cid2 + " = (" + envname + "*)plant_env_alloc(sizeof(" + envname + "));\n".
            CREATE cpi(NUM) TO 0.
            CREATE capn(TX) TO "".
            CREATE capi(TX) TO "".
            SEASON cpi + 1 < COUNT caps,
                REAP capn FROM plant_list_get, caps, cpi.
                REAP capi FROM plant_list_get, caps, cpi + 1.
                SET ccode2 TO ccode2 + isel + "    __env_" + cid2 + "->" + capn + " = " + capi + ";\n".
                SET cpi TO cpi + 2.
            /SEASON.
            SET ccode2 TO ccode2 + isel + "    " + target + " = (tx_t)__env_" + cid2 + ";\n".
            SET ccode2 TO ccode2 + isel + "  }\n".
            CREATE cmi(NUM) TO 0.
            CREATE cmv(TX) TO "".
            SEASON cmi < COUNT moved,
                REAP cmv FROM plant_list_get, moved, cmi.
                SET ccode2 TO ccode2 + isel + "  " + cmv + " = 0;\n".
                SET cmi TO cmi + 1.
            /SEASON.
            GIVE ccode2.
        /IF.
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val, nums, evars.
        REAP cval FROM _handle_cat, cval, nums, evars.
        IF actx IS "a",
            GIVE isel + "  " + target + " = " + cval + ";\n".
        /IF.
        IF vtype IS "NUM",
            GIVE isel + "  long " + target + " = " + cval + ";\n".
        /IF.
        REAP vst4 FROM is_struct_type, vtype.
        IF vst4 IS "1",
            REAP vct4 FROM ffi_ctype, vtype.
            IF actx IS "a",
                GIVE isel + "  " + target + " = " + cval + ";\n".
            /IF.
            GIVE isel + "  " + vct4 + " " + target + " = " + cval + ";\n".
        /IF.
        IF vtype ISNT "NUM",
            REAP vst5 FROM is_struct_type, vtype.
            IF vst5 ISNT "1",
                GIVE isel + "  tx_t " + target + " = " + cval + ";\n".
            /IF.
        /IF.
    /IF.
  
    # ── give_stmt: GIVE val. → return val; ────────────────────
    #    async step phase: complete the task with the value.
    #    ENUM values (bare member refs, enum vars, struct field
    #    reads) are wrapped with _from_enum at the return site so
    #    callers receive the member-name string (v0.48.11).
    #    Pure numeric GIVEs of NUM-typed actions (explicit -> NUM
    #    or -> T instantiated with NUM) are wrapped with _from_long
    #    so callers get the value as text instead of raw long bits
    #    (v0.48.13); implicit-return actions keep the raw-bit
    #    convention so existing callers are unaffected.
    IF ntype IS "give_stmt",
        REAP code FROM gen_give_stmt, node, nums, evars, rty, actx, mexit, isel0.
        GIVE code.
    /IF.
  
    # ── break_stmt → break; ───────────────────────────────────
    #    v0.48.23: WEATHER frames enclosing the loop are popped by
    #    wexit lines before the jump so no checkpoint goes stale.
    IF ntype IS "break_stmt",
        REAP isel FROM indent_str, indent_num.
        GIVE isel + wexit + isel + "  break;\n".
    /IF.
   
    # ── continue_stmt → continue; ─────────────────────────────
    IF ntype IS "continue_stmt",
        REAP isel FROM indent_str, indent_num.
        GIVE isel + wexit + isel + "  continue;\n".
    /IF.
  
    # ── put_stmt: PUT item INTO target. → plant_list_add(…) ──
    #    v0.48.30: NULL-safe plant_list_add instantiates the list
    #    when the target is null/uninitialized.
    IF ntype IS "put_stmt",
        REAP item FROM _map_get, node, "item".
        REAP target FROM _map_get, node, "target".
        REAP citem FROM translate_expr, item, nums, evars.
        REAP citem FROM _handle_cat, citem, nums, evars.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  " + target + " = plant_list_add(" + target + ", " + citem + ");\n".
    /IF.

    # ── take_stmt: TAKE item FROM target. → plant_list_remove(…) ─
    IF ntype IS "take_stmt",
        REAP item FROM _map_get, node, "item".
        REAP target FROM _map_get, node, "target".
        REAP citem FROM translate_expr, item, nums, evars.
        REAP citem FROM _handle_cat, citem, nums, evars.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  " + target + " = plant_list_remove(" + target + ", " + citem + ");\n".
    /IF.

    # ── braid_stmt: BRAID l1 WITH l2 AS name. ────────────────
    #    zip l1/l2 into a fresh pair list; the target is a NEW
    #    variable, so emit a declaration (v0.48.31).
    IF ntype IS "braid_stmt",
        REAP left FROM _map_get, node, "left".
        REAP right FROM _map_get, node, "right".
        REAP target FROM _map_get, node, "target".
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  PlantArray* " + target + " = plant_braid(" + left + ", " + right + ");\n".
    /IF.

    # ── braid_map_stmt: BRAID l1 WITH l2 AS name MAP. ────────
    IF ntype IS "braid_map_stmt",
        REAP left FROM _map_get, node, "left".
        REAP right FROM _map_get, node, "right".
        REAP target FROM _map_get, node, "target".
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  PlantArray* " + target + " = plant_braid_map(" + left + ", " + right + ");\n".
    /IF.

    # ── link_stmt: LINK key WITH value IN map. → upsert ──────
    IF ntype IS "link_stmt",
        REAP key FROM _map_get, node, "key".
        REAP value FROM _map_get, node, "value".
        REAP target FROM _map_get, node, "target".
        REAP ckey FROM translate_expr, key, nums, evars.
        REAP ckey FROM _handle_cat, ckey, nums, evars.
        REAP cval FROM translate_expr, value, nums, evars.
        REAP cval FROM _handle_cat, cval, nums, evars.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  " + target + " = plant_link(" + target + ", " + ckey + ", " + cval + ");\n".
    /IF.

    # ── harvest_stmt: HARVEST url AS resp [options]. ─────────
    #    resp = plant_net_harvest(url, method, payload, headers, timeout);
    #    resp is a NEW variable → declare; method defaults to "GET",
    #    missing payload/headers/timeout pass ""/0/NULL/0. The AST key
    #    for the request body is "payload" (v0.48.32) — NOT "body",
    #    which generic closure/scope walkers read as the statement
    #    list of structured statements (a collision that crashed
    #    _cl_walk when the payload was a long string). The optional
    #    MAP option (v0.48.34) routes to plant_net_harvest_map, whose
    #    response MAP also carries the live "sock" descriptor.
    IF ntype IS "harvest_stmt",
        REAP hurl FROM _map_get, node, "url".
        REAP hresp FROM _map_get, node, "resp".
        REAP hmeth FROM _map_get, node, "method".
        REAP hbody FROM _map_get, node, "payload".
        REAP hhdrs FROM _map_get, node, "headers".
        REAP htime FROM _map_get, node, "timeout".
        REAP hmap FROM _map_get, node, "map".
        REAP hjson FROM _map_get, node, "json".
        CREATE hfn(TX) TO "plant_net_harvest".
        IF hjson IS "1",
            SET hfn TO "plant_net_harvest_json".
        /IF.
        IF hmap IS "1",
            SET hfn TO "plant_net_harvest_map".
        /IF.
        REAP isel FROM indent_str, indent_num.
        REAP hcurl FROM translate_expr, hurl, nums, evars.
        CREATE hmethod(TX) TO hmeth.
        IF hmethod > "",
            REAP hx0 FROM substring, hmethod, 0, 1.
            IF hx0 ISNT "\"", SET hmethod TO "\"" + hmethod + "\"". /IF.
        /IF.
        IF hmethod IS "", SET hmethod TO "\"GET\"". /IF.
        CREATE hcbody(TX) TO hbody.
        IF hcbody > "",
            REAP hy0 FROM substring, hcbody, 0, 1.
            IF hy0 ISNT "\"",
                REAP hy1 FROM translate_expr, hcbody, nums, evars.
                REAP hy1 FROM _handle_cat, hy1, nums, evars.
                SET hcbody TO hy1.
            /IF.
        /IF.
        IF hcbody IS "", SET hcbody TO "\"\"". /IF.
        CREATE hhdr(TX) TO hhdrs.
        IF hhdr IS "", SET hhdr TO "0". /IF.
        CREATE htmo(TX) TO htime.
        IF htmo > "",
            REAP hz0 FROM substring, htmo, 0, 1.
            IF hz0 ISNT "\"",
                REAP hz1 FROM translate_expr, htmo, nums, evars.
                SET htmo TO hz1.
            /IF.
        /IF.
        IF htmo IS "", SET htmo TO "0". /IF.
        GIVE isel + "  tx_t " + hresp + " = " + hfn + "(" + hcurl + ", " + hmethod + ", " + hcbody + ", " + hhdr + ", " + htmo + ");\n".
    /IF.

    # ── listen_stmt: LISTEN ON port AS req [TIMEOUT t]. ──────
    #    tx_t req = plant_net_listen(port);        (v0.48.33)
    #    tx_t req = plant_net_listen_timeout(port, t);  (v0.49.2)
    #    req is a NEW variable → declare. port is a numeric literal
    #    or a raw expression translated as-is.
    IF ntype IS "listen_stmt",
        REAP ls_port FROM _map_get, node, "port".
        REAP ls_resp FROM _map_get, node, "resp".
        REAP ls_tmo FROM _map_get, node, "timeout".
        REAP isel FROM indent_str, indent_num.
        CREATE lsp(TX) TO ls_port.
        IF lsp > "",
            REAP lsp0 FROM substring, lsp, 0, 1.
            IF lsp0 ISNT "\"",
                REAP lsp1 FROM translate_expr, lsp, nums, evars.
                SET lsp TO lsp1.
            /IF.
        /IF.
        CREATE lst(TX) TO ls_tmo.
        IF lst > "",
            REAP lst0 FROM substring, lst, 0, 1.
            IF lst0 ISNT "\"",
                REAP lst1 FROM translate_expr, lst, nums, evars.
                SET lst TO lst1.
            /IF.
        /IF.
        IF lst IS "",
            GIVE isel + "  tx_t " + ls_resp + " = plant_net_listen(" + lsp + ");\n".
        /IF.
        IF lst ISNT "",
            GIVE isel + "  tx_t " + ls_resp + " = plant_net_listen_timeout(" + lsp + ", " + lst + ");\n".
        /IF.
    /IF.

    # ── respond_stmt: GIVE body AS RESPONSE [JSON]. ──────────
    #    plant_net_respond(req, body);        (v0.48.33)
    #    plant_net_respond_json(req, body);   (v0.49.3)
    #    req names the request MAP from the nearest LISTEN in the
    #    same block (resolved by the parser); an unbound statement
    #    (no LISTEN in scope) is dropped silently. The JSON form
    #    serializes the body (MAP/LIST/PlantJson) with
    #    Content-Type: application/json.
    IF ntype IS "respond_stmt",
        REAP rs_body FROM _map_get, node, "content".
        REAP rs_req FROM _map_get, node, "req".
        REAP rs_json FROM _map_get, node, "json".
        IF rs_req IS "",
            GIVE "".
        /IF.
        REAP isel FROM indent_str, indent_num.
        CREATE rsb(TX) TO rs_body.
        IF rsb > "",
            REAP rsb0 FROM substring, rsb, 0, 1.
            IF rsb0 ISNT "\"",
                REAP rsb1 FROM translate_expr, rsb, nums, evars.
                REAP rsb1 FROM _handle_cat, rsb1, nums, evars.
                SET rsb TO rsb1.
            /IF.
        /IF.
        IF rsb IS "", SET rsb TO "\"\"". /IF.
        CREATE rfn(TX) TO "plant_net_respond".
        IF rs_json IS "1",
            SET rfn TO "plant_net_respond_json".
        /IF.
        GIVE isel + "  " + rfn + "(" + rs_req + ", " + rsb + ");\n".
    /IF.

    # ── sort_stmt: SORT l [ASC|DESC] [BY f…]. → l = plant_sort(l, spec); ─
    #    spec: "" = plain ASC | "DESC" = plain DESC | "f1:DESC,f2:ASC"
    IF ntype IS "sort_stmt",
        REAP target FROM _map_get, node, "target".
        REAP gdir FROM _map_get, node, "gdir".
        REAP fields FROM _map_get, node, "fields".
        REAP dirs FROM _map_get, node, "dirs".
        CREATE spec(TX) TO "".
        REAP isel FROM indent_str, indent_num.
        IF COUNT fields IS 0,
            IF gdir IS "DESC", SET spec TO "DESC". /IF.
        /IF.
        IF COUNT fields > 0,
            CREATE fi(NUM) TO 0.
            SEASON fi < COUNT fields,
                REAP fn FROM plant_list_get, fields, fi.
                REAP fd FROM plant_list_get, dirs, fi.
                IF fi > 0, SET spec TO spec + ",". /IF.
                SET spec TO spec + fn + ":".
                IF fd IS "DESC",
                    SET spec TO spec + "DESC".
                /IF.
                IF fd ISNT "DESC",
                    SET spec TO spec + "ASC".
                /IF.
                SET fi TO fi + 1.
            /SEASON.
        /IF.
        GIVE isel + "  " + target + " = plant_sort(" + target + ", \"" + spec + "\");\n".
    /IF.

    # ── shake_stmt: SHAKE l. → l = plant_shuffle(l); ─
    IF ntype IS "shake_stmt",
        REAP target FROM _map_get, node, "target".
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  " + target + " = plant_shuffle(" + target + ");\n".
    /IF.

    # ── await_stmt: only valid as the final statement of an async
    #    step phase; async_emit_step handles those directly. Any
    #    AWAIT reaching generate_node (normal action body, closure
    #    body, or nested inside IF/SEASON/CYCLE/MATCH of an async
    #    action) is a compile-time error.
    IF ntype IS "await_stmt",
        GIVE "#error AWAIT must be a top-level statement of an ASYNC ACTION body\n".
    /IF.

    # ── start_stmt: START foo, args. / ASYNC IN ctx, foo, args.
    #    → foo(0, 0, args);  (fire-and-forget spawn)
    #    START foo, args IN ctx → plant_async_start_in(ctx, foo, args)
    #    (v0.48.14 contextual spawn; same ABI, zero cost without ctx)
    IF ntype IS "start_stmt",
        REAP act FROM _map_get, node, "action".
        REAP act FROM strings:REPLACE, act, ":", "_".
        CREATE ctx_s(TX) TO "0".
        REAP ctx_n FROM _map_get, node, "ctx".
        IF ctx_n ISNT "" AND ctx_n ISNT "null", SET ctx_s TO ctx_n. /IF.
        CREATE args_s(LIST) TO _map_get(node, "args").
        CREATE argstr_s(TX) TO "".
        REAP argstr_s FROM async_argstr, args_s, sigs, act, nums, stvars, evars.
        REAP isel FROM indent_str, indent_num.
        REAP kind_s FROM _map_get, node, "kind".
        IF ctx_n ISNT "" AND ctx_n ISNT "null",
            CREATE spawn_fn(TX) TO "plant_async_start_in".
            IF kind_s IS "async_in", SET spawn_fn TO "plant_async_in". /IF.
            IF argstr_s > "",
                GIVE isel + "  " + spawn_fn + "(" + ctx_n + ", " + act + ", " + argstr_s + ");\n".
            /IF.
            IF argstr_s IS "",
                GIVE isel + "  " + spawn_fn + "(" + ctx_n + ", " + act + ");\n".
            /IF.
        /IF.
        IF argstr_s > "",
            GIVE isel + "  " + act + "(0, 0, " + argstr_s + ");\n".
        /IF.
        IF argstr_s IS "",
            GIVE isel + "  " + act + "(0, 0);\n".
        /IF.
    /IF.

    # ── cancel_stmt: CANCEL expr. → plant_async_cancel(expr);
    #    CANCEL expr IN ctx → plant_async_cancel_in(ctx, expr) (v0.48.14:
    #    only cancels the handle if it lives in the given context) ─
    IF ntype IS "cancel_stmt",
        REAP val FROM _map_get, node, "value".
        REAP cval FROM translate_expr, val, nums, evars.
        REAP cctx FROM _map_get, node, "ctx".
        REAP isel FROM indent_str, indent_num.
        IF cctx ISNT "" AND cctx ISNT "null",
            GIVE isel + "  plant_async_cancel_in(" + cctx + ", " + cval + ");\n".
        /IF.
        IF cctx IS "" OR cctx IS "null",
            GIVE isel + "  plant_async_cancel(" + cval + ");\n".
        /IF.
    /IF.

    # ── trace_stmt: TRACE INFO|DEBUG|PERF expr. → plant_trace(…);
    #    TRACE … IN ctx → plant_async_trace_in(ctx, level, msg), which
    #    tags the event with the context name (v0.48.14) ─
    IF ntype IS "trace_stmt",
        REAP lv FROM _map_get, node, "level".
        CREATE lvnum(TX) TO "0".
        IF lv IS "DEBUG", SET lvnum TO "1". /IF.
        IF lv IS "PERF", SET lvnum TO "2". /IF.
    REAP val FROM _map_get, node, "value".
    REAP cval FROM translate_expr, val, nums, evars.
    REAP cval FROM _handle_cat, cval, nums, evars.
    REAP tctx FROM _map_get, node, "ctx".
    REAP isel FROM indent_str, indent_num.
    IF tctx ISNT "" AND tctx ISNT "null",
        GIVE isel + "  plant_async_trace_in(" + tctx + ", " + lvnum + ", " + cval + ");\n".
    /IF.
    IF tctx IS "" OR tctx IS "null",
        GIVE isel + "  plant_trace(" + lvnum + ", \"\", " + cval + ");\n".
    /IF.
    /IF.

    # ── config_stmt: MISSION CONFIG KEY = VALUE. → plant_async_config ─
    IF ntype IS "config_stmt",
        REAP key FROM _map_get, node, "key".
        REAP val FROM _map_get, node, "value".
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  plant_async_config(\"" + key + "\", \"" + val + "\");\n".
    /IF.
  
    # ── emit_stmt: raw C statement text (v0.49.11 — bare method
    #    calls like l.push("d"). → plant_list_push(l, "d");) ─
    IF ntype IS "emit_stmt",
        REAP ec2 FROM _map_get, node, "code".
        REAP isel FROM indent_str, indent_num.
        GIVE isel + ec2 + ";\n".
    /IF.

    # ── call_stmt: bare call for void FFI helpers — reuses the
    #    reap_stmt discard path (target "_") so the call is emitted
    #    with the full ffi/struct/varargs arg handling. ─
    IF ntype IS "call_stmt",
        REAP ca2 FROM _map_get, node, "action".
        REAP ca2 FROM _swap_self, ca2.
        CREATE cargs2(LIST) TO _map_get(node, "args").
        CREATE ccl2(LIST) TO _map_get(node, "clargs").
        IF ccl2 IS "",
            SET ccl2 TO plant_list_make(0).
        /IF.
        REAP ca2s FROM _swap_self, ca2.
        SET ca2 TO ca2s.
        CREATE cargs3(LIST) TO plant_list_make(0).
        CREATE cai(NUM) TO 0.
        SEASON cai < COUNT cargs2,
          REAP ael FROM plant_list_get, cargs2, cai.
          REAP asw FROM _swap_self, ael.
          PUT asw INTO cargs3.
          SET cai TO cai + 1.
        /SEASON.
        SET cargs2 TO cargs3.
        CREATE cnode2(LIST) TO plant_list_make(10, "type", "reap_stmt", "target", "_", "action", ca2, "args", cargs2, "clargs", ccl2).
        REAP ccode3 FROM generate_node, cnode2, env.
        GIVE ccode3.
    /IF.

    # ── reap_stmt: REAP var FROM action, args. → var = action(…); ─
    # Generic calls (action[T1, T2]) emit the mangled monomorphized name.
    IF ntype IS "reap_stmt",
        REAP code FROM gen_reap_stmt, node, sigs, subst, clmap, nums, stvars, evars, isel0.
        GIVE code.
    /IF.

    # ── reap_expr_stmt: REAP x FROM a[0]. — direct ingestion from an
    #    indexed location (v0.49.6). The parser captured the whole
    #    expression (a [ 0 ]); translate it here like any value so the
    #    list/map accessors, numeric wrappers, and chained indexing
    #    all apply.
    IF ntype IS "reap_expr_stmt",
        REAP tgt2 FROM _map_get, node, "target".
        REAP expr2 FROM _map_get, node, "expr".
        REAP cval2 FROM translate_expr, expr2, nums, evars.
        REAP cval2 FROM _handle_cat, cval2, nums, evars.
        # v0.49.9 — numeric results (COUNT, arithmetic, _to_long…)
        # are stored as text like numeric-action REAPs, so SHOW/
        # concat never dereference raw long bits.
        REAP isnum2 FROM expr_is_numeric, cval2, nums.
        IF isnum2 IS 1,
            SET cval2 TO "_from_long(" + cval2 + ")".
        /IF.
        REAP isel2 FROM indent_str, indent_num.
        GIVE isel2 + "  " + tgt2 + " = " + cval2 + ";\n".
    /IF.
  
    # ── const_stmt: CONST name TO "lit". → static const char *name ─
    #    = "lit"; (v0.48.35). Root-elevated constants ("root":"1")
    #    emit nothing at their position — the first-pass collector
    #    hoists them to file scope, so the block-scoped decl would
    #    only duplicate them. "static" keeps the binding scoped to
    #    the enclosing C block; a same-named ROOT constant at file
    #    scope is shadowed (local-first lookup), and a same-named
    #    local const in a sibling/nested block shadows again — the
    #    exact lexical hierarchy the tables at parse time enforce.
    IF ntype IS "const_stmt",
        REAP cname FROM _map_get, node, "name".
        REAP cval FROM _map_get, node, "value".
        REAP croot FROM _map_get, node, "root".
        IF croot IS "1",
            GIVE "".
        /IF.
        REAP isel FROM indent_str, indent_num.
        REAP cpre FROM substring, cval, 0, 1.
        IF cpre ISNT "\"",
            GIVE "#error " + cname + " CONST value must be a quoted string literal\n".
        /IF.
        GIVE isel + "  static const char *" + cname + " = " + cval + ";\n".
    /IF.

    # ── root_stmt: ROOT name TO "lit". → no inline code ───────────
    #    (file-scope static const emitted at the top by the first
    #    pass). The statement position is a no-op.
    # v0.49.25: import_stmt is expanded by the loader (main.plant);
    # residual nodes generate nothing.
    IF ntype IS "import_stmt",
        GIVE "".
    /IF.

    IF ntype IS "root_stmt",
        GIVE "".
    /IF.

    # ── root_scope: ROOT_SCOPE … /ROOT_SCOPE. wrapper ─────────────
    #    Its constants are hoisted; any non-constant statements still
    #    generate inline, so the body can be walked with generate_body
    #    (elevated const_stmt/root_stmt nodes are no-ops there).
    IF ntype IS "root_scope",
        REAP bd8 FROM _map_get, node, "body".
        REAP bcode8 FROM generate_body, bd8, env.
        GIVE bcode8.
    /IF.

    # ── now_stmt: NOW [FORMAT:x]. → plant_print(plant_now(fmt)); ──
    IF ntype IS "now_stmt",
        REAP fmt0 FROM _map_get, node, "fmt".
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  plant_iReport_print(get_report(), plant_now(\"" + fmt0 + "\"));\n".
    /IF.

    # ── analyze_stmt: ANALYZE x. → plant_print(plant_map_to_string(plant_analyze(x))); ─
    IF ntype IS "analyze_stmt",
        REAP tgt FROM _map_get, node, "target".
        REAP cval FROM translate_expr, tgt, nums, evars.
        REAP cval FROM _handle_cat, cval, nums, evars.
        REAP isn2 FROM expr_is_numeric, cval, nums.
        IF isn2 IS 1,
            SET cval TO "_from_long(" + cval + ")".
        /IF.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  plant_iReport_print(get_report(), plant_map_to_string(plant_analyze(" + cval + ")));\n".
    /IF.

    # ── typeof_stmt: TYPEOF x. → plant_print(plant_typeof(x)); ────
    IF ntype IS "typeof_stmt",
        REAP tgt2 FROM _map_get, node, "target".
        REAP cval2 FROM translate_expr, tgt2, nums, evars.
        REAP cval2 FROM _handle_cat, cval2, nums, evars.
        REAP isn3 FROM expr_is_numeric, cval2, nums.
        IF isn3 IS 1,
            SET cval2 TO "_from_long(" + cval2 + ")".
        /IF.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  plant_iReport_print(get_report(), plant_typeof(" + cval2 + "));\n".
    /IF.

    # ── free_stmt: FREE x. → x = plant_mem_free((tx_t)x); ────
    IF ntype IS "free_stmt",
        REAP ftgt FROM _map_get, node, "target".
        REAP fcv FROM translate_expr, ftgt, nums, evars.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  " + fcv + " = plant_mem_free((tx_t)" + fcv + ");\n".
    /IF.

    # ── arc_link_stmt / arc_unlink_stmt: ARC LINK a TO b. ──
    IF ntype IS "arc_link_stmt" OR ntype IS "arc_unlink_stmt",
        REAP ap FROM _map_get, node, "parent".
        REAP ac FROM _map_get, node, "child".
        REAP avp FROM translate_expr, ap, nums, evars.
        REAP avc FROM translate_expr, ac, nums, evars.
        REAP isnp FROM expr_is_numeric, avp, nums.
        IF isnp IS 1,
            SET avp TO "_from_long(" + avp + ")".
        /IF.
        REAP isnc FROM expr_is_numeric, avc, nums.
        IF isnc IS 1,
            SET avc TO "_from_long(" + avc + ")".
        /IF.
        REAP isel FROM indent_str, indent_num.
        IF ntype IS "arc_link_stmt",
            GIVE isel + "  plant_arc_link((tx_t)" + avp + ", (tx_t)" + avc + ");\n".
        /IF.
        GIVE isel + "  plant_arc_unlink((tx_t)" + avp + ", (tx_t)" + avc + ");\n".
    /IF.

    # ── fast_reset_stmt: FAST RESET. → plant_fast_reset(); ──
    IF ntype IS "fast_reset_stmt",
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  plant_fast_reset();\n".
    /IF.

    # ── wait_stmt: WAIT [n]. → plant_msleep(n); ─────────────
    #    v0.48.37e — execution throttling. The millisecond operand
    #    becomes a raw C long expression; a bare WAIT. (legacy async
    #    phase spelling) and zero/negative durations are no-ops at
    #    runtime (plant_msleep clamps ms <= 0).
    IF ntype IS "wait_stmt",
        REAP wms FROM _map_get, node, "ms".
        REAP isel FROM indent_str, indent_num.
        CREATE wsleep(TX) TO "0".
        IF wms > "",
            REAP wc2 FROM translate_expr, wms, nums, evars.
            SET wsleep TO wc2.
        /IF.
        GIVE isel + "  plant_msleep(" + wsleep + ");\n".
    /IF.

    # ── lock_stmt: LOCK var. → plant_lock((tx_t)var); ───────
    #    v0.48.37e — synchronization. The target variable's value is
    #    registered as a locking key in the runtime lock table; numeric
    #    targets are stringified so their value is the key.
    IF ntype IS "lock_stmt",
        REAP lv2 FROM _map_get, node, "var".
        REAP lcv2 FROM translate_expr, lv2, nums, evars.
        REAP isnl2 FROM expr_is_numeric, lcv2, nums.
        IF isnl2 IS 1,
            SET lcv2 TO "_from_long(" + lcv2 + ")".
        /IF.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  plant_lock((tx_t)" + lcv2 + ");\n".
    /IF.

    # ── if_stmt: IF cond, body [ORIF cond2, body2]* [ELSE, bodyE] /IF. ─
    #    → if (c) { … } else if (c2) { … } else { … }  (v0.48.20)
    IF ntype IS "if_stmt",
        REAP code FROM gen_if_stmt, node, nums, evars, isel0, indent_num, env.
        GIVE code.
    /IF.
  
    # ── season_stmt: SEASON cond, body /SEASON. → while(cond) {…} ─
    IF ntype IS "season_stmt",
        REAP code FROM gen_season_stmt, node, nums, evars, isel0, indent_num, env.
        GIVE code.
    /IF.
  
    # ── cycle_stmt: FROM/TO → for(iter=from; iter<=to; iter+=step) ─
    IF ntype IS "cycle_stmt",
        REAP code FROM gen_cycle_stmt, node, nums, evars, isel0, indent_num, env.
        GIVE code.
    /IF.
  
    # ── weather_stmt: WEATHER … SHELTER … CALM … /WEATHER. ──
    #    v0.48.23 — WEATHER/SHELTER/CALM exception management.
    #    Emits a setjmp/longjmp checkpoint frame: the protected body
    #    runs with the checkpoint pushed; a storm transfers control
    #    to the else branch, where the captured exception is matched
    #    against each SHELTER type via plant_storm_match (name
    #    equality, with ANY_STORM catching everything as the
    #    catch-all — v0.48.23-patch centralizes matching in the
    #    runtime so all 13 registered storm kinds route here), the
    #    message is optionally bound via `AS err`, and the frame is
    #    popped so a handler THROW propagates outward.
    #    v0.48.25 — the CALM body runs through plant_calm: it is
    #    embedded in the threaded mexit/wexit exit lists so
    #    GIVE/BREAK/CONTINUE interruptions still finalize, and the
    #    unmatched-storm rethrow moved from generated guards into
    #    plant_calm (raised && !handled), which pops the frame and
    #    re-raises so the storm bubbles to the enclosing WEATHER.
    #    The frame variable is named from the indent level so nested
    #    WEATHER blocks each address their own checkpoint even
    #    through the mexit/wexit threading below.
    #    v0.48.37d — weather memory management. Each frame registers
    #    its SHELTER hook count at enter; the exceptional path pops
    #    the frame (plant_weather_leave tears down its exit-list),
    #    then plant_weather_handling_begin makes it the registration
    #    target for handler temporaries, which the per-shelter
    #    plant_weather_shelter_enter/leave pair purges immediately
    #    after each handler body runs (prior to exiting the shelter
    #    scope). plant_weather_handling_end closes the dispatch.
    IF ntype IS "weather_stmt",
        REAP code FROM gen_weather_stmt, node, isel0, indent_num, env.
        GIVE code.
    /IF.
  
    # ── throw_stmt: THROW <storm> "msg". → plant_throw(type, msg) ─
    IF ntype IS "throw_stmt",
        REAP code FROM gen_throw_stmt, node, nums, evars, isel0.
        GIVE code.
    /IF.
  
    # ── stop_if_stmt: STOP IF cond. → if(cond) STOP_STORM ──
    #    v0.48.25 — conditional execution halting: evaluates the
    #    condition like an IF header and raises the STOP_STORM
    #    classification through the standard exception pipeline when
    #    it is true. A NULL message lets the runtime registry supply
    #    the descriptive default ("conditional stop requested").
    IF ntype IS "stop_if_stmt",
        REAP scond FROM _map_get, node, "cond".
        REAP scc FROM translate_expr, scond, nums, evars.
        REAP scc FROM handle_strcmp, scc.
        REAP isel FROM indent_str, indent_num.
        GIVE isel + "  if (" + scc + ") \{\n" + isel + "    plant_throw(\"STOP_STORM\", NULL);\n" + isel + "  \}\n".
    /IF.
  
    # ── match_stmt: MATCH subject { pattern -> body } →
    #    { tx_t __mt = <subject>;
    #      if (_match_eq(__mt, "lit")) { … }          // literal arm
    #      else if (plant_array_length(__mt) == 2 && _match_eq(plant_list_get(__mt, 0), "Tag")) {
    #        tx_t <bind> = _match_extract(__mt, "Tag"); … }  // binding arm
    #      else { … } }                               // wildcard arm
    #    The __mt temp lives in its own block so nested or sibling
    #    MATCHes never collide, and binding declarations inside arm
    #    blocks are C-block-scoped (v0.49.7).
    IF ntype IS "match_stmt",
        REAP subj FROM _map_get, node, "subjectExpr".
        CREATE clauses(LIST) TO _map_get(node, "clauses").
        REAP csubj FROM translate_expr, subj, nums, evars.
        REAP isel FROM indent_str, indent_num.
        CREATE ccode(TX) TO isel + "  \{\n" + isel + "    tx_t __mt = " + csubj + ";\n".
        CREATE ci(NUM) TO 0.
        CREATE clause(TX) TO "".
        CREATE vname(TX) TO "".
        CREATE binding(TX) TO "".
        CREATE wc(NUM) TO 0.
        SEASON ci < COUNT clauses,
            REAP clause FROM plant_list_get, clauses, ci.
            REAP vname FROM _map_get, clause, "variantName".
            REAP binding FROM _map_get, clause, "binding".
            REAP cbody FROM _map_get, clause, "bodyStatements".
            SET wc TO 0.
            IF vname IS "_", SET wc TO 1. /IF.
            IF ci IS 0,
                IF wc IS 1,
                    SET ccode TO ccode + isel + "    if (1) \{\n".
                /IF.
                IF wc IS 0,
                    IF binding > "" AND binding ISNT "null",
                        SET ccode TO ccode + isel + "    if (plant_array_length(__mt) == 2 && _match_eq(plant_list_get(__mt, 0), \"" + vname + "\")) \{\n".
                    /IF.
                    IF binding IS "" OR binding IS "null",
                        SET ccode TO ccode + isel + "    if (_match_eq(__mt, \"" + vname + "\")) \{\n".
                    /IF.
                /IF.
            /IF.
            IF ci > 0,
                IF wc IS 1,
                    SET ccode TO ccode + isel + "    \} else \{\n".
                /IF.
                IF wc IS 0,
                    IF binding > "" AND binding ISNT "null",
                        SET ccode TO ccode + isel + "    \} else if (plant_array_length(__mt) == 2 && _match_eq(plant_list_get(__mt, 0), \"" + vname + "\")) \{\n".
                    /IF.
                    IF binding IS "" OR binding IS "null",
                        SET ccode TO ccode + isel + "    \} else if (_match_eq(__mt, \"" + vname + "\")) \{\n".
                    /IF.
                /IF.
            /IF.
            IF binding > "" AND binding ISNT "null",
                SET ccode TO ccode + isel + "        tx_t " + binding + " = _match_extract(__mt, \"" + vname + "\");\n".
            /IF.
            REAP _ FROM env_set, env, 11, _from_long(indent_num + 4).
            REAP bcode FROM generate_body, cbody, env.
            REAP _ FROM env_set, env, 11, _from_long(indent_num).
            SET ccode TO ccode + bcode.
            IF ci + 1 IS COUNT clauses,
                SET ccode TO ccode + isel + "    \}\n".
            /IF.
            SET ci TO ci + 1.
        /SEASON.
        SET ccode TO ccode + isel + "  \}\n".
        GIVE ccode.
    /IF.
  
    # ── external_decl: ACTION name(params) -> external. → no code (plant_compat.h) ─
    IF ntype IS "external_decl",
        GIVE "".
    /IF.

    # ── struct_decl: STRUCT name { field: TYPE, … } → no code here;
    #    typedefs (plain + mangled instantiations) come from the
    #    structs table pass in generate_c.
    IF ntype IS "struct_decl",
        GIVE "".
    /IF.

    # ── action_decl: ACTION name(params), body /ACTION. → void name(…) {…} ─
    # Generic templates emit nothing here; monomorphized copies are emitted
    # separately for each instantiation (see emit_inst).
    IF ntype IS "action_decl",
        CREATE gens_nd(LIST) TO _map_get(node, "generics").
        IF COUNT gens_nd IS 0,
            REAP aname FROM _map_get, node, "name".
            CREATE fnname(TX) TO aname.
            IF aname IS "main" AND _map_get(node, "main_rename") IS "1",
                SET fnname TO "plant_main".
            /IF.
            CREATE params(LIST) TO _map_get(node, "params").
            REAP bd FROM _map_get, node, "body".
            CREATE stvars_a(LIST) TO collect_stvars(bd, params, subst).
        # ── ASYNC ACTION: state struct + step function + entry ──
        #    (v0.48.3 async engine; generic async actions unsupported)
        CREATE asy_mark(TX) TO _map_get(node, "async").
        IF asy_mark IS "1",
            REAP prio_s FROM _map_get, node, "prio".
            CREATE avars(LIST) TO async_collect_vars(bd, params).
            CREATE aphases(LIST) TO async_split_phases(bd).
            CREATE evars_asy(LIST) TO collect_enums(bd, params, subst, evars, sigs).
            REAP st_code FROM async_emit_state, aname, avars.
            REAP en_code FROM async_emit_entry, aname, params, prio_s, _map_get(node, "mission_mode").
            REAP stp_code FROM async_emit_step, aname, aphases, avars, sigs, subst, clmap, stvars_a, evars_asy.
            GIVE "static int plant_a_" + aname + "_step(tx_t st);\n\n" + st_code + en_code + stp_code.
        /IF.
        CREATE paramstr(TX) TO "".
        CREATE pi(NUM) TO 0.
        CREATE param_el(TX) TO "".
        SEASON pi < COUNT params,
            REAP param_el FROM plant_list_get, params, pi.
            REAP pname FROM _map_get, param_el, "name".
            REAP ptype FROM _map_get, param_el, "type".
            REAP ctype FROM ffi_ctype, ptype.
            IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
            SET paramstr TO paramstr + ctype + " " + pname.
            SET pi TO pi + 1.
        /SEASON.
        CREATE nums_a(LIST) TO collect_nums(bd, params, subst).
        CREATE evars_a(LIST) TO collect_enums(bd, params, subst, evars, sigs).
        CREATE ccode(TX) TO "tx_t " + fnname + "(" + paramstr + ") \{\n".
        CREATE implicit(LIST) TO collect_implicit(bd, params).
        CREATE dcode(TX) TO "".
        CREATE di(NUM) TO 0.
        CREATE dv(TX) TO "".
        SEASON di < COUNT implicit,
            REAP dv FROM plant_list_get, implicit, di.
            SET dcode TO dcode + "  tx_t " + dv + " = \"\";\n".
            SET di TO di + 1.
        /SEASON.
        # v0.48.13: the declared -> Type after substitution drives
        # _from_long wrapping of numeric GIVEs ("" for implicit)
        CREATE rty_a(TX) TO subst_type(_map_get(node, "ret"), subst).
        # v0.48.18: the mission-mode exit lines are computed up front so
        # they can be threaded into the body generator — GIVE returns
        # emit them before the return; tail returns get them appended
        # after the body (see below).
        CREATE mmode(TX) TO _map_get(node, "mission_mode").
        CREATE amode_exit(TX) TO "".
        IF mmode IS "FAST", SET amode_exit TO "  plant_fast_reset();\n  plant_fast_exit();\n". /IF.
        IF mmode IS "SAFE", SET amode_exit TO "  plant_safe_exit();\n". /IF.
        IF mmode IS "SMART", SET amode_exit TO "  plant_smart_exit(\"" + aname + "\");\n". /IF.
        IF mmode IS "PERSISTENT", SET amode_exit TO "  plant_persist_exit();\n". /IF.
        REAP bcode FROM generate_body, bd, env_make(1, sigs, subst, clmap, actx, nums_a, stvars_a, evars_a, rty_a, amode_exit, "").
        # v0.49.53: scan body for verify_stmt nodes; wrap with
        # plant_verify_begin/end only for actions that contain VERIFY
        # assertions (test actions).
        CREATE has_verify(FACT) TO FALSE.
        CREATE vbdi(NUM) TO 0.
        SEASON vbdi < COUNT bd,
            REAP vbnd FROM plant_list_get, bd, vbdi.
            REAP vbnd_ty FROM _map_get, vbnd, "type".
            IF vbnd_ty IS "verify_stmt", SET has_verify TO TRUE. /IF.
            SET vbdi TO vbdi + 1.
        /SEASON.
        IF has_verify IS TRUE, SET bcode TO "  plant_iRuntime_verify_begin(get_runtime());\n" + bcode. /IF.
        # v0.48.15: Mission Mode binding — FAST actions bind the bump
        # heap (plant_fast_enter resets it at every scope enter);
        # SAFE actions carry the Boundary Handshake guard so FAST
        # callers are blocked at the callee entry.
        # v0.48.16: every guarded mode (FAST/SAFE/SMART/PERSISTENT)
        # carries the callee-side boundary guard with its mode; FAST
        # binds the bump heap, SAFE binds the warm pool + SafeChannel.
        IF mmode IS "FAST",
            SET bcode TO "  if (plant_boundary_block(\"" + aname + "\", \"FAST\")) return \"\";\n  plant_fast_enter(\"" + aname + "\");\n" + bcode.
        /IF.
        IF mmode IS "SAFE",
            SET bcode TO "  if (plant_boundary_block(\"" + aname + "\", \"SAFE\")) return \"\";\n  plant_safe_enter(\"" + aname + "\");\n  plant_safe_channel_init(\"" + aname + "\");\n" + bcode.
        /IF.
        # v0.48.17: SMART binds the SmartExecutionRouter, which routes on
        # the dataset size (first NUM parameter): N < threshold runs
        # Scalar Inline, N >= threshold runs Parallel Vector Mode with
        # chunk dispatch over the dynamic vec pool.
        IF mmode IS "SMART",
            CREATE sp(TX) TO "0".
            CREATE spi(NUM) TO 0.
            SEASON spi < COUNT params,
                REAP sp_ty FROM _map_get, params[spi], "type".
                IF sp_ty IS "NUM",
                    REAP sp FROM _map_get, params[spi], "name".
                    SET spi TO COUNT params.
                /IF.
                SET spi TO spi + 1.
            /SEASON.
            SET bcode TO "  if (plant_boundary_block(\"" + aname + "\", \"SMART\")) return \"\";\n  plant_smart_enter(\"" + aname + "\", " + sp + ");\n" + bcode.
        /IF.
        IF mmode IS "PERSISTENT",
            SET bcode TO "  if (plant_boundary_block(\"" + aname + "\", \"PERSISTENT\")) return \"\";\n  plant_persist_enter(\"" + aname + "\");\n" + bcode.
        /IF.
        # v0.48.16: leave the mission mode (release worker/channel for
        # SAFE, pop the mode stack for FAST) before the tail returns.
        # GIVE-terminated bodies already carried the exit lines (they
        # were threaded into the body generator as mexit), so only
        # non-give tails get the exit appended here.
        IF (COUNT bd) > 0,
            CREATE bd_count2(NUM) TO COUNT bd.
            CREATE last_idx2(NUM) TO bd_count2 - 1.
            CREATE last_nd2(TX) TO plant_list_get(bd, last_idx2).
            CREATE last_ty2(TX) TO _map_get(last_nd2, "type").
            IF amode_exit > "" AND last_ty2 ISNT "give_stmt",
                SET bcode TO bcode + amode_exit.
            /IF.
        /IF.
        IF (COUNT bd) IS 0,
            IF amode_exit > "",
                SET bcode TO bcode + amode_exit.
            /IF.
        /IF.
        # plant_async_drain() for ACTION main() when async is
        # reachable from its call graph (drain_after marker set by
        # generate_c pass 2b). Skipped when main ends in explicit
        # GIVE (the give's return would precede the drain).
        REAP drn2 FROM _map_get, node, "drain_after".
        IF (COUNT bd) IS 0,
            IF drn2 IS "1", SET bcode TO bcode + "  plant_async_drain();\n". /IF.
            # v0.49.24: empty bodies must return a valid tx_t, not the
            # function designator (fnname decays to a pointer here).
            IF has_verify IS TRUE, SET bcode TO bcode + "  plant_iRuntime_verify_end(get_runtime());\n". /IF.
            SET bcode TO bcode + "  return \"\";\n".
        /IF.
        IF (COUNT bd) > 0,
            CREATE bd_count(NUM) TO COUNT bd.
            CREATE last_idx(NUM) TO bd_count - 1.
            CREATE last_nd(TX) TO plant_list_get(bd, last_idx).
            CREATE last_ty(TX) TO _map_get(last_nd, "type").
            IF drn2 IS "1" AND last_ty ISNT "give_stmt",
                SET bcode TO bcode + "  plant_async_drain();\n".
            /IF.
            IF last_ty ISNT "give_stmt",
                IF has_verify IS TRUE, SET bcode TO bcode + "  plant_iRuntime_verify_end(get_runtime());\n". /IF.
                SET bcode TO bcode + "  return " + fnname + ";\n".
            /IF.
        /IF.
        SET ccode TO ccode + dcode + bcode + "\}\n".
        GIVE ccode.
        /IF.
        GIVE "".
    /IF.
  
    # ── enum_decl: ENUM name { MEMBER, … } → typedef enum { … } name; ─
    IF ntype IS "enum_decl",
        REAP ename FROM _map_get, node, "name".
        CREATE members(LIST) TO _map_get(node, "members").
        CREATE ccode(TX) TO "typedef enum \{\n  ".
        CREATE mi(NUM) TO 0.
        CREATE member_el(TX) TO "".
        SEASON mi < COUNT members,
            REAP member_el FROM plant_list_get, members, mi.
            IF mi > 0, SET ccode TO ccode + ",\n  ". /IF.
            SET ccode TO ccode + member_el.
            SET mi TO mi + 1.
        /SEASON.
        SET ccode TO ccode + "\n\} " + ename + ";\n".
        # guard macro lets FFI mock code reference the enum type and
        # its member constants (#ifdef PLANT_ENUM_Color) (v0.48.12)
        GIVE "#define PLANT_ENUM_" + ename + " 1\n" + ccode.
    /IF.
    GIVE "".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  plant_ctype — PlantLang param type → C type (REF → pointer)
#  Generic/container types (LIST[T]) are stripped to their base
#  before mapping, so LIST[NUM] → PlantArray*.
# ──────────────────────────────────────────────────────────────
ACTION type_base(ptype(TX)),
    REAP bi FROM find_any, ptype, "[".
    IF bi IS -1, GIVE ptype. /IF.
    REAP b FROM substring, ptype, 0, bi.
    REAP bt FROM trim, b.
    GIVE bt.
/ACTION.

ACTION plant_ctype(ptype(TX)),
    REAP base FROM type_base, ptype.
    IF base IS "NUM", GIVE "long". /IF.
    IF base IS "FACT", GIVE "int". /IF.
    IF base IS "LIST", GIVE "PlantArray*". /IF.
    IF base IS "REF NUM", GIVE "long*". /IF.
    IF base IS "REF FACT", GIVE "int*". /IF.
    IF base IS "REF LIST", GIVE "PlantArray**". /IF.
    IF base IS "REF TX", GIVE "tx_t*". /IF.
    GIVE "tx_t".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  v0.48.4 — FFI Optional Extensions
#  Type classification + marshalling helpers for STRUCT-by-value,
#  STRUCT-by-pointer (REF STRUCT), void*, CALLBACK and varargs.
#  Plain struct names (no STRUCT prefix) keep the opaque tx_t ABI.
# ──────────────────────────────────────────────────────────────

# ffi_param_kind — classify an FFI param type:
#   struct_val   STRUCT X (by value)
#   struct_ref   REF STRUCT X (by pointer)
#   voidptr      void*
#   callback     CALLBACK
#   plain        everything else
ACTION ffi_param_kind(ptype(TX)),
  REAP p0 FROM substring, ptype, 0, 4.
  IF p0 IS "REF ",
    REAP rest FROM substring, ptype, 4, LEN(ptype).
    REAP r0 FROM substring, rest, 0, 7.
    IF r0 IS "STRUCT ", GIVE "struct_ref". /IF.
    GIVE "plain".
  /IF.
  REAP s0 FROM substring, ptype, 0, 7.
  IF s0 IS "STRUCT ", GIVE "struct_val". /IF.
  IF str_eq(ptype, "void*") IS "1", GIVE "voidptr". /IF.
  IF str_eq(ptype, "CALLBACK") IS "1", GIVE "callback". /IF.
  GIVE "plain".
/ACTION.

# ffi_struct_name — "STRUCT Point" / "REF STRUCT Box [ NUM ]" →
# "Point" / "Box [ NUM ]" (struct type text without markers)
ACTION ffi_struct_name(typ(TX)),
  REAP p0 FROM substring, typ, 0, 4.
  IF p0 IS "REF ",
    REAP rest FROM substring, typ, 4, LEN(typ).
    SET typ TO rest.
  /IF.
  REAP s0 FROM substring, typ, 0, 7.
  IF s0 IS "STRUCT ",
    GIVE substring(typ, 7, LEN(typ)).
  /IF.
  GIVE typ.
/ACTION.

# ffi_struct_cname — struct type text → generated C typedef name:
# "Point" → plant_Point, "Box [ NUM ]" → plant_Box_NUM
ACTION ffi_struct_cname(typ(TX)),
  REAP p0 FROM substring, typ, 0, 4.
  IF p0 IS "REF ",
    REAP typ FROM substring, typ, 4, LEN(typ).
  /IF.
  REAP s0 FROM substring, typ, 0, 7.
  IF s0 IS "STRUCT ",
    REAP typ FROM substring, typ, 7, LEN(typ).
  /IF.
  REAP b0 FROM base_of, typ.
  REAP bt0 FROM trim, b0.
  CREATE cname(TX) TO "plant_" + bt0.
  REAP bi FROM find_any, typ, "[".
  IF bi ISNT -1,
    REAP gargs FROM parse_type_args, typ.
    CREATE ai(NUM) TO 0.
    CREATE av(TX) TO "".
    SEASON ai < COUNT gargs,
      REAP av FROM plant_list_get, gargs, ai.
      SET cname TO cname + "_" + av.
      SET ai TO ai + 1.
    /SEASON.
  /IF.
  GIVE cname.
/ACTION.

# is_struct_type — 1 when a type is a struct type (not a primitive
# scalar NUM/FACT/TX/LIST, not a REF, not empty)
ACTION is_struct_type(t(TX)),
  REAP base FROM type_base, t.
  REAP tb FROM trim, base.
  IF tb IS "NUM", GIVE "0". /IF.
  IF tb IS "FACT", GIVE "0". /IF.
  IF tb IS "TX", GIVE "0". /IF.
  IF tb IS "LIST", GIVE "0". /IF.
  IF tb IS "", GIVE "0". /IF.
  REAP rf FROM substring, tb, 0, 4.
  IF rf IS "REF ", GIVE "0". /IF.
  GIVE "1".
/ACTION.

# collect_stvars_walk — struct-typed CREATE/LET targets in a body
ACTION collect_stvars_walk(bd(LIST), subst(LIST), res(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE wnd(TX) TO "".
  CREATE wty(TX) TO "".
  CREATE wtg(TX) TO "".
  CREATE wvt(TX) TO "".
  CREATE wbs(TX) TO "".
  SEASON wi < COUNT bd,
    REAP wnd FROM plant_list_get, bd, wi.
    REAP wty FROM _map_get, wnd, "type".
    IF wty IS "create_stmt" OR wty IS "let_stmt",
      REAP wtg FROM _map_get, wnd, "target".
      REAP wvt FROM _map_get, wnd, "var_type".
      REAP wbs FROM subst_type, wvt, subst.
      REAP wsf FROM is_struct_type, wbs.
      IF wsf IS "1",
        REAP wfound FROM list_contains, res, wtg.
        IF wfound IS 0,
          PUT wtg INTO res.
          REAP wk2 FROM ffi_param_kind, wbs.
          PUT wk2 INTO res.
        /IF.
      /IF.
    /IF.
    IF wty IS "if_stmt",
      REAP ib FROM _if_bodies, wnd.
      CREATE ii6(NUM) TO 0.
      SEASON ii6 < COUNT ib,
        REAP ibd6 FROM plant_list_get, ib, ii6.
        REAP wret2 FROM collect_stvars_walk, ibd6, subst, res.
        SET ii6 TO ii6 + 1.
      /SEASON.
    /IF.
    IF wty IS "season_stmt" OR wty IS "cycle_stmt",
      REAP wbd2 FROM _map_get, wnd, "body".
      REAP wret2 FROM collect_stvars_walk, wbd2, subst, res.
    /IF.
    IF wty IS "match_stmt",
      CREATE mcl5(LIST) TO _map_get(wnd, "clauses").
      CREATE mci5(NUM) TO 0.
      SEASON mci5 < COUNT mcl5,
        REAP mcl6 FROM plant_list_get, mcl5, mci5.
        REAP mcb3 FROM _map_get, mcl6, "bodyStatements".
        REAP wret2 FROM collect_stvars_walk, mcb3, subst, res.
        SET mci5 TO mci5 + 1.
      /SEASON.
    /IF.
    IF wty IS "weather_stmt",
      REAP wbl7 FROM _weather_bodies, wnd.
      CREATE wbi7(NUM) TO 0.
      SEASON wbi7 < COUNT wbl7,
        REAP wbel7 FROM plant_list_get, wbl7, wbi7.
        REAP wret2 FROM collect_stvars_walk, wbel7, subst, res.
        SET wbi7 TO wbi7 + 1.
      /SEASON.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE res.
/ACTION.

# collect_stvars — struct-typed var names in scope for an action:
# struct params + struct CREATE/LET targets (mirrors collect_nums).
# Flat [name, kind, …] pairs; kind = ffi_param_kind of the type.
ACTION collect_stvars(bd(LIST), params(LIST), subst(LIST)),
  CREATE res(LIST) TO plant_list_make(0).
  CREATE pi(NUM) TO 0.
  CREATE pnd(LIST) TO plant_list_make(0).
  CREATE pn2(TX) TO "".
  CREATE pty2(TX) TO "".
  CREATE psu2(TX) TO "".
  SEASON pi < COUNT params,
    REAP pnd FROM plant_list_get, params, pi.
    REAP pn2 FROM _map_get, pnd, "name".
    REAP pty2 FROM _map_get, pnd, "type".
    REAP psu2 FROM subst_type, pty2, subst.
    REAP pbs2 FROM is_struct_type, psu2.
    IF pbs2 IS "1",
      REAP pf FROM list_contains, res, pn2.
      IF pf IS 0,
        PUT pn2 INTO res.
        REAP pk2 FROM ffi_param_kind, psu2.
        PUT pk2 INTO res.
      /IF.
    /IF.
    SET pi TO pi + 1.
  /SEASON.
  REAP ret FROM collect_stvars_walk, bd, subst, res.
  GIVE res.
/ACTION.

# find_sig — look up the full sigs entry (name/params/ret/varargs)
# by declaration name; real empty LIST when missing
ACTION find_sig(sigs(LIST), name(TX)),
  CREATE fi(NUM) TO 0.
  CREATE fe(TX) TO "".
  CREATE fn(TX) TO "".
  CREATE found(LIST) TO plant_list_make(0).
  SEASON fi < COUNT sigs,
    REAP fe FROM plant_list_get, sigs, fi.
    REAP fn FROM _map_get, fe, "name".
    IF str_eq(fn, name) IS "1",
      SET found TO fe.
    /IF.
    SET fi TO fi + 1.
  /SEASON.
  GIVE found.
/ACTION.

# ffi_ctype — C type for an FFI param/return type
ACTION ffi_ctype(ptype(TX)),
  REAP k FROM ffi_param_kind, ptype.
  IF k IS "struct_val",
    REAP sn FROM ffi_struct_name, ptype.
    GIVE ffi_struct_cname(sn).
  /IF.
  IF k IS "struct_ref",
    REAP sn FROM ffi_struct_name, ptype.
    GIVE ffi_struct_cname(sn) + "*".
  /IF.
  IF k IS "voidptr", GIVE "void*". /IF.
  IF k IS "callback", GIVE "plant_cb_t". /IF.
  GIVE plant_ctype(ptype).
/ACTION.

# is_bare_id — expr is a single identifier [A-Za-z0-9_]+
ACTION is_bare_id(e(TX)),
  CREATE bi2(NUM) TO 0.
  CREATE bc(TX) TO "".
  SEASON bi2 < LEN(e),
    REAP bc FROM char_at, e, bi2.
    IF bc IS " " OR bc IS "(" OR bc IS ")" OR bc IS "+" OR bc IS "-" OR bc IS "\"" OR bc IS "[" OR bc IS "]" OR bc IS "@" OR bc IS "*" OR bc IS "&" OR bc IS "=" OR bc IS "!",
      GIVE "0".
    /IF.
    SET bi2 TO bi2 + 1.
  /SEASON.
  GIVE "1".
/ACTION.

# expr_is_stringlike — a translated expression yields a TX string:
# starts with a string literal, is a _cat call, or a _from_long call
# (quote checks use substring comparisons — call-arg string literals
#  cannot contain quote characters in the v1 bootstrap)
ACTION expr_is_stringlike(e(TX)),
  REAP q0 FROM substring, e, 0, 1.
  IF q0 IS "\"", GIVE "1". /IF.
  REAP c1 FROM find_any, e, "_cat(".
  IF c1 ISNT -1, GIVE "1". /IF.
  REAP s1 FROM substring, e, 0, 11.
  IF s1 IS "_from_long(", GIVE "1". /IF.
  GIVE "0".
/ACTION.

# stvar_kind — flat [name, kind, …] lookup: struct-var kind
# ("struct_val"/"struct_ref") for a name, or "" when not a stvar
ACTION stvar_kind(stvars(LIST), name(TX)),
  CREATE si(NUM) TO 0.
  SEASON si + 1 < COUNT stvars,
    REAP sv1 FROM plant_list_get, stvars, si.
    IF str_eq(sv1, name) IS "1",
      REAP sk1 FROM plant_list_get, stvars, si + 1.
      GIVE sk1.
    /IF.
    SET si TO si + 2.
  /SEASON.
  GIVE "".
/ACTION.

# collect_cb_uses — action names passed as CALLBACK args anywhere
# in a body (recurses IF/SEASON/CYCLE/MATCH)
ACTION collect_cb_uses(bd(LIST), sigs(LIST), acc(LIST)),
  CREATE wi(NUM) TO 0.
  CREATE nd(TX) TO "".
  CREATE ty(TX) TO "".
  SEASON wi < COUNT bd,
    REAP nd FROM plant_list_get, bd, wi.
    REAP ty FROM _map_get, nd, "type".
    IF ty IS "reap_stmt" OR ty IS "start_stmt" OR ty IS "await_stmt",
      REAP caact FROM _map_get, nd, "action".
      IF caact > "",
        REAP caact FROM strings:REPLACE, caact, ":", "_".
        REAP cafp FROM find_params, sigs, caact.
        CREATE caargs(LIST) TO _map_get(nd, "args").
        CREATE kai(NUM) TO 0.
        SEASON kai < COUNT caargs,
          IF kai < COUNT cafp,
            REAP kap FROM plant_list_get, cafp, kai.
            REAP kpty FROM _map_get, kap, "type".
            REAP kk FROM ffi_param_kind, kpty.
            IF kk IS "callback",
              REAP karg FROM plant_list_get, caargs, kai.
              REAP kb FROM is_bare_id, karg.
              IF kb IS "1",
                REAP kfound FROM callee_add, acc, karg.
                SET acc TO kfound.
              /IF.
            /IF.
          /IF.
          SET kai TO kai + 1.
        /SEASON.
      /IF.
    /IF.
    IF ty IS "if_stmt",
      REAP ib FROM _if_bodies, nd.
      CREATE ii7(NUM) TO 0.
      SEASON ii7 < COUNT ib,
        REAP ibd7 FROM plant_list_get, ib, ii7.
        REAP acc FROM collect_cb_uses, ibd7, sigs, acc.
        SET ii7 TO ii7 + 1.
      /SEASON.
    /IF.
    IF ty IS "season_stmt" OR ty IS "cycle_stmt",
      REAP sb FROM _map_get, nd, "body".
      REAP acc FROM collect_cb_uses, sb, sigs, acc.
    /IF.
    IF ty IS "match_stmt",
      CREATE cl9(LIST) TO _map_get(nd, "clauses").
      CREATE ci9(NUM) TO 0.
      SEASON ci9 < COUNT cl9,
        REAP cl2 FROM plant_list_get, cl9, ci9.
        REAP cb9 FROM _map_get, cl2, "bodyStatements".
        REAP acc FROM collect_cb_uses, cb9, sigs, acc.
        SET ci9 TO ci9 + 1.
      /SEASON.
    /IF.
    IF ty IS "weather_stmt",
      REAP wbl8 FROM _weather_bodies, nd.
      CREATE wbi8(NUM) TO 0.
      SEASON wbi8 < COUNT wbl8,
        REAP wbel8 FROM plant_list_get, wbl8, wbi8.
        REAP acc FROM collect_cb_uses, wbel8, sigs, acc.
        SET wbi8 TO wbi8 + 1.
      /SEASON.
    /IF.
    SET wi TO wi + 1.
  /SEASON.
  GIVE acc.
/ACTION.

# ffi_ret_ctype — FFI return type text → C type
ACTION ffi_ret_ctype(ret(TX)),
  REAP rk FROM ffi_param_kind, ret.
  IF rk IS "struct_val",
    REAP sn FROM ffi_struct_name, ret.
    GIVE ffi_struct_cname(sn).
  /IF.
  IF rk IS "voidptr", GIVE "void*". /IF.
  GIVE "tx_t".
/ACTION.

# struct_fields_at — subst'd field pairs [name, type, …] of a
# struct template for a type instantiation (args may be empty)
ACTION struct_fields_at(tpl(LIST), args(LIST)),
  CREATE flds(LIST) TO plant_list_make(0).
  CREATE sgens(LIST) TO _map_get(tpl, "generics").
  CREATE sfields(LIST) TO _map_get(tpl, "fields").
  CREATE fsub(LIST) TO build_subst(sgens, args).
  CREATE fi9(NUM) TO 0.
  CREATE fel9(TX) TO "".
  SEASON fi9 < COUNT sfields,
    REAP fel9 FROM plant_list_get, sfields, fi9.
    REAP fn9 FROM _map_get, fel9, "name".
    REAP ft9 FROM _map_get, fel9, "type".
    REAP fs9 FROM subst_type, ft9, fsub.
    PUT fn9 INTO flds.
    PUT fs9 INTO flds.
    SET fi9 TO fi9 + 1.
  /SEASON.
  GIVE flds.
/ACTION.

# ffi_emit_struct_helpers — map↔C-struct conversion helpers for
# one struct type (fields as [name, type, …] pairs, depth ≤ 3)
ACTION ffi_emit_struct_helpers(cname(TX), flds(LIST)),
  CREATE h1(TX) TO "".
  CREATE h2(TX) TO "".
  CREATE h3(TX) TO "".
  CREATE h4(TX) TO "".
  CREATE hall(TX) TO "".
  SET h1 TO "static " + cname + " plant_map_to_" + cname + "_d(tx_t m, long depth) \{\n".
  SET h1 TO h1 + "  " + cname + " r;\n  memset(&r, 0, sizeof(r));\n".
  SET h1 TO h1 + "  if (depth > 3) { plant_ffi_errno = FFI_ERR_DEPTH; plant_ffi_debug_print(\"map_to_" + cname + ": depth limit\"); return r; }\n".
  SET h1 TO h1 + "  if (!m) { plant_ffi_errno = FFI_ERR_TYPE; return r; }\n".
  CREATE fi8(NUM) TO 0.
  CREATE fn8(TX) TO "".
  CREATE ft8(TX) TO "".
  SEASON fi8 + 1 < COUNT flds,
    REAP fn8 FROM plant_list_get, flds, fi8.
    REAP ft8 FROM plant_list_get, flds, fi8 + 1.
    REAP fb8 FROM type_base, ft8.
    IF fb8 IS "NUM",
      SET h1 TO h1 + "  r." + fn8 + " = (long)(intptr_t)plant_map_get(m, \"" + fn8 + "\");\n".
    /IF.
    IF fb8 IS "FACT",
      SET h1 TO h1 + "  r." + fn8 + " = (int)(intptr_t)plant_map_get(m, \"" + fn8 + "\");\n".
    /IF.
    IF fb8 IS "TX",
      SET h1 TO h1 + "  r." + fn8 + " = plant_map_get(m, \"" + fn8 + "\");\n".
    /IF.
    REAP fs8 FROM is_struct_type, ft8.
    IF fs8 IS "1",
      REAP es8 FROM substring, ft8, 0, 7.
      IF es8 IS "STRUCT ",
        REAP fcn8 FROM ffi_struct_cname, ft8.
        SET h1 TO h1 + "  r." + fn8 + " = plant_map_to_" + fcn8 + "_d(plant_map_get(m, \"" + fn8 + "\"), depth + 1);\n".
      /IF.
      IF es8 ISNT "STRUCT ",
        SET h1 TO h1 + "  r." + fn8 + " = plant_map_get(m, \"" + fn8 + "\");\n".
      /IF.
    /IF.
    IF fb8 IS "LIST",
      SET h1 TO h1 + "  plant_ffi_errno = FFI_ERR_TYPE;\n  return r;\n".
    /IF.
    SET fi8 TO fi8 + 2.
  /SEASON.
  SET h1 TO h1 + "  return r;\n\}\n".
  SET h2 TO "static " + cname + " plant_map_to_" + cname + "(tx_t m) { return plant_map_to_" + cname + "_d(m, 1); }\n".
  SET h3 TO "static void* plant_struct_alloc_copy_" + cname + "(" + cname + " v) { " + cname + "* r = (" + cname + "*)plant_alloc(sizeof(" + cname + ")); *r = v; return (void*)r; }\n".
  SET h3 TO h3 + "static " + cname + "* plant_map_to_ref_" + cname + "(tx_t m) { return (" + cname + "*)plant_struct_alloc_copy_" + cname + "(plant_map_to_" + cname + "(m)); }\n".
  SET h4 TO "static tx_t plant_" + cname + "_to_map(" + cname + " v) \{\n".
  SET h4 TO h4 + "  tx_t r = (tx_t)plant_map_hash_create(8);\n".
  CREATE fi7(NUM) TO 0.
  CREATE fn7(TX) TO "".
  CREATE ft7(TX) TO "".
  SEASON fi7 + 1 < COUNT flds,
    REAP fn7 FROM plant_list_get, flds, fi7.
    REAP ft7 FROM plant_list_get, flds, fi7 + 1.
    REAP fb7 FROM type_base, ft7.
    IF fb7 IS "NUM",
      SET h4 TO h4 + "  plant_map_hash_set(r, \"" + fn7 + "\", (void*)(intptr_t)v." + fn7 + ");\n".
    /IF.
    IF fb7 IS "FACT",
      SET h4 TO h4 + "  plant_map_hash_set(r, \"" + fn7 + "\", (void*)(intptr_t)v." + fn7 + ");\n".
    /IF.
    IF fb7 IS "TX",
      SET h4 TO h4 + "  plant_map_hash_set(r, \"" + fn7 + "\", v." + fn7 + ");\n".
    /IF.
    REAP fs7 FROM is_struct_type, ft7.
    IF fs7 IS "1",
      REAP es7 FROM substring, ft7, 0, 7.
      IF es7 IS "STRUCT ",
        REAP fcn7 FROM ffi_struct_cname, ft7.
        SET h4 TO h4 + "  plant_map_hash_set(r, \"" + fn7 + "\", plant_" + fcn7 + "_to_map(v." + fn7 + "));\n".
      /IF.
      IF es7 ISNT "STRUCT ",
        SET h4 TO h4 + "  plant_map_hash_set(r, \"" + fn7 + "\", v." + fn7 + ");\n".
      /IF.
    /IF.
    IF fb7 IS "LIST",
      SET h4 TO h4 + "  plant_ffi_errno = FFI_ERR_TYPE;\n  return r;\n".
    /IF.
    SET fi7 TO fi7 + 2.
  /SEASON.
  SET h4 TO h4 + "  return r;\n\}\n".
  SET hall TO h1 + h2 + "".
  SET hall TO hall + h3 + "".
  SET hall TO hall + h4 + "".
  GIVE hall.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  trim — strip leading/trailing spaces
# ──────────────────────────────────────────────────────────────
ACTION trim(s(TX)),
    CREATE st(NUM) TO 0.
    CREATE en(NUM) TO LEN(s).
    SEASON st < en,
        REAP c FROM char_at, s, st.
        IF c ISNT " ", BREAK 0. /IF.
        SET st TO st + 1.
    /SEASON.
    SEASON en > st,
        REAP c FROM char_at, s, en - 1.
        IF c ISNT " ", BREAK 0. /IF.
        SET en TO en - 1.
    /SEASON.
    IF en <= st, GIVE "". /IF.
    GIVE substring(s, st, en).
/ACTION.

# ──────────────────────────────────────────────────────────────
#  Generics Engine — monomorphization helpers
#
#  subst is a flat key/value list [T, NUM, U, TX, …] mapping
#  generic type parameters to concrete types.
# ──────────────────────────────────────────────────────────────
ACTION subst_append(acc(TX), w(TX), subst(LIST)),
    CREATE fi(NUM) TO 0.
    CREATE fk(TX) TO "".
    CREATE fv(TX) TO "".
    SEASON fi + 1 < COUNT subst,
        REAP fk FROM plant_list_get, subst, fi.
        REAP fv FROM plant_list_get, subst, fi + 1.
        IF str_eq(fk, w) IS "1",
            GIVE acc + fv.
        /IF.
        SET fi TO fi + 2.
    /SEASON.
    GIVE acc + w.
/ACTION.

# subst_type — replace whole-token generic names inside a type
# string; separators are space ( ) [ ] ,
# Fast-path: with an empty substitution map nothing can change,
# so the type is returned as-is without scanning (v0.48.11).
ACTION subst_type(t(TX), subst(LIST)),
    IF COUNT subst IS 0, GIVE t. /IF.
    CREATE res(TX) TO "".
    CREATE w(TX) TO "".
    CREATE si(NUM) TO 0.
    CREATE ch(TX) TO "".
    SEASON si < LEN(t),
        REAP ch FROM char_at, t, si.
        IF ch IS " " OR ch IS "[" OR ch IS "]" OR ch IS "(" OR ch IS ")" OR ch IS ",",
            REAP res FROM subst_append, res, w, subst.
            SET w TO "".
            SET res TO res + ch.
        /IF.
        IF ch ISNT " " AND ch ISNT "[" AND ch ISNT "]" AND ch ISNT "(" AND ch ISNT ")" AND ch ISNT ",",
            SET w TO w + ch.
        /IF.
        SET si TO si + 1.
    /SEASON.
    REAP res FROM subst_append, res, w, subst.
    GIVE res.
/ACTION.

# subst_reap_act — substitute generic names inside the […] of an
# action name: foo[T] under T→NUM → foo[NUM]
ACTION subst_reap_act(act(TX), subst(LIST)),
    REAP bi FROM find_any, act, "[".
    IF bi IS -1, GIVE act. /IF.
    REAP head FROM substring, act, 0, bi.
    REAP tail FROM substring, act, bi, LEN(act).
    REAP stail FROM subst_type, tail, subst.
    GIVE head + stail.
/ACTION.

# base_of — action name without type args: foo[NUM] → foo
ACTION base_of(act(TX)),
    REAP bi FROM find_any, act, "[".
    IF bi IS -1, GIVE act. /IF.
    GIVE substring(act, 0, bi).
/ACTION.

# ffi_topo_order — reorder a list of {scn, flds} maps so that every
# struct comes after all structs referenced by its fields (deps not
# present in the entries are ignored). Returns the reordered list.
ACTION ffi_topo_order(entries(LIST)),
  CREATE tdone(LIST) TO plant_list_make(0).
  CREATE tprog(NUM) TO 1.
  CREATE ti(NUM) TO 0.
  CREATE te9(LIST) TO plant_list_make(0).
  CREATE tscn(TX) TO "".
  CREATE tflds2(LIST) TO plant_list_make(0).
  CREATE td1(TX) TO "0".
  CREATE td2(TX) TO "0".
  CREATE td3(TX) TO "0".
  CREATE tj(NUM) TO 0.
  CREATE tok(NUM) TO 1.
  CREATE ft9(TX) TO "".
  CREATE fs9(TX) TO "".
  CREATE fc9(TX) TO "".
  CREATE res(LIST) TO plant_list_make(0).
  CREATE entries_scns(LIST) TO plant_list_make(0).
  SET ti TO 0.
  SEASON ti < COUNT entries,
    REAP te9 FROM plant_list_get, entries, ti.
    REAP tscn FROM _map_get, te9, "scn".
    PUT tscn INTO entries_scns.
    SET ti TO ti + 1.
  /SEASON.
  SEASON tprog IS 1,
    SET tprog TO 0.
    SET ti TO 0.
    SEASON ti < COUNT entries,
      REAP te9 FROM plant_list_get, entries, ti.
      REAP tscn FROM _map_get, te9, "scn".
      REAP td1 FROM key_in_acc, tscn, tdone.
      IF td1 IS "1",
        SET ti TO ti + 1.
        CONTINUE.
      /IF.
      CREATE tflds2(LIST) TO _map_get(te9, "flds").
      SET tok TO 1.
      SET tj TO 0.
      SEASON tj < COUNT tflds2,
        REAP ft9 FROM plant_list_get, tflds2, tj.
        REAP fs9 FROM is_struct_type, ft9.
        IF fs9 IS "1",
          REAP fc9 FROM ffi_struct_cname, ft9.
          REAP td2 FROM key_in_acc, fc9, entries_scns.
          IF td2 IS "1",
            REAP td3 FROM key_in_acc, fc9, tdone.
            IF td3 IS "0",
              SET tok TO 0.
            /IF.
          /IF.
        /IF.
        SET tj TO tj + 1.
      /SEASON.
      IF tok IS 1,
        PUT te9 INTO res.
        PUT tscn INTO tdone.
        SET tprog TO 1.
      /IF.
      SET ti TO ti + 1.
    /SEASON.
  /SEASON.
  GIVE res.
/ACTION.

# ffi_topo_emit_helpers — emit FFI struct conversion helpers
# (ffi_fwd + ffi_def text) in dependency order so that structs
# referenced as fields are emitted before their parents.
ACTION ffi_topo_emit_helpers(entries(LIST)),
  REAP ord FROM ffi_topo_order, entries.
  CREATE tfw(TX) TO "".
  CREATE tdf(TX) TO "".
  CREATE tscn(TX) TO "".
  CREATE tflds2(LIST) TO plant_list_make(0).
  CREATE ffd1(TX) TO "".
  CREATE ti(NUM) TO 0.
  CREATE te9(LIST) TO plant_list_make(0).
  SEASON ti < COUNT ord,
    REAP te9 FROM plant_list_get, ord, ti.
    REAP tscn FROM _map_get, te9, "scn".
    SET tfw TO tfw + "static " + tscn + " plant_map_to_" + tscn + "_d(tx_t m, long depth);\nstatic " + tscn + " plant_map_to_" + tscn + "(tx_t m);\nstatic void* plant_struct_alloc_copy_" + tscn + "(" + tscn + " v);\nstatic " + tscn + "* plant_map_to_ref_" + tscn + "(tx_t m);\nstatic tx_t plant_" + tscn + "_to_map(" + tscn + " v);\n".
    CREATE tflds2(LIST) TO _map_get(te9, "flds").
    REAP ffd1 FROM ffi_emit_struct_helpers, tscn, tflds2.
    SET tdf TO tdf + ffd1 + "\n".
    SET ti TO ti + 1.
  /SEASON.
  GIVE tfw + tdf.
/ACTION.

# parse_type_args — extract the type-arg list from foo[NUM, TX]
ACTION parse_type_args(act(TX)),
    REAP bi FROM find_any, act, "[".
    REAP ei FROM find_any, act, "]".
    IF bi IS -1 OR ei IS -1, GIVE plant_list_make(0). /IF.
    IF ei <= bi + 1, GIVE plant_list_make(0). /IF.
    REAP inner FROM substring, act, bi + 1, ei.
    REAP parts FROM strings:SPLIT, inner, ",".
    CREATE out(LIST) TO plant_list_make(0).
    CREATE oi(NUM) TO 0.
    CREATE pe(TX) TO "".
    CREATE pt(TX) TO "".
    SEASON oi < COUNT parts,
        REAP pe FROM plant_list_get, parts, oi.
        REAP pt FROM trim, pe.
        IF pt > "",
            PUT pt INTO out.
        /IF.
        SET oi TO oi + 1.
    /SEASON.
    GIVE out.
/ACTION.

# mangle — unique C identifier: plant_<name>_<T1>_<T2>
ACTION mangle(base(TX), args(LIST)),
    CREATE res(TX) TO "plant_" + base.
    CREATE mi(NUM) TO 0.
    CREATE ae(TX) TO "".
    SEASON mi < COUNT args,
        REAP ae FROM plant_list_get, args, mi.
        SET res TO res + "_" + ae.
        SET mi TO mi + 1.
    /SEASON.
    GIVE res.
/ACTION.

# find_template — locate a generic action template by base name
# (returns a real empty LIST when missing, so COUNT on the result
# is safe — never the "" sentinel, which would be read as a list)
ACTION find_template(templates(LIST), base(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE found(LIST) TO plant_list_make(0).
    SEASON fi < COUNT templates,
        REAP fe FROM plant_list_get, templates, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, base) IS "1",
            SET found TO fe.
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE found.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  STRUCT generics — struct template table + instantiation scan
#
#  structs is a list of [name, generics, fields] maps. Struct
#  types map to tx_t in generated C (opaque handles); the
#  typedefs plant_<Name>[_<T1>_<T2>] are emitted so C FFI code
#  (mocks, libraries) can cast and read the concrete layout.
# ──────────────────────────────────────────────────────────────

# find_struct — locate a STRUCT template by base name
# (real empty LIST when missing — never the "" sentinel, so
# COUNT on the result is safe)
ACTION find_struct(structs(LIST), name(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE found(LIST) TO plant_list_make(0).
    SEASON fi < COUNT structs,
        REAP fe FROM plant_list_get, structs, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, name) IS "1",
            SET found TO fe.
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE found.
/ACTION.

# scan_type — collect every concrete struct instantiation named
# inside a type string (substituted first), recursing into the
# template's fields and into nested bracket args
# (LIST[Box[NUM]], Pair[NUM, Box[U]], Node[T] …).
ACTION scan_type(t(TX), subst(LIST), structs(LIST), acc(LIST)),
    CREATE st(TX) TO "".
    CREATE bi(NUM) TO -1.
    CREATE ai2b(NUM) TO -1.
    REAP st FROM subst_type, t, subst.
    REAP bi FROM find_any, st, "[".
    IF bi ISNT -1,
            REAP base FROM base_of, st.
        REAP btrim FROM trim, base.
        REAP rf FROM substring, btrim, 0, 4.
        IF rf IS "REF ",
            REAP btrim FROM substring, btrim, 4, LEN(btrim).
        /IF.
        REAP tpl FROM find_struct, structs, btrim.
        IF COUNT tpl > 0,
            REAP args FROM parse_type_args, st.
            REAP found FROM key_in_acc, st, acc.
            IF found IS "0",
                PUT st INTO acc.
                REAP generics FROM _map_get, tpl, "generics".
                REAP nsubst FROM build_subst, generics, args.
                REAP fields FROM _map_get, tpl, "fields".
                CREATE fi2(NUM) TO 0.
                CREATE fv(TX) TO "".
                SEASON fi2 < COUNT fields,
                    REAP fv FROM _map_get, fields[fi2], "type".
                    REAP acc FROM scan_type, fv, nsubst, structs, acc.
                    SET fi2 TO fi2 + 1.
                /SEASON.
            /IF.
        /IF.
        REAP args FROM parse_type_args, st.
        CREATE ai2(NUM) TO 0.
        CREATE av(TX) TO "".
        SEASON ai2 < COUNT args,
            REAP av FROM plant_list_get, args, ai2.
            REAP ai2b FROM find_any, av, "[".
            IF ai2b ISNT -1,
                REAP acc FROM scan_type, av, subst, structs, acc.
            /IF.
            SET ai2 TO ai2 + 1.
        /SEASON.
    /IF.
    GIVE acc.
/ACTION.

# scan_params — scan every param type of a decl
ACTION scan_params(params(LIST), subst(LIST), structs(LIST), acc(LIST)),
    CREATE pi(NUM) TO 0.
    CREATE pv(TX) TO "".
    SEASON pi < COUNT params,
        REAP pv FROM _map_get, params[pi], "type".
        REAP acc FROM scan_type, pv, subst, structs, acc.
        SET pi TO pi + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# scan_fields — scan every field type of a struct template
ACTION scan_fields(fields(LIST), subst(LIST), structs(LIST), acc(LIST)),
    CREATE fi(NUM) TO 0.
    CREATE fv(TX) TO "".
    SEASON fi < COUNT fields,
        REAP fv FROM _map_get, fields[fi], "type".
        REAP acc FROM scan_type, fv, subst, structs, acc.
        SET fi TO fi + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# collect_struct_insts — walk a body for struct-typed declarations
ACTION collect_struct_insts(bd(LIST), subst(LIST), structs(LIST), acc(LIST)),
    CREATE ci(NUM) TO 0.
    CREATE nd(TX) TO "".
    CREATE ty(TX) TO "".
    CREATE vt(TX) TO "".
    CREATE sub_bd(LIST) TO plant_list_make(0).
    SEASON ci < COUNT bd,
        REAP nd FROM plant_list_get, bd, ci.
        REAP ty FROM _map_get, nd, "type".
        IF ty IS "create_stmt" OR ty IS "let_stmt",
            REAP vt FROM _map_get, nd, "var_type".
            IF vt > "",
                REAP acc FROM scan_type, vt, subst, structs, acc.
            /IF.
        /IF.
        IF ty IS "if_stmt",
            REAP ib FROM _if_bodies, nd.
            CREATE ii8(NUM) TO 0.
            SEASON ii8 < COUNT ib,
                REAP ibd8 FROM plant_list_get, ib, ii8.
                REAP acc FROM collect_struct_insts, ibd8, subst, structs, acc.
                SET ii8 TO ii8 + 1.
            /SEASON.
        /IF.
        IF ty IS "season_stmt",
            REAP sub_bd FROM _map_get, nd, "body".
            REAP acc FROM collect_struct_insts, sub_bd, subst, structs, acc.
        /IF.
        IF ty IS "match_stmt",
            CREATE mcl9(LIST) TO _map_get(nd, "clauses").
            CREATE mci9(NUM) TO 0.
            SEASON mci9 < COUNT mcl9,
                REAP mcl10 FROM plant_list_get, mcl9, mci9.
                REAP mcb5 FROM _map_get, mcl10, "bodyStatements".
                REAP acc FROM collect_struct_insts, mcb5, subst, structs, acc.
                SET mci9 TO mci9 + 1.
            /SEASON.
        /IF.
        IF ty IS "weather_stmt",
            REAP wbl9 FROM _weather_bodies, nd.
            CREATE wbi9(NUM) TO 0.
            SEASON wbi9 < COUNT wbl9,
                REAP wbel9 FROM plant_list_get, wbl9, wbi9.
                REAP acc FROM collect_struct_insts, wbel9, subst, structs, acc.
                SET wbi9 TO wbi9 + 1.
            /SEASON.
        /IF.
        SET ci TO ci + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# struct_typedef — C typedef text for a struct template, optionally
# instantiated: typedef struct { … } plant_<Name>[_<T1>_<T2>];
ACTION struct_typedef(tpl(LIST), args(LIST)),
    REAP sname FROM _map_get, tpl, "name".
    REAP generics FROM _map_get, tpl, "generics".
    REAP fields FROM _map_get, tpl, "fields".
    REAP subst FROM build_subst, generics, args.
    CREATE tname(TX) TO "plant_" + sname.
    CREATE mi(NUM) TO 0.
    CREATE ae(TX) TO "".
    SEASON mi < COUNT args,
        REAP ae FROM plant_list_get, args, mi.
        SET tname TO tname + "_" + ae.
        SET mi TO mi + 1.
    /SEASON.
    CREATE ccode(TX) TO "typedef struct \{\n".
    CREATE fi(NUM) TO 0.
    CREATE fel(LIST) TO plant_list_make(0).
    CREATE fname(TX) TO "".
    CREATE ftype(TX) TO "".
    CREATE fsub(TX) TO "".
    CREATE ctype(TX) TO "".
    SEASON fi < COUNT fields,
        REAP fel FROM plant_list_get, fields, fi.
        REAP fname FROM _map_get, fel, "name".
        REAP ftype FROM _map_get, fel, "type".
        REAP fsub FROM subst_type, ftype, subst.
        REAP sp8 FROM substring, fsub, 0, 7.
        IF sp8 IS "STRUCT ",
            REAP ctype FROM ffi_ctype, fsub.
        /IF.
        IF sp8 ISNT "STRUCT ",
            # Non-STRUCT fields: explicit REF STRUCT → pointer layout; a
            # plain/generic struct reference (Box[NUM]) is an opaque tx_t
            # handle at runtime, so the typedef keeps the handle and the
            # marshalling helpers pass it through (v0.48.5).
            REAP fk9 FROM ffi_param_kind, fsub.
            IF fk9 IS "struct_ref",
                REAP ctype FROM ffi_ctype, fsub.
            /IF.
            IF fk9 ISNT "struct_ref",
                REAP base9 FROM type_base, fsub.
                IF base9 IS "NUM" OR base9 IS "FACT" OR base9 IS "TX" OR base9 IS "LIST",
                    REAP ctype FROM plant_ctype, fsub.
                /IF.
                IF base9 ISNT "NUM" AND base9 ISNT "FACT" AND base9 ISNT "TX" AND base9 ISNT "LIST",
                    SET ctype TO "tx_t".
                /IF.
            /IF.
        /IF.
        SET ccode TO ccode + "  " + ctype + " " + fname + ";\n".
        SET fi TO fi + 1.
    /SEASON.
    SET ccode TO ccode + "\} " + tname + ";\n".
    GIVE ccode.
/ACTION.

# key_in_acc — is key already in the instantiation cache?
ACTION key_in_acc(key(TX), acc(LIST)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    SEASON fi < COUNT acc,
        REAP fe FROM plant_list_get, acc, fi.
        IF str_eq(fe, key) IS "1", GIVE "1". /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE "0".
/ACTION.

# build_subst — zip template generics with concrete type args
ACTION build_subst(generics(LIST), args(LIST)),
    CREATE subst(LIST) TO plant_list_make(0).
    CREATE zi(NUM) TO 0.
    CREATE gv(TX) TO "".
    CREATE av(TX) TO "".
    SEASON zi < COUNT generics,
        IF zi < COUNT args,
            REAP gv FROM plant_list_get, generics, zi.
            REAP av FROM plant_list_get, args, zi.
            PUT gv INTO subst.
            PUT av INTO subst.
        /IF.
        SET zi TO zi + 1.
    /SEASON.
    GIVE subst.
/ACTION.

# collect_insts — discover every concrete instantiation reachable
# from a body; walks into generic templates with the substituted
# type context. Functional accumulation (acc is returned).
ACTION collect_insts(bd(LIST), subst(LIST), templates(LIST), acc(LIST)),
    CREATE ci(NUM) TO 0.
    CREATE nd(TX) TO "".
    CREATE ty(TX) TO "".
    CREATE act(TX) TO "".
    CREATE gi(NUM) TO -1.
    SEASON ci < COUNT bd,
        REAP nd FROM plant_list_get, bd, ci.
        REAP ty FROM _map_get, nd, "type".
        IF ty IS "reap_stmt",
            REAP act FROM _map_get, nd, "action".
            REAP gi FROM find_any, act, "[".
            IF gi ISNT -1,
                REAP sact FROM subst_reap_act, act, subst.
                REAP base FROM base_of, sact.
                REAP tpl FROM find_template, templates, base.
                IF COUNT tpl > 0,
                    REAP found FROM key_in_acc, sact, acc.
                    IF found IS "0",
                        PUT sact INTO acc.
                        REAP args FROM parse_type_args, sact.
                        REAP generics FROM _map_get, tpl, "generics".
                        REAP nsubst FROM build_subst, generics, args.
                        REAP tbd FROM _map_get, tpl, "body".
                        REAP acc FROM collect_insts, tbd, nsubst, templates, acc.
                    /IF.
                /IF.
            /IF.
        /IF.
        IF ty IS "if_stmt",
            REAP ib FROM _if_bodies, nd.
            CREATE ii9(NUM) TO 0.
            SEASON ii9 < COUNT ib,
                REAP ibd9 FROM plant_list_get, ib, ii9.
                REAP acc FROM collect_insts, ibd9, subst, templates, acc.
                SET ii9 TO ii9 + 1.
            /SEASON.
        /IF.
        IF ty IS "season_stmt",
            REAP sub_bd FROM _map_get, nd, "body".
            REAP acc FROM collect_insts, sub_bd, subst, templates, acc.
        /IF.
        IF ty IS "match_stmt",
            CREATE mcl11(LIST) TO _map_get(nd, "clauses").
            CREATE mci11(NUM) TO 0.
            SEASON mci11 < COUNT mcl11,
                REAP mcl12 FROM plant_list_get, mcl11, mci11.
                REAP mcb6 FROM _map_get, mcl12, "bodyStatements".
                REAP acc FROM collect_insts, mcb6, subst, templates, acc.
                SET mci11 TO mci11 + 1.
            /SEASON.
        /IF.
        IF ty IS "weather_stmt",
            REAP wbl10 FROM _weather_bodies, nd.
            CREATE wbi10(NUM) TO 0.
            SEASON wbi10 < COUNT wbl10,
                REAP wbel10 FROM plant_list_get, wbl10, wbi10.
                REAP acc FROM collect_insts, wbel10, subst, templates, acc.
                SET wbi10 TO wbi10 + 1.
            /SEASON.
        /IF.
        SET ci TO ci + 1.
    /SEASON.
    GIVE acc.
/ACTION.

# inst_fwddecl — forward declaration for one instantiation
ACTION inst_fwddecl(inst(TX), templates(LIST)),
    REAP base FROM base_of, inst.
    REAP args FROM parse_type_args, inst.
    REAP tpl FROM find_template, templates, base.
    IF COUNT tpl IS 0, GIVE "". /IF.
    REAP generics FROM _map_get, tpl, "generics".
    REAP params FROM _map_get, tpl, "params".
    REAP subst FROM build_subst, generics, args.
    REAP mname FROM mangle, base, args.
    CREATE paramstr(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE param_el(TX) TO "".
    CREATE pname(TX) TO "".
    CREATE ptype(TX) TO "".
    CREATE psub(TX) TO "".
    CREATE ctype(TX) TO "".
    SEASON pi < COUNT params,
        REAP param_el FROM plant_list_get, params, pi.
        REAP pname FROM _map_get, param_el, "name".
        REAP ptype FROM _map_get, param_el, "type".
        REAP psub FROM subst_type, ptype, subst.
        REAP ctype FROM ffi_ctype, psub.
        IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
        SET paramstr TO paramstr + ctype + " " + pname.
        SET pi TO pi + 1.
    /SEASON.
    GIVE "tx_t " + mname + "(" + paramstr + ");\n".
/ACTION.

# emit_inst — full body emission for one instantiation
ACTION emit_inst(inst(TX), templates(LIST), sigs(LIST), reg(LIST)),
    REAP base FROM base_of, inst.
    REAP args FROM parse_type_args, inst.
    REAP tpl FROM find_template, templates, base.
    IF COUNT tpl IS 0, GIVE "". /IF.
    REAP generics FROM _map_get, tpl, "generics".
    REAP params FROM _map_get, tpl, "params".
    REAP bd FROM _map_get, tpl, "body".
    REAP subst FROM build_subst, generics, args.
    REAP mname FROM mangle, base, args.
    # v0.48.13: the template's declared -> Type after substitution
    # drives _from_long wrapping of numeric GIVEs ("" if implicit)
    CREATE rtpl(TX) TO _map_get(tpl, "ret").
    CREATE rty_m(TX) TO subst_type(rtpl, subst).
    CREATE paramstr(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE param_el(TX) TO "".
    CREATE pname(TX) TO "".
    CREATE ptype(TX) TO "".
    CREATE psub(TX) TO "".
    CREATE ctype(TX) TO "".
    SEASON pi < COUNT params,
        REAP param_el FROM plant_list_get, params, pi.
        REAP pname FROM _map_get, param_el, "name".
        REAP ptype FROM _map_get, param_el, "type".
        REAP psub FROM subst_type, ptype, subst.
        REAP ctype FROM ffi_ctype, psub.
        IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
        SET paramstr TO paramstr + ctype + " " + pname.
        SET pi TO pi + 1.
    /SEASON.
    CREATE ccode(TX) TO "tx_t " + mname + "(" + paramstr + ") \{\n".
    CREATE nums_m(LIST) TO collect_nums(bd, params, subst).
    CREATE stvars_m(LIST) TO collect_stvars(bd, params, subst).
    CREATE evars_m(LIST) TO collect_enums(bd, params, subst, reg, sigs).
    CREATE implicit(LIST) TO collect_implicit(bd, params).
    CREATE dcode(TX) TO "".
    CREATE di(NUM) TO 0.
    CREATE dv(TX) TO "".
    SEASON di < COUNT implicit,
        REAP dv FROM plant_list_get, implicit, di.
        SET dcode TO dcode + "  tx_t " + dv + " = \"\";\n".
        SET di TO di + 1.
    /SEASON.
    REAP bcode FROM generate_body, bd, env_make(1, sigs, subst, plant_list_make(0), "", nums_m, stvars_m, evars_m, rty_m, "", "").
    IF (COUNT bd) IS 0,
        SET bcode TO "  return " + mname + ";\n".
    /IF.
    IF (COUNT bd) > 0,
        CREATE bd_count(NUM) TO COUNT bd.
        CREATE last_idx(NUM) TO bd_count - 1.
        CREATE last_nd(TX) TO plant_list_get(bd, last_idx).
        CREATE last_ty(TX) TO _map_get(last_nd, "type").
        IF last_ty ISNT "give_stmt", SET bcode TO bcode + "  return " + mname + ";\n". /IF.
    /IF.
    SET ccode TO ccode + dcode + bcode + "\}\n".
    GIVE ccode.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  find_params — look up a decl's params by name in sigs
# ──────────────────────────────────────────────────────────────
ACTION find_params(sigs(LIST), name(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE fp(LIST) TO plant_list_make(0).
    SEASON fi < COUNT sigs,
        REAP fe FROM plant_list_get, sigs, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, name) IS "1",
            REAP fp FROM _map_get, fe, "params".
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE fp.
/ACTION.

# find_ret — return type of a sig entry (by action name), or ""
ACTION find_ret(sigs(LIST), name(TX)),
    CREATE fi(NUM) TO 0.
    CREATE fe(TX) TO "".
    CREATE fn(TX) TO "".
    CREATE fr(TX) TO "".
    SEASON fi < COUNT sigs,
        REAP fe FROM plant_list_get, sigs, fi.
        REAP fn FROM _map_get, fe, "name".
        IF str_eq(fn, name) IS "1",
            REAP fr FROM _map_get, fe, "ret".
        /IF.
        SET fi TO fi + 1.
    /SEASON.
    GIVE fr.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_ref_param — type string starts with "REF "
# ──────────────────────────────────────────────────────────────
ACTION is_ref_param(ptype(TX)),
    REAP pf FROM substring, ptype, 0, 4.
    IF pf IS "REF ", GIVE "1". /IF.
    GIVE "0".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  is_ref_at — params[idx] is a REF parameter
# ──────────────────────────────────────────────────────────────
ACTION is_ref_at(params(LIST), idx(NUM)),
    IF idx < COUNT params,
        REAP pel FROM plant_list_get, params, idx.
        REAP pty FROM _map_get, pel, "type".
        REAP rf FROM is_ref_param, pty.
        IF rf IS "1", GIVE "1". /IF.
    /IF.
    GIVE "0".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  _map_get — safe MAP field access (external FFI)
# ──────────────────────────────────────────────────────────────
ACTION _map_get(m, key(TX)) -> external.
ACTION plant_list_get(lst, idx(NUM)) -> external.
ACTION char_at(s(TX), idx(NUM)) -> external.
ACTION substring(s(TX), start(NUM), end(NUM)) -> external.
ACTION find_any(s(TX), delims(TX)) -> external.
ACTION handle_brackets(expr(TX)) -> external.
ACTION handle_strcmp(expr(TX)) -> external.
ACTION str_eq(a(TX), b(TX)) -> external.
ACTION _to_long(s(TX)) -> external.
ACTION _from_long(n(NUM)) -> external.

# ──────────────────────────────────────────────────────────────
#  find_node — AST action_decl node by name ("" if none)
# ──────────────────────────────────────────────────────────────
ACTION find_node(ast(LIST), name(TX)),
  CREATE fi(NUM) TO 0.
  CREATE fe(TX) TO "".
  CREATE fty(TX) TO "".
  CREATE fnm(TX) TO "".
  SEASON fi < COUNT ast,
    REAP fe FROM plant_list_get, ast, fi.
    REAP fty FROM _map_get, fe, "type".
    IF fty IS "action_decl",
      REAP fnm FROM _map_get, fe, "name".
      IF str_eq(fnm, name) IS "1", GIVE fe. /IF.
    /IF.
    SET fi TO fi + 1.
  /SEASON.
  GIVE "".
/ACTION.

# find_ext_node — locate an external_decl node by name (FFI
# signatures live on external_decl nodes, not action_decl)
ACTION find_ext_node(ast(LIST), name(TX)),
  CREATE fei(NUM) TO 0.
  CREATE fee(TX) TO "".
  CREATE fet(TX) TO "".
  CREATE fen(TX) TO "".
  SEASON fei < COUNT ast,
    REAP fee FROM plant_list_get, ast, fei.
    REAP fet FROM _map_get, fee, "type".
    IF fet IS "external_decl",
      REAP fen FROM _map_get, fee, "name".
      IF str_eq(fen, name) IS "1", GIVE fee. /IF.
    /IF.
    SET fei TO fei + 1.
  /SEASON.
  GIVE "".
/ACTION.

# ──────────────────────────────────────────────────────────────
#  callees_of — flat list of action names invoked by a body:
#  REAP/START/ASYNC IN/AWAIT action fields plus "START name"
#  expressions inside SET/CREATE/etc. values. Recurses into
#  IF/SEASON/CYCLE/MATCH bodies. Callers must skip names that
#  aren't declared (module calls, external fns).
# ──────────────────────────────────────────────────────────────
ACTION callee_add(acc(LIST), name(TX)),
  CREATE cfound(NUM) TO 0.
  CREATE ci(NUM) TO 0.
  CREATE ce(TX) TO "".
  SEASON ci < COUNT acc,
    REAP ce FROM plant_list_get, acc, ci.
    IF str_eq(ce, name) IS "1", SET cfound TO 1. /IF.
    SET ci TO ci + 1.
  /SEASON.
  IF NOT cfound, PUT name INTO acc. /IF.
  GIVE acc.
/ACTION.

ACTION callee_from_value(acc(LIST), val(TX)),
  REAP v0 FROM substring, val, 0, 6.
  IF v0 IS "START ",
    REAP ve FROM substring, val, 6, LEN(val).
    REAP vcm FROM find_any, ve, ",".
    IF vcm IS -1,
      REAP vn0 FROM trim, ve.
      REAP acc FROM callee_add, acc, vn0.
    /IF.
    IF vcm ISNT -1,
      REAP vn1 FROM substring, ve, 0, vcm.
      REAP vn1b FROM trim, vn1.
      REAP acc FROM callee_add, acc, vn1b.
    /IF.
  /IF.
  GIVE acc.
/ACTION.

ACTION callees_of(bd(LIST)),
  CREATE acc(LIST) TO plant_list_make(0).
  CREATE ci(NUM) TO 0.
  CREATE cnd(TX) TO "".
  CREATE cty(TX) TO "".
  CREATE cact(TX) TO "".
  CREATE cval(TX) TO "".
  SEASON ci < COUNT bd,
    REAP cnd FROM plant_list_get, bd, ci.
    REAP cty FROM _map_get, cnd, "type".
    IF cty IS "reap_stmt" OR cty IS "start_stmt" OR cty IS "await_stmt",
      REAP cact FROM _map_get, cnd, "action".
      IF cact > "",
        REAP cact FROM strings:REPLACE, cact, ":", "_".
        REAP acc FROM callee_add, acc, cact.
      /IF.
    /IF.
    IF cty IS "set_stmt" OR cty IS "create_stmt" OR cty IS "let_stmt" OR cty IS "give_stmt" OR cty IS "show_stmt" OR cty IS "put_stmt" OR cty IS "verify_stmt" OR cty IS "setup_stmt" OR cty IS "teardown_stmt" OR cty IS "cancel_stmt" OR cty IS "trace_stmt" OR cty IS "config_stmt",
      REAP cval FROM _map_get, cnd, "value".
      IF cval > "",
        REAP acc FROM callee_from_value, acc, cval.
      /IF.
    /IF.
    # v0.49.9 — reap_expr_stmt expressions can embed action calls
    # (e.g. REAP x FROM UPPER(helper(3)).): scan the expr text for
    # calls exactly like values above.
    IF cty IS "reap_expr_stmt",
      REAP cval FROM _map_get, cnd, "expr".
      IF cval > "",
        REAP acc FROM callee_from_value, acc, cval.
      /IF.
    /IF.
    IF cty IS "if_stmt",
      REAP ib FROM _if_bodies, cnd.
      CREATE ii10(NUM) TO 0.
      SEASON ii10 < COUNT ib,
        REAP ibd10 FROM plant_list_get, ib, ii10.
        REAP cret2 FROM callees_of, ibd10.
        CREATE cj0(NUM) TO 0.
        CREATE cje0(TX) TO "".
        SEASON cj0 < COUNT cret2,
          REAP cje0 FROM plant_list_get, cret2, cj0.
          REAP acc FROM callee_add, acc, cje0.
          SET cj0 TO cj0 + 1.
        /SEASON.
        SET ii10 TO ii10 + 1.
      /SEASON.
    /IF.
    IF cty IS "season_stmt" OR cty IS "cycle_stmt",
      REAP cbd2 FROM _map_get, cnd, "body".
      REAP cret2 FROM callees_of, cbd2.
      CREATE cj(NUM) TO 0.
      CREATE cje(TX) TO "".
      SEASON cj < COUNT cret2,
        REAP cje FROM plant_list_get, cret2, cj.
        REAP acc FROM callee_add, acc, cje.
        SET cj TO cj + 1.
      /SEASON.
    /IF.
    IF cty IS "match_stmt",
      CREATE mcl7(LIST) TO _map_get(cnd, "clauses").
      CREATE mci7(NUM) TO 0.
      SEASON mci7 < COUNT mcl7,
        REAP mcl8 FROM plant_list_get, mcl7, mci7.
        REAP mcb4 FROM _map_get, mcl8, "bodyStatements".
        REAP cret2 FROM callees_of, mcb4.
        CREATE cj2(NUM) TO 0.
        CREATE cje2(TX) TO "".
        SEASON cj2 < COUNT cret2,
          REAP cje2 FROM plant_list_get, cret2, cj2.
          REAP acc FROM callee_add, acc, cje2.
          SET cj2 TO cj2 + 1.
        /SEASON.
        SET mci7 TO mci7 + 1.
      /SEASON.
    /IF.
    IF cty IS "weather_stmt",
      REAP wbl11 FROM _weather_bodies, cnd.
      CREATE wbi11(NUM) TO 0.
      SEASON wbi11 < COUNT wbl11,
        REAP wbel11 FROM plant_list_get, wbl11, wbi11.
        REAP cret2 FROM callees_of, wbel11.
        CREATE cj2(NUM) TO 0.
        CREATE cje2(TX) TO "".
        SEASON cj2 < COUNT cret2,
          REAP cje2 FROM plant_list_get, cret2, cj2.
          REAP acc FROM callee_add, acc, cje2.
          SET cj2 TO cj2 + 1.
        /SEASON.
        SET wbi11 TO wbi11 + 1.
      /SEASON.
    /IF.
    SET ci TO ci + 1.
  /SEASON.
  GIVE acc.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  async_reachable — BFS from "main": 1 if any reachable action
#  (via REAP/START/AWAIT/ASYNC IN calls) is an ASYNC ACTION.
#  Drives conditional plant_async_drain() injection in ACTION main.
# ──────────────────────────────────────────────────────────────
ACTION async_reachable(ast(LIST)),
  CREATE queue(LIST) TO plant_list_make(0).
  CREATE seen(LIST) TO plant_list_make(0).
  CREATE found(NUM) TO 0.
  PUT "main" INTO queue.
  CREATE qi(NUM) TO 0.
  CREATE front(TX) TO "".
  SEASON qi < COUNT queue,
    REAP front FROM plant_list_get, queue, qi.
    REAP sfound FROM list_contains, seen, front.
    IF sfound IS 0,
      REAP fnd FROM find_node, ast, front.
      IF fnd > "",
        REAP fas FROM _map_get, fnd, "async".
        IF fas IS "1", SET found TO 1. /IF.
        REAP fbod FROM _map_get, fnd, "body".
        REAP callers2 FROM callees_of, fbod.
        CREATE ck(NUM) TO 0.
        CREATE cke(TX) TO "".
        SEASON ck < COUNT callers2,
          REAP cke FROM plant_list_get, callers2, ck.
          REAP kf FROM list_contains, seen, cke.
          IF kf IS 0, PUT cke INTO queue. /IF.
          SET ck TO ck + 1.
        /SEASON.
      /IF.
      PUT front INTO seen.
    /IF.
    SET qi TO qi + 1.
  /SEASON.
  GIVE found.
/ACTION.

# ──────────────────────────────────────────────────────────────
#  generate_c — main entry point
# ──────────────────────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
#  v0.48.35 — collect_roots: first-pass global ROOT registration
#
#  Runs in generate_c BEFORE any emission. Walks the entire module
#  (action bodies, every nested block, ROOT_SCOPE wrappers) in
#  declaration order and appends [name, cValue] pairs for every
#  root_stmt plus every root-flagged const_stmt (CONST elevated by
#  ROOT_SCOPE) to acc. generate_c splices them as file-scope
#  `static const char *` definitions right after the include header,
#  so ROOT constants are visible across all blocks regardless of
#  where (or in what order) they were declared — the hoisting pass.
#  The parser's own tables have already rejected redeclarations, so
#  the table here is duplicate-free.
# ═══════════════════════════════════════════════════════════════
ACTION collect_roots(bd(LIST), acc(LIST)),
  CREATE j2(NUM) TO 0.
  CREATE n2(TX) TO "".
  CREATE t2(TX) TO "".
  SEASON j2 < COUNT bd,
    REAP n2 FROM plant_list_get, bd, j2.
    REAP t2 FROM _map_get, n2, "type".
    IF t2 IS "root_stmt",
      REAP rnm FROM _map_get, n2, "name".
      REAP rvl FROM _map_get, n2, "value".
      PUT rnm INTO acc.
      PUT rvl INTO acc.
    /IF.
    IF t2 IS "const_stmt",
      REAP crf FROM _map_get, n2, "root".
      IF crf IS "1",
        REAP rnm FROM _map_get, n2, "name".
        REAP rvl FROM _map_get, n2, "value".
        PUT rnm INTO acc.
        PUT rvl INTO acc.
      /IF.
    /IF.
    IF t2 IS "if_stmt",
      REAP ifb FROM _if_bodies, n2.
      CREATE jj2(NUM) TO 0.
      SEASON jj2 < COUNT ifb,
        REAP ibd2 FROM plant_list_get, ifb, jj2.
        REAP acc FROM collect_roots, ibd2, acc.
        SET jj2 TO jj2 + 1.
      /SEASON.
    /IF.
    IF t2 IS "season_stmt" OR t2 IS "cycle_stmt" OR t2 IS "root_scope",
      REAP sbd2 FROM _map_get, n2, "body".
      REAP acc FROM collect_roots, sbd2, acc.
    /IF.
    IF t2 IS "match_stmt",
      CREATE mcl13(LIST) TO _map_get(n2, "clauses").
      CREATE mci13(NUM) TO 0.
      SEASON mci13 < COUNT mcl13,
        REAP mcl14 FROM plant_list_get, mcl13, mci13.
        REAP mcb7 FROM _map_get, mcl14, "bodyStatements".
        REAP acc FROM collect_roots, mcb7, acc.
        SET mci13 TO mci13 + 1.
      /SEASON.
    /IF.
    IF t2 IS "weather_stmt",
      REAP wf2 FROM _weather_bodies, n2.
      CREATE wj2(NUM) TO 0.
      SEASON wj2 < COUNT wf2,
        REAP wbd2 FROM plant_list_get, wf2, wj2.
        REAP acc FROM collect_roots, wbd2, acc.
        SET wj2 TO wj2 + 1.
      /SEASON.
    /IF.
    IF t2 IS "action_decl",
      REAP abd2 FROM _map_get, n2, "body".
      REAP acc FROM collect_roots, abd2, acc.
    /IF.
    SET j2 TO j2 + 1.
  /SEASON.
  GIVE acc.
/ACTION.

# _map_replace - rebuild a pairs-list map with one value replaced.
ACTION _map_replace(m(LIST), k(TX), v(TX)),
  CREATE out(LIST) TO plant_list_make(0).
  CREATE i(NUM) TO 0.
  SEASON i + 1 < COUNT m,
    REAP mk FROM plant_list_get, m, i.
    REAP mv FROM plant_list_get, m, i + 1.
    REAP samek FROM str_eq, mk, k.
    IF samek IS "1",
      PUT mk INTO out.
      PUT v INTO out.
    /IF.
    IF samek ISNT "1",
      PUT mk INTO out.
      PUT mv INTO out.
    /IF.
    SET i TO i + 2.
  /SEASON.
  GIVE out.
/ACTION.

# _ts_resolve - chase alias chains (bounded) through the tsub table.
# _ta_rw_list - v0.49.27: return a copy of lst where CREATE/LET
# var_type fields are resolved through the TYPE alias table; descends
# into ACTION bodies so declarations inside actions resolve too.
# _ta_collect_list - collect TYPE aliases from lst (recursing into
# ACTION bodies) into the tsub pairs-list.
ACTION _ta_collect_list(lst(LIST), tsub(LIST)),
  CREATE i(NUM) TO 0.
  SEASON i < COUNT lst,
    REAP tn FROM plant_list_get, lst, i.
    REAP tt FROM _map_get, tn, "type".
    IF tt IS "type_decl",
      REAP tal FROM _map_get, tn, "alias".
      REAP trg FROM _map_get, tn, "target".
      PUT tal INTO tsub.
      PUT trg INTO tsub.
    /IF.
    IF tt IS "action_decl",
      REAP obd FROM _map_get, tn, "body".
      REAP x FROM _ta_collect_list, obd, tsub.
    /IF.
    SET i TO i + 1.
  /SEASON.
  GIVE 0.
/ACTION.

ACTION _ta_rw_list(lst(LIST), tsub(LIST)),
  CREATE out2(LIST) TO plant_list_make(0).
  CREATE i(NUM) TO 0.
  SEASON i < COUNT lst,
    REAP tn FROM plant_list_get, lst, i.
    REAP tt FROM _map_get, tn, "type".
    IF tt IS "create_stmt" OR tt IS "let_stmt",
      REAP vt FROM _map_get, tn, "var_type".
      IF vt > "",
        REAP rv FROM _ts_resolve, tsub, vt.
        REAP chg FROM str_eq, rv, vt.
        IF chg ISNT "1",
          REAP nn FROM _map_replace, tn, "var_type", rv.
          SET tn TO nn.
        /IF.
      /IF.
    /IF.
    IF tt IS "action_decl",
      REAP obd FROM _map_get, tn, "body".
      REAP nbd FROM _ta_rw_list, obd, tsub.
      REAP an2 FROM _map_replace, tn, "body", nbd.
      SET tn TO an2.
    /IF.
    PUT tn INTO out2.
    SET i TO i + 1.
  /SEASON.
  GIVE out2.
/ACTION.

ACTION _ts_resolve(tsub(LIST), name(TX)),
  CREATE cur(TX) TO name.
  CREATE hops(NUM) TO 0.
  SEASON hops < 16,
    CREATE found(TX) TO "".
    CREATE i(NUM) TO 0.
    SEASON i + 1 < COUNT tsub,
      REAP an FROM plant_list_get, tsub, i.
      REAP at FROM plant_list_get, tsub, i + 1.
      REAP samean FROM str_eq, an, cur.
      IF samean IS "1",
        SET found TO at.
        BREAK 0.
      /IF.
      SET i TO i + 2.
    /SEASON.
    IF found IS "", BREAK 0. /IF.
    SET cur TO found.
    SET hops TO hops + 1.
  /SEASON.
  GIVE cur.
/ACTION.

# _map_replace - rebuild a pairs-list map with one value replaced.



ACTION generate_c(ast(LIST)),
    CREATE header(TX) TO "#include <plant_compat.h>\n\n".
    CREATE decl_code(TX) TO "".
    CREATE stmt_code(TX) TO "".
    CREATE has_decl(NUM) TO 0.
    CREATE has_stmt(NUM) TO 0.
    CREATE i(NUM) TO 0.
    CREATE node_el(TX) TO "".
    CREATE pro_code(TX) TO "".
    CREATE pi(NUM) TO 0.
    CREATE param_el(TX) TO "".
    CREATE pname(TX) TO "".
    CREATE ptype(TX) TO "".
    CREATE ctype(TX) TO "".
    CREATE aname(TX) TO "".
    CREATE paramstr(TX) TO "".
    # pass 0: signature table (sigs) for REF-param call-site rewriting +
    # generic action template table (templates) + struct template table (structs)
    CREATE sigs(LIST) TO plant_list_make(0).
    CREATE templates(LIST) TO plant_list_make(0).
    CREATE structs(LIST) TO plant_list_make(0).
    CREATE species(LIST) TO plant_list_make(0).
    CREATE sp_init_code(TX) TO "".
    CREATE safe_acts(LIST) TO plant_list_make(0).
    CREATE eregs(LIST) TO build_enum_registry(ast).
    # pass 0r: first-pass ROOT constant collection (v0.48.35). The
    # whole module is walked BEFORE any emission so every ROOT /
    # ROOT_SCOPE constant lands in the file-scope tier, visible
    # across all blocks regardless of declaration order.
    CREATE roots(LIST) TO collect_roots(ast, plant_list_make(0)).
    CREATE roots_code(TX) TO "".
    CREATE ri5(NUM) TO 0.
    CREATE rn5(TX) TO "".
    CREATE rv5(TX) TO "".
    SEASON ri5 + 1 < COUNT roots,
        REAP rn5 FROM plant_list_get, roots, ri5.
        REAP rv5 FROM plant_list_get, roots, ri5 + 1.
        REAP rp55 FROM substring, rv5, 0, 1.
        IF rp55 ISNT "\"",
            SET roots_code TO roots_code + "#error " + rn5 + " ROOT value must be a quoted string literal\n".
        /IF.
        IF rp55 IS "\"",
            SET roots_code TO roots_code + "static const char *" + rn5 + " = " + rv5 + ";\n".
        /IF.
        SET ri5 TO ri5 + 2.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl" OR ntype IS "external_decl",
            REAP aname FROM _map_get, node_el, "name".
            CREATE params2(LIST) TO _map_get(node_el, "params").
            CREATE rt2(TX) TO _map_get(node_el, "ret").
            CREATE vg2(TX) TO _map_get(node_el, "varargs").
            CREATE asy2(TX) TO _map_get(node_el, "async").
            CREATE mm2(TX) TO _map_get(node_el, "mission_mode").
            PUT plant_list_make(14, "name", aname, "type", ntype, "params", params2, "ret", rt2, "varargs", vg2, "async", asy2, "mission_mode", mm2) INTO sigs.
            IF ntype IS "action_decl" AND mm2 IS "SAFE",
                PUT aname INTO safe_acts.
            /IF.
        /IF.
        IF ntype IS "action_decl",
            REAP aname FROM _map_get, node_el, "name".
            CREATE gens2(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens2 > 0,
                CREATE pms2(LIST) TO _map_get(node_el, "params").
                CREATE bd2(LIST) TO _map_get(node_el, "body").
                CREATE rt2b(TX) TO _map_get(node_el, "ret").
                PUT plant_list_make(10, "name", aname, "generics", gens2, "params", pms2, "body", bd2, "ret", rt2b) INTO templates.
            /IF.
        /IF.
        IF ntype IS "struct_decl",
            REAP sname FROM _map_get, node_el, "name".
            CREATE sgens2(LIST) TO _map_get(node_el, "generics").
            CREATE sfields2(LIST) TO _map_get(node_el, "fields").
            PUT plant_list_make(6, "name", sname, "generics", sgens2, "fields", sfields2) INTO structs.
        /IF.
        IF ntype IS "species_decl",
            REAP sn7 FROM _map_get, node_el, "name".
            REAP sf7 FROM _map_get, node_el, "fields".
            REAP sp9 FROM _map_get, node_el, "parent".
            PUT plant_list_make(6, "name", sn7, "fields", sf7, "parent", sp9) INTO species.
            CREATE regl(TX) TO "_from_long(".
            SET regl TO regl + COUNT sf7.
            SET regl TO regl + ")".
            CREATE fj9(NUM) TO 0.
            SEASON fj9 < COUNT sf7,
              REAP fe9 FROM plant_list_get, sf7, fj9.
              REAP fn9 FROM _map_get, fe9, "name".
              SET regl TO regl + ", \"" + fn9 + "\"".
              SET fj9 TO fj9 + 1.
            /SEASON.
            SET regl TO regl + ")".
            SET regl TO "plant_list_make(" + substring(regl, 11, LEN(regl)).
            SET sp_init_code TO sp_init_code + "  plant_species_register(\"" + sn7 + "\", " + regl + ", \"" + sp9 + "\");\n".
            # v0.49.34: register implemented interfaces
            REAP imps FROM _map_get, node_el, "implements".
            CREATE ii9(NUM) TO 0.
            SEASON ii9 < COUNT imps,
              REAP iv9 FROM plant_list_get, imps, ii9.
              SET sp_init_code TO sp_init_code + "  plant_impl_iface(\"" + sn7 + "\", \"" + iv9 + "\");\n".
              SET ii9 TO ii9 + 1.
            /SEASON.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 0f: FFI-extension externals (ffi_exts: STRUCT/CALLBACK/
    # void*/varargs signatures) + actions passed as callback args
    # (cb_acts — they get plant_cbw_<name> wrappers)
    CREATE ffi_exts(LIST) TO plant_list_make(0).
    CREATE cb_acts(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "external_decl",
            CREATE fparams7(LIST) TO _map_get(node_el, "params").
            CREATE fret7(TX) TO _map_get(node_el, "ret").
            CREATE fvg7(TX) TO _map_get(node_el, "varargs").
            CREATE ffi_ok(NUM) TO 0.
            IF fret7 > "", SET ffi_ok TO 1. /IF.
            IF fvg7 IS "1", SET ffi_ok TO 1. /IF.
            CREATE fai(NUM) TO 0.
            SEASON fai < COUNT fparams7,
                REAP fpel FROM plant_list_get, fparams7, fai.
                REAP fpty FROM _map_get, fpel, "type".
                REAP fk7 FROM ffi_param_kind, fpty.
                IF fk7 ISNT "plain", SET ffi_ok TO 1. /IF.
                SET fai TO fai + 1.
            /SEASON.
            IF ffi_ok IS 1,
                REAP anm7 FROM _map_get, node_el, "name".
                PUT anm7 INTO ffi_exts.
            /IF.
        /IF.
        IF ntype IS "action_decl",
            CREATE gsf(LIST) TO _map_get(node_el, "generics").
            IF COUNT gsf IS 0,
                CREATE bdf(LIST) TO _map_get(node_el, "body").
                REAP cb2 FROM collect_cb_uses, bdf, sigs, cb_acts.
                SET cb_acts TO cb2.
            /IF.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP cb3 FROM collect_cb_uses, plant_list_make(1, node_el), sigs, cb_acts.
            SET cb_acts TO cb3.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 0b: discover every reachable generic instantiation
    # (generic template bodies are walked per-instantiation inside
    # collect_insts with the proper type substitution, never bare)
    CREATE insts(LIST) TO plant_list_make(0).
    CREATE esub(LIST) TO plant_list_make(0).
    # pass 0a2 - v0.49.27 TYPE aliases: collect + rewrite (recursive)
    CREATE tsub(LIST) TO plant_list_make(0).
    REAP tcx FROM _ta_collect_list, ast, tsub.
    REAP ast FROM _ta_rw_list, ast, tsub.

    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            CREATE gens5(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens5 IS 0,
                CREATE bd3(LIST) TO _map_get(node_el, "body").
                REAP insts FROM collect_insts, bd3, esub, templates, insts.
            /IF.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP insts FROM collect_insts, plant_list_make(1, node_el), esub, templates, insts.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 0c: discover every reachable struct instantiation from
    # type positions (params, struct fields, typed vars). Generic
    # struct templates are only scanned per-instantiation with the
    # substituted type context — never bare (avoids phantom T-typed
    # typedefs like plant_Box_T).
    CREATE structs_insts(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            CREATE gs5(LIST) TO _map_get(node_el, "generics").
            IF COUNT gs5 IS 0,
                CREATE ps5(LIST) TO _map_get(node_el, "params").
                CREATE bd5(LIST) TO _map_get(node_el, "body").
                REAP structs_insts FROM scan_params, ps5, esub, structs, structs_insts.
                REAP structs_insts FROM collect_struct_insts, bd5, esub, structs, structs_insts.
            /IF.
        /IF.
        IF ntype IS "external_decl",
            CREATE ps6(LIST) TO _map_get(node_el, "params").
            REAP structs_insts FROM scan_params, ps6, esub, structs, structs_insts.
        /IF.
        IF ntype IS "struct_decl",
            CREATE gs6(LIST) TO _map_get(node_el, "generics").
            IF COUNT gs6 IS 0,
                CREATE fs6(LIST) TO _map_get(node_el, "fields").
                REAP structs_insts FROM scan_fields, fs6, esub, structs, structs_insts.
            /IF.
        /IF.
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl",
            REAP structs_insts FROM collect_struct_insts, plant_list_make(1, node_el), esub, structs, structs_insts.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # per-instantiation struct scans: generic action templates with
    # the substituted type context of each discovered instantiation
    SET i TO 0.
    SEASON i < COUNT insts,
        REAP node_el FROM plant_list_get, insts, i.
        REAP ibase FROM base_of, node_el.
        REAP iargs FROM parse_type_args, node_el.
        REAP itpl FROM find_template, templates, ibase.
        IF COUNT itpl > 0,
            REAP igns FROM _map_get, itpl, "generics".
            REAP insub FROM build_subst, igns, iargs.
            REAP ipms FROM _map_get, itpl, "params".
            REAP ibd FROM _map_get, itpl, "body".
            REAP structs_insts FROM scan_params, ipms, insub, structs, structs_insts.
            REAP structs_insts FROM collect_struct_insts, ibd, insub, structs, structs_insts.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # struct typedefs: plain templates + every instantiation, emitted
    # right after the includes so C FFI code can use them. The block
    # is bracketed by markers so run_native_tests.sh can extract it
    # into a header for mock_ffi.c (-include).
    CREATE struct_code(TX) TO "/*__PLANT_TYPES_BEGIN__*/\n#ifndef PLANT_TYPES_INCLUDED\n#define PLANT_TYPES_INCLUDED\n".
    # enum typedefs live in the shared types block (extracted into
    # the mock-FFI header), so both the generated C and the mock can
    # reference enum member constants — e.g. mock struct constructors
    # that fill enum fields (v0.48.10).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "enum_decl",
            REAP nd_code FROM generate_node, node_el, env_make(0, sigs, esub, plant_list_make(0), "", plant_list_make(0), plant_list_make(0), eregs, "", "", "").
            SET struct_code TO struct_code + nd_code.
        /IF.
        SET i TO i + 1.
    /SEASON.
    CREATE ffi_tentries(LIST) TO plant_list_make(0).
    CREATE ffi_torder(LIST) TO plant_list_make(0).
    CREATE tscnX(TX) TO "".
    CREATE tstdef(TX) TO "".
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "struct_decl",
            CREATE sgens4(LIST) TO _map_get(node_el, "generics").
            IF COUNT sgens4 IS 0,
                REAP sname4 FROM _map_get, node_el, "name".
                REAP scn4 FROM ffi_struct_cname, sname4.
                CREATE eargs(LIST) TO plant_list_make(0).
                REAP stdef FROM struct_typedef, node_el, eargs.
                CREATE sfldsT(LIST) TO struct_fields_at(node_el, eargs).
                CREATE enT(LIST) TO plant_list_make(0).
                PUT "scn" INTO enT.
                PUT scn4 INTO enT.
                PUT "flds" INTO enT.
                PUT sfldsT INTO enT.
                PUT "stdef" INTO enT.
                PUT stdef INTO enT.
                PUT enT INTO ffi_tentries.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT structs_insts,
        REAP node_el FROM plant_list_get, structs_insts, i.
        REAP ibase FROM base_of, node_el.
        REAP ibtrim FROM trim, ibase.
        REAP iargs FROM parse_type_args, node_el.
        REAP itpl FROM find_struct, structs, ibtrim.
        IF COUNT itpl > 0,
            REAP scnA FROM ffi_struct_cname, node_el.
            REAP stdef FROM struct_typedef, itpl, iargs.
            CREATE sfldsT(LIST) TO struct_fields_at(itpl, iargs).
            CREATE enT(LIST) TO plant_list_make(0).
            PUT "scn" INTO enT.
            PUT scnA INTO enT.
            PUT "flds" INTO enT.
            PUT sfldsT INTO enT.
            PUT "stdef" INTO enT.
            PUT stdef INTO enT.
            PUT enT INTO ffi_tentries.
        /IF.
        SET i TO i + 1.
    /SEASON.
    REAP ffi_torder FROM ffi_topo_order, ffi_tentries.
    SET i TO 0.
    SEASON i < COUNT ffi_torder,
        REAP node_el FROM plant_list_get, ffi_torder, i.
        REAP tscnX FROM _map_get, node_el, "scn".
        SET struct_code TO struct_code + "#define PLANT_STRUCT_" + tscnX + " 1\n".
        REAP tstdef FROM _map_get, node_el, "stdef".
        SET struct_code TO struct_code + tstdef.
        SET i TO i + 1.
    /SEASON.
    # FFI-extension prototypes (STRUCT/CALLBACK/void*/varargs sigs) —
    # the mock defines matching functions; plain externals keep the
    # hand-written mock_ffi.h prototypes (no duplicates).
    CREATE ffi_has_cb(NUM) TO 0.
    CREATE ffi_has_vp(NUM) TO 0.
    CREATE ffi_has_va(NUM) TO 0.
    SET i TO 0.
    SEASON i < COUNT ffi_exts,
        REAP fex FROM plant_list_get, ffi_exts, i.
        REAP fnode FROM find_ext_node, ast, fex.
        IF COUNT fnode > 0,
            CREATE fpars(LIST) TO _map_get(fnode, "params").
            CREATE fret2(TX) TO _map_get(fnode, "ret").
            CREATE fvga(TX) TO _map_get(fnode, "varargs").
            REAP fretc FROM ffi_ret_ctype, fret2.
            CREATE fexneed(NUM) TO 0.
            REAP fkr2 FROM ffi_param_kind, fret2.
            IF fkr2 IS "plain", SET fexneed TO 0. /IF.
            IF fkr2 IS "struct_val", SET fexneed TO 1. /IF.
            IF fkr2 IS "struct_ref", SET fexneed TO 1. /IF.
            IF fkr2 IS "callback", SET fexneed TO 1. /IF.
            IF fkr2 IS "voidptr", SET fexneed TO 1. /IF.
            CREATE fci(NUM) TO 0.
            CREATE fcel(TX) TO "".
            SEASON fci < COUNT fpars,
                REAP fcel FROM plant_list_get, fpars, fci.
                REAP fcnx FROM _map_get, fcel, "name".
                REAP fct2 FROM _map_get, fcel, "type".
                REAP fccx FROM ffi_ctype, fct2.
                REAP fk9 FROM ffi_param_kind, fct2.
                IF fk9 IS "callback", SET ffi_has_cb TO 1. /IF.
                IF fk9 IS "voidptr", SET ffi_has_vp TO 1. /IF.
                IF fk9 IS "struct_val", SET fexneed TO 1. /IF.
                IF fk9 IS "struct_ref", SET fexneed TO 1. /IF.
                IF fk9 IS "callback", SET fexneed TO 1. /IF.
                IF fk9 IS "voidptr", SET fexneed TO 1. /IF.
                SET fci TO fci + 1.
            /SEASON.
            IF fvga IS "1",
                SET ffi_has_va TO 1.
                SET fexneed TO 1.
            /IF.
            # Only emit prototypes that mock_ffi.h does NOT already
            # cover: struct/callback/void*/varargs signatures. Plain
            # externs keep the hand-written prototypes (their C types
            # are mock-specific, e.g. `long` for Result<NUM,TX>).
            IF fexneed IS 1,
                SET struct_code TO struct_code + fretc + " " + fex + "(".
                SET fci TO 0.
                SEASON fci < COUNT fpars,
                    REAP fcel FROM plant_list_get, fpars, fci.
                    REAP fcnx FROM _map_get, fcel, "name".
                    REAP fct2 FROM _map_get, fcel, "type".
                    REAP fccx FROM ffi_ctype, fct2.
                    IF fci > 0, SET struct_code TO struct_code + ", ". /IF.
                    SET struct_code TO struct_code + fccx + " " + fcnx.
                    SET fci TO fci + 1.
                /SEASON.
                IF fvga IS "1",
                    SET struct_code TO struct_code + ", ...".
                /IF.
                SET struct_code TO struct_code + ");\n".
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    IF ffi_has_cb IS 1, SET struct_code TO struct_code + "#define PLANT_FFI_HAS_CALLBACKS 1\n". /IF.
    IF ffi_has_vp IS 1, SET struct_code TO struct_code + "#define PLANT_FFI_HAS_VOIDPTR 1\n". /IF.
    IF ffi_has_va IS 1, SET struct_code TO struct_code + "#define PLANT_FFI_HAS_VARARGS 1\n". /IF.
    SET struct_code TO struct_code + "#endif\n/*__PLANT_TYPES_END__*/\n\n".
    # FFI conversion helpers for every reachable struct type:
    # plant_map_to_X / plant_map_to_ref_X / plant_struct_alloc_copy_X /
    # plant_X_to_map. Emitted in dependency order (topo) so nested
    # struct fields can reference each other's helpers.
    CREATE ffi_entries(LIST) TO plant_list_make(0).
    CREATE ffi_topo(TX) TO "".
    CREATE enA(LIST) TO plant_list_make(0).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "struct_decl",
            CREATE sgensQ(LIST) TO _map_get(node_el, "generics").
            IF COUNT sgensQ IS 0,
                REAP snameQ FROM _map_get, node_el, "name".
                CREATE eargsQ(LIST) TO plant_list_make(0).
                REAP scnA FROM ffi_struct_cname, snameQ.
                CREATE sfldsA(LIST) TO struct_fields_at(node_el, eargsQ).
                CREATE enA(LIST) TO plant_list_make(0).
                PUT "scn" INTO enA.
                PUT scnA INTO enA.
                PUT "flds" INTO enA.
                PUT sfldsA INTO enA.
                PUT enA INTO ffi_entries.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT structs_insts,
        REAP node_el FROM plant_list_get, structs_insts, i.
        REAP ibase2 FROM base_of, node_el.
        REAP ibtrim2 FROM trim, ibase2.
        REAP iargs2 FROM parse_type_args, node_el.
        REAP itpl2 FROM find_struct, structs, ibtrim2.
        IF COUNT itpl2 > 0,
            REAP scnB FROM ffi_struct_cname, node_el.
            CREATE sfldsB(LIST) TO struct_fields_at(itpl2, iargs2).
            CREATE enA(LIST) TO plant_list_make(0).
            PUT "scn" INTO enA.
            PUT scnB INTO enA.
            PUT "flds" INTO enA.
            PUT sfldsB INTO enA.
            PUT enA INTO ffi_entries.
        /IF.
        SET i TO i + 1.
    /SEASON.
    REAP ffi_topo FROM ffi_topo_emit_helpers, ffi_entries.
    # callback wrappers: static tx_t plant_cbw_<name>(long ctx,
    # tx_t val) { return <name>(...); } for every ACTION passed as a
    # CALLBACK argument (ABI: ctx is the ensure-token, val the call
    # value). A 2-param action maps (ctx → p0, val → p1); a 1-param
    # action gets val; 0 params gets a plain call.
    CREATE cb_code(TX) TO "".
    CREATE cbnode(LIST) TO plant_list_make(0).
    CREATE cbprms(LIST) TO plant_list_make(0).
    CREATE cbp(TX) TO "".
    CREATE cbt(TX) TO "".
    CREATE cbtk(TX) TO "".
    CREATE cbcn(TX) TO "".
    CREATE cbak(NUM) TO 0.
    CREATE cbcast(TX) TO "".
    SET i TO 0.
    SEASON i < COUNT cb_acts,
        REAP cba FROM plant_list_get, cb_acts, i.
        REAP cbnode FROM find_node, ast, cba.
        CREATE cbprms(LIST) TO _map_get(cbnode, "params").
        SET cbcn TO cba + "(".
        SET cbak TO 0.
        SEASON cbak < COUNT cbprms,
            REAP cbp FROM plant_list_get, cbprms, cbak.
            REAP cbt FROM _map_get, cbp, "type".
            REAP cbtk FROM ffi_param_kind, cbt.
            SET cbcast TO "".
            IF cbtk IS "plain" AND cbt IS "NUM", SET cbcast TO "(long)(intptr_t)". /IF.
            IF cbtk IS "plain" AND cbt IS "FACT", SET cbcast TO "(int)(intptr_t)". /IF.
            IF cbak > 0, SET cbcn TO cbcn + ", ". /IF.
            IF cbak IS 0 AND COUNT cbprms IS 1,
                SET cbcn TO cbcn + cbcast + "val".
            /IF.
            IF cbak IS 0 AND COUNT cbprms IS 2,
                SET cbcn TO cbcn + cbcast + "ctx".
            /IF.
            IF cbak IS 1,
                SET cbcn TO cbcn + cbcast + "val".
            /IF.
            SET cbak TO cbak + 1.
        /SEASON.
        SET cbcn TO cbcn + ")".
        SET cb_code TO cb_code + "static tx_t plant_cbw_" + cba + "(long ctx, tx_t val) { return " + cbcn + "; }\n".
        SET i TO i + 1.
    /SEASON.
    IF COUNT cb_acts > 0, SET cb_code TO cb_code + "\n". /IF.
    # v0.48.15: top-level MISSION CONFIG stmts force a wrapper main; a
    # plain ACTION main() is then emitted as plant_main() and invoked
    # by the wrapper so the config keys apply before any FAST heap use
    # (avoids the int-main/tx_t-main type clash in the generated C).
    CREATE has_cfg(TX) TO "0".
    CREATE has_plain_main(TX) TO "0".
    # v0.48.37c: SAFE actions force the int-main wrapper (registrations +
    # plant_maybe_run_worker + plant_init_cli) even for action-only
    # programs, so the real worker pool gets argv0/worker-mode and the
    # ACTION main() is renamed plant_main() to avoid the C main clash.
    CREATE has_safe_work(TX) TO "0".
    IF COUNT safe_acts > 0, SET has_safe_work TO "1". /IF.
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP ce_nd FROM plant_list_get, ast, i.
        REAP ce_ty FROM _map_get, ce_nd, "type".
        IF ce_ty IS "config_stmt", SET has_cfg TO "1". /IF.
        IF ce_ty IS "action_decl",
            REAP ce_nm FROM _map_get, ce_nd, "name".
            REAP ce_as FROM _map_get, ce_nd, "async".
            IF ce_nm IS "main" AND ce_as ISNT "1", SET has_plain_main TO "1". /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 1: forward declarations for every non-generic action_decl +
    # every monomorphized instantiation
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            REAP aname FROM _map_get, node_el, "name".
            CREATE gens3(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens3 IS 0,
                CREATE params3(LIST) TO _map_get(node_el, "params").
                REAP asymark FROM _map_get, node_el, "async".
                SET paramstr TO "".
                SET pi TO 0.
                SEASON pi < COUNT params3,
                    REAP param_el FROM plant_list_get, params3, pi.
                    REAP pname FROM _map_get, param_el, "name".
                    REAP ptype FROM _map_get, param_el, "type".
                    REAP ctype FROM ffi_ctype, ptype.
                    IF pi > 0, SET paramstr TO paramstr + ", ". /IF.
                    SET paramstr TO paramstr + ctype + " " + pname.
                    SET pi TO pi + 1.
                /SEASON.
                IF asymark IS "1",
                    SET pro_code TO pro_code + "tx_t " + aname + "(tx_t __parent, tx_t __ctx".
                    IF paramstr > "", SET pro_code TO pro_code + ", " + paramstr. /IF.
                    SET pro_code TO pro_code + ");\n".
                /IF.
                IF asymark ISNT "1",
                    IF aname IS "main",
                        IF has_cfg IS "1" OR has_safe_work IS "1",
                            SET pro_code TO pro_code + "tx_t plant_main(" + paramstr + ");\n".
                        /IF.
                    /IF.
                    IF aname ISNT "main",
                        SET pro_code TO pro_code + "tx_t " + aname + "(" + paramstr + ");\n".
                    /IF.
                    IF aname IS "main" AND has_cfg ISNT "1" AND has_safe_work ISNT "1",
                        SET pro_code TO pro_code + "tx_t " + aname + "(" + paramstr + ");\n".
                    /IF.
                /IF.
            /IF.
        /IF.
        SET i TO i + 1.
    /SEASON.
    SET i TO 0.
    SEASON i < COUNT insts,
        REAP node_el FROM plant_list_get, insts, i.
        REAP inst_code FROM inst_fwddecl, node_el, templates.
        SET pro_code TO pro_code + inst_code.
        SET i TO i + 1.
    /SEASON.
    # pass 0d: closure discovery — stamps closure nodes in place and
    # builds the per-action clmap table + the ordered closure list;
    # env typedefs and closure fn forwards/definitions go into
    # pro_code before the ACTION definitions so all calls resolve.
    REAP clres FROM collect_closures, ast, sigs.
    REAP clmaps FROM plant_list_get, clres, 0.
    REAP cllist FROM plant_list_get, clres, 1.
    CREATE cltype_code(TX) TO "".
    CREATE clfwd_code(TX) TO "".
    CREATE cldef_code(TX) TO "".
    # enum typedefs now live in the shared types block (struct_code),
    # before every consumer — closure defs, action defs, mock FFI.
    SET i TO 0.
    SEASON i < COUNT cllist,
        REAP cnode FROM plant_list_get, cllist, i.
        REAP tc FROM _cl_emit_typedef, cnode.
        SET cltype_code TO cltype_code + tc + "".
        REAP fnn FROM _map_get, cnode, "fnname".
        REAP cprm FROM _map_get, cnode, "params".
        REAP pstr2 FROM _cl_param_str, cprm.
        SET clfwd_code TO clfwd_code + "tx_t " + fnn + "(tx_t env".
        IF pstr2 > "", SET clfwd_code TO clfwd_code + ", " + pstr2. /IF.
        SET clfwd_code TO clfwd_code + ");\n".
        REAP fd FROM _cl_emit_fn, cnode, sigs, esub, eregs.
        SET cldef_code TO cldef_code + fd + "".
        SET i TO i + 1.
    /SEASON.
    CREATE implicit(LIST) TO collect_implicit(ast, plant_list_make(0)).
    CREATE dcode(TX) TO "".
    CREATE di(NUM) TO 0.
    CREATE dv(TX) TO "".
    SEASON di < COUNT implicit,
        REAP dv FROM plant_list_get, implicit, di.
        SET dcode TO dcode + "  tx_t " + dv + " = \"\";\n".
        SET di TO di + 1.
    /SEASON.
    # pass 2b: async reachability from ACTION main() — if any
    # action in main's call graph is an ASYNC ACTION, stamp main
    # with drain_after so generate_node emits plant_async_drain()
    # at the end of the C main() entry (v0.48.3a).
    CREATE drn_main(NUM) TO async_reachable(ast).
    SET i TO 0.
    SEASON i < COUNT ast,
        REAP node_el FROM plant_list_get, ast, i.
        REAP ntype FROM _map_get, node_el, "type".
        IF ntype IS "action_decl",
            CREATE gens4(LIST) TO _map_get(node_el, "generics").
            IF COUNT gens4 IS 0,
                REAP aname FROM _map_get, node_el, "name".
                REAP asy4 FROM _map_get, node_el, "async".
                CREATE node_el2(TX) TO node_el.
                IF str_eq(aname, "main") IS "1" AND drn_main IS 1 AND asy4 ISNT "1",
                    REAP node_el2 FROM map_add, node_el, "drain_after", "1".
                /IF.
                IF str_eq(aname, "main") IS "1" AND asy4 ISNT "1",
                    IF has_cfg IS "1" OR has_safe_work IS "1",
                        REAP node_el2 FROM map_add, node_el2, "main_rename", "1".
                    /IF.
                /IF.
                REAP cmact FROM _cl_map_get, clmaps, aname.
                REAP nd_code FROM generate_node, node_el2, env_make(0, sigs, esub, cmact, "", plant_list_make(0), plant_list_make(0), eregs, "", "", "").
                SET decl_code TO decl_code + nd_code.
                SET has_decl TO 1.
            /IF.
        /IF.
        IF ntype IS "enum_decl",
            SET has_decl TO 1.
        /IF.
        # v0.49.25: import_stmt nodes are loader-level no-ops and must
        # not flip has_stmt (which would force a duplicate CLI main).
        IF ntype ISNT "action_decl" AND ntype ISNT "enum_decl" AND ntype ISNT "external_decl" AND ntype ISNT "struct_decl" AND ntype ISNT "import_stmt" AND ntype ISNT "type_decl" AND ntype ISNT "species_decl" AND ntype ISNT "interface_decl",
            REAP ns_code FROM generate_node, node_el, env_make(0, sigs, esub, plant_list_make(0), "", plant_list_make(0), plant_list_make(0), eregs, "", "", "").
            SET stmt_code TO stmt_code + ns_code.
            SET has_stmt TO 1.
        /IF.
        SET i TO i + 1.
    /SEASON.
    # pass 3: definitions of every monomorphized instantiation
    SET i TO 0.
    SEASON i < COUNT insts,
        REAP node_el FROM plant_list_get, insts, i.
        REAP nd_code FROM emit_inst, node_el, templates, sigs, eregs.
        SET decl_code TO decl_code + nd_code.
        SET has_decl TO 1.
        SET i TO i + 1.
    /SEASON.
    # v0.48.37c: one file-scope adapter per SAFE action, in registry
    # order. The worker process dispatches to these by index; each
    # unpacks the wire argv into the action's C parameter list.
    CREATE adapter_code(TX) TO "".
    SET i TO 0.
    SEASON i < COUNT safe_acts,
        REAP sae FROM plant_list_get, safe_acts, i.
        REAP san FROM find_node, ast, sae.
        CREATE sprm(LIST) TO _map_get(san, "params").
        SET adapter_code TO adapter_code + "tx_t plant_safe_adapter_" + sae + "(int argc, tx_t* argv) {\n".
        CREATE spi(NUM) TO 0.
        CREATE spe(TX) TO "".
        CREATE spn(TX) TO "".
        CREATE spt(TX) TO "".
        CREATE sct(TX) TO "".
        SEASON spi < COUNT sprm,
            REAP spe FROM plant_list_get, sprm, spi.
            REAP spn FROM _map_get, spe, "name".
            REAP spt FROM _map_get, spe, "type".
            REAP sct FROM ffi_ctype, spt.
            IF sct IS "long",
                SET adapter_code TO adapter_code + "  long " + spn + " = (argc > " + spi + ") ? " + "plant_rw_arg_long" + "(" + "argv" + "[" + spi + "]" + ") :" + " 0;\n".
            /IF.
            IF sct IS "int",
                SET adapter_code TO adapter_code + "  int " + spn + " = (argc > " + spi + ") ? " + "(int)plant_rw_arg_long" + "(" + "argv" + "[" + spi + "]" + ") :" + " 0;\n".
            /IF.
            IF sct ISNT "long" AND sct ISNT "int",
                SET adapter_code TO adapter_code + "  tx_t " + spn + " = (argc > " + spi + ") ? " + "argv" + "[" + spi + "]" + " :" + " NULL;\n".
            /IF.
            SET spi TO spi + 1.
        /SEASON.
        SET adapter_code TO adapter_code + "  return (tx_t)" + sae + "(".
        SET spi TO 0.
        SEASON spi < COUNT sprm,
            REAP spe FROM plant_list_get, sprm, spi.
            REAP spn FROM _map_get, spe, "name".
            IF spi > 0, SET adapter_code TO adapter_code + ", ". /IF.
            SET adapter_code TO adapter_code + spn.
            SET spi TO spi + 1.
        /SEASON.
        SET adapter_code TO adapter_code + ");\n}\n".
        SET i TO i + 1.
    /SEASON.
    IF COUNT safe_acts > 0, SET adapter_code TO adapter_code + "\n". /IF.
    IF has_stmt IS 1 OR has_safe_work IS "1",
        # v0.48.37c: registrations must precede every SAFE call; they
        # run in the worker process too (plant_maybe_run_worker never
        # returns there, so the child only ever sees init + registry).
        IF COUNT safe_acts > 0,
            CREATE reg_code(TX) TO "".
            SET i TO 0.
            SEASON i < COUNT safe_acts,
                REAP sae FROM plant_list_get, safe_acts, i.
                SET reg_code TO reg_code + "  plant_safe_register(\"" + sae + "\", plant_safe_adapter_" + sae + ");\n".
                SET i TO i + 1.
            /SEASON.
            SET stmt_code TO reg_code + "  plant_maybe_run_worker();\n" + stmt_code.
        /IF.
        IF has_plain_main IS "1",
            SET stmt_code TO stmt_code + "  plant_main();\n".
        /IF.
        SET stmt_code TO "int main(int argc, char **argv) {\n  plant_init_cli(argc, argv);\n" + sp_init_code + dcode + stmt_code + "  plant_async_drain();\n  return 0;\n}\n".
    /IF.
    # v0.49.27 - C typedefs for TYPE aliases
    CREATE td_code(TX) TO "".
    SET i TO 0.
    SEASON i + 1 < COUNT tsub,
        REAP tal FROM plant_list_get, tsub, i.
        REAP trg FROM plant_list_get, tsub, i + 1.
        REAP rv2 FROM _ts_resolve, tsub, trg.
        REAP ct2 FROM plant_ctype, rv2.
        SET td_code TO td_code + "typedef " + ct2 + " " + tal + ";\n".
        SET i TO i + 2.
    /SEASON.
    GIVE header + roots_code + struct_code + td_code + ffi_topo + cltype_code + pro_code + cb_code + clfwd_code + "\n" + cldef_code + "\n" + decl_code + adapter_code + stmt_code.
/ACTION.

# ═══════════════════════════════════════════════════════════════
#  Closures Engine — v0.48.2
#
#  Pass 0d runs in generate_c: collect_closures(ast) walks every
#  non-generic ACTION body with a scope stack (params + locals +
#  implicit vars) and stamps each closure node in place:
#    cid      — unique closure index N
#    envname  — plant_Env_N          (env struct typedef name)
#    fnname   — plant_Closure_N_fn   (C function name)
#    captures — flat [name, initCexpr, …]  (create-site assignments)
#    moved    — list of MOVE names (outer var cleared after create)
#    shadows  — list of 6-key maps (name, ctype, mode) driving the
#               closure fn's local shadows + env struct fields
#    clmap    — flat [varname, closurenode, …] of closures created
#               directly inside this closure's own body
#  Returns [clmaps, cllist]; clmaps is flat [actionname, clmap, …]
#  and cllist holds every closure node in discovery order.
#  Env typedefs + closure fn forwards + definitions are emitted
#  into pro_code (before the ACTION definitions) so calls resolve.
# ═══════════════════════════════════════════════════════════════

# _cl_is_arg — "1" when a reap argument is a @@CLOSURE@@ placeholder
ACTION _cl_is_arg(arg(TX)),
    REAP pre FROM substring, arg, 0, 11.
    IF pre IS "@@CLOSURE@@", GIVE "1". /IF.
    GIVE "0".
/ACTION.

# _cl_map_get — flat-pairs lookup: value for key, or ""
ACTION _cl_map_get(clmap(LIST), key(TX)),
    CREATE mi2(NUM) TO 0.
    CREATE me2(TX) TO "".
    SEASON mi2 < COUNT clmap,
        REAP me2 FROM plant_list_get, clmap, mi2.
        IF str_eq(me2, key) IS "1",
            REAP mret FROM plant_list_get, clmap, mi2 + 1.
            GIVE mret.
        /IF.
        SET mi2 TO mi2 + 2.
    /SEASON.
    GIVE "".
/ACTION.

# is_prim_type — "1" when a PlantLang type is a built-in scalar
# (NUM/FACT/TX/LIST/STRING/DOUBLE/JSON/SET/QUEUE/STACK/BYTES/FUNC);
# "0" for enum/struct/generic/REF types. Closure scopes skip the
# "#t" twin keys for primitives since only enum/struct types can
# carry enum values (v0.48.11).
ACTION is_prim_type(ptype(TX)),
  REAP pb FROM type_base, ptype.
  REAP pbt FROM trim, pb.
  IF pbt IS "NUM", GIVE "1". /IF.
  IF pbt IS "FACT", GIVE "1". /IF.
  IF pbt IS "LIST", GIVE "1". /IF.
  IF pbt IS "TX", GIVE "1". /IF.
  IF pbt IS "STRING", GIVE "1". /IF.
  IF pbt IS "DOUBLE", GIVE "1". /IF.
  IF pbt IS "JSON", GIVE "1". /IF.
  IF pbt IS "SET", GIVE "1". /IF.
  IF pbt IS "QUEUE", GIVE "1". /IF.
  IF pbt IS "STACK", GIVE "1". /IF.
  IF pbt IS "BYTES", GIVE "1". /IF.
  IF pbt IS "FUNC", GIVE "1". /IF.
  GIVE "0".
/ACTION.

# _cl_ccache_get — look up a resolved "ctype;prim" pair for a type
# in the per-scope cache (flat triples [type, ctype, prim]); "" on
# miss. Repeated types within one scope share one resolution
# instead of recomputing plant_ctype/is_prim_type (v0.48.11).
ACTION _cl_ccache_get(cache(LIST), t(TX)),
  CREATE ci(NUM) TO 0.
  CREATE ck(TX) TO "".
  CREATE cv(TX) TO "".
  CREATE cp(TX) TO "".
  SEASON ci + 2 < COUNT cache,
    REAP ck FROM plant_list_get, cache, ci.
    REAP cv FROM plant_list_get, cache, ci + 1.
    REAP cp FROM plant_list_get, cache, ci + 2.
    IF str_eq(ck, t) IS "1",
      GIVE cv + ";" + cp.
    /IF.
    SET ci TO ci + 3.
  /SEASON.
  GIVE "".
/ACTION.

# _cl_scopes — extend a scope stack with the declarations a
# statement list introduces (create/let locals, reap targets,
# cycle iterators, match bindings). sigs resolves reap targets to
# their callee return type for the "#t" twin keys (v0.48.10).
# Type resolution for create/let is memoized per call and the "#t"
# twin keys are skipped for primitive types (v0.48.11).
ACTION _cl_scopes(bd(LIST), scopes(LIST), sigs(LIST)),
    CREATE n2(NUM) TO 0.
    CREATE st(TX) TO "".
    CREATE res(LIST) TO scopes.
    CREATE cch(LIST) TO plant_list_make(0).
    SEASON n2 < COUNT bd,
        REAP st FROM plant_list_get, bd, n2.
        REAP sty FROM _map_get, st, "type".
        IF sty IS "create_stmt",
            REAP stg FROM _map_get, st, "target".
            REAP stv FROM _map_get, st, "var_type".
            REAP ccv FROM _cl_ccache_get, cch, stv.
            IF ccv IS "",
                REAP stc FROM plant_ctype, stv.
                REAP spr FROM is_prim_type, stv.
                IF COUNT cch < 36,
                    PUT stv INTO cch.
                    PUT stc INTO cch.
                    PUT spr INTO cch.
                /IF.
            /IF.
            IF ccv ISNT "",
                REAP ccparts FROM strings:SPLIT, ccv, ";".
                REAP stc FROM plant_list_get, ccparts, 0.
                REAP spr FROM plant_list_get, ccparts, 1.
            /IF.
            PUT stg INTO res.
            PUT stc INTO res.
            IF spr IS "0",
                PUT stg + "#t" INTO res.
                PUT stv INTO res.
            /IF.
        /IF.
        IF sty IS "let_stmt",
            REAP stg FROM _map_get, st, "target".
            REAP stv FROM _map_get, st, "var_type".
            REAP ccv FROM _cl_ccache_get, cch, stv.
            IF ccv IS "",
                REAP stc FROM plant_ctype, stv.
                REAP spr FROM is_prim_type, stv.
                IF COUNT cch < 36,
                    PUT stv INTO cch.
                    PUT stc INTO cch.
                    PUT spr INTO cch.
                /IF.
            /IF.
            IF ccv ISNT "",
                REAP ccparts FROM strings:SPLIT, ccv, ";".
                REAP stc FROM plant_list_get, ccparts, 0.
                REAP spr FROM plant_list_get, ccparts, 1.
            /IF.
            PUT stg INTO res.
            PUT stc INTO res.
            IF spr IS "0",
                PUT stg + "#t" INTO res.
                PUT stv INTO res.
            /IF.
        /IF.
        IF sty IS "reap_stmt",
            REAP stg FROM _map_get, st, "target".
            IF stg ISNT "_",
                REAP oldc FROM _cl_map_get, res, stg.
                IF oldc IS "",
                    PUT stg INTO res.
                    PUT "tx_t" INTO res.
                    REAP stact FROM _map_get, st, "action".
                    REAP stbs FROM base_of, stact.
                    REAP stre FROM find_ret, sigs, stbs.
                    IF stre > "",
                        PUT stg + "#t" INTO res.
                        PUT stre INTO res.
                    /IF.
                /IF.
            /IF.
        /IF.
        # v0.49.6 — reap_expr_stmt targets (REAP x FROM a[0].) are
        # plain tx_t too, declared exactly like reap_stmt targets.
        IF sty IS "reap_expr_stmt",
            REAP stg FROM _map_get, st, "target".
            IF stg ISNT "_",
                REAP oldc FROM _cl_map_get, res, stg.
                IF oldc IS "",
                    PUT stg INTO res.
                    PUT "tx_t" INTO res.
                /IF.
            /IF.
        /IF.
        IF sty IS "cycle_stmt",
            REAP iv FROM _map_get, st, "iterVar".
            REAP le FROM _map_get, st, "listExpr".
            IF le > "",
                PUT iv INTO res.
                PUT "tx_t" INTO res.
            /IF.
            IF le IS "",
                PUT iv INTO res.
                PUT "long" INTO res.
            /IF.
        /IF.
        IF sty IS "match_stmt",
            REAP mcl FROM _map_get, st, "clauses".
            CREATE mn2(NUM) TO 0.
            CREATE mel(TX) TO "".
            SEASON mn2 < COUNT mcl,
                REAP mel FROM plant_list_get, mcl, mn2.
                REAP mb FROM _map_get, mel, "binding".
                IF mb > "" AND mb ISNT "null",
                    PUT mb INTO res.
                    PUT "tx_t" INTO res.
                /IF.
                SET mn2 TO mn2 + 1.
            /SEASON.
        /IF.
        IF sty IS "weather_stmt",
            REAP wsh FROM _map_get, st, "shelters".
            CREATE wni(NUM) TO 1.
            SEASON wni < COUNT wsh,
                REAP wbe FROM plant_list_get, wsh, wni.
                IF wbe > "" AND wbe ISNT "null",
                    PUT wbe INTO res.
                    PUT "tx_t" INTO res.
                /IF.
                SET wni TO wni + 3.
            /SEASON.
        /IF.
        SET n2 TO n2 + 1.
    /SEASON.
    GIVE res.
/ACTION.

# _cl_stamp_cnode — resolve a closure node's captures against the
# enclosing scope, recurse into its own body, stamp cid/envname/
# fnname/captures/moved/shadows/clmap keys in place, append it to
# the closure sequence. Returns [clseq, cid].
ACTION _cl_stamp_cnode(cnode(LIST), scopes(LIST), cc(NUM), res(LIST), sigs(LIST)),
    REAP cnp FROM _map_get, cnode, "params".
    REAP cnb FROM _map_get, cnode, "body".
    REAP ccap FROM _map_get, cnode, "captures".
    CREATE cid3(TX) TO _from_long(cc).
    CREATE envn3(TX) TO "plant_Env_" + cid3.
    CREATE fnn3(TX) TO "plant_Closure_" + cid3 + "_fn".
    CREATE capsflat(LIST) TO plant_list_make(0).
    CREATE moved3(LIST) TO plant_list_make(0).
    CREATE shads3(LIST) TO plant_list_make(0).
    CREATE cpsc(LIST) TO plant_list_make(0).
    # closure params are in scope inside the closure body
    CREATE cpi3(NUM) TO 0.
    CREATE cpe3(TX) TO "".
    SEASON cpi3 < COUNT cnp,
        REAP cpe3 FROM plant_list_get, cnp, cpi3.
        REAP cpn3 FROM _map_get, cpe3, "name".
        REAP cpt3 FROM _map_get, cpe3, "type".
        REAP cct3 FROM plant_ctype, cpt3.
        PUT cpn3 INTO cpsc.
        PUT cct3 INTO cpsc.
        REAP cpr3 FROM is_prim_type, cpt3.
        IF cpr3 IS "0",
            PUT cpn3 + "#t" INTO cpsc.
            PUT cpt3 INTO cpsc.
        /IF.
        SET cpi3 TO cpi3 + 1.
    /SEASON.
    # resolve each capture against the enclosing scope
    CREATE cci3(NUM) TO 0.
    CREATE cce3(TX) TO "".
    SEASON cci3 < COUNT ccap,
        REAP cce3 FROM plant_list_get, ccap, cci3.
        REAP capn3 FROM _map_get, cce3, "name".
        REAP capm3 FROM _map_get, cce3, "mode".
        REAP capct FROM _cl_map_get, scopes, capn3.
        IF capct IS "",
            SET capct TO "tx_t".
        /IF.
        REAP capty FROM _cl_map_get, scopes, capn3 + "#t".
        IF capty IS "",
            SET capty TO capct.
        /IF.
        IF str_eq(capm3, "MOVE") IS "1",
            PUT capn3 INTO capsflat.
            PUT capn3 INTO capsflat.
            PUT capn3 INTO moved3.
        /IF.
        IF str_eq(capm3, "REF") IS "1",
            PUT capn3 INTO capsflat.
            PUT "&" + capn3 INTO capsflat.
        /IF.
        PUT plant_list_make(8, "name", capn3, "ctype", capct, "mode", capm3, "ptype", capty) INTO shads3.
        PUT capn3 INTO cpsc.
        PUT capct INTO cpsc.
        PUT capn3 + "#t" INTO cpsc.
        PUT capty INTO cpsc.
        SET cci3 TO cci3 + 1.
    /SEASON.
    # nested closures inside this closure's own body (block form only;
    # expr bodies are plain text and contain no statements)
    CREATE cmap3(LIST) TO plant_list_make(0).
    CREATE cck(NUM) TO cc + 1.
    REAP cnk FROM _map_get, cnode, "bkind".
    IF str_eq(cnk, "block") IS "1",
        REAP cres FROM _cl_walk, cnb, cpsc, res, plant_list_make(0), cc + 1, sigs.
        REAP res FROM plant_list_get, cres, 0.
        REAP cmap3 FROM plant_list_get, cres, 1.
        REAP cck FROM plant_list_get, cres, 2.
    /IF.
    # stamp the closure node in place
    PUT "cid" INTO cnode.
    PUT cid3 INTO cnode.
    PUT "envname" INTO cnode.
    PUT envn3 INTO cnode.
    PUT "fnname" INTO cnode.
    PUT fnn3 INTO cnode.
    PUT "clcaps" INTO cnode.
    PUT capsflat INTO cnode.
    PUT "moved" INTO cnode.
    PUT moved3 INTO cnode.
    PUT "shadows" INTO cnode.
    PUT shads3 INTO cnode.
    PUT "clmap" INTO cnode.
    PUT cmap3 INTO cnode.
    PUT cnode INTO res.
    GIVE plant_list_make(2, res, cck).
/ACTION.

# _cl_walk — walk one statement list, stamping closures in place.
# scopes: flat [name, ctype, …] of the current C function scope.
# Returns the accumulator triple [clseq, clmap, cid].
ACTION _cl_walk(bd(LIST), scopes(LIST), clseq(LIST), clmap(LIST), cid(NUM), sigs(LIST)),
    CREATE n3(NUM) TO 0.
    CREATE st3(TX) TO "".
    CREATE res(LIST) TO clseq.
    CREATE rmap(LIST) TO clmap.
    CREATE cc(NUM) TO cid.
    SEASON n3 < COUNT bd,
        REAP st3 FROM plant_list_get, bd, n3.
        REAP sty3 FROM _map_get, st3, "type".
        REAP sc3 FROM _cl_scopes, plant_list_make(1, st3), scopes, sigs.
        # create_stmt / let_stmt carrying a closure node
        REAP cnode3 FROM _map_get, st3, "closure".
        IF cnode3 > "",
            REAP tgt3 FROM _map_get, st3, "target".
            REAP cres FROM _cl_stamp_cnode, cnode3, sc3, cc, res, sigs.
            REAP res FROM plant_list_get, cres, 0.
            REAP cc FROM plant_list_get, cres, 1.
            PUT tgt3 INTO rmap.
            PUT cnode3 INTO rmap.
        /IF.
        # inline closure arguments of reap statements are stamped too
        # (their envs are built inline at the call site)
        IF sty3 IS "reap_stmt",
            REAP cla3 FROM _map_get, st3, "clargs".
            IF cla3 > "",
                CREATE clai(NUM) TO 0.
                CREATE clae(TX) TO "".
                SEASON clai < COUNT cla3,
                    REAP clae FROM plant_list_get, cla3, clai.
                    REAP cres FROM _cl_stamp_cnode, clae, sc3, cc, res, sigs.
                    REAP res FROM plant_list_get, cres, 0.
                    REAP cc FROM plant_list_get, cres, 1.
                    SET clai TO clai + 1.
                /SEASON.
            /IF.
        /IF.
        # recurse into nested bodies (same scope + their own locals);
        # if_stmt branches are walked uniformly via _if_bodies and
        # weather_stmt bodies via _weather_bodies (v0.48.20/.48.23)
        IF sty3 ISNT "if_stmt" AND sty3 ISNT "weather_stmt",
            REAP bd3 FROM _map_get, st3, "body".
            IF bd3 > "",
                REAP scn FROM _cl_scopes, bd3, sc3, sigs.
                REAP cres FROM _cl_walk, bd3, scn, res, rmap, cc, sigs.
                REAP res FROM plant_list_get, cres, 0.
                REAP rmap FROM plant_list_get, cres, 1.
                REAP cc FROM plant_list_get, cres, 2.
            /IF.
        /IF.
        IF sty3 IS "if_stmt",
            REAP ib3 FROM _if_bodies, st3.
            CREATE ibi3(NUM) TO 0.
            SEASON ibi3 < COUNT ib3,
                REAP ibd5 FROM plant_list_get, ib3, ibi3.
                REAP scn FROM _cl_scopes, ibd5, sc3, sigs.
                REAP cres FROM _cl_walk, ibd5, scn, res, rmap, cc, sigs.
                REAP res FROM plant_list_get, cres, 0.
                REAP rmap FROM plant_list_get, cres, 1.
                REAP cc FROM plant_list_get, cres, 2.
                SET ibi3 TO ibi3 + 1.
            /SEASON.
        /IF.
        IF sty3 IS "weather_stmt",
            REAP wbl13 FROM _weather_bodies, st3.
            CREATE wbi13(NUM) TO 0.
            SEASON wbi13 < COUNT wbl13,
                REAP wbel13 FROM plant_list_get, wbl13, wbi13.
                REAP scn FROM _cl_scopes, wbel13, sc3, sigs.
                REAP cres FROM _cl_walk, wbel13, scn, res, rmap, cc, sigs.
                REAP res FROM plant_list_get, cres, 0.
                REAP rmap FROM plant_list_get, cres, 1.
                REAP cc FROM plant_list_get, cres, 2.
                SET wbi13 TO wbi13 + 1.
            /SEASON.
        /IF.
        IF sty3 IS "match_stmt",
            REAP mcl3 FROM _map_get, st3, "clauses".
            CREATE mn3(NUM) TO 0.
            CREATE mel3(TX) TO "".
            SEASON mn3 < COUNT mcl3,
                REAP mel3 FROM plant_list_get, mcl3, mn3.
                REAP mb3 FROM _map_get, mel3, "bodyStatements".
                REAP scm FROM _cl_scopes, mb3, sc3, sigs.
                REAP cres FROM _cl_walk, mb3, scm, res, rmap, cc, sigs.
                REAP res FROM plant_list_get, cres, 0.
                REAP rmap FROM plant_list_get, cres, 1.
                REAP cc FROM plant_list_get, cres, 2.
                SET mn3 TO mn3 + 1.
            /SEASON.
        /IF.
        SET n3 TO n3 + 1.
    /SEASON.
    GIVE plant_list_make(3, res, rmap, cc).
/ACTION.

# collect_closures — pass 0d over the whole AST
ACTION collect_closures(ast(LIST), sigs(LIST)),
    CREATE clmaps(LIST) TO plant_list_make(0).
    CREATE cllist(LIST) TO plant_list_make(0).
    CREATE ai5(NUM) TO 0.
    CREATE ae5(TX) TO "".
    SEASON ai5 < COUNT ast,
        REAP ae5 FROM plant_list_get, ast, ai5.
        REAP aty FROM _map_get, ae5, "type".
        IF aty IS "action_decl",
            REAP agen FROM _map_get, ae5, "generics".
            IF COUNT agen IS 0,
                REAP aname5 FROM _map_get, ae5, "name".
                REAP apms5 FROM _map_get, ae5, "params".
                REAP abd5 FROM _map_get, ae5, "body".
                REAP apsc FROM _cl_scopes, abd5, plant_list_make(0), sigs.
                CREATE ai6(NUM) TO 0.
                CREATE ae6(TX) TO "".
                SEASON ai6 < COUNT apms5,
                    REAP ae6 FROM plant_list_get, apms5, ai6.
                    REAP apn6 FROM _map_get, ae6, "name".
                    REAP apt6 FROM _map_get, ae6, "type".
                    REAP act6 FROM plant_ctype, apt6.
                    PUT apn6 INTO apsc.
                    PUT act6 INTO apsc.
                    PUT apn6 + "#t" INTO apsc.
                    PUT apt6 INTO apsc.
                    SET ai6 TO ai6 + 1.
                /SEASON.
                REAP imp5 FROM collect_implicit, abd5, apms5.
                CREATE di5(NUM) TO 0.
                CREATE dv5(TX) TO "".
                SEASON di5 < COUNT imp5,
                    REAP dv5 FROM plant_list_get, imp5, di5.
                    PUT dv5 INTO apsc.
                    PUT "tx_t" INTO apsc.
                    SET di5 TO di5 + 1.
                /SEASON.
                CREATE cseedd(NUM) TO COUNT cllist.
                REAP cres FROM _cl_walk, abd5, apsc, cllist, plant_list_make(0), cseedd, sigs.
                REAP cllist FROM plant_list_get, cres, 0.
                REAP cmap5 FROM plant_list_get, cres, 1.
                PUT aname5 INTO clmaps.
                PUT cmap5 INTO clmaps.
            /IF.
        /IF.
        SET ai5 TO ai5 + 1.
    /SEASON.
    GIVE plant_list_make(2, clmaps, cllist).
/ACTION.

# _cl_param_str — "type name, type name" for a params list
ACTION _cl_param_str(params(LIST)),
    CREATE pstr(TX) TO "".
    CREATE pi3(NUM) TO 0.
    CREATE pe3(TX) TO "".
    SEASON pi3 < COUNT params,
        REAP pe3 FROM plant_list_get, params, pi3.
        REAP pn3 FROM _map_get, pe3, "name".
        REAP pt3 FROM _map_get, pe3, "type".
        REAP ct3 FROM plant_ctype, pt3.
        IF pi3 > 0, SET pstr TO pstr + ", ". /IF.
        SET pstr TO pstr + ct3 + " " + pn3.
        SET pi3 TO pi3 + 1.
    /SEASON.
    GIVE pstr.
/ACTION.

# _cl_emit_typedef — "typedef struct { … } plant_Env_N;"
# MOVE fields keep the captured value's C type; REF fields are
# always tx_t (a pointer to the borrowed outer variable).
ACTION _cl_emit_typedef(cnode(LIST)),
    REAP envn FROM _map_get, cnode, "envname".
    REAP shads FROM _map_get, cnode, "shadows".
    CREATE tc(TX) TO "typedef struct \{\n".
    CREATE si4(NUM) TO 0.
    CREATE se4(TX) TO "".
    CREATE sm4(TX) TO "".
    SEASON si4 < COUNT shads,
        REAP se4 FROM plant_list_get, shads, si4.
        REAP sm4 FROM _map_get, se4, "mode".
        REAP sct4 FROM _map_get, se4, "ctype".
        REAP sname4 FROM _map_get, se4, "name".
        IF str_eq(sm4, "MOVE") IS "1",
            SET tc TO tc + "  " + sct4 + " " + sname4 + ";\n".
        /IF.
        IF str_eq(sm4, "REF") IS "1",
            SET tc TO tc + "  tx_t " + sname4 + ";\n".
        /IF.
        SET si4 TO si4 + 1.
    /SEASON.
    SET tc TO tc + "\} " + envn + ";\n".
    GIVE tc.
/ACTION.

# _cl_emit_fn — the closure function definition:
#   tx_t plant_Closure_N_fn(tx_t env, params…) {
#     ctype name = env->name;            // MOVE shadow
#     ctype name = *((ctype*)env->name); // REF shadow
#     return expr;                       // or block body
#   }
#  reg: enum registry (build_enum_registry) — the closure body gets
#  its own enum table (closure params + captured shadows + enum
#  CREATE/LET targets) so SHOW/concat wrap with _from_enum (v0.48.9).
ACTION _cl_emit_fn(cnode(LIST), sigs(LIST), subst(LIST), reg(LIST)),
    REAP fname FROM _map_get, cnode, "fnname".
    REAP envn2 FROM _map_get, cnode, "envname".
    REAP params FROM _map_get, cnode, "params".
    REAP bk FROM _map_get, cnode, "bkind".
    REAP shads FROM _map_get, cnode, "shadows".
    REAP cm2 FROM _map_get, cnode, "clmap".
    REAP pstr FROM _cl_param_str, params.
    # closure-scope param-style maps: closure params + captured
    # shadows (as name/type pairs) feed the enum table
    CREATE cbpars2(LIST) TO plant_list_make(0).
    CREATE cbi(NUM) TO 0.
    CREATE cbe(TX) TO "".
    SEASON cbi < COUNT params,
        REAP cbe FROM plant_list_get, params, cbi.
        PUT cbe INTO cbpars2.
        SET cbi TO cbi + 1.
    /SEASON.
    CREATE cbsi(NUM) TO 0.
    CREATE cbse(TX) TO "".
    CREATE cbsn(TX) TO "".
    CREATE cbty(TX) TO "".
    SEASON cbsi < COUNT shads,
        REAP cbse FROM plant_list_get, shads, cbsi.
        REAP cbsn FROM _map_get, cbse, "name".
        REAP cbty FROM _map_get, cbse, "ptype".
        PUT plant_list_make(4, "name", cbsn, "type", cbty) INTO cbpars2.
        SET cbsi TO cbsi + 1.
    /SEASON.
    CREATE fnc(TX) TO "tx_t " + fname + "(tx_t env".
    IF pstr > "", SET fnc TO fnc + ", " + pstr. /IF.
    SET fnc TO fnc + ") \{\n".
    CREATE si5(NUM) TO 0.
    CREATE se5(TX) TO "".
    CREATE sm5(TX) TO "".
    CREATE sct5(TX) TO "".
    SEASON si5 < COUNT shads,
        REAP se5 FROM plant_list_get, shads, si5.
        REAP sm5 FROM _map_get, se5, "mode".
        REAP sct5 FROM _map_get, se5, "ctype".
        REAP snameQ FROM _map_get, se5, "name".
        IF str_eq(sm5, "MOVE") IS "1",
            SET fnc TO fnc + "  " + sct5 + " " + snameQ + " = ((" + envn2 + "*)env)->" + snameQ + ";\n".
        /IF.
        IF str_eq(sm5, "REF") IS "1",
            SET fnc TO fnc + "  " + sct5 + " " + snameQ + " = *(( " + sct5 + "*)((" + envn2 + "*)env)->" + snameQ + ");\n".
        /IF.
        SET si5 TO si5 + 1.
    /SEASON.
    IF str_eq(bk, "expr") IS "1",
        REAP bx FROM _map_get, cnode, "body".
        CREATE nums_c(LIST) TO collect_nums_cb(plant_list_make(0), params, shads, subst).
        CREATE evars_c(LIST) TO collect_enums(plant_list_make(0), cbpars2, subst, reg, sigs).
        REAP cx3 FROM translate_expr, bx, nums_c, evars_c.
        REAP cx3 FROM _handle_cat, cx3, nums_c, evars_c.
        SET fnc TO fnc + "  return " + cx3 + ";\n".
    /IF.
    IF str_eq(bk, "block") IS "1",
        REAP bb FROM _map_get, cnode, "body".
        CREATE nums_c(LIST) TO collect_nums_cb(bb, params, shads, subst).
        CREATE stvars_c(LIST) TO collect_stvars_walk(bb, subst, plant_list_make(0)).
        CREATE cbpars(LIST) TO params.
        CREATE si6(NUM) TO 0.
        CREATE se6(TX) TO "".
        SEASON si6 < COUNT shads,
            REAP se6 FROM plant_list_get, shads, si6.
            PUT se6 INTO cbpars.
            SET si6 TO si6 + 1.
        /SEASON.
        REAP imp6 FROM collect_implicit, bb, cbpars.
        CREATE di6(NUM) TO 0.
        CREATE dv6(TX) TO "".
        SEASON di6 < COUNT imp6,
            REAP dv6 FROM plant_list_get, imp6, di6.
            SET fnc TO fnc + "  tx_t " + dv6 + " = \"\";\n".
            SET di6 TO di6 + 1.
        /SEASON.
        CREATE evars_c(LIST) TO collect_enums(bb, cbpars2, subst, reg, sigs).
        REAP bc3 FROM generate_body, bb, env_make(1, sigs, subst, cm2, "", nums_c, stvars_c, evars_c, "", "", "").
        SET fnc TO fnc + bc3 + "".
    /IF.
    SET fnc TO fnc + "\}\n".
    GIVE fnc.


/ACTION.
