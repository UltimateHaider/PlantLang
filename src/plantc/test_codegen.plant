IMPORT "tokens.plant".
IMPORT "ast.plant".
IMPORT "lexer.plant".
IMPORT "parser.plant".
IMPORT "codegen_c.plant".

# ──────────────────────────────────────────────────────────────
#  Helper: build test ASTs via variables (inline maps in
#  REAP args don't evaluate — use CREATE + _map_get normally)
# ──────────────────────────────────────────────────────────────

# ── Test 1: Basic statements ──────────────────────────────────
CREATE test_ast(LIST) TO [
  { "type": "create_stmt", "target": "x", "var_type": "NUM", "value": "42" },
  { "type": "set_stmt", "target": "x", "value": "x + 1" },
  { "type": "show_stmt", "value": "x" },
  { "type": "give_stmt", "value": "x" },
  { "type": "break_stmt" },
  { "type": "continue_stmt" },
  { "type": "put_stmt", "item": "x", "target": "arr" }
].
REAP ccode1 FROM generate_c, test_ast.
SHOW "═══ test 1 — statements ═══".
SHOW ccode1.

# ── Test 2: if_stmt with body ─────────────────────────────────
CREATE if_body(LIST) TO [
  { "type": "show_stmt", "value": "x" },
  { "type": "set_stmt", "target": "x", "value": "x - 1" }
].
CREATE if_ast(LIST) TO [
  { "type": "if_stmt", "cond": "x > 0", "body": if_body }
].
REAP ccode2 FROM generate_c, if_ast.
SHOW "═══ test 2 — if_stmt ═══".
SHOW ccode2.

# ── Test 3: season_stmt (while loop) ──────────────────────────
CREATE season_body(LIST) TO [
  { "type": "show_stmt", "value": "x" },
  { "type": "set_stmt", "target": "x", "value": "x + 1" }
].
CREATE season_ast(LIST) TO [
  { "type": "season_stmt", "cond": "x < 10", "body": season_body }
].
REAP ccode3 FROM generate_c, season_ast.
SHOW "═══ test 3 — season_stmt ═══".
SHOW ccode3.

# ── Test 4: cycle_stmt FROM/TO ────────────────────────────────
CREATE cycle_body(LIST) TO [
  { "type": "show_stmt", "value": "i" }
].
CREATE cycle_ft_ast(LIST) TO [
  { "type": "cycle_stmt", "iterVar": "i", "fromExpr": "0", "toExpr": "10", "stepExpr": "2", "body": cycle_body }
].
REAP ccode4 FROM generate_c, cycle_ft_ast.
SHOW "═══ test 4 — cycle_stmt FROM/TO ═══".
SHOW ccode4.

# ── Test 5: cycle_stmt IN list form ───────────────────────────
CREATE cycle_in_body(LIST) TO [
  { "type": "show_stmt", "value": "item" }
].
CREATE cycle_in_ast(LIST) TO [
  { "type": "cycle_stmt", "iterVar": "item", "listExpr": "arr", "indexVar": "idx", "body": cycle_in_body }
].
REAP ccode5 FROM generate_c, cycle_in_ast.
SHOW "═══ test 5 — cycle_stmt IN list ═══".
SHOW ccode5.

# ── Test 6: reap_stmt (variable and silent targets) ───────────
CREATE reap_ast(LIST) TO [
  { "type": "reap_stmt", "target": "result", "action": "my_func", "args": ["x", "42"] },
  { "type": "reap_stmt", "target": "_", "action": "side_effect", "args": [] },
  { "type": "reap_stmt", "target": "output", "action": "translate_expr", "args": ["x + 1"] }
].
REAP ccode6 FROM generate_c, reap_ast.
SHOW "═══ test 6 — reap_stmt ═══".
SHOW ccode6.

# ── Test 7: action_decl with parameters and body ──────────────
CREATE add_params(LIST) TO [
  { "name": "a", "type": "NUM" },
  { "name": "b", "type": "NUM" }
].
CREATE add_body(LIST) TO [
  { "type": "give_stmt", "value": "a + b" }
].
CREATE greet_params(LIST) TO [
  { "name": "name", "type": "TX" }
].
CREATE greet_body(LIST) TO [
  { "type": "show_stmt", "value": "name" }
].
CREATE action_ast(LIST) TO [
  { "type": "action_decl", "name": "add", "params": add_params, "body": add_body },
  { "type": "action_decl", "name": "greet", "params": greet_params, "body": greet_body }
].
REAP ccode7 FROM generate_c, action_ast.
SHOW "═══ test 7 — action_decl ═══".
SHOW ccode7.

# ── Test 8: enum_decl ─────────────────────────────────────────
CREATE color_members(LIST) TO ["RED", "GREEN", "BLUE"].
CREATE status_members(LIST) TO ["OK", "ERROR", "PENDING"].
CREATE enum_ast(LIST) TO [
  { "type": "enum_decl", "name": "Color", "members": color_members },
  { "type": "enum_decl", "name": "Status", "members": status_members }
].
REAP ccode8 FROM generate_c, enum_ast.
SHOW "═══ test 8 — enum_decl ═══".
SHOW ccode8.

# ── Test 9: match_stmt ────────────────────────────────────────
CREATE match_clause1_body(LIST) TO [
  { "type": "show_stmt", "value": "\"one\"" }
].
CREATE match_clause2_body(LIST) TO [
  { "type": "show_stmt", "value": "val" }
].
CREATE match_clauses(LIST) TO [
  { "variantName": "ONE", "binding": "null", "bodyStatements": match_clause1_body },
  { "variantName": "TWO", "binding": "val", "bodyStatements": match_clause2_body }
].
CREATE match_ast(LIST) TO [
  { "type": "match_stmt", "subjectExpr": "x", "clauses": match_clauses }
].
REAP ccode9 FROM generate_c, match_ast.
SHOW "═══ test 9 — match_stmt ═══".
SHOW ccode9.

# ── Test 10: combined action with if/season inside ────────────
CREATE countdown_body(LIST) TO [
  { "type": "season_stmt", "cond": "n > 0", "body": [
    { "type": "show_stmt", "value": "n" },
    { "type": "set_stmt", "target": "n", "value": "n - 1" }
  ] },
  { "type": "show_stmt", "value": "\"done\"" }
].
CREATE countdown_params(LIST) TO [
  { "name": "n", "type": "NUM" }
].
CREATE combined_ast(LIST) TO [
  { "type": "action_decl", "name": "countdown", "params": countdown_params, "body": countdown_body }
].
REAP ccode10 FROM generate_c, combined_ast.
SHOW "═══ test 10 — combined action with season ═══".
SHOW ccode10.
