IMPORT "tokens.plant".
IMPORT "ast.plant".
IMPORT "lexer.plant".
IMPORT "parser.plant".
IMPORT "codegen_c.plant".

PLANT fs.
PLANT strings.

# ── get_cli_arg — FFI external stub ─────────────────────────
# Linked to process.argv in the JS runtime.
# Falls back to "test.plant" when no argument is provided.

ACTION get_cli_arg(idx(NUM)) -> external.


# ═══════════════════════════════════════════════════════════
#  Compiler Pipeline — Stage 0 self-hosting driver
# ═══════════════════════════════════════════════════════════

# 1. Source file path (default: test.plant)
REAP arg0 FROM get_cli_arg, 0.
IF arg0 IS "-h" OR arg0 IS "--help",
  SHOW "Chloroplast — Pure Native PlantLang compiler".
  SHOW "usage: Chloroplast <source.plant> [out.c]".
  SHOW "options:".
  SHOW "  -h, --help     show this help and exit".
  SHOW "  -v, --version  show version and exit".
  GIVE 0.
/IF.
IF arg0 IS "-v" OR arg0 IS "--version",
  SHOW "Chloroplast 0.49.56b (pure native)".
  GIVE 0.
/IF.
REAP source_path FROM get_cli_arg, 0.
SHOW "input: " + source_path.

# 2. Validate
REAP exists FROM fs:EXISTS, source_path.
IF exists ISNT "1",
  SHOW "Error: file not found — " + source_path.
  GIVE 1.
/IF.

# 3. Read
REAP source_text FROM fs:READ, source_path.

# 3b. v0.49.25 - expand IMPORT directives (dedupe + cycle guard)
REAP merged_text FROM plant_import_load, source_path.
CREATE err_head(TX) TO substring(merged_text, 0, 5).
REAP is_err FROM str_eq, err_head, "@@E@@".
IF is_err IS "1",
  REAP emsg FROM substring, merged_text, 5, LEN(merged_text).
  SHOW emsg.
  GIVE 1.
/IF.
SET source_text TO merged_text.

# 4. Tokenize
SHOW "tokenizing...".
REAP tokens FROM scan_tokens, source_text.

# 5. Parse
SHOW "parsing...".
REAP program_ast FROM parse_program, tokens.
REAP perr FROM _map_get, program_ast, "error".
IF perr > "",
  SHOW "Error: " + perr + ".".
  GIVE 1.
/IF.
REAP body FROM _map_get, program_ast, "body".

# v0.49.39 - compile-time interface conformance validation
CREATE iface_names(LIST) TO plant_list_make(0).
CREATE iface_meths(LIST) TO plant_list_make(0).
CREATE ci99(NUM) TO 0.
SEASON ci99 < COUNT body,
  REAP nd99 FROM plant_list_get, body, ci99.
  REAP ty99 FROM _map_get, nd99, "type".
  IF ty99 IS "interface_decl",
    REAP inm99 FROM _map_get, nd99, "name".
    REAP imth99 FROM _map_get, nd99, "methods".
    PUT inm99 INTO iface_names.
    PUT imth99 INTO iface_meths.
  /IF.
  SET ci99 TO ci99 + 1.
/SEASON.
CREATE spi99(NUM) TO 0.
SEASON spi99 < COUNT body,
  REAP snd99 FROM plant_list_get, body, spi99.
  REAP sty99 FROM _map_get, snd99, "type".
  IF sty99 IS "species_decl",
    REAP simp99 FROM _map_get, snd99, "implements".
    IF simp99 > "",
      REAP snm99 FROM _map_get, snd99, "name".
      CREATE ii999(NUM) TO 0.
      SEASON ii999 < COUNT simp99,
        REAP ifn999 FROM plant_list_get(simp99, ii999).
        CREATE mi999(NUM) TO 0.
        SEASON mi999 < COUNT iface_names,
          REAP ifnm999 FROM plant_list_get(iface_names, mi999).
          REAP feq999 FROM str_eq, ifn999, ifnm999.
          IF feq999 IS "1",
            REAP reqmth FROM plant_list_get(iface_meths, mi999).
            CREATE fnd999(NUM) TO 0.
            CREATE ai999(NUM) TO 0.
            SEASON ai999 < COUNT body,
              REAP and99 FROM plant_list_get(body, ai999).
              REAP aty999 FROM _map_get(and99, "type").
              IF aty999 IS "action_decl",
                REAP anm999 FROM _map_get, and99, "name".
                REAP meq999 FROM str_eq, anm999, reqmth.
                IF meq999 IS "1", SET fnd999 TO 1. /IF.
              /IF.
              SET ai999 TO ai999 + 1.
            /SEASON.
            IF fnd999 IS 0,
              SHOW "Error: species '" + snm99 + "' does not implement method '" + reqmth + "' from interface '" + ifn999 + "'".
              GIVE 1.
            /IF.
          /IF.
          SET mi999 TO mi999 + 1.
        /SEASON.
        SET ii999 TO ii999 + 1.
      /SEASON.
    /IF.
  /IF.
  SET spi99 TO spi99 + 1.
/SEASON.

# v0.49.32 - polymorphic dispatch: dedup action_decls keeping the
# LAST definition for each name (child overrides parent). Uses a
# pairs-map for O(1) lookup; each unique action appears once in the
# output at its first original position.
CREATE ad_map(LIST) TO plant_map_create().
CREATE ad_out(LIST) TO plant_list_make(0).
CREATE ad_emitted(LIST) TO plant_map_create().
CREATE adi(NUM) TO 0.
SEASON adi < COUNT body,
  REAP en9 FROM plant_list_get, body, adi.
  REAP ety9 FROM _map_get, en9, "type".
  IF ety9 IS "action_decl",
    REAP enm9 FROM _map_get, en9, "name".
    SET ad_map TO plant_map_set(ad_map, enm9, en9).
  /IF.
  SET adi TO adi + 1.
/SEASON.
CREATE adi2(NUM) TO 0.
SEASON adi2 < COUNT body,
  REAP en9b FROM plant_list_get, body, adi2.
  REAP ety9b FROM _map_get, en9b, "type".
  IF ety9b IS "action_decl",
    REAP enm9b FROM _map_get, en9b, "name".
    REAP alr9 FROM _map_get, ad_emitted, enm9b.
    IF alr9 IS "",
      REAP resolved FROM _map_get, ad_map, enm9b.
      PUT resolved INTO ad_out.
      SET ad_emitted TO plant_map_set(ad_emitted, enm9b, "1").
    /IF.
  /IF.
  IF ety9b ISNT "action_decl", PUT en9b INTO ad_out. /IF.
  SET adi2 TO adi2 + 1.
/SEASON.
SET body TO ad_out.

# 6. Code generate
SHOW "generating C...".
REAP c_code FROM generate_c, body.

# 7. Determine output path (use second CLI arg if provided)
REAP out_path FROM get_cli_arg, 1.
IF out_path IS "",
  REAP out_path FROM strings:REPLACE, source_path, ".plant", ".c".
/IF.
REAP written FROM fs:WRITE, out_path, c_code.
REAP c_len FROM strings:LENGTH, c_code.
SHOW "output: " + c_len + " bytes to " + out_path.
CALM.
