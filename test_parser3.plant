IMPORT "src/plantc/tokens.plant".
IMPORT "src/plantc/ast.plant".
IMPORT "src/plantc/lexer.plant".
IMPORT "src/plantc/parser.plant".

CREATE src(TX) TO "LET x(NUM) TO 42.".
REAP toks FROM scan_tokens, src.
SHOW "tokens:".
SHOW toks.

SHOW "---test parse_let_stmt---".
REAP pair FROM parse_let_stmt, toks, 0.
SHOW "result:".
SHOW pair.

SHOW "DONE".
