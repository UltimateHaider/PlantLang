ACTION main(),
  REAP s FROM math_sqrt, "16".
  SHOW "sqrt16=" + s.
  REAP s2 FROM math_sqrt, "2".
  SHOW "sqrt2=" + s2.
  REAP f FROM math_floor, "3.7".
  SHOW "floor37=" + f.
  REAP c FROM math_ceil, "3.2".
  SHOW "ceil32=" + c.
  REAP r FROM math_round, "2.5".
  SHOW "round25=" + r.
  REAP p FROM math_pow, "2", "10".
  SHOW "pow=" + p.
  REAP si FROM math_sin, "0".
  SHOW "sin0=" + si.
  REAP mn FROM math_min, "3", "7".
  SHOW "min=" + mn.
  REAP mx FROM math_max, "3", "7".
  SHOW "max=" + mx.
  REAP rd FROM math_random.
  CREATE rl(NUM) TO LEN(rd).
  CREATE rls(TX) TO "".
  REAP rls FROM _from_long, rl.
  SHOW "rndlen=" + rls.
  REAP d0 FROM _at, rd, 0.
  SHOW "rndhead=" + d0.
  GIVE 0.
/GIVE main.
