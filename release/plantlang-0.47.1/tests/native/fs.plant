ACTION main(),
  REAP w FROM fs_WRITE, "/tmp/plantlang_fs_test_src.txt", "hello fs".
  SHOW "write=" + w.
  REAP c1 FROM file_copy, "/tmp/plantlang_fs_test_src.txt", "/tmp/plantlang_fs_test_dst.txt".
  SHOW "copy=" + c1.
  REAP e1 FROM fs_EXISTS, "/tmp/plantlang_fs_test_dst.txt".
  SHOW "exists=" + e1.
  REAP st FROM file_stat, "/tmp/plantlang_fs_test_dst.txt".
  IF st IS NULL,
    SHOW "FAIL: stat".
    GIVE 1.
  /IF.
  REAP sz FROM _map_get, st, "size".
  SHOW "size=" + sz.
  REAP mo FROM _map_get, st, "mode".
  SHOW "mode=" + mo.
  REAP mt FROM _map_get, st, "mtime".
  CREATE mlen(NUM) TO LEN(mt).
  CREATE ms(TX) TO "".
  REAP ms FROM _from_long, mlen.
  SHOW "mtimelen=" + ms.
  REAP mv FROM file_move, "/tmp/plantlang_fs_test_dst.txt", "/tmp/plantlang_fs_test_moved.txt".
  SHOW "move=" + mv.
  REAP e2 FROM fs_EXISTS, "/tmp/plantlang_fs_test_dst.txt".
  SHOW "oldgone=" + e2.
  REAP e3 FROM fs_EXISTS, "/tmp/plantlang_fs_test_moved.txt".
  SHOW "newhere=" + e3.
  REAP st2 FROM file_stat, "/tmp/plantlang_fs_test_nope.txt".
  IF st2 IS NULL,
    SHOW "stat-missing-nil".
  /IF.
  GIVE 0.
/GIVE main.
