# generic STRUCTs through the monomorphization engine:
#   Box[T] { val: T }            — single type param
#   Pair[T, U] { first: T, second: U }  — multi type params
#   Wrap[T] { box: Box[T], tag: TX }    — nested generic struct
# The typedefs plant_Box_NUM / plant_Pair_NUM_TX / plant_Wrap_NUM
# must be emitted (checked via .grep) and phantom instantiations
# (plant_Box_T, plant_Pair_NUM_NUM) must NOT appear.
STRUCT Box[T] { val: T }
STRUCT Pair[T, U] { first: T, second: U }
STRUCT Wrap[T] { box: Box[T], tag: TX }

ACTION ffi_make_box(v(TX)) -> external.
ACTION ffi_box_write(b(Box[NUM]), v(NUM)) -> external.
ACTION ffi_box_read(b(Box[NUM])) -> external.
ACTION ffi_make_pair(a(TX), b(TX)) -> external.
ACTION ffi_pair_read(p(Pair[NUM, TX])) -> external.
ACTION ffi_make_wrap(box(TX), tag(TX)) -> external.
ACTION ffi_w_read(w(Wrap[NUM])) -> external.

ACTION main(),
  REAP b FROM ffi_make_box, "0".
  REAP _ FROM ffi_box_write, b, 42.
  REAP v FROM ffi_box_read, b.
  SHOW "box=" + v.
  REAP p FROM ffi_make_pair, "7", "x".
  REAP pr FROM ffi_pair_read, p.
  SHOW "pair=" + pr.
  REAP w FROM ffi_make_wrap, b, "t".
  REAP wr FROM ffi_w_read, w.
  SHOW "wrap=" + wr.
  GIVE 0.
/GIVE main.
