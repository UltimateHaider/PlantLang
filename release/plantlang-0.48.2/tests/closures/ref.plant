# REF captures: the env stores a pointer to the outer variable;
# mutations made after closure creation are visible inside.
ACTION main(),
  CREATE y(NUM) TO 20.
  CREATE g TO [REF y](v(NUM)) -> v + y + 1.
  REAP r FROM g, 1.
  REAP rs FROM _from_long, r.
  SHOW "before=" + rs.
  SET y TO 99.
  REAP r2 FROM g, 1.
  REAP rs2 FROM _from_long, r2.
  SHOW "after=" + rs2.
  REAP ys FROM _from_long, y.
  SHOW "outer=" + ys.
  GIVE 0.
/GIVE main.
