{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PlantLang",
  "scopeName": "source.plantlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#mission" },
    { "include": "#depth-prefix" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#storm-types" },
    { "include": "#type-names" },
    { "include": "#block-closers" },
    { "include": "#control-flow" },
    { "include": "#declarations" },
    { "include": "#actions" },
    { "include": "#objects" },
    { "include": "#http" },
    { "include": "#testing" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#library-calls" }
  ],
  "repository": {

    "comments": {
      "name": "comment.line.number-sign.plantlang",
      "match": "#.*$"
    },

    "mission": {
      "match": "^(MISSION)\\s*:\\s*(SAFE|FAST|SMART|BALANCED)\\b",
      "captures": {
        "1": { "name": "keyword.control.mission.plantlang" },
        "2": { "name": "constant.language.mission-mode.plantlang" }
      }
    },

    "depth-prefix": {
      "match": "^(\\d+)\\\\",
      "captures": {
        "1": { "name": "punctuation.definition.depth.plantlang" }
      }
    },

    "strings": {
      "name": "string.quoted.double.plantlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.plantlang",
          "match": "\\\\."
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.plantlang",
          "match": "\\b-?[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.plantlang",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },

    "booleans": {
      "name": "constant.language.boolean.plantlang",
      "match": "\\b(TRUE|FALSE)\\b"
    },

    "storm-types": {
      "name": "entity.name.type.storm.plantlang",
      "match": "\\b(ZERO_STORM|TYPE_STORM|MISSING_STORM|SEED_STORM|LOST_STORM|BOUND_STORM|LOCK_STORM|STOP_STORM|PERM_STORM|NETWORK_STORM|SYNTAX_STORM|ANY_STORM)\\b"
    },

    "type-names": {
      "name": "entity.name.type.plantlang",
      "match": "\\b(NUM|SCL|TX|FACT|LIST|MAP|INSTANCE|VEIN)\\b"
    },

    "block-closers": {
      "patterns": [
        {
          "name": "keyword.control.block-close.plantlang",
          "match": "^\\s*\\d*\\\\?\\.\\s*$"
        },
        {
          "name": "keyword.control.block-close.plantlang",
          "match": "\\b(\\/ACTION|\\/SPECIES|LISTEN\\/|SUITE\\/)\\b"
        }
      ]
    },

    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.plantlang",
          "match": "\\b(IF|ORIF|ELSE|STOP\\s+IF|PICK)\\b"
        },
        {
          "name": "keyword.control.loop.plantlang",
          "match": "\\b(CYCLE|SEASON|FROM|TO|STEP|IN)\\b"
        },
        {
          "name": "keyword.control.match.plantlang",
          "match": "\\b(MATCH|YIELD|BETWEEN|IS|IS NOT|ELSE)\\b"
        },
        {
          "name": "keyword.control.storm.plantlang",
          "match": "\\b(WEATHER|SHELTER|CALM)\\b"
        },
        {
          "name": "keyword.control.flow.plantlang",
          "match": "\\b(FLOW|AND|OR|NOT|GREATER|LESS|THAN)\\b"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(CREATE)\\s+(\\w+)\\s*\\(\\s*(NUM|SCL|TX|FACT|LIST|MAP|INSTANCE|VEIN)\\s*\\)",
          "captures": {
            "1": { "name": "keyword.other.create.plantlang" },
            "2": { "name": "variable.other.plantlang" },
            "3": { "name": "entity.name.type.plantlang" }
          }
        },
        {
          "match": "\\b(CREATE)\\s+(\\w+)\\b",
          "captures": {
            "1": { "name": "keyword.other.create.plantlang" },
            "2": { "name": "variable.other.plantlang" }
          }
        },
        {
          "name": "keyword.other.variable.plantlang",
          "match": "\\b(SET|INCREASE|DECREASE|LOCK|EVAPORATE|EMPTY|SHOW|ANALYZE)\\b"
        },
        {
          "match": "\\b(ROOT_SCOPE)\\s+(\\w+)\\b",
          "captures": {
            "1": { "name": "keyword.other.root-scope.plantlang" },
            "2": { "name": "entity.name.constant.plantlang" }
          }
        },
        {
          "match": "\\b(ROOT)\\s+(\\w+)\\s+TO\\b",
          "captures": {
            "1": { "name": "keyword.other.root.plantlang" },
            "2": { "name": "entity.name.constant.plantlang" }
          }
        },
        {
          "name": "keyword.other.config.plantlang",
          "match": "\\b(MISSION|PLANT|ROOT|ROOT_SCOPE|WAIT|NOW|TYPEOF)\\b"
        },
        {
          "name": "keyword.other.list.plantlang",
          "match": "\\b(PUT|TAKE|SORT|SHAKE|EMPTY|BRAID|LINK|WITH)\\b"
        },
        {
          "name": "keyword.other.reactive.plantlang",
          "match": "\\b(PULSE|WHENEVER|CHANGES)\\b"
        },
        {
          "name": "keyword.other.file.plantlang",
          "match": "\\b(TAP|ABSORB|INFUSE|SEAL|LINE)\\b"
        }
      ]
    },

    "actions": {
      "patterns": [
        {
          "match": "\\b(ACTION)\\s+(\\w+)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.action.plantlang" },
            "2": { "name": "entity.name.function.plantlang" }
          }
        },
        {
          "name": "keyword.other.action.plantlang",
          "match": "\\b(GIVE|REAP|FROM)\\b"
        }
      ]
    },

    "objects": {
      "patterns": [
        {
          "match": "\\b(SPECIES)\\s+(\\w+)(?:\\s+PARENT\\s+(\\w+))?\\b",
          "captures": {
            "1": { "name": "keyword.declaration.species.plantlang" },
            "2": { "name": "entity.name.class.plantlang" },
            "3": { "name": "entity.name.class.parent.plantlang" }
          }
        },
        {
          "match": "\\b(BLOOM)\\s+(\\w+)\\s+AS\\s+(\\w+)\\b",
          "captures": {
            "1": { "name": "keyword.other.bloom.plantlang" },
            "2": { "name": "entity.name.class.plantlang" },
            "3": { "name": "variable.other.instance.plantlang" }
          }
        },
        {
          "name": "keyword.other.object.plantlang",
          "match": "\\b(PARENT|VAR)\\b"
        },
        {
          "name": "variable.language.self.plantlang",
          "match": "\\bSELF:(\\w+)\\b"
        }
      ]
    },

    "http": {
      "patterns": [
        {
          "match": "\\b(LISTEN)\\s+(BRANCH)\\b",
          "captures": {
            "1": { "name": "keyword.other.listen.plantlang" },
            "2": { "name": "keyword.other.branch.plantlang" }
          }
        },
        {
          "name": "keyword.other.http.plantlang",
          "match": "\\b(HARVEST|RESPONSE|ON|WITH|AS|METHOD|BODY|HEADERS|TIMEOUT)\\b"
        },
        {
          "name": "keyword.other.http-method.plantlang",
          "match": "\\b(GET|POST|PUT|DELETE|PATCH)\\b"
        }
      ]
    },

    "testing": {
      "patterns": [
        {
          "match": "\\b(VERIFY)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.other.verify.plantlang" },
            "2": { "name": "string.quoted.double.test-label.plantlang" }
          }
        },
        {
          "match": "\\b(SUITE)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.other.suite.plantlang" },
            "2": { "name": "string.quoted.double.suite-name.plantlang" }
          }
        },
        {
          "name": "keyword.other.testing.plantlang",
          "match": "\\b(STORMS|GIVES|SHOW_VERIFY_SUMMARY)\\b"
        }
      ]
    },

    "builtins": {
      "name": "support.function.builtin.plantlang",
      "match": "\\b(COUNT|FIRST|LAST|SUM|MAX|MIN|REVERSE)\\b"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.plantlang",
          "match": "\\*\\*|\\+|-|\\*|//?|%"
        },
        {
          "name": "keyword.operator.comparison.plantlang",
          "match": "\\b(IS|IS NOT|GREATER THAN OR EQUAL|LESS THAN OR EQUAL|GREATER THAN|LESS THAN)\\b"
        },
        {
          "name": "keyword.operator.logical.plantlang",
          "match": "\\b(AND|OR|NOT)\\b"
        }
      ]
    },

    "library-calls": {
      "patterns": [
        {
          "match": "\\b(math|strings|lists):(\\w+)\\b",
          "captures": {
            "1": { "name": "support.class.library.plantlang" },
            "2": { "name": "support.function.library.plantlang" }
          }
        },
        {
          "match": "(\\w+):(\"[^\"]*\")",
          "captures": {
            "1": { "name": "variable.other.object.plantlang" },
            "2": { "name": "variable.other.property.plantlang" }
          }
        },
        {
          "match": "(\\w+):(\\w+)",
          "captures": {
            "1": { "name": "variable.other.object.plantlang" },
            "2": { "name": "variable.other.property.plantlang" }
          }
        }
      ]
    }

  }
}
