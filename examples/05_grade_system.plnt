# ═══════════════════════════════════════════════════════════
# PlantLang — Example 05: Real Grade System
# ═══════════════════════════════════════════════════════════

MISSION: SAFE.
PLANT math.
PLANT strings.
PLANT lists.

ROOT PASS_MARK TO 50.
ROOT MAX_MARK  TO 100.

# ── Define SPECIES Student ──────────────────────────────────
1\ SPECIES Student,
2\   VAR name(TX)   TO "Unknown".
2\   VAR id(NUM)    TO 0.
2\   VAR scores(LIST).

2\   ACTION add_score(subject(TX), score(NUM)),
3\     IF score LESS THAN 0,    GIVE "Invalid negative score".
3\     IF score GREATER THAN MAX_MARK, GIVE "Score exceeds limit".
3\     PUT score INTO SELF:scores.
3\     GIVE score.
2\   /ACTION.

2\   ACTION average(),
3\     IF COUNT SELF:scores IS 0, GIVE 0.
3\     REAP total FROM lists:AVERAGE, SELF:scores.
3\     REAP rounded FROM math:ROUND, total, 1.
3\     GIVE rounded.
2\   /ACTION.

2\   ACTION grade(),
3\     REAP avg FROM SELF:average.
3\     MATCH avg,
4\       IS BETWEEN 90 100 YIELD GIVE "A — Excellent".
4\       IS BETWEEN 80 89  YIELD GIVE "B — Very Good".
4\       IS BETWEEN 70 79  YIELD GIVE "C — Good".
4\       IS BETWEEN 50 69  YIELD GIVE "D — Pass".
4\       ELSE              YIELD GIVE "F — Fail".
3\     \\.
2\   /ACTION.

2\   ACTION report(),
3\     REAP avg   FROM SELF:average.
3\     REAP grade FROM SELF:grade.
3\     REAP max   FROM lists:SORT, SELF:scores.
3\     GIVE SELF:name + " | Avg: " + avg + " | " + grade.
2\   /ACTION.
1\ /SPECIES.

# ── إنشاء الطnoب ──────────────────────────────────────────
1\ BLOOM Student AS s1.
1\ SET s1:name TO "أحمد علي".
1\ SET s1:id   TO 1001.

1\ BLOOM Student AS s2.
1\ SET s2:name TO "فاطمة حسين".
1\ SET s2:id   TO 1002.

1\ BLOOM Student AS s3.
1\ SET s3:name TO "محمد كريم".
1\ SET s3:id   TO 1003.

# ── Add Scores ─────────────────────────────────────────
1\ REAP _ FROM s1:add_score, "Math", 85.
1\ REAP _ FROM s1:add_score, "Science",    90.
1\ REAP _ FROM s1:add_score, "Arabic",    78.
1\ REAP _ FROM s1:add_score, "English", 92.

1\ REAP _ FROM s2:add_score, "Math", 95.
1\ REAP _ FROM s2:add_score, "Science",    88.
1\ REAP _ FROM s2:add_score, "Arabic",    91.
1\ REAP _ FROM s2:add_score, "English", 87.

1\ REAP _ FROM s3:add_score, "Math", 45.
1\ REAP _ FROM s3:add_score, "Science",    52.
1\ REAP _ FROM s3:add_score, "Arabic",    48.
1\ REAP _ FROM s3:add_score, "English", 55.

# ── Each Student's Report ─────────────────────────────────────────
1\ CREATE students(LIST) TO.
1\ PUT s1 INTO students.
1\ PUT s2 INTO students.
1\ PUT s3 INTO students.

1\ SHOW "═══ Final Grades Report ═══".

1\ REAP r1 FROM s1:report.
1\ REAP r2 FROM s2:report.
1\ REAP r3 FROM s3:report.

1\ SHOW r1.
1\ SHOW r2.
1\ SHOW r3.

# ── Result Summary (Pass/Fail) ─────────────────────────────
1\ SHOW "".
1\ SHOW "═══ Result Summary ═══".

1\ REAP avg1 FROM s1:average.
1\ REAP avg2 FROM s2:average.
1\ REAP avg3 FROM s3:average.

1\ IF avg1 GREATER THAN PASS_MARK, SHOW s1:name + " — Pass ✓".
1\ IF avg2 GREATER THAN PASS_MARK, SHOW s2:name + " — Pass ✓".
1\ IF avg3 LESS THAN PASS_MARK,    SHOW s3:name + " — Fail ✗".

# ── Save Report to File ─────────────────────────────────────
1\ TAP "results.txt" MODE:MARK AS outfile.
1\ INFUSE outfile WITH "تقرير درجات 2025".
1\ INFUSE outfile WITH r1.
1\ INFUSE outfile WITH r2.
1\ INFUSE outfile WITH r3.
1\ SEAL outfile.

1\ SHOW "".
1\ SHOW "Report saved to results.txt ✓".
