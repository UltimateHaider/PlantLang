# PlantLang — Example 02: Actions and Objects
PLANT math.

1\ ACTION add(a(NUM), b(NUM)),
2\   GIVE a + b.
1\ /ACTION.

1\ ACTION factorial(n(NUM)),
2\   IF n IS 0, GIVE 1.
2\   REAP sub FROM factorial, n - 1.
2\   GIVE n * sub.
1\ /ACTION.

1\ ACTION greet(name(TX)),
2\   GIVE "Hello " + name + "!".
1\ /ACTION.

1\ REAP r1 FROM add, 15, 27.
1\ REAP r2 FROM factorial, 6.
1\ REAP r3 FROM greet, "حيدر".
1\ SHOW r1.
1\ SHOW r2.
1\ SHOW r3.

1\ REAP sq FROM math:SQRT, 144.
1\ REAP rnd FROM math:ROUND, 3.14159, 2.
1\ SHOW sq.
1\ SHOW rnd.

1\ SPECIES BankAccount,
2\   VAR owner(TX) TO "Unknown".
2\   VAR balance(SCL) TO 0.
2\   ACTION deposit(amount(SCL)),
3\     INCREASE SELF:balance BY amount.
3\     GIVE SELF:balance.
2\   /ACTION.
2\   ACTION withdraw(amount(SCL)),
3\     IF SELF:balance LESS THAN amount, GIVE "Insufficient balance".
3\     DECREASE SELF:balance BY amount.
3\     GIVE SELF:balance.
2\   /ACTION.
2\   ACTION info(),
3\     GIVE SELF:owner + " — Balance: " + SELF:balance.
2\   /ACTION.
1\ /SPECIES.

1\ BLOOM BankAccount AS acc.
1\ SET acc:owner TO "علي محمد".
1\ REAP b1 FROM acc:deposit, 500.
1\ REAP b2 FROM acc:deposit, 250.
1\ REAP b3 FROM acc:withdraw, 100.
1\ REAP inf FROM acc:info.
1\ SHOW b1.
1\ SHOW b2.
1\ SHOW b3.
1\ SHOW inf.

1\ SPECIES SavingsAccount PARENT BankAccount,
2\   VAR interest_rate(SCL) TO 0.05.
2\   ACTION add_interest(),
3\     REAP interest FROM math:ROUND, SELF:balance * SELF:interest_rate, 2.
3\     INCREASE SELF:balance BY interest.
3\     GIVE "Interest: " + interest.
2\   /ACTION.
1\ /SPECIES.

1\ BLOOM SavingsAccount AS savings.
1\ SET savings:owner TO "فاطمة".
1\ REAP _ FROM savings:deposit, 1000.
1\ REAP msg FROM savings:add_interest.
1\ SHOW msg.
1\ REAP inf2 FROM savings:info.
1\ SHOW inf2.
