{
  "MISSION header": {
    "prefix": "mission",
    "body": ["MISSION: ${1|SAFE,FAST,SMART,BALANCED|}."],
    "description": "Set program mission mode"
  },
  "CREATE variable": {
    "prefix": "create",
    "body": ["1\\ CREATE ${1:name}(${2|NUM,SCL,TX,FACT,LIST,MAP|}) TO ${3:value}."],
    "description": "Create a typed variable"
  },
  "CREATE list": {
    "prefix": "list",
    "body": ["1\\ CREATE ${1:items}(LIST) TO ${2:item1}, ${3:item2}."],
    "description": "Create a list"
  },
  "CREATE map": {
    "prefix": "map",
    "body": [
      "1\\ CREATE ${1:data}(MAP).",
      "1\\ LINK \"${2:key}\" WITH ${3:value} IN ${1:data}."
    ],
    "description": "Create a map and add a key"
  },
  "IF block": {
    "prefix": "if",
    "body": [
      "1\\ IF ${1:condition},",
      "2\\   ${2:SHOW \"true\"}.${0}",
      "1\\."
    ],
    "description": "IF block"
  },
  "IF/ORIF/ELSE": {
    "prefix": "ifelse",
    "body": [
      "1\\ IF ${1:condition},",
      "2\\   ${2:SHOW \"true\"}.",
      "1\\ ORIF ${3:other condition},",
      "2\\   ${4:SHOW \"other\"}.",
      "1\\ ELSE,",
      "2\\   ${5:SHOW \"false\"}.",
      "1\\."
    ],
    "description": "IF / ORIF / ELSE chain"
  },
  "CYCLE over list": {
    "prefix": "cycle",
    "body": [
      "1\\ CYCLE ${1:item} IN ${2:list},",
      "2\\   SHOW ${1:item}.",
      "1\\."
    ],
    "description": "Cycle over a list"
  },
  "CYCLE range": {
    "prefix": "cyclerange",
    "body": [
      "1\\ CYCLE ${1:i} FROM ${2:1} TO ${3:10},",
      "2\\   SHOW ${1:i}.",
      "1\\."
    ],
    "description": "Cycle over a numeric range"
  },
  "SEASON while": {
    "prefix": "season",
    "body": [
      "1\\ SEASON ${1:condition},",
      "2\\   ${2:SHOW \"looping\"}.",
      "1\\."
    ],
    "description": "SEASON while loop"
  },
  "MATCH block": {
    "prefix": "match",
    "body": [
      "1\\ MATCH ${1:value},",
      "2\\   IS \"${2:case1}\"   YIELD ${3:SHOW \"matched\"}.",
      "2\\   IS \"${4:case2}\"   YIELD ${5:SHOW \"other\"}.",
      "2\\   ELSE             YIELD ${6:SHOW \"default\"}.",
      "1\\ \\\\."
    ],
    "description": "MATCH pattern matching"
  },
  "ACTION definition": {
    "prefix": "action",
    "body": [
      "1\\ ACTION ${1:name}(${2:param}(${3|NUM,SCL,TX,FACT,LIST,MAP|})),",
      "2\\   GIVE ${4:result}.",
      "1\\ /ACTION."
    ],
    "description": "Define an ACTION (function)"
  },
  "REAP call": {
    "prefix": "reap",
    "body": ["1\\ REAP ${1:result} FROM ${2:action}, ${3:arg}."],
    "description": "Call an action and capture result"
  },
  "WEATHER/SHELTER/CALM": {
    "prefix": "weather",
    "body": [
      "1\\ WEATHER,",
      "2\\   ${1:SHOW \"try\"}.",
      "1\\ SHELTER ${2|ZERO_STORM,TYPE_STORM,MISSING_STORM,ANY_STORM|} AS ${3:err},",
      "2\\   SHOW \"Error: \" + ${3:err}.",
      "1\\ CALM."
    ],
    "description": "Error handling block"
  },
  "SPECIES class": {
    "prefix": "species",
    "body": [
      "1\\ SPECIES ${1:ClassName},",
      "2\\   VAR ${2:field}(${3|NUM,TX,SCL,FACT|}) TO ${4:default}.",
      "2\\   ACTION ${5:method}(),",
      "3\\     GIVE SELF:${2:field}.",
      "2\\   /ACTION.",
      "1\\ /SPECIES.",
      "",
      "1\\ BLOOM ${1:ClassName} AS ${6:instance}."
    ],
    "description": "Define a class and create an instance"
  },
  "ROOT constant": {
    "prefix": "root",
    "body": ["ROOT ${1:NAME} TO ${2:value}."],
    "description": "Define a locked ROOT constant"
  },
  "ROOT_SCOPE config": {
    "prefix": "rootscope",
    "body": [
      "ROOT_SCOPE ${1:CONFIG},",
      "  LINK \"${2:key}\" WITH ${3:value} IN ${1:CONFIG}.",
      "ROOT_SCOPE/."
    ],
    "description": "Define a locked config MAP"
  },
  "PLANT library": {
    "prefix": "plant",
    "body": ["PLANT ${1|math,strings,lists|}."],
    "description": "Load a built-in library"
  },
  "BRAID lists": {
    "prefix": "braid",
    "body": ["1\\ BRAID ${1:list1} WITH ${2:list2} AS ${3:result}."],
    "description": "Zip two lists into pairs"
  },
  "BRAID to MAP": {
    "prefix": "braidmap",
    "body": ["1\\ BRAID ${1:keys} WITH ${2:values} AS ${3:result} MAP."],
    "description": "Zip two lists into a MAP"
  },
  "HARVEST GET": {
    "prefix": "harvest",
    "body": [
      "1\\ HARVEST \"${1:https://api.example.com/endpoint}\" AS ${2:response}.",
      "1\\ SHOW ${2:response}:\"status\".",
      "1\\ SHOW ${2:response}:\"body\"."
    ],
    "description": "HTTP GET request"
  },
  "HARVEST POST": {
    "prefix": "harvestpost",
    "body": [
      "1\\ CREATE ${1:payload}(MAP).",
      "1\\ LINK \"${2:key}\" WITH ${3:value} IN ${1:payload}.",
      "",
      "1\\ HARVEST \"${4:https://api.example.com/endpoint}\",",
      "2\\   METHOD: POST,",
      "2\\   BODY: ${1:payload},",
      "2\\   AS ${5:response}.",
      "1\\ SHOW ${5:response}:\"status\"."
    ],
    "description": "HTTP POST request"
  },
  "LISTEN BRANCH server": {
    "prefix": "listen",
    "body": [
      "1\\ CREATE cfg(MAP).",
      "1\\ LINK \"timeout\" WITH 30 IN cfg.",
      "",
      "1\\ LISTEN BRANCH ON ${1:3000} WITH cfg AS req MAP,",
      "2\\   CREATE path(TX)   TO req:\"path\".",
      "2\\   CREATE method(TX) TO req:\"method\".",
      "",
      "2\\   IF path IS \"/\",",
      "3\\     CREATE body(MAP).",
      "3\\     LINK \"status\" WITH \"ok\" IN body.",
      "3\\     GIVE body AS RESPONSE.",
      "2\\   ELSE,",
      "3\\     GIVE \"Not Found\" AS RESPONSE.",
      "2\\.",
      "1\\ LISTEN/."
    ],
    "description": "HTTP server with routing"
  },
  "VERIFY test": {
    "prefix": "verify",
    "body": ["  VERIFY \"${1:test description}\", ${2:condition}."],
    "description": "Single VERIFY assertion"
  },
  "SUITE block": {
    "prefix": "suite",
    "body": [
      "SUITE \"${1:Suite Name}\",",
      "",
      "  VERIFY \"${2:test description}\", ${3:condition}.",
      "",
      "SUITE/."
    ],
    "description": "SUITE test group"
  },
  "VERIFY FROM GIVES": {
    "prefix": "verifyfrom",
    "body": ["  VERIFY \"${1:action returns expected}\", FROM ${2:action}, ${3:args} GIVES ${4:expected}."],
    "description": "VERIFY action return value"
  },
  "VERIFY STORMS": {
    "prefix": "verifystorm",
    "body": ["  VERIFY \"${1:error is thrown}\", STORMS ${2|ZERO_STORM,TYPE_STORM,MISSING_STORM,ANY_STORM|} FROM ${3:expression}."],
    "description": "VERIFY that a storm is raised"
  },
  "PULSE + WHENEVER": {
    "prefix": "pulse",
    "body": [
      "1\\ CREATE ${1:value}(${2|NUM,TX,SCL,FACT|}) PULSE TO ${3:initial}.",
      "1\\ WHENEVER ${1:value} CHANGES,",
      "2\\   SHOW \"${1:value} changed to \" + ${1:value}.",
      "1\\."
    ],
    "description": "Reactive variable with watcher"
  },
  "ANALYZE variable": {
    "prefix": "analyze",
    "body": ["1\\ ANALYZE ${1:variable}."],
    "description": "Inspect a variable's type and contents"
  },
  "NOW timestamp": {
    "prefix": "now",
    "body": ["1\\ REAP ${1:ts} FROM NOW FORMAT:${2|STAMP,DATE,TIME,YEAR,FULL|}."],
    "description": "Get current date/time"
  },
  "Program template": {
    "prefix": "plnt",
    "body": [
      "MISSION: SAFE.",
      "PLANT math.",
      "PLANT strings.",
      "",
      "# ── ${1:Program Title} ────────────────────────────────",
      "",
      "1\\ SHOW \"${2:Hello, PlantLang!}\".",
      "$0"
    ],
    "description": "Full program template"
  }
}
